# Bluesim/bsc build artifacts (see stretch/bsv/README.md "Toolchain")
build/
simbuild/
# bsc writes one Bluesim output directory per build variant, and the
# variants are named: simbuild-hosttape is the one the host-file tape
# source uses.  Ten of its generated files were committed by accident
# before this line existed, and a single rebuild churns 95,000 lines
# of generated C++.
simbuild-*/
*.bo
*.ba
*_sim
*_sim.so
*_sim.h
*_sim.o

# Generated testbenches (see stretch/strap/run_program.sh, gen_tb.py) --
# ignore any Stretch*Tb.bsv in bsv/ EXCEPT the hand-written StretchTb.bsv
# itself, so this doesn't need updating every time a new ModuleName is
# passed to run_program.sh (name-independent, not a list of module names).
stretch/bsv/Stretch*Tb.bsv
!stretch/bsv/StretchTb.bsv

# Python
__pycache__/
*.pyc

# OS cruft
.DS_Store

# Claude Code harness-internal state (not project content)
.claude/
