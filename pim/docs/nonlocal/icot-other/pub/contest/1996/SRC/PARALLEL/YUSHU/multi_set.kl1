:- module multi_set.

% 各処理 @node( ( X mod N ) mod P )
% N : 素数 ( >> P )
% P : ノード数


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   1. マルチ集合 L を内部表現 M に変換: encode(L, M)

encode([],M) :- M=[].
encode(L,M) :- list(L), N=307 |
    current_node(_,P),
    encode:encode(L,M,N,P).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   2. 内部表現 M をリスト表現 L に戻す: decode(M, L)

decode(M,L) :-
    current_node(_,P),
    decode(M,L,0,P).

decode([M0|M],L,N,P) :- N1:=N+1, Node:=N mod P |
    decode(M,L1,N1,P),
    decode2(M0,L,L1)@node(Node).
decode([],L,_,_) :- L=[].


%%%%
%   decode2

decode2([X,Xn|M],L,L1) :- repeat(X,Xn,L,L1,M).
decode2([],L,L1) :- L=L1.

repeat(X,1,L,L1,M) :-
    L=[X|L2],
    decode2(M,L2,L1).
repeat(X,Xn,L,L1,M) :- Xn>1, Xn1:=Xn-1 |
    L=[X|L2],
    repeat(X,Xn1,L2,L1,M).


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   3. 和集合 M0 ∪ M1 = M : union(M0, M1, M)

union(M0,M1,M) :-
    current_node(_,P),
    union(M0,M1,M,0,P).

union([L0|M0],[L1|M1],M,N,P) :- N1:=N+1, Node:=N mod P |
    M=[L|M2],
    union(M0,M1,M2,N1,P),
    union2(L0,L1,L)@node(Node).
union([],M1,M,_,_) :- M=M1.
union(M0,[],M,_,_) :- M=M0.


%%%%
%   union2

union2([X0,Xn0|L0],[X1|L1],L) :-  X0 < X1 |
    L=[X0,Xn0|L2],
    union2(L0,[X1|L1],L2).
union2([X0|L0],[X1,Xn1|L1],L) :-  X1 < X0 |
    L=[X1,Xn1|L2],
    union2([X0|L0],L1,L2).
union2([X,Xn0|L0],[X,Xn1|L1],L) :-  Xn:=Xn0 + Xn1 |
    L=[X,Xn|L2],
    union2(L0,L1,L2).
union2([],L1,L) :- L=L1.
union2(L0,[],L) :- L=L0.


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   4. 積集合 M0 ∩ M1 = M : intersection(M0, M1, M)

intersection(M0,M1,M) :-
    current_node(_,P),
    intersection(M0,M1,M,0,P).

intersection([L0|M0],[L1|M1],M,N,P) :- N1:=N+1, Node:=N mod P |
    M=[L|M2],
    intersection(M0,M1,M2,N1,P),
    intersection2(L0,L1,L)@node(Node).
intersection([],_,M,_,_) :- M=[].
intersection(_,[],M,_,_) :- M=[].


%%%%
%   intersection2

intersection2([X0,Xn0|L0],[X1|L1],L) :- X0 < X1 |
    intersection2(L0,[X1|L1],L).
intersection2([X0|L0],[X1,Xn1|L1],L) :- X1 < X0 |
    intersection2([X0|L0],L1,L).
intersection2([X,Xn0|L0],[X,Xn1|L1],L) :- Xn0 =< Xn1 |
    L=[X,Xn0|L2],
    intersection2(L0,L1,L2).
intersection2([X,Xn0|L0],[X,Xn1|L1],L) :- Xn1 =< Xn0 |
    L=[X,Xn1|L2],
    intersection2(L0,L1,L2).
intersection2([],_,L) :- L=[].
intersection2(_,[],L) :- L=[].


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   5. 差集合 M0 ＼ M1 = M : difference(M0, M1, M)

difference(M0,M1,M) :-
    current_node(_,P),
    difference(M0,M1,M,0,P).

difference([L0|M0],[L1|M1],M,N,P) :- N1:=N+1, Node:=N mod P |
    M=[L|M2],
    difference(M0,M1,M2,N1,P),
    difference2(L0,L1,L)@node(Node).
difference([],_,M,_,_) :- M=[].
difference(M0,[],M,_,_) :- M=M0.


%%%%
%   difference2

difference2([X0,Xn0|L0],[X1|L1],L) :- X0 < X1 |
    L=[X0,Xn0|L2],
    difference2(L0,[X1|L1],L2).
difference2([X0|L0],[X1,Xn1|L1],L) :- X1 < X0 |
    difference2([X0|L0],L1,L).
difference2([X,Xn0|L0],[X,Xn1|L1],L) :- Xn0 =< Xn1 |
    difference2(L0,L1,L).
difference2([X,Xn0|L0],[X,Xn1|L1],L) :- Xn1 < Xn0, Xn:=Xn0-Xn1 |
    L=[X,Xn|L2],
    difference2(L0,L1,L2).
difference2([],_,L) :- L=[].
difference2(L0,[],L) :- L=L0.


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   6. 重複を除いた集合 M  : contraction(M0, M)

contraction(M0,M) :-
    current_node(_,P),
    contraction(M0,M,0,P).

contraction([L0|M0],M,N,P) :- N1:=N+1, Node:=N mod P |
    M=[L|M1],
    contraction(M0,M1,N1,P),
    contraction2(L0,L)@node(Node).
contraction([],M,_,_) :- M=[].


%%%%
%   contraction2

contraction2([X,Xn|L],M) :-
    M=[X,1|M1],
    contraction2(L,M1).
contraction2([],M) :- M=[].


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%   7. M(≠φ) の1要素 E と残りの集合 S(内部表現): choose(M, E, S)

choose([[X,Xn|L]|M],E,S) :- Xn>1, Xn1:=Xn-1 |
    E=X,
    S=[[X,Xn1|L]|M].
choose([[X,1|L]|M],E,S) :- list(L) | E=X, S=[L|M].
choose([[X,1]|M],E,S) :- E=X, S=M.
choose([[]|M],E,S) :- choose(M,E,S).


%%%%  multi_set EOF.

