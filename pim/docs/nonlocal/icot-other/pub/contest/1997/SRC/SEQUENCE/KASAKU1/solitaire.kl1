:- module solitaire.

%%%% M A I N %%%%
poker(Cards,Results) :- 
	encode(Cards,CardsString),
	my_CS_Shuffle(CardsString,ShuffleCards,61000)@lower_priority,
	simulatedAnnealing(ShuffleCards,Ans_Cards,0),
	filter(Ans_Cards,FilterCards,-1,0),
	decode(FilterCards,Results).


% Filter -----------------------------------------------------------
filter([],Result,_,_) :- Result = []. 
filter([Ans|Ans1],Result,Pre_Score,N) :- 
	myScore(Ans,Ans_Score),
	filterCheck(Ans,Result,Result1,Pre_Score,Ans_Score,HighScore,N),
%	io:outstream([print([N,Ans_Score]),nl]), % print loop number and Score!
	N1 := N + 1,
	filter(Ans1,Result1,HighScore,N1).

filterCheck(Ans,Result,Result1,Pre_Score,Ans_Score,High,_):- 
	Pre_Score < Ans_Score |
		Result = [Ans|Result1],
		High   = Ans_Score.
filterCheck(  _,Result,Result1,Pre_Score,Ans_Score,High,_):- 
	Pre_Score >= Ans_Score|
		Result = Result1,
		High   = Pre_Score.


% Simulated Annealing Method ---------------------------------------------
simulatedAnnealing([],               Ans_Cards,_) :- Ans_Cards = [].
simulatedAnnealing([SC|ShuffleCards],Ans_Cards,N) :-
	simulatedAnnealing(SC,Ans,3000.0,1.0,N), %SA parameter(T=3000, Limit=1)
	Ans_Cards = [Ans|Ans_Cards1],
	N1 := N + 1,
	simulatedAnnealing(ShuffleCards,Ans_Cards1,N1).

simulatedAnnealing(SC,Ans,T,Limit,_) :- wait(SC), Limit $>= T | Ans = SC.
simulatedAnnealing(SC,Ans,T,Limit,N) :- wait(SC), Limit $<  T | 
	myScore(SC,SC_Score),
	simulatedAnnealingLoop(SC,High,0,1,SC_Score,T,N),
%	T1 $:= T * 0.9,  %SA parameter(alpha=0.9)
	T1 $:= T * 0.85, %SA parameter(alpha=0.85)
%	T1 $:= T * 0.8,  %SA parameter(alpha=0.8)
	N1 := N + 1,
	simulatedAnnealing(High,Ans,T1,Limit,N1).	

simulatedAnnealingLoop(SC,Ans,I,_,_,_,_)        :- I >=25     | Ans = SC.
simulatedAnnealingLoop(SC,Ans,I,J,SC_Score,T,N) :- I<25,J>=25 | 
	I1 := I  + 1,
	J1 := I1 + 1,
	N1 := N  + 1,
	simulatedAnnealingLoop(SC,Ans,I1,J1,SC_Score,T,N1).
simulatedAnnealingLoop(SC,Ans,I,J,SC_Score,T,N) :- I<25,J<25 | 
	J1 := J + 1,
	N1 := N  + 1,
	simulatedAnnealingSwap(SC,Swap,I,J),
	myScore(Swap,Swap_Score),
	Difference $:= float(Swap_Score - SC_Score - 1), % -1 is better!
	Exponent   $:= exp( Difference / T ),
	myrandom1Float(RandomF,N),
	simulatedAnnealingCheck(SC,Swap,High,SC_Score,Swap_Score,High_Score,
				Exponent,RandomF),
	simulatedAnnealingLoop(High,Ans,I,J1,High_Score,T,N1).

simulatedAnnealingCheck(_,B,High,A_Score,B_Score,High_Score,_,_)
	:- A_Score<B_Score  |
		High       = B,
		High_Score = B_Score.
simulatedAnnealingCheck(_,B,High,A_Score,B_Score,High_Score,Exponent,RandomF) 
	:- A_Score>=B_Score, Exponent $> RandomF |
		High       = B,
		High_Score = B_Score.
simulatedAnnealingCheck(A,_,High,A_Score,B_Score,High_Score,Exponent,RandomF) 
	:- A_Score>=B_Score, Exponent $=< RandomF |
		High       = A,
		High_Score = A_Score.

simulatedAnnealingSwap(SC,Swap,I,J):-
	string_element(SC,I ,E1),
	string_element(SC,J ,E2),
 	set_string_element(SC ,I ,E2,SC1),
 	set_string_element(SC1,J ,E1,Swap).
	

% CardsString Shuffle Part ----------------------------------------
my_CS_Shuffle(CardsString,ShuffleCards,N) :- N =< 1 |
	ShuffleCards = [CardsString].
my_CS_Shuffle(CardsString,ShuffleCards,N) :- N >  1 |
	myrandom25Seed(R,N),
	random_CS_Shuffle(CardsString,RandomCard,R,24),
	N1 := N - 1,
	ShuffleCards = [CardsString|ShuffleCards1],
	my_CS_Shuffle(RandomCard, ShuffleCards1,N1).

random_CS_Shuffle(CardsString,RandomCard,_,     N) :- N <  0 |
	RandomCard = CardsString.
random_CS_Shuffle(CardsString,RandomCard,[R0|R],N) :- N >= 0 |
	N1 := N - 1,
	R1 := R0 mod 25,
	string_element(CardsString,N ,E1),
	string_element(CardsString,R1,E2),
 	set_string_element(CardsString,N ,E2,CS1),
 	set_string_element(CS1,        R1,E1,CS2),
	random_CS_Shuffle(CS2,RandomCard,R,N1).


% RANDOM -----------------------------------------------------------
% random generator : number of the random elements is 25
myrandom25Seed(R,Seed) :- 
		Seed1 := ( ( 129 * Seed + 351751 ) mod 917687),	
		myrandom25(R,Seed1,24).

myrandom25(R,_,   N) :- N < 0  | R = [].
myrandom25(R,Seed,N) :- N >= 0 | 
		R      = [Seed|R1],
		N1    := N - 1,
		Seed1 := ( ( 129 * Seed + 351751 ) mod 917687),
		myrandom25(R1,Seed1,N1).

% [0 <= RandomF < 1 ] float random generator 
myrandom1Float(RandomF,Seed) :- 
		R        := ( ( 129 * Seed + 351751 ) mod 917687),
		R1       := ( ( 129 * R    + 351751 ) mod 917687),
		RandomF $:= float( R1 ) / 917687.0 .


% Decoding --------------------------------------------------------
decode([],Results) :- Results = [].
decode([CS|CardsString],Results) :- wait(CS) |
	decode1(CS,Card,0),
	Results = [Card|Results1],
	decode(CardsString,Results1).

decode1(CS,Card,N) :-  N >  24 | Card = [].
decode1(CS,Card,N) :-  N =< 24 | 
	string_element(CS,N,A0), 
	Suit := A0 /\ 15,
	Rank := A0 >> 4,
	suit_decode(Suit,Suit_Decode),
	rank_decode(Rank,Rank_Decode),
	Card = [card(Rank_Decode,Suit_Decode)|Card1],
	N1 := N + 1,
	decode1(CS,Card1,N1).

suit_decode(S, D) :- S = 4 | D = spades.
suit_decode(S, D) :- S = 3 | D = hearts.
suit_decode(S, D) :- S = 2 | D = diamonds.
suit_decode(S, D) :- S = 1 | D = clubs.

rank_decode(R, D) :- 1<R, R<11 | D = R.
rank_decode(R, D) :- R = 11    | D = jack.
rank_decode(R, D) :- R = 12    | D = queen.
rank_decode(R, D) :- R = 13    | D = king.
rank_decode(R, D) :- R = 14    | D = ace.


% ---Modified version of Score ---------
myScore(CardsString,Score) :- score(1,12,CardsString,0,Score).
% --------------------------------------


%%%%%  modified version of eval.kl1 %%%%%%%%%%%%%%
% 実行委員会配布の eval.kl1 を少し修正。
% --- evaluate 12 hands of a board 
score(K,M,CS,Total,Score) :- K =< M, K1 := K+1 |
	eval_idx(K,Idx), 
	score1(K,Idx,CS)+Total+Total1,
	score(K1,M,CS,Total1,Score).
score(K,M,CS,Total,Score) :- K > M | Score = Total.

score1(N,i(I0,I1,I2,I3,I4),CS)-Total :- 
    string_element(CS,I0,A0), string_element(CS,I1,A1),
    string_element(CS,I2,A2), string_element(CS,I3,A3),
    string_element(CS,I4,A4) |
	hand_eval(A0,A1,A2,A3,A4,Hand),
	score_point(Hand,Sc), 
	Total += Sc.

%%%%%  same as eval.kl1 %%%%%%%%%%%%%%%%%%%%%%%%%%
% 以下のプログラムは、実行委員会配布の eval.kl1 と同じ。
% Encoding - same as eval.kl1 ------------------------------
encode(Cards,CardsString) :- 
    encode_card_list(Cards,List),
    generic:new(string,CardsString,List,8).

encode_card_list([C|Cards],List) :-
    encode_card(C,E),    List = [E|List1],
    encode_card_list(Cards,List1).
encode_card_list([],List) :- List = [].

encode_card(card(Rank,Suit),Encoded) :-
    rank_code(Rank,RankCode), 
    suit_code(Suit,SuitCode), 
    Encoded := (RankCode << 4) \/ SuitCode.

suit_code(spades,  R) :- R = 4.
suit_code(hearts,  R) :- R = 3.
suit_code(diamonds,R) :- R = 2.
suit_code(clubs,   R) :- R = 1.

rank_code(N,      R) :- integer(N), 1 < N, N < 11 | R = N.
rank_code(jack,   R) :- R = 11.
rank_code(queen,  R) :- R = 12.
rank_code(king,   R) :- R = 13.
rank_code(ace,    R) :- R = 14.
% --------------------------------------

% lines
eval_idx( 1,L) :- L = i( 0, 1, 2, 3, 4).
eval_idx( 2,L) :- L = i( 5, 6, 7, 8, 9).
eval_idx( 3,L) :- L = i(10,11,12,13,14).
eval_idx( 4,L) :- L = i(15,16,17,18,19).
eval_idx( 5,L) :- L = i(20,21,22,23,24).
% columns
eval_idx( 6,L) :- L = i( 0, 5,10,15,20).
eval_idx( 7,L) :- L = i( 1, 6,11,16,21).
eval_idx( 8,L) :- L = i( 2, 7,12,17,22).
eval_idx( 9,L) :- L = i( 3, 8,13,18,23).
eval_idx(10,L) :- L = i( 4, 9,14,19,24).
% diagonals
eval_idx(11,L) :- L = i( 0, 6,12,18,24).
eval_idx(12,L) :- L = i( 4, 8,12,16,20).
% --------------------------------------

% --- evaluate 5 cards as a hand
hand_eval(A0,A1,A2,A3,A4, Hand) :- 
    card_sort(0,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4),
    CC := B0 >> 4,
    pairs([B1,B2,B3,B4],CC,1,Pairs),

    ( Pairs = [N|L] -> 
      
      (% Four of a kind
       N = [4|Rank] -> Hand = four_of_a_kind(Rank) ; 
       % Three of a kind or ...
       N = [3|Rank1] -> 
         (% Full house!
	  L = [[2|Rank2]] -> Hand = full_house(Rank1,Rank2) ;
	  L = []          -> Hand = three_of_a_kind(Rank1) ) ;
       % One pair or ... 
       N = [2|Rank1] -> 
         (L = [[M|Rank2]] -> 
	    (% Full house!
	     M = 3 -> Hand = full_house(Rank2,Rank1) ;
	     % Two pairs
	     M = 2 -> Hand = two_pairs(Rank1,Rank2) ) ;
	  L = []          -> Hand = one_pair(Rank1)) ) ;
      Pairs = []    -> is_straight_flush(B0,B1,B2,B3,B4,Hand) ).

is_straight_flush(B0,B1,B2,B3,B4,Hand) :- 
    U := B0 >> 4, L := B0 /\ 16'F |
	is_straight([B1,B2,B3,B4],U,U,H1),
	is_flush([B1,B2,B3,B4],   L,U,H2),
	(H1 = straight(X) -> 
%	   (H2 = flush(Y) -> R = straight_flush(Y) ;
%          (H2 = flush(Y) -> Hand = straight_flush(Y) ;
           (H2 = flush(Y) -> Hand = straight_flush(X) ;
	    otherwise; 
	    true       -> Hand = H1) ;
	 otherwise;
	 H2 = flush(Y) -> Hand = H2 ;
	 otherwise;
	 true       -> Hand = no_pair).

is_straight([X|T],U,M,R) :- U1 := X >> 4, U1 =:= U+1,
    M1 := M+U1 | is_straight(T,U1,M1,R).
is_straight([]   ,U,M,R) :- R = straight(M).
otherwise.
% 2,3,4,5, A
is_straight([X]  ,5,M,R) :- 14 =:= X >> 4 | R = straight(15).
otherwise.
is_straight(_    ,_,_,R) :- R = no.

is_flush([X|T],L,U,R) :- L =:= X /\ 16'F, U1 := (X >> 4)+U | 
	is_flush(T,L,U1,R).
is_flush([],   L,U,R) :- R = flush(U).
otherwise.
is_flush(_,    _,_,R) :- R = no.

% --- Sort 5 cards in rank order
card_sort(0,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A0 < A1 |
	card_sort(1,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4).
card_sort(0,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A0 > A1 |
	card_sort(1,A1,A0,A2,A3,A4,B0,B1,B2,B3,B4).
card_sort(1,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A1 < A2 |
	card_sort(2,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4).
card_sort(1,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A1 > A2 |
	card_sort(0,A0,A2,A1,A3,A4,B0,B1,B2,B3,B4).
card_sort(2,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A2 < A3 |
	card_sort(3,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4).
card_sort(2,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A2 > A3 |
	card_sort(1,A0,A1,A3,A2,A4,B0,B1,B2,B3,B4).
card_sort(3,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A3 < A4 |
	A0=B0,A1=B1,A2=B2,A3=B3,A4=B4.
card_sort(3,A0,A1,A2,A3,A4,B0,B1,B2,B3,B4) :- A3 > A4 |
	card_sort(2,A0,A1,A2,A4,A3,B0,B1,B2,B3,B4).

% --- Find pairs in sorted cards
pairs([C1|Cs],C0, N,Pairs) :- CC := C1 >> 4 |
	( CC = C0, N1 := N+1 -> pairs(Cs,C0,N1,Pairs) ;
	  otherwise;
	  N = 1 -> pairs(Cs,CC,N,Pairs) ;
	  N > 1 -> ( Pairs = [[N|C0]|Pairs1], pairs(Cs,CC,1,Pairs1) )).
pairs([],     C0, N,Pairs) :- 
    ( N = 1 -> Pairs = [];  N > 1 -> Pairs = [[N|C0]] ).

% --- Evaluate a hand and give score
 %         Straight Flush       2745600 points
 %         Four of a Kind        176000 
 %         Full House             29333 
 %         Flush                  21500 
 %         Straight               10767 
 %         Three of a Kind         2000 
 %         Two Pairs                888 
 %         One Pair                 100 

score_point(straight_flush(X), S) :-  S := 2745600+X.
score_point(four_of_a_kind(X), S) :-  S :=  176000+(X*4).
score_point(full_house(X,Y),   S) :-  S :=   29333+(X*3)+(Y*2).
score_point(flush(X),          S) :-  S :=   21500+X.
score_point(straight(X),       S) :-  S :=   10767+X.
score_point(three_of_a_kind(X),S) :-  S :=    2000+(X*3).
score_point(two_pairs(X,Y),    S) :-  S :=     888+(X*2)+(Y*2).
score_point(one_pair(X),       S) :-  S :=     100+(X*2).
score_point(no_pair,           S) :-  S = 0.
