%%
%% Cross ( Try & Check )
%%

:- module solitaire_cross.

cross_filter([], OS):- OS = [].
cross_filter([I|IS], OS):- true |
	cross(I, O),
	OS = [O|NOS],
	cross_filter(IS, NOS).

cross(IN, OUT):-
	try_line(IN, O1),
	try_cross(O1, OUT).

try_line(IN, OUT):- true |
	solitaire_misc:score_e_x1(IN, SI),
	solitaire_misc:list_topn(5,IN, L1,R1),
	solitaire_misc:list_topn(5,R1, L2,R2),
	solitaire_misc:list_topn(5,R2, L3,R3),
	solitaire_misc:list_topn(5,R3, L4,L5),
	try_line(1, [L1,L2,L3,L4,L5], SI,IN,OUT).

% 120 通り全て試して一番良いものを出力する
try_line(120, I, SC,C,OUT):-
	OUT = C.
try_line(N, I,SI, C,OUT):- N<120 | N1 := N+1,
	solitaire_pairtry:try_shuffle(N, I, O),
	solitaire_misc:connect_members(O, CO),
	solitaire_misc:score_e_x1(CO, SO),
	( SO > SI -> NC = CO, NS = SO;
	  SO=< SI -> NC = C,  NS = SI ),
	try_line(N1, I, NS,NC,OUT).

% 逆方向の斜めの得点を最大化(15通りしかない)
try_cross(IN, OUT):-
	generic:new(string,CS,IN,8),
	solitaire_misc:score_e_x2(IN, SC),
	try_cross(1, CS, 0,SC,A),
	pairs(A, i(I3, I1,I5, I2,I4)),
%	io:outstream([print(['- cross key- ',I1,I2,I3,I4,I5,K1,K2,K3,K4,K5]),nl]),
	sort_key([0,1,2,3,4], I1,I2,I3,I4,I5, [K5,K4,K3,K2,K1]),
	cross_sort_key(IN, K1,K2,K3,K4,K5, OUT).

try_cross(15,CS, CN,SC,ANS):- true |
	ANS = CN.
try_cross(N, CS, CN,SC,ANS):- N<15 | NN := N+1,
%	io:outstream([print('- try_cross -'),print([SC,Hand,HSC]),nl]),
	pairs(N, i(I1,I2,I3,I4,I5)),
	N1 := I1*5 + I1,
	N2 := I2*5 + I3,
	N3 := I3*5 + I2,
	N4 := I4*5 + I5,
	N5 := I5*5 + I4,
	string_element(CS, N1,C1),
	string_element(CS, N2,C2),
	string_element(CS, N3,C3),
	string_element(CS, N4,C4),
	string_element(CS, N5,C5),
	solitaire_evaluate:hand_eval(C1,C2,C3,C4,C5,Hand),
	solitaire_evaluate:score_point(Hand,HSC),
	( HSC > SC -> try_cross(NN,CS, N,HSC,ANS);
	  HSC=< SC -> try_cross(NN,CS, CN,SC,ANS) ).

pairs(0, R):- R = i(2, 0,4, 1,3).
pairs(1, R):- R = i(0, 1,2, 3,4).
pairs(2, R):- R = i(0, 1,3, 2,4).
pairs(3, R):- R = i(0, 1,4, 2,3).
pairs(4, R):- R = i(1, 0,2, 3,4).
pairs(5, R):- R = i(1, 0,3, 2,4).
pairs(6, R):- R = i(1, 0,4, 2,3).
pairs(7, R):- R = i(2, 0,1, 3,4).
pairs(8, R):- R = i(2, 0,3, 1,4).
pairs(9, R):- R = i(3, 0,1, 2,4).
pairs(10,R):- R = i(3, 0,2, 1,4).
pairs(11,R):- R = i(3, 0,4, 1,2).
pairs(12,R):- R = i(4, 0,1, 2,3).
pairs(13,R):- R = i(4, 0,2, 1,3).
pairs(14,R):- R = i(4, 0,3, 1,2).

cross_sort_key(IN, I1,I2,I3,I4,I5, OUT):-
	solitaire_misc:list_topn(5,IN, L1,R1),
	solitaire_misc:list_topn(5,R1, L2,R2),
	solitaire_misc:list_topn(5,R2, L3,R3),
	solitaire_misc:list_topn(5,R3, L4,L5),
	sort_key([L1,L2,L3,L4,L5], I1,I2,I3,I4,I5, [S1,S2,S3,S4,S5]),
	sort_key(S1, I1,I2,I3,I4,I5, O1),
	sort_key(S2, I1,I2,I3,I4,I5, O2),
	sort_key(S3, I1,I2,I3,I4,I5, O3),
	sort_key(S4, I1,I2,I3,I4,I5, O4),
	sort_key(S5, I1,I2,I3,I4,I5, O5),
	solitaire_misc:connect_members([O1,O2,O3,O4,O5], OUT).

sort_key([L1,L2,L3,L4,L5], I1,I2,I3,I4,I5, OUT):-
	solitaire_sort:sort_r_key(
	  [item(I1,L1),item(I2,L2),item(I3,L3),item(I4,L4),item(I5,L5)],OUT).
