active2x3LR_sub1(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results4, actve(Id2,X,Y,lr,Len2) ,
		Active1,Active4,Answer1,Answer5,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):-
		string_element(Used1,Id1,U1), U1 = 0,               % not used yet
		Len1 >= 3,					    % enough length
		X>0,                                                % enough space
		string_element(Answer1,~((X-1)*Size+Y),W1),   W1=0, % next space?
		string_element(Answer1,~((X-1)*Size+Y+1),W2), W2=0, %(X-1,Y)(X-1,Y+1)
		string_element(Answer1,~((X-1)*Size+Y+2),W3), W3=0 |%    (X-1,Y+2)
	tail3char(Str,Len1,C1,C2,C3),
	put3charLR(~(X-1),Y,Size,Answer1,C1,C2,C3,Answer2),                      
	pick2charTB(~(X-1),Y,     Size,Answer2,D1,D2),              % north-west
	pick2charTB(~(X-1),~(Y+1),Size,Answer2,D3,D4),              % 
	pick2charTB(~(X-1),~(Y+2),Size,Answer2,D5,D6),              % north-east
	try_put_LR(~(X-1),~(Y+2-(Len1-1)),Str,Len1,Answer2,Size,X2,Y2,Flag1),
	search2DTable(id(D1,D2),Table2D,List1),
	search2DTable(id(D3,D4),Table2D,List2),
	search2DTable(id(D5,D6),Table2D,List3),
	triple_try_put_TB(Flag1,Flag2,List1,List2,List3,~(X-1),Y,Size,BinWords,Id1, % north-west
			Results1,Results2, Active1,Active2,Answer1,Answer2,Answer3,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	ifOKputLR(Flag2,word(Id1,U,Key,Str,Val,Len1),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer3,Answer4,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	active2x3LR_sub1(Flag2,Flag,BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id2,X,Y,lr,Len2) ,
			Active3,Active4,Answer4,Answer5,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4).
otherwise.
active2x3LR_sub1( next ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,lr,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.


