% 第一引数が next ということは、try_put_LR で失敗しているということ。
%
triple_try_put_TB(next,Flag,List1,List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	


%
% 第一引数が ok なので、 start!
%
% 新しい単語はすでに使われている。
triple_try_put_TB( ok ,Flag,List1,List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
		string_element(Used1,Cand1,U1),U1=\=0 |
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	
otherwise.
triple_try_put_TB( ok ,Flag,List1,List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	triple_try_put_TB_main(next ,Flag,List1,List2,List3,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

%
% 3重ループの外側。
%
% OKが出ているから終了。
triple_try_put_TB_main(ok ,Flag,List1,List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List1 が空になったので、終了。
triple_try_put_TB_main(next ,Flag,[],List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = AnswerOrg, % 古い解に戻す ！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

triple_try_put_TB_main(next ,Flag,[L1|List1],List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	triple_try_put_TB_sub(next ,Flag1, L1 ,List2,List3,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	triple_try_put_TB_main(Flag1,Flag,    List1 ,List2,List3,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).
	

%
% 3重ループの真ん中
%
% OKが出ているから終了。
triple_try_put_TB_sub(ok ,Flag, L1 ,List2,List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List2 が空になったので、終了。
triple_try_put_TB_sub(next ,Flag, L1 ,[],List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1, 
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

triple_try_put_TB_sub(next ,Flag, L1 ,[L2|List2],List3,X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	triple_try_put_TB_subsub(next, Flag1, L1 , L2 ,List3,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	triple_try_put_TB_sub(Flag1,Flag, L1 , List2, List3 ,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).

%
% 3重ループの内側
%
% OKが出ているから終了。
triple_try_put_TB_subsub(ok ,Flag, L1 ,L2, List3,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List3 が空になったので、終了。
triple_try_put_TB_subsub(next ,Flag, L1 ,L2, [],X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1, 
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

triple_try_put_TB_subsub(next ,Flag, L1 ,L2,[L3|List3],X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	triple_try_put_TB_core(Flag1, L1 , L2 ,L3 ,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	triple_try_put_TB_subsub(Flag1,Flag, L1 , L2, List3 ,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).

%
% 一番内側の計算     (x,y),(x,y+1),(x,y+2)
%                  (x+1,y),(x+1,y+1),(x+1,y+2)
triple_try_put_TB_core(Flag,elm(Atom1,Id1,rear),elm(Atom2,Id2,head),elm(Atom3,Id3,rear),
		X,Y,Size,BinWords,Cand1,
		Results1,Results4, Active1,Active4,AnswerOrg,Answer1,Answer4,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):- 
		Id1=\=Id2, Id1=\=Id3, Id2=\=Id3,Id1=\=Cand1,Id2=\=Cand1,Id3=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 ,
		string_element(Used1,Id3,U3), U3 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	searchBinWords(Id3,BinWords,word(_,U3,Key3,Str3,Val3,Len3),Used1),
	try_put_TB(~(X+1-(Len1-1)),     Y,Str1,Len1,Answer1,Size,X1,Y1,Flag1), % rear
	try_put_TB(X,              ~(Y+1),Str2,Len2,Answer1,Size,X2,Y2,Flag2), % head
	try_put_TB(~(X+1-(Len3-1)),~(Y+2),Str3,Len3,Answer1,Size,X3,Y3,Flag3), % rear
	ifTripleOK(Flag1,Flag2,Flag3,Flag),
	ifOKputTB(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,          
				Results1,Results2,Active1,Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputTB(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,          
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	ifOKputTB(Flag,word(Id3,U3,Key3,Str3,Val3,Len3),X3,Y3,Size,          
				Results3,Results4,Active3,Active4,
				Answer3,Answer4,
				HistTB3,HistTB4,HistLR3,HistLR4,Used3,Used4).

triple_try_put_TB_core(Flag,elm(Atom1,Id1,head),elm(Atom2,Id2,rear),elm(Atom3,Id3,head),
		X,Y,Size,BinWords,Cand1,
		Results1,Results4, Active1,Active4,AnswerOrg,Answer1,Answer4,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):- 
		Id1=\=Id2, Id1=\=Id3, Id2=\=Id3,Id1=\=Cand1,Id2=\=Cand1,Id3=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 ,
		string_element(Used1,Id3,U3), U3 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	searchBinWords(Id3,BinWords,word(_,U3,Key3,Str3,Val3,Len3),Used1),
	try_put_TB(X,              Y,     Str1,Len1,Answer1,Size,X1,Y1,Flag1), % head
	try_put_TB(~(X+1-(Len2-1)),~(Y+1),Str2,Len2,Answer1,Size,X2,Y2,Flag2), % rear
	try_put_TB(X,              ~(Y+2),Str3,Len3,Answer1,Size,X3,Y3,Flag3), % head
	ifTripleOK(Flag1,Flag2,Flag3,Flag),
	ifOKputTB(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,          
				Results1,Results2,[],Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputTB(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,          
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	ifOKputTB(Flag,word(Id3,U3,Key3,Str3,Val3,Len3),X3,Y3,Size,          
				Results3,Results4,Active3,Active4,
				Answer3,Answer4,
				HistTB3,HistTB4,HistLR3,HistLR4,Used3,Used4).

otherwise.
% 同じDir方向だから失敗
% Atom1 と Atom2 が 同じ だから、失敗
% Atom1 と Atom3 が 同じ だから、失敗
% Atom2 と Atom3 が 同じ だから、失敗
% Atom1 と Cand1 が 同じ だから、失敗
% Atom2 と Cand1 が 同じ だから、失敗
% Atom3 と Cand1 が 同じ だから、失敗
% Atom1, Atom2, Atom3 とも、すでに使っていたから 失敗
triple_try_put_TB_core(Flag,elm(Atom1,Id1,Dir1),elm(Atom2,Id2,Dir2),elm(Atom3,Id3,Dir3),
		X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.



%  ( 2x2 TB )
%            s   s
%            u   u
%            b W b
%            1 O 2
%              R
%            s D s
%            u S b 
%            b   b
%            3   4

% dummy
activeSearch2x2TB1(BinWords,MyWords,Number,Size,
		Results1,Results,_,Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	Results  = Results1,
	Active   = Active1,
	Answer   = Answer1,
	HistTB   = HistTB1,
	HistLR   = HistLR1,
	Used     = Used1.

%
% 対象となる active() は 横置きなので、キャンセル
%
activeSearch2x2TB(BinWords,MyWords,Number,Size,
		Results1,Results,actve(Id,X,Y,lr,Len),Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	Results  = Results1,
	Active   = Active1,
	Answer   = Answer1,
	HistTB   = HistTB1,
	HistLR   = HistLR1,
	Used     = Used1.
	
%
% 対象となる active() について、上下左右４方向に 単語を一つずつ置いてみる。
%
activeSearch2x2TB(BinWords,MyWords,Number,Size,
		Results1,Results,actve(Id,X,Y,tb,Len),Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	active2x2TB_sub1( next, Flag1, BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id,X,Y,tb,Len), 
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	active2x2TB_sub2( Flag1, Flag2, BinWords,MyWords,Number,Size,
			Results2,Results3, actve(Id,X,Y,tb,Len),
			Active2,Active3,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3),
	active2x2TB_sub3( next, Flag3, BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id,X,Y,tb,Len),
			Active3,Active4,Answer3,Answer4,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4),
	active2x2TB_sub4( Flag3, Flag4, BinWords,MyWords,Number,Size,
			Results4,Results,  actve(Id,X,Y,tb,Len),
			Active4,Active,Answer4,Answer,
			HistTB4,HistTB,HistLR4,HistLR,Table2D,Table3D,Used4,Used).

%
%
% sub1 対象となる active() について、未使用の単語をひとつずつ当てはめていく。
%
%
active2x2TB_sub1( ok ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len),
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = ok,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

active2x2TB_sub1( next ,Flag,BinWords,[     ],Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len),
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

%
% 単語wordがすでに使用されていたから、次の単語に移る。
%		
active2x2TB_sub1(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results2, actve(Id2,X,Y,tb,Len2),
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
			string_element(Used1,Id1,U1), U1 =\= 0 |
	active2x2TB_sub1(next,Flag,BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

active2x2TB_sub1(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results4, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active4,Answer1,Answer5,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):-
		string_element(Used1,Id1,U1), U1 = 0,               % not used yet
		Y>0,                                                % enough space? 
		string_element(Answer1,~(X*Size+Y-1),W1),     W1=0, % next space ? 
		string_element(Answer1,~((X+1)*Size+Y-1),W2), W2=0 |%(X,Y-1)(X+1,Y-1)
	tail2char(Str,Len1,C1,C2),
	put2charTB(X,~(Y-1),Size,Answer1,C1,C2,Answer2),                      
	pick2charLR(     X,~(Y-1),Size,Answer2,D1,D2),                  % north-west
	pick2charLR(~(X+1),~(Y-1),Size,Answer2,D3,D4),                  % south-west
	try_put_TB(~(X+1-(Len1-1)),~(Y-1),Str,Len1,Answer2,Size,X2,Y2,Flag1),
	search2DTable(id(D1,D2),Table2D,List1),
	search2DTable(id(D3,D4),Table2D,List2),
	double_try_put_LR(Flag1,Flag2,List1,List2,X,~(Y-1),Size,BinWords,Id1, % north-west
			Results1,Results2, Active1,Active2,Answer1,Answer2,Answer3,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	ifOKputTB(Flag2,word(Id1,U,Key,Str,Val,Len1),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer3,Answer4,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	active2x2TB_sub1(Flag2,Flag,BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id2,X,Y,tb,Len2) ,	
			Active3,Active4,Answer4,Answer5,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4).
otherwise.
active2x2TB_sub1( next ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.


%
%
% sub2 対象となる active() について、未使用の単語をひとつずつ当てはめていく。
%
%
active2x2TB_sub2( ok ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = ok,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

active2x2TB_sub2( next ,Flag,BinWords,[     ],Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

%
% 単語wordがすでに使用されていたから、次の単語に移る。
%		
active2x2TB_sub2(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
			string_element(Used1,Id1,U1), U1 =\= 0 |
	active2x2TB_sub2(next,Flag,BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

active2x2TB_sub2(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results4, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active4,Answer1,Answer5,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):-
		string_element(Used1,Id1,U1), U1 = 0,               % not used yet
		Y< ~(Size-1),                                       % enough space?
		string_element(Answer1,~(X*Size+Y+1),W1),     W1=0, % next space?
		string_element(Answer1,~((X+1)*Size+Y+1),W2), W2=0 |%(X,Y+1)(X+1,Y+1)
	tail2char(Str,Len1,C1,C2),
	put2charTB(X,~(Y+1),Size,Answer1,C1,C2,Answer2),                       
	pick2charLR(     X,Y,Size,Answer2,D1,D2),                   % north-west 
	pick2charLR(~(X+1),Y,Size,Answer2,D3,D4),                   % south-west
	try_put_TB(~(X+1-(Len1-1)),~(Y+1),Str,Len1,Answer2,Size,X2,Y2,Flag1),     
	search2DTable(id(D1,D2),Table2D,List1),
	search2DTable(id(D3,D4),Table2D,List2),
	double_try_put_LR(Flag1,Flag2,List1,List2,X,Y,Size,BinWords,Id1, % north-west
			Results1,Results2, Active1,Active2,Answer1,Answer2,Answer3,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	ifOKputTB(Flag2,word(Id1,U,Key,Str,Val,Len1),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer3,Answer4,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	active2x2TB_sub2(Flag2,Flag,BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id2,X,Y,tb,Len2) ,
			Active3,Active4,Answer4,Answer5,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4).
otherwise.
active2x2TB_sub2( next ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.


%
%
% sub3 対象となる active() について、未使用の単語をひとつずつ当てはめていく。
%
%
active2x2TB_sub3( ok ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = ok,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

active2x2TB_sub3( next ,Flag,BinWords,[     ],Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

%
% 単語wordがすでに使用されていたから、次の単語に移る。
%		
active2x2TB_sub3(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
			string_element(Used1,Id1,U1), U1 =\= 0 |
	active2x2TB_sub3(next,Flag,BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

active2x2TB_sub3(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results4, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active4,Answer1,Answer5,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):-
		string_element(Used1,Id1,U1), U1 = 0,               % not used yet
		Y>0,                                                % ecnough space
		string_element(Answer1,~((X+Len2-2)*Size+Y-1),W1), W1=0, %next space?
		string_element(Answer1,~((X+Len2-1)*Size+Y-1),W2), W2=0 |% (X+Len2-2,Y-1) (X+Len2-1,Y-1)
	head2char(Str,Len1,C1,C2),
	put2charTB(~(X+Len2-2),~(Y-1),Size,Answer1,C1,C2,Answer2), 
	pick2charLR(~(X+Len2-2),~(Y-1),Size,Answer2,D1,D2),         % north-west
	pick2charLR(~(X+Len2-1),~(Y-1),Size,Answer2,D3,D4),         % south-west
	try_put_TB(~(X+Len2-2),~(Y-1),Str,Len1,Answer2,Size,X2,Y2,Flag1),
	search2DTable(id(D1,D2),Table2D,List1),
	search2DTable(id(D3,D4),Table2D,List2),
	double_try_put_LR(Flag1,Flag2,List1,List2,~(X+Len2-2),~(Y-1),Size,BinWords,Id1, % north-west
			Results1,Results2, Active1,Active2,Answer1,Answer2,Answer3,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	ifOKputTB(Flag2,word(Id1,U,Key,Str,Val,Len1),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer3,Answer4,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	active2x2TB_sub3(Flag2,Flag,BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id2,X,Y,tb,Len2) ,
			Active3,Active4,Answer4,Answer5,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4).
otherwise.
active2x2TB_sub3( next ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.


%
%
% sub4 対象となる active() について、未使用の単語をひとつずつ当てはめていく。
%
%
active2x2TB_sub4( ok ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = ok,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

active2x2TB_sub4( next ,Flag,BinWords,[     ],Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

%
% 単語wordがすでに使用されていたから、次の単語に移る。
%		
active2x2TB_sub4(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
			string_element(Used1,Id1,U1), U1 =\= 0 |
	active2x2TB_sub4(next,Flag,BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id2,X,Y,tb,Len2) ,
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

active2x2TB_sub4(next,Flag,BinWords,[word(Id1,U,Key,Str,Val,Len1)|MyWords],
		Number,Size,
		Results1,Results4, actve(Id2,X,Y,tb,Len2) ,
		Active1,Active4,Answer1,Answer5,
		HistTB1,HistTB4,HistLR1,HistLR4,Table2D,Table3D,Used1,Used4):-
		string_element(Used1,Id1,U1), U1 = 0,               % not used yet
		Y< ~(Size-1),                                       % enough spave
		string_element(Answer1,~((X+Len2-2)*Size+Y+1),W1), W1=0, %next space?
		string_element(Answer1,~((X+Len2-1)*Size+Y+1),W2), W2=0 |% (X+Len2-2,Y+1) (X+Len2-1,Y+1)
	head2char(Str,Len1,C1,C2),
	put2charTB(~(X+Len2-2),~(Y+1),Size,Answer1,C1,C2,Answer2),  
	pick2charLR(~(X+Len2-2),Y,Size,Answer2,D1,D2),              % north-west 
	pick2charLR(~(X+Len2-1),Y,Size,Answer2,D3,D4),              % south-west
	try_put_TB(~(X+Len2-2),~(Y+1),Str,Len1,Answer2,Size,X2,Y2,Flag1),     
	search2DTable(id(D1,D2),Table2D,List1),
	search2DTable(id(D3,D4),Table2D,List2),
	double_try_put_LR(Flag1,Flag2,List1,List2,~(X+Len2-2),Y,Size,BinWords,Id1,     % north-west
			Results1,Results2, Active1,Active2,Answer1,Answer2,Answer3,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	ifOKputTB(Flag2,word(Id1,U,Key,Str,Val,Len1),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer3,Answer4,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3),
	active2x2TB_sub4(Flag2,Flag,BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id2,X,Y,tb,Len2) ,
			Active3,Active4,Answer4,Answer5,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4).
otherwise.
active2x2TB_sub4( next ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,tb,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag     = next,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.




%
% 第一引数が next ということは、try_put_TB で失敗しているということ。
%
double_try_put_LR(next,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	


%
% 第一引数が ok なので、 start!
%
% 新しい単語はすでに使われている。
double_try_put_LR( ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
		string_element(Used1,Cand1,U1),U1=\=0 |
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	
otherwise.
double_try_put_LR( ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	double_try_put_LR_main(next ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

%
% ２重ループの外側。
%
% OKが出ているから終了。
double_try_put_LR_main(ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List1 が空になったので、終了。
double_try_put_LR_main(next ,Flag,[],List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = AnswerOrg, % 古い解に戻す ！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

double_try_put_LR_main(next ,Flag,[L1|List1],List2,X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	double_try_put_LR_sub(next ,Flag1, L1 ,List2,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	double_try_put_LR_main(Flag1,Flag,    List1 ,List2,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).
	

%
% ２重ループの内側
%
% OKが出ているから終了。
double_try_put_LR_sub(ok ,Flag, L1 ,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List2 が空になったので、終了。
double_try_put_LR_sub(next ,Flag, L1 ,[],X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1, 
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

double_try_put_LR_sub(next ,Flag, L1 ,[L2|List2],X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	double_try_put_LR_core(Flag1, L1 , L2 ,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	double_try_put_LR_sub(Flag1,Flag, L1 , List2 ,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).

%
% 一番内側の計算     (x,y),(x,y+1)
%                  (x+1,y),(x+1,y+1)
double_try_put_LR_core(Flag,elm(Atom1,Id1,rear),elm(Atom2,Id2,head),X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):- 
		Id1=\=Id2, Id1=\=Cand1, Id2=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	try_put_LR(X,~(Y+1-(Len1-1)),Str1,Len1,Answer1,Size,X1,Y1,Flag1),  % rear
	try_put_LR(~(X+1),Y,Str2,Len2,Answer1,Size,X2,Y2,Flag2),           % head
	ifDoubleOK(Flag1,Flag2,Flag),
	ifOKputLR(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,
				Results1,Results2,Active1,Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputLR(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3).

double_try_put_LR_core(Flag,elm(Atom1,Id1,head),elm(Atom2,Id2,rear),X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):- 
		Id1=\=Id2, Id1=\=Cand1, Id2=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	try_put_LR(X,Y,Str1,Len1,Answer1,Size,X1,Y1,Flag1),                    % head
	try_put_LR(~(X+1),~(Y+1-(Len2-1)),Str2,Len2,Answer1,Size,X2,Y2,Flag2), % rear
	ifDoubleOK(Flag1,Flag2,Flag),
	ifOKputLR(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,
				Results1,Results2,[],Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputLR(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3).

otherwise.
% 同じDir方向だから失敗
% Atom1 と Atom2 が 同じ だから、
% Atom1 と Cand1 が 同じ だから、
% Atom2 と Cand1 が 同じ だから、
% Atom1, Atom2 とも、すでに使っていたから
double_try_put_LR_core(Flag,elm(Atom1,Id1,Dir1),elm(Atom2,Id2,Dir2),X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.


ifDoubleOK(ok,ok,Flag):- Flag = ok.
otherwise.
ifDoubleOK(_,_,Flag):- Flag = next.


%  ( 2x2 LR )
%          
%          sub1 sub3
%            WORDS
%          sub2 sub4
%          

% dummy
activeSearch2x2LR1(BinWords,MyWords,Number,Size,
		Results1,Results,_ ,Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	Results  = Results1,
	Active   = Active1,
	Answer   = Answer1,
	HistTB   = HistTB1,
	HistLR   = HistLR1,
	Used     = Used1.

%
% 対象となる active() は 縦置きなので、キャンセル
%
activeSearch2x2LR(BinWords,MyWords,Number,Size,
		Results1,Results, actve(Id,X,Y,tb,Len) ,
		Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	Results  = Results1,
	Active   = Active1,
	Answer   = Answer1,
	HistTB   = HistTB1,
	HistLR   = HistLR1,
	Used     = Used1.
	
%
% 対象となる active() について、上下左右４方向に 単語を一つずつ置いてみる。
%
activeSearch2x2LR(BinWords,MyWords,Number,Size,
		Results1,Results, actve(Id,X,Y,lr,Len) ,
		Active1,Active,Answer1,Answer,
		HistTB1,HistTB,HistLR1,HistLR,Table2D,Table3D,Used1,Used):-
	active2x2LR_sub1( next, Flag1, BinWords,MyWords,Number,Size,
			Results1,Results2, actve(Id,X,Y,lr,Len), 
			Active1,Active2,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	active2x2LR_sub2( Flag1, Flag2, BinWords,MyWords,Number,Size,
			Results2,Results3, actve(Id,X,Y,lr,Len) ,
			Active2,Active3,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3),
	active2x2LR_sub3( next, Flag3, BinWords,MyWords,Number,Size,
			Results3,Results4, actve(Id,X,Y,lr,Len) ,
			Active3,Active4,Answer3,Answer4,
			HistTB3,HistTB4,HistLR3,HistLR4,Table2D,Table3D,Used3,Used4),
	active2x2LR_sub4( Flag3, Flag4, BinWords,MyWords,Number,Size,
			Results4,Results,  actve(Id,X,Y,lr,Len) ,
			Active4,Active,Answer4,Answer,
			HistTB4,HistTB,HistLR4,HistLR,Table2D,Table3D,Used4,Used).


%
%
% sub1 対象となる active() について、未使用の単語をひとつずつ当てはめていく。
%
%
active2x2LR_sub1( ok ,Flag,BinWords,MyWords,Number,Size,
		Results1,Results2, actve(Id,X,Y,lr,Len) ,
		Active1,Active2,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag     = ok,
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = Answer1,
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1.

