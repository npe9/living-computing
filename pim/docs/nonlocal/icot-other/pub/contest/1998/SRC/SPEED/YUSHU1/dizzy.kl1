%
% 第一引数が next ということは、try_put_LR で失敗しているということ。
%
double_try_put_TB(next,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	


%
% 第一引数が ok なので、 start!
%

% 新しい単語はすでに使われている。
double_try_put_TB( ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
		string_element(Used1,Cand1,U1),U1=\=0 |
	Results2 = Results1,
	Active2  = Active1,
	Answer2  = AnswerOrg, % 解を元に戻す
	HistTB2  = HistTB1,
	HistLR2  = HistLR1,
	Used2    = Used1,
	Flag     = next.	
otherwise.
double_try_put_TB( ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	double_try_put_TB_main(next ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2).

%
% ２重ループの外側。
%
% OKが出ているから終了。
double_try_put_TB_main(ok ,Flag,List1,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List1 が空になったので、終了。
double_try_put_TB_main(next ,Flag,[],List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = AnswerOrg, % 古い解に戻す ！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

double_try_put_TB_main(next ,Flag,[L1|List1],List2,X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	double_try_put_TB_sub(next ,Flag1, L1 ,List2,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	double_try_put_TB_main(Flag1,Flag,    List1 ,List2,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).
	

%
% ２重ループの内側
%
% OKが出ているから終了。
double_try_put_TB_sub(ok ,Flag, L1 ,List2,X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = ok,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,  % 新しい解に更新！
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

% List2 が空になったので、終了。
double_try_put_TB_sub(next ,Flag, L1 ,[],X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):-
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1, 
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.

double_try_put_TB_sub(next ,Flag, L1 ,[L2|List2],X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):-
	double_try_put_TB_core(Flag1, L1 , L2 ,X,Y,Size,BinWords,Cand1,
			Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
			HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2),
	double_try_put_TB_sub(Flag1,Flag, L1 , List2 ,X,Y,Size,BinWords,Cand1,
			Results2,Results3, Active2,Active3,AnswerOrg,Answer2,Answer3,
			HistTB2,HistTB3,HistLR2,HistLR3,Table2D,Table3D,Used2,Used3).

%
% 一番内側の計算     (x,y),(x,y+1)
%                  (x+1,y),(x+1,y+1)
double_try_put_TB_core(Flag,elm(Atom1,Id1,rear),elm(Atom2,Id2,head),X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):- 
		Id1=\=Id2, Id1=\=Cand1, Id2=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	try_put_TB(~(X+1-(Len1-1)),Y,Str1,Len1,Answer1,Size,X1,Y1,Flag1),  % rear
	try_put_TB(X,~(Y+1),Str2,Len2,Answer1,Size,X2,Y2,Flag2),           % head
	ifDoubleOK(Flag1,Flag2,Flag),
	ifOKputTB(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,          
				Results1,Results2,Active1,Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputTB(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,          
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3).

double_try_put_TB_core(Flag,elm(Atom1,Id1,head),elm(Atom2,Id2,rear),X,Y,Size,BinWords,Cand1,
		Results1,Results3, Active1,Active3,AnswerOrg,Answer1,Answer3,
		HistTB1,HistTB3,HistLR1,HistLR3,Table2D,Table3D,Used1,Used3):- 
		Id1=\=Id2, Id1=\=Cand1, Id2=\=Cand1,
		string_element(Used1,Id1,U1), U1 = 0 ,
		string_element(Used1,Id2,U2), U2 = 0 |
	searchBinWords(Id1,BinWords,word(_,U1,Key1,Str1,Val1,Len1),Used1),
	searchBinWords(Id2,BinWords,word(_,U2,Key2,Str2,Val2,Len2),Used1),
	try_put_TB(X,Y,Str1,Len1,Answer1,Size,X1,Y1,Flag1),                    % head
	try_put_TB(~(X+1-(Len2-1)),~(Y+1),Str2,Len2,Answer1,Size,X2,Y2,Flag2), % rear
	ifDoubleOK(Flag1,Flag2,Flag),
	ifOKputTB(Flag,word(Id1,U1,Key1,Str1,Val1,Len1),X1,Y1,Size,          
				Results1,Results2,[],Active2,
				Answer1,Answer2,
				HistTB1,HistTB2,HistLR1,HistLR2,Used1,Used2),
	ifOKputTB(Flag,word(Id2,U2,Key2,Str2,Val2,Len2),X2,Y2,Size,          
				Results2,Results3,Active2,Active3,
				Answer2,Answer3,
				HistTB2,HistTB3,HistLR2,HistLR3,Used2,Used3).

otherwise.
% 同じDir方向だから失敗
% Atom1 と Atom2 が 同じ だから、
% Atom1 と Cand1 が 同じ だから、
% Atom2 と Cand1 が 同じ だから、
% Atom1, Atom2 とも、すでに使っていたから
double_try_put_TB_core(Flag,elm(Atom1,Id1,Dir1),elm(Atom2,Id2,Dir2),X,Y,Size,BinWords,Cand1,
		Results1,Results2, Active1,Active2,AnswerOrg,Answer1,Answer2,
		HistTB1,HistTB2,HistLR1,HistLR2,Table2D,Table3D,Used1,Used2):- 
	Flag = next,
	Active2  = Active1,
        Results2 = Results1,
        Answer2  = Answer1,
        HistTB2  = HistTB1,
        HistLR2  = HistLR1,
        Used2    = Used1.


%
% 自家製 単語のcheck!
%
ioutcheck([],Answer,Size):-
	io:outstream([print(["ERROR check finish!! "]),nl]).
ioutcheck([myplace(Id,Key,Str,Val,X,Y,Dir)|Results],Answer,Size):-
	wordExist(Answer,Size,X,Y,Str,Dir,Flag),
	printError(Flag,Str,X,Y,Dir),
	ioutcheck(Results,Answer,Size).

printError(ok,Str,X,Y,Dir).
otherwise.
printError(_,Str,X,Y,Dir):-
	io:outstream([print(["ERROR... ",Str,X,Y,Dir]),nl]).

wordExist(Answer,Size,X,Y,Str,tb,Flag):- wordExist2(Answer,Size,X,Y,Str,tb,Flag).
wordExist(Answer,Size,X,Y,Str,lr,Flag):- 
	string(Str,Len,_)| 
	wordExist(Answer,Size,X,Y,Str,lr,Flag,Len).

wordExist(Answer,Size,X,Y,Str,lr,Flag,Len):-
		Y>0, string_element(Answer,~(X*Size+Y-1),W ), W=\=0 | Flag = no.
wordExist(Answer,Size,X,Y,Str,lr,Flag,Len):-
		~(Y+Len-1)< ~(Size-1), 
		string_element(Answer,~(X*Size+Y+Len),W ),   W=\=0  | Flag = no.
otherwise.
wordExist(Answer,Size,X,Y,Str,lr,Flag,Len):-
	wordExist(Answer,Size,X,Y,Str,lr,Flag,Len,0).

wordExist(Answer,Size,X,Y,Str,lr,Flag,Len,N):- N>=Len | Flag = ok.
wordExist(Answer,Size,X,Y,Str,lr,Flag,Len,N):- N<Len,
		string_element(Answer,~(X*Size+Y+N),W1),
		string_element(Str,N,W2), W1=W2 |
	wordExist(Answer,Size,X,Y,Str,lr,Flag,Len,~(N+1)).
otherwise.
wordExist(Answer,Size,X,Y,Str,lr,Flag,Len,N):- Flag = no.


wordExist2(Answer,Size,X,Y,Str,tb,Flag):- 
	string(Str,Len,_)| 
	wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len).

wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len):-
		X>0, string_element(Answer,~((X-1)*Size+Y),W ), W=\=0 | Flag = no.
wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len):-
		~(X+Len-1)< ~(Size-1), 
		string_element(Answer,~((X+Len)*Size+Y),W ),   W=\=0  | Flag = no.
otherwise.
wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len):-
	wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len,0).

wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len,N):- N>=Len | Flag = ok.
wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len,N):- N<Len,
		string_element(Answer,~((X+N)*Size+Y),W1),
		string_element(Str,N,W2), W1=W2 |
	wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len,~(N+1)).
otherwise.
wordExist2(Answer,Size,X,Y,Str,tb,Flag,Len,N):- Flag = no.

