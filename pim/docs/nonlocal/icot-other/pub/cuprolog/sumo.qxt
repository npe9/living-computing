% Quixote 5Gシンポジウム用プログラム		
%   スポーツ、相撲の知識表現
%   「若ノ花は大関になれるか?」
&program;;

%%% 基礎オブジェクト項の包摂関係(概念の上下関係)の定義  %%%
&subsumption;;		
	スポーツ 	>= {相撲,野球,スキー,サッカー};;
	相撲 		>= {大相撲,学生相撲};;
	野球 		>= {プロ野球,高校野球,六大学野球};;
	サッカー 	>= {ジェーリーグ};;
	スキー 		>= {ノルディック,アルペン};;
	ノルディック 	>= {クロスカントリー,ジャンプ};;
	アルペン 	>= {滑降,回転,大回転,スーパー大回転};;
	力士		>= {花田満,花田勝治,花田光司,花田勝,
			    ローウェンチャドジョージハヘオ};;
	番付		>= {横綱,大関,関脇,小結};;

%%% モジュール間関係(知識分割の枠組)の定義  %%%
&submodule;;
	昭和 >- 相撲;;
	平成五年初場所 >- 相撲;;
	現在 >- 相撲;;
	次場所 >- 相撲;;

%%% ルール定義  %%%
&rule;;
相撲::{	横綱/[上位=横綱, 下位=大関];;
	大関/[上位=横綱, 下位=関脇];;
	関脇/[上位=大関, 下位=小結];;
	ローウェンチャドジョージハヘオ/[国籍=米国,生年月日="S44.5.8"];;
	花田光司/[生年月日="S47.8.12"];;
	花田勝/[生年月日="S46.1.20"];;
	花田満/[生年月日="S25.2.19"];;
	親子[父=花田満, 子=花田勝];;
	親子[父=花田満, 子=花田光司] };;
昭和::{	花田満/[四股名=貴ノ花, 番付=大関];;
	花田勝治/[四股名=若乃花, 番付=横綱] };;
平成五年初場所::{
	ローウェンチャドジョージハヘオ/[四股名=曙, 番付=大関];;
	花田光司/[四股名=貴花田, 番付=関脇];;
	花田勝/[四股名=若花田, 番付=前頭] };;
現在::{	ローウェンチャドジョージハヘオ/[四股名=曙, 番付=横綱];;
	花田光司/[四股名=貴ノ花, 番付=大関];;
	花田勝/[四股名=若ノ花, 番付=関脇] };;

次場所::X/[番付=Z] <= 現在:X/[番付=Y, 成績=優勝],Y/[上位=Z]||
			{X=<力士,Y=<番付};;
		%「今場所優勝した人は、次の場所では番付が一つ上がる」 
&end.

%%% 質問
%%% 「次場所の若ノ花の番付は何ですか?」
?-次場所:花田勝/[番付=X].
%%** Elapse Time of query : 3 sec **
%%** 1 answer exists **
%%** Answer 1 **
%% IF 現在:花田勝.成績 == 優勝 THEN
%%    X == 大関

%%%  「もし今場所若ノ花が優勝したら, 次場所の若ノ花の番付は何ですか?」
?-次場所:花田勝/[番付=X];;&program;;&rule;;現在::花田勝/[成績=優勝];;&end. 
%%** Elapse Time of query : 3 sec **
%%** 1 answer exists **
%%** Answer 1 **
%%    X == 大関
