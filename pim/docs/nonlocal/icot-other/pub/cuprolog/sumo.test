% Quixote 5Gシンポ用プログラム案		
%   スポーツ、相撲の知識表現
%   「若ノ花は大関になれるか?」
		93/5/25 version			津田 宏
デモ手順
1.qxt-start
2.qxt-create-database
3.qxt-show-lattice
4.qxt-show-module-hierarchy
5.qxt-query

% Quixote 5Gシンポ用プログラム案		
%   スポーツ、相撲の知識表現
%   「若ノ花は大関になれるか?」
&program;;
&subsumption;;
	スポーツ >= {相撲,野球,スキー};;
	スキー >= {ノルディック,アルペン};;
	相撲 >= {大相撲,学生相撲};;
	野球 >= {プロ野球,高校野球,六大学野球};;
	ノルディック >= {クロスカントリー,ジャンプ};;
	ノルディック複合 =< {クロスカントリー,ジャンプ};;
	アルペン >= {滑降,回転,大回転,スーパー大回転};;
	アルペン複合 =< {滑降,回転};;
	力士>={花田満,花田勝治,花田光司,花田勝,ローウェンチャドジョージハヘオ};;
	番付>={横綱,大関,関脇,小結};;
&submodule;;
	昭和 >- 相撲;;
	平成五年初場所 >- 相撲;;
	現在 >- 相撲;;
	次場所 >- 相撲;;
&rule;;
相撲::{	横綱/[上位=横綱, 下位=大関];;
	大関/[上位=横綱, 下位=関脇];;
	関脇/[上位=大関, 下位=小結];;
	ローウェンチャドジョージハヘオ/[国籍=米国];;
	親子[父=花田満, 子=花田勝];;
	親子[父=花田満, 子=花田光司] };;
昭和::{	花田満/[四股名=貴ノ花, 番付=大関];;
	花田勝治/[四股名=若乃花, 番付=横綱] };;
平成五年初場所::{
	ローウェンチャドジョージハヘオ/[四股名=曙, 番付=大関];;
	花田光司/[四股名=貴花田, 番付=関脇];;
	花田勝/[四股名=若花田, 番付=前頭] };;
現在::{	ローウェンチャドジョージハヘオ/[四股名=曙, 番付=横綱];;
	花田光司/[四股名=貴ノ花, 番付=大関];;
	花田勝/[四股名=若ノ花, 番付=関脇] };;
次場所::X/[番付=Z] <= 現在:X/[番付=Y, 成績=優勝],Y/[上位=Z]||
			{X=<力士,Y=<番付};;
&end.



?-次場所:花田勝/[番付=X].
%%** Elapse Time of query : 3 sec **
%%** 1 answer exists **
%%** Answer 1 **
%% IF 現在:花田勝.成績 == 優勝 THEN
%%    X == 大関

?-次場所:花田勝/[番付=X];;&program;;&rule;;現在::花田勝/[成績=優勝];;&end.
%%** Elapse Time of query : 3 sec **
%%** 1 answer exists **
%%** Answer 1 **
%%    X == 大関

四ページ目
何が書いてあってもいいはず。
