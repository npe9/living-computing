:- module dbtcui_runCommandParser.

:- public 
    get_commandList/3.
            
:- with_macro pimos.

%get_commandList
    get_commandList(FileName,CommandList,R):-true |
        dbtcui_utility:get_file(FileName,File,R1),
        (   R1 = normal(_)->
                get_commandList1(File,CommandList,R)
        ;
            R1 = abnormal(_)->
                R = R1
        ).


    get_commandList1(File1,CommandList,R):-true|
        File1 = [getl(Line)|File],
        (   Line = -1->
                File        = [],
                CommandList = [],
                R           = normal(success)
        ;
            Line \= -1->
                get_command(Line,CPA,R1),
                (   R1 = normal(_)->
                        get_commandList1(File,CommandList1,R),
                        (   CPA = nil->
                                CommandList = CommandList1
                        ;
                            CPA \=nil->
                                CommandList = [CPA|CommandList1]
                        )
                ;
                    R1 = abnormal(_)->
                        File = [],
                        R    = R1
                )
        ).


%get_command
    get_command(Line,CPA,R):-true|
        sifLibrary:get_commandArguments(Line,Command1,Arguments1),
        get_command1(Command1,Arguments1,CPA,R).

%%load
    get_command1("load",["goal",FileName],CPA,R):-true|
        CPA = {load,nil,goal,[FileName]},
        R  = normal(success).
    get_command1("load",["p","type",FileName],CPA,R):-true|
        CPA = {load,p,type,[FileName]},
        R  = normal(success).
    get_command1("load",["d","type",FileName],CPA,R):-true|
        CPA = {load,d,type,[FileName]},
        R  = normal(success).
    get_command1("load",["p","rule",FileName],CPA,R):-true|
        CPA = {load,p,rule,[FileName]},
        R  = normal(success).
    get_command1("load",["d","rule",FileName],CPA,R):-true|
        CPA = {load,d,rule,[FileName]},
        R  = normal(success).
    get_command1("load",["p","pom",FileName],CPA,R):-true|
        CPA = {load,p,pom,[FileName]},
        R  = normal(success).
    get_command1("load",["d","pom",FileName],CPA,R):-true|
        CPA = {load,d,pom,[FileName]},
        R  = normal(success).

%compile
    get_command1("compile",["goal",FileName],CPA,R):-true|
        CPA = {compile,nil,goal,[FileName]},
        R  = normal(success).
    get_command1("compile",["p","type",FileName],CPA,R):-true|
        CPA = {compile,p,type,[FileName]},
        R  = normal(success).
    get_command1("compile",["d","type",FileName],CPA,R):-true|
        CPA = {compile,d,type,[FileName]},
        R  = normal(success).
    get_command1("compile",["p","rule",FileName],CPA,R):-true|
        CPA = {compile,p,rule,[FileName]},
        R  = normal(success).
    get_command1("compile",["d","rule",FileName],CPA,R):-true|
        CPA = {compile,d,rule,[FileName]},
        R  = normal(success).
    get_command1("compile",["p","pom",FileName],CPA,R):-true|
        CPA = {compile,p,pom,[FileName]},
        R  = normal(success).
    get_command1("compile",["d","pom",FileName],CPA,R):-true|
        CPA = {compile,d,pom,[FileName]},
        R  = normal(success).

%%set
    get_command1("set",["p","solver","user"],CPA,R):-true|
        CPA = {set,p,solver,[user]},
        R  = normal(success).
    get_command1("set",["d","solver","user"],CPA,R):-true|
        CPA = {set,d,solver,[user]},
        R  = normal(success).
    get_command1("set",["p","solver","system"],CPA,R):-true|
        CPA = {set,p,solver,[system]},
        R  = normal(success).
    get_command1("set",["d","solver","system"],CPA,R):-true|
        CPA = {set,d,solver,[system]},
        R  = normal(success).

    get_command1("set",["gp",Pos],CPA,R):-true|
	sToiList([Pos],Arguments,R),
        CPA = {set,nil,gp,Arguments}.
    get_command1("set",["goal"|List],CPA,R):-true|
	append_string:append_string(List,Goal),
        CPA = {set,nil,goal,[Goal]},
	R=normal(success).

    get_command1("set",["p","view",View],CPA,R):-true|
	sToaList([View],Arguments,R),
        CPA = {set,p,useView,Arguments}.
    get_command1("set",["d","view",View],CPA,R):-true|
	sToaList([View],Arguments,R),
        CPA = {set,d,useView,Arguments}.
    get_command1("set",["p","sp"|SPList],CPA,R):-true|
	sToaList(SPList,Arguments,R),
        CPA = {set,p,useSpPriority,Arguments}.
    get_command1("set",["d","sp"|SPList],CPA,R):-true|
	sToaList(SPList,Arguments,R),
        CPA = {set,d,useSpPriority,Arguments}.
    get_command1("set",["p","unit"|UnitList],CPA,R):-UnitList\=[]|
	sToaList(UnitList,Arguments,R),
        CPA = {set,p,useUnit,Arguments}.
    get_command1("set",["d","unit"|UnitList],CPA,R):-UnitList\=[]|
	sToaList(UnitList,Arguments,R),
        CPA = {set,d,useUnit,Arguments}.

    get_command1("set",["p","pl",PL],CPA,R):-true|
	set_pl(PL,Arguments,R),
        CPA = {set,p,pl,Arguments}.
    get_command1("set",["d","pl",PL],CPA,R):-true|
	set_pl(PL,Arguments,R),
        CPA = {set,d,pl,Arguments}.
    get_command1("set",["p","pt","h"],CPA,R):-true|
        CPA = {set,p,pt,[h]},
	R=normal(success).
    get_command1("set",["d","pt","h"],CPA,R):-true|
        CPA = {set,d,pt,[h]},
	R=normal(success).
    get_command1("set",["p","pt","e"],CPA,R):-true|
        CPA = {set,p,pt,[e]},
	R=normal(success).
    get_command1("set",["d","pt","e"],CPA,R):-true|
        CPA = {set,d,pt,[e]},
	R=normal(success).
    get_command1("set",["p","cl",CL],CPA,R):-true|
	set_cl(CL,Arguments,R),
        CPA = {set,p,cl,Arguments}.
    get_command1("set",["d","cl",CL],CPA,R):-true|
	set_cl(CL,Arguments,R),
        CPA = {set,d,cl,Arguments}.

    get_command1("set",["p","sim",Sim],CPA,R):-true|
	set_similarity(Sim,Arguments,R),
        CPA = {set,p,similarity,Arguments}.
    get_command1("set",["d","sim",Sim],CPA,R):-true|
	set_similarity(Sim,Arguments,R),
        CPA = {set,d,similarity,Arguments}.
    get_command1("set",["p","weight",W],CPA,R):-true|
	set_weight(W,Arguments,R),
        CPA = {set,p,weight,Arguments}.
    get_command1("set",["d","weight",W],CPA,R):-true|
	set_weight(W,Arguments,R),
        CPA = {set,d,weight,Arguments}.
    get_command1("set",["p","ptst"|PsiTermSimTB],CPA,R):-PsiTermSimTB\=[]|
        set_psiTermSimTB(PsiTermSimTB,Arguments,R),
        CPA = {set,p,psiTermSimTB,Arguments}.
    get_command1("set",["d","ptst"|PsiTermSimTB],CPA,R):-PsiTermSimTB\=[]|
        set_psiTermSimTB(PsiTermSimTB,Arguments,R),
        CPA = {set,d,psiTermSimTB,Arguments}.
    get_command1("set",["p","ptaw",PsiTermAttWeight],CPA,R):-true|
        set_psiTermAttWeight(PsiTermAttWeight,Arguments,R),
        CPA = {set,p,psiTermAttWeight,Arguments}.
    get_command1("set",["d","ptaw",PsiTermAttWeight],CPA,R):-true|
        set_psiTermAttWeight(PsiTermAttWeight,Arguments,R),
        CPA = {set,d,psiTermAttWeight,Arguments}.

    get_command1("set",["p","tf","on"],CPA,R):-true|
        CPA = {set,p,tf,[on]},
	R=normal(success).
    get_command1("set",["d","tf","on"],CPA,R):-true|
        CPA = {set,d,tf,[on]},
	R=normal(success).
    get_command1("set",["p","tf","off"],CPA,R):-true|
        CPA = {set,p,tf,[off]},
	R=normal(success).
    get_command1("set",["d","tf","off"],CPA,R):-true|
        CPA = {set,d,tf,[off]},
	R=normal(success).
    get_command1("set",["p","sr"|SpyRuleList],CPA,R):-true|
	sToaList(SpyRuleList,Arguments,R),
        CPA = {set,p,sr,Arguments}.
    get_command1("set",["d","sr"|SpyRuleList],CPA,R):-true|
	sToaList(SpyRuleList,Arguments,R),
        CPA = {set,d,sr,Arguments}.
    get_command1("set",["p","sg"|SpyGateList],CPA,R):-true|
        get_spyGateList(SpyGateList,Arguments,R),
        CPA = {set,p,sg,Arguments}.
    get_command1("set",["d","sg"|SpyGateList],CPA,R):-true|
        get_spyGateList(SpyGateList,Arguments,R),
        CPA = {set,d,sg,Arguments}.

%solve
    get_command1("solve",["p"],CPA,R):-true|
        CPA = {solve,p,nil,[]},
	R=normal(success).
    get_command1("solve",["d"],CPA,R):-true|
        CPA = {solve,d,nil,[]},
	R=normal(success).
    get_command1("solve",["p"|List],CPA,R):-List\=[]|
	append_string:append_string(List,Goal),
        CPA = {solve,p,nil,[Goal]},
	R=normal(success).
    get_command1("solve",["d"|List],CPA,R):-List\=[]|
	append_string:append_string(List,Goal),
        CPA = {solve,d,nil,[Goal]},
	R=normal(success).
%other
    get_command1(nil,_,CPA,R):-true|
        CPA = nil,
        R   = normal(success).
otherwise.
    get_command1(C,P,_,R):-true|
        R  = abnormal({cui,'Illegal command',{C,P}}).


%%%%%internal method
    sToiList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToiList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   integer(A)->
                sToiList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({ui,'Illegal integer',A})
        ).

    sToaList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToaList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   atom(A)->
                sToaList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({ui,'Illegal atom',A})
        ).


%%%%%%

    get_spyGateList([],L,R):-true|
        L = [],
        R = normal(success).
    get_spyGateList(["call"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [call|L1].
    get_spyGateList(["redu"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [redu|L1].
    get_spyGateList(["fail"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [fail|L1].
otherwise.
    get_spyGateList([H|_],_,R):-true|
        R = abnormal({drs,'Illegal Argument',H}).


%%%%%
    set_similarity(Sim1,Arguments,Result):-true|
        sToiList([Sim1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[Sim],
                ( Sim>0,Sim=<100 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({drs,'Illegal similarity',Sim})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_weight(W1,Arguments,Result):-true|
        sToiList([W1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[W],
                ( W>0,W=<10 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({drs,'Illegal weight',W})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_psiTermSimTB([A1,B1,C1,D1,E1,F1],Arguments,Result):-true|
        sToiList([A1,B1,C1,D1,E1,F1],Arguments1,R1),
        ( R1 = normal(success)->
		Arguments1=[A,B,C,D,E,F],
                ( 100>=A,A>=B,B>=C,C>=D,D>=E,E>=F,F>0->
                   Arguments = [{A,B,C,D,E,F}],Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({drs,'Illegal psiTermSimTB',[A,B,C,D,E,F]})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).
otherwise.
    set_psiTermSimTB(TB,_,Result):-true|
        Result = abnormal({drs,'Illegal psiTermSimTB',TB}).

    set_psiTermAttWeight(PsiTermAttWeight1,Arguments,Result):-true|
        sToiList([PsiTermAttWeight1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[PsiTermAttWeight],
                (  PsiTermAttWeight>0,PsiTermAttWeight=<10->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({drs,'Illegal psiTermAttWeight',PsiTermAttWeight})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

%%set pl
    set_pl(PL1,Arguments,Result):-true|
        sToiList([PL1],Arguments,R1),
	( R1 = normal(success)->
            Arguments=[PL],
	    ( integer(PL),PL>0->
	        Result = normal(success)
	    ;
	     otherwise;
	      true->
	        Result = abnormal({drs,'Illegal pl',PL})
	    )
	;
	  R1 = abnormal(_)->
	    Result = R1
	).

%set_cl
    set_cl(CL1,Arguments,Result):-true|
	sToiList([CL1],Arguments1,Result1),
	( Result1 = normal(success),Arguments1=[CL],CL>=0->
	    Arguments = [CL],Result= normal(success)
	;
	  Result1 = normal(success),Arguments1=[-1]->
	    Arguments = [infinite],Result= normal(success)
	;
	otherwise;
	  true->
	    Result = Result1
	).