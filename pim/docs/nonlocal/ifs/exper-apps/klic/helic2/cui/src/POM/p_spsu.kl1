:- module spScopeUnitTable.

:- public 
    create/2,
    quick_create/2.
            
:- with_macro pimos.

    quick_create({SpList,SpSUOrgList,SpSUList},I):- true |
        hset:create(SpList,SpB),
        hLibrary:pool(keyed_bag,SpSUOrgKB1),
        hLibrary:pool(keyed_bag,SpSUKB1),
        put_all(SpSUOrgList,SpSUOrgKB1,SpSUOrgKB),
        put_all(SpSUList,SpSUKB1,SpSUKB),
        loop(I,SpB,SpSUOrgKB,SpSUKB).

    create(SPList,I):- true |
        initiate(SPList,SpB,SpSUOrgKB,SpSUKB),
        loop(I,SpB,SpSUOrgKB,SpSUKB).

    initiate(SPList,SpB,SpSUOrgKB,SpSUKB):- true |
        hset:create(SpB1),
        hLibrary:pool(keyed_bag,SpSUOrgKB1),
        hLibrary:pool(keyed_bag,SpSUKB1),
        initiate1(SPList,SpB1,SpSUOrgKB1,SpSUKB1,SpB,SpSUOrgKB,SpSUKB).

    initiate1([],SpB1,SpSUOrgKB1,SpSUKB1,SpB,SpSUOrgKB,SpSUKB):-true |
        SpB = SpB1,
        SpSUOrgKB = SpSUOrgKB1,
        SpSUKB = SpSUKB1.
    initiate1([{SP,SUListList}|T],SpB1,SpSUOrgKB1,SpSUKB1,SpB,SpSUOrgKB,SpSUKB):-true |
        SpB1 = [put(SP)|SpB2],
        SpSUOrgKB1 = [empty(SP,YN)|SpSUOrgKB2],
        (   YN = yes ->
                SpSUOrgKB2 = [put(SP,SUListList)|SpSUOrgKB3],

%                hset:create(SUListList,SUB),
%                SpSUOrgKB2 = [put(SP,SUB)|SpSUOrgKB3],

                initiate10(SUListList,SP,SpSUKB1,SpSUKB2)
        ;
            YN = no-> %display_console("error spsu pool") 
                SpB2 = SpB1,
                SpSUOrgKB3 = SpSUOrgKB2,
                SpSUKB2 = SpSUKB1
                     %onaji sp name ga sonzai siteha ikenai
                     %hontouha error
        ),
        initiate1(T,SpB2,SpSUOrgKB3,SpSUKB2,SpB,SpSUOrgKB,SpSUKB).

    initiate10([],_,SpSUKB1,SpSUKB):-true |
        SpSUKB = SpSUKB1.
    initiate10([SUList|T],SP,SpSUKB1,SpSUKB):-true |
        initiate11(SUList,SP,SpSUKB1,SpSUKB2),
        initiate10(T,SP,SpSUKB2,SpSUKB).    

    initiate11([_],_,SpSUKB1,SpSUKB):-true |
        SpSUKB = SpSUKB1.
    initiate11([SU|T],SP,SpSUKB1,SpSUKB):-T\=[] |
        initiate111(T,SU,SP,SpSUKB1,SpSUKB2),
        initiate11(T,SP,SpSUKB2,SpSUKB).

    initiate111([],_,_,SpSUKB1,SpSUKB):-true |
        SpSUKB = SpSUKB1.
    initiate111([SU2|T],SU1,SP,SpSUKB1,SpSUKB):-true |
        put_SU(SU2,SU1,SP,SpSUKB1,SpSUKB2),
        initiate111(T,SU1,SP,SpSUKB2,SpSUKB).

    put_SU([],  _, _,SpSUKB1,SpSUKB):-true |
        SpSUKB = SpSUKB1.
    put_SU([SU2|T],SU1,SP,SpSUKB1,SpSUKB):-true |
        put_SU1(SU1,SU2,SP,SpSUKB1,SpSUKB2),
        put_SU(T,SU1,SP,SpSUKB2,SpSUKB).
otherwise.
    put_SU(SU2,SU1,SP,SpSUKB1,SpSUKB):-atom(SU2) |
        put_SU1(SU1,SU2,SP,SpSUKB1,SpSUKB).

    put_SU1([],  _, _,SpSUKB1,SpSUKB):-true |
        SpSUKB = SpSUKB1.
    put_SU1([SU1|T],SU2,SP,SpSUKB1,SpSUKB):-true |
        SpSUKB1 = [put(SP,{SU1,SU2})|SpSUKB2],
        put_SU1(T,SU2,SP,SpSUKB2,SpSUKB).
otherwise.
    put_SU1(SU1,SU2,SP,SpSUKB1,SpSUKB):-atom(SU1),atom(SU2) |
        SpSUKB1 = [put(SP,{SU1,SU2})|SpSUKB].

    loop([],SpB,SpSUOrgKB,SpSUKB):-true |
        SpB = [],
        SpSUOrgKB = [],
        SpSUKB = [].
    loop([get_spList(SPList)|T],SpB1,SpSUOrgKB,SpSUKB):-true |
        SpB1 = [get_all(SPList)|SpB2],
        loop(T,SpB2,SpSUOrgKB,SpSUKB).
    loop([get_spOrgList(SPList)|T],SpB,SpSUOrgKB1,SpSUKB):-true |
        SpSUOrgKB1 = [carbon_copy(SPList)|SpSUOrgKB2],
        loop(T,SpB,SpSUOrgKB2,SpSUKB).
    loop([get_scopeUnitOrgList(SP,SUList)|T],SpB,SpSUOrgKB1,SpSUKB):-true |
        SpSUOrgKB1 = [carbon_copy(SP,SUList1)|SpSUOrgKB2],
        SUList1 = [SUList],
        loop(T,SpB,SpSUOrgKB2,SpSUKB).
    loop([get_scopeUnitList(SP,SUList)|T],SpB,SpSUOrgKB,SpSUKB1):-true |
        SpSUKB1 = [carbon_copy(SP,SUList1)|SpSUKB2],

%        SUList1 = [SUList], %show sp
        SUList1 = SUList, 

        loop(T,SpB,SpSUOrgKB,SpSUKB2).
    loop([get_all(ALL)|T],SpB1,SpSUOrgKB1,SpSUKB1):-true |
        SpB1 = [get_all(SpList)|SpB2],
        SpSUOrgKB1 = [carbon_copy(SpSUOrgList)|SpSUOrgKB2],
        SpSUKB1    = [carbon_copy(SpSUList)|SpSUKB2],
        ALL={SpList,SpSUOrgList,SpSUList},
        loop(T,SpB2,SpSUOrgKB2,SpSUKB2).
    loop([is_sp(SP,YN)|T],SpB1,SpSUOrgKB,SpSUKB):-true |
        SpB1 = [in(SP,YN)|SpB2],
        loop(T,SpB2,SpSUOrgKB,SpSUKB).

    put_all([],KB1,KB):-true|
        KB = KB1.
    put_all([{Key,Data}|T],KB1,KB):-true|
        KB1=[put(Key,Data)|KB2],
        put_all(T,KB2,KB).
