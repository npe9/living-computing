act13_2::with_intent(a_object=person[name=>"mary"], object= #taking_away, 
                goal= hide(agent=person[name=>"mary"],  
                           object= #hard_hitting)). 

%仕様3.9
act13_3:: with_intent(a_object=person[name=>"mary"], object= #taking_away,
                  goal= use(agent=person[name=>"mary"],
                                   object=handbag[name=>"handbag1"])).
%%New (end)

%%Ni act14:: -with_intent(a_object=person[name=>"mary"], 
%%Ni                   object= use(agent=person[name=>"mary"],
