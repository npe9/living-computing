&define_absolute_rule.
&define_RBR_rule.     {

act0::hate(agent=person[name=>"mary"], object=person[name=>"jane"]).
act1::wait_for(agent=person[name=>"mary"], object=person[name=>"jane"], 
                 purpose=hurt(agent=person[name=>"mary"],
object=person[name=>"jane"]),
                 time= night[name=>"night1"],   place= street[name=>"street1"]).
act2::hit(agent=person[name=>"mary"], object=person[name=>"jane"], 
            time= night[name=>"night1"], place= street[name=>"street1"], manner="hard", 
            implement=fist[possessor=>person[name=>"mary"]]) 
                       |#hard_hitting.
act3::with_intent(a_object=person[name=>"mary"], object= #hard_hitting, 
               goal=hurt(agent=person[name=>"mary"], object=person[name=>"jane"])).
act4:: -with_criminal_intent(a_object=person[name=>"mary"], object= #hard_hitting, goal=crime_of_robbery).
act5::fall_down(agent=person[name=>"jane"], place= street[name=>"street1"], 
               condition= #hard_hitting)
                       |#falling.
act6::bruise(agent=person[name=>"jane"], place= street[name=>"street1"], 
               object=back_head[possessor=>person[name=>"jane"]], condition= #falling)
                       |#bruise.
act7::faint(agent=person[name=>"jane"], condition= #bruise)|#fainting.
act8::mistake(agent=person[name=>"mary"], object= #fainting,
               goal= die(agent=person[name=>"jane"], condition= #bruise),
               time= #fainting).
act9::has_ownership(a_object=person[name=>"jane"], 
                         object=handbag[name=>"handbag1"]).
act10::has_occupied(a_object=person[name=>"jane"], 
                     object=handbag[name=>"handbag1"],
                     time= #hard_hitting)|#ownership.
act11::recognize(a_object=person[name=>"mary"], object= #ownership,
                    time= #hard_hitting).
act12::take_away(agent=person[name=>"mary"], 
                object=handbag[name=>"handbag1"], 
                source=person[name=>"jane"])
                        |#taking_away.
act12_2::in_short_time(a_object= #taking_away, basis= #fainting).

