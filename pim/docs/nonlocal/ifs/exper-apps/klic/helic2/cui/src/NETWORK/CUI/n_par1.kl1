%help
    parse("help",[],Command,AgentName,Parameter,Arguments,Result):-true|
        Command = send,AgentName=nil,Parameter = help,Arguments=[],Result=normal(success).
    parse("help",[C],Command,AgentName,Parameter,Arguments,Result):-true|
        Command = send,AgentName=nil,Parameter = help,Arguments=[C],Result=normal(success).

otherwise.
    parse(_,_,_,_,_,_,Result):-true|
        Result = abnormal({ui,'Illegal command or arguments',nil}).

    sToiList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToiList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   integer(A)->
                sToiList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({cui,'Illegal integer',A})
        ).

    sToaList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToaList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   atom(A)->
                sToaList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({cui,'Illegal atom',A})
        ).
                

    get_spyGateList([],L,R):-true|
        L = [],
        R = normal(success).
    get_spyGateList(["call"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [call|L1].
    get_spyGateList(["redu"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [redu|L1].
    get_spyGateList(["fail"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [fail|L1].
otherwise.
    get_spyGateList([H|_],_,R):-true|
        R = abnormal({cui,'Illegal Argument',H}).

%%%%%
    set_similarity(Sim1,Arguments,Result):-true|
        sToiList([Sim1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[Sim],
                ( Sim>0,Sim=<100 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal similarity',Sim})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_weight(W1,Arguments,Result):-true|
        sToiList([W1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[W],
                ( W>0,W=<10 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal weight',W})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_psiTermSimTB([A1,B1,C1,D1,E1,F1],Arguments,Result):-true|
        sToiList([A1,B1,C1,D1,E1,F1],Arguments1,R1),
        ( R1 = normal(success)->
		Arguments1=[A,B,C,D,E,F],
                ( 100>=A,A>=B,B>=C,C>=D,D>=E,E>=F,F>0->
                   Arguments = [{A,B,C,D,E,F}],Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal psiTermSimTB',[A,B,C,D,E,F]})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).
otherwise.
    set_psiTermSimTB(TB,_,Result):-true|
        Result = abnormal({cui,'Illegal psiTermSimTB',TB}).

    set_psiTermAttWeight(PsiTermAttWeight1,Arguments,Result):-true|
        sToiList([PsiTermAttWeight1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[PsiTermAttWeight],
                (  PsiTermAttWeight>0,PsiTermAttWeight=<10->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal psiTermAttWeight',PsiTermAttWeight})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

%%set pl
    set_pl(PL1,Arguments,Result):-true|
        sToiList([PL1],Arguments,R1),
	( R1 = normal(success)->
            Arguments=[PL],
	    ( integer(PL),PL>0->
	        Result = normal(success)
	    ;
	     otherwise;
	      true->
	        Result = abnormal({cui,'Illegal pl',PL})
	    )
	;
	  R1 = abnormal(_)->
	    Result = R1
	).


%set_cl
    set_cl(CL1,Arguments,Result):-true|
	sToiList([CL1],Arguments1,Result1),
	( Result1 = normal(success),Arguments1=[CL],CL>=0->
	    Arguments = [CL],Result= normal(success)
	;
	  Result1 = normal(success),Arguments1=[-1]->
	    Arguments = [infinite],Result= normal(success)
	;
	otherwise;
	  true->
	    Result = Result1
	).

