		Command,AgentName,Parameter,Arguments,Result):-true|
        Command = trans,AgentName=nil,Parameter = goal,
	Arguments=[FileName1,FileName2],Result=normal(success).

    parse("trans",["type",FileName1,FileName2],
		Command,AgentName,Parameter,Arguments,Result):-true|
        Command = trans,AgentName=p,Parameter = type,
	Arguments=[FileName1,FileName2],Result=normal(success).
    parse("trans",["rule",FileName1,FileName2],
		Command,AgentName,Parameter,Arguments,Result):-true|
        Command = trans,AgentName=p,Parameter = rule,
	Arguments=[FileName1,FileName2],Result=normal(success).
    parse("trans",["pom",FileName1,FileName2],
		Command,AgentName,Parameter,Arguments,Result):-true|
        Command = trans,AgentName=p,Parameter = pom,
	Arguments=[FileName1,FileName2],Result=normal(success).

