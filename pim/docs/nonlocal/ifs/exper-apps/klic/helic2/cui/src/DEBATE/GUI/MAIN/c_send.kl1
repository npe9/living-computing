:- module dbtcui_send.
:- public 
    goal/4,

    useView/4,
    useSpPriority/4,
    useUnit/4,

    view/5,
    sp/5,
    unit/5,

    solver/4,
    pl/4,
    pt/4,
    cl/4,
    similarity/4,
    weight/4,
    psiTermSimTB/4,
    psiTermAttWeight/4.
            
:- with_macro pimos. 

%goal
    goal(AgentName,{DBT,CGS1},Data,Protocol):-true|
        CGS1 = [get(AgentName,currentGoal,CurrentGoal),
		get(AgentName,dispGoalList,DispGoalList)|CGS],
        (   DispGoalList = nil->
                dbtcui_utility:make_errorProtocol(AgentName,
			{cui,'Goal file not read',nil},Protocol)
        ;
            DispGoalList \= nil->
                make_protocol(normal(success),goal,AgentName,[{CurrentGoal,DispGoalList}],Protocol)
        ),
        Data = {DBT,CGS}.

%useView
    useView(AgentName,{DBT1,CGS},Data,Protocol):-true|
        dbtcui_protocolPool:get(AgentName,show,useView,nil,ProtocolList),
        send(ProtocolList,DBT1,DBT,UseView,Result),
        make_protocol(Result,useView,AgentName,UseView,Protocol),
        Data = {DBT,CGS}.

%useSpPriority
    useSpPriority(AgentName,{DBT1,CGS},Data,Protocol):-true|
        dbtcui_protocolPool:get(AgentName,show,useView,nil,ProtocolList),
        send(ProtocolList,DBT1,DBT,UseView,Result),
        make_protocol(Result,useSpPriority,AgentName,UseView,Protocol),
        Data = {DBT,CGS}.

%useUnit
    useUnit(AgentName,{DBT1,CGS},Data,Protocol):-true|
        dbtcui_protocolPool:get(AgentName,show,useUnit,nil,ProtocolList),
        send(ProtocolList,DBT1,DBT,UseUnit,Result),
        make_protocol(Result,useUnit,AgentName,UseUnit,Protocol),
        Data = {DBT,CGS}.

