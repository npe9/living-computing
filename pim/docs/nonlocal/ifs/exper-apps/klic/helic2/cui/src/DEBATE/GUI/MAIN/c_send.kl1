        Data = {DBT,CGS}.

%%%%%%%%%%%%internal method
%send
    send(Protocol,DBT1,DBT,RD,Result):-true |
        DBT1 = [Protocol|DBT],
	Protocol = {_,[Protocol1]},
        is_normal(Protocol1,RD,Result).

%%is_normal
    is_normal(get_parameter(_,Info1,normal(_)),Info,Result):-true|
        Info    = Info1,
        Result  = normal(success).
otherwise.
    is_normal(get_parameter(_,_,abnormal(Reason)),_,Result):-true|
        Result = abnormal(Reason).

%make_protocol
    make_protocol(abnormal(Reason),_,AgentName,_,Protocol):-true|
        dbtcui_utility:make_errorProtocol(AgentName,Reason,Protocol).
    make_protocol(normal(success),ProtocolName,AgentName,Arguments,Protocol):-true|
        Protocol = receive(AgentName,ProtocolName,Arguments,_).


