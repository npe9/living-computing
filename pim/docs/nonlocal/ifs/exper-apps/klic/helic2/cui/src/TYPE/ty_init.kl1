:- module ty_init.
:- with_macro pimos.

:- public default_typeDB_size/1.
default_typeDB_size(X):-true|X=3000.

:- public ty_debug_tag/2.
%ty_debug_tag(debug_tag#tcmp,X):-X=true.
%ty_debug_tag(debug_tag#tatt,X):-X=true.
%ty_debug_tag(debug_tag#tlat,X):-X=true.
%ty_debug_tag(debug_tag#att,X):-X=true.
%ty_debug_tag(debug_tag#lat,X):-X=true.
%otherwise.
ty_debug_tag(_,X):-X=false.

:-public ty_debug_print/1.
% on/off
ty_debug_print(X):-X=off.

:-public ty_compact_occurrence_threshold/1.
ty_compact_occurrence_threshold(Threshold):-Threshold = 3.
