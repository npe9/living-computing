:- module dbtcui_help.

:- public 
    help/1.
    help/2.
            
:- with_macro pimos. 

%help/3
    help(Protocol):-true|
        Help = [
"        ab              help            run             start",
"        add             load            set             trans",
"        clear           quit            show  ",
"        compile         remove          solve"],
        make_protocol(normal(success),help,p,Help,Protocol).

    help(Command,Protocol):-true|
        get_help(Command,Help,Result),
        make_protocol(Result,help,p,Help,Protocol).

%%%%%
    get_help("all",Help,Result):-true|
        Help =[
"    compile             goal            ReadFileName",
"    compile     <p|d>   <type|rule|pom> ReadFileName",
"    load                goal            ReadFileName",
"    load        <p|d>   <type|rule|pom> ReadFileName",
"    set         <p|d>   solver          <user|system>",
"    set                 gp              Position",
"    set                 goal            Goal",
"    set         <p|d>   view            View",
"    set         <p|d>   sp              SP-list",
"    set         <p|d>   unit            Unit-list",
"    set         <p|d>   pl              Int",
"    set         <p|d>   pt              <h|e>",
"    set         <p|d>   cl              Int",
"    set         <p|d>   sim             Int",
"    set         <p|d>   weight          Int",
"    set         <p|d>   ptst            Int Int Int Int Int Int",
"    set         <p|d>   ptaw            Int",
"    set         <p|d>   tf              <on|off>",
"    set         <p|d>   sr              RuleName-list",
"    set         <p|d>   sg              SpyGate-ist",
"    run                                 ReadFileName",
"    solve       <p|d>                   [Goal]",
"    ab          <p|d>",
"    start                               [Goal]",
"    quit  ",
"    show                goal",
"    show        <p|d>   view            [View]",
