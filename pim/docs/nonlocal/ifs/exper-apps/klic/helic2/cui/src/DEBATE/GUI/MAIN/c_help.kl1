"    show        <p|d>   unit            [Unit]",
"    show        <p|d>   solver",
"    show        <p|d>   pl",
"    show        <p|d>   pt",
"    show        <p|d>   cl",
"    show        <p|d>   sim",
"    show        <p|d>   weight",
"    show        <p|d>   ptst",
"    show        <p|d>   ptaw",
"    show        <p|d>   tf",
"    show        <p|d>   sr",
"    show        <p|d>   sg",
"    add         <p|d>   sr              RuleName-list",
"    add         <p|d>   sg              SpyGate-list",
"    remove      <p|d>   sr              RuleName-list",
"    remove      <p|d>   sg              SpyGate-list",
"    clear       <p|d>   sr",
"    clear       <p|d>   sg",
"    trans               <goal|type|rule|pom> ReadFileName WriteFileName",
"    help                                [Command]"],
        Result = normal(success).

    get_help("compile",Help,Result):-true|
        Help =[
"    compile             goal            ReadFileName",
"    compile     <p|d>   <type|rule|pom> ReadFileName"],
        Result = normal(success).

