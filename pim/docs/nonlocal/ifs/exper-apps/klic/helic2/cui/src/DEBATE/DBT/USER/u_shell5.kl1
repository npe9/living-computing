:- module dbtcui_shellUtility5.

:- public 
    get_help/1,
    get_help/2.
            
:- with_macro pimos. 

%help/3
    get_help(Help,R):-true|
        Help = [
        "    add        end             help            notice          set",
        "    backward   finish          jump            pose            show",
        "    cancel     forward         justify         previous",
        "    clear      focus           next            remove"],
        R = normal(success).

    get_help(Command,Help,R):-true|
        get_help1(Command,Help,R).

%get_help
    get_help1("all",Help,Result):-true|
        Help =[
        "    pose",
        "    notice",
        "    cancel",
        "    finish",
        "    backward",
        "    forward",
        "    next",
        "    previous",
        "    focus",
