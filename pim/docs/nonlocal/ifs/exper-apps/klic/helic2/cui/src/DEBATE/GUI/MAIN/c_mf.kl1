:- module dbtcui_makeFile.

:- public 
    goal/2.

:- with_macro pimos.

%goal
    goal(Goal,R):-true|
        dbtcui_defaultName:get_inputFileName(InputFileName),
        dbtcui_utility:put_file(InputFileName,InputFile,R1),
        (   R1 = normal(success)->
                InputFile = 
                    [
                        putl("&define_goal."),
                        putl("{"),
                        putb("    "),putb(Goal),
                        putl("}")
                    ],
                R = normal(success)
        ;
            R1 = abnormal(_)->
                R = R1
        ).
