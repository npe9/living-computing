        Info  = {A,B,C,{X,PT,Z}},
        DisplayArgInfo = {_,LArg},
        sendProtocol_getCommandArguments(argument,[LArg],
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

