%send psiTermAttWeight
    get_commandArguments1(send,psiTermAttWeight,_,
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Info1 = {RBR1,B,C,D},
        RBR1  = [get_parameter(psiTermAttWeight,PsiTermAttWeight,R1)|RBR],
        Info  = {RBR,B,C,D},
        (   R1 = normal(success)->
                sendProtocol_getCommandArguments(psiTermAttWeight,PsiTermAttWeight,
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).

