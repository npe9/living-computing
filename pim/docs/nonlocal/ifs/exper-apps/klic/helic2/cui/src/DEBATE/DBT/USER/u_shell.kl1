%%%%%%%internal method

%sendProtocol_getCommandArguments
    sendProtocol_getCommandArguments(argument,[LArg],
                {Pool1,Info1,{FLArg,CLArg},CSS1},Retern,CPA,R):-true|
        dbtcui_shellUtility4:get_argumentInfo({Pool1,Info1,{FLArg,CLArg},CSS1},LArg,
                {Pool2,Info,CSS},ArgumentInfo,R1),
        Pool2 = [make(nh,NH)|Pool],
        (   R1 = normal(success)->
                NH = [receive(argument,ArgumentInfo,R2)],
                DisplayArgInfo = {FLArg,LArg}
        ;
            R1 = abnormal(Reason)->
                NH = [receive(errorInfo,[Reason],R2)],
                DisplayArgInfo = {FLArg,CLArg}

        ),
        (   wait(R2)->
                get_commandArguments(
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)).
otherwise.
    sendProtocol_getCommandArguments(Parameter,Arguments,
                {Pool1,Info,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Pool1 = [make(nh,NH)|Pool],
        NH = [receive(Parameter,Arguments,R1)],
        (   wait(R1)->
                get_commandArguments(
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)).

%send_okProtocol
%    send_okProtocol(Pool1,Pool,R):-true|
%        Pool1 = [make(nh,NH)|Pool],
%        NH = [receive(ok,[],R)].

    get_unit([],POM1,POM,UnitList):-true |
        POM = POM1,
        UnitList = [].
    get_unit([U|T],POM1,POM,UnitList):-true |
        POM1= [is({unit,U},YN,_)|POM2],
        (   YN = yes ->
                get_unit(T,POM2,POM,UnitList1),
                UnitList = [{U,[]}|UnitList1]
        ;
            YN = no ->
                POM2 = [get({scopeUnitToUnit,[U]},UList,_)|POM3],
                get_unit(T,POM3,POM,UnitList1),
                UList = [UList1],
                UnitList = [UList1|UnitList1]
        ).