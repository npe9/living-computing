%send view
    get_commandArguments1(send,useView,_,
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Info1 = {A,POM1,C,D},
	C     = {UseViewName,_,_,_},
        POM1 = [get({view,UseViewName},[View],R1)|POM],
        Info  = {A,POM,C,D},
