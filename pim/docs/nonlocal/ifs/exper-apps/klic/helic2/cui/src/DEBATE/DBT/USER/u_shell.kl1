%send unit
    get_commandArguments1(send,useUnit,_,
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Info = {A,POM,C,D},
	C     = {_,UseUnitNameList,_,_},
        sendProtocol_getCommandArguments(useUnit,UseUnitNameList,
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

%send unit Unit
    get_commandArguments1(send,unit,[all],
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Info1 = {A,POM1,C,D},
        POM1 = [get({scopeUnit,all},ScopeUnitNameList,R1)|POM2],
        (   R1 = normal(success)->
	        get_unit(ScopeUnitNameList,POM2,POM,UnitList),
        	Info  = {A,POM,C,D},
                sendProtocol_getCommandArguments(unit,UnitList,
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
	        POM2  = POM,
        	Info  = {A,POM,C,D},
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).
    get_commandArguments1(send,unit,Unit,
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-Unit\=all|
        Info1 = {A,POM1,C,D},
        POM1 = [is({unitOrScopeUnitList,Unit},YN,R1)|POM2],
        (   R1 = normal(success),YN = yes ->
           	get_unit(Unit,POM2,POM,UnitList),
		Info  = {A,POM,C,D},
	        sendProtocol_getCommandArguments(unit,UnitList,
        	        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
	;
    	    R1 = normal(success),YN = {no,Unknown} ->
                POM = POM2,
		Info  = {A,POM,C,D},
		Reason = {cui,'Illegal unit name',Unknown},
	        sendProtocol_getCommandArguments(errorInfo,[Reason],
        	   	{Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                POM = POM2,
		Info  = {A,POM,C,D},
                sendProtocol_getCommandArguments(errorInfo,[Reason],
       	                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).


