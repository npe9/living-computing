:- module dbtcui_set.

:- public 
    goal/5,
    goal1/5,

    useView/5,
    useSpPriority/5,
    useUnit/5,

    solver/5,
    pl/5,
    pt/5,
    cl/5,
    similarity/5,
    weight/5,
    psiTermSimTB/5,
    psiTermAttWeight/5.
            
:- with_macro pimos. 

%goal
    goal(AgentName,Goal,Data1,Data,Protocol):-true|
        dbtcui_makeFile:goal(Goal,R1),
        (   R1 = normal(success)->
                dbtcui_defaultName:get_inputFileName(GoalFileName),
                dbtcui_compile:goal(AgentName,GoalFileName,Data1,Data2,Protocol1),
                (   Protocol1 = receive(_,ok,_,_)->
                        goal1(AgentName,0,Data2,Data,Protocol)
                ;
                    Protocol1 = receive(_,errorInfo,_,_)->
                        Data     = Data2,
                        Protocol = Protocol1
                )
        ;
            R1 = abnormal(Reason)->
                make_protocol(abnormal(Reason),_,AgentName,_,Protocol),
                        Data = Data1
        ).

    goal1(AgentName,Pos,{DBT1,CGS1},Data,Protocol):-true|
        CGS1 = [get(AgentName,goalList,GoalList)|CGS2],
        (   GoalList \= nil->
                get_element(GoalList,0,Pos,Goal,YN1),
                (   YN1 = yes->
                        dbtcui_protocolPool:get(AgentName,set,goal,Goal,ProtocolList),
                        send(ProtocolList,DBT1,DBT,Result),
                        (   Result = normal(_)->
                                CGS2 = [set(AgentName,currentGoal,Pos)|CGS]
                        ;
                            Result = abnormal(_)->
                                CGS  = CGS2
                        ),
                        make_protocol(Result,ok,AgentName,[],Protocol),
                        Data = {DBT,CGS}
                ;
                    YN1 = no->
                        make_protocol(abnormal({cui,'Illegal goal number',Pos}),
				_,AgentName,_,Protocol),
                        Data = {DBT1,CGS2}
                )
        ;
            GoalList = nil->
                make_protocol(abnormal({cui,'Goal file not read',nil}),
			_,AgentName,_,Protocol),
                Data = {DBT1,CGS2}
        ).

%useView
    useView(AgentName,View,{DBT1,CGS},Data,Protocol):-true|
        dbtcui_protocolPool:get(AgentName,set,useView,View,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        make_protocol(Result,ok,AgentName,[],Protocol),
        Data = {DBT,CGS}.

