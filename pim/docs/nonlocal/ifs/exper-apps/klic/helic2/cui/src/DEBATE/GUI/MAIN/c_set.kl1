%%%%%%%%%%%%%%%%%%%%%%
%send
    send(Protocol,DBT1,DBT,Result):-true|
        DBT1 = [Protocol|DBT],
	Protocol = {_,[Protocol1]},
        is_normal(Protocol1,Result).

%%is_normal
    is_normal(set_parameter(_,_,R),Result):-true|
        Result = R.
    is_normal(tracer(set(_,_,R)),Result):-true|
        Result = R.

%make_protocol
    make_protocol(abnormal(Reason),_,	       AgentName,_,        Protocol):-true|
        dbtcui_utility:make_errorProtocol(AgentName,Reason,Protocol).
    make_protocol(normal(success),ProtocolName,AgentName,Arguments,Protocol):-true|
        Protocol = receive(AgentName,ProtocolName,Arguments,_).

%%%%%%%%%%%%%list utility

%get_element
    get_element([],_,_,_,YN):-true|
        YN = no.
    get_element([E1|_],L,L,E,YN):-true|
        E  = E1,
        YN = yes.
otherwise.
    get_element([_|T],W,L,E,YN):-true|
        W1 := W +1,
        get_element(T,W1,L,E,YN).



