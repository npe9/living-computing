%rule_vec_to_list(RV,I,RL,RV1):-
%    vector_element(RV,I,0) |
%    RL = [], RV1 = RV.
%otherwise.
%rule_vec_to_list(RV,I,RL,RV1):- true |
%    vector_element(RV,I,{Rule,_},RV0),
%    rule_vec_to_list(RV0,~(I+1),RLT,RV1),
%    RL = [Rule|RLT].

get_key_list([{Key,_C}|T],KeyList):-
    get_key_list(T,KeyListT),
    KeyList = [Key|KeyListT].
get_key_list([],KeyList):-
    KeyList = [].

check_counter(infinite,CntD0,CntD1,Res):-
    CntD1 := ~(CntD0+1), 
    Res = yes.
check_counter(N,CntD0,CntD1,Res):-
    N =< CntD0 |
    CntD1 = '***error***',
    Res = no.
check_counter(N,CntD0,CntD1,Res):-
    N > CntD0 |
    CntD1 := ~(CntD0+1), 
    Res = yes.

set_counter(infinite,_,NewCntD,Res):-
    NewCntD = infinite,
    Res = normal(success).
set_counter(N,_,NewCntD,Res):-
    N >= 0 |
    NewCntD = N,
    Res = normal(success).
otherwise.
set_counter(InCntD,CntD0,NewCntD,Res):-
    NewCntD = CntD0,
    Res = abnormal({rbr,illegal_counter_depth,InCntD}).

deletelist([],RNL,RNL1):-
    RNL1 = RNL.
deletelist([E|T],RNL,RNL1):-
    deleteE(RNL,E,RNL0),
    deletelist(T,RNL0,RNL1).

deleteE([E|RNL],E,RNL1):-
    RNL1 = RNL.
deleteE([],_E,RNL1):-
    RNL1 = [].
otherwise.
deleteE([E1|RNL],E,RNL1):-
    RNL1 = [E1|RNL1T],
    deleteE(RNL,E,RNL1T).

%for HyoukaTB method
%HyoukaTB = {Sim,Weight,PsiTermSimTB,PsiTermAttK}

set_similarity(HyoukaTB1,Sim,HyoukaTB):-true|
    set_vector_element(HyoukaTB1,0,_,Sim,HyoukaTB).
set_weight(HyoukaTB1,Weight,HyoukaTB):-true|
    set_vector_element(HyoukaTB1,1,_,Weight,HyoukaTB).
set_psiTermSimTB(HyoukaTB1,PsiTermSimTB,HyoukaTB):-true|
    set_vector_element(HyoukaTB1,2,_,PsiTermSimTB,HyoukaTB).
set_psiTermAttWeight(HyoukaTB1,PsiTermAttWeight,HyoukaTB):-true|
    set_vector_element(HyoukaTB1,3,_,PsiTermAttWeight,HyoukaTB).


get_similarity(HyoukaTB,Sim):-true|
    vector_element(HyoukaTB,0,Sim,_).
get_weight(HyoukaTB,Weight):-true|
    vector_element(HyoukaTB,1,Weight,_).
get_psiTermSimTB(HyoukaTB,PsiTermSimTB):-true|
    vector_element(HyoukaTB,2,PsiTermSimTB,_).
get_psiTermAttWeight(HyoukaTB,PsiTermAttWeight):-true|
    vector_element(HyoukaTB,3,PsiTermAttWeight,_).






