get_rules(hp(HID,Goal),NewGoals,T,RuleV,RNB,VB,TS,UO,HyoukaTB,AllRule,Node,CntD,RLS,TRC):-
    Goal = {Head,Env,_HIDT} |
    get_type_name(Head,Env,Type),
    VB = [carbon_copy(Type,RNL)|VB1],
    append(RNL,AllRule,CandiRule),
    deletelist(RLS,CandiRule,CandiRule0),
    get_candi_rule(CandiRule0,RuleV,RNB,RuleV1,RNB1,RuleCandi),
    TS = {TS1,TS2},
    unif_check_list(RuleCandi,hp(HID,Goal),TS1,NewGoals),
    loop(T,RuleV1,RNB1,VB1,TS2,UO,HyoukaTB,AllRule,Node,CntD,TRC).
otherwise.
get_rules(Goal,NewGoals,T,RuleV,RNB,VB,TS,UO,HyoukaTB,AllRule,Node,CntD,RLS,TRC):-
    Goal = {Head,Env,_HIDT} |
    get_type_name(Head,Env,Type),
    VB = [carbon_copy(Type,RNL)|VB1],
    append(RNL,AllRule,CandiRule),
    deletelist(RLS,CandiRule,CandiRule0),
    get_candi_rule(CandiRule0,RuleV,RNB,RuleV1,RNB1,RuleCandi),
    TS = {TS1,TS2},
    unif_check_list(RuleCandi,Goal,TS1,NewGoals),
    loop(T,RuleV1,RNB1,VB1,TS2,UO,HyoukaTB,AllRule,Node,CntD,TRC).

delete_all_rules([RNH|RNT],RuleList,AllRule,RNB,RuleV,RNB1,RuleV1,Res):-
    get_all_flag(RNH,RNB,RuleV,RNBm,RuleVm,AllF),
    delete_all_rules1(AllF,RNH,RNT,RuleList,AllRule,RNBm,RuleVm,RNB1,RuleV1,Res).
delete_all_rules([],RuleList,AllRule,RNB,RuleV,RNB1,RuleV1,Res):-
    RuleList = [], AllRule = [], RNB1 = RNB, RuleV1 = RuleV, Res = normal(success).

%%%    Res = abnormal({rbr,unknown_rule_name,RNH})
delete_all_rules1(abnormal({rbr,unknown_rule_name,RNH}),
    _RNH,_RNT,_RuleList,_AllRule,RNB,RuleV,RNB1,RuleV1,Res):-
    Res = abnormal({rbr,unknown_rule_name,RNH}),
    RNB1 = RNB,
    RuleV1 = RuleV.
otherwise.
delete_all_rules1(AllF,RNH,RNT,RuleList,AllRule,RNB,RuleV,RNB1,RuleV1,Res):-
    AllF = 0 |
    AllRule = [RNH|AllRuleT],
    delete_all_rules(RNT,RuleList,AllRuleT,RNB,RuleV,RNB1,RuleV1,Res).
otherwise.
delete_all_rules1(_,RNH,RNT,RuleList,AllRule,RNB,RuleV,RNB1,RuleV1,Res):-
    RuleList = [RNH|RuleListT],
    delete_all_rules(RNT,RuleListT,AllRule,RNB,RuleV,RNB1,RuleV1,Res).

get_all_flag(RNH,RNB,RuleV,RNB1,RuleV1,AllF):-
    RNB = [carbon_copy(RNH,Index0)|RNB1], 
    get_all_flag1(Index0,RNH,RuleV,RuleV1,AllF).

get_all_flag1([Index],_RNH,RuleV,RuleV1,AllF):-
    vector_element(RuleV,Index,Rule,RuleV1),
    vector_element(Rule,0,Head,RuleM),
    vector_element(Head,0,{Not,PTerm},_Head1),
    pterm_to_all_flag(Not,PTerm,RuleM,AllF,_Rule1).
get_all_flag1([],RNH,RuleV,RuleV1,AllF):-
    RuleV1 = RuleV,
    AllF = abnormal({rbr,unknown_rule_name,RNH}).

pterm_to_all_flag(-,_VarID,Rule,AllFlag,Rule1):-
    AllFlag = not_rule, Rule1 = Rule.
pterm_to_all_flag([],VarID,Rule,AllFlag,Rule1):-
    pterm_to_all_flag1(VarID,Rule,AllFlag,Rule1).

pterm_to_all_flag1(VarID,Rule,AllFlag,Rule1):-
    VarID = 0 |
    AllFlag = 0, Rule1 = Rule.
pterm_to_all_flag1(VarID,Rule,AllFlag,Rule1):-
    VarID > 0 |
    set_vector_element(Rule,2,Env,Env1,RuleM),
    vector_element(Env,VarID,PTerm,Env1),
    pterm_to_all_flag1(PTerm,RuleM,AllFlag,Rule1).
pterm_to_all_flag1(PTerm,Rule,AllFlag,Rule1):-
    vector(PTerm,3) |
    vector_element(PTerm,1,AllFlag,_PTerm1),
    Rule1 = Rule.

append([H|T],L,Lout):-
    append(T,L,LT),
    Lout = [H|LT].
append([],L,Lout):-
    Lout = L.

solve_blt({{greater,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    TS = [greater(X,Y,Env,NewEnv,Res)|TS1],
    Q1 = {{greater,X,Y},NewEnv,HIDT}.
solve_blt({{less,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    TS = [less(X,Y,Env,NewEnv,Res)|TS1],
    Q1 = {{less,X,Y},NewEnv,HIDT}.
%$ shuusei '96/11/21
%solve_blt({{equal,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
%    TS = [equal(X,Y,Env,NewEnv,Res)|TS1],
%    Q1 = {{equal,X,Y},NewEnv,HIDT}.
%solve_blt({{not_equal,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
%    TS = [not_equal(X,Y,Env,NewEnv,Res)|TS1],
%    Q1 = {{not_equal,X,Y},NewEnv,HIDT}.
solve_blt({{equal,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    solve_equal(X,Y,TS,Env,NewEnv,Res,TS1),
    Q1 = {{equal,X,Y},NewEnv,HIDT}.
solve_blt({{not_equal,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    solve_not_equal(X,Y,TS,Env,NewEnv,Res,TS1),
    Q1 = {{not_equal,X,Y},NewEnv,HIDT}.
%$ shuusei_end '96/11/21
solve_blt({{same,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    TS = [same(X,Y,Env,NewEnv,Res)|TS1],
    Q1 = {{same,X,Y},NewEnv,HIDT}.
solve_blt({{different,X,Y},Env,HIDT},TS,Q1,TS1,Res):-
    TS = [different(X,Y,Env,NewEnv,Res)|TS1],
    Q1 = {{different,X,Y},NewEnv,HIDT}.

%$ add '95/11/21
solve_equal(X,Y,TS,Env,NewEnv,Res,TS1):-
    string_equal(X,Y,Env,Env1,YorN),
    solve_equal1(YorN,X,Y,TS,Env1,NewEnv,Res,TS1).

solve_equal1(equal,X,Y,TS,Env1,NewEnv,Res,TS1):-
    NewEnv = Env1,
    TS1 = TS,
    Res = normal(success).
solve_equal1(not_equal,X,Y,TS,Env1,NewEnv,Res,TS1):-
    NewEnv = Env1,
    TS1 = TS,
    Res = fail.
solve_equal1(no,X,Y,TS,Env1,NewEnv,Res,TS1):-
    TS = [equal(X,Y,Env1,NewEnv,Res)|TS1].

solve_not_equal(X,Y,TS,Env,NewEnv,Res,TS1):-
    string_equal(X,Y,Env,Env1,YorN),
    solve_not_equal1(YorN,X,Y,TS,Env1,NewEnv,Res,TS1).

solve_not_equal1(equal,X,Y,TS,Env1,NewEnv,Res,TS1):-
    NewEnv = Env1,
    TS1 = TS,
    Res = fail.
solve_not_equal1(not_equal,X,Y,TS,Env1,NewEnv,Res,TS1):-
    NewEnv = Env1,
    TS1 = TS,
    Res = normal(success).
solve_not_equal1(no,X,Y,TS,Env1,NewEnv,Res,TS1):-
    TS = [not_equal(X,Y,Env1,NewEnv,Res)|TS1].

string_equal(X,Y,Env,Env1,YorN):-
    get_real_PT(X,Env,XS,EnvM),
    string_equal1(XS,Y,EnvM,Env1,YorN).

string_equal1(no,Y,Env,Env1,YorN):-
    Env1 = Env,
    YorN = no.
otherwise.
string_equal1(XS,Y,Env,Env1,YorN):-
    get_real_PT(Y,Env,YS,Env1),
    string_equal2(YS,XS,YorN).    

string_equal2(no,_XS,YorN):-
    YorN = no.
otherwise.
string_equal2(XS,XS,YorN):-
    YorN = equal.
otherwise.
string_equal2(XS,YS,YorN):-
    YorN = not_equal.

get_real_PT(0,Env,Xres,Env1):-
    Env1 = Env,
    Xres = no.
otherwise.
get_real_PT(X,Env,Xres,Env1):-
    integer(X) |
    vector_element(Env,X,XX,EnvM),
    get_real_PT(XX,EnvM,Xres,Env1).
get_real_PT({X,_,[]},Env,Xres,Env1):-
    string(X,_,_) |
    Xres = X,
    Env1 = Env.
otherwise.
get_real_PT(_X,Env,Xres,Env1):-
    Env1 = Env,
    Xres = no.
	
