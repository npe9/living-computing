:- module ty_osif.
:- with_macro pimos.
:- public add_at/4,get_at/4,in/4,remove_at/4,
	  get_contents/3,get_contents_with_key/3,get_contents_at/4,get_keys/3,
	  put_with/4,get_with/4,exist/4.
:- public open/4,close/1,gett/3,putt/3.
:-public keyed_bag/1,keyed_set/1.
:-public atom_to_string/2,string_to_atom/2.
:-public or_string_elements/7,and_string_elements/7,
	 complement_string_elements/4,substring/5,string_tail/3,
	 append_string/2,search_character/6.
:-public key_sort/2.
