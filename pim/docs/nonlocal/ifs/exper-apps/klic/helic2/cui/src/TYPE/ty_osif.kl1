% S add_at(Key,Data,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%add_at(Key,Data,Old,New):-
%    Old = [put(Key,Data)|New].

add_at(Key,Data,Tree,NewTree):-
    ty_util:add_at(Key,Data,Tree,NewTree).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_at(Key,Data,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%get_at(Key,Data,Old,New):-
%    Old = [get_if_any(Key,X)|TMP],
%    (vector(X,0) ->
%        New = TMP,
%%        Data = ty#void
%        Data = '&void'
%    ;otherwise;true ->
%        vector_element(X,0,Data,_),
%        TMP = [put(Key,Data)|New]
%    ).

get_at(Key,Data,Tree,NewTree):-
    NewTree = Tree,
    ty_util:get_at(Key,X,Tree),
    (vector(X,1) ->
        vector_element(X,0,Data)
    ;vector(X,0) ->
%        Data = ty#void
        Data = '&void'
    ).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S in(Key,Old,New,Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%in(Key,Old,New,Result):-
%    Old = [get_if_any(Key,X)|TMP],
%    (vector(X,0) ->
%        New = TMP,
%%        Result = ty#no
%        Result = fail
%    ;otherwise;true ->
%        vector_element(X,0,Y,_),
%        TMP = [put(Key,Y)|New],
%%        Result = ty#yes
%        Result = success
%    ).

in(Key,Tree,NewTree,Result):-
    NewTree = Tree,
    ty_util:get_at(Key,X,Tree),
    (vector(X,1) ->
%        Result = ty#yes
        Result = success
    ;vector(X,0) ->
%        Result = ty#no
        Result = fail
    ).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S remove_at(Key,Data,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%remove_at(Key,Data,Old,New):-
%    Old = [get(Key,Data)|New].

remove_at(Key,Data,Tree,NewTree):-
    ty_util:remove_at(Key,Data,Tree,NewTree).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_contents(Data,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%get_contents(Data,Old,New):-
%    Old = [carbon_copy(Contents)|New],
%    only_data(Contents,Data).

get_contents(Data,Tree,NewTree):-
    NewTree = Tree,
    ty_util:carbon_copy(Contents,Tree),
    only_data(Contents,Data).

only_data([],Data):-Data=[].
only_data([{_,Datum}|Contents],Data):-
    Data=[Datum|NewData],
    only_data(Contents,NewData).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_contents_with_key(Contents,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%get_contents_with_key(Contents,Old,New):-
%    Old = [carbon_copy(Contents)|New].

get_contents_with_key(Contents,Tree,NewTree):-
    NewTree = Tree,
    ty_util:carbon_copy(Contents,Tree).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_contents_at(Key,Contents,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%get_contents_at(Key,Contents,Old,New):-
%    Old = [carbon_copy(Key,Contents)|New].

get_contents_at(Key,Contents,Tree,NewTree):-
    NewTree = Tree,
    ty_util:carbon_copy_at(Key,Contents,Tree).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_keys(Keys,Old,New)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%get_keys(Keys,Old,New):-
%    Old = [carbon_copy(Contents)|New],
%    only_keys(Contents,Keys).

get_keys(Keys,Tree,NewTree):-
    NewTree = Tree,
    ty_util:carbon_copy(Contents,Tree),
    only_keys(Contents,Keys).

only_keys([],Keys):-Keys=[].
only_keys([{Key,_}|Contents],Keys):-
    Keys=[Key|NewKeys],
    only_keys(Contents,NewKeys).

