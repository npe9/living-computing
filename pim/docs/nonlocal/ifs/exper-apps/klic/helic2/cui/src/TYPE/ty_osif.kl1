%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S open(Pathname,Mode,File,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% hLibrary
% Result : normal(ty#yes) | abnormal(Info)
%          Info : {ty#typemid,open_fail,Add}
%open(Pathname,Mode,File,Result):-
%    hLibrary:file(Pathname,Mode,R1),
%    (ty#functor(R1,P,_),P=normal ->
%        vector_element(R1,1,File,_),
%        Result = normal(ty#yes)
%    ;otherwise;true ->
%        Result = abnormal(Info),
%        Info = {ty#typemid,open_fail,[Pathname]}
%    ).


% PIMOS
%open(Pathname,Mode,File,Result):-
%    % hLibrary:file(Pathname,Mode,File),
%    % Result = normal.
%    get_user_file_device(Pathname,Mode,File,Result).
%
%get_user_file_device(Pathname,Mode,File,Result):-true|
%	get_file_device(Pathname,Mode,Device,R1),
%	(R1 = normal ->
%	    buffer:input_filter(File,Device),
%	    Result = normal
%	;otherwise;true ->
%	    File = Device,
%	    Result = R1
%	).
%
%get_file_device(Pathname,Mode,Device,Result):-
%    shoen:raise(pimos_tag#task,general_request, GeneralRequestDevice),
%    GeneralRequestDevice = [file(R1)],
%    wait_file_request_device(Pathname,Mode,Device,R1,Result).
%
%wait_file_request_device(Pathname,Mode,Device,normal(FRS,_,_),Result):-true|
%	FRS = [open(Pathname,{Mode,R1})],
%	(R1 = normal(Device,_Abort,_Attention) ->
%	    Result = normal
%	;otherwise;true ->
%	    Device = ty#void,
%	    Result = abnormal(open_error(Pathname))
%	).
%otherwise.
%wait_file_request_device(Pathname,_,Device,_,Result) :- true|
%	Device=ty#void,
%	Result=abnormal(open_error(Pathname)).


% For KLIC
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S open(Pathname,Mode,File,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% hLibrary
% Result : normal(ty#yes) | abnormal(Info)
%          Info : {ty#typemid,open_fail,Add}
open(Pathname,Mode,InStream,Result):-
    string(Pathname,_,8), Mode = read |
	klicio:klicio(S),
	S=[read_open(Pathname,R1)],
	(functor(R1,P,A),A=:=1, P=normal ->
	    arg(1,R1,InStream),
	    Result = normal(success)
	;otherwise;true ->
	    Result = abnormal(Info),
	    Info = {type,open_fail,[Pathname]}
	).
open(Pathname,Mode,OutStream,Result):-
    string(Pathname,_,8), Mode = write |
	klicio:klicio(S),
	S=[write_open(Pathname,R1)],
	(functor(R1,P,_),P=normal ->
	    arg(1,R1,OutStream),
	    Result = normal(success)
	;otherwise;true ->
	    Result = abnormal(Info),
	    Info = {type,open_fail,[Pathname]}
	).
open(Pathname,_Mode,InStream,Result):-
    Pathname = stdin |
	klicio:klicio(S),
	S=[stdin(R1)],
	(functor(R1,P,A),A=:=1, P=normal ->
	    arg(1,R1,InStream),
	    Result = normal(success)
	;otherwise;true ->
	    Result = abnormal(Info),
	    Info = {type,open_fail,[stdin]}
	).
open(Pathname,_Mode,OutStream,Result):-
    Pathname = stdout |
	klicio:klicio(S),
	S=[stdout(R1)],
	(functor(R1,P,_),P=normal ->
	    arg(1,R1,OutStream),
	    Result = normal(success)
	;otherwise;true ->
	    Result = abnormal(Info),
	    Info = {type,open_fail,[stdout]}
	).
open(Pathname,_Mode,ErrStream,Result):-
    Pathname = stderr |
	klicio:klicio(S),
	S=[stderr(R1)],
	(functor(R1,P,_),P=normal ->
	    arg(1,R1,ErrStream),
	    Result = normal(success)
	;otherwise;true ->
	    Result = abnormal(Info),
	    Info = {type,open_fail,[stderr]}
	).
otherwise.
open(Pathname,Mode,ErrStream,Result):-
    Result = abnormal(Info),
    Info = {type,open_fail,[Pathname,Mode]}.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S gett(Term,File,^NewFile)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
gett(Term,File,NewFile):-
    File = [gett(Term)|NewFile].

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S putt(Term,File,^NewFile)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
putt(Term,File,NewFile):-
    File = [puttq(Term)|NewFile].

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S close(File)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
close(File):-
    File = [].

