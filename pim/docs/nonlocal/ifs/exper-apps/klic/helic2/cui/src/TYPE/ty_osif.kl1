% Followings are predicates for KLIC port.
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S sorter:key_sort(In,Out)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% [注意!]
% AttrPairsが{Key,Data}の形式であり、かつ、Key が string で
% あることを前提にしている。
key_sort(In,Out):-
    key_qsort(In,Out,[]).

key_qsort([],Out,NewOut):-
    NewOut = Out.
key_qsort([X|In],Out,NewOut):-
    partition(In, X, S, L),
    key_qsort(S, Out, Out1),
    Out1 = [X|Out2],
    key_qsort(L, Out2, NewOut).

partition([], P, S, L):-
    S=[], L=[].
partition([X|In], P, S, L):-
    vector_element(X,0,Kx),
    vector_element(P,0,Kp),
    generic:less_than(Kx,Kp)|
	S=[X|S0], partition(In, P, S0, L).
partition([X|In], P, S, L):-
    vector_element(X,0,Kx),
    vector_element(P,0,Kp),
    generic:not_less_than(Kx,Kp)|
	L=[X|L0], partition(In, P, S, L0).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S or_string_elements(String1,Position,Length,String2,Position2,
%		      ^NewString1,^Newstring2)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
or_string_elements(String1,Position1,Length,String2,Position2,
		    NewString1,NewString2):-
    string(String1,Size1,ElementSize1),
    string(String2,Size2,ElementSize2),
    ElementSize1 =:= ElementSize2,
    integer(Position1), integer(Position2),
    integer(Length),
    0 =< Position1, Position1 < Size1,
    0 =< Position2, Position2 < Size2,
    0 =< Length, Length =< ~(Size1 - Position1),
                 Length =< ~(Size2 - Position2) |
	or_loop(Length,String1,Position1,String2,Position2,
		 NewString1,NewString2).

or_loop(Length,String1,_Position1,String2,_Position2,
	 NewString1,NewString2):-
    Length =< 0 |
	NewString1 = String1, NewString2 = String2.
or_loop(Length,String1,Position1,String2,Position2,
	 NewString1,NewString2):-
    Length > 0 |
	string_element(String1,Position1,Element1),
	string_element(String2,Position2,Element2),
	NewElement := Element1 \/ Element2,
	set_string_element(String1,Position1,NewElement,TmpString1),
	or_loop(~(Length-1),TmpString1,~(Position1+1),
		 String2,~(Position2+1),NewString1,NewString2).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S and_string_elements(String1,Position,Length,String2,Position2,
%		       ^NewString1,^Newstring2)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
and_string_elements(String1,Position1,Length,String2,Position2,
		    NewString1,NewString2):-
    string(String1,Size1,ElementSize1),
    string(String2,Size2,ElementSize2),
    ElementSize1 =:= ElementSize2,
    integer(Position1), integer(Position2),
    integer(Length),
    0 =< Position1, Position1 < Size1,
    0 =< Position2, Position2 < Size2,
    0 =< Length, Length =< ~(Size1 - Position1),
                 Length =< ~(Size2 - Position2) |
	and_loop(Length,String1,Position1,String2,Position2,
		 NewString1,NewString2).

and_loop(Length,String1,_Position1,String2,_Position2,
	 NewString1,NewString2):-
    Length =< 0 |
	NewString1 = String1, NewString2 = String2.
and_loop(Length,String1,Position1,String2,Position2,
	 NewString1,NewString2):-
    Length > 0 |
	string_element(String1,Position1,Element1),
	string_element(String2,Position2,Element2),
	NewElement := Element1 /\ Element2,
	set_string_element(String1,Position1,NewElement,TmpString1),
	and_loop(~(Length-1),TmpString1,~(Position1+1),
		 String2,~(Position2+1),NewString1,NewString2).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S complement_string_elements(String,Position,Length,^NewString)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
complement_string_elements(String,Position,Length,NewString):-
    string(String,Size,ElementSize),
    integer(Position), integer(Length),
    0 =< Position, Position < Size,
    0 =< Length, Length =< ~(Size - Position) |
	Mask := (1 << ElementSize) - 1,
	complement_loop(Length, String, Position, Mask, NewString).

complement_loop(Length, String, _Position, _Mask, NewString):-
    Length =< 0 |
	NewString = String.
complement_loop(Length, String, Position, Mask, NewString):-
    Length > 0 |
	string_element(String, Position, Element),
	complement_with_mask(Element,Mask,NewElement),
	set_string_element(String, Position, NewElement, TmpString),
	complement_loop(~(Length-1), TmpString, ~(Position+1), Mask, NewString).

complement_with_mask(Int,Mask,NewInt):-
    inline:"%2 = makeint(~intval(%0) & intval(%1));":
    [Int+int, Mask+int, Result-int] | NewInt=Result.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S substring(String,Position,Length,^SubString,^NewString)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
substring(String, Position, Length, SubString, NewString):-
    string(String, Size, ElementSize),
    integer(Position),
    integer(Length),
    Position >= 0, Position < Size,
    Length >= 0, Length =< ~(Size - Position) |
	new_string(WorkString, Length, ElementSize),
	substring_loop(0, Length, Position,
			String, WorkString, NewString, SubString).

substring_loop(Current, Current, _Position,
			String, WorkString, NewString, SubString):-
    true |
	NewString = String,
	SubString = WorkString.
otherwise.
substring_loop(Current, Length, Position,
			String, WorkString, NewString, SubString):-
    true |
	string_element(String, Position, Element, TmpString),
	set_string_element(WorkString, Current, Element, NewWorkString),
	substring_loop(~(Current + 1), Length, ~(Position + 1),
			TmpString, NewWorkString, NewString, SubString).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S string_tail(String,Position,^NewString)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
string_tail(String, Position, NewString):-
    string(String,Size,ElementSize),
    integer(Position),
    0 =< Position, Position < Size |
	Length := Size - Position,
	substring(String, Position, Length, NewString, _).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S append_string(StringList, ^NewString)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
append_string([S0|SL], RS):-
    append_string2_loop(SL, S0, RS).
append_string([], RS):-
    RS = string#"".

append_string2_loop([S|SL], PS, RS):-
    append_string(PS, S, NPS),
    append_string2_loop(SL, NPS, RS).

append_string2_loop([], PS, RS):-
    RS = PS.

append_string(String1, String2, NewString):-
    string(String1, Size1, EleSize),
    string(String2, Size2, EleSize) |
	new_string(WorkString, ~(Size1 + Size2), EleSize),
	append_string_loop(0, 0, Size1, String1, WorkString, WorkString2),
	append_string_loop(0, Size1, ~(Size1 + Size2),
				String2, WorkString2, NewString).

append_string_loop(Current, Size, Size, String, WorkString, NewString):-
    true |
	NewString = WorkString.
otherwise.
append_string_loop(Current, Position, Size, String, WorkString, NewString):-
    true |
	string_element(String, Current, Element, TmpString),
	set_string_element(WorkString, Position, Element, NewWorkString),
	append_string_loop(~(Current + 1), ~(Position + 1),
			   Size, TmpString, NewWorkString, NewString).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S search_character(String,Start,End,CharacterCode,^Position,^NewString)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
search_character(String,Start,End,CharacterCode,Position,NewString):-
    generic:search_character(String,Start,End,CharacterCode,Position),
    NewString = String.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%S stdio(Type,^Stream)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% These are just for convenience. Should use open/4.
stdio(in,In):-
    open(stdin,in,In,_).
stdio(out,Out):-
    open(stdout,out,Out,_).
stdio(err,Err):-
    open(stderr,err,Err,_).
