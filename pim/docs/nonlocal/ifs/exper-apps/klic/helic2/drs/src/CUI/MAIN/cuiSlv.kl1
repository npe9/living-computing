:- module rbrcui_solve.

:- public 
    solve/4,
    solve/3.

:- with_macro pimos. 

    solve(Goal,Data1,Data,Protocol):-true|
        rbrcui_set:goal(Goal,Data1,Data2,Protocol1),
        (   Protocol1 = receive(errorInfo,_,_)->
                Data     = Data2,
                Protocol = Protocol1
        ;
            Protocol1 = receive(ok,_,_)->
                solve(Data2,Data,Protocol)
        ).

    solve({RPM1,CS1},Data,Protocol):-true|
        rbrcui_protocolPool:get(execute,solve,_,ProtocolList),
        send(ProtocolList,RPM1,RPM,ST,R1),
%       builtin:print(ST),
        (   R1 = normal(success)->
                show_variable(ST,CS1,CS,Protocol)
        ;
            R1 = abnormal(Reason)->
                CS = CS1,
                rbrcui_utility:make_errorProtocol(Reason,Protocol)
        ),
        Data = {RPM,CS}.        

%send
    send([Protocol],RPM1,RPM,ST,Result):-true |
        RPM1 = [Protocol|RPM],
        is_normal(Protocol,ST,Result).

%%is_normal
    is_normal(execute(solve,_,ST1,normal(_)),ST,Result):-true|
        ST     = ST1,
        Result = normal(success).
    is_normal(execute(solve,_,_,abnormal(Reason)),_,Result):-true|
        Result = abnormal(Reason).

%%%%%%%%%show variable
    show_variable([],CS1,CS,Protocol):-true|
        CS1      = [set(st,nil)|CS],
        Protocol = receive(varInfoList,no,_).
otherwise.
    show_variable(ST,CS1,CS,Protocol):-true|
        CS1 = [set(st,ST)|CS2],
        show_varInfoList(ST,CS2,CS,Protocol).

%show_varInfoList
    show_varInfoList(ST,CS1,CS,Protocol):-true|
        get_varInfoList(ST,CS1,CS,VarInfoList),
        Protocol = receive(varInfoList,VarInfoList,_).

    get_varInfoList(ST,CS1,CS,VarInfoList):-true|
%        CS1 = [get(ingiEnvList,[IngiEnv|_])|CS],
        CS1 = [ get(ingiEnvList,IngiEnvList),
                get(currentGoal,Pos)|CS],
        get_element(IngiEnvList,0,Pos,IngiEnv),
        vector(IngiEnv,L,_),
        (   L = 1->
                VarInfoList = []
        ;
            L \=1->
                get_varInfoList1(ST,IngiEnv,L,VarInfoList)
        ).

    get_varInfoList1([],_,_,VarInfoList):-true|
        VarInfoList = [].
%oosaki modify
%    get_varInfoList1([{Env,_,_}|T],IngiEnv,L,VarInfoList):-true|
    get_varInfoList1([{env(Env,_),_,_}|T],IngiEnv,L,VarInfoList):-true|
        get_varInfo(1,L,IngiEnv,Env,VarInfo),
        get_varInfoList1(T,IngiEnv,L,VarInfoList1),
        VarInfoList = [VarInfo|VarInfoList1].

    get_varInfo(L,L,_,_,VarInfo):-true|
        VarInfo = [].
otherwise.
    get_varInfo(Pos,L,IngiEnv,Env,VarInfo):-true|
        vector_element(IngiEnv,Pos,Ingi,_),
        vector_element(Env,Pos,Value1,_),
        ( Value1 = 0->
                Value = "?"
        ;
        otherwise;
          true->
                reverse_translate:reverse_translate(1,{Value1,Env},Value)
        ),
        append_string:append_string([Ingi,"=",Value],Display),
        Pos1 := Pos+1,
        get_varInfo(Pos1,L,IngiEnv,Env,VarInfo1),
        VarInfo = [Display|VarInfo1].

%%%%%%%
    get_element([H|_],L,L,E):-true|
        E = H.
otherwise.
    get_element([_|T],Pos1,L,E):-true|
        Pos := Pos1+1,
        get_element(T,Pos,L,E).