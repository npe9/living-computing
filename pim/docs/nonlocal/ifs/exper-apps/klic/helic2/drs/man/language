	| <Unit> "::" <CBR H term> [ "||"<Rule explanation>] "."
<CBR body> ::= 
	["!"] <CBR H term>
	| <Built-in predicate>
<CBR H term> ::= 
	<CBR predicate name> "(" [<CBR case description>] ")" [ "|" <H term identifier>]
	| <H term identifier>
	| ["-"] <CBR predicate name> "(" [<CBR case description>] ")"
<CBR predicate name> ::= [<Variable> "/" ] <General type> 
