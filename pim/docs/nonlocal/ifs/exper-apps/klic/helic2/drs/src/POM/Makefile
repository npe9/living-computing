OBJS	=  	atomTb.o	pomTrans.o	strMat.o	vecMatU.o \
		viewUur.o	justify.o	spSu.o	suu.o	  \
		viewDef.o	viewUurM.o 	pom.o		spUur.o \
		vecMat.o	viewTab.o


DB		= 	$(SRC)/DB

all 		:	$(OBJS)

clean		:	
			/bin/rm -f  *.o *.ext *.c *.h *.db


atomTb.o	:	atomTb.kl1
			klic -x$(DB) -c   atomTb.kl1
pomTrans.o	:	pomTrans.kl1
			klic -x$(DB) -c   pomTrans.kl1
strMat.o	:	strMat.kl1
			klic -x$(DB) -c   strMat.kl1
vecMatU.o 	:	vecMatU.kl1
			klic -x$(DB) -c   vecMatU.kl1
viewUur.o	:	viewUur.kl1
			klic -x$(DB) -c   viewUur.kl1
justify.o	:	justify.kl1
			klic -x$(DB) -c   justify.kl1
spSu.o		:	spSu.kl1
			klic -x$(DB) -c   spSu.kl1
suu.o	  	:	suu.kl1
			klic -x$(DB) -c   suu.kl1
viewDef.o	:	viewDef.kl1
			klic -x$(DB) -c   viewDef.kl1
viewUurM.o 	:	viewUurM.kl1
			klic -x$(DB) -c   viewUurM.kl1
pom.o		:	pom.kl1
			klic -x$(DB) -c   pom.kl1
spUur.o 	:	spUur.kl1
			klic -x$(DB) -c   spUur.kl1
vecMat.o	:	vecMat.kl1
			klic -x$(DB) -c   vecMat.kl1
viewTab.o	:	viewTab.kl1
			klic -x$(DB) -c   viewTab.kl1

