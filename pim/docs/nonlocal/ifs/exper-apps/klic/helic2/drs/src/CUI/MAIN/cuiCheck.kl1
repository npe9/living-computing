:- module rbrcui_check.

:- public 
    unit/4.

:- with_macro pimos. 

%unit
    unit(UnitName,{RPM1,CS},Data,Protocol):-true|
        rbrcui_protocolPool:get(show,unit,[UnitName],ProtocolList),
        send(ProtocolList,RPM1,RPM,Result),
        make_protocol(Result,ok,[],Protocol),
        Data = {RPM,CS}.

%send
    send([Protocol],RPM1,RPM,Result):-true |
        RPM1 = [Protocol|RPM],
        is_normal(Protocol,Result).

%%is_normal
    is_normal(get_parameter(_,_,normal(_)),Result):-true|
        Result = normal(success).
otherwise.
    is_normal(get_parameter(_,_,abnormal(Reason)),Result):-true|
        Result = abnormal(Reason).

%make_protocol
    make_protocol(abnormal(Reason),_,_,Protocol):-true|
        rbrcui_utility:make_errorProtocol(Reason,Protocol).
    make_protocol(normal(success),ProtocolName,Arguments,Protocol):-true|
        Protocol = receive(ProtocolName,Arguments,_).

