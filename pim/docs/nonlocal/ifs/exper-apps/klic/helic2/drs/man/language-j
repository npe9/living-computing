  &define_standpoint.
  罪刑法定主義を重視 := {刑法204条_故意犯説 < 刑法204条_結果的加重犯説}.
  罪のバランスを重視 := {刑法204条_結果的加重犯説 < 刑法204条_故意犯説}.

  &define_view.
  検察 ::= {罪のバランスを重視 < 罪刑法定主義を重視}.
  弁護 ::= {罪刑法定主義を重視 < 罪のバランスを重視}.

[ゴール定義ファイル]

  &define_goal.
  {
    構成要件に該当する(agent=殴る(agent=甲, object=乙, basis=X1, goal=X2), 
