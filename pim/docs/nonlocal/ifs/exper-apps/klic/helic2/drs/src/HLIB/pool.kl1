:-module helic_pool.


pool(PoolName,_,Pool):-true|
        pool(PoolName,Pool).

pool(bag,Pool):-true|
        bag:create(Pool).
pool(stack,Pool):-true|
        stack:create(Pool).
pool(keyed_bag,Pool):-true|
        helic_keyed_bag:create(Pool).
pool(keyed_set,Pool):-true|
        helic_keyed_bag:create(Pool).
