:- module rbrcui_parser.

:- public 
    get_commandArguments/4.
            
:- with_macro pimos.

%get_commandArguments
    get_commandArguments(Command,Parameter,Arguments,Result):-true|
        rbrcui_ioUtility:get_commandArguments("DRS>",Command1,Arguments1),
        parse(Command1,Arguments1,Command2,Parameter2,Arguments2,Result2),
        (   Result2 = normal(_),Command2\=nil->
                Command = Command2,
                Parameter=Parameter2,Arguments=Arguments2,Result=Result2
        ;
            Result2 = normal(_),Command2=nil->
                get_commandArguments(Command,Parameter,Arguments,Result)
        ;
            Result2 = abnormal(Reason)->
                rbrcui_ioUtility:show_error(Reason,R),
                (   wait(R)->
                        get_commandArguments(Command,Parameter,Arguments,Result))
        ).

%nil
    parse(nil,_,Command,Parameter,Arguments,Result):-true|
        Command = nil,Parameter = nil,Arguments=nil,Result=normal(success).

%run
    parse("run",[FileName],Command,Parameter,Arguments,Result):-true|
        Command = run,Parameter = nil,Arguments=[FileName],Result=normal(success).

%load
    parse("load",["goal",FileName],Command,Parameter,Arguments,Result):-true|
        Command = load,Parameter = goal,Arguments=[FileName],Result=normal(success).
    parse("load",["type",FileName],Command,Parameter,Arguments,Result):-true|
        Command = load,Parameter = type,Arguments=[FileName],Result=normal(success).
    parse("load",["rule",FileName],Command,Parameter,Arguments,Result):-true|
        Command = load,Parameter = rule,Arguments=[FileName],Result=normal(success).
    parse("load",["pom",FileName],Command,Parameter,Arguments,Result):-true|
        Command = load,Parameter = pom,Arguments=[FileName],Result=normal(success).

%trans
    parse("trans",["goal",FileName1,FileName2],Command,Parameter,Arguments,Result):-true|
        Command = trans,Parameter = goal,Arguments=[FileName1,FileName2],Result=normal(success).
    parse("trans",["type",FileName1,FileName2],Command,Parameter,Arguments,Result):-true|
        Command = trans,Parameter = type,Arguments=[FileName1,FileName2],Result=normal(success).
    parse("trans",["rule",FileName1,FileName2],Command,Parameter,Arguments,Result):-true|
        Command = trans,Parameter = rule,Arguments=[FileName1,FileName2],Result=normal(success).
    parse("trans",["pom",FileName1,FileName2],Command,Parameter,Arguments,Result):-true|
        Command = trans,Parameter = pom, Arguments=[FileName1,FileName2],Result=normal(success).

%compile 
    parse("compile",["goal",FileName],Command,Parameter,Arguments,Result):-true|
        Command = compile,Parameter = goal,Arguments=[FileName],Result=normal(success).
    parse("compile",["type",FileName],Command,Parameter,Arguments,Result):-true|
        Command = compile,Parameter = type,Arguments=[FileName],Result=normal(success).
    parse("compile",["rule",FileName],Command,Parameter,Arguments,Result):-true|
        Command = compile,Parameter = rule,Arguments=[FileName],Result=normal(success).
    parse("compile",["pom",FileName],Command,Parameter,Arguments,Result):-true|
        Command = compile,Parameter = pom, Arguments=[FileName],Result=normal(success).

%set
    parse("set",["gp",Pos],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = gp,sToiList([Pos],Arguments,Result).
    parse("set",["goal"|List],Command,Parameter,Arguments,Result):-List\=[]|
        Command = set,Parameter = goal,append_string:append_string(List,Goal),
        Arguments = [Goal],Result=normal(success).
    parse("set",["view",View],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = useView,sToaList([View],Arguments,Result).
    parse("set",["sp"|SPList],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = useSpPriority,sToaList(SPList,Arguments,Result).
    parse("set",["unit"|UnitList],Command,Parameter,Arguments,Result):-UnitList\=[]|
        Command = set,Parameter = useUnit,sToaList(UnitList,Arguments,Result).
    parse("set",["pl",PL],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = pl,
	set_pl(PL,Arguments,Result).
    parse("set",["pt","h"],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = pt,Arguments=[h],Result=normal(success).
    parse("set",["pt","e"],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = pt,Arguments=[e],Result=normal(success).
    parse("set",["cl",CL],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = cl,
	set_cl(CL,Arguments,Result).
    parse("set",["sim",Sim],Command,Parameter,Arguments,Result):-true|
	Command = set,Parameter=similarity,
        set_similarity(Sim,Arguments,Result).
    parse("set",["weight",W],Command,Parameter,Arguments,Result):-true|
	Command = set,Parameter=weight,
        set_weight(W,Arguments,Result).
    parse("set",["ptst"|PsiTermSimTB],
                Command,Parameter,Arguments,Result):-PsiTermSimTB\=[]|
	Command = set,Parameter=psiTermSimTB,
        set_psiTermSimTB(PsiTermSimTB,Arguments,Result).
    parse("set",["ptaw",PsiTermAttWeight],
                Command,Parameter,Arguments,Result):-true|
	Command = set,Parameter=psiTermAttWeight,
        set_psiTermAttWeight(PsiTermAttWeight,Arguments,Result).

%send
%%view
    parse("show",["goal"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = goal,Arguments=[],Result=normal(success).
    parse("show",["view"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = useView,Arguments=[],Result=normal(success).
    parse("show",["sp"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = useSpPriority,Arguments=[],Result=normal(success).
    parse("show",["unit"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = useUnit,Arguments=[],Result=normal(success).
    parse("show",["view",View],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = view,sToaList([View],Arguments,Result).
    parse("show",["sp",SP],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = sp,sToaList([SP],Arguments,Result).
    parse("show",["unit",Unit],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = unit,sToaList([Unit],Arguments,Result).
    parse("show",["pl"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = pl,Arguments=[],Result=normal(success).
    parse("show",["pt"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = pt,Arguments=[],Result=normal(success).
    parse("show",["cl"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = cl,Arguments=[],Result=normal(success).
    parse("show",["sim"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = similarity,Arguments=[],Result=normal(success).
    parse("show",["weight"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = weight,Arguments=[],Result=normal(success).
    parse("show",["ptst"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = psiTermSimTB,Arguments=[],Result=normal(success).
    parse("show",["ptaw"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = psiTermAttWeight,Arguments=[],Result=normal(success).

%start
    parse("solve",[],Command,Parameter,Arguments,Result):-true|
        Command = solve,Parameter = nil,Arguments=[],Result=normal(success).
    parse("solve",List,Command,Parameter,Arguments,Result):-List \=[]|
        Command = solve,Parameter = nil,append_string:append_string(List,Goal),
        Arguments = [Goal],Result=normal(success).

%argument brawser
    parse("ab",[],Command,Parameter,Arguments,Result):-true|
        Command = ab,Parameter = argument,Arguments=[],Result=normal(success).

%quit
    parse("quit",[],Command,Parameter,Arguments,Result):-true|
        Command = quit,Parameter = nil,Arguments=[],Result=normal(success).

%tracer
%%flag
    parse("set",["tf","on"],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = tf,Arguments=[on],Result=normal(success).
    parse("set",["tf","off"],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = tf,Arguments=[off],Result=normal(success).
    parse("show",["tf"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = tf,Arguments=[],Result=normal(success).
%%spy(rule)
    parse("set",["sr"|SpyRuleList],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = sr,sToaList(SpyRuleList,Arguments,Result).
    parse("add",["sr"|SpyRuleList],Command,Parameter,Arguments,Result):-SpyRuleList\=[]|
        Command = add,Parameter = sr,sToaList(SpyRuleList,Arguments,Result).
    parse("remove",["sr"|SpyRuleList],Command,Parameter,Arguments,Result):-SpyRuleList\=[]|
        Command = remove,Parameter = sr,sToaList(SpyRuleList,Arguments,Result).
    parse("clear",["sr"],Command,Parameter,Arguments,Result):-true|
        Command = clear,Parameter = sr,Arguments=[],Result=normal(success).
    parse("show",["sr"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = sr,Arguments=[],Result=normal(success).
%%spy(gate)
    parse("set",["sg"|SpyGateList1],Command,Parameter,Arguments,Result):-true|
        Command = set,Parameter = sg,
        get_spyGateList(SpyGateList1,Arguments,Result).
    parse("add",["sg"|SpyGateList1],Command,Parameter,Arguments,Result):-SpyGateList1\=[]|
        Command = add,Parameter = sg,
        get_spyGateList(SpyGateList1,Arguments,Result).
    parse("remove",["sg"|SpyGateList1],Command,Parameter,Arguments,Result):-SpyGateList1\=[]|
        Command = remove,Parameter = sg,
        get_spyGateList(SpyGateList1,Arguments,Result).
    parse("clear",["sg"],Command,Parameter,Arguments,Result):-true|
        Command = clear,Parameter = sg,Arguments=[],Result=normal(success).
    parse("show",["sg"],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = sg,Arguments=[],Result=normal(success).
%help
    parse("help",[],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = help,Arguments=[],Result=normal(success).
    parse("help",[C],Command,Parameter,Arguments,Result):-true|
        Command = send,Parameter = help,Arguments=[C],Result=normal(success).
otherwise.
    parse(_,_,_,_,_,Result):-true|
        Result = abnormal({drs,'Illegal command or arguments',nil}).

    sToiList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToiList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   integer(A)->
                sToiList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({drs,'Illegal integer',A})
        ).

    sToaList([],List,Result):-true |
        List = [],
        Result = normal(success).
    sToaList([S|T],List,Result):-true |
        hLibrary:sTot(S,A),
        (   atom(A)->
                sToaList(T,List1,Result),
                List = [A|List1]
        ;
        otherwise;
            true->
                Result= abnormal({drs,'Illegal atom',A})
        ).
                

    get_spyGateList([],L,R):-true|
        L = [],
        R = normal(success).
    get_spyGateList(["call"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [call|L1].
    get_spyGateList(["redu"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [redu|L1].
    get_spyGateList(["fail"|T],L,R):-true|
        get_spyGateList(T,L1,R),
        L = [fail|L1].
otherwise.
    get_spyGateList([H|_],_,R):-true|
        R = abnormal({drs,'Illegal Argument',H}).


%%%%%
    set_similarity(Sim1,Arguments,Result):-true|
        sToiList([Sim1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[Sim],
                ( Sim>0,Sim=<100 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal similarity',Sim})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_weight(W1,Arguments,Result):-true|
        sToiList([W1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[W],
                ( W>0,W=<10 ->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal weight',W})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

    set_psiTermSimTB([A1,B1,C1,D1,E1,F1],Arguments,Result):-true|
        sToiList([A1,B1,C1,D1,E1,F1],Arguments1,R1),
        ( R1 = normal(success)->
		Arguments1=[A,B,C,D,E,F],
                ( 100>=A,A>=B,B>=C,C>=D,D>=E,E>=F,F>0->
                   Arguments = [{A,B,C,D,E,F}],Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal psiTermSimTB',[A,B,C,D,E,F]})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).
otherwise.
    set_psiTermSimTB(TB,_,Result):-true|
        Result = abnormal({cui,'Illegal psiTermSimTB',TB}).

    set_psiTermAttWeight(PsiTermAttWeight1,Arguments,Result):-true|
        sToiList([PsiTermAttWeight1],Arguments,R1),
        ( R1 = normal(success)->
		Arguments=[PsiTermAttWeight],
                (  PsiTermAttWeight>0,PsiTermAttWeight=<10->
                   Result = normal(success)
                ;
                otherwise;
                  true->
                   Result = abnormal({cui,'Illegal psiTermAttWeight',PsiTermAttWeight})
                )
        ;
          R1 = abnormal(_)->
                Result = R1
        ).

%%set pl
    set_pl(PL1,Arguments,Result):-true|
        sToiList([PL1],Arguments,R1),
	( R1 = normal(success)->
            Arguments=[PL],
	    ( integer(PL),PL>0->
	        Result = normal(success)
	    ;
	     otherwise;
	      true->
	        Result = abnormal({cui,'Illegal pl',PL})
	    )
	;
	  R1 = abnormal(_)->
	    Result = R1
	).

%set_cl
    set_cl(CL1,Arguments,Result):-true|
	sToiList([CL1],Arguments1,Result1),
	( Result1 = normal(success),Arguments1=[CL],CL>=0->
	    Arguments = [CL],Result= normal(success)
	;
	  Result1 = normal(success),Arguments1=[-1]->
	    Arguments = [infinite],Result= normal(success)
	;
	otherwise;
	  true->
	    Result = Result1
	).

