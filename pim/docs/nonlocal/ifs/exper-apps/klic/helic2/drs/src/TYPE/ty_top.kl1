process([lower_bound(X,LB,Result)|Stream],TypeDB):-
    ty_lat:lower_bound(X,LB,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).
%process([lower_bound(X,LB,Result,Debug)|Stream],TypeDB):-
%    Debug = [nodebug],
%    ty_lat:lower_bound(X,LB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-else.
%process([lower_bound(X,LB,Result)|Stream],TypeDB):-
%    ty_lat:lower_bound(_Debug,[],X,LB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%process([lower_bound(X,LB,Result,Debug)|Stream],TypeDB):-
%    ty_lat:lower_bound(Debug,[],X,LB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-end_if.

%=====================================================================
% D immediate_lower_bound(X,^ILB,^Result)
%=====================================================================
%:-if_equal(debug,no).
process([immediate_lower_bound(X,ILB,Result)|Stream],TypeDB):-
    ty_lat:immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).
%process([immediate_lower_bound(X,ILB,Result,Debug)|Stream],TypeDB):-
%    Debug = [nodebug],
%    ty_lat:immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-else.
%process([immediate_lower_bound(X,ILB,Result)|Stream],TypeDB):-
%    ty_lat:immediate_lower_bound(_Debug,[],X,ILB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%process([immediate_lower_bound(X,ILB,Result,Debug)|Stream],TypeDB):-
%    ty_lat:immediate_lower_bound(Debug,[],X,ILB,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-end_if.

otherwise.
% skip unknown message
process([Message|Stream],TypeDB):-
%    hLibrary:stdio(out,OutStream),
    ty_osif:stdio(out,OutStream),
%    Depth = 20,
%    Length = 20,
%    variable:wrap(Message,Result,Depth,Length),
    variable:wrap(Message,WrappedTerm),
%    vector_element(Result,1,WrappedTerm,_),
%    OutStream = [putf("~nUnknown message : ~w~n",[WrappedTerm]),flush(_)],
    OutStream = [putc(key#lf),fwrite("Unknown message : ",_),
		 putwt(WrappedTerm),putc(key#lf),fflush(_)],
    process(Stream,TypeDB).



