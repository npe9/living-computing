% D load(SavePathname,^Result)
%=====================================================================
%:-if_equal(debug,no).
process([load(SavePathname,Result)|Stream],TypeDB):-
    free_typeDB(TypeDB),
    ty_tload:load(SavePathname,NewTypeDB,Result),
    process(Stream,NewTypeDB).
