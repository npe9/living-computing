:- module ty_top.
%:- with_macro ty_macro.
:- with_macro pimos.

%:-include("debug.h").

:- public compile_type/3,create_type/3.

% for debug
%:- public compile_type/4,create_type/4.
:- public create/1.



% message dispatching for compiler

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S compile_type(Pathname,SavePathname,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
%:-if_equal(debug,no).
compile_type(SourcePathname,SavePathname,Result):-
    ty_tcmp:compile(SourcePathname,SavePathname,Result).

%compile_type(SourcePathname,SavePathname,Result,Debug):-
%    ty_tcmp:compile(SourcePathname,SavePathname,Result),
%    Debug = [nodebug].
%:-else.
%compile_type(SourcePathname,SavePathname,Result):-
%    ty_tcmp:compile(_Debug,[],SourcePathname,SavePathname,Result).
%
%compile_type(SourcePathname,SavePathname,Result,Debug):-
%    ty_tcmp:compile(Debug,[],SourcePathname,SavePathname,Result).
%:-end_if.


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S compile_poset(Pathname,SavePathname,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++


% process creation, message handling

%=====================================================================
% C create(^Stream)
%=====================================================================
% for debug
create(Stream):-
%    process(Stream,ty#void).
    process(Stream,'&void').

%=====================================================================
% C create_type(Pathname,^Stream,^Result)
%=====================================================================
%:-if_equal(debug,no).
create_type(Pathname,Stream,Result):-
    ty_tload:load(Pathname,TypeDB,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        Result = R1,
        process(Stream,TypeDB)
    ;otherwise;true ->
        Result = R1
    ).

%create_type(Pathname,Stream,Result,Debug):-
%    Debug = [nodebug],
%    ty_tload:load(Pathname,TypeDB,R1),
%%    (R1 = normal(ty#yes) ->
%    (R1 = normal(success) ->
%        Result = R1,
%        process(Stream,TypeDB)
%    ;otherwise;true ->
%        Result = R1
%    ).
%:-else.
%create_type(Pathname,Stream,Result):-
%    ty_tload:load(_DebugInfo,[],Pathname,TypeDB,R1),
%%    (R1 = normal(ty#yes) ->
%    (R1 = normal(success) ->
%        Result = R1,
%        process(Stream,TypeDB)
%    ;otherwise;true ->
%        Result = R1
%    ).
%
%create_type(Pathname,Stream,Result,DebugInfo):-
%    ty_tload:load(DebugInfo,[],Pathname,TypeDB,R1),
%%    (R1 = normal(ty#yes) ->
%    (R1 = normal(success) ->
%        Result = R1,
%        process(Stream,TypeDB)
%    ;otherwise;true ->
%        Result = R1
%    ).
%:-end_if.

%=====================================================================
% M []
%=====================================================================
process([],TypeDB):-
    free_typeDB(TypeDB).

%=====================================================================
% M subsume(X,Y,Env,^NewEnv,^Result)
%=====================================================================
%=====================================================================
% M subsume(X,Y,^NewX,^NewY,Env,^NewEnv,^Result)
%=====================================================================
%:-if_equal(debug,no).
process([subsume(X,Y,Env,NewEnv,Result)|Stream],TypeDB):-
    ty_att:psubsume(X,Y,Env,NewEnv,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).
%process([subsume(X,Y,Env,NewEnv,Result,Debug)|Stream],TypeDB):-
%    Debug = [nodebug],
%    ty_att:psubsume(X,Y,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
process([subsume(X,Y,NewX,NewY,Env,NewEnv,Result)|Stream],TypeDB):-
    ty_att:psubsume(X,Y,NewX,NewY,Env,NewEnv,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).
%process([subsume(X,Y,NewX,NewY,Env,NewEnv,Result,Debug)|Stream],TypeDB):-
%    Debug = [nodebug],
%    ty_att:psubsume(X,Y,NewX,NewY,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-else.
%process([subsume(X,Y,Env,NewEnv,Result)|Stream],TypeDB):-
%    ty_att:psubsume(_Debug,[],X,Y,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%process([subsume(X,Y,Env,NewEnv,Result,Debug)|Stream],TypeDB):-
%    ty_att:psubsume(Debug,[],X,Y,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%process([subsume(X,Y,NewX,NewY,Env,NewEnv,Result)|Stream],TypeDB):-
%    ty_att:psubsume(_Debug,[],X,Y,NewX,NewY,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%process([subsume(X,Y,NewX,NewY,Env,NewEnv,Result,Debug)|Stream],TypeDB):-
%    ty_att:psubsume(Debug,[],X,Y,NewX,NewY,Env,NewEnv,TypeDB,NewTypeDB,Result),
%    process(Stream,NewTypeDB).
%:-end_if.

