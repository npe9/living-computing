%=====================================================================
% M get_explanations(X,^NewX,Explanations,^Result)
%=====================================================================
process([get_explanations(X,Explanations,Result)|Stream],TypeDB):-
    ty_info:get_explanations(X,Explanations,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).
process([get_explanations(X,NewX,Explanations,Result)|Stream],TypeDB):-
    ty_info:get_explanations(X,NewX,Explanations,TypeDB,NewTypeDB,Result),
    process(Stream,NewTypeDB).

%=====================================================================
% D compile_type(SourcePathname,SavePathname,^Result)
%=====================================================================
process([compile_type(SourcePathname,SavePathname,Result)|Stream],TypeDB):-
    compile_type(SourcePathname,SavePathname,Result),
    process(Stream,TypeDB).

%process([compile_type(SourcePathname,SavePathname,Result,Debug)|Stream],TypeDB):-
%    compile_type(SourcePathname,SavePathname,Result,Debug),
%    process(Stream,TypeDB).


