:- module slv_currentState.

:- public 
    create/2.
            
:- with_macro pimos.

%create
    create({IAL,NH,DP},I):-true| 
        loop(I,{nil,nil,[],{nil,nil},DP,IAL,NH}).

%0:argumentList 1:counterList 2:forwardList 3:displayArgInfo
%4:displayParameter 5:ial 6:nh

%loop
    loop([],ElementVec):-true|
        get_elementPos(ial,Pos1),
        get_elementPos(nh,Pos2),
        vector_element(ElementVec,Pos1,Pool1,_),
        vector_element(ElementVec,Pos2,Pool2,_),
        Pool1=[],Pool2=[].
    loop([set(ElementName,E)|T],ElementVec1):-true|
        get_elementPos(ElementName,ElementPos),
        set_vector_element(ElementVec1,ElementPos,_,E,ElementVec),
        loop(T,ElementVec).
    loop([get(ElementName,E)|T],ElementVec):-true|
        get_elementPos(ElementName,ElementPos),
        vector_element(ElementVec,ElementPos,E,_),
        loop(T,ElementVec).
    loop([get_pos(ElementName,Pos,EE)|T],ElementVec):-true|
        get_elementPos(ElementName,ElementPos),
        vector_element(ElementVec,ElementPos,List,_),
        get_element(List,0,Pos,EE),
        loop(T,ElementVec).
    loop([send(ElementName,Command)|T],ElementVec1):-true|
        get_elementPos(ElementName,Pos),
        vector_element(ElementVec1,Pos,Pool1,_),
        Pool1 = [Command|Pool],
        set_vector_element(ElementVec1,Pos,_,Pool,ElementVec),
        loop(T,ElementVec).

%get_elementPos
    get_elementPos(argumentList,Pos):-true|
        Pos = 0.
    get_elementPos(counterList,Pos):-true|
        Pos = 1.
    get_elementPos(forwardList,Pos):-true|
        Pos = 2.
%    get_elementPos(displayArgInfo,Pos):-true|
%        Pos = 3.
    get_elementPos(displayParameter,Pos):-true|
        Pos = 4.
    get_elementPos(ial,Pos):-true|
        Pos = 5.
    get_elementPos(nh,Pos):-true|
        Pos = 6.

%get_element
    get_element([E1|_],L,L,E):-true|
        E = E1.
otherwise.
    get_element([_|T],W,L,E):-true|
        W1 := W +1,
        get_element(T,W1,L,E).
