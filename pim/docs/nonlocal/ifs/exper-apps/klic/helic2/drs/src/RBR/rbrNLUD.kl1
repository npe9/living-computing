:- module rbr_oldt.
:- public 
    solve/3,
%*    solve1/7,
    counter_solve_top/4.
:- with_macro pimos.

% <Query> ::= {<Hterm>,<Env>,<HIDT>}
solve(Query,RM,ST):-
    solve(Query,RM,ST,not_counter,0).

%%oosaki
%solve(Query,RM,ST,CF,CounterD):-
%  rbr_solution_table:create_with_hash(100,ST0), 
%  RM = {RM1,RM2,RM3},
%  solve(Query,ST0,RM1,STm,[],not_top,[]), 
%  rbr_eval_answer:eval_answer(STm,RM2,STmm),
%  rbr_counter:dr(CF,STmm,RM3,ST,CounterD).

solve(Query,RM,ST,CF,CounterD):- true|
   rbr_solution_table:create_with_hash(100,ST0), 
   RM = {RM1,RM2,RM3,RM4},                              %add RM4
   RM4 = [                                              %add
          tracer(get(callNumber,CN,_R2)),               %add
          tracer(print(call,Query,CN,_R3))],            %add
        solve(Query,CN,ST0,RM1,STm,[],not_top,[]),      %add CN
        rbr_eval_answer:eval_answer(STm,RM2,STmm),
        rbr_counter:dr(CF,STmm,RM3,ST,CounterD).


%%oosaki  
%counter_solve_top(Query,RM,ST,CounterD):-
%  solve(Query,RM,ST,counter_top,CounterD).

counter_solve_top(Query,RM,ST,CounterD):-

    RM = {RM1,RM2},
    RM1 = [                                             %add
          tracer(get(callNumber,CN,R1)),                %add
          tracer(print(call,Query,CN,R2))],             %add
    ( wait(R1),wait(R2)->
        solve(Query,RM2,ST,counter_top,CounterD)).

%%oosaki
%solve(Query,ST,RM,ST1,ST1T,TF,RLS):-
%  blt_chk(Query,Res),
%  solve_bc(Res,Query,ST,RM,ST1,ST1T,TF,RLS).

solve(Query,CN,ST,RM,ST1,ST1T,TF,RLS):-                 %add CN
  blt_chk(Query,Res),
  solve_bc(Res,Query,CN,ST,RM,ST1,ST1T,TF,RLS).         %add NC

%%oosaki
%solve_bc(yes,Query,ST,RM,ST1,ST1T,TF,_RLS):-
%  solve_blt(Query,ST,RM,ST1,ST1T,TF).
%solve_bc(no,Query,ST,RM,ST1,ST1T,TF,RLS):-
%  solve0(Query,ST,RM,ST1,ST1T,TF,RLS).

solve_bc(yes,Query,CN,ST,RM,ST1,ST1T,TF,_RLS):-         %add CN
  solve_blt(Query,CN,ST,RM,ST1,ST1T,TF).                %add CN
solve_bc(no,Query,CN,ST,RM,ST1,ST1T,TF,RLS):-           %add CN
  solve0(Query,CN,ST,RM,ST1,ST1T,TF,RLS).               %add CN

%oosaki
%solve0({{not,{Q,CL,OC}},_Env,_HIDT},ST,RM,ST1,ST1T,_TF,_RLS):-
%  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,_Q1,ST2,new(Node)),
%  rbr_solution_table:update_data(Node,ST2,naf,ST3),
%  ST1 = [naf(Node,ST3)|ST1T],
%  RM = [].
%solve0({{[],{Q,CL,OC}},Env,HIDT},ST,RM,ST1,ST1T,TF,RLS):-
%  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,Q1,ST2,Result),
%  solve1(Result,{Q1,Env,HIDT},ST2,RM,ST1,ST1T,TF,RLS).
%solve0({{[],hp(HID,{Q,CL,OC})},Env,HIDT},ST,RM,ST1,ST1T,TF,RLS):-
%  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,Q1,ST2,Result),
%  solve1(Result,hp(HID,{Q1,Env,HIDT}),ST2,RM,ST1,ST1T,TF,RLS).

solve0({{not,{Q,CL,OC}},Env,HIDT},CN,ST,RM,ST1,ST1T,_TF,_RLS):-                 %add CN
  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,_Q1,ST2,new(Node)),
  rbr_solution_table:update_data(Node,ST2,naf,ST3),
  ST1 = [naf(Node,ST3)|ST1T],
  RM  = [tracer(print(redu,not,{{Q,CL,OC},Env,HIDT},CN,[],_,_R))].      %add
solve0({{[],{Q,CL,OC}},Env,HIDT},CN,ST,RM,ST1,ST1T,TF,RLS):-                    %add CN
  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,Q1,ST2,Result),           
  solve1(Result,{Q1,Env,HIDT},CN,ST2,RM,ST1,ST1T,TF,RLS).                       %add CN
solve0({{[],hp(HID,{Q,CL,OC})},Env,HIDT},CN,ST,RM,ST1,ST1T,TF,RLS):-            %add CN
  rbr_solution_table:check_and_put_query({Q,CL,OC},ST,Q1,ST2,Result),
  solve1(Result,hp(HID,{Q1,Env,HIDT}),CN,ST2,RM,ST1,ST1T,TF,RLS).               %add CN

%oosaki
%solve1(new(Node),Q,ST,RM,ST1,ST1T,TF,RLS):-
%  RM = [get_rules(Q,RLS,OrRuleList)|RM1],
%  solveOR(OrRuleList,Node,Q,ST,RM1,ST1,ST1T,TF,RLS).

solve1(new(Node),Q,CN,ST,RM,ST1,ST1T,TF,RLS):-          %add CN
  RM = [get_rules(Q,RLS,OrRuleList)|RM1],
  solveOR(OrRuleList,Node,Q,CN,ST,RM1,ST1,ST1T,TF,RLS). %add CN

%oosaki
%solveOR([],Node,{_Q,Env,HIDT},ST,RM,ST1,ST1T,_TF,_RLS):-
%  rbr_solution_table:update_data(Node,ST,fail,ST2),
%  ST1 = [fail(Node,ST2,Env,HIDT)|ST1T],
%  RM = [].
%solveOR([],Node,hp(_HID,{_Q,Env,HIDT}),ST,RM,ST1,ST1T,_TF,_RLS):-
%  rbr_solution_table:update_data(Node,ST,fail,ST2),
%  ST1 = [fail(Node,ST2,Env,HIDT)|ST1T],
%  RM = [].
%solveOR(OrRuleList,Node,Q,ST,RM,ST1,ST1T,TF,RLS):-
%  list(OrRuleList) |
%  solveOR1(OrRuleList,Node,Q,ST,RM,ST1,ST1T,TF,RLS).

solveOR([],Node,{Q,Env,HIDT},CN,ST,RM,ST1,ST1T,_TF,_RLS):-              %add CN
  rbr_solution_table:update_data(Node,ST,fail,ST2),
  ST1 = [fail(Node,ST2,Env,HIDT)|ST1T],
  RM  = [tracer(print(fail,{Q,Env,HIDT},CN,_R1))].                      %add
solveOR([],Node,hp(HID,{Q,Env,HIDT}),CN,ST,RM,ST1,ST1T,_TF,_RLS):-      %add CN
  rbr_solution_table:update_data(Node,ST,fail,ST2),
  ST1 = [fail(Node,ST2,Env,HIDT)|ST1T],
  RM  = [tracer(print(fail,hp(HID,{Q,Env,HIDT}),CN,_R1))].              %add
solveOR(OrRuleList,Node,Q,CN,ST,RM,ST1,ST1T,TF,RLS):-                   %add CN
  list(OrRuleList) |
  solveOR1(OrRuleList,Node,Q,CN,ST,RM,ST1,ST1T,TF,RLS).                 %add CN

%oosaki
%solveOR1([],_Node,_Q,_ST,RM,ST1,ST1T,_TF,_RLS):-
%  ST1 = ST1T,
%  RM = [].
%solveOR1([{Rule,BLH,Qnew,cbr}|BLT],Node,Q,ST,RM,ST1,ST1T,TF,RLS):-
%  Rule = {RN,_} |
%  get_real_entry(Qnew,Entry,Qnew1),
%  RM = {RM1,RM2},
%  rbr_solution_table:update_entry(Node,ST,Entry,ST0),
%  cbr_solveAND(BLH,Rule,[],Node,Qnew1,ST0,RM1,ST1,ST1T0,TF,[RN|RLS]),
%  solveOR1(BLT,Node,Q,ST,RM2,ST1T0,ST1T,TF,RLS).
%solveOR1([{Rule,BLH,Qnew}|BLT],Node,Q,ST,RM,ST1,ST1T,TF,RLS):-
%  Rule = {RN,_} |
%  get_real_entry(Qnew,Entry,Qnew1),
%  RM = {RM1,RM2},
%  rbr_solution_table:update_entry(Node,ST,Entry,ST0),
%  solveAND(BLH,Rule,[],Node,Qnew1,ST0,RM1,ST1,ST1T0,TF,[RN|RLS]),
%  solveOR1(BLT,Node,Q,ST,RM2,ST1T0,ST1T,TF,RLS).

solveOR1([],_Node,_Q,_CN,_ST,RM,ST1,ST1T,_TF,_RLS):-                    %add CN
  ST1 = ST1T,
  RM = [].
solveOR1([{Rule,BLH,Qnew,cbr}|BLT],Node,Q,CN,ST,RM,ST1,ST1T,TF,RLS):-   %add CN
  Rule = {RN,_} |
  get_real_entry(Qnew,Entry,Qnew1),
  RM = {RM1,RM2,RM3},                                                   %add RM3
  rbr_solution_table:update_entry(Node,ST,Entry,ST0),

  RM3 = [tracer(print(redu,RN,Qnew1,CN,BLH,BLH_CN,R1))],                %add

  ( wait(R1)->                                                          %add
        cbr_solveAND(BLH_CN,Rule,[],Node,Qnew1,ST0,RM1,ST1,ST1T0,TF,[RN|RLS]),  
                                                                        %modify BLH ->BLH_CN
        solveOR1(BLT,Node,Q,CN,ST,RM2,ST1T0,ST1T,TF,RLS)).              %add CN
solveOR1([{Rule,BLH,Qnew}|BLT],Node,Q,CN,ST,RM,ST1,ST1T,TF,RLS):-       %add CN
  Rule = {RN,_} |
  get_real_entry(Qnew,Entry,Qnew1),
  RM = {RM1,RM2,RM3},                                                   %add RM3
  rbr_solution_table:update_entry(Node,ST,Entry,ST0),

  RM3 = [tracer(print(redu,RN,Qnew1,CN,BLH,BLH_CN,R1))],                %add

  ( wait(R1)->
        solveAND(BLH_CN,Rule,[],Node,Qnew1,ST0,RM1,ST1,ST1T0,TF,[RN|RLS]),
                                                                        %modify BLH ->BLH_CN
        solveOR1(BLT,Node,Q,CN,ST,RM2,ST1T0,ST1T,TF,RLS)).              %add CN

%oosaki
