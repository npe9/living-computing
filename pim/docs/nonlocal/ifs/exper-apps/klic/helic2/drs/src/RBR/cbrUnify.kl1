%otherwise.
predAdd1(_,_,Env,IDTable,List,
        TS,TS1,NewHT,NewEnv,NewIDTable,Result,AddList):- true |
      Result=fail,TS=TS1,NewHT=[],Env=NewEnv,IDTable=NewIDTable,AddList=List.

