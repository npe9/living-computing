%%oosaki modify & add 960408
%H-Table ni pterm(X,Y) ga haixtutekitatokino shori wo tuika
%     vector_element(HTL1,0,A,_),
%     vector_element(HTL1,1,Term,_),
%     vector_element(HTL1,2,Tr,_),
%     vector_element(HTL2,1,L2Term,_),

     vector_element(HTL1,0,A,_),
     vector_element(HTL1,1,Term1,_),
     vector_element(HTL1,2,Tr,_),
     vector_element(HTL2,1,L2Term1,_),
     get_purePTerm(Term1,Term),
     get_purePTerm(L2Term1,L2Term),

%%
     predUnify3(Term,L2Term,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Res), %mod Result -> Res

     NHTPred = {A,NHT,Tr,Res},
     Result  = success.

predUnify2(no,HTL1,_,{_,HN23},Env,_,IDTable,List,TS,NHTPred,NEnv,NIDTable,TSs,
               Result,AddList):- 
            integer(HN23) |
     predAdd1(HTL1,HN23,Env,IDTable,List,TS,TSs,_NHT,NEnv,NIDTable,
            Res,AddList),

%oosaki modify
%     vector_element(HTL1,0,A,_),
%     predAddC1(Res,A,NHT,NHTPred,Result).

     vector_element(HTL1,0,A,_),
     vector_element(HTL1,1,Term1,_),
     
     ( Res = success ->
             Term = Term1
     ;
       Res = fail ->
             Term = dummy
     ),
     ( vector(HTL1,3)->                         %for event
             vector_element(HTL1,2,Tr,_),
             NHTPred = {A,Term,Tr,Res}
     ;
       vector(HTL1,2)->                         %for property
             Tr = 0,
             NHTPred = {A,Term,Tr,Res}

%oosaki add 960408
%H-Table ni pterm(X,Y)to iu data ga haixtuteiirutokinoshori
     ;
       vector(HTL1,4)->                 
             NHTPred = HTL1
     ),
     Result  = success.

otherwise.
predUnify2(no,HTL1,_,_,Env,_,IDTable,List,TS,NHTPred,NEnv,NIDTable,TSs,
               Result,AddList):- true |
     Env=NEnv,
     TS=TSs,

%oosaki modify
%     NHTPred=HTL1,
%     termCheck([HTL1],List,IDTable,AddList,NIDTable,Result).

     vector_element(HTL1,0,A,_),
     vector_element(HTL1,1,Term,_),
     ( vector(HTL1,3)->                         %for event
             vector_element(HTL1,2,Tr,_),
             NHTPred = {A,dummy,Tr,fail}
     ;
       vector(HTL1,2)->                         %for property
             Tr = 0,
             NHTPred = {A,dummy,Tr,fail}
     ),
     termCheck([HTL1],List,IDTable,AddList,NIDTable,_),
     Result = success.

%%oosaki add 960404
get_purePTerm(pterm(PT1,_),PT):-true|
     PT = PT1.
otherwise.
get_purePTerm(Term1,Term):-true|
     Term = Term1.
%%


predUnify3(Term1,Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- 
                        integer(Term1) |
     pTermCheck(Term2,Ans),
     predUnify3PT(Ans,Term1,Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
predUnify3({TermNumber},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- true |
     hTermCheck(Term2,Ans),
     predUnify3HT(Ans,{TermNumber},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
%$predUnify3({T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- 
%$       vector(T1) |
%$     hTermCheck(Term2,Ans),
%$     predUnify3HT(Ans,{T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
%$otherwise.
%$predUnify3({T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):-
%$       true |
%$     pTermCheck(Term2,Ans),
%$     predUnify3PT(Ans,{T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
predUnify3({T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):-
     list(T3) |
     pTermCheck(Term2,Ans),
     predUnify3PT(Ans,{T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
predUnify3({T1,T2,[]},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):-
     pTermCheck(Term2,Ans),
     predUnify3PT(Ans,{T1,T2,[]},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).
otherwise.
predUnify3({T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- 
       vector(T1) |
     hTermCheck(Term2,Ans),
     predUnify3HT(Ans,{T1,T2,T3},Term2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).


pTermCheck(Term,Ans):- integer(Term) | Ans=yes.
pTermCheck({_,T2,T3},Ans):- integer(T2),list(T3) | Ans=yes.
pTermCheck({_,T2,[]},Ans):- integer(T2)| Ans=yes. %$ insert line
otherwise.
pTermCheck(_,Ans):- true | Ans=no.

hTermCheck({TNumber},Ans):- integer(TNumber) | Ans=yes.
hTermCheck({_,_,T3},Ans):- integer(T3) | Ans=yes.
hTermCheck({_,_,@},Ans):- true | Ans=yes.
otherwise.
hTermCheck(_,Ans):- true | Ans=no.

%%%%%%%%%%%%%%%%%%%
predUnify3PT(no,_,_,Env,_,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- true |
           NEnv=Env,NIDTable=IDTable,TS=TSs,Result=fail,NHT=[].
predUnify3PT(yes,PTerm1,PTerm2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- true |
     NIDTable=IDTable,
     predUnify1case(PTerm1,PTerm2,TS,Env,CEnv,TSs,NHT,NEnv,Result).

predUnify3HT(no,_,_,Env,_,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- true |
           NEnv=Env,NIDTable=IDTable,TS=TSs,Result=fail,NHT=[].
predUnify3HT(yes,HTerm1,HTerm2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result):- true |
     hTUnify0(HTerm1,HTerm2,Env,CEnv,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result).



%oosaki test
%predUnify1(PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result):-
%     TS=[glb(PTerm1,PTerm2,NPT,Env,NewEnv,Result0)|TSs],
%     reChange(Result0,Result).

predUnify1(PTerm1,PTerm2,TS1,Env1,CEnv,TS,NPT,Env,Result):-
     unify_ptermForCBR:unify(PTerm1,PTerm2,TS1,Env1,CEnv,TS,NPT,Env,Result).

scIDto0({V,_,ATR},PTermN):-
    PTermN = {V,0,ATR}.     
otherwise.
scIDto0(PTerm,PTermN):-
    PTermN = PTerm.

predUnify1case(PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result):-
    integer(PTerm1) |
    predUnify10case(normal(success),PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result).
predUnify1case(PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result):-
    integer(PTerm2) |
    predUnify10case(normal(success),PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result).
otherwise.
predUnify1case(PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result):- true |
    scIDto0(PTerm1,PTerm1n),
    scIDto0(PTerm2,PTerm2n),


           TS=[same(PTerm1n,PTerm2n,Env,Env0,Result0)|TSs0],

%%%%oosaki test
%       TSs0 = TS,
%       Env0 = Env,
%       Result0 = normal(success),

    predUnify10case(Result0,PTerm1,PTerm2,TSs0,Env0,CEnv,TSs,NPT,NewEnv,Result).

predUnify10case(normal(success),PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result):-

%oosaki modify
%           TS=[glb(PTerm1,PTerm2,NPT,Env,NewEnv,Result0)|TSs],
%     reChange(Result0,Result).

     predUnify1(PTerm1,PTerm2,TS,Env,CEnv,TSs,NPT,NewEnv,Result).

otherwise.
predUnify10case(Res,_,_,TS,Env,_,TSs,_,NewEnv,Result):- true |
     Result = Res, NewEnv = Env, TSs = TS.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
append([H|T],L,AL):- true | 
           AL=[H|NAL],
           append(T,L,NAL).
append([],L,AL):- true | AL=L.

reChange(normal(success),Result):- true | Result=success.

%%%%%oosaki add
reChange(normal(fail),Result):- true | Result=fail.        %add

otherwise.
reChange(Res,Result):- true | Result=Res.

%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
property_or_event({_,PT},TS,Env,TS1,R):-
    pterm_with_env_to_type_name(PT,Env,TypeName),
    TS = [upper_bound(TypeName,TL,_)|TS1],
    property_or_event1(TL,R).

pterm_with_env_to_type_name(0,_,TypeName):-
    TypeName = '&top'.
pterm_with_env_to_type_name(VarID,Env,TypeName):-
    VarID > 0 |
    vector_element(Env,VarID,PTerm,Env1),
    pterm_with_env_to_type_name(PTerm,Env1,TypeName).
pterm_with_env_to_type_name(PTerm,_,TypeName):-
    vector(PTerm,3) |
    vector_element(PTerm,0,TypeName,_).

property_or_event1([],R):-
    R = event.
property_or_event1([event|_],R):-
    R = event.
property_or_event1([property|_],R):-
    R = property.
otherwise.
property_or_event1([_|T],R):-
    property_or_event1(T,R).


%%%%%%%%%%%%%%%%%%%
hTUnifySub_o(_,_,_,Env,_,IDTable,{N1,N1},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N1),N1>0 |
      NewIDTable=IDTable,
      Result=success,
      TS=TS1,
      NewEnv=Env,
      NHTerm={N1}.
otherwise.
hTUnifySub_o(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0_o(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,NHTList,
        NewEnv,NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
hTUnifySub_o(fail,_,_,Env,_,IDTable,_,TS,TS1,NHTerm,NewEnv,NewIDTable,Result):- 
                  true |
      Result=fail,NewEnv=Env,NewIDTable=IDTable,NHTerm=[],
      TS1 = TS.
otherwise.
hTUnifySub_o(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- atom(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0_o(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,NHTList,NewEnv,
                   NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTUnifySub_o(Res,_,_,Env,_,IDTable,_,TS,TS1,NHTerm,NewEnv,NewIDTable,Result):- 
                  true |
      TS1 = TS,
      Result=Res,NewEnv=Env,NewIDTable=IDTable,NHTerm=[].

hTUnify1Sub0_o(success,NHT,HTL1,HTL2,{HN13,HN23},Env,CEnv,IDTable,TS,TS1,NewHT,NewEnv,
        NewIDTable,Result) :- true |
      hTUnify1Sub_o(HTL1,HTL2,NHT,{HN13,HN23},Env,CEnv,IDTable,[],TS,TS1,NewHT,NewEnv,
             NewIDTable,Result,_).
otherwise.
hTUnify1Sub0_o(Res,_,_,_,_,Env,_,IDTable,TS,TS1,NewHT,NewEnv,NewIDTable,Result):- 
                  true |
      Result=Res,NewEnv=Env,NewIDTable=IDTable,TS=TS1,NewHT=[].

hTUnify1Sub_o([],[],_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- true |
      Result=success,NewHT=[],NewEnv=Env,TS=TS1,NewIDTable=IDTable,AddList=List.
hTUnify1Sub_o([],HTermL2,_,{HN13,_},Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- 
                integer(HN13) |
      predAdd(HTermL2,HN13,Env,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList).
hTUnify1Sub_o([HTL1|HTL1s],HTermL2,{Num1,{B,L1,ID}},{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,
             NewHT,NewEnv,NewIDTable,Result,AddList):- true |
      takeName(HTL1,HTermL2,L2Term,NHTermL2,Ans),
      predUnify2(Ans,HTL1,L2Term,{HN13,HN23},Env,CEnv,IDTable,List,TS,NHTPred,NEnv,NIDTable,
                TSs,Res,AddList1),
      hTUf1SubSub(Res,HTL1s,NHTermL2,{Num1,{B,L1,ID}},{HN13,HN23},NEnv,CEnv,NIDTable,
        AddList1,TSs,TS1,NHTs,NewEnv,NewIDTable,Result,AddList),
      NewHT=[NHTPred|NHTs].
otherwise.
hTUnify1Sub_o([],HTermL2,_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):-  true |
      termCheck(HTermL2,[],IDTable,NewList,NewIDTable,Result),
      NewEnv=Env,
      TS=TS1,
      NewHT=NewList,
      AddList=List.

