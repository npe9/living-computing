:- module cbr_unif.
:- public
     hTerm_Unify/10.
:- with_macro pimos.

hTerm_Unify({HNumber1},{HNumber2},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,Result):- 
                   integer(HNumber1),integer(HNumber2) |
      idCheck(HNumber1,HNumber2,IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{HNumber1,HNumber2},TS,[],
                NHTerm,NewEnv,NewIDTable,Result).
hTerm_Unify({H1,H2,H3},{HNumber2},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,Result):- 
                   integer(HNumber2) |
      idCheck({H1,H2,H3},HNumber2,IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{0,HNumber2},TS,[],NHTerm,NewEnv,
                NewIDTable,Result).
hTerm_Unify({HNumber1},{H21,H22,H23},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,Result):- 
                   integer(HNumber1) |
      idCheck(HNumber1,{H21,H22,H23},IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{HNumber1,0},TS,[],NHTerm,NewEnv,
                NewIDTable,Result).
hTerm_Unify({H11,H12,H13},{H21,H22,H23},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,
                Result):- true |
      idCheck({H11,H12,H13},{H21,H22,H23},IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{0,0},TS,[],NHTerm,NewEnv,
                NewIDTable,Result).

hTUnify0({HNumber1},{HNumber2},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,TSs,Result):- 
                   integer(HNumber1),integer(HNumber2) |
      idCheck(HNumber1,HNumber2,IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub_o(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{HNumber1,HNumber2},TS,TSs,
                NHTerm,NewEnv,NewIDTable,Result).
hTUnify0({H1,H2,H3},{HNumber2},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,TSs,Result):- 
                   integer(HNumber2) |
      idCheck({H1,H2,H3},HNumber2,IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub_o(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{0,HNumber2},TS,TSs,NHTerm,NewEnv,
                NewIDTable,Result).
hTUnify0({HNumber1},{H21,H22,H23},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,TSs,Result):- 
                   integer(HNumber1) |
      idCheck(HNumber1,{H21,H22,H23},IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub_o(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{HNumber1,0},TS,TSs,NHTerm,NewEnv,
                NewIDTable,Result).
hTUnify0({H11,H12,H13},{H21,H22,H23},Env,CEnv,IDTable,TS,NHTerm,NewEnv,NewIDTable,TSs,
        Result):- true |
      idCheck({H11,H12,H13},{H21,H22,H23},IDTable,Ans,NIDTable,HN1E,HN2E),
      hTUnifySub_o(Ans,HN1E,HN2E,Env,CEnv,NIDTable,{0,0},TS,TSs,NHTerm,NewEnv,
                NewIDTable,Result).

idCheck(N1,N2,IDTable,Ans,NIDTable,NewN1E,NewN2E):- 
                  integer(N1),integer(N2) |
      set_vector_element(IDTable,N1,N1E,N1E,N1DT1),
      integerCheck(N1E,N1DT1,NewN1E,NewN1DT1),
      set_vector_element(NewN1DT1,N2,N2E,N2E,NIDT2),
      integerCheck(N2E,NIDT2,NewN2E,NIDTable),
      idCheckSub(NewN1E,NewN2E,Ans).
idCheck(N1,N2,IDTable,Ans,NIDTable,NewN1E,N2E):- 
                  integer(N1),vector(N2) |
      set_vector_element(IDTable,N1,N1E,N1E,NIDT1),
      integerCheck(N1E,NIDT1,NewN1E,NIDTable),
      idCheckSub(NewN1E,N2,Ans),
      N2E=N2.
idCheck(N1,N2,IDTable,Ans,NIDTable,N1E,NewN2E):- 
                  vector(N1),integer(N2) |
      set_vector_element(IDTable,N2,N2E,N2E,NIDT2),
      integerCheck(N2E,NIDT2,NewN2E,NIDTable),
      idCheckSub(N1,NewN2E,Ans),
      N1E=N1.
idCheck(N1,N2,IDTable,Ans,NIDTable,NH1E,NH2E):-
                  vector(N1),vector(N2) |
      NH1E=N1,
      NH2E=N2,
      NIDTable=IDTable, 
      idCheckSub(N1,N2,Ans).

idCheckSub({_,_,N13},{_,_,N13},Ans):- integer(N13) | Ans =N13.
idCheckSub({_,_,_},{_,_,[]},Ans):- true | Ans = fail.
idCheckSub({_,_,@},{_,_,@},Ans):- true | Ans ='@'.
idCheckSub({_,_,N13},{_,_,@},Ans):- integer(N13)| Ans = N13.
idCheckSub({_,_,@},{_,_,N23},Ans):- integer(N23) | Ans = N23.
idCheckSub({_,_,[]},{_,_,_},Ans):- true | Ans = fail.
otherwise.
idCheckSub(_,_,Ans) :- true | Ans=fail.

integerCheck(Number,Table,NewNumber,NewTable):- integer(Number) |
      set_vector_element(Table,Number,N1,N1,Table0),
      integerCheck(N1,Table0,NewNumber,NewTable).
otherwise.
integerCheck(Number,Table,NewNumber,NewTable):- true |
      NewNumber=Number,NewTable=Table.


hTUnifySub(fail,_,_,Env,_,IDTable,_,TS,TS1,NHTerm,NewEnv,NewIDTable,Result):- 
                  true |
      Result=fail,NewEnv=Env,NewIDTable=IDTable,NHTerm=[],
      TS1 = TS.
otherwise.
hTUnifySub(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,Npair,TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):-
    property_or_event(HN11,TS,Env,TS0,R),
    hTUnifySubL0(R,N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,
       Npair,TS0,TS1,NHTerm, NewEnv,NewIDTable,Result).

hTUnifySubL0(event,N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,
       Npair,TS,TS1,NHTerm, NewEnv,NewIDTable,Result):-
        hTUnifySubL(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,
                       Npair,TS,TS1,NHTerm, NewEnv,NewIDTable,Result).
hTUnifySubL0(property,N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,
       Npair,TS,TS1,NHTerm, NewEnv,NewIDTable,Result):-
        hTUnifySubL_p(N,{HN11,HN12,HN13},{HN21,HN22,HN23},
                Env,CEnv,IDTable,
                       Npair,TS,TS1,NHTerm,NewEnv,NewIDTable,Result).

%%%%%%%%%%%%%% for top event
hTUnifySubL(_,_,_,Env,_,IDTable,{N1,N1},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N1),N1>0 |
      NewIDTable=IDTable,
      Result=success,
      TS=TS1,
      NewEnv=Env,
      NHTerm={N1}.
otherwise.
hTUnifySubL(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,NHTList,
                NewEnv,NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTUnifySubL(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- atom(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,NHTList,NewEnv,
                   NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTUnifySubL(Res,_,_,Env,_,IDTable,_,TS,TS1,NHTerm,NewEnv,NewIDTable,Result):- 
                  true |
%oosaki add 950807
      TS1 = TS,
      Result=Res,NewEnv=Env,NewIDTable=IDTable,NHTerm=[].

hTUnify1Sub0(success,NHT,HTL1,HTL2,{HN13,HN23},Env,CEnv,IDTable,TS,TS1,NewHT,NewEnv,
        NewIDTable, Result) :- true |
      hTUnify1Sub(HTL1,HTL2,NHT,{HN13,HN23},Env,CEnv,IDTable,[],TS,TS1,NewHT,NewEnv,
             NewIDTable,Result,_).
otherwise.
hTUnify1Sub0(Res,_,_,_,_,Env,_,IDTable,TS,TS1,NewHT,NewEnv,NewIDTable,Result):- 
                  true |
      Result=Res,NewEnv=Env,NewIDTable=IDTable,TS=TS1,NewHT=[].

hTUnify1Sub([],[],_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- true |
      Result=success,NewHT=[],NewEnv=Env,TS=TS1,NewIDTable=IDTable,AddList=List.
hTUnify1Sub([],HTermL2,_,{HN13,_},Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- 
                integer(HN13) |
      predAdd(HTermL2,HN13,Env,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList).
hTUnify1Sub([HTL1|HTL1s],HTermL2,{Num1,{B,L1,ID}},{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,
             NewHT,NewEnv,NewIDTable,Result,AddList):- true |
      takeName(HTL1,HTermL2,L2Term,NHTermL2,Ans),
      predUnify2(Ans,HTL1,L2Term,{HN13,HN23},Env,CEnv,IDTable,List,TS,NHTPred,NEnv,NIDTable,
                TSs,Res,AddList1),
      hTUf1SubSub(Res,HTL1s,NHTermL2,{Num1,{B,L1,ID}},{HN13,HN23},NEnv,CEnv,NIDTable,
        AddList1,TSs,TS1,NHTs,NewEnv,NewIDTable,Result,AddList),
      NewHT=[NHTPred|NHTs].
otherwise.
hTUnify1Sub([],HTermL2,_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):-  true |
      termCheck(HTermL2,[],IDTable,NewList,NewIDTable,Result),
      NewEnv=Env,
      TS=TS1,
      NewHT=NewList,
      AddList=List.

hTUf1SubSub(success,HTL1,NHTermL2,NHT,{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- true |
      hTUnify1Sub(HTL1,NHTermL2,NHT,{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,NewHT,
        NewEnv,NewIDTable,Result,AddList).
otherwise.
hTUf1SubSub(Res,_,_,_,_,NEnv,_,NID,List,TS,TS1,NHT,NewEnv,NewIDTable,
                   Result,AddList):- true |
            Result=Res,NewEnv=NEnv,TS=TS1,NewIDTable=NID,NHT=[],AddList=List.
%%%%%%%%%%%%%% for top property
hTUnifySubL_p(_,_,_,Env,_,IDTable,{N1,N1},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N1),N1>0 |
      NewIDTable=IDTable,
      Result=success,
      TS=TS1,
      NewEnv=Env,
      NHTerm={N1}.
otherwise.
hTUnifySubL_p(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- integer(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0_p(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,
                NHTList,NewEnv,NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTUnifySubL_p(N,{HN11,HN12,HN13},{HN21,HN22,HN23},Env,CEnv,IDTable,{N1,N2},TS,TS1,NHTerm,
          NewEnv,NewIDTable,Result):- atom(N) |
      nagCheck(HN11,HN21,Ans1,PTerm1,PTerm2,Nag),
      pTermUni(Ans1,PTerm1,PTerm2,Env,CEnv,TS,TS0,NPT,NEnv,Res1),
      newTermMake(Res1,N,Nag,NPT,{N1,N2},IDTable,NEnv,NHT,NIDTable,Res2),
      hTUnify1Sub0_p(Res2,NHT,HN12,HN22,{HN13,HN23},NEnv,CEnv,NIDTable,TS0,TS1,NHTList,NewEnv,
                   NIDTable1,Result),
      hTmake0(Res1,NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTUnifySubL_p(Res,_,_,Env,_,IDTable,_,TS,TS1,NHTerm,NewEnv,NewIDTable,Result):- 
                  true |
%oosaki add 950807
      TS1 = TS,
      Result=Res,NewEnv=Env,NewIDTable=IDTable,NHTerm=[].

hTUnify1Sub0_p(success,NHT,HTL1,HTL2,{HN13,HN23},Env,CEnv,IDTable,TS,TS1,NewHT,
        NewEnv,NewIDTable,Result) :- true |
      hTUnify1Sub_p(HTL1,HTL2,NHT,{HN13,HN23},Env,CEnv,IDTable,[],TS,TS1,NewHT,NewEnv,
             NewIDTable,Result,_).
otherwise.
hTUnify1Sub0_p(Res,_,_,_,_,Env,_,IDTable,TS,TS1,NewHT,NewEnv,NewIDTable,Result):- 
                  true |
      Result=Res,NewEnv=Env,NewIDTable=IDTable,TS=TS1,NewHT=[].

hTUnify1Sub_p([],[],_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- true |
      Result=success,NewHT=[],NewEnv=Env,TS=TS1,NewIDTable=IDTable,AddList=List.
hTUnify1Sub_p(HTermL2,[],_,{HN13,_},Env,_,IDTable,List,TS,TS1,
        NewHT,NewEnv,NewIDTable,Result,AddList):- 
                integer(HN13) |
      predAdd(HTermL2,HN13,Env,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList).
hTUnify1Sub_p(HTermL2,[HTL1|HTL1s],{Num1,{B,L1,ID}},{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,
             NewHT,NewEnv,NewIDTable,Result,AddList):- true |
      takeName(HTL1,HTermL2,L2Term,NHTermL2,Ans),
      predUnify2(Ans,L2Term,HTL1,{HN13,HN23},Env,CEnv,IDTable,List,TS,NHTPred,NEnv,NIDTable,
                TSs,Res,AddList1),
      hTUf1SubSub_p(Res,NHTermL2,HTL1s,{Num1,{B,L1,ID}},{HN13,HN23},NEnv,CEnv,
        NIDTable,AddList1,TSs,TS1,NHTs,NewEnv,NewIDTable,Result,AddList),
      NewHT=[NHTPred|NHTs].
otherwise.
hTUnify1Sub_p(HTermL2,[],_,_,Env,_,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):-  true |
      termCheck(HTermL2,[],IDTable,NewList,NewIDTable,Result),
      NewEnv=Env,
      TS=TS1,
      NewHT=NewList,
      AddList=List.

hTUf1SubSub_p(success,HTL1,NHTermL2,NHT,{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,NewHT,NewEnv,
            NewIDTable,Result,AddList):- true |
      hTUnify1Sub_p(HTL1,NHTermL2,NHT,{HN13,HN23},Env,CEnv,IDTable,List,TS,TS1,
        NewHT,NewEnv,NewIDTable,Result,AddList).
otherwise.
hTUf1SubSub_p(Res,_,_,_,_,NEnv,_,NID,List,TS,TS1,NHT,NewEnv,NewIDTable,
                   Result,AddList):- true |
            Result=Res,NewEnv=NEnv,TS=TS1,NewIDTable=NID,NHT=[],AddList=List.
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
nagCheck({A,H1},{A,H2},Ans,PTerm1,PTerm2,Nag):- true |
      Nag=A,Ans=success,PTerm1=H1,PTerm2=H2.
otherwise.
nagCheck({_,H1},{_,H2},Ans,PTerm1,PTerm2,Nag):- true |
      Ans=fail,Nag=0,PTerm1=H1,PTerm2=H2.


pTermUni(fail,_,_,Env,_,TS,TS1,NPT,NEnv,Result):- true |
      Result=fail,NEnv=Env,TS=TS1,NPT=[].
pTermUni(success,PTerm1,PTerm2,Env,CEnv,TS,TS1,NPT,NEnv,Result):- true |

%%oosaki modify &add 960408
%H-Table ni pterm(X,Y) ga haixtutekitatokinoshori
%      predUnify1(PTerm1,PTerm2,TS,Env,CEnv,TS1,NPT,NEnv,Result).

      get_purePTerm(PTerm1,PTerm10),
      get_purePTerm(PTerm2,PTerm20),
      predUnify1(PTerm10,PTerm20,TS,Env,CEnv,TS1,NPT,NEnv,Result).

newTermMake(success,N,Nag,NPT,{N1,N2},IDTable,_,NHT,NIDTable,Result):-
                   true |
      idTableChange({N1,N2},IDTable,Number,NIDTable,Result),
      NHT={Number,{{Nag,NPT},_,N}}.

otherwise.
newTermMake(Res,_,_,_,_,IDTable,_,NHT,NIDTable,Result):- true |
      Result=Res,NIDTable=IDTable,NHT=[].

idTableChange({0,N2},IDTable,Number,NIDTable,Result):- N2 > 0 |
      Number=N2,NIDTable=IDTable,Result=success.
idTableChange({0,0},IDTable,Number,NIDTable,Result):- true |
      Number=0,NIDTable=IDTable,Result=success.
idTableChange({N1,0},IDTable,Number,NIDTable,Result):- N1 > 0 |
      Number=N1,NIDTable=IDTable,Result=success.
idTableChange({N1,N2},IDTable,Number,NIDTable,Result):- N1 > 0 ,N2 > 0 |
      smallCheck(N1,N2,Number0,Number),
      set_vector_element(IDTable,Number0,_,Number,NIDTable),
      Result=success.

smallCheck(N1,N2,Number,SmallN):- N1 > N2 |
                  Number=N1,SmallN=N2.
smallCheck(N1,N2,Number,SmallN):- N1 < N2 |
                  Number=N2,SmallN=N1.

hTmake0(success,NHT,NIDTable1,NHTList,NHTerm,NewIDTable):- 
              true  |
   hTmake(NHT,NIDTable1,NHTList,NHTerm,NewIDTable).
otherwise.
hTmake0(_,NHT,NIDTable1,NHTList,NHTerm,NewIDTable):-
              true  |
       NHTList=[],NHTerm=NHT,NewIDTable=NIDTable1.

hTmake({N,Term},IDTable,NHTList,NHTerm,NewIDTable):- N=0 |
      set_vector_element(Term,1,_,NHTList,NHTerm),
      NewIDTable=IDTable.
hTmake({N,Term},IDTable,NHTList,NHTerm,NewIDTable):- N>0 |
      set_vector_element(Term,1,_,NHTList,NTerm),
      set_vector_element(IDTable,N,N1,N1,NewIDT),
      idTableCheck(N1,N,NewIDT,NTerm,NHTerm,NewIDTable).

idTableCheck(N1,_,IDTable,NTerm,NHTerm,NewIDTable):- integer(N1) |
      set_vector_element(IDTable,N1,N1E,N1E,NIDT),
      idTableCheck(N1E,N1,NIDT,NTerm,NHTerm,NewIDTable).
otherwise.
idTableCheck(_,N,IDTable,NTerm,NHTerm,NewIDTable):- true |
      set_vector_element(IDTable,N,_,NTerm,NewIDTable),
      NHTerm={N}.

termCheck([],List,IDTable,NewList,NewIDTable,Result):- true |
            NewList=List,NewIDTable=IDTable,Result=success.
termCheck([HTL1|HTLs],List,IDTable,NewList,NewIDTable,Result):- 
                       true |
      append(List,[HTL1],NList),
      termCheck(HTLs,NList,IDTable,NewList,NewIDTable,Result).

predAdd([TermL1|TLs],TermScolemID,Env,IDTable,List,TS,TS1,NewHT,
        NewEnv,NewIDTable,Result,AddList):- true |
      predAdd1(TermL1,TermScolemID,Env,IDTable,List,TS,TS2,NewHT1,
                Env1,IDTable1,Res,List2),
      predAddSub(Res,TLs,TermScolemID,Env1,IDTable1,List2,TS2,TS1,
                NewHT2,NewEnv,NewIDTable,Result,AddList),
      NewHT=[NewHT1|NewHT2].
predAdd([],_,Env,IDTable,List,TS,TS1,NewHT,NewEnv,NewIDTable,
        Result,AddList):- true |
      TS=TS1,
      NewHT=[],
      Env=NewEnv,
      NewIDTable=IDTable,
      Result=success,
      AddList=List.

predAddSub(success,TL,TermScolemID,Env,IDTable,List,TS,TS1,
        NewHT,NewEnv,NewIDTable,Result,AddList):- true |
      predAdd(TL,TermScolemID,Env,IDTable,List,TS,TS1,NewHT,
             NewEnv,NewIDTable,Result,AddList).
predAddSub(fail,_,_,Env,IDTable,List,TS,TS1,NewHT,
        NewEnv,NewIDTable,Result,AddList):- true |
      Result=fail,
      AddList=List,
      Env=NewEnv,
      IDTable=NewIDTable,
      NewHT=[],
      TS=TS1.

%predAdd1(HTL1,TermScolemID,Env,IDTable,List,TS,TS1,NewHT,
%        NewEnv,NewIDTable,Result,AddList):- 
%                vector_element(HTL1,1,TermL1),
%                integer(TermL1),TermL1 > 0 |
%      set_vector_element(Env,TermL1,TermL1E,TermL1E,Env1),
%      set_vector_element(HTL1,1,_,TermL1E,NHTL1),
%      predAdd1(NHTL1,TermScolemID,Env1,IDTable,List,
%               TS,TS1,NewHT,NewEnv,NewIDTable,Result,AddList).
%predAdd1(HTL1,TermScolemID,Env,IDTable,List,TS,TS1,NewHT,
%        NewEnv,NewIDTable,Result,AddList):- 
%                vector_element(HTL1,1,0) |
%
%%oosaki modify
%%      set_vector_element(HTL1,0,KName,KName,HTL2),
%%      somenumbermake(KName,TermScolemID,[],NHT),
%%      set_vector_element(HTL2,1,_,NHT,NewHT),
%
%      vector_element(HTL1,0,KName,HTL2),                 %modify set_ve -> vec
%      vector_element(HTL2,2,Tr,_),                         %add
