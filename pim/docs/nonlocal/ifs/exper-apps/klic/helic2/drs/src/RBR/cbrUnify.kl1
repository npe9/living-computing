%predAddC1(fail,KName,NHT,NewHT,Result):- true |
%      Result=fail,NewHT=[].

takeName(HTL1,[],L2Term,NHTermL2,Ans):- true | 
           Ans=no,L2Term=HTL1,NHTermL2=[].
takeName(HTL1,[HTL2|HTermL2s],L2Term,NHTermL2,Ans):-
                        vector_element(HTL1,0,A),
                        vector_element(HTL2,0,A)|
           Ans=yes,NHTermL2=HTermL2s,L2Term=HTL2.
otherwise.
takeName(HTL1,[HTL2|HTermL2],L2Term,NHTermL2,Ans):- true |
     NHTermL2=[HTL2|NHTL2s],
     takeName(HTL1,HTermL2,L2Term,NHTL2s,Ans).

predUnify2(yes,HTL1,HTL2,_,Env,CEnv,IDTable,List,TS,NHTPred,NEnv,NIDTable,TSs,
               Result,AddList):- true |
     AddList=List,

%oosaki modify
%     set_vector_element(HTL1,1,Term,Term,NHTL1),
%     set_vector_element(HTL2,1,L2Term,L2Term,NHTL2),
%     predUnify3(Term,L2Term,Env,IDTable,TS,NHT,NEnv,NIDTable,TSs,Result),
