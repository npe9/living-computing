%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
subs_cov(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Nx,X,_X1) }},
	vector_element(X,0,Nx,_X1),
%	{{ cover#read(from,From,Y,Y1) }},
	vector_element(Y,0,From,Y1),
%	{{ number#read(value,FromN,From,_From1) }},
	vector_element(From,0,FromN,_From1),
%	{{ cover#read(to,To,Y1,_Y2) }},
	vector_element(Y1,1,To,_Y2),
%	{{ number#read(value,ToN,To,_To1) }},
	vector_element(To,0,ToN,_To1),
	(FromN =< Nx,Nx =< ToN ->
%	        Result = normal(ty#yes)
	        Result = normal(success)
	;otherwise;true ->
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
subs_cov(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	{{ cover#read(from,Xf,X,X1) }},
	vector_element(X,0,Xf,X1),
%	{{ number#read(value,XfN,Xf,_Xf1) }},
	vector_element(Xf,0,XfN,_Xf1),
%	{{ cover#read(from,Yf,Y,Y1) }},
	vector_element(Y,0,Yf,Y1),
%	{{ number#read(value,YfN,Yf,_Yf1) }},
	vector_element(Yf,0,YfN,_Yf1),
%	{{ cover#read(to,Xt,X1,_X2) }},
	vector_element(X1,1,Xt,_X2),
%	{{ number#read(value,XtN,Xt,_Xt1) }},
	vector_element(Xt,0,XtN,_Xt1),
%	{{ cover#read(to,Yt,Y1,_Y2) }},
	vector_element(Y1,1,Yt,_Y2),
%	{{ number#read(value,YtN,Yt,_Yt1) }},
	vector_element(Yt,0,YtN,_Yt1),
	(YfN =< XfN, XtN =< YtN ->
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
    atom(X)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
subs_cov(X,_Y,TypeDB,NewTypeDB,Result):-
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


