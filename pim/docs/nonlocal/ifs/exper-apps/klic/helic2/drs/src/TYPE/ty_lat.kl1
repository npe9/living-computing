    Info = {type,illegal_type_name,[X]}.




subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
    atom(X)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = subsume_general(Y,X,TypeDB,NewTypeDB,Result),
%	{{ subsume_general(Y,X,TypeDB,NewTypeDB,Result) }}.
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
subs_bltstr(X,_Y,TypeDB,NewTypeDB,Result):-
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,Result),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,Result).
subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#string,X,TypeDB,NewTypeDB,Result),
%	bsubsume(ty#string,X,TypeDB,NewTypeDB,Result).
subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,Result),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,Result).
otherwise.
subs_general(X,Y,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = subsume_general(Y,X,TypeDB,NewTypeDB,Result),
	subsume_general(Y,X,TypeDB,NewTypeDB,Result).
otherwise.
subs_general(X,_Y,TypeDB,NewTypeDB,Result):-
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


% Result : normal(ty#yes|ty#no) | abnormal(Info)
%        Info : illegal_type_name
subsume_general(X,Y,TypeDB,NewTypeDB,Result):-
    name_to_lower_code(X,CodeX,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        name_to_position(Y,PosY,TypeDB1,NewTypeDB,R2),
%        (R2 = normal(ty#yes) ->
        (R2 = normal(success) ->
	    string(CodeX,SizeX,_,CodeX1),
	    (PosY < SizeX ->
	        check_bit(CodeX1,PosY,_,Result)
	    ;otherwise;true ->
%	        Result = normal(ty#no)
	        Result = normal(fail)
	    )
	;otherwise;true ->
	    Result = R2
	)
    ;otherwise;true ->
        NewTypeDB = TypeDB1,
        Result = R1
    ).


% Result : normal(ty#yes|ty#no)
check_bit(String,Position,NewString,Result):-
    string_element(String,Position,E,NewString),
%    (E = bit#on ->
    (E = 1 ->
%        Result = normal(ty#yes)
        Result = normal(success)
    ;otherwise;true ->
%        Result = normal(ty#no)
        Result = normal(fail)
    ).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% upper_bound(X,^UB,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X : string
% UB : list of string
% Result : normal(ty#yes) | abnormal(Info)
%          Info = illegal_type_name(Name)

upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
%	UB = [ty#top],
	UB = ['&top'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	ub(X,UB,TypeDB,NewTypeDB,Result).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	UB = [ty#integer],
	UB = ['&integer'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	UB = [ty#string],
	UB = ['&string'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	UB = [ty#integer],
	UB = ['&integer'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	UB = [ty#top],
	UB = ['&top'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	UB = [ty#top],
	UB = ['&top'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
    atom(X)|
	ub(X,UB,TypeDB,NewTypeDB,Result).
otherwise.
upper_bound(X,UB,TypeDB,NewTypeDB,Result):-
    UB = [],
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
ub(X,UB,TypeDB,NewTypeDB,Result):-
    name_to_upper_code(X,CodeX,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%	debug#info(debug_tag#lat,&debug,Info),
%        Info = upper_element_names(CodeX,UB,TypeDB1,NewTypeDB),
        upper_element_names(CodeX,UB,TypeDB1,NewTypeDB)
    ;otherwise;true ->
        UB = [],
        NewTypeDB = TypeDB1
    ),
    Result = R1.

upper_element_names(Code,NameList,TypeDB,NewTypeDB):-
    string(Code,Size,_,Code1),
    ub_names(Size,Code1,_,NameList,TypeDB,NewTypeDB).

ub_names(N,Code,NewCode,NameList,TypeDB,NewTypeDB):- N>0|
    M := N-1,
    check_bit(Code,M,Code1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        % 上界テーブル中のコードは先行の0を消したものが入っ
        % ている。コード中のあるビット位置に対応するポジショ
        % ンを求めるには、そのコードの先行の0の数分を足さな
        % ければならない。先行0の数は全体の要素数からそのコー
        % ドの長さを引くことで求められる。
%        typeDB#read(dbsize,Size,TypeDB,TypeDB1),
        vector_element(TypeDB,0,Size,TypeDB1),
        string(Code1,CodeLength,_,Code2),
        Pos := Size - CodeLength + M,
%        typeDB#get(nameTBL,NameTBL,NewNameTBL,TypeDB1,TypeDB2),
        set_vector_element(TypeDB1,2,NameTBL,NewNameTBL,TypeDB2),
        vector_element(NameTBL,Pos,Name,NewNameTBL),
        NameList = [Name|NewNameList],
        ub_names(M,Code2,NewCode,NewNameList,TypeDB2,NewTypeDB)
    ;otherwise;true ->
        ub_names(M,Code1,NewCode,NameList,TypeDB,NewTypeDB)
    ).
ub_names(N,Code,NewCode,NameList,TypeDB,NewTypeDB):- N=<0|
    NewTypeDB = TypeDB,
    NewCode = Code,
    NameList = [].

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% immediate_upper_bound
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X : string
% IUB : list of string
% Result : normal(ty#yes) | abnormal(Info)
%          Info : illegal_type_name(Name)

immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	IUB = [],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	iub(X,IUB,TypeDB,NewTypeDB,Result).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	IUB = [ty#integer],
	IUB = ['&integer'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	IUB = [ty#string],
	IUB = ['&string'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	IUB = [ty#integer],
	IUB = ['&integer'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	IUB = [ty#top],
	IUB = ['&top'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	IUB = [ty#top],
	IUB = ['&top'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
    atom(X)|
	iub(X,IUB,TypeDB,NewTypeDB,Result).
otherwise.
immediate_upper_bound(X,IUB,TypeDB,NewTypeDB,Result):-
    IUB = [],
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
iub(X,IUB,TypeDB,NewTypeDB,Result):-
    upper_mask_code(X,Mask,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        string(Mask,Size,_,NewMask),
%	{{ typeDB#read(dbsize,DBSize,TypeDB1,TypeDB2) }},
	vector_element(TypeDB1,0,DBSize,TypeDB2),
        Offset := DBSize-Size,
%	debug#info(debug_tag#lat,&debug,Info),
%        Info = least_among_ub(Size,Offset,NewMask,IUB,TypeDB2,NewTypeDB),
        least_among_ub(Size,Offset,NewMask,IUB,TypeDB2,NewTypeDB)
    ;otherwise;true ->
        IUB = [],
        NewTypeDB = TypeDB1
    ),
    Result = R1.

upper_mask_code(X,MaskCode,TypeDB,NewTypeDB,Result):-
    name_to_upper_code(X,Code,TypeDB,NewTypeDB,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%        set_string_element(Code,0,bit#off,MaskCode)
        set_string_element(Code,0,0,MaskCode)
    ;otherwise;true ->
%        MaskCode = ty#void
        MaskCode = '&void'
    ),
    Result = R1.

%上界のうちで最も小さいものを求める。
% 0 番目はもとのコードのビットなので調べない
least_among_ub(N,Offset,Mask,IUBL,TypeDB,NewTypeDB):-N>1|
    M := N-1,
    check_least_if_on(M,Offset,Mask,NewMask,IUBL,IUBL1,TypeDB,TypeDB1),
    least_among_ub(M,Offset,NewMask,IUBL1,TypeDB1,NewTypeDB).
least_among_ub(N,_Offset,_Mask,IUBL,TypeDB,NewTypeDB):-N=<1|
    IUBL = [],
    NewTypeDB = TypeDB.

check_least_if_on(M,Offset,Mask,NewMask,IUBL,NewIUBL,TypeDB,NewTypeDB):-
%    string_element(Mask,M,bit#on)|
    string_element(Mask,M,1)|
	string(Mask,Size,_,Mask1),
%	new_string(WorkMask,Size,1),
	new_string(WorkMask,Size,8),
%	builtin#or_string_elements(WorkMask,0,Size,Mask1,0,
%				   WorkMask1,NewMask),
	ty_osif:or_string_elements(WorkMask,0,Size,Mask1,0,
				   WorkMask1,NewMask),
%	set_string_element(WorkMask1,M,bit#off,WorkMask2),
	set_string_element(WorkMask1,M,0,WorkMask2),
%	typeDB#get(lowerTBL,LowerTBL,NewLowerTBL,TypeDB,TypeDB1),
	set_vector_element(TypeDB,3,LowerTBL,NewLowerTBL,TypeDB1),
	% 上界コードはコード長とテーブル内のポジションは反比例するので
	% Offset でポジションを補正する
	vector_element(LowerTBL,~(M+Offset),Code,NewLowerTBL),
	check_and_all_zero(Code,WorkMask2,TypeDB1,TypeDB2,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
	    lower_code_to_name(Code,Name,TypeDB2,NewTypeDB),
	    IUBL = [Name|NewIUBL]
%	;R1 = normal(ty#no) ->
	;R1 = normal(fail) ->
	    NewIUBL = IUBL,
	    NewTypeDB = TypeDB2
	).
check_least_if_on(M,_Offset,Mask,NewMask,IUBL,NIUBL,TypeDB,NewTypeDB):-
%    string_element(Mask,M,bit#off)|
    string_element(Mask,M,0)|
	NewTypeDB = TypeDB,
	NewMask = Mask,
	NIUBL = IUBL.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% lower_bound(X,^LB,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X : string
% LB : list of string
% Result : normal(ty#yes) | abnormal(illegal_type_name)

lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	lb(X,LB,TypeDB,NewTypeDB,Result).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
%	LB = [ty#bottom],
	LB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	LB = [ty#bottom],
	LB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	LB = [ty#bottom],
	LB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	LB = [ty#bottom],
	LB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X= '&integer'|
	lb(X,LB,TypeDB,NewTypeDB,Result).
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	lb(X,LB,TypeDB,NewTypeDB,Result).
otherwise.
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
    atom(X)|
	lb(X,LB,TypeDB,NewTypeDB,Result).
otherwise.
lower_bound(X,LB,TypeDB,NewTypeDB,Result):-
    LB = [],
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
lb(X,LB,TypeDB,NewTypeDB,Result):-
    name_to_lower_code(X,CodeX,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%	debug#info(debug_tag#lat,&debug,Info),
%        Info = lower_element_names(CodeX,LB,TypeDB1,NewTypeDB),
        lower_element_names(CodeX,LB,TypeDB1,NewTypeDB)
    ;otherwise;true ->
        LB = [],
        NewTypeDB = TypeDB1
    ),
    Result = R1.

lower_element_names(Code,NameList,TypeDB,NewTypeDB):-
    string(Code,Size,_,Code1),
    lb_names(Size,Code1,_,NameList,TypeDB,NewTypeDB).

lb_names(N,Code,NewCode,NameList,TypeDB,NewTypeDB):- N>0|
    M := N-1,
    check_bit(Code,M,Code1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%        typeDB#get(nameTBL,NameTBL,NewNameTBL,TypeDB,TypeDB1),
        set_vector_element(TypeDB,2,NameTBL,NewNameTBL,TypeDB1),
        vector_element(NameTBL,M,Name,NewNameTBL),
        NameList = [Name|NewNameList],
        lb_names(M,Code1,NewCode,NewNameList,TypeDB1,NewTypeDB)
    ;otherwise;true ->
        lb_names(M,Code1,NewCode,NameList,TypeDB,NewTypeDB)
    ).
lb_names(N,Code,NewCode,NameList,TypeDB,NewTypeDB):- N=<0|
    NewCode = Code,
    NameList = [],
    NewTypeDB = TypeDB.


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% immediate_lower_bound(X,^ILB,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X : string
% ILB : list of string
% Result : normal(ty#yes) | abnormal(illegal_type_name)

immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	ilb(X,ILB,TypeDB,NewTypeDB,Result).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	ILB = [],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	ILB = [ty#bottom],
	ILB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	ILB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	ILB = [ty#bottom],
	ILB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	ILB = [ty#bottom],
	ILB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	ilb(X,ILB,TypeDB,NewTypeDB,Result).
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	ILB = [ty#bottom],
	ILB = ['&bottom'],
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	ilb(X,ILB,TypeDB,NewTypeDB,Result).
otherwise.
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
    atom(X)|
	ilb(X,ILB,TypeDB,NewTypeDB,Result).
otherwise.
immediate_lower_bound(X,ILB,TypeDB,NewTypeDB,Result):-
    ILB = [],
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
ilb(X,ILB,TypeDB,NewTypeDB,Result):-
    lower_mask_code(X,Mask,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        string(Mask,Size,_,NewMask),
%	debug#info(debug_tag#lat,&debug,Info),
%        Info = greatest_among_lb(Size,NewMask,ILB,TypeDB1,NewTypeDB),
        greatest_among_lb(Size,NewMask,ILB,TypeDB1,NewTypeDB)
    ;otherwise;true ->
        ILB = [],
        NewTypeDB = TypeDB1
    ),
    Result = R1.

% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
lower_mask_code(X,MaskCode,TypeDB,NewTypeDB,Result):-
    name_to_lower_code(X,Code,TypeDB,NewTypeDB,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        string(Code,Size,_,NewCode),
%        builtin#substring(NewCode,0,~(Size-1),MaskCode,_)
        ty_osif:substring(NewCode,0,~(Size-1),MaskCode,_)
    ;otherwise;true ->
%        MaskCode = ty#void
        MaskCode = '&void'
    ),
    Result = R1.

%下界のうちで最も大きいものを求める。
greatest_among_lb(N,Mask,ILBL,TypeDB,NewTypeDB):-N>0|
    M := N-1,
    check_greatest_if_on(M,Mask,NewMask,ILBL,ILBL1,TypeDB,TypeDB1),
    greatest_among_lb(M,NewMask,ILBL1,TypeDB1,NewTypeDB).
greatest_among_lb(N,_Mask,ILBL,TypeDB,NewTypeDB):-N=<0|
    ILBL = [],
    NewTypeDB = TypeDB.


check_greatest_if_on(M,Mask,NewMask,ILBL,NewILBL,TypeDB,NewTypeDB):-
%    string_element(Mask,M,bit#on)|
    string_element(Mask,M,1)|
	string(Mask,Size,_,Mask1),
%	new_string(WorkMask,Size,1),
	new_string(WorkMask,Size,8),
%	builtin#or_string_elements(WorkMask,0,Size,Mask1,0,
%				   WorkMask1,NewMask),
	ty_osif:or_string_elements(WorkMask,0,Size,Mask1,0,
				   WorkMask1,NewMask),
%	set_string_element(WorkMask1,M,bit#off,WorkMask2),
	set_string_element(WorkMask1,M,0,WorkMask2),
	set_vector_element(TypeDB,4,UpperTBL,NewUpperTBL,TypeDB1),
	vector_element(UpperTBL,M,Code,NewUpperTBL),
	check_and_all_zero(WorkMask2,Code,TypeDB1,TypeDB2,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
	    upper_code_to_name(Code,Name,TypeDB2,NewTypeDB),
	    ILBL = [Name|NewILBL]
%	;R1 = normal(ty#no) ->
	;R1 = normal(fail) ->
	    NewILBL = ILBL,
	    NewTypeDB = TypeDB2
	).
check_greatest_if_on(M,Mask,NewMask,ILBL,NILBL,TypeDB,NewTypeDB):-
%    string_element(Mask,M,bit#off)|
    string_element(Mask,M,0)|
	NewMask = Mask,
	NILBL = ILBL,
	NewTypeDB = TypeDB.


check_and_all_zero(LowerCode,UpperCode,TypeDB,NewTypeDB,Result):-
    string(LowerCode,LSize,_,LowerCode1),
    string(UpperCode,USize,_,UpperCode1),
    Lpos := LSize - 1,
%    typeDB#read(dbsize,DBSize,TypeDB,NewTypeDB),
    vector_element(TypeDB,0,DBSize,NewTypeDB),
    Upos := DBSize - USize,
    (Lpos < Upos ->
%        Result = normal(ty#yes)
        Result = normal(success)
    ;Lpos >= Upos ->
%        builtin#and_string_elements(LowerCode1,Upos,~(Lpos-Upos+1),
%                                    UpperCode1,0,
%                                    LowerCode2,_UpperCode2),
        ty_osif:and_string_elements(LowerCode1,Upos,~(Lpos-Upos+1),
                                    UpperCode1,0,
                                    LowerCode2,_UpperCode2),
%        search_character(LowerCode2,Upos,Lpos,bit#on,Pos,_LowerCode3),
        ty_osif:search_character(LowerCode2,Upos,Lpos,1,Pos,_LowerCode3),
        (Pos < 0 ->
%            Result = normal(ty#yes)
            Result = normal(success)
        ;Pos >= 0 ->
%            Result = normal(ty#no)
            Result = normal(fail)
        )
    ).
