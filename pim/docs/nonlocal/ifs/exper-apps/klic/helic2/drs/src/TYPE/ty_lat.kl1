:- module ty_lat.
:- with_macro pimos.


% meet,join,subsume,
% upper_bound,immediate_upper_bound,
% lower_bound,immediate_lower_bound

%:-include("debug.h").

%:-if_not_equal(debug,no).
%:-local_implicit debug:oldnew.
%:-end_if.

%:-if_equal(debug,no).
:-public meet/6,join/6,bsubsume/5.
:-public upper_bound/5,immediate_upper_bound/5,lower_bound/5,immediate_lower_bound/5.
%:-else.
%:-public meet/8,join/8,bsubsume/7.
%:-public upper_bound/7,immediate_upper_bound/7,lower_bound/7,immediate_lower_bound/7.
%:-end_if.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S meet(X,Y,Z)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++

% Result : normal(ty#yes|ty#no) | abnormal(Info)
%        Info : illegal_type_name
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	meet_num(Y,X,Z,TypeDB,NewTypeDB,Result).
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	meet_str(Y,X,Z,TypeDB,NewTypeDB,Result).
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	meet_cov(Y,X,Z,TypeDB,NewTypeDB,Result).
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	meet_int(Y,X,Z,TypeDB,NewTypeDB,Result).
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	meet_bltstr(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
meet(X,Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
	meet_gen(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
meet(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes|ty#no) | abnormal(Info)
%        Info : illegal_type_name
meet_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Nx,X, X1) }},
	vector_element(X,0,Nx, X1),
%	{{ number#read(value,Ny,Y,_Y1) }},
	vector_element(Y,0,Ny,_Y1),
	(Nx=:=Ny ->
	    Z = X1,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;Nx=\=Ny ->
%	    Z = ty#bottom,
	    Z = '&bottom',
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
meet_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Ny,Y,Y1) }},
	vector_element(Y,0,Ny,Y1),
%	{{ cover#read(from,From,X,X1) }},
	vector_element(X,0,From,X1),
%	{{ number#read(value,FromN,From,_From1) }},
	vector_element(From,0,FromN,_From1),
%	{{ cover#read(to,To,X1,_X2) }},
	vector_element(X1,1,To,_X2),
%	{{ number#read(value,ToN,To,_To1) }},
	vector_element(To,0,ToN,_To1),
	(FromN =< Ny,Ny =< ToN ->
	    Z = Y1,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#bottom,
	    Z = '&bottom',
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
meet_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = Y,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
meet_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes|ty#no) | abnormal(Info)
%        Info : illegal_type_name
meet_str(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_str(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
	(X = Y ->
	    Z = X,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#bottom,
	    Z = '&bottom',
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
meet_str(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#string,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#string,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = Y,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes|ty#no) | abnormal(Info)
%        Info : illegal_type_name
meet_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Nx,X,X1) }},
	vector_element(X,0,Nx,X1),
%	{{ cover#read(from,From,Y,Y1) }},
	vector_element(Y,0,From,Y1),
%	{{ number#read(value,FromN,From,_From1) }},
	vector_element(From,0,FromN,_From1),
%	{{ cover#read(to,To,Y1,_Y2) }},
	vector_element(Y1,1,To,_Y2),
%	{{ number#read(value,ToN,To,_To1) }},
	vector_element(To,0,ToN,_To1),
	(FromN =< Nx,Nx =< ToN ->
	    Z = X1,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#bottom,
	    Z = '&bottom',
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
meet_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	{{ cover#read(from,Xf,X,X1) }},
	vector_element(X,0,Xf,X1),
%	{{ number#read(value,XfN,Xf,_Xf1) }},
	vector_element(Xf,0,XfN,_Xf1),
%	{{ cover#read(from,Yf,Y,Y1) }},
	vector_element(Y,0,Yf,Y1),
%	{{ number#read(value,YfN,Yf,_Yf1) }},
	vector_element(Yf,0,YfN,_Yf1),
%	{{ cover#read(to,Xt,X1,X2) }},
	vector_element(X1,1,Xt,X2),
%	{{ number#read(value,XtN,Xt,_Xt1) }},
	vector_element(Xt,0,XtN,_Xt1),
%	{{ cover#read(to,Yt,Y1,_Y2) }},
	vector_element(Y1,1,Yt,_Y2),
%	{{ number#read(value,YtN,Yt,_Yt1) }},
	vector_element(Yt,0,YtN,_Yt1),
%	ty#greater(XfN,YfN,ZfN),
	(XfN<YfN->ZfN=YfN;otherwise;true->ZfN=XfN),
%	ty#smaller(XtN,YtN,ZtN),
	(XtN<YtN->ZtN=XtN;otherwise;true->ZtN=YtN),
	(ZfN =:= ZtN ->
%	    {{ number#new(Z0) }},
	    new_vector(Z0,1),
%	    {{ number#set(value,ZfN,Z0,Z) }},
	    set_vector_element(Z0,0,_,ZfN,Z),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;ZfN < ZtN ->
%	    {{ cover#get(from,Zf,NewZf,X2,X3) }},
	    set_vector_element(X2,0,Zf,NewZf,X3),
%	    {{ number#set(value,ZfN,Zf,NewZf) }},
	    set_vector_element(Zf,0,_,ZfN,NewZf),
%	    {{ cover#get(to,Zt,NewZt,X3,Z) }},
	    set_vector_element(X3,1,Zt,NewZt,Z),
%	    {{ number#set(value,ZtN,Zt,NewZt) }},
	    set_vector_element(Zt,0,_,ZtN,NewZt),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;ZfN > ZtN ->
%	    Z = ty#bottom,
	    Z = '&bottom',
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
meet_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Z = ty#bottom,
	Z = '&bottom',
%	Result = normal(ty#no).
	Result = normal(fail).
meet_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = Y,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
otherwise.
meet_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



