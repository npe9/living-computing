    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Nx,X,_X1) }},
	vector_element(X,0,Nx,_X1),
%	{{ cover#read(from,From,Y,Y1) }},
	vector_element(Y,0,From,Y1),
%	{{ number#read(value,FromN,From,_From1) }},
	vector_element(From,0,FromN,_From1),
%	{{ cover#read(to,To,Y1,Y2) }},
	vector_element(Y1,1,To,Y2),
%	{{ number#read(value,ToN,To,_To1) }},
	vector_element(To,0,ToN,_To1),
	(FromN =< Nx,Nx =< ToN ->
	    Z = Y2,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#top,
	    Z = '&top',
%	    Result = normal(ty#yes)
	    Result = normal(success)
	).
join_cov(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	{{ cover#read(from,Xf,X,X1) }},
	vector_element(X,0,Xf,X1),
%	{{ number#read(value,XfN,Xf,_Xf1) }},
	vector_element(Xf,0,XfN,_Xf1),
%	{{ cover#read(from,Yf,Y,Y1) }},
	vector_element(Y,0,Yf,Y1),
%	{{ number#read(value,YfN,Yf,_Yf1) }},
	vector_element(Yf,0,YfN,_Yf1),
%	{{ cover#read(to,Xt,X1,X2) }},
	vector_element(X1,1,Xt,X2),
%	{{ number#read(value,XtN,Xt,_Xt1) }},
	vector_element(Xt,0,XtN,_Xt1),
%	{{ cover#read(to,Yt,Y1,_Y2) }},
	vector_element(Y1,1,Yt,_Y2),
%	{{ number#read(value,YtN,Yt,_Yt1) }},
	vector_element(Yt,0,YtN,_Yt1),
	(YfN =< XtN, XfN =< YtN ->
%	    ty#smaller(XfN,YfN,ZfN),
	    (XfN<YfN->ZfN=XfN;otherwise;true->ZfN=YfN),
%	    ty#greater(XtN,YtN,ZtN),
	    (XtN<YtN->ZtN=YtN;otherwise;true->ZtN=XtN),
%	    {{ cover#get(from,Zf,NewZf,X2,X3) }},
	    set_vector_element(X2,0,Zf,NewZf,X3),
%	    {{ number#set(value,ZfN,Zf,NewZf) }},
	    set_vector_element(Zf,0,_,ZfN,NewZf),
%	    {{ cover#get(to,Zt,NewZt,X3,Z) }},
	    set_vector_element(X3,1,Zt,NewZt,Z),
%	    {{ number#set(value,ZtN,Zt,NewZt) }},
	    set_vector_element(Zt,0,_,ZtN,NewZt),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#integer,
	    Z = '&integer',
%	    Result = normal(ty#yes)
	    Result = normal(success)
	).
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = X,
%	    Result = normal(ty#yes)
%	;R1 = normal(ty#no) ->
%	    Z = ty#top,
%	    Result = R1
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
otherwise.
join_cov(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.

%---------------------------------------------------------------------
% L
