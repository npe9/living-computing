meet_gen(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
meet_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
meet_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
%	Z = ty#bottom,
	Z = '&bottom',
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
meet_gen(X,Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = meet_general(Y,X,Z,TypeDB,NewTypeDB,Result),
	meet_general(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
meet_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
meet_general(X,Y,Z,TypeDB,NewTypeDB,Result):-
    name_to_lower_code(X,CodeX,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        name_to_lower_code(Y,CodeY,TypeDB1,TypeDB2,R2),
%        (R2 = normal(ty#yes) ->
        (R2 = normal(success) ->
	    and_lower_code(CodeX,CodeY,AndCode),
	    lower_code_to_name(AndCode,Z,TypeDB2,NewTypeDB),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#void,
	    Z = '&void',
	    NewTypeDB = TypeDB2,
	    Result = R2
	)
    ;otherwise;true ->
%        Z = ty#void,
        Z = '&void',
        NewTypeDB = TypeDB1,
        Result = R1
    ).


:-public name_to_lower_code/5.
%---------------------------------------------------------------------
% L name_to_lower_code(Name,Code,TypeDB,NewTypeDB,Result)
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
name_to_lower_code(Name,Code,TypeDB,NewTypeDB,Result):-
    name_to_position(Name,Pos,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%        typeDB#get(lowerTBL,LowerTBL,NewLowerTBL,TypeDB1,NewTypeDB),
        set_vector_element(TypeDB1,3,LowerTBL,NewLowerTBL,NewTypeDB),
        vector_element(LowerTBL,Pos,Code,NewLowerTBL)
    ;otherwise;true ->
%        Code = ty#void,
        Code = '&void',
        NewTypeDB = TypeDB1
    ),
    Result = R1.

:- public name_to_position/5.
%---------------------------------------------------------------------
% L name_to_position(Name,Pos)
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(illegal_type_name(Name))
name_to_position(Name,Pos,TypeDB,NewTypeDB,Result):-
%    typeDB#get(posTBL,PosTBL,NewPosTBL,TypeDB,NewTypeDB),
    set_vector_element(TypeDB,1,PosTBL,NewPosTBL,NewTypeDB),
    ty_osif:get_with(Name,Pos,PosTBL,NewPosTBL),
%    (Pos = ty#void ->
    (Pos = '&void' ->
        Result = abnormal(Info),
%        Info = {ty#typemid,illegal_type_name,[Name]}
        Info = {type,illegal_type_name,[Name]}
    ;otherwise;true ->
%        Result = normal(ty#yes)
        Result = normal(success)
    ).


:- public lower_code_to_name/4.
%---------------------------------------------------------------------
% L lower_code_to_name(Code,Name,TypeDB,NewTypeDB)
%---------------------------------------------------------------------
lower_code_to_name(Code,Name,TypeDB,NewTypeDB):-
    lower_code_to_position(Code,Pos),
%    typeDB#get(nameTBL,NameTBL,NewNameTBL,TypeDB,NewTypeDB),
    set_vector_element(TypeDB,2,NameTBL,NewNameTBL,NewTypeDB),
    vector_element(NameTBL,Pos,Name,NewNameTBL).

:-public lower_code_to_position/2.
%---------------------------------------------------------------------
% L lower_code_to_position(Code,Position)
%---------------------------------------------------------------------
lower_code_to_position(Code,Position):-
    string(Code,Size,_,_),
    Position := Size - 1.


:-public and_lower_code/3.
%---------------------------------------------------------------------
% L and_lower_code(X,Y,Z)
%---------------------------------------------------------------------
and_lower_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx<Ly|
    % YのLx分の長さ部分とXのandをとり、結果のうち後ろから
    % さがして最初に1が見つかったところまでを捨てたものを返す。
    % (tailing 0 を捨てる) コードの有効な長さはuniqueであり、それを
    % 利用してテーブル中のポジションの計算をするため。
%    builtin#and_string_elements(X,0,Lx,Y,0,And,_NY),
    ty_osif:and_string_elements(X,0,Lx,Y,0,And,_NY),
%    search_character(And,~(Lx-1),0,bit#on,Pos,NewAnd),
    ty_osif:search_character(And,~(Lx-1),0,1,Pos,NewAnd),
%    builtin#substring(NewAnd,0,~(Pos+1),Z,_).
    ty_osif:substring(NewAnd,0,~(Pos+1),Z,_).
and_lower_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx>Ly|
%    builtin#and_string_elements(Y,0,Ly,X,0,And,_NX),
    ty_osif:and_string_elements(Y,0,Ly,X,0,And,_NX),
%    search_character(And,~(Ly-1),0,bit#on,Pos,NewAnd),
    ty_osif:search_character(And,~(Ly-1),0,1,Pos,NewAnd),
%    builtin#substring(NewAnd,0,~(Pos+1),Z,_).
    ty_osif:substring(NewAnd,0,~(Pos+1),Z,_).
and_lower_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx=Ly|
%    builtin#and_string_elements(X,0,Lx,Y,0,And,_NY),
    ty_osif:and_string_elements(X,0,Lx,Y,0,And,_NY),
%    search_character(And,~(Lx-1),0,bit#on,Pos,NewAnd),
    ty_osif:search_character(And,~(Lx-1),0,1,Pos,NewAnd),
%    builtin#substring(NewAnd,0,~(Pos+1),Z,_).
    ty_osif:substring(NewAnd,0,~(Pos+1),Z,_).


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% join
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X,Y,Z : string
% Result : normal(ty#yes) | abnormal(illegal_type_name(Name)


join(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	join_num(Y,X,Z,TypeDB,NewTypeDB,Result).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	join_str(Y,X,Z,TypeDB,NewTypeDB,Result).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	join_cov(Y,X,Z,TypeDB,NewTypeDB,Result).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	join_int(Y,X,Z,TypeDB,NewTypeDB,Result).
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	join_bltstr(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
join(X,Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
	join_gen(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
join(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
	(X = Y ->
	    Z = X
	;otherwise;true ->
%	    Z = ty#integer
	    Z = '&integer'
	),
%	Result = normal(ty#yes).
	Result = normal(success).
join_num(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	{{ number#read(value,Ny,Y,_Y1) }},
	vector_element(Y,0,Ny,_Y1),
%	{{ cover#read(from,From,X,X1) }},
	vector_element(X,0,From,X1),
%	{{ number#read(value,FromN,From,_From1) }},
	vector_element(From,0,FromN,_From1),
%	{{ cover#read(to,To,X1,X2) }},
	vector_element(X1,1,To,X2),
%	{{ number#read(value,ToN,To,_To1) }},
	vector_element(To,0,ToN,_To1),
	(FromN =< Ny, Ny =< ToN ->
	    Z = X2,
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#integer,
	    Z = '&integer',
%	    Result = normal(ty#yes)
	    Result = normal(success)
	).
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = X,
%	    Result = normal(ty#yes)
%	;R1 = normal(ty#no) ->
%	    Z = ty#top,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
join_num(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_str(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
