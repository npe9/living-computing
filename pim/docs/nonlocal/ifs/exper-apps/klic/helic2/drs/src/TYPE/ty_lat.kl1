    X = '&integer'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
subs_num(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#no).
	Result = normal(fail).
otherwise.
subs_num(X,_Y,TypeDB,NewTypeDB,Result):-
