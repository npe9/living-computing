    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_int(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
