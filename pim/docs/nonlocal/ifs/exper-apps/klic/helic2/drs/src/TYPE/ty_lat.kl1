%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
	Z = Y,
%	Result = normal(ty#yes).
	Result = normal(success).
join_int(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
	Z = Y,
%	Result = normal(ty#yes).
	Result = normal(success).
