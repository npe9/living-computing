    atom(X)|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#integer,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = ty#top,
%	    Result = normal(ty#yes)
%	;R1 = normal(ty#no) ->
%	    Z = ty#top,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#bottom,
%	    Result = R1
%	).
otherwise.
join_int(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.

%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
	Z = Y,
%	Result = normal(ty#yes).
	Result = normal(success).
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
%	debug#info(debug_tag#lat,&debug,Info),
%	Info = bsubsume(ty#string,X,TypeDB,NewTypeDB,R1),
%	bsubsume(ty#string,X,TypeDB,NewTypeDB,R1),
%	(R1 = normal(ty#yes) ->
%	    Z = Y,
%	    Result = normal(ty#yes)
%	;R1 = normal(ty#no) ->
%	    Z = ty#top,
%	    Result = normal(ty#yes)
%	;otherwise;true ->
%	    Z = ty#void,
%	    Result = R1
%	).
otherwise.
join_bltstr(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



%---------------------------------------------------------------------
% L
%---------------------------------------------------------------------
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	Z = X,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	Z = Y,
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	NewTypeDB = TypeDB,
%	Z = ty#top,
	Z = '&top',
%	Result = normal(ty#yes).
	Result = normal(success).
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
%	Z = ty#top,
	Z = '&top',
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
join_gen(X,Y,Z,TypeDB,NewTypeDB,Result):-
    atom(X)|
	join_general(Y,X,Z,TypeDB,NewTypeDB,Result).
otherwise.
join_gen(X,_Y,Z,TypeDB,NewTypeDB,Result):-
%    Z = ty#void,
    Z = '&void',
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.



% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
join_general(X,Y,Z,TypeDB,NewTypeDB,Result):-
    name_to_upper_code(X,CodeX,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        name_to_upper_code(Y,CodeY,TypeDB1,TypeDB2,R2),
%        (R2 = normal(ty#yes) ->
        (R2 = normal(success) ->
	    and_upper_code(CodeX,CodeY,AndCode),
	    upper_code_to_name(AndCode,Z,TypeDB2,NewTypeDB),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Z = ty#void,
	    Z = '&void',
	    NewTypeDB = TypeDB2,
	    Result = R2
	)
    ;otherwise;true ->
%        Z = ty#void,
        Z = '&void',
        NewTypeDB = TypeDB1,
        Result = R1
    ).


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_type_name
name_to_upper_code(Name,Code,TypeDB,NewTypeDB,Result):-
    name_to_position(Name,Pos,TypeDB,TypeDB1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
%        typeDB#get(upperTBL,UpperTBL,NewUpperTBL,TypeDB1,NewTypeDB),
        set_vector_element(TypeDB1,4,UpperTBL,NewUpperTBL,NewTypeDB),
        vector_element(UpperTBL,Pos,Code,NewUpperTBL)
    ;otherwise;true ->
%        Code = ty#void,
        Code = '&void',
        NewTypeDB = TypeDB1
    ),
    Result = R1.

and_upper_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx<Ly|
    % Yの後ろからLx分の長さ部分とXのandをとり、結果のうち前から
    % さがして最初に1が見つかったところまでを捨てたものを返す。
    % (heading 0 を捨てる) コードの有効な長さはuniqueであり、それを
    % 利用してテーブル中のポジションの計算をするため。
%    builtin#and_string_elements(X,0,Lx,Y,~(Ly-Lx),And,_NY),
    ty_osif:and_string_elements(X,0,Lx,Y,~(Ly-Lx),And,_NY),
%    search_character(And,0,~(Lx-1),bit#on,Pos,NewAnd),
    ty_osif:search_character(And,0,~(Lx-1),1,Pos,NewAnd),
%    builtin#string_tail(NewAnd,Pos,Z).
    ty_osif:string_tail(NewAnd,Pos,Z).
and_upper_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx>Ly|
%    builtin#and_string_elements(Y,0,Ly,X,~(Lx-Ly),And,_NX),
    ty_osif:and_string_elements(Y,0,Ly,X,~(Lx-Ly),And,_NX),
%    search_character(And,0,~(Ly-1),bit#on,Pos,NewAnd),
    ty_osif:search_character(And,0,~(Ly-1),1,Pos,NewAnd),
%    builtin#string_tail(NewAnd,Pos,Z).
    ty_osif:string_tail(NewAnd,Pos,Z).
and_upper_code(X,Y,Z):-string(X,Lx,_),string(Y,Ly,_),Lx=Ly|
%    builtin#and_string_elements(X,0,Lx,Y,0,And,_NY),
    ty_osif:and_string_elements(X,0,Lx,Y,0,And,_NY),
%    search_character(And,0,~(Lx-1),bit#on,Pos,NewAnd),
    ty_osif:search_character(And,0,~(Lx-1),1,Pos,NewAnd),
%    builtin#string_tail(NewAnd,Pos,Z).
    ty_osif:string_tail(NewAnd,Pos,Z).

%---------------------------------------------------------------------
% L upper_code_to_name(Code,Name,TypeDB,NewTypeDB)
%---------------------------------------------------------------------
upper_code_to_name(Code,Name,TypeDB,NewTypeDB):-
    upper_code_to_position(Code,Pos,TypeDB,TypeDB1),
%    typeDB#get(nameTBL,NameTBL,NewNameTBL,TypeDB1,NewTypeDB),
    set_vector_element(TypeDB1,2,NameTBL,NewNameTBL,NewTypeDB),
    vector_element(NameTBL,Pos,Name,NewNameTBL).

%---------------------------------------------------------------------
% L upper_code_to_position(Code,Position)
%---------------------------------------------------------------------
upper_code_to_position(Code,Position,TypeDB,NewTypeDB):-
%    typeDB#read(dbsize,Size,TypeDB,NewTypeDB),
    vector_element(TypeDB,0,Size,NewTypeDB),
    string(Code,CodeLength,_,_),
    Position := Size - CodeLength.



%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% subsume(X,Y,^Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% X,Y : string
% Result : normal(ty#yes|ty#no) | abnormal(Info)
%          Info : illegal_type_name(Name)
bsubsume(X,_Y,TypeDB,NewTypeDB,Result):-
%    ty#is_top(X)|
    X = '&top'|
	NewTypeDB = TypeDB,
%	Result = normal(ty#yes).
	Result = normal(success).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_bottom(X)|
    X = '&bottom'|
	NewTypeDB = TypeDB,
%	(ty#is_bottom(Y) ->
	(Y = '&bottom' ->
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    Result = normal(ty#no)
	    Result = normal(fail)
	).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_number(X)|
    vector(X,1)|
	subs_num(Y,X,TypeDB,NewTypeDB,Result).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_string(X)|
    string(X,_,_)|
	subs_str(Y,X,TypeDB,NewTypeDB,Result).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#is_cover(X)|
    vector(X,2)|
	subs_cov(Y,X,TypeDB,NewTypeDB,Result).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_integer(X)|
    X = '&integer'|
	subs_bltint(Y,X,TypeDB,NewTypeDB,Result).
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
%    ty#blt_string(X)|
    X = '&string'|
	subs_bltstr(Y,X,TypeDB,NewTypeDB,Result).
otherwise.
bsubsume(X,Y,TypeDB,NewTypeDB,Result):-
    atom(X)|
	subs_general(Y,X,TypeDB,NewTypeDB,Result).
otherwise.
bsubsume(X,_Y,TypeDB,NewTypeDB,Result):-
    NewTypeDB = TypeDB,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_type_name,[X]}.
    Info = {type,illegal_type_name,[X]}.


