:- module dbtgui_guiCurrentState.

:- public 
    create/2.
            
:- with_macro pimos.


%create
    create(NH,I):-true| 
        loop(I,NH,{{0,0,0,0},nil,       nil,         0        ,[]},
                  {{0,0,0,0},nil,       nil,         0        ,[]}).

%        loop(I,NH,{{0,0,0,0},nil,       nil,         nil        ,[]},
%                  {{0,0,0,0},nil,       nil,         nil        ,[]}).
              % loadFlag   GoalList   DispGoalList CurrentGoal   CurrentUnit

%loop
    loop([],NH,_,_):-true|
        NH=[].
    loop([make_nh(NH1)|T],NH,PCS,DCS):-true|
        merge({NH1,NH2},NH),
        loop(T,NH2,PCS,DCS).
    loop([set(p,ElementName,E)|T],NH,CS1,DCS):-true|
        get_elementPos(ElementName,ElementPos),
        set_vector_element(CS1,ElementPos,_,E,CS),
        loop(T,NH,CS,DCS).
    loop([set(d,ElementName,E)|T],NH,PCS,CS1):-true|
        get_elementPos(ElementName,ElementPos),
        set_vector_element(CS1,ElementPos,_,E,CS),
        loop(T,NH,PCS,CS).
    loop([get(p,ElementName,E)|T],NH,CS,DCS):-true|
        get_elementPos(ElementName,ElementPos),
        vector_element(CS,ElementPos,E,_),
        loop(T,NH,CS,DCS).
    loop([get(d,ElementName,E)|T],NH,PCS,CS):-true|
        get_elementPos(ElementName,ElementPos),
        vector_element(CS,ElementPos,E,_),
        loop(T,NH,PCS,CS).

              % loadFlag   goalList   dispGoalList currnetGoal 
%get_elementPos
    get_elementPos(loadFlag,Pos):-true|
        Pos = 0.
    get_elementPos(goalList,Pos):-true|
        Pos = 1.
    get_elementPos(dispGoalList,Pos):-true|
        Pos = 2.
    get_elementPos(currentGoal ,Pos):-true|
        Pos = 3.
    get_elementPos(currentUnit ,Pos):-true|
        Pos = 4.