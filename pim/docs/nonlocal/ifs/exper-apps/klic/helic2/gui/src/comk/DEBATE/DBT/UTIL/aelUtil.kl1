:- module dbtgui_argumentElementListUtility.

:- public 
    get_argumentElementList/5.

:- with_macro pimos.

%get_argumentElementList
    get_argumentElementList(SV,APos,Data1,Data,AEL):-true|
        get_initTabPos(InitTabPos),
        get_argumentElementList1([APos],InitTabPos,APos,SV,Data1,Data,AEL).

    get_argumentElementList1([],_,_,_,Data1,Data,AEL):-true|
        Data   = Data1,
        AEL     = [].
    get_argumentElementList1([Pos|T],Tab,StartPos,SV,Data1,Data,AEL):-integer(Pos)|
        get_line(Pos,Tab,StartPos,SV,Data1,Data2,AE),
        (   wait(AE)->
                get_tabLength(TabLength),
                NextTab := Tab+TabLength,
                dbt_svUtility:get_solution(SV,Pos,childList,ChildList),
                get_argumentElementList1(ChildList,NextTab,StartPos,SV,Data2,Data3,AEL1),
                (   wait(AEL1)->
                        get_argumentElementList1(T,Tab,StartPos,SV,Data3,Data,AEL2),
                        append([AE|AEL1],AEL2,AEL))).
    get_argumentElementList1([naf(Pos)|T],Tab,StartPos,SV,Data1,Data,AEL):-integer(Pos)|
        get_line(naf(Pos),Tab,StartPos,SV,Data1,Data2,AE),
        (   wait(AE)->
                get_argumentElementList1(T,Tab,StartPos,SV,Data2,Data,AEL1),
                AEL = [AE|AEL1]).

    get_line(Pos,Tab,StartPos,SV,Data1,Data,AE):-integer(Pos)|
        get_ruleName(SV,Pos,RuleName),
        get_similarity(SV,Pos,Sim),
	get_plpt(Data1,PL,PT),
        dbt_issueUtility:make_consequence(SV,Pos,PL,PT,Consequence1),
        (   wait(Consequence1)->
                get_attackInfo(SV,StartPos,Pos,Data1,Data,AttackInfo),
                make_attackInfoString(AttackInfo,AttackInfoString),
                get_line1(Tab,AttackInfoString,RuleName,Consequence1,AE,Sim)).

    get_line(naf(Pos),Tab,StartPos,SV,Data1,Data,AE):-true|
        get_ruleName(SV,naf(Pos),RuleName),
        get_similarity(SV,naf(Pos),Sim),
	get_plpt(Data1,PL,PT),
        dbt_issueUtility:make_consequence(SV,naf(Pos),PL,PT,Consequence1),
        (   wait(Consequence1)->
                get_attackInfo(SV,StartPos,naf(Pos),Data1,Data,AttackInfo),
                make_attackInfoString(AttackInfo,AttackInfoString),
                get_line1(Tab,AttackInfoString,RuleName,Consequence1,AE,Sim)).

%get_ruleName
    get_ruleName(_,naf(_),RuleName):-true|
        RuleName = "".
    get_ruleName(SV,Pos,RuleName):-integer(Pos)|
        dbt_svUtility:get_solution(SV,Pos,ruleName,RuleName1),
        hLibrary:tTos(RuleName1,RuleName).


%get_similarity
    get_similarity(_,naf(_),Sim):-true|
        Sim = "".
    get_similarity(SV,Pos,Sim):-integer(Pos)|
        dbt_svUtility:get_solution(SV,Pos,similarity,Sim1),
        ( Sim1 = nil->
                Sim = ""
        ;
        otherwise;
          true->
                hLibrary:tTos(Sim1,Sim)
        ).

%get_plpt
    get_plpt({_,{_,_,_,{_,PT1,OP}}},PL,PT):-true|
	vector_element(OP,0,PL,_),
	PT = PT1.

%%%%%get_attackInfo

    get_attackInfo(SV,StartPos,Pos,{Pool1,Info},Data,AttackInfo):-true|
        Pool1 = [make(mat,MAT)|Pool],
        dbt_issueUtility:is_issue(SV,Pos,MAT,[],YN),
        (   YN = yes->
                get_attackInfo1(SV,StartPos,Pos,{Pool,Info},Data,AttackInfo)
        ;
            YN = no->
                Data       = {Pool,Info},
                AttackInfo = {IssueJudge,NumOfAttack,NumOfArgued,NumOfFinishArg},
                IssueJudge = nil,NumOfAttack=nil,NumOfArgued=nil,NumOfFinishArg=nil
        ).

    get_attackInfo1(SV,StartPos,Pos,{Pool1,Info1},Data,AttackInfo):-true|
        dbt_issueUtility:get_numOfCounterArgument(SV,Pos,NumOfAttack),
        dbt_issueUtility:get_topRuleRel(SV,Pos,Info1,Info,TopRuleRel),
        Pool1 = [send(at, refer_ID({SV,StartPos},ID,YN1))|Pool2],
        (   YN1 = no->
                AttackInfo = {TopRuleRel,NumOfAttack,0,nil},
                Pool = Pool2
        ;
            YN1 = yes->
                Pool2 = [
                            send(ct,get_numOfClaim({ID,Pos},NumOfArgued)),
                            send(ct,get_claimJudge({ID,Pos},ClaimJudge))|Pool],
                change_claimJudge(ClaimJudge,NumOfFinishArg),
                AttackInfo = {TopRuleRel,NumOfAttack,NumOfArgued,NumOfFinishArg}
        ),
        Data = {Pool,Info}.

    change_claimJudge(cancel,T):-true|
        T = "C".
    change_claimJudge(finish,T):-true|
        T = "F".
    change_claimJudge(claim,T):-true|
        T = "A".
    change_claimJudge(nil,T):-true|
        T = nil.

    make_attackInfoString({nil,nil,nil,nil},AttackInfoString):-true|
        AttackInfoString  = "          ".
otherwise.
    make_attackInfoString({TopRuleRel,NumOfAttack,NumOfArgued,NumOfFinishArg},AttackInfoString):-true|
        make_topRuleRelString(TopRuleRel,S0),
        iTos(NumOfAttack,S1),
        iTos(NumOfArgued,S2),
        (   NumOfFinishArg = nil->
                append_string:append_string(["  ",S0,"  ",S1,"(",S2,") "],AttackInfoString)
        ;
            NumOfFinishArg \= nil->
                append_string:append_string(["  ",S0,"  ",S1,"(",S2,NumOfFinishArg,")"],AttackInfoString)
        ).

    make_topRuleRelString(j,S):-true|
        S = ">".
    make_topRuleRelString(p,S):-true|
        S = "!".
    make_topRuleRelString(d,S):-true|
        S = "<".

    iTos(Num,S):-true|
        hLibrary:tTos(Num,S).

    get_line1(Tab,AttackInfoString,RuleName,Consequence,AE,""):-wait(AttackInfoString)|
        make_tab(Tab,TabString),
        append_string:append_string([AttackInfoString,"  ",TabString,RuleName,":",
		Consequence],AE).
otherwise.
    get_line1(Tab,AttackInfoString,RuleName,Consequence,AE,Sim):-wait(AttackInfoString)|
        make_tab(Tab,TabString),
        append_string:append_string([AttackInfoString,"  ",TabString,RuleName,":",
		Consequence],AE).

%%%%check arg ni bug ari,check_arg shitatokini Sim no keisan ga hen
%        append_string:append_string([AttackInfoString,"  ",TabString,RuleName,":",
%		Sim,":",Consequence],AE).

    make_tab(Length,String):-true|
        string("",_,Type,_),
        new_string(S,Length,Type),
        set_space(S,0,Length,String).

    set_space(S,L,L,String):-true|
        String = S.
otherwise.
    set_space(S,P,L,String):-true|
        set_string_element(S,P,#" ",S1),
        P1 := P+1,
        set_space(S1,P1,L,String).



%%%
%get_initTabPos
    get_initTabPos(InitTabPos):-true|
        InitTabPos = 0.

%get_tabLength
    get_tabLength(TabLength):-true|
        TabLength = 1.

%%%%%%%%utility
    append([],Y,Z):-true|
        Z = Y.
    append([X1|X],Y,Z):-true|
        append(X,Y,Z1),
        Z = [X1|Z1].

