%% receive show argument

cmdShowArg(Argument,Agent,String):- true |
        new_string(ST0,2,8),
        set_string_element(ST0,1,10#"232",ST2),
        convert:charpchange(Agent,AString),
        listReShow(Argument,1,[],ArguString),
        append_string:append_string([ST2,AString,ArguString],String).


%%

listReShow([L1|Ls],N,_,String):- N=1 |
        listReAr1(L1,ArgSt1),
        N1 := N+1,
        listReShow(Ls,N1,ArgSt1,String).
listReShow([L1|Ls],N,St,String):- N=2 |
        listReAr2(L1,ArgSt2),
        N1 := N+1,
        append_string:append_string([St,ArgSt2],NArgSt),
        listReShow(Ls,N1,NArgSt,String).
listReShow([L1|Ls],N,St,String):- N=3 |
	new_string(ST0,3,8),
	set_string_element(ST0,0,16#"3",ST1),
	listReAr3(L1,ST1,ArgSt3),
        N1 := N+1,
        append_string:append_string([St,ArgSt3],NArgSt),
        listReShow(Ls,N1,NArgSt,String).
listReShow([L1|Ls],N,St,String):- N=4 |
        listReAr4(L1,1,[],ArgSt4),
        N1 := N+1,
        append_string:append_string([St,ArgSt4],NArgSt),
        listReShow(Ls,N1,NArgSt,String).
listReShow([L1|Ls],N,St,String):- N=5 |
        listReAr5(L1,ArgSt5),
        N1 := N+1,
        append_string:append_string([St,ArgSt5],NArgSt),
        listReShow(Ls,N1,NArgSt,String).
listReShow([L1|Ls],N,St,String):- N=6 |
        listReAr6(L1,ArgSt6),
        N1 := N+1,
        append_string:append_string([St,ArgSt6],NArgSt),
        listReShow(Ls,N1,NArgSt,String).
listReShow([],_N,St,String):- true |
        String = St.


%%  load type;command;rule;view;query


cmdLoadSend(Agent,[{A,B,C,D}],SendString):- true |
        new_string(ST0,2,8),
        set_string_element(ST0,1,10#"45",ST1),
        convert:charpchange(Agent,AString),
        new_string(NST0,2,8),
        set_string_element(NST0,0,16#"1",NST1),
        flagstringmake({A,B,C,D},_N,NST1,NST2),
        append_string:append_string([ST1,AString,NST2],SendString).


flagstringmake(Vector,_N,String,NewString):- true |
        flagToNumber(Vector,Number),
        set_string_element(String,1,Number,NewString).

flagToNumber({A,B,C,D},Number):- true |
        Number := A+ B*2 + C*4 + D*8.
        


        
append([],L2,List):- true |
        List = L2.
append([H|T],L,AL):- true |
        AL = [H|NAL],
        append(T,L,NAL).



kakkocut(LS,NLS):- true |
        string(LS,Size,BitSize,_NewLS),
        NSize := Size - 2,
        new_string(LS2,NSize,BitSize),
        kakkocut2(LS,NSize,0,0,LS2,NLS).

kakkocut2(LS,NSize,N,M,String,NLS):- N=0 |
        N1:= N+1,
        kakkocut2(LS,NSize,N1,M,String,NLS).
otherwise.
kakkocut2(LS,NSize,N,M,String,NLS):- M < NSize|
        string_element(LS,N,NEle,LSS),
%       N2:= N - 1,
        N1:= N + 1,
        M1 := M+1,
        set_string_element(String,M,NEle,NString),
        kakkocut2(LSS,NSize,N1,M1,NString,NLS).
kakkocut2(_LS,NSize,_N,M,String,NLS):- M = NSize |
        NLS = String,
        io:outstream([print(NLS),nl]).


%  ["string1","string2",… ]  wo encode ni henkan
stringLReList([L1|Ls],String):- true |
        stLReList2([L1|Ls],[],String).

stLReList2([L1|Ls],List,String):- true |
        convert:stringchange(L1,L1St),
        append(List,[L1St],NList),
        stLReList2(Ls,NList,String).
stLReList2([],List,String):- true |
        convert:listchange(List,String).

