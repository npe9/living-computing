:- module dbtgui_set.

:- public 
    solver/5,
    goal/5,
    standpointList/5,
    unitList/5,
    depth/5,
    explanationMode/5.
            
:- with_macro pimos. 

%solver
    solver(AgentName,Solver,{DBT1,CGS},Data,GUIProtocol):-true|
        dbtgui_protocolPool:get(AgentName,set,solver,Solver,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        make_protocol(Result,ok,AgentName,[],GUIProtocol),
        Data = {DBT,CGS}.

%goal
    goal(AgentName,Pos,{DBT1,CGS1},Data,GUIProtocol):-true|
        CGS1 = [get(AgentName,goalList,GoalList)|CGS2],
        (   GoalList \= nil->
                get_element(GoalList,0,Pos,Goal,YN1),
                (   YN1 = yes->
                        dbtgui_protocolPool:get(AgentName,set,goal,Goal,ProtocolList),
                        send(ProtocolList,DBT1,DBT,Result),
                        (   Result = normal(_)->
                                CGS2 = [set(AgentName,currentGoal,Pos)|CGS]
                        ;
                            Result = abnormal(_)->
                                CGS  = CGS2
                        ),
                        make_protocol(Result,ok,AgentName,[],GUIProtocol),
                        Data = {DBT,CGS}
                ;
                    YN1 = no->
                        make_protocol(abnormal({gui,'Illegal goal number',Pos}),_,AgentName,_,GUIProtocol),
                        Data = {DBT1,CGS2}
                )
        ;
            GoalList = nil->
                make_protocol(abnormal({gui,'Goal file not read',nil}),_,AgentName,_,GUIProtocol),
                Data = {DBT1,CGS2}
        ).

%standpointList
    standpointList(AgentName,SPList1,{DBT1,CGS},Data,GUIProtocol):-true|
        reverse(SPList1,[],SPList),
        dbtgui_protocolPool:get(AgentName,set,defaultUseView,SPList,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        make_protocol(Result,ok,AgentName,[],GUIProtocol),
        Data = {DBT,CGS}.

%unitList
    unitList(AgentName,[],Data1,Data,GUIProtocol):-true|
        Data = Data1,
        dbtgui_utility:make_errorProtocol(AgentName,{gui,'Unit list is empty',nil},GUIProtocol).
    unitList(AgentName,UnitList,{DBT1,CGS1},Data,GUIProtocol):-UnitList\=[]|
        dbtgui_protocolPool:get(AgentName,set,useUnit,UnitList,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        (   Result = normal(_)->
                CGS1 = [set(AgentName,currentUnit,UnitList)|CGS]
        ;
            Result = abnormal(_)->
                CGS  = CGS1
        ),
        make_protocol(Result,ok,AgentName,[],GUIProtocol),
        Data = {DBT,CGS}.

%depth
    depth(AgentName,Depth1,{DBT1,CGS},Data,GUIProtocol):-integer(Depth1)|
	(   Depth1 = -1 ->
		Depth = infinite
	;
	otherwise;
	    true ->
		Depth = Depth1
	),
	builtin:print("%%%%%%%%%%%SET DEPTH %%%%%%%%%%%"),
	builtin:print(Depth),
	builtin:print("%%%%%%%%%%%SET DEPTH %%%%%%%%%%%"),
        dbtgui_protocolPool:get(AgentName,set,depth,Depth,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        make_protocol(Result,ok,AgentName,[],GUIProtocol),
        Data = {DBT,CGS}.
otherwise.
    depth(AgentName,Depth,Data1,Data,GUIProtocol):-true|
	Data   = Data1,
	Reason = {gui,'Illegal integer',Depth},
        dbtgui_utility:make_errorProtocol(AgentName,Reason,GUIProtocol).

%explantionMode
    explanationMode(AgentName,h,{DBT1,CGS},Data,GUIProtocol):-true|
        dbtgui_protocolPool:get(AgentName,set,explantionMode,h,ProtocolList),
        send(ProtocolList,DBT1,DBT,Result),
        make_protocol(Result,ok,AgentName,[],GUIProtocol),
        Data = {DBT,CGS}.
    explanationMode(AgentName,e,Data1,Data,GUIProtocol):-true|
        dbtgui_utility:make_errorProtocol(AgentName,{gui,'Non support',nil},GUIProtocol),
        Data = Data1.

%send
    send(Protocol,DBT1,DBT,Result):-true|
        DBT1 = [Protocol|DBT],
        is_normal(Protocol,Result).

%%is_normal
    is_normal({_,ProtocolList},Result):-true |
        is_normal1(ProtocolList,Result).

    is_normal1([],Result):-true|
        Result = normal(success).
    is_normal1([set_parameter(_,_,normal(success))|T],Result):-true|
        is_normal1(T,Result).
    is_normal1([set_parameter(_,_,abnormal(Reason))|_],Result):-true|
        Result = abnormal(Reason).

%make_protocol
    make_protocol(abnormal(Reason),_,AgentName,_,GUIProtocol):-true|
        dbtgui_utility:make_errorProtocol(AgentName,Reason,GUIProtocol).
    make_protocol(normal(success),ProtocolName,AgentName,Arguments,GUIProtocol):-true|
        GUIProtocol = receive(AgentName,ProtocolName,Arguments,_R).

%%%%%%%%%%%%%list utility

%get_element
    get_element([],_,_,_,YN):-true|
        YN = no.
    get_element([E1|_],L,L,E,YN):-true|
        E  = E1,
        YN = yes.
otherwise.
    get_element([_|T],W,L,E,YN):-true|
        W1 := W +1,
        get_element(T,W1,L,E,YN).

%reverse
    reverse([],W,L):-true|
        L = W.
    reverse([H|T],W,L):-true|
        reverse(T,[H|W],L).

