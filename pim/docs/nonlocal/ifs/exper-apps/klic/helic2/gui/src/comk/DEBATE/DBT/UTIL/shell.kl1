:- module dbtgui_shell.

:- public 
    get_commandArguments/4.
            
:- with_macro pimos.

%get_commandArguments
    get_commandArguments({Pool,Info,CSS1},Retern,CPA,R):-true|
        CSS1 = [get(displayArgInfo,DisplayArgInfo)|CSS],
        get_commandArguments({Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

    get_commandArguments({Pool1,Info,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Pool1 = [make(nh,NH)|Pool],
        NH = [get_commandArguments(Command,Parameter,Arguments,R1)],
        Data = {Pool,Info,DisplayArgInfo,CSS},
        (   R1 = normal(_) ->
                get_commandArguments1(Command,Parameter,Arguments,Data,Retern,CPA,R)
        ;
            R1 = abnormal(_)->
                R = R1
        ).

%pose claim
        %'pose' ga kitatokino {{SV,APos},nil} ha kanarazu 
        %'pose claim'dearu. mata  {SV,APos}ha kanarazu initial Arg de aru
    get_commandArguments1(pose,nil,[],            
                {Pool,Info,{nil,{SV,APos}},CSS},Retern,CPA,R):-true|
        CSS     = [],
        Retern  = {Pool,Info},
        CPA     = {pose,claim,[{SV,APos}]},
        R       = normal(success).

%pose counter
        %'pose' ga kitatokino FLArg:{SV,APos} CLArg:{{SV,APos},IPos,CPos}} ha kanarazu 
        %'pose counter 'dearu. mata  {SV,IPos,CPos}ha kanarazu counter 
    get_commandArguments1(pose,nil,[],
                {Pool,Info,{{SV,APos},{{SV,APos},IPos,CPos}},CSS},Retern,CPA,R):-true|
        CSS     = [],
        Retern  = {Pool,Info},
        CPA     = {pose,counter,[{SV,IPos,CPos}]},
        R       = normal(success).

%send reasonList
    get_commandArguments1(send,reasonList,[],
                {Pool1,Info1,DisplayArgInfo,CSS1},Retern,CPA,R):-true|
        dbtgui_shellUtility1:get_reasonList({Pool1,Info1,DisplayArgInfo,CSS1},
                {Pool,Info,CSS2},ReasonList,R1),
        (   R1 = normal(success)->
                CSS2 = [set(reasonList,ReasonList)|CSS],
                sendProtocol_getCommandArguments(reasonList,ReasonList,
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                CSS = CSS2,
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).

%notice draw/win
    get_commandArguments1(notice,nil,[Pos],
                {Pool,Info,_,CSS1},Retern,CPA,R):-true|
        CSS1 = [get(reasonList,ReasonList)|CSS],
        (   ReasonList = []->
                CSS     = [],
                Retern  = {Pool,Info},
                CPA     = {notice,draw,[]},
                R       = normal(success)
        ;
            ReasonList \= []->
                CSS     = [get_pos(reasonList,Pos,SPList)],
                Retern  = {Pool,Info},
                CPA     = {notice,win,SPList},
                R       = normal(success)
        ).

%cancel
    get_commandArguments1(cancel,nil,[],
                {Pool,Info,_,CSS},Retern,CPA,R):-true|
        CSS     = [],
        Retern  = {Pool,Info},
        CPA     = {cancel,nil,[]},
        R       = normal(success).

%finish
    get_commandArguments1(finish,nil,[],
                {Pool,Info,_,CSS},Retern,CPA,R):-true|
        CSS     = [],
        Retern  = {Pool,Info},
        CPA     = {finish,nil,[]},
        R       = normal(success).

%end
    get_commandArguments1(end,nil,[],
                {Pool1,Info,_,CSS},Retern,CPA,R):-true|
         CSS     = [],
         Retern  = {Pool1,Info},
         CPA     = {end,nil,[]},
         R       = normal(success).

%        send_okProtocol(Pool1,Pool,R1),
%        (   wait(R1)->
%                CSS     = [],
%                Retern  = {Pool,Info},
%                CPA     = {end,nil,[]},
%                R       = normal(success)).

%justify
    get_commandArguments1(justify,nil,[],
                {Pool1,Info1,DisplayArgInfo,CSS1},Retern,CPA,R):-true|
        dbtgui_shellUtility1:get_justificationList({Pool1,Info1,DisplayArgInfo,CSS1},
                {Pool,Info,CSS2},SetJL,DispJL,R1),
        (   R1 = normal(success)->
                CSS2 = [set(justificationList,SetJL)|CSS],
                sendProtocol_getCommandArguments(justificationList,DispJL,
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                CSS = CSS2,
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).

%set justification [Pos]
    get_commandArguments1(set,justification,[Pos],
                {Pool1,Info1,DisplayArgInfo,CSS1},Retern,CPA,R):-true|
        CSS1    = [get_pos(justificationList,Pos,SPList)|CSS2],
        dbtgui_shellUtility1:justify({Pool1,Info1,DisplayArgInfo,CSS2},SPList,
                {Pool,Info,CSS},R1),
        (   R1 = normal(success)->
                DisplayArgInfo = {_,LArg},
                sendProtocol_getCommandArguments(argument,[LArg],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).

%set depth
    get_commandArguments1(set,depth,[Depth1],
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-true|

	(   Depth1 = -1->
		Depth = infinite
	;
	    Depth1 \= -1->
		Depth = Depth1
	),

        Info1 = {RBR1,B,C,D},
        RBR1  = [set_parameter(counter,Depth,R1)|RBR],
        Info  = {RBR,B,C,D},

        (   R1 = normal(success)->
                DisplayArgInfo = {_,LArg},
%                sendProtocol_getCommandArguments(argument,[LArg],
                sendProtocol_getCommandArguments(ok,[],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ;
            R1 = abnormal(Reason)->
                sendProtocol_getCommandArguments(errorInfo,[Reason],
                        {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R)
        ).

%set explanationMode
    get_commandArguments1(set,explanationMode,[Mode],
                {Pool,Info1,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        Info1 = {A,B,C,{X,GG,Z}},
        Info  = {A,B,C,{X,Mode ,Z}},

%	builtin:print("%%%%%%%%%%%debug"),
%	builtin:print({GG,Mode}),
%	builtin:print("%%%%%%%%%%%debug"),

        DisplayArgInfo = {_,LArg},
        sendProtocol_getCommandArguments(argument,[LArg],
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

%send explanation
    get_commandArguments1(send,explanation,[],
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R):-true|
        DisplayArgInfo = {_,LArg},
	
	dbtgui_shellUtility4:get_explanation(LArg,Exp),
        sendProtocol_getCommandArguments(explanation,[Exp],
               {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

%send argument [Pos]
    get_commandArguments1(send,argument,[Pos],
                {Pool,Info,DisplayArgInfo,CSS1},Retern,CPA,R):-true|
        CSS1    = [get_pos(argumentList,Pos,LArg),
                   set(forwardList,[])|CSS],            %clear forwardList
        sendProtocol_getCommandArguments(argument,[LArg],
                {Pool,Info,DisplayArgInfo,CSS},Retern,CPA,R).

