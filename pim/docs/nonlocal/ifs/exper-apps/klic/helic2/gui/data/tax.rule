&define_absolute_rule.
&define_RBR_rule.  	{



f1::     考えられる(a_object=高齢化社会)
||"将来、高齢化社会が考えられる".

f2::     公約済み(a_object=-導入する(object=大型間接税))
||"大型間接税を導入しないというのは公約済みである".


f3::     高い(object=所得税)
||"所得税は高い".


f4::     偏重である(a_object=直接税)
||"直接税は偏重である".

f5::     過酷である(a_object=Y/間接税, object=Z/弱者)
||Z "にとって間接税である" Y "は過酷である".


f6::     公平である(a_object=Y/間接税, object=Z/国民)
||Z "にとって" Y "は公平である".


f7::     できる(object=削減する(object=防衛費))
||"防衛費は削減することはできる".


f8::    -できる(object=削減する(object=防衛費))
||"防衛費は削減することはできない".


f9::     大型間接税(a_object=消費税)
||"消費税は大型間接税である".


f10::   -大型間接税(a_object=消費税)
||"消費税は大型間接税ではない".

r1::導入するべきである(object=X)
%      <- 必要である(a_object=X/新しい税金),
      <- 必要である(a_object=新しい税金),
         望ましい(a_object=X/間接税)
||X "を導入すべきである".


r2::必要である(a_object=X/新しい税金) 
      <- 必要である(a_object=増やす(object=税収)),
	 困難である(a_object=増やす(object=Y/古い税金))
|| X "が必要である".


r3::必要である(a_object=増やす(object=税収))
      <- 考えられる(a_object=不足する(object=税収))
||"税収を増やす必要がある".


r4::考えられる(a_object=不足する(object=税収))
      <- 考えられる(a_object=高齢化社会)
||"税収が不足することが考えられる".


r5::困難である(a_object=増やす(object=X))
      <- 高い(object=X/古い税金)
|| "古い税収である" X "を増やすことは困難である".


r6::望ましい(a_object=X/間接税) 
      <- 偏重である(a_object=直接税)
|| "間接税である" X "が望ましい".


r7:: -必要である(a_object=増やす(object=税収))
      <- できる(object=削減する(object=X/支出))
|| "税収を増やす必要はない".


r8:: -望ましい(a_object=Y) 
      <- 過酷である(a_object=Y/間接税, object=Z/弱者)
|| "間接税である" Y "は望ましくない".


r9:: -過酷である(a_object=Y, object=Z)
      <- 公平である(a_object=Y/間接税, object=Z/国民)
|| "間接税である" Y "は国民である" Z "にとって過酷ではない".


r10:: -導入するべきである(object=X)
      <- 公約済み(a_object=-導入する(object=大型間接税)),
         大型間接税(a_object=X)
|| "大型間接税である" X "は導入すべきではない".


}
&define_CBR_rule.


