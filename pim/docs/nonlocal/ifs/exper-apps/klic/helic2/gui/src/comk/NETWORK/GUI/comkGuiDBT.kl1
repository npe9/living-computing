:- module comkGuiDBT.
:- public cmdPose/8,cmdSendRl/8,cmdNotice/8,cmdCancel/8,cmdFinish/8,
          cmdJustify/8,cmdSetJust/8,cmdSendArg/8,cmdSendCounter/8,
        cmdEndDebate/8,
          cmdSendRebut/8,cmdBackward/8,cmdForward/8,cmdNext/8,
          cmdPrevious/8,cmdFocus/8,cmdJump/8,cmdSendCl/8,cmdJumpClaim/8,
          cmdSendExp/8,cmdSendErrInfo/8,cmdSendBye/8,cmdEntBrow/8,
	  cmdExitBrow/8,cmdStartSol/8,cmdExpMode/8,cmdSetDepth/8.

:- with_macro pimos.

cmdPose(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum,_NSTRING),
        Command = 'pose',
        Parameter = 'nil',
        Argument =[].

cmdSendRl(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum,_NSTRING),
        Command = 'send',
        Parameter = 'reasonList',
        Argument =[].


cmdNotice(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
        convert:shortTochange(NString,NNum1,2,0,Int,NNum,_NNString),
        Command = 'notice',
        Parameter = 'nil',
        Argument = [Int].


