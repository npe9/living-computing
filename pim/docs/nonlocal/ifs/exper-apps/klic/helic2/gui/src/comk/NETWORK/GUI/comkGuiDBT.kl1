cmdExpMode(String,Number,_N,_NNum,Command,Parameter,Argument,Agent):- true |
	convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
	convert:charpToatom(NString,NNum1,1,0,Int,_NNums,_NNString),
%	Command = 'explanation',
%	Parameter = 'mode',
	Command = 'set',
	Parameter = 'explanationMode',
	( Int = 'p' ->
		Argument = [h];
	Int = 'd' ->
		Argument = [e]).

cmdSetDepth(String,Number,_N,_NNum,Command,Parameter,Argument,Agent):- true |
	convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
	convert:shortTochange(NString,NNum1,2,0,Int,_NNums,_NNString),
	( wait(Int) ->
		Command = 'set',
		Parameter = 'depth',
%	Command = 'setDepth',
%	Parameter = 'nil',
		Argument = [Int]).