&define_unit.
  抽象的符合説:= {学説3p,判例3p0}.
  法定的符合説:= {学説3d1,学説3d2,学説3d3,学説3d4}.
  具体的符合説:= {学説3d0}.
  定説:=     {定説1,定説2,定説3,定説4}.
  学説:=     {法定的符合説,抽象的符合説,具体的符合説}.
  判例:=     {判例1p,判例1d,判例2p1,判例2p2,判例2d,判例3p0}.
  広い解釈:=   {判例1p,判例2p1,判例2p2}.
  狭い解釈:=   {判例1d,判例2d}.
  勝訴:=     {判例2p1}.
  敗訴:=     {判例2d}.
  刑法:=     {刑法219条}.

  事件:=     {act1,act2,act3,act4,act5,act6,act7}.

  demo:=     {抽象的符合説,法定的符合説,具体的符合説,定説,学説,
		判例,広い解釈,狭い解釈,勝訴,敗訴,刑法,事件}.


&define_standpoint.

    犯罪心理を考慮:=       {具体的符合説<法定的符合説<抽象的符合説}.
    犯罪心理と喪失利益を考慮:=  {{抽象的符合説,具体的符合説}<法定的符合説}.
    厳格性を考慮:=        {抽象的符合説<法定的符合説<具体的符合説}.
    具体的妥当性を考慮:=     {狭い解釈<広い解釈}.
    罪刑法定主義を考慮:=     {広い解釈<狭い解釈}.
    判例優先:=          {学説<判例}.
    多数説優先:=         {{抽象的符合説,具体的符合説}<法定的符合説}.
    定説重視:=          {学説<定説}.
    勝訴重視:=          {敗訴<勝訴}.


&define_view.
   体系重視:= {判例優先 < 勝訴重視 < 厳格性を考慮 < 罪刑法定主義を考慮 < 定説重視}. 
   結果重視:= {具体的妥当性を考慮 < 判例優先 < 勝訴重視 < 犯罪心理と喪失利益を考慮 < 定説重視}.
   行為重視:= {具体的妥当性を考慮 < 判例優先 < 勝訴重視 < 犯罪心理を考慮 < 定説重視}.



