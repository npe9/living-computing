:- module comkGui.
:- public cmdSetPid/8,cmdLoadType/8,cmdLoadCommand/8,cmdLoadRule/8,
          cmdLoadView/8,cmdLoadQuery/8,cmdSetSolver/8,cmdSendSpl/8,
          cmdSendVcl/8,cmdSendGcl/8,cmdSendCu/8,cmdSendCv/8,cmdSendVc/8,
          cmdSetSpl/8,cmdCheckUnit/8,cmdSetUl/8,cmdSetGoal/8,cmdStartDebate/8,
          cmdOK/8.

:- with_macro pimos.


cmdSetPid(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
	Agent = 'nil',
        convert:intTochange(String,Number,4,0,Int,NNum,_NString),
        Command = 'pid',
        Parameter = 'nil',
        Argument = Int.

cmdOK(_String,_Number,N,NNum,Command,Parameter,Argument,Agent):- true |
%       convert:intTochange(String,Number,4,0,Int,NNum,NString),
        NNum = N,
        Command = 'ok',
        Parameter = 'nil',
	Agent = 'nil',
        Argument = [].


cmdLoadType(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
        convert:stringToList(NString,NNum1,_,0,NStr,NNum,_NString2),
        Command = 'load',
        Parameter = 'type',
        Argument = [NStr].


