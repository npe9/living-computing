cmdSetGoal(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
        convert:shortTochange(NString,NNum1,2,0,Int,NNum,_NSTRING2),
        Command = 'set',
        Parameter = 'goal',
        Argument = [Int].

%%%%%   shuusei ari
cmdStartDebate(_String,_Number,_N,_NNum,Command,Parameter,Argument,Agent):- true |
        Command = 'startDebate' ,
        Agent  = 'p',
        Parameter = 'nil',
        Argument =[].
        
        

cmdSendGcl(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum,_NString),
%       convert:shortTochange(NString,NNum1,2,0,Int,NNum,_NSTRING2),
        Command = 'send',
        Parameter = 'goalCandidateList',
        Argument = [].
        

listToAtomL([L1|Ls],NewList):- true |
        listToAt([L1|Ls],[],NewList).
listToAtomL([],NewList):- true |
	NewList=[].

listToAt([L1|Ls],List,NewList):- true |
        hLibrary:sTot(L1,L1Atom),
        append(List,[L1Atom],NList),
        listToAt(Ls,NList,NewList).
listToAt([],List,NewList):- true | NewList=List.

        
append([],L2,List):- true |
        List = L2.
append([H|T],L,AL):- true |
        AL = [H|NAL],
        append(T,L,NAL).

