        convert:stringToList(NString,NNum1,_,0,NStr,NNum,_NSTRING2),     
%       listToAtomL([NStr],NList),
        Command = 'send',
        Parameter = 'viewCandidate',
        hLibrary:sTot(NStr,NStr0),
        Argument = [NStr0].


cmdSetSpl(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
        convert:liToList(NString,NNum1,_,0,List,NNum,_NSTRING2),
        listToAtomL(List,NewList),
        Command = 'set',
        Parameter = 'standpointList',
        Argument = NewList. %%%%%%%%%%%%%%%%%%%  check hituyou ari 


