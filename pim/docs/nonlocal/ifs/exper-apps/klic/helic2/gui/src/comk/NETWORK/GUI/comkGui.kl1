cmdSetSolver(String,Number,_N,NNum,Command,Parameter,Argument,Agent):- true |
        convert:charpToatom(String,Number,1,0,Agent,NNum1,NString),
        convert:charpToatom(NString,NNum1,1,0,Role,NNum,_NSTRING2),
        io:outstream([print(Role),nl]),
        Command = 'set',
        Parameter = 'solver',
        setSol(Role,Argument).

setSol('p',Argument):- true | Argument = ['system'].
setSol('d',Argument):- true | Argument = ['user'].

%       (Role = 'p' ->
%       Argument = ['user'];
%       Role = 'q' ->
%       Argument = ['system']).


