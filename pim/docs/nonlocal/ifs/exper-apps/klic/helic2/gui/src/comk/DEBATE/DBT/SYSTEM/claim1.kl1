:- module dbts_claim1.

:- public 
    claim/4.
            
:- with_macro pimos.

%claim
                %Info         = {RBR,POM,UseKnowledge,Para} %rbr ni kaesu mono
                %UseKnowledge = {UseView,UseUnit,Goal,AgentName}
                %Para         = {Solver,Lang,Verbose},
                %Data         = {O,Pool,Info}
    claim(Claim,{O,Pool1,Info1},Data,NextDR):-true| %Claim = {YA,MI,YA_Arg}
        initiate(Claim,Pool1,Info1,Pool2,Info2,CSS,R1),
        (   R1 = normal(success)->
                dbtgui_systemShell:claim1({Pool2,Info2,CSS},{Pool3,Info3},CPA,R2),
                (   R2 = normal(_)->
                        execute(CPA,Claim,{O,Pool3,Info3},Data,NextDR)
                ;
                    R2 = abnormal(_)->
                        Data = {O,Pool3,Info3},NextDR = []
                )
                
        ;
            R1 = abnormal(_)->
                Data = {O,Pool2,Info2},NextDR = []
        ).

%initiate
    initiate({YA,MI,YA_Arg},Pool1,Info1,Pool,Info,CSS,R):-true|
        make_YDArg({YA,MI,YA_Arg},Pool1,Info1,Pool2,Info2,Status,YDArg,R1),
        (   R1 = normal(success)->
                History = claim(YA,MI),
                YLArg   = YDArg,
                InitVec = {{1,0,0,1},Status,History,nil,{YLArg,YLArg}},
                dbtgui_shellCurrentState:create(InitVec,CSS1),
                dbtgui_showArgumentUtility:show_argumentInfo({Pool2,Info2,CSS1},
                        YLArg,YLArg,{Pool,Info,CSS},R)
        ;
            R1 = abnormal(_)->
                Pool = Pool2,
                Info = Info2,
                R    = R1
        ).

%make_YDArg
    make_YDArg({YA,_,YA_Arg},Pool1,Info1,Pool,Info,Status,YDArg,R):-true|
        Pool1 = [make(at,AT1)|Pool2],
        AT1   = [is_inID(YA,YN1)|AT2],
        Info1 = {_,_,{_,_,_,AgentName},_},
        dbtgui_messagePool:make_message({claim,you},{AgentName,YA},Status),
        (   YN1 = yes->
                AT2     = [refer_arg(YA,YDArg,_)],
                Pool    = Pool2,
                Info    = Info1,
                R       = normal(success)
        ;
            YN1 = no->
                dbtgui_rbrUtility:check_arg(YA_Arg,initial,Info1,Info,YDArg,R1),
                (   R1 = normal(_)->
                        AT2     = [put(YA,YDArg,R2)],
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
                        (   R2 = normal(_)->        %korega naito umaku ugokanai
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
                                Pool2   = [makeList([yat,icat],[YAT,ICAT])|Pool3],
                                YAT     = [put(YDArg)],
                                ICAT    = [put({YDArg,YA},Pool3,Pool)],
                                R       = normal(success))
                ;
                    R1 = abnormal(_)->
                        AT2     = [],
                        Pool    = Pool2,
                        R       = R1
                )
        ).

%execute
    execute({pose,counter,[{SV,IPos,CPos}]},{YA,MI,_},{O1,Pool1,Info1},Data,_):-true|
        MLArg   = {{SV,0},IPos,CPos},
        MDArg   = {SV,IPos,CPos},
        Pool1   = [makeList([at,mat,ct,mnt,hl],[AT,MAT,CT,MNT,HL])|Pool2],
        AT      = [is_inArg(MDArg,YN1)|AT1],
        (   YN1 = yes->
                AT1 = [refer_ID(MDArg,MA,R1)]
                    % message-"Already sent this argument"
        ;
            YN1 = no->
                AT1 = [make_ID(MA),put(MA,MDArg,R1)]
        ),
        (   wait(R1)->
                Info1 = {_,_,{_,_,_,AgentName},_},
                dbtgui_messagePool:make_message({claim,i},{AgentName,MA},Status),
                dbtgui_showArgumentUtility:show_status(Pool2,Status,Pool,R2)),
        (   wait(R2)->
                MAT   = [put(MDArg)],
                CT    = [claim({YA,IPos},MA)],
                set_uur(MDArg,MA,YA,MNT,Info1,Info),
                dbtgui_LArgUtility:get_PArg(MLArg,MPArg),
                O1    = [{claim(MA,issue(claim(YA,MI),IPos)),MPArg}|O],
                HL    = [put(send(y,{claim(MA,issue(claim(YA,MI),IPos)),MPArg}))],
                Data  = {O,Pool,Info}).
    execute({finish,_,_},{YA,_,_},{O1,Pool1,Info},Data,_):-true|
        Info = {_,_,{_,_,_,AgentName},_},
        dbtgui_messagePool:make_message({finish,i},{AgentName,YA},Status),
        dbtgui_showArgumentUtility:show_status(Pool1,Status,Pool2,R1),
        (   wait(R1)->
                Pool2   = [makeList([at,yat,hl],[AT,YAT,HL])|Pool],
                AT      = [refer_arg(YA,YDArg,_)],
                YAT     = [finish(YDArg)],
                O1      = [finish(claim(YA,nil))|O],
                HL      = [put(send(y,finish(claim(YA,nil))))],
                Data    = {O,Pool,Info}).
    execute({end,_,_},_,Data1,Data,NextDR):-true|
        Data    = Data1,
        NextDR  = [].

%set_uur
    set_uur({SV,IPos,CPos},MA,YA,MNT,Info1,Info):-integer(IPos)|
        YLArg  = {SV,0},
        MLArg  = {{SV,0},IPos,CPos},
        dbtgui_LArgUtility:get_ruleName(YLArg,IPos,YR),
        dbtgui_LArgUtility:get_ruleName(MLArg,0,MR),

        dbtgui_guiUtility:get_unitUnitRelReason(YR,MR,Info1,Info,Rel,_),
        (   Rel = -1->
                Type      = lose,
		XXRuleName= {YR,MR}
        ;
            Rel = 0->
                Type      = draw,
		XXRuleName= {MR,YR}
        ),

        MNT = [put(Type,{YA,IPos},{MA,XXRuleName})].
                    %                        MNT = [put(Type,{YA,IPos},{MA,{RN1,RN2}})]
                    % hontouha {RN1,RN2} daga "change view" wo surutokini RN2>RN1 mo yurusu
                    %sikasi programu ha RN1 > RN2 moyurusutonaxtuteirutameni rule rel ha tuneni
                    %{MyRule,YourRule}tosi Type ha kono2tuno kankei wo kijutusurukototosuru
otherwise.
    set_uur(_,_,_,MNT,Info1,Info):-true|
        MNT    = [],
        Info   = Info1.