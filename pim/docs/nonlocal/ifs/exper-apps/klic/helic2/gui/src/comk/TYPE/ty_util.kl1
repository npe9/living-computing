%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S compact(X,Y)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
compact([],OL):-OL=[].
compact([H|IL],OL):-
    CurrentDigit = H,
    CurrentOccurrence = 1,
    ty_init:ty_compact_occurrence_threshold(Threshold),
    n_compact(IL,CurrentDigit,CurrentOccurrence,Threshold,OL).

n_compact([],CurrentDigit,CurrentOccurrence,Threshold,OL):-
    compact_check(CurrentOccurrence,Threshold,CurrentDigit,OL,NOL),
    NOL = [].
n_compact([H|IL],CurrentDigit,CurrentOccurrence,Threshold,OL):-
    H =:= CurrentDigit |
	n_compact(IL,CurrentDigit,~(CurrentOccurrence+1),Threshold,OL).
n_compact([H|IL],CurrentDigit,CurrentOccurrence,Threshold,OL):-
    H =\= CurrentDigit |
	compact_check(CurrentOccurrence,Threshold,CurrentDigit,OL,NOL),
	NewCurrentDigit = H,
	NewCurrentOccurrence = 1,
	n_compact(IL,NewCurrentDigit,NewCurrentOccurrence,Threshold,NOL).

compact_check(Count,Threshold,X,L,LL):-
    Count < Threshold |
	n_element_copy(Count,X,L,LL).
compact_check(Count,Threshold,X,L,LL):-
    Count >= Threshold |
	Compaction = {Count,X},
	L = [Compaction|LL].

n_element_copy(N,X,L,LL):-
    N > 0 |
	L = [X|TL],
	n_element_copy(~(N-1),X,TL,LL).
n_element_copy(N,_X,L,LL):-
    N =< 0 |
	LL = L.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S decompact(X,Y)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
decompact([],OL):-OL=[].
decompact([H|IL],OL):-
    decode_element(H,OL,TOL),
    decompact(IL,TOL).

decode_element(H,L,LL):-
    vector(H,2) |
	vector_element(H,0,N,H1),
	vector_element(H1,1,X,_H2),
	n_element_copy(N,X,L,LL).
decode_element(H,L,LL):-
    integer(H) |
	L = [H|LL].



% The followings are for KLIC port.
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S encapsulate(X,Y)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% PseudoBitString : 8#{1,0,1,0,0,...}
% EncapsulatedVector : {Size,[10,...]}
encapsulate(PseudoBitString,EncapsulatedVector):-
    string_to_stream(PseudoBitString,BitSize,BitStream),
    bitstream_to_bytestream(BitStream,ByteStream),
    compact(ByteStream,CompactedByteStream),
    EncapsulatedVector = {BitSize,CompactedByteStream}.

% {1,0,0,1,...} -> [1,0,0,1,...]
string_to_stream(String,Size,Stream):-
    generic:string(String,Size,_ElementSize),
    string2stream(Size,String,Stream).

string2stream(Size,_String,Stream):-Size=<0|
	Stream = [].
string2stream(Size,String,Stream):-Size>0|
	Position := Size-1,
	string_element(String,Position,Element),
	Stream = [Element|NewStream],
	string2stream(Position,String,NewStream).

% ビットストリーム -> バイトストリーム(十進)
% [1,0,0,1,...] -> [90,00,00,...]
bitstream_to_bytestream([],ByteStream):-ByteStream = [].
otherwise.
bitstream_to_bytestream(BitStream,ByteStream):-
    Count = 7,
    Byte = 0,
    bitstream2bytestream(BitStream,Count,Byte,ByteStream).

bitstream2bytestream([],Count,Byte,ByteStream):- Count =:= 7 |
    ByteStream = [].
bitstream2bytestream([],Count,Byte,ByteStream):- Count < 7 |
	ByteStream = [Byte].
bitstream2bytestream([Bit|BitStream],Count,Byte,ByteStream):- Count =:= 0 |
	ByteStream = [~(Byte+Bit)|NewByteStream],
	NewCount = 7,
	NewByte = 0,
	bitstream2bytestream(BitStream,NewCount,NewByte,NewByteStream).
bitstream2bytestream([Bit|BitStream],Count,Byte,ByteStream):- Count > 0 |
	NewByte := Byte + (Bit << Count),
	NewCount := Count-1,
	bitstream2bytestream(BitStream,NewCount,NewByte,ByteStream).


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S decapsulate(X,Y)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% PseudoBitString : 8#{1,0,1,0,0,...}
% EncapsulatedVector : {Size,[10,...]}
decapsulate(EncapsulatedVector,PseudoBitString):-
    vector_element(EncapsulatedVector,0,BitSize),
    vector_element(EncapsulatedVector,1,CompactedByteStream),
    decompact(CompactedByteStream,ByteStream),
    bytestream_to_bitstream(ByteStream,BitStream),
    stream_to_string(BitStream,BitSize,PseudoBitString).

bytestream_to_bitstream([],BitStream):-
    BitStream = [].
bytestream_to_bitstream([Byte|ByteStream],BitStream):-
    Count = 8,
    byte2bitstream(Count,Byte,BitStream,NewBitStream),
    bytestream_to_bitstream(ByteStream,NewBitStream).

byte2bitstream(Count,_Byte,BitStream,NewBitStream):- Count =:= 0 |
    NewBitStream = BitStream.
byte2bitstream(Count,Byte,BitStream,NewBitStream):- Count > 0 |
	NewCount := Count-1,
	Bit := Byte /\ (1 << NewCount),
	(Bit =:= 0 ->
	    BitStream = [0|BitStream1]
	;otherwise;true ->
	    BitStream = [1|BitStream1]
	),
	byte2bitstream(NewCount,Byte,BitStream1,NewBitStream).

stream_to_string(BitStream,BitSize,PseudoBitString):-
    new_string(PseudoBitString0,BitSize,8),
    stream2string(BitSize,BitStream,PseudoBitString0,PseudoBitString).

stream2string(EffectiveSize,_Stream,String,NewString):-
    EffectiveSize =:= 0|
	NewString = String.
stream2string(EffectiveSize,[Element|Stream],String,NewString):-
    EffectiveSize > 0|
	Position := EffectiveSize-1,
	set_string_element(String,Position,Element,String1),
	stream2string(Position,Stream,String1,NewString).



%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S keyed_set(X)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
keyed_set(Tree):-
    Tree = [].


%
% keyed_set
%

% keyed_set Tree : {Key,[Data],SmallTree,LargeTree}

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_with(Key,Data,Tree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
get_with(_Key,Data,[]):-
    Data={}.
otherwise.
get_with(Key,Data,Tree):-
%    Tree = {K,_,_,_},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_get_with(R,Key,Data,Tree).

cmp_get_with(same,_Key,Data,Tree):-
%    Tree = {_,DL,_,_},
    vector_element(Tree,1,DL),
    [D] = DL,
    Data = {D}.
cmp_get_with(less,Key,Data,Tree):-
%    Tree = {_,_,S,_},
    vector_element(Tree,2,S),
    get_with(Key,Data,S).
cmp_get_with(greater,Key,Data,Tree):-
%    Tree = {_,_,_,L},
    vector_element(Tree,3,L),
    get_with(Key,Data,L).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S put_with(Key,Data,Tree,^NewTree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
put_with(Key,Data,[],NewTree):-
%    NewTree = {Key,[Data],[],[]}.
    new_vector(Tree0,4),
    set_vector_element(Tree0,0,_,Key,Tree1),
    set_vector_element(Tree1,1,_,[Data],Tree2),
    set_vector_element(Tree2,2,_,[],Tree3),
    set_vector_element(Tree3,3,_,[],NewTree).
otherwise.
put_with(Key,Data,Tree,NewTree):-
%    Tree = {K,_,_,_},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_put_with(R,Key,Data,Tree,NewTree).

cmp_put_with(same,Key,Data,Tree,NewTree):-
%    Tree = {_,_,S,L},
%    NewTree = {Key,[Data],S,L},
    set_vector_element(Tree,0,_,Key,Tree1),
    set_vector_element(Tree1,1,_,[Data],NewTree).
cmp_put_with(less,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,NS,L},
    set_vector_element(Tree,2,S,NS,NewTree),
    put_with(Key,Data,S,NS).
cmp_put_with(greater,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,S,NL},
    set_vector_element(Tree,3,L,NL,NewTree),
    put_with(Key,Data,L,NL).

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S carbon_copy(Contents,Tree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
carbon_copy(Contents,Tree):-
    traverse_tree(Tree,Contents,[]).

traverse_tree([],Contents,NewContents):-
    NewContents = Contents.
traverse_tree(Tree,Contents,NewContents):-vector(Tree,4)|
%    Tree = {Key,DL,S,L},
    vector_element(Tree,0,Key),
    vector_element(Tree,1,DL),
    vector_element(Tree,2,S),
    vector_element(Tree,3,L),
    traverse_tree(S,Contents,Contents1),
    key_data_pair(Key,DL,Contents1,Contents2),
    traverse_tree(L,Contents2,NewContents).

key_data_pair(_,[],Contents,NewContents):-
    NewContents = Contents.
key_data_pair(Key,[Data|DL],Contents,NewContents):-
    Contents = [{Key,Data}|Contents1],
    key_data_pair(Key,DL,Contents1,NewContents).



%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S keyed_bag(X)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
keyed_bag(Tree):-
    Tree = [].

% keyed_bag Tree : {Key,DataList,Small,Large}

%
% keyed_bag
%

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S get_at(Key,Data,Tree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
get_at(_,Data,[]):-
    Data={}.
otherwise.
get_at(Key,Data,Tree):-
%    Tree = {K,_,_,_},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_get_at(R,Key,Data,Tree).

cmp_get_at(same,_Key,Data,Tree):-
%    Tree = {_,DL,_,_},
    vector_element(Tree,1,DL),
    scan_get_data(DL,Data).
cmp_get_at(less,Key,Data,Tree):-
%    Tree = {_,_,S,_},
    vector_element(Tree,2,S),
    get_at(Key,Data,S).
cmp_get_at(greater,Key,Data,Tree):-
%    Tree = {_,_,_,L},
    vector_element(Tree,3,L),
    get_at(Key,Data,L).

scan_get_data([],Data):-
    % no data
    Data = {}.
scan_get_data([D|_],Data):-
    % LIFO
    Data = {D}.


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S add_at(Key,Data,Tree,^NewTree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
add_at(Key,Data,[],NewTree):-
%    NewTree = {Key,[Data],[],[]},
    new_vector(Tree0,4),
    set_vector_element(Tree0,0,_,Key,   Tree1),
    set_vector_element(Tree1,1,_,[Data],Tree2),
    set_vector_element(Tree2,2,_,[],    Tree3),
    set_vector_element(Tree3,3,_,[],    NewTree).
otherwise.
add_at(Key,Data,Tree,NewTree):-
%    Tree = {K,_,_,_},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_add_at(R,Key,Data,Tree,NewTree).

cmp_add_at(same,Key,Data,Tree,NewTree):-
%    Tree = {_,DL,S,L},
%    NewTree = {Key,NDL,S,L},
    set_vector_element(Tree,0,_,Key,Tree1),
    scan_add_data(DL,Data,NDL),
    set_vector_element(Tree1,1,DL,NDL,NewTree).
cmp_add_at(less,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,NS,L},
    set_vector_element(Tree,2,S,NS,NewTree),
    add_at(Key,Data,S,NS).
cmp_add_at(greater,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,S,NL},
    set_vector_element(Tree,3,L,NL,NewTree),
    add_at(Key,Data,L,NL).

scan_add_data([],Data,NDL):-
    NDL = [Data].
scan_add_data(DL,Data,NDL):-DL=[_|_]|
    NDL = [Data|DL].


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S remove_at(Key,Data,Tree,^NewTree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% If there is no data, remove_at fails.
% Data must be given ground data otherwise deadlock.
remove_at(Key,Data,Tree,NewTree):-
%    Tree = {K,_,_,_},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_remove_at(R,Key,Data,Tree,NewTree).

cmp_remove_at(same,Key,Data,Tree,NewTree):-
%    Tree = {_,DL,S,L},
%    NewTree = {Key,NDL,S,L},
    set_vector_element(Tree,0,_,Key,Tree1),
    set_vector_element(Tree1,1,DL,NDL,NewTree),
    scan_remove_data(DL,Data,NDL).
cmp_remove_at(less,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,NS,L},
    set_vector_element(Tree,2,S,NS,NewTree),
    remove_at(Key,Data,S,NS).
cmp_remove_at(greater,Key,Data,Tree,NewTree):-
%    Tree = {K,DL,S,L}
%    NewTree = {K,DL,S,NL},
    set_vector_element(Tree,3,L,NL,NewTree),
    remove_at(Key,Data,L,NL).

% If unifiable, remove it.
% If Data is ground, check unifiability.
% If Data is not ground(variable), unify it with D.
% If no unifiable data, fail.
scan_remove_data([D|DL],Data,NDL):-D=Data|
    NDL = DL.
otherwise.
scan_remove_data([D|DL],Data,NDL):-
    NDL = [D|DL1],
    scan_remove_data(DL,Data,DL1).


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S carbon_copy_at(Contents,Tree)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
carbon_copy_at(Key,Contents,Tree):-
    traverse_tree_at(Key,Tree,Contents).

traverse_tree_at(_,[],Contents):-
    Contents = [].
otherwise.
traverse_tree_at(Key,Tree,Contents):-
%    Tree = {K,DL,S,L},
    vector_element(Tree,0,K),
    comp(Key,K,R),
    cmp_traverse_tree_at(R,Key,Tree,Contents).
    
cmp_traverse_tree_at(same,Key,Tree,Contents):-
%    Tree = {Key,DL,_,_},
    vector_element(Tree,1,Contents).
cmp_traverse_tree_at(less,Key,Tree,Contents):-
%    Tree = {_,_,S,_},
    vector_element(Tree,2,S),
    traverse_tree_at(Key,S,Contents).
cmp_traverse_tree_at(greater,Key,Tree,Contents):-
%    Tree = {_,_,_,L},
    vector_element(Tree,3,L),
    traverse_tree_at(Key,L,Contents).


% comparator
% We only support atom and integer. Because we only use them as key
% of keyed_set / keyed_bag.
comp(X,Y,Z):-atom(X),atom(Y)|
	comp_atom(X,Y,Z).
comp(X,Y,Z):-integer(X),integer(Y)|
	comp_int(X,Y,Z).

comp_atom(X,Y,Z):-X=Y|
	Z=same.
comp_atom(X,Y,Z):-
    tag_and_value(X,_,Xv),tag_and_value(Y,_,Yv),Xv<Yv |
	Z=less.
comp_atom(X,Y,Z):-
    tag_and_value(X,_,Xv),tag_and_value(Y,_,Yv),Xv>Yv |
	Z=greater.

comp_int(X,Y,Z):-X=:=Y|
	Z=same.
comp_int(X,Y,Z):-X<Y|
	Z=less.
comp_int(X,Y,Z):-X>Y|
	Z=greater.
