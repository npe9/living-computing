:-module ty_util.
:-with_macro pimos.
:-public make_pterm/3,make_dcl_pterm/3.
:-public make_pterm/5.
%:-public bit2byte/2,byte2bit/2.
:-public compact/2,decompact/2.
:-public encapsulate/2,decapsulate/2.
:-public keyed_bag/1,get_at/3,add_at/4,remove_at/4,carbon_copy_at/3.
:-public keyed_set/1,get_with/3,put_with/4,carbon_copy/2.

%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S make_pterm(Defs,PTerms,Result)
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_syntax | illegal_attribute_syntax
make_pterm(Defs,PTerms,Result):-
    QID = 1,
    make_pterm(Defs,QID,_NewQID,PTerms,Result).

make_pterm([],QID,NewQID,PTerms,Result):-
    NewQID = QID,
    PTerms = [],
%    Result = normal(ty#yes).
    Result = normal(success).
make_pterm([Def|Defs],QID,NewQID,PTerms,Result):-
    mk_pterm(Def,PTerm,QID,QID1,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        make_pterm(Defs,QID1,NewQID,NewPTerms,Result),
        PTerms = [PTerm|NewPTerms]
    ;otherwise;true ->
        NewQID = QID1,
        PTerms = [],
        Result = R1
    ).


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_syntax, illegal_attribute_syntax
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_some(X)|
    functor(X,P,A),P=some,A=:=1|
%	vector_element(X,1,XX,_X),
	arg(1,X,XX),
	mk_pterm(XX,PTerm,QID,QID1,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
%	    pterm#set(quantifier,QID,PTerm,NewPTerm),
	    set_vector_element(PTerm,1,_,QID,NewPTerm),
	    NewQID := QID1+1,
	    Result = R1
	;otherwise;true ->
	    NewPTerm = PTerm,
	    NewQID = QID1,
	    Result = R1
	).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_var(X)|
    functor(X,P,A),P='&var',A=:=1|
%	vector_element(X,1,VarID,_X),
	arg(1,X,VarID),
	NewPTerm = VarID,
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_integer(X)|
    X = integer|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,ty#integer,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,'&integer',PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_string(X)|
    X=string|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,ty#string,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,'&string',PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
    atom(X)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,X,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,X,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
    string(X,_,_)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,X,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,X,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
    integer(X)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	number#new(Number0),
	new_vector(Number0,1),
%	number#set(value,X,Number0,Number),
	set_vector_element(Number0,0,_,X,Number),
%	pterm#set(typename,Number,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,Number,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_cover(X,From,To)|
    X=[R],functor(R,P,A),P='..',A=:=2,
    arg(1,R,From),arg(2,R,To)|
	FromNumber = {From},
	ToNumber = {To},
%	cover#new(Cover),
	new_vector(Cover,2),
%	cover#set(from,FromNumber,Cover,Cover1),
	set_vector_element(Cover,0,_,FromNumber,Cover1),
%	cover#set(to,ToNumber,Cover1,NewCover),
	set_vector_element(Cover1,1,_,ToNumber,NewCover),
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,NewCover,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,NewCover,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_cover(X,From,To)|   % vector version for convenience of test pro
    X=[R],vector(R,3),vector_element(R,0,P),P='..'|
	vector_element(R,1,From),
	vector_element(R,2,To),
	FromNumber = {From},
	ToNumber = {To},
%	cover#new(Cover),
	new_vector(Cover,2),
%	cover#set(from,FromNumber,Cover,Cover1),
	set_vector_element(Cover,0,_,FromNumber,Cover1),
%	cover#set(to,ToNumber,Cover1,NewCover),
	set_vector_element(Cover1,1,_,ToNumber,NewCover),
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,NewCover,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,NewCover,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
	NewQID = QID,
%	Result = normal(ty#yes).
	Result = normal(success).
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%    syn#is_pterm(X)|
    functor(X,Pred,A),atom(Pred),A=:=1|
%	ty#functor(X,Pred,1,X1),
%	ty#arg(X1,1,AttrDefs,_X2),
	arg(1,X,AttrDefs),
	mk_attrs(AttrDefs,AttrPairs,QID,NewQID,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
	    % [注意!]
	    % AttrPairsが{Key,Data}の形式であることを前提にしてPIMOSの
	    % sorterを利用している。
%	    sorter:key_sort(AttrPairs,SortedAttrPairs),
	    ty_osif:key_sort(AttrPairs,SortedAttrPairs),
%	    pterm#new(PTerm),
	    new_vector(PTerm,3),
%	    pterm#set(typename,Pred,PTerm,PTerm1),
	    set_vector_element(PTerm,0,_,Pred,PTerm1),
%	    pterm#set(attributes,SortedAttrPairs,PTerm1,NewPTerm),
	    set_vector_element(PTerm1,2,_,SortedAttrPairs,NewPTerm),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    NewPTerm = ty#void,
	    NewPTerm = '&void',
	    Result = R1
	).
otherwise.
mk_pterm(X,NewPTerm,QID,NewQID,Result):-
%	NewPTerm = ty#void,
	NewPTerm = '&void',
	NewQID = QID,
	Result = abnormal(Info),
%	Info = {ty#typemid,illegal_syntax,[X]}.
	Info = {type,illegal_syntax,[X]}.

% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_attribute_syntax
mk_attrs([],Attrs,QID,NewQID,Result):-
    Attrs = [],
    NewQID = QID,
%    Result = normal(ty#yes).
    Result = normal(success).
mk_attrs([Pair|Pairs],Attrs,QID,NewQID,Result):-
%    ty#functor(Pair,syn#occattr,2)|
    functor(Pair,P,A),P='=>',A=:=2|
%	ty#arg(Pair,1,Label,Pair1),
	arg(1,Pair,Label),
%	ty#arg(Pair1,2,Value,_Pair2),
	arg(2,Pair,Value),
	mk_pterm(Value,PTermValue,QID,QID1,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
%	    ty_osif:term_to_string(Label,LabelStr),
	    ty_osif:atom_to_string(Label,LabelStr),
%	    attribute#new(Attr),
	    new_vector(Attr,2),
%	    attribute#set(label,LabelStr,Attr,Attr1),
	    set_vector_element(Attr,0,_,LabelStr,Attr1),
%	    attribute#set(value,PTermValue,Attr1,NewAttr),
	    set_vector_element(Attr1,1,_,PTermValue,NewAttr),
	    Attrs = [NewAttr|NewAttrs],
	    mk_attrs(Pairs,NewAttrs,QID1,NewQID,Result)
	;otherwise;true ->
	    Attrs = [],
	NewQID=QID1,
	    Result = R1
	).
otherwise.
mk_attrs([Pair|_Pairs],Attrs,QID,NewQID,Result):-
    Attrs = [],
	NewQID=QID,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_attribute_syntax,[Pair]}.
    Info = {type,illegal_attribute_syntax,[Pair]}.
otherwise.
mk_attrs(Term,Attrs,QID,NewQID,Result):-
    Attrs = [],
	NewQID=QID,
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_attribute_syntax,[Term]}.
    Info = {type,illegal_attribute_syntax,[Term]}.


%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% S
%+++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++++
% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_dcl_syntax | illegal_attribute_dcl_syntax
make_dcl_pterm([],PTerms,Result):-
%    Result = normal(ty#yes),
    Result = normal(success),
    PTerms = [].
make_dcl_pterm([Def|Defs],PTerms,Result):-
    mk_dcl_pterm(Def,PTerm,R1),
%    (R1 = normal(ty#yes) ->
    (R1 = normal(success) ->
        make_dcl_pterm(Defs,NewPTerms,Result),
        PTerms = [PTerm|NewPTerms]
    ;otherwise;true ->
        PTerms = [],
        Result = R1
    ).


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_attribute_dcl_syntax
mk_dcl_pterm(X,NewPTerm,Result):-
%    syn#is_integer(X)|
    X=integer|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,ty#integer,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,'&integer',PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
mk_dcl_pterm(X,NewPTerm,Result):-
%    syn#is_string(X)|
    X=string|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,ty#string,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,'&string',PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
otherwise.
mk_dcl_pterm(X,NewPTerm,Result):-
    atom(X)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,X,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,X,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
mk_dcl_pterm(X,NewPTerm,Result):-
    string(X,_,_)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,X,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,X,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
mk_dcl_pterm(X,NewPTerm,Result):-
    integer(X)|
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	number#new(Number0),
	new_vector(Number0,1),
%	number#set(value,X,Number0,Number),
	set_vector_element(Number0,0,_,X,Number),
%	pterm#set(typename,Number,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,Number,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
mk_dcl_pterm(X,NewPTerm,Result):-
%    syn#is_cover(X,From,To)|
    X=[R],functor(R,P,A),P='..',A=:=2,
    arg(1,R,From),arg(2,R,To)|
	FromNumber = {From},
	ToNumber = {To},
%	cover#new(Cover),
	new_vector(Cover,2),
%	cover#set(from,FromNumber,Cover,Cover1),
	set_vector_element(Cover,0,_,FromNumber,Cover1),
%	cover#set(to,ToNumber,Cover1,NewCover),
	set_vector_element(Cover1,1,_,ToNumber,NewCover),
%	pterm#new(PTerm),
	new_vector(PTerm,3),
%	pterm#set(typename,NewCover,PTerm,PTerm1),
	set_vector_element(PTerm,0,_,NewCover,PTerm1),
%	pterm#set(attributes,[],PTerm1,NewPTerm),
	set_vector_element(PTerm1,2,_,[],NewPTerm),
%	Result = normal(ty#yes).
	Result = normal(success).
mk_dcl_pterm(X,NewPTerm,Result):-
%    syn#is_pterm(X)|
    vector(X,2), vector_element(X,0,Pred),atom(Pred)|
%	ty#functor(X,Pred,1,X1),
%	ty#arg(X1,1,AttrDefs,_X2),
	vector_element(X,1,AttrDefs),
	mk_dcl_attrs(AttrDefs,AttrPairs,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
	    % [注意!]
	    % AttrPairsが{Key,Data}の形式であることを前提にしてPIMOSの
	    % sorterを利用している。
%	    sorter:key_sort(AttrPairs,SortedAttrPairs),
	    ty_osif:key_sort(AttrPairs,SortedAttrPairs),
%	    pterm#new(PTerm),
	    new_vector(PTerm,3),
%	    pterm#set(typename,Pred,PTerm,PTerm1),
	    set_vector_element(PTerm,0,_,Pred,PTerm1),
%	    pterm#set(attributes,SortedAttrPairs,PTerm1,NewPTerm),
	    set_vector_element(PTerm1,2,_,SortedAttrPairs,NewPTerm),
%	    Result = normal(ty#yes)
	    Result = normal(success)
	;otherwise;true ->
%	    NewPTerm = ty#void,
	    NewPTerm = '&void',
	    Result = R1
	).
otherwise.
mk_dcl_pterm(X,NewPTerm,Result):-
%	NewPTerm = ty#void,
	NewPTerm = '&void',
	Result = abnormal(Info),
%	Info = {ty#typemid,illegal_dcl_syntax,[X]}.
	Info = {type,illegal_dcl_syntax,[X]}.


% Result : normal(ty#yes) | abnormal(Info)
%        Info : illegal_attribute_dcl_syntax
mk_dcl_attrs([],Attrs,Result):-
    Attrs = [],
%    Result = normal(ty#yes).
    Result = normal(success).
mk_dcl_attrs([Pair|Pairs],Attrs,Result):-
%    ty#functor(Pair,syn#dclattr,2)|
    functor(Pair,P,A),P=':',A=:=2|
%	ty#arg(Pair,1,Label,Pair1),
	arg(1,Pair,Label),
%	ty#arg(Pair1,2,Value,_Pair2),
	arg(2,Pair,Value),
	mk_dcl_pterm(Value,PTermValue,R1),
%	(R1 = normal(ty#yes) ->
	(R1 = normal(success) ->
%	    ty_osif:term_to_string(Label,LabelStr),
	    ty_osif:atom_to_string(Label,LabelStr),
%	    attribute#new(Attr),
	    new_vector(Attr,2),
%	    attribute#set(label,LabelStr,Attr,Attr1),
	    set_vector_element(Attr,0,_,LabelStr,Attr1),
%	    attribute#set(value,PTermValue,Attr1,NewAttr),
	    set_vector_element(Attr1,1,_,PTermValue,NewAttr),
	    Attrs = [NewAttr|NewAttrs],
	    mk_dcl_attrs(Pairs,NewAttrs,Result)
	;otherwise;true ->
	    Attrs = [],
	    Result = R1
	).
otherwise.
mk_dcl_attrs([Pair|_Pairs],Attrs,Result):-
    Attrs = [],
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_attribute_dcl_syntax,[Pair]}.
    Info = {type,illegal_attribute_dcl_syntax,[Pair]}.
otherwise.
mk_dcl_attrs(Term,Attrs,Result):-
    Attrs = [],
    Result = abnormal(Info),
%    Info = {ty#typemid,illegal_attribute_dcl_syntax,[Term]}.
    Info = {type,illegal_attribute_dcl_syntax,[Term]}.



