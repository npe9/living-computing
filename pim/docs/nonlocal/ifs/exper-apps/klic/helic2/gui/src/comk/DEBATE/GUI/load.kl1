%make_protocol
    make_protocol(abnormal(Reason),_,AgentName,CGS1,CGS,GUIProtocol):-true|
        CGS         = CGS1,
        dbtgui_utility:make_errorProtocol(AgentName,Reason,GUIProtocol).
    make_protocol(normal(success),LoadFileType,AgentName,CGS1,CGS,GUIProtocol):-true|
        CGS1        = [get(AgentName,loadFlag,LoadFlag1)|CGS2],
        set_loadFlag(LoadFileType,LoadFlag1,LoadFlag),
        CGS2        = [set(AgentName,loadFlag,LoadFlag)|CGS],
        GUIProtocol = receive(AgentName,loadFlag,[LoadFlag],_R).

    set_loadFlag(LoadFileType,LoadFlag1,LoadFlag):-true|
        get_loadFlagPos(LoadFileType,Pos),
        set_vector_element(LoadFlag1,Pos,_,1,LoadFlag).

    get_loadFlagPos(type,Pos):-true|
        Pos = 0.
    get_loadFlagPos(rule,Pos):-true|
        Pos = 1.
    get_loadFlagPos(view,Pos):-true|
        Pos = 2.
    get_loadFlagPos(goal,Pos):-true|
        Pos = 3.