% TR-056 (Hattori, Yokoi, "The Concepts and Facilities of SIMPOS Supervisor", ICOT TR-056, 84.04)
% PDF page 13, printed folio 11. Section 4(1) stream uses: Semaphore and Event (clause bodies printed); Figure 4.1 Stream.
% Transcribed by eye from 300dpi code-line crops (work/tr0056/m*.png), F2 2026-11-23. Courier font: punctuation clear.
% Interface lines are printed one per bullet item, each under an 'o To ...' description (given as % comments).

% o Semaphore
%   A semaphore and p/v operations on it can synchronize processes.
          :p(Semaphore) :-
                  :get(Semaphore,Token).
          :v(Semaphore) :-
                  :put(Semaphore,token).
          :init(Semaphore)
                  :put(Semaphore,token).
% (as printed: ":init(Semaphore)" has no ":-" -- misprint; not corrected)
%   An integer semaphore can be implemented by initializing a semaphore
%   so that it includes the specified number of tokens:
          :init(Semaphore,Count)
% o Event
%   An event synchronizes processes by passing an event code.
          :post(Event,Code) :-
                  :put(Event,Code).
          :wait(Event,Code) :-
                  :get(Event,Code).
