:- module kl1cmp2.
:- public builtin/7,active_builtin/5,expression/4,pr1/1,pr2/1,pr3/1,pr4/1.
	  
	  


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%  Builtin Tables  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%
%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

:- local_implicit instr:shared, inarg:stream, outarg:stream,
		  preins:oldnew, type:shared.

builtin(add(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = add(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3],
    &preins <<= [integer(X1),integer(X2)].
builtin(subtract(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = subtract(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3],
    &preins <<= [integer(X1),integer(X2)].
builtin(multiply(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = multiply(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3],
    &preins <<= [integer(X1),integer(X2)].
builtin(divide(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = divide(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3],
    &preins <<= [integer(X1),integer(X2)].
builtin(modulo(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = modulo(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3],
    &preins <<= [integer(X1),integer(X2)].

builtin(equal(X1,X2)) --> true |
    &type     = builtin,
    &instr    = equal(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2],
    &preins <<= [integer(X1),integer(X2)].
builtin(not_equal(X1,X2)) --> true |
    &type     = builtin,
    &instr    = not_equal(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2],
    &preins <<= [integer(X1),integer(X2)].
builtin(less(X1,X2)) --> true |
    &type     = builtin,
    &instr    = less(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2],
    &preins <<= [integer(X1),integer(X2)].
builtin(not_less(X1,X2)) --> true |
    &type     = builtin,
    &instr    = not_less(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2],
    &preins <<= [integer(X1),integer(X2)].

builtin((X1=:=X2)) --> true |
    &type     = relop,
    &instr    = equal(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2].
builtin((X1=\=X2)) --> true |
    &type     = relop,
    &instr    = not_equal(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2].
builtin((X1<X2)) --> true |
    &type     = relop,
    &instr    = less(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2].
builtin((X1>=X2)) --> true |
    &type     = relop,
    &instr    = not_less(Y1,Y2),
    &inarg  <<= [X1,Y1,X2,Y2].
builtin((X1>X2)) --> true |
    &type     = relop,
    &instr    = less(Y2,Y1),
    &inarg  <<= [X1,Y1,X2,Y2].
builtin((X1=<X2)) --> true |
    &type     = relop,
    &instr    = not_less(Y2,Y1),
    &inarg  <<= [X1,Y1,X2,Y2].

builtin(wait(X1)) --> true |
    &type     = int_or_wait,
    &instr    = wait(Y1),
    &inarg  <<= [X1,Y1].
builtin(integer(X1)) --> true |
    &type     = int_or_wait,
    &instr    = integer(Y1),
    &inarg  <<= [X1,Y1].
builtin(atom(X1)) --> true |
    &type     = builtin,
    &instr    = atom(Y1),
    &inarg  <<= [X1,Y1].
builtin(vector(X1,X2)) --> true |
    &type     = builtin,
    &instr    = vector(Y1,Y2),
    &inarg  <<= [X1,Y1],
    &outarg <<= [X2,Y2],
    &preins <<= [wait(X1)].
builtin(string(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = string(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1],
    &outarg <<= [X2,Y2,X3,Y3],
    &preins <<= [wait(X1)].


:- local_implicit instr:shared, inarg:stream, outarg:stream,
		  type:shared.

active_builtin(add(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = b_add(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3].
active_builtin(subtract(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = b_subtract(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3].
active_builtin(multiply(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = b_multiply(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3].
active_builtin(divide(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = b_divide(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3].
active_builtin(modulo(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = b_modulo(Y1,Y2,Y3),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3].

active_builtin(new_vector(X1,X2)) --> true |
    &type     = builtin,
    &instr    = new_vector(Y1,Y2),
    &inarg  <<= [X2,Y2],
    &outarg <<= [X1,Y1].
active_builtin(set_vector_element(X1,X2,X3,X4,X5)) --> true |
    &type     = builtin,
    &instr    = set_vector_element(Y1,Y2,Y3,Y4,Y5),
    &inarg  <<= [X1,Y1,X2,Y2,X4,Y4],
    &outarg <<= [X3,Y3,X5,Y5].
active_builtin(new_string(X1,X2,X3)) --> true |
    &type     = builtin,
    &instr    = new_string(Y1,Y2,Y3),
    &inarg  <<= [X2,Y2,X3,Y3],
    &outarg <<= [X1,Y1].
active_builtin(string_element(X1,X2,X3,X4)) --> true |
    &type     = builtin,
    &instr    = get_string_element(Y1,Y2,Y3,Y4),
    &inarg  <<= [X1,Y1,X2,Y2],
    &outarg <<= [X3,Y3,X4,Y4].
active_builtin(set_string_element(X1,X2,X3,X4)) --> true |
    &type     = builtin,
    &instr    = set_string_element(Y1,Y2,Y3,Y4),
    &inarg  <<= [X1,Y1,X2,Y2,X3,Y3],
    &outarg <<= [X4,Y4].

otherwise.
active_builtin(X) --> true |
    &type     = none,
    &instr    = X.


:- local_implicit instr:shared, inarg:stream, outarg:shared.

expression(X1+X2) --> true |
    &instr   = add(Y1,Y2,Y3),
    &inarg <<= [X1,Y1,X2,Y2],
    &outarg  = Y3.
expression(X1-X2) --> true |
    &instr   = subtract(Y1,Y2,Y3),
    &inarg <<= [X1,Y1,X2,Y2],
    &outarg  = Y3.
expression(X1*X2) --> true |
    &instr   = multiply(Y1,Y2,Y3),
    &inarg <<= [X1,Y1,X2,Y2],
    &outarg  = Y3.
expression(X1/X2) --> true |
    &instr   = divide(Y1,Y2,Y3),
    &inarg <<= [X1,Y1,X2,Y2],
    &outarg  = Y3.
expression(X1 mod X2) --> true |
    &instr   = modulo(Y1,Y2,Y3),
    &inarg <<= [X1,Y1,X2,Y2],
    &outarg  = Y3.
expression(-X1) --> true |
    &instr   = subtract(Y1,Y2,Y3),
    &inarg <<= [0,Y1,X1,Y2],
    &outarg  = Y3.

%%%% TrueTrue %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% truetrue:- true | true.
pr1(KL1):- true | KL1=[(truetrue:- true ; true):0].

%%%% Append %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% append([A|X],Y,Z):- true | Z=[A|W], append(X,Y,W).
% append([],   Y,Z):- true | Z=Y.
pr2(KL1):- true | KL1=[
  ( append(['$VAR'(0)|'$VAR'(1)],'$VAR'(2),'$VAR'(3)):- true ;
	'$VAR'(3)=['$VAR'(0)|'$VAR'(4)],
	append('$VAR'(1),'$VAR'(2),'$VAR'(4)) ):5,
  ( append([],'$VAR'(0),'$VAR'(1)):- true ;
	'$VAR'(1)='$VAR'(0) ):2].

%%%% Primes %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% primes(N,PL):- true | gen(2,N,NL), shift(NL,PL).
% gen(N,Max,S):- N=<Max | S=[N|S1], M:=N+1, gen(M,Max,S1).
% gen(N,Max,S):- N >Max | S=[].
% shift([P|L],S):- true | S=[P|S1], filter(P,L,K), shift(K,S1).
% shift([],   S):- true | S=[].
% filter(P,[Q|L],K):- Q mod P=:=0 |           filter(P,L,K).
% filter(P,[Q|L],K):- Q mod P=\=0 | K=[Q|K1], filter(P,L,K1).
% filter(P,[],   K):- true        | K=[].
pr3(KL1):- true | KL1=[
  ( primes('$VAR'(0),'$VAR'(1)):- true ;
	gen(2,'$VAR'(0),'$VAR'(2)), shift('$VAR'(2),'$VAR'(1)) ):3,
  ( gen('$VAR'(0),'$VAR'(1),'$VAR'(2)):- '$VAR'(0)=<'$VAR'(1) ;
	'$VAR'(2)=['$VAR'(0)|'$VAR'(3)], '$VAR'(4):='$VAR'(0)+1,
	gen('$VAR'(4),'$VAR'(1),'$VAR'(3)) ):5,
  ( gen('$VAR'(0),'$VAR'(1),'$VAR'(2)):- '$VAR'(0)>'$VAR'(1) ;
	'$VAR'(2)=[] ):3,
  ( shift(['$VAR'(0)|'$VAR'(1)],'$VAR'(2)):- true ;
	'$VAR'(2)=['$VAR'(0)|'$VAR'(3)],
	filter('$VAR'(0),'$VAR'(1),'$VAR'(4)),
	shift('$VAR'(4),'$VAR'(4)) ):5,
  ( shift([],'$VAR'(0)):- true ; '$VAR'(0)=[] ):1,
  ( filter('$VAR'(0),['$VAR'(1)|'$VAR'(2)],'$VAR'(3)):-
      '$VAR'(1) mod '$VAR'(0) =:= 0 ;
	filter('$VAR'(0),'$VAR'(2),'$VAR'(3)) ):4,
  ( filter('$VAR'(0),['$VAR'(1)|'$VAR'(2)],'$VAR'(3)):-
      '$VAR'(1) mod '$VAR'(0) =\= 0 ;
	'$VAR'(3)=['$VAR'(1)|'$VAR'(4)],
	filter('$VAR'(0),'$VAR'(2),'$VAR'(4)) ):5,
  ( filter('$VAR'(0),[],'$VAR'(1)):- true ;
	'$VAR'(1)=[] ):2].


%%%% Expand %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
% expand((A:=B),T,VN0,VN):- true |
%     expand_exp(B,O,unify(A,O),T,VN0,VN).
% expand((A=B),T,VN0,VN):- true | 
%     T=unify(A,B), VN=VN0.
% expand((A,B),T,VN0,VN):- true |
%     T=(TA,TB), expand(A,TA,VN0,VN1), expand(B,TB,VN1,VN).
% otherwise.
% expand(X,T,VN0,VN):- true | T=X, VN=VN0.
% 
% expand_exp(A+B,O,T0,T,VN0,VN):- true |
%     expand_exp(add,O,T0,T,VN0,VN,A,B).
% expand_exp(A-B,O,T0,T,VN0,VN):- true |
%     expand_exp(subtract,O,T0,T,VN0,VN,A,B).
% expand_exp(A*B,O,T0,T,VN0,VN):- true |
%     expand_exp(multiply,O,T0,T,VN0,VN,A,B).
% expand_exp(A/B,O,T0,T,VN0,VN):- true |
%     expand_exp(divide,O,T0,T,VN0,VN,A,B).
% otherwise.
% expand_exp(X,O,T0,T,VN0,VN):- true | O=X, T=T0, VN=VN0.
% 
% expand_exp(F,O,T0,T,VN0,VN,A,B):- true |
%     expand_exp(A,OA,T0,T1,VN0,VN1),
%     expand_exp(B,OB,T1,T2,VN1,VN2),
%     expand_exp_wai(F,O,T2,T,VN2,VN,OA,OB).
% 
% expand_exp_wai(add,     O,T0,T,N0,N,OA,OB):- X:=OA+OB | O=X, T=T0, N=N0.
% expand_exp_wai(subtract,O,T0,T,N0,N,OA,OB):- X:=OA-OB | O=X, T=T0, N=N0.
% expand_exp_wai(multiply,O,T0,T,N0,N,OA,OB):- X:=OA*OB | O=X, T=T0, N=N0.
% expand_exp_wai(divide,  O,T0,T,N0,N,OA,OB):- X:=OA/OB | O=X, T=T0, N=N0.
% otherwise.
% expand_exp_wai(F,O,T0,T,VN0,VN,OA,OB):- true |
%     T=(T0,{F,OA,OB,O}), O='$VAR'(VN0,[]), VN:=VN0+1.
pr4(KL1):- true | KL1=[
  ( expand('$VAR'(0):='$VAR'(1),'$VAR'(2),'$VAR'(3),'$VAR'(4)):- true ;
	expand_exp('$VAR'(1),'$VAR'(5),
	    unify('$VAR'(0),'$VAR'(5)),'$VAR'(2),'$VAR'(3),'$VAR'(4)) ):6,
  ( expand('$VAR'(0)='$VAR'(1),'$VAR'(2),'$VAR'(3),'$VAR'(4)):- true ;
	'$VAR'(2)=unify('$VAR'(0),'$VAR'(1)),
	'$VAR'(4)='$VAR'(3) ):5,
  ( expand(('$VAR'(0),'$VAR'(1)),'$VAR'(2),'$VAR'(3),'$VAR'(4)):- true ;
	'$VAR'(2)=('$VAR'(5),'$VAR'(6)),
	expand('$VAR'(0),'$VAR'(5),'$VAR'(3),'$VAR'(7)),
	expand('$VAR'(1),'$VAR'(6),'$VAR'(7),'$VAR'(4)) ):8,
  ( otherwise ):0,
  ( expand('$VAR'(0),'$VAR'(1),'$VAR'(2),'$VAR'(3)):- true ;
	'$VAR'(1)='$VAR'(0),
	'$VAR'(3)='$VAR'(2) ):4,
  ( expand_exp('$VAR'(0)+'$VAR'(1),'$VAR'(2),
	       '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):- true ;
	expand_exp(add,'$VAR'(2),'$VAR'(3),'$VAR'(4),
		   '$VAR'(5),'$VAR'(6),'$VAR'(0),'$VAR'(1)) ):7,
  ( expand_exp('$VAR'(0)-'$VAR'(1),'$VAR'(2),
	       '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):- true ;
	expand_exp(subtract,'$VAR'(2),'$VAR'(3),'$VAR'(4),
		   '$VAR'(5),'$VAR'(6),'$VAR'(0),'$VAR'(1)) ):7,
  ( expand_exp('$VAR'(0)*'$VAR'(1),'$VAR'(2),
	       '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):- true ;
	expand_exp(multiply,'$VAR'(2),'$VAR'(3),'$VAR'(4),
		   '$VAR'(5),'$VAR'(6),'$VAR'(0),'$VAR'(1)) ):7,
  ( expand_exp('$VAR'(0)/'$VAR'(1),'$VAR'(2),
	       '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):- true ;
	expand_exp(divide,'$VAR'(2),'$VAR'(3),'$VAR'(4),
		   '$VAR'(5),'$VAR'(6),'$VAR'(0),'$VAR'(1)) ):7,
  ( otherwise ):0,
  ( expand_exp('$VAR'(0),'$VAR'(1),
	       '$VAR'(2),'$VAR'(3),'$VAR'(4),'$VAR'(5)):- true ;
	'$VAR'(1)='$VAR'(0),
	'$VAR'(3)='$VAR'(2),
	'$VAR'(5)='$VAR'(4) ):6,
  ( expand_exp('$VAR'(0),'$VAR'(1),'$VAR'(2),'$VAR'(3),
	       '$VAR'(4),'$VAR'(5),'$VAR'(6),'$VAR'(7)):- true ;
	expand_exp('$VAR'(6),'$VAR'(8),
		   '$VAR'(2),'$VAR'(9),'$VAR'(4),'$VAR'(10)),
	expand_exp('$VAR'(7),'$VAR'(11),
		   '$VAR'(9),'$VAR'(12),'$VAR'(10),'$VAR'(13)),
	expand_exp_wai('$VAR'(0),'$VAR'(1),'$VAR'(12),'$VAR'(3),
		       '$VAR'(13),'$VAR'(5),'$VAR'(8),'$VAR'(11)) ):14,
  ( expand_exp_wai(add,'$VAR'(0),'$VAR'(1),'$VAR'(2),
		   '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):-
      '$VAR'(7):='$VAR'(5)+'$VAR'(6) ;
	'$VAR'(0)='$VAR'(7),
	'$VAR'(2)='$VAR'(1),
	'$VAR'(4)='$VAR'(3) ):8,
  ( expand_exp_wai(subtract,'$VAR'(0),'$VAR'(1),'$VAR'(2),
		   '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):-
      '$VAR'(7):='$VAR'(5)-'$VAR'(6) ;
	'$VAR'(0)='$VAR'(7),
	'$VAR'(2)='$VAR'(1),
	'$VAR'(4)='$VAR'(3) ):8,
  ( expand_exp_wai(multiply,'$VAR'(0),'$VAR'(1),'$VAR'(2),
		   '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):-
      '$VAR'(7):='$VAR'(5)*'$VAR'(6) ;
	'$VAR'(0)='$VAR'(7),
	'$VAR'(2)='$VAR'(1),
	'$VAR'(4)='$VAR'(3) ):8,
  ( expand_exp_wai(divide,'$VAR'(0),'$VAR'(1),'$VAR'(2),
		   '$VAR'(3),'$VAR'(4),'$VAR'(5),'$VAR'(6)):-
      '$VAR'(7):='$VAR'(5)/'$VAR'(6) ;
	'$VAR'(0)='$VAR'(7),
	'$VAR'(2)='$VAR'(1),
	'$VAR'(4)='$VAR'(3) ):8,
  ( otherwise ):0,
  ( expand_exp_wai('$VAR'(0),'$VAR'(1),'$VAR'(2),'$VAR'(3),
		   '$VAR'(4),'$VAR'(5),'$VAR'(6),'$VAR'(7)):- true ;
	'$VAR'(3)= ('$VAR'(2),{'$VAR'(0),'$VAR'(6),'$VAR'(7),'$VAR'(1)}),
	'$VAR'(1)='$VAR'('$VAR'(4),[]),
	'$VAR'(5):='$VAR'(4)+1 ):8].
