'smove/3#35'(A,BB,N,O) :- true | N=O.

'smove/3#36'(A,b(B,C,D,0,1,1,E,F,G,H,I,J,K,L,M),N,O) :- true |
   'cont$smove/3'(A,36,b(B,C,D,1,0,0,E,F,G,H,I,J,K,L,M),N,O).
otherwise.
'smove/3#36'(A,BB,N,O) :- true | N=O.

'cont$smove/3'('L2'(A,B),C,D,E,F) :- G := B+1 |
   'sweeper$playS'('L3'(A,C),G,D,E,F).


