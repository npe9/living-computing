   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_floor(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_floor(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_sqrt(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_sqrt(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_ln(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_ln(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_log(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_log(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_exp(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_exp(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_pow(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_pow(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_sin(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_sin(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_cos(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_cos(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_tan(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_tan(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
