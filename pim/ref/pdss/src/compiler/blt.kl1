   Y= floating_point_cosh(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_tanh(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_tanh(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.

builtin(floating_point_to_integer(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_to_integer(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[integer(X2)], Type=builtin.
builtin(integer_to_floating_point(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= integer_to_floating_point(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[float(X2)], Type=builtin.

%% Special
builtin(nop,Y,In,Out,Pre,Post,Type) :- true |
   Y= nop, In=[], Out=[], Pre=[], Post=[], Type=builtin.
builtin(halt(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= halt(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(request_gc(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= request_gc(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(statistics(X1,X2,X3,X4,X5,X6),Y,In,Out,Pre,Post,Type) :- true |
   Y= statistics(Y1,Y2,Y3,Y4,Y5,Y6), In=[],
   Out=[X1,Y1,X2,Y2,X3,Y3,X4,Y4,X5,Y5,X6,Y6], Pre=[],
   Post=[integer(X1),integer(X2),integer(X3),
	 integer(X4),integer(X5),integer(X6)], Type=builtin.
