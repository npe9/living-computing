builtin(floating_point_atan(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_atan(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_atan(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
