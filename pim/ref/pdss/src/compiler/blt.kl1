:- module kl1cmp_blttbl.
:- public builtin/7, active_builtin/5, expression/6, float_expression/6.

%%%%%%%%%%%%%%%%%%%%%%%%%  Builtin predicates (passive)  %%%%%%%%%%%%%%%%%%%%%%

% These are all defined builtin predicates for the passive part
% with the exception of 'true', ':=' and '='.

%:- mode builtin(+, -, -, -, -, -, -).
% Type check.
builtin(wait(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= wait(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=type_or_wait. %%!?
builtin(atom(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= atom(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(integer(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= integer(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=type_or_wait. %%!?
builtin(float(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= float(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=type_or_wait. %%!?
builtin(list(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= list(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(vector(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= vector(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(string(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= string(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.

%% Compare.
builtin(diff(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= diff(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=builtin.
% Synonym for previous:
builtin((X1\=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= diff(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=builtin.

builtin(equal(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[integer(X1), integer(X2)], Post=[], Type=builtin.
builtin(not_equal(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= not_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[integer(X1), integer(X2)], Post=[], Type=builtin.
builtin(less_than(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[integer(X1), integer(X2)], Post=[], Type=builtin.
builtin(not_less_than(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= not_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[integer(X1), integer(X2)], Post=[], Type=builtin.

builtin((X1=:=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.
builtin((X1=\=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= not_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.
builtin((X1<X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.
builtin((X1>=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= not_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.
builtin((X1>X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= less_than(Y2,Y1), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.
builtin((X1=<X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= not_less_than(Y2,Y1), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=relop.

%% Arithmetic operation.
builtin(add(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= add(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(subtract(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= subtract(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(multiply(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= multiply(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(divide(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= divide(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(modulo(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= modulo(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(minus(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= minus(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[integer(X2)], Type=builtin.
builtin(increment(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= increment(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[integer(X2)], Type=builtin.
builtin(decrement(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= decrement(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[integer(X2)], Type=builtin.
builtin(abs(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= abs(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[integer(X2)], Type=builtin.
builtin(min(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= min(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(max(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= max(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(and(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= and(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(or(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= or(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(exclusive_or(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= exclusive_or(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(complement(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= complement(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[integer(X1)], Post=[integer(X2)], Type=builtin.
builtin(shift_left(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= shift_left(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.
builtin(shift_right(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= shift_right(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[integer(X1), integer(X2)], Post=[integer(X3)], Type=builtin.

% Arithmetic relation operators.
builtin(vector(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= vector(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[vector(X1)], Post=[integer(X2)], Type=builtin.
builtin(vector_element(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= vector_element(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[vector(X1), integer(X2)], Post=[], Type=builtin.
builtin(string(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= string(Y1,Y2,Y3), In=[X1,Y1], Out=[X2,Y2,X3,Y3],
   Pre=[string(X1)], Post=[integer(X2),integer(X3)], Type=builtin.
builtin(string_element(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= string_element(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[string(X1), integer(X2)], Post=[integer(X3)], Type=builtin.

builtin(put_console(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= put_console(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(display_console(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= display_console(Y1), In=[X1,Y1], Out=[], Pre=[], Post=[], Type=builtin.
builtin(read_console(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= read_console(Y1), In=[], Out=[X1,Y1], Pre=[], Post=[], Type=builtin.

%% Compare (float).
builtin(floating_point_equal(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[float(X1), float(X2)], Post=[], Type=builtin.
builtin(floating_point_not_equal(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_not_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[float(X1), float(X2)], Post=[], Type=builtin.
builtin(floating_point_less_than(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[float(X1), float(X2)], Post=[], Type=builtin.
builtin(floating_point_not_less_than(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_not_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[float(X1), float(X2)], Post=[], Type=builtin.

builtin((X1$=:=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.
builtin((X1$=\=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_not_equal(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.
builtin((X1$<X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.
builtin((X1$>=X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_not_less_than(Y1,Y2), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.
builtin((X1$>X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_less_than(Y2,Y1), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.
builtin((X1$=<X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_not_less_than(Y2,Y1), In=[X1,Y1,X2,Y2], Out=[],
   Pre=[], Post=[], Type=float_relop.

%% Arithmetic operation (float).
builtin(floating_point_add(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_add(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_subtract(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_subtract(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_multiply(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_multiply(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_divide(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_divide(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_minus(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_minus(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_abs(X1,X2),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_abs(Y1,Y2), In=[X1,Y1], Out=[X2,Y2],
   Pre=[float(X1)], Post=[float(X2)], Type=builtin.
builtin(floating_point_min(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= floating_point_min(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=[X3,Y3],
   Pre=[float(X1), float(X2)], Post=[float(X3)], Type=builtin.
builtin(floating_point_max(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
