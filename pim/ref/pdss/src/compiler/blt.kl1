otherwise.
active_builtin(X,Y,In,Out,Type) :- true |
   Y=true, In=[], Out=[], Type=none.


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%  Expressions  %%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%

% These are the valid expressions in ':=' and arithmetic relations.
:- local_implicit io:oldnew.
%:- mode expression(+, -, -, -, -, ?).
expression(X1+X2,Y,In,Out) --> true |
    (X1 =:=  1 -> {{ Y= increment(Y1,Y2), In=[X2,Y1], Out=Y2 }};
     X1 =:= -1 -> {{ Y= decrement(Y1,Y2), In=[X2,Y1], Out=Y2 }};
     X2 =:=  1 -> {{ Y= increment(Y1,Y2), In=[X1,Y1], Out=Y2 }};
     X2 =:= -1 -> {{ Y= decrement(Y1,Y2), In=[X1,Y1], Out=Y2 }};
     otherwise;
     true      -> {{ Y= add(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }} ).
expression(X1-X2,Y,In,Out) --> true |
    (X2 =:=  1 -> {{ Y= decrement(Y1,Y2), In=[X1,Y1], Out=Y2 }};
     X2 =:= -1 -> {{ Y= increment(Y1,Y2), In=[X1,Y1], Out=Y2 }};
     otherwise;
     true      -> {{ Y= subtract(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }} ).
expression(X1*X2,Y,In,Out) --> true |
 {{ Y= multiply(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1/X2,Y,In,Out) --> true |
 {{ Y= divide(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1 mod X2,Y,In,Out) --> true |
 {{ Y= modulo(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(-X1,Y,In,Out) --> true |
 {{ Y= minus(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
expression(abs(X1),Y,In,Out) --> true |
 {{ Y= abs(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
expression(min(X1,X2),Y,In,Out) --> true |
 {{ Y= min(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(max(X1,X2),Y,In,Out) --> true |
 {{ Y= max(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1/\X2,Y,In,Out) --> true |
 {{ Y= and(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1\/X2,Y,In,Out) --> true |
 {{ Y= or(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1 xor X2,Y,In,Out) --> true |			% 881227
 {{ Y= exclusive_or(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.	% SSL:Nishizaki
expression(\(X1),Y,In,Out) --> true |				% 890605
 {{ Y= complement(Y1,Y2), In=[X1,Y1], Out=Y2 }}.		% SSL:Nishizaki
expression(X1 << X2,Y,In,Out) --> true |
 {{ Y= shift_left(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(X1 >> X2,Y,In,Out) --> true |
 {{ Y= shift_right(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
expression(int(X1),Y,In,Out) --> true |
 {{ Y= floating_point_to_integer(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
otherwise.
expression(X,Y,In,Out) --> true |
 {{ Y=true, In=[], Out=_ }},
  &io<<=[error_message(string#"Undefined expression, replaced by VOID.",[X])].

%%%%%%%%%%%%%%%%%%%%%%%%  Floating Point Expressions  %%%%%%%%%%%%%%%%%%%%%%%%%

% These are the valid expressions in '$:=' and arithmetic relations.
:- local_implicit io:oldnew.
%:- mode float_expression(+, -, -, -, -, ?).
float_expression(X1+X2,Y,In,Out) --> true |
 {{ Y= floating_point_add(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(X1-X2,Y,In,Out) --> true |
 {{ Y= floating_point_subtract(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(X1*X2,Y,In,Out) --> true |
 {{ Y= floating_point_multiply(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(X1/X2,Y,In,Out) --> true |
 {{ Y= floating_point_divide(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(-X1,Y,In,Out) --> true |
 {{ Y= floating_point_minus(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(abs(X1),Y,In,Out) --> true |
 {{ Y= floating_point_abs(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(min(X1,X2),Y,In,Out) --> true |
 {{ Y= floating_point_min(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(max(X1,X2),Y,In,Out) --> true |
 {{ Y= floating_point_max(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(floor(X1),Y,In,Out) --> true |
 {{ Y= floating_point_floor(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(sqrt(X1),Y,In,Out) --> true |
 {{ Y= floating_point_sqrt(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(ln(X1),Y,In,Out) --> true |
 {{ Y= floating_point_ln(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(log(X1),Y,In,Out) --> true |
 {{ Y= floating_point_log(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(exp(X1),Y,In,Out) --> true |
 {{ Y= floating_point_exp(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression((X1**X2),Y,In,Out) --> true |
 {{ Y= floating_point_pow(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(sin(X1),Y,In,Out) --> true |
 {{ Y= floating_point_sin(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(cos(X1),Y,In,Out) --> true |
 {{ Y= floating_point_cos(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(tan(X1),Y,In,Out) --> true |
 {{ Y= floating_point_tan(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(asin(X1),Y,In,Out) --> true |
 {{ Y= floating_point_asin(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(acos(X1),Y,In,Out) --> true |
 {{ Y= floating_point_acos(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(atan(X1/X2),Y,In,Out) --> true |
 {{ Y= floating_point_atan(Y1,Y2,Y3), In=[X1,Y1,X2,Y2], Out=Y3 }}.
float_expression(sinh(X1),Y,In,Out) --> true |
 {{ Y= floating_point_sinh(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(cosh(X1),Y,In,Out) --> true |
 {{ Y= floating_point_cosh(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(tanh(X1),Y,In,Out) --> true |
 {{ Y= floating_point_tanh(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
float_expression(float(X1),Y,In,Out) --> true |
 {{ Y= integer_to_floating_point(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
otherwise.
float_expression(atan(X1),Y,In,Out) --> true |
 {{ Y= floating_point_atan(Y1,Y2), In=[X1,Y1], Out=Y2 }}.
otherwise.
float_expression(X,Y,In,Out) --> true |
 {{ Y=true, In=[], Out=_ }},
  &io<<=[error_message(
         string#"Undefined floating point expression, replaced by VOID.",[X])].
