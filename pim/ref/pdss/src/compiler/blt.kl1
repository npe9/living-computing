   Y= set_scheduling_switch(Y1), In=[X1,Y1], Out=[],
   Pre=[], Post=[], Type=builtin.
builtin(set_trace_switch(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= set_trace_switch(Y1), In=[X1,Y1], Out=[],
   Pre=[], Post=[], Type=builtin.
builtin(set_backtrace_switch(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= set_backtrace_switch(Y1), In=[X1,Y1], Out=[],
   Pre=[],Post=[], Type=builtin.
builtin(device_dup_check(X1),Y,In,Out,Pre,Post,Type) :- true |
   Y= device_dup_check(Y1), In=[X1,Y1], Out=[], Pre=[],
   Post=[], Type=builtin.

%% Firm Test
builtin(tag_and_value(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= tag_and_value(Y1,Y2,Y3), In=[X1,Y1], Out=[X2,Y2,X3,Y3],
   Pre=[], Post=[integer(X2),integer(X3)], Type=builtin.
builtin(register_tag_and_value(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= tag_and_value(Y1,Y2,Y3), In=[X1,Y1], Out=[X2,Y2,X3,Y3],
   Pre=[], Post=[integer(X2),integer(X3)], Type=builtin.
builtin(word(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= word(Y1,Y2,Y3), In=[X1,Y1], Out=[X2,Y2,X3,Y3],
   Pre=[], Post=[integer(X2),integer(X3)], Type=builtin.
builtin(set_tag_and_value(X1,X2,X3),Y,In,Out,Pre,Post,Type) :- true |
   Y= set_tag_and_value(Y1,Y2,Y3), In=[X2,Y2,X3,Y3], Out=[X1,Y1],
   Pre=[integer(X2),integer(X3)], Post=[], Type=builtin.

otherwise.
builtin(X,Y,In,Out,Pre,Post,Type) :- true | % prolog(nonvar(X)) |
   Y=X, In=[], Out=[], Pre=[], Post=[], Type=none.


%%%%%%%%%%%%%%%%%%%%%%%%%  Builtin predicates (active)  %%%%%%%%%%%%%%%%%%%%%%%

% These are all the builtin predicates for the active part with the exception
% of 'true', '=' and ':='.

%:- mode active_builtin(+, -, -, -, -).
