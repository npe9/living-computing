tbl(vector_element(X1,X2,X3)) --> true | &code<<=[g_vector_element(X1,X2,X3)].
tbl(string(X1,X2,X3)) --> true | &code<<=[g_string(X1,X2,X3)].
tbl(string_element(X1,X2,X3)) --> true | &code<<=[g_string_element(X1,X2,X3)].
