	&code<<=[g_set_tag_and_value(X1,X2,X3)].
otherwise.
tbl(Instr) --> true | &code<<=[Instr].


set_vector_element(Tabs0, Tabs, Idx, Ele) :- true |
   set_vector_element(Tabs0, Idx, _, Ele, Tabs).

ref_vector_element(Tabs0, Tabs, Idx, Ele) :- true |
   set_vector_element(Tabs0, Idx, Ele, Ele, Tabs).

:- local_implicit out:oldnew.
output_const_code(Msgs) --> true |
  &out <<= [nl, flush(_)],
  output_const_code_(Msgs).

output_const_code_(['$SCNST'(Label)|Rest]) --> string(Label, N, _) |
%  make_atom(Label, AtomLabel),
  &out <<= [putc(c#"'")],
  write_string(0, N, Label),
  &out <<= [putc(c#"'"), putt(':'), nl],
  output_const_code_(Rest).
otherwise.
output_const_code_([One|Rest]) --> vector(One, N) |
{{set_vector_element(One, 0, Func, [], One1)}},
  &out <<= [putc(9), putt(Func), putc(9)],
{{N1 := N-1}},
  output_const_arg(1, N1, One1),
  output_const_code_(Rest).
output_const_code_([]) --> true | true.

write_string(A, N, Str) --> A<N, string_element(Str, A, C) |
  &out <<= [putc(C)],
   write_string(~(A+1), N, Str).
write_string(N, N, _) --> true | true.

output_const_arg(A, N, Instr0) --> A<N |
 {{set_vector_element(Instr0, A, Arg, [], Instr1)}},
   output_one_arg(Arg),
   &out <<= [putt(',')],
 {{A1 := A+1}},
   output_const_arg(A1, N, Instr1).
output_const_arg(N, N, Instr0) --> true |
 {{set_vector_element(Instr0, N, Arg, [], _)}},
   output_one_arg(Arg),
   &out <<= [nl].

output_one_arg('$SCNST'(Label)) --> string(Label, N, _) |
%   make_atom(Label, AtomLabel),
%   &out <<= [puttq(AtomLabel)].
   &out <<= [putc(c#"'")],
   write_string(0, N, Label),
   &out <<= [putc(c#"'")].
otherwise.
output_one_arg(Arg) --> true |
   &out <<= [puttq(Arg)].

%%%%%  Optimize KLB Code  %%%%%
:- local_implicit code:stream.
optimize([]) --> true | true.

optimize([list(R),read_car(R,H),read_cdr(R,T)|X]) --> true |
	&code<<=[wait_list_var_var(R,H,T)],
	optimize(X).

optimize([put_vector(R,N),write_element_atom(R,0,A)|X]) --> true |
	&code<<=[put_func(R,N,A)],
	optimize(X).

optimize([put_list(R),write_car_value(R,H),write_cdr_value(R,T)|X]) --> true |
	&code<<=[put_list_val_val(R,H,T)],
	optimize(X).

optimize([put_list(R),write_car_value(R,H),write_cdr_variable(R,T)|X]) -->
    true |
    ( X = [get_list_value(U,R)|XX] ->
	&code<<=[get_list_val_var(U,R,H,T)],
	optimize(XX);
      otherwise;
      true ->
	&code<<=[put_list_val_var(R,H,T)],
	optimize(X) ).

optimize([read_element(V,I0,R0),read_element(V,I,R)|X]) -->
    I =:= I0+1, R := R0+1 |
	optimize([read_elements_inc(V,I0,R0,2)|X]).
optimize([read_element(V,I0,R0),read_element(V,I,R)|X]) -->
    I =:= I0+1, R := R0-1  |
	optimize([read_elements_dec(V,I0,R0,2)|X]).
optimize([read_elements_inc(V,I0,R0,N),read_element(V,I,R)|X]) -->
    I =:= I0+N, R := R0+N |
	NN := N+1,
	optimize([read_elements_inc(V,I0,R0,NN)|X]).
optimize([read_elements_dec(V,I0,R0,N),read_element(V,I,R)|X]) -->
    I =:= I0+N, R := R0-N |
	NN := N+1,
	optimize([read_elements_dec(V,I0,R0,NN)|X]).

optimize([write_element_value(V,I0,R0),write_element_value(V,I,R)|X]) -->
    I =:= I0+1, R := R0+1 |
	optimize([write_elements_inc(V,I0,R0,2)|X]).
optimize([write_element_value(V,I0,R0),write_element_value(V,I,R)|X]) -->
    I =:= I0+1, R := R0-1 |
	optimize([write_elements_dec(V,I0,R0,2)|X]).
optimize([write_elements_inc(V,I0,R0,N),write_element_value(V,I,R)|X]) -->
    I =:= I0+N, R :=R0+N |
	NN := N+1,
	optimize([write_elements_inc(V,I0,R0,NN)|X]).
optimize([write_elements_dec(V,I0,R0,N),write_element_value(V,I,R)|X]) -->
    I =:= I0+N, R := R0-N |
	NN := N+1,
	optimize([write_elements_dec(V,I0,R0,NN)|X]).

optimize([put_value(D0,R0),put_value(D,R)|X]) -->
    D =:= D0+1, R := R0+1 |
	optimize([put_values_inc(D0,R0,2)|X]).
optimize([put_value(D0,R0),put_value(D,R)|X]) -->
    D =:= D0+1, R := R0-1 |
	optimize([put_values_dec(D0,R0,2)|X]).
optimize([put_values_inc(D0,R0,N),put_value(D,R)|X]) -->
    D =:= D0+N, R := R0+N |
	NN := N+1,
	optimize([put_values_inc(D0,R0,NN)|X]).
optimize([put_values_dec(D0,R0,N),put_value(D,R)|X]) -->
    D =:= D0+N, R := R0-N |
	NN := N+1,
	optimize([put_values_dec(D0,R0,NN)|X]).

optimize([set_value(A0,R0),set_value(A,R)|X]) -->
    A =:= A0+1, R := R0+1 |
	optimize([set_values_inc(A0,R0,2)|X]).
optimize([set_value(A0,R0),set_value(A,R)|X]) -->
    A =:= A0+1, R := R0-1 |
	optimize([set_values_dec(A0,R0,2)|X]).
optimize([set_values_inc(A0,R0,N),set_value(A,R)|X]) -->
    A =:= A0+N, R := R0+N |
	NN := N+1,
	optimize([set_values_inc(A0,R0,NN)|X]).
optimize([set_values_dec(A0,R0,N),set_value(A,R)|X]) -->
    A =:= A0+N, R := R0-N |
	NN := N+1,
	optimize([set_values_dec(A0,R0,NN)|X]).
otherwise.
optimize([Instr|X]) --> true |
	&code<<=[Instr],
	optimize(X).
