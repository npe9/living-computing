is_command(min(_,_,_),                    X):- true | X=yes.
is_command(max(_,_,_),                    X):- true | X=yes.
is_command(unbound(_,_,_,_),              X):- true | X=yes.
is_command(unbound(_,_),                  X):- true | X=yes.
is_command(hash(_,_,_),                   X):- true | X=yes.
is_command(vector(_,_,_),                 X):- true | X=yes.
