is_command(vector_element(_,_,_,_),       X):- true | X=yes.
is_command(set_vector_element(_,_,_,_,_), X):- true | X=yes.
is_command(string(_,_,_,_),               X):- true | X=yes.
is_command(new_string(_,_,_),             X):- true | X=yes.
is_command(string_element(_,_,_,_),       X):- true | X=yes.
is_command(set_string_element(_,_,_,_),   X):- true | X=yes.
is_command(substring(_,_,_,_,_),          X):- true | X=yes.
is_command(set_substring(_,_,_,_),        X):- true | X=yes.
is_command(append_string(_,_,_),          X):- true | X=yes.
is_command(string_and(_,_,_,_),           X):- true | X=yes.
is_command(string_or(_,_,_,_),            X):- true | X=yes.
is_command(string_exclusive_or(_,_,_,_),  X):- true | X=yes.
is_command(string_complement(_,_),        X):- true | X=yes.
is_command(intern_atom(_,_),              X):- true | X=yes.
is_command(atom_name(_,_),                X):- true | X=yes.
is_command(atom_number(_,_),              X):- true | X=yes.
is_command(new_atom(_),                   X):- true | X=yes.
is_command(predicate_to_code(_,_,_,_),    X):- true | X=yes.
is_command(code_to_predicate(_,_,_,_,_),  X):- true | X=yes.
is_command(apply(_,ArgV),                 X):- vector(ArgV) | X=yes.
is_command(merge(_,_),                    X):- true | X=yes.
is_command(raise(_,_,_),	          X):- true | X=yes.
is_command(consume_resource(_),	          X):- true | X=yes.
is_command(current_processor(_,_,_),	  X):- true | X=yes.
is_command(current_node(_,_),		  X):- true | X=yes.
is_command(current_priority(_,_,_),	  X):- true | X=yes.
is_command(floating_point_add(_,_,_),     X):- true | X=yes.
is_command(floating_point_subtract(_,_,_),X):- true | X=yes.
is_command(floating_point_multiply(_,_,_),X):- true | X=yes.
is_command(floating_point_divide(_,_,_),  X):- true | X=yes.
is_command(floating_point_minus(_,_),     X):- true | X=yes.
is_command(floating_point_abs(_,_),       X):- true | X=yes.
is_command(floating_point_min(_,_,_),     X):- true | X=yes.
is_command(floating_point_max(_,_,_),     X):- true | X=yes.
is_command(floating_point_floor(_,_),     X):- true | X=yes.
is_command(floating_point_sqrt(_,_),      X):- true | X=yes.
is_command(floating_point_ln(_,_),        X):- true | X=yes.
is_command(floating_point_log(_,_),       X):- true | X=yes.
is_command(floating_point_exp(_,_),       X):- true | X=yes.
is_command(floating_point_pow(_,_,_),     X):- true | X=yes.
