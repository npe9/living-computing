is_command(floating_point_sinh(_,_),      X):- true | X=yes.
is_command(floating_point_cosh(_,_),      X):- true | X=yes.
is_command(floating_point_tanh(_,_),      X):- true | X=yes.
is_command(floating_point_to_integer(_,_),X):- true | X=yes.
is_command(integer_to_floating_point(_,_),X):- true | X=yes.
otherwise.
is_command(_, X):- true | X=no.

do_command(true,SS):- true|
    SS = [].
do_command(unify(A,B),SS):- true|
    SS = [],
    A = B.
do_command(add(A,B,C), SS):- true |
    SS = [],
    add(A,B,C).
