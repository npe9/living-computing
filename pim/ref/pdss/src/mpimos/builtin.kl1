%do_command(Command, System):- vector(Command, N) |
%	NN := N-1, new_vector(Args, NN),
%	do_command(Command, Args, NN).
%
%do_command(Command, Args, 0):- true |
%	set_vector_element(Command, 0, Proc, _, _),
%	apply(pdss_runtime_body_builtin, Proc, Args).
%do_command(Command, Args, N):- N > 0 |
%	NN := N-1,
%	set_vector_element(Command, N, Arg, _, Command2),
%	set_vector_element(Args, NN, _, Arg, Args2),
%	do_command(Command2, Args2, NN).

help(menu,MSG):-
     true | MSG = string#"builtin predicates (body).".
help(item,MSG):-
     true | MSG = builtin.
help(message,MSG):-
     true | MSG =
	[string#"You can use body builtin predicates as commands.",
	 string#"Beside, there are following macros.",
	 string#"Unification  ---  unify(A,B)  or  A = B.",
	 string#"Arithmetic Expression",
	 string#"             ---  A := <arithmetic expression>.",
	 string#"Floating Point Arithmetic Expression",
	 string#"             ---  A $:= <arithmetic expression>."].
