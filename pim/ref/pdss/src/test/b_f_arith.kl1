:- module b_f_arith.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for B_Float_Arithmetic %%%"), put_console(key#lf) | add.

add:- put_console(ascii#"% B_Float_Add %%%%%%%%%%% ") | add00.

add00:- true | add00(12.34,12.34).
add00(X,Y):- true | Z$:=X+Y, add00(Z).
add00(Z):- 24.68-1.0e-4$<Z, Z$< 24.68+1.0e-4, put_console(c#"a") | add01.
otherwise.
add00(_):- put_console(c#"*") | add01.

