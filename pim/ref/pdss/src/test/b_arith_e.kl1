%%% KL1-B Test for B_Arithmetic (Exception) %%%
% B_Add %%%%%%%%%%%%%%%%% abcdefghijklmn
% B_Subtract %%%%%%%%%%%% abcdefghijklmn
% B_Multiply %%%%%%%%%%%% abcdefghijklmn
% B_Divide %%%%%%%%%%%%%% abcdefghijklmn
% B_Modulo %%%%%%%%%%%%%% abcdefghijklm
% B_Minus %%%%%%%%%%%%%%% abcdefg
% B_Increment %%%%%%%%%%% abcdefg
% B_Decrement %%%%%%%%%%% abcdefg

:- module b_arith_e.
:- public go/0
,do_add/3,do_subtract/3,do_multiply/3,do_divide/3,do_modulo/3,do_minus/2,do_increment/2,do_decrement/2.

go:- put_console(ascii#"%%% KL1-B Test for B_Arithmetic (Exception) %%%"), put_console(key#lf) | add.

add:- put_console(ascii#"% B_Add %%%%%%%%%%%%%%%%% ") | add00.

add00:- true | execute_in_shoen(do_add,{16#"7FFFFFFF",0,Z},R), add00(R,Z).
add00(success,_):- put_console(c#"a") | add01.
otherwise.
add00(_,_):- put_console(c#"*") | add01.

add01:- true | execute_in_shoen(do_add,{16#"7FFFFFFF",1,Z},R), add01(R,Z).
