dec04:- true | execute_in_shoen(do_decrement,{[list],Z},R), dec04(R,Z).
dec04(illegal_input,_):- put_console(c#"e") | dec05.
otherwise.
dec04(_,_):- put_console(c#"*") | dec05.

dec05:- true | execute_in_shoen(do_decrement,{{0,1},Z},R), dec05(R,Z).
dec05(illegal_input,_):- put_console(c#"f") | dec06.
otherwise.
dec05(_,_):- put_console(c#"*") | dec06.

dec06:- true | execute_in_shoen(do_decrement,{ascii#"String",Z},R), dec06(R,Z).
dec06(illegal_input,_):- put_console(c#"g") | dec07.
otherwise.
dec06(_,_):- put_console(c#"*") | dec07.

dec07:- put_console(key#lf) | done.

done:- true | true.

execute_in_shoen(P,A,R):- vector(A,L) |
	'Sho-en':execute({b_arith_e,P,L},A, 0,0, -1, C0,R0),
	C0 = [add_resource(100),start|C],
	shoen_wait(R0,R,C).

shoen_wait([resource_added,started|R0],R,C):- true | shoen_check(R0,R,C).

shoen_check([terminated|_],R,C):- true |
	R=success, C=[].
shoen_check([exception(0,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=illegal_input, C=[abort].
shoen_check([exception(1,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=range_overflow, C=[abort].
shoen_check([exception(3,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=integer_overflow, C=[abort].

do_add(X,Y,Z):- true | Z:=X+Y.
do_subtract(X,Y,Z):- true | Z:=X-Y.
do_multiply(X,Y,Z):- true | Z:=X*Y.
do_divide(X,Y,Z):- true | Z:=X/Y.
do_modulo(X,Y,Z):- true | Z:=X mod Y.
do_minus(X,Z):- true | Z:= -X.
do_increment(X,Z):- true | Z:=X+1.
do_decrement(X,Z):- true | Z:=X-1.
