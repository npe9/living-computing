sub01(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"b") | sub02.
otherwise.
sub01(_):- put_console(c#"*") | sub02.

sub02:- true | Z$:=X-Y, unify(X,Y,12.34,-12.34), sub02(Z).
sub02(Z):- 24.68-1.0e-4$<Z, Z$< 24.68+1.0e-4, put_console(c#"c") | sub03.
otherwise.
sub02(_):- put_console(c#"*") | sub03.

sub03:- true | Z$:=X-Y, unify(X,Y,0.0,12.34), sub03(Z).
sub03(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"d") | sub04.
otherwise.
sub03(_):- put_console(c#"*") | sub04.

