%%% KL1-B Test for B_Float_Arithmetic (Suspend) %%%
% B_Float_Add %%%%%%%%%%% abcdefghi
% B_Float_Subtract %%%%%% abcdefghi
% B_Float_Multiply %%%%%% abcdefghi
% B_Float_Divide %%%%%%%% abcdef
% B_Float_Minus %%%%%%%%% abc

:- module b_f_arith_s.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for B_Float_Arithmetic (Suspend) %%%"), put_console(key#lf) | add.

add:- put_console(ascii#"% B_Float_Add %%%%%%%%%%% ") | add00.

add00:- true | Z$:=X+Y, unify(X,Y,12.34,12.34), add00(Z).
add00(Z):- 24.68-1.0e-4$<Z, Z$< 24.68+1.0e-4, put_console(c#"a") | add01.
otherwise.
add00(_):- put_console(c#"*") | add01.

add01:- true | Z$:=X+Y, unify(X,Y,12.34,0.0), add01(Z).
add01(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"b") | add02.
otherwise.
add01(_):- put_console(c#"*") | add02.

add02:- true | Z$:=X+Y, unify(X,Y,12.34,-12.34), add02(Z).
add02(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"c") | add03.
otherwise.
add02(_):- put_console(c#"*") | add03.

add03:- true | Z$:=X+Y, unify(X,Y,0.0,12.34), add03(Z).
add03(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"d") | add04.
otherwise.
add03(_):- put_console(c#"*") | add04.

add04:- true | Z$:=X+Y, unify(X,Y,0.0,0.0), add04(Z).
add04(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"e") | add05.
otherwise.
add04(_):- put_console(c#"*") | add05.

add05:- true | Z$:=X+Y, unify(X,Y,0.0,-12.34), add05(Z).
add05(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"f") | add06.
otherwise.
add05(_):- put_console(c#"*") | add06.

add06:- true | Z$:=X+Y, unify(X,Y,-12.34,12.34), add06(Z).
add06(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"g") | add07.
otherwise.
add06(_):- put_console(c#"*") | add07.

add07:- true | Z$:=X+Y, unify(X,Y,-12.34,0.0), add07(Z).
add07(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"h") | add08.
otherwise.
add07(_):- put_console(c#"*") | add08.

add08:- true | Z$:=X+Y, unify(X,Y,-12.34,-12.34), add08(Z).
add08(Z):- -24.68-1.0e-4$<Z, Z$< -24.68+1.0e-4, put_console(c#"i") | add09.
otherwise.
add08(_):- put_console(c#"*") | add09.

add09:- put_console(key#lf) | sub.

sub:- put_console(ascii#"% B_Float_Subtract %%%%%% ") | sub00.

sub00:- true | Z$:=X-Y, unify(X,Y,12.34,12.34), sub00(Z).
sub00(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"a") | sub01.
otherwise.
sub00(_):- put_console(c#"*") | sub01.

