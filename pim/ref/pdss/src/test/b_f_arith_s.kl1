div04(Z):- -1.0-1.0e-5$<Z, Z$< -1.0+1.0e-5, put_console(c#"e") | div05.
otherwise.
div04(_):- put_console(c#"*") | div05.

div05:- true | Z$:=X/Y, unify(X,Y,-12.34,-12.34), div05(Z).
div05(Z):- 1.0-1.0e-5$<Z, Z$< 1.0+1.0e-5, put_console(c#"f") | div06.
otherwise.
div05(_):- put_console(c#"*") | div06.

div06:- put_console(key#lf) | min.

min:- put_console(ascii#"% B_Float_Minus %%%%%%%%% ") | min00.

min00:- true | Z$:= -X, unify(X,12.34), min00(Z).
min00(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"a") | min01.
otherwise.
min00(_):- put_console(c#"*") | min01.

min01:- true | Z$:= -X, unify(X,0.0), min01(Z).
min01(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"b") | min02.
otherwise.
min01(_):- put_console(c#"*") | min02.

min02:- true | Z$:= -X, unify(X,-12.34), min02(Z).
min02(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"c") | min03.
otherwise.
min02(_):- put_console(c#"*") | min03.

min03:- put_console(key#lf) | done.

done:- true | true.

unify(X,Y,A,B):- true | X=A, Y=B.
unify(X,A):- true | X=A.
