sub04(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"e") | sub05.
otherwise.
sub04(_):- put_console(c#"*") | sub05.

sub05:- true | Z$:=X-Y, unify(X,Y,0.0,-12.34), sub05(Z).
sub05(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"f") | sub06.
otherwise.
sub05(_):- put_console(c#"*") | sub06.

sub06:- true | Z$:=X-Y, unify(X,Y,-12.34,12.34), sub06(Z).
sub06(Z):- -24.68-1.0e-4$<Z, Z$< -24.68+1.0e-4, put_console(c#"g") | sub07.
otherwise.
sub06(_):- put_console(c#"*") | sub07.

sub07:- true | Z$:=X-Y, unify(X,Y,-12.34,0.0), sub07(Z).
sub07(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"h") | sub08.
otherwise.
sub07(_):- put_console(c#"*") | sub08.

sub08:- true | Z$:=X-Y, unify(X,Y,-12.34,-12.34), sub08(Z).
sub08(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"i") | sub09.
otherwise.
sub08(_):- put_console(c#"*") | sub09.

sub09:- put_console(key#lf) | mul.

mul:- put_console(ascii#"% B_Float_Multiply %%%%%% ") | mul00.

mul00:- true | Z$:=X*Y, unify(X,Y,12.34,12.34), mul00(Z).
mul00(Z):- 152.276-1.0e-3$<Z, Z$< 152.276+1.0e-3, put_console(c#"a") | mul01.
otherwise.
mul00(_):- put_console(c#"*") | mul01.

mul01:- true | Z$:=X*Y, unify(X,Y,12.34,0.0), mul01(Z).
mul01(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"b") | mul02.
