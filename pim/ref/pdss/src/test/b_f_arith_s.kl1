mul06:- true | Z$:=X*Y, unify(X,Y,-12.34,12.34), mul06(Z).
mul06(Z):- -152.276-1.0e-3$<Z, Z$< -152.276+1.0e-3, put_console(c#"g") | mul07.
otherwise.
mul06(_):- put_console(c#"*") | mul07.

mul07:- true | Z$:=X*Y, unify(X,Y,-12.34,0.0), mul07(Z).
mul07(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"h") | mul08.
otherwise.
mul07(_):- put_console(c#"*") | mul08.

mul08:- true | Z$:=X*Y, unify(X,Y,-12.34,-12.34), mul08(Z).
mul08(Z):- 152.276-1.0e-3$<Z, Z$< 152.276+1.0e-3, put_console(c#"i") | mul09.
otherwise.
mul08(_):- put_console(c#"*") | mul09.

mul09:- put_console(key#lf) | div.

div:- put_console(ascii#"% B_Float_Divide %%%%%%%% ") | div00.

div00:- true | Z$:=X/Y, unify(X,Y,12.34,12.34), div00(Z).
div00(Z):- 1.0-1.0e-5$<Z, Z$< 1.0+1.0e-5, put_console(c#"a") | div01.
otherwise.
div00(_):- put_console(c#"*") | div01.

div01:- true | Z$:=X/Y, unify(X,Y,12.34,-12.34), div01(Z).
div01(Z):- -1.0-1.0e-5$<Z, Z$< -1.0+1.0e-5, put_console(c#"b") | div02.
otherwise.
div01(_):- put_console(c#"*") | div02.

div02:- true | Z$:=X/Y, unify(X,Y,0.0,12.34), div02(Z).
div02(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"c") | div03.
otherwise.
div02(_):- put_console(c#"*") | div03.

