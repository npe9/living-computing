pow06(illegal_input,_):- put_console(c#"g") | pow07.
otherwise.
pow06(_,_):- put_console(c#"*") | pow07.

pow07:- true | execute_in_shoen(do_pow,{atom,0.0,Z},R), pow07(R,Z).
pow07(illegal_input,_):- put_console(c#"h") | pow08.
otherwise.
pow07(_,_):- put_console(c#"*") | pow08.

pow08:- true | execute_in_shoen(do_pow,{[list],0.0,Z},R), pow08(R,Z).
pow08(illegal_input,_):- put_console(c#"i") | pow09.
otherwise.
pow08(_,_):- put_console(c#"*") | pow09.

pow09:- true | execute_in_shoen(do_pow,{{0,1},0.0,Z},R), pow09(R,Z).
pow09(illegal_input,_):- put_console(c#"j") | pow10.
otherwise.
pow09(_,_):- put_console(c#"*") | pow10.

pow10:- true | execute_in_shoen(do_pow,{ascii#"String",0.0,Z},R), pow10(R,Z).
pow10(illegal_input,_):- put_console(c#"k") | pow11.
otherwise.
pow10(_,_):- put_console(c#"*") | pow11.

pow11:- put_console(key#lf) | done.

done:- true | true.

execute_in_shoen(P,A,R):- vector(A,L) |
	'Sho-en':execute({b_f_func2_e,P,L},A, 0,0, -1, C0,R0),
	C0 = [add_resource(100),start|C],
	shoen_wait(R0,R,C).

shoen_wait([resource_added,started|R0],R,C):- true | shoen_check(R0,R,C).

shoen_check([terminated|_],R,C):- true |
	R=success, C=[].
shoen_check([exception(0,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=illegal_input, C=[abort].
shoen_check([exception(5,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=floating_point_error, C=[abort].

do_min(X,Y,Z):- true | Z$:=min(X,Y).
do_max(X,Y,Z):- true | Z$:=max(X,Y).
do_pow(X,Y,Z):- true | Z$:= X** Y.
