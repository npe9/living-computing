%%% KL1-B Test for B_Float_Function_2_Args (Exception) %%%
% B_Float_Min %%%%%%%%%%% abcdef
% B_Float_Max %%%%%%%%%%% abcdef
% B_Float_Pow %%%%%%%%%%% abcdef

:- module b_f_func2_e.
:- public go/0
,do_min/3,do_max/3,do_pow/3.

go:- put_console(ascii#"%%% KL1-B Test for B_Float_Function_2_Args (Exception) %%%"), put_console(key#lf) | min.

min:- put_console(ascii#"% B_Float_Min %%%%%%%%%%% ") | min00.

min00:- true | execute_in_shoen(do_min,{12.34,0.0,Z},R), min00(R,Z).
min00(success,_):- put_console(c#"a") | min01.
otherwise.
min00(_,_):- put_console(c#"*") | min01.

min01:- true | execute_in_shoen(do_min,{0.0,1234,Z},R), min01(R,Z).
min01(illegal_input,_):- put_console(c#"b") | min02.
otherwise.
min01(_,_):- put_console(c#"*") | min02.

min02:- true | execute_in_shoen(do_min,{0.0,atom,Z},R), min02(R,Z).
min02(illegal_input,_):- put_console(c#"c") | min03.
otherwise.
min02(_,_):- put_console(c#"*") | min03.

