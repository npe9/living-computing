min07:- true | execute_in_shoen(do_min,{atom,0.0,Z},R), min07(R,Z).
min07(illegal_input,_):- put_console(c#"h") | min08.
otherwise.
min07(_,_):- put_console(c#"*") | min08.

min08:- true | execute_in_shoen(do_min,{[list],0.0,Z},R), min08(R,Z).
min08(illegal_input,_):- put_console(c#"i") | min09.
otherwise.
min08(_,_):- put_console(c#"*") | min09.

min09:- true | execute_in_shoen(do_min,{{0,1},0.0,Z},R), min09(R,Z).
min09(illegal_input,_):- put_console(c#"j") | min10.
otherwise.
min09(_,_):- put_console(c#"*") | min10.

min10:- true | execute_in_shoen(do_min,{ascii#"String",0.0,Z},R), min10(R,Z).
min10(illegal_input,_):- put_console(c#"k") | min11.
otherwise.
min10(_,_):- put_console(c#"*") | min11.

min11:- put_console(key#lf) | max.

