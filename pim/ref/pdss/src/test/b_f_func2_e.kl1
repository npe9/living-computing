max10(illegal_input,_):- put_console(c#"k") | max11.
otherwise.
max10(_,_):- put_console(c#"*") | max11.

max11:- put_console(key#lf) | pow.

pow:- put_console(ascii#"% B_Float_Pow %%%%%%%%%%% ") | pow00.

pow00:- true | execute_in_shoen(do_pow,{12.34,-12.34,Z},R), pow00(R,Z).
pow00(success,_):- put_console(c#"a") | pow01.
otherwise.
pow00(_,_):- put_console(c#"*") | pow01.

pow01:- true | execute_in_shoen(do_pow,{0.0,1234,Z},R), pow01(R,Z).
pow01(illegal_input,_):- put_console(c#"b") | pow02.
otherwise.
pow01(_,_):- put_console(c#"*") | pow02.

