%%% KL1-B Test for G_Float_Tri_Function %%%
% G_Float_Sin %%%%%%%%%%% abcd
% G_Float_Cos %%%%%%%%%%% abcd
% G_Float_Tan %%%%%%%%%%% abc
% G_Float_Asin %%%%%%%%%% abcd
% G_Float_Acos %%%%%%%%%% abcd
