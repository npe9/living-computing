asn00ans(Z):- 1.5708-1.0e-4$<Z, Z$< 1.5708+1.0e-4, put_console(c#"a") | asn01.
otherwise.
asn00ans(_):- put_console(c#"*") | asn01.

asn01:- true | asn01(0.5).
asn01(X):- Z$:=asin(X) | asn01ans(Z).
