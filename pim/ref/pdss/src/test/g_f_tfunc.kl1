:- module g_f_tfunc.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for G_Float_Tri_Function %%%"), put_console(key#lf) | sin.

sin:- put_console(ascii#"% G_Float_Sin %%%%%%%%%%% ") | sin00.

sin00:- true | sin00(3.141592654).
sin00(X):- Z$:=sin(X) | sin00ans(Z).
otherwise.
sin00(_):- put_console(c#"*") | sin01.
sin00ans(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"a") | sin01.
otherwise.
sin00ans(_):- put_console(c#"*") | sin01.

sin01:- true | sin01($~(3.141592654/float(2))).
sin01(X):- Z$:=sin(X) | sin01ans(Z).
otherwise.
sin01(_):- put_console(c#"*") | sin02.
sin01ans(Z):- 1.0-1.0e-5$<Z, Z$< 1.0+1.0e-5, put_console(c#"b") | sin02.
otherwise.
sin01ans(_):- put_console(c#"*") | sin02.

sin02:- true | sin02($~(3.141592654/float(6))).
sin02(X):- Z$:=sin(X) | sin02ans(Z).
otherwise.
sin02(_):- put_console(c#"*") | sin03.
sin02ans(Z):- 0.5-1.0e-5$<Z, Z$< 0.5+1.0e-5, put_console(c#"c") | sin03.
otherwise.
sin02ans(_):- put_console(c#"*") | sin03.

sin03:- true | sin03(0.0).
sin03(X):- Z$:=sin(X) | sin03ans(Z).
otherwise.
sin03(_):- put_console(c#"*") | sin04.
sin03ans(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"d") | sin04.
otherwise.
sin03ans(_):- put_console(c#"*") | sin04.

sin04:- put_console(key#lf) | cos.

