asn02ans(_):- put_console(c#"*") | asn03.

asn03:- true | asn03(2.0).
asn03(X):- Z$:=asin(X), put_console(c#"*") | asn04.
otherwise.
asn03(_):- put_console(c#"d") | asn04.

asn04:- put_console(key#lf) | acs.

