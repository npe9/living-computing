otherwise.
sub04(_):- put_console(c#"*") | sub05.

sub05:- true | sub05(0,-1234).
sub05(X,Y):- Z:=X-Y | sub05(Z).
otherwise.
sub05(_,_):- put_console(c#"*") | sub06.
sub05(1234):- put_console(c#"f") | sub06.
otherwise.
sub05(_):- put_console(c#"*") | sub06.

sub06:- true | sub06(-1234,1234).
sub06(X,Y):- Z:=X-Y | sub06(Z).
otherwise.
sub06(_,_):- put_console(c#"*") | sub07.
sub06(-2468):- put_console(c#"g") | sub07.
otherwise.
sub06(_):- put_console(c#"*") | sub07.

sub07:- true | sub07(-1234,0).
