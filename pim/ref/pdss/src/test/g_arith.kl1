otherwise.
div03(_):- put_console(c#"*") | div04.

div04:- true | div04(0,0).
div04(X,Y):- Z:=X/Y, put_console(c#"*") | div05.
otherwise.
div04(_,_):- put_console(c#"e") | div05.

div05:- true | div05(0,-1234).
div05(X,Y):- Z:=X/Y | div05(Z).
otherwise.
div05(_,_):- put_console(c#"*") | div06.
div05(0):- put_console(c#"f") | div06.
otherwise.
div05(_):- put_console(c#"*") | div06.

div06:- true | div06(-1234,1234).
div06(X,Y):- Z:=X/Y | div06(Z).
otherwise.
div06(_,_):- put_console(c#"*") | div07.
div06(-1):- put_console(c#"g") | div07.
otherwise.
div06(_):- put_console(c#"*") | div07.

div07:- true | div07(-1234,0).
div07(X,Y):- Z:=X/Y, put_console(c#"*") | div08.
otherwise.
div07(_,_):- put_console(c#"h") | div08.

div08:- true | div08(-1234,-1234).
div08(X,Y):- Z:=X/Y | div08(Z).
otherwise.
div08(_,_):- put_console(c#"*") | div09.
div08(1):- put_console(c#"i") | div09.
otherwise.
div08(_):- put_console(c#"*") | div09.

div09:- true | div09(16#"80000000",-1).
div09(X,Y):- Z:=X/Y, put_console(c#"*") | div10.
otherwise.
div09(_,_):- put_console(c#"j") | div10.

div10:- put_console(key#lf) | mod.

mod:- put_console(ascii#"% G_Modulo %%%%%%%%%%%%%% ") | mod00.

mod00:- true | mod00(1234,1234).
mod00(X,Y):- Z:=X mod Y | mod00(Z).
otherwise.
mod00(_,_):- put_console(c#"*") | mod01.
mod00(0):- put_console(c#"a") | mod01.
otherwise.
mod00(_):- put_console(c#"*") | mod01.

mod01:- true | mod01(1234,0).
mod01(X,Y):- Z:=X mod Y, put_console(c#"*") | mod02.
otherwise.
mod01(_,_):- put_console(c#"b") | mod02.

mod02:- true | mod02(1234,-1234).
mod02(X,Y):- Z:=X mod Y | mod02(Z).
otherwise.
mod02(_,_):- put_console(c#"*") | mod03.
