mul05:- true | mul05(0,-1234).
mul05(X,Y):- Z:=X*Y | mul05(Z).
otherwise.
mul05(_,_):- put_console(c#"*") | mul06.
mul05(0):- put_console(c#"f") | mul06.
otherwise.
mul05(_):- put_console(c#"*") | mul06.

mul06:- true | mul06(-1234,1234).
mul06(X,Y):- Z:=X*Y | mul06(Z).
otherwise.
mul06(_,_):- put_console(c#"*") | mul07.
mul06(-1522756):- put_console(c#"g") | mul07.
otherwise.
mul06(_):- put_console(c#"*") | mul07.

mul07:- true | mul07(-1234,0).
mul07(X,Y):- Z:=X*Y | mul07(Z).
otherwise.
mul07(_,_):- put_console(c#"*") | mul08.
mul07(0):- put_console(c#"h") | mul08.
otherwise.
mul07(_):- put_console(c#"*") | mul08.

mul08:- true | mul08(-1234,-1234).
mul08(X,Y):- Z:=X*Y | mul08(Z).
otherwise.
mul08(_,_):- put_console(c#"*") | mul09.
mul08(1522756):- put_console(c#"i") | mul09.
