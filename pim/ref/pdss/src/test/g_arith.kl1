mul10(X,Y):- Z:=X*Y, put_console(c#"*") | mul11.
otherwise.
mul10(_,_):- put_console(c#"k") | mul11.

mul11:- put_console(key#lf) | div.

div:- put_console(ascii#"% G_Divide %%%%%%%%%%%%%% ") | div00.

div00:- true | div00(1234,1234).
div00(X,Y):- Z:=X/Y | div00(Z).
otherwise.
div00(_,_):- put_console(c#"*") | div01.
div00(1):- put_console(c#"a") | div01.
otherwise.
div00(_):- put_console(c#"*") | div01.

div01:- true | div01(1234,0).
div01(X,Y):- Z:=X/Y, put_console(c#"*") | div02.
otherwise.
div01(_,_):- put_console(c#"b") | div02.

div02:- true | div02(1234,-1234).
div02(X,Y):- Z:=X/Y | div02(Z).
otherwise.
div02(_,_):- put_console(c#"*") | div03.
div02(-1):- put_console(c#"c") | div03.
otherwise.
div02(_):- put_console(c#"*") | div03.

div03:- true | div03(0,1234).
div03(X,Y):- Z:=X/Y | div03(Z).
otherwise.
div03(_,_):- put_console(c#"*") | div04.
