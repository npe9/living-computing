mod08:- true | mod08(-1234,-1234).
mod08(X,Y):- Z:=X mod Y | mod08(Z).
otherwise.
mod08(_,_):- put_console(c#"*") | mod09.
mod08(0):- put_console(c#"i") | mod09.
otherwise.
mod08(_):- put_console(c#"*") | mod09.

mod09:- put_console(key#lf) | min.

min:- put_console(ascii#"% G_Minus %%%%%%%%%%%%%%% ") | min00.

min00:- true | min00(1234).
min00(X):- Z:= -X | min00ans(Z).
otherwise.
min00(_):- put_console(c#"*") | min01.
min00ans(-1234):- put_console(c#"a") | min01.
otherwise.
min00ans(_):- put_console(c#"*") | min01.

min01:- true | min01(0).
min01(X):- Z:= -X | min01ans(Z).
otherwise.
min01(_):- put_console(c#"*") | min02.
min01ans(0):- put_console(c#"b") | min02.
otherwise.
min01ans(_):- put_console(c#"*") | min02.

min02:- true | min02(-1234).
min02(X):- Z:= -X | min02ans(Z).
otherwise.
min02(_):- put_console(c#"*") | min03.
min02ans(1234):- put_console(c#"c") | min03.
otherwise.
min02ans(_):- put_console(c#"*") | min03.

min03:- true | min03(16#"80000000").
min03(X):- Z:= -X, put_console(c#"*") | min04.
otherwise.
min03(_):- put_console(c#"d") | min04.

min04:- put_console(key#lf) | inc.

inc:- put_console(ascii#"% G_Increment %%%%%%%%%%% ") | inc00.

inc00:- true | inc00(1234).
inc00(X):- Z:=X+1 | inc00ans(Z).
otherwise.
inc00(_):- put_console(c#"*") | inc01.
inc00ans(1235):- put_console(c#"a") | inc01.
otherwise.
inc00ans(_):- put_console(c#"*") | inc01.

inc01:- true | inc01(0).
inc01(X):- Z:=X+1 | inc01ans(Z).
otherwise.
inc01(_):- put_console(c#"*") | inc02.
inc01ans(1):- put_console(c#"b") | inc02.
otherwise.
inc01ans(_):- put_console(c#"*") | inc02.

inc02:- true | inc02(-1234).
inc02(X):- Z:=X+1 | inc02ans(Z).
otherwise.
inc02(_):- put_console(c#"*") | inc03.
inc02ans(-1233):- put_console(c#"c") | inc03.
otherwise.
inc02ans(_):- put_console(c#"*") | inc03.

inc03:- true | inc03(16#"7FFFFFFF").
inc03(X):- Z:=X+1, put_console(c#"*") | inc04.
otherwise.
inc03(_):- put_console(c#"d") | inc04.

inc04:- put_console(key#lf) | dec.

dec:- put_console(ascii#"% G_Decrement %%%%%%%%%%% ") | dec00.

dec00:- true | dec00(1234).
dec00(X):- Z:=X-1 | dec00ans(Z).
otherwise.
dec00(_):- put_console(c#"*") | dec01.
dec00ans(1233):- put_console(c#"a") | dec01.
otherwise.
dec00ans(_):- put_console(c#"*") | dec01.

dec01:- true | dec01(0).
dec01(X):- Z:=X-1 | dec01ans(Z).
otherwise.
dec01(_):- put_console(c#"*") | dec02.
dec01ans(-1):- put_console(c#"b") | dec02.
otherwise.
dec01ans(_):- put_console(c#"*") | dec02.

dec02:- true | dec02(-1234).
dec02(X):- Z:=X-1 | dec02ans(Z).
otherwise.
dec02(_):- put_console(c#"*") | dec03.
dec02ans(-1235):- put_console(c#"c") | dec03.
otherwise.
dec02ans(_):- put_console(c#"*") | dec03.

dec03:- true | dec03(16#"80000000").
dec03(X):- Z:=X-1, put_console(c#"*") | dec04.
otherwise.
dec03(_):- put_console(c#"d") | dec04.

dec04:- put_console(key#lf) | done.

done:- true | true.
