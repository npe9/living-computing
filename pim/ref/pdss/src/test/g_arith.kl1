otherwise.
sub08(_):- put_console(c#"*") | sub09.

sub09:- true | sub09(16#"7FFFFFFF",-1).
sub09(X,Y):- Z:=X-Y, put_console(c#"*") | sub10.
otherwise.
sub09(_,_):- put_console(c#"j") | sub10.

sub10:- true | sub10(16#"80000000",1).
sub10(X,Y):- Z:=X-Y, put_console(c#"*") | sub11.
otherwise.
sub10(_,_):- put_console(c#"k") | sub11.

sub11:- put_console(key#lf) | mul.

