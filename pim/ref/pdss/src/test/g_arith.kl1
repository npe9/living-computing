%%% KL1-B Test for G_Arithmetic %%%
% G_Add %%%%%%%%%%%%%%%%% abcdefghijk
% G_Subtract %%%%%%%%%%%% abcdefghijk
% G_Multiply %%%%%%%%%%%% abcdefghijk
% G_Divide %%%%%%%%%%%%%% abcdefghij
% G_Modulo %%%%%%%%%%%%%% abcdefghi
% G_Minus %%%%%%%%%%%%%%% abcd
% G_Increment %%%%%%%%%%% abcd
% G_Decrement %%%%%%%%%%% abcd

:- module g_arith.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for G_Arithmetic %%%"), put_console(key#lf) | add.

add:- put_console(ascii#"% G_Add %%%%%%%%%%%%%%%%% ") | add00.

add00:- true | add00(1234,1234).
add00(X,Y):- Z:=X+Y | add00(Z).
otherwise.
add00(_,_):- put_console(c#"*") | add01.
add00(2468):- put_console(c#"a") | add01.
otherwise.
add00(_):- put_console(c#"*") | add01.

add01:- true | add01(1234,0).
add01(X,Y):- Z:=X+Y | add01(Z).
otherwise.
add01(_,_):- put_console(c#"*") | add02.
add01(1234):- put_console(c#"b") | add02.
otherwise.
add01(_):- put_console(c#"*") | add02.

add02:- true | add02(1234,-1234).
add02(X,Y):- Z:=X+Y | add02(Z).
otherwise.
add02(_,_):- put_console(c#"*") | add03.
add02(0):- put_console(c#"c") | add03.
otherwise.
add02(_):- put_console(c#"*") | add03.

add03:- true | add03(0,1234).
add03(X,Y):- Z:=X+Y | add03(Z).
otherwise.
add03(_,_):- put_console(c#"*") | add04.
add03(1234):- put_console(c#"d") | add04.
otherwise.
add03(_):- put_console(c#"*") | add04.

add04:- true | add04(0,0).
add04(X,Y):- Z:=X+Y | add04(Z).
otherwise.
add04(_,_):- put_console(c#"*") | add05.
add04(0):- put_console(c#"e") | add05.
otherwise.
add04(_):- put_console(c#"*") | add05.

add05:- true | add05(0,-1234).
add05(X,Y):- Z:=X+Y | add05(Z).
otherwise.
add05(_,_):- put_console(c#"*") | add06.
add05(-1234):- put_console(c#"f") | add06.
otherwise.
add05(_):- put_console(c#"*") | add06.

add06:- true | add06(-1234,1234).
add06(X,Y):- Z:=X+Y | add06(Z).
otherwise.
add06(_,_):- put_console(c#"*") | add07.
add06(0):- put_console(c#"g") | add07.
otherwise.
add06(_):- put_console(c#"*") | add07.

add07:- true | add07(-1234,0).
add07(X,Y):- Z:=X+Y | add07(Z).
otherwise.
add07(_,_):- put_console(c#"*") | add08.
add07(-1234):- put_console(c#"h") | add08.
otherwise.
add07(_):- put_console(c#"*") | add08.

add08:- true | add08(-1234,-1234).
add08(X,Y):- Z:=X+Y | add08(Z).
otherwise.
add08(_,_):- put_console(c#"*") | add09.
add08(-2468):- put_console(c#"i") | add09.
otherwise.
add08(_):- put_console(c#"*") | add09.

add09:- true | add09(16#"7FFFFFFF",1).
add09(X,Y):- Z:=X+Y, put_console(c#"*") | add10.
otherwise.
add09(_,_):- put_console(c#"j") | add10.

add10:- true | add10(16#"80000000",-1).
add10(X,Y):- Z:=X+Y, put_console(c#"*") | add11.
otherwise.
add10(_,_):- put_console(c#"k") | add11.

add11:- put_console(key#lf) | sub.

sub:- put_console(ascii#"% G_Subtract %%%%%%%%%%%% ") | sub00.

