%%% KL1-B Test for Type %%%
% Atom %%%%%%%%%%%%%%%%%% abcdefg
% Integer %%%%%%%%%%%%%%% abcdefg
% Float %%%%%%%%%%%%%%%%% abcdefg
% List %%%%%%%%%%%%%%%%%% abcdefg
% Vector %%%%%%%%%%%%%%%% abcdefg
% String %%%%%%%%%%%%%%%% abcdefg
% Wait %%%%%%%%%%%%%%%%%% abcdefg

:- module type.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for Type %%%"), put_console(key#lf) | atm.

atm:- put_console(ascii#"% Atom %%%%%%%%%%%%%%%%%% ") | atm00.

atm00:- true | atm00(atom).
atm00(X):- atom(X), put_console(c#"a") | atm01.
alternatively.
atm00(_):- put_console(c#"*") | atm01.

atm01:- true | atm01(1234).
atm01(X):- atom(X), put_console(c#"*") | atm02.
alternatively.
atm01(_):- put_console(c#"b") | atm02.

atm02:- true | atm02(12.34).
atm02(X):- atom(X), put_console(c#"*") | atm03.
alternatively.
atm02(_):- put_console(c#"c") | atm03.

atm03:- true | atm03([list]).
atm03(X):- atom(X), put_console(c#"*") | atm04.
alternatively.
atm03(_):- put_console(c#"d") | atm04.

atm04:- true | atm04({0,1}).
atm04(X):- atom(X), put_console(c#"*") | atm05.
alternatively.
atm04(_):- put_console(c#"e") | atm05.

atm05:- true | atm05(ascii#"String").
atm05(X):- atom(X), put_console(c#"*") | atm06.
alternatively.
atm05(_):- put_console(c#"f") | atm06.

atm06:- true | atm06(_).
atm06(X):- atom(X), put_console(c#"*") | atm07.
alternatively.
atm06(_):- put_console(c#"g") | atm07.

atm07:- put_console(key#lf) | int.

int:- put_console(ascii#"% Integer %%%%%%%%%%%%%%% ") | int00.

int00:- true | int00(atom).
int00(X):- integer(X), put_console(c#"*") | int01.
alternatively.
int00(_):- put_console(c#"a") | int01.

int01:- true | int01(1234).
int01(X):- integer(X), put_console(c#"b") | int02.
alternatively.
int01(_):- put_console(c#"*") | int02.

int02:- true | int02(12.34).
int02(X):- integer(X), put_console(c#"*") | int03.
alternatively.
int02(_):- put_console(c#"c") | int03.

int03:- true | int03([list]).
int03(X):- integer(X), put_console(c#"*") | int04.
alternatively.
int03(_):- put_console(c#"d") | int04.

int04:- true | int04({0,1}).
int04(X):- integer(X), put_console(c#"*") | int05.
alternatively.
int04(_):- put_console(c#"e") | int05.

int05:- true | int05(ascii#"String").
int05(X):- integer(X), put_console(c#"*") | int06.
alternatively.
int05(_):- put_console(c#"f") | int06.

int06:- true | int06(_).
int06(X):- integer(X), put_console(c#"*") | int07.
alternatively.
int06(_):- put_console(c#"g") | int07.

int07:- put_console(key#lf) | flt.

flt:- put_console(ascii#"% Float %%%%%%%%%%%%%%%%% ") | flt00.

flt00:- true | flt00(atom).
flt00(X):- floating_point(X), put_console(c#"*") | flt01.
alternatively.
flt00(_):- put_console(c#"a") | flt01.

flt01:- true | flt01(1234).
flt01(X):- floating_point(X), put_console(c#"*") | flt02.
alternatively.
flt01(_):- put_console(c#"b") | flt02.

flt02:- true | flt02(12.34).
