%%% KL1-B Test for B_Vector (Exception) %%%
% B_Vector %%%%%%%%%%%%%% abcdef
% B_New_Vector %%%%%%%%%% abcdefgh
% B_Vector_Element %%%%%% abcdefghijklmno
% B_Set_Vector_Element %% abcdefghijklmno

:- module b_vector_e.
:- public go/0
,do_vector/1,do_new_vector/1,do_vector_element/2,do_set_vector_element/3.

go:- put_console(ascii#"%%% KL1-B Test for B_Vector (Exception) %%%"), put_console(key#lf) | vec.

vec:- put_console(ascii#"% B_Vector %%%%%%%%%%%%%% ") | vec00.

vec00:- true | execute_in_shoen(do_vector,{{0,1}},R), vec00(R).
vec00(success):- put_console(c#"a") | vec01.
otherwise.
vec00(_):- put_console(c#"*") | vec01.

vec01:- true | execute_in_shoen(do_vector,{1234},R), vec01(R).
vec01(illegal_input):- put_console(c#"b") | vec02.
otherwise.
vec01(_):- put_console(c#"*") | vec02.

vec02:- true | execute_in_shoen(do_vector,{12.34},R), vec02(R).
vec02(illegal_input):- put_console(c#"c") | vec03.
otherwise.
vec02(_):- put_console(c#"*") | vec03.

vec03:- true | execute_in_shoen(do_vector,{atom},R), vec03(R).
vec03(illegal_input):- put_console(c#"d") | vec04.
otherwise.
vec03(_):- put_console(c#"*") | vec04.

vec04:- true | execute_in_shoen(do_vector,{[list]},R), vec04(R).
vec04(illegal_input):- put_console(c#"e") | vec05.
otherwise.
vec04(_):- put_console(c#"*") | vec05.

vec05:- true | execute_in_shoen(do_vector,{ascii#"String"},R), vec05(R).
vec05(illegal_input):- put_console(c#"f") | vec06.
otherwise.
vec05(_):- put_console(c#"*") | vec06.

vec06:- put_console(key#lf) | nvc.

nvc:- put_console(ascii#"% B_New_Vector %%%%%%%%%% ") | nvc00.

nvc00:- true | execute_in_shoen(do_new_vector,{0},R), nvc00(R).
nvc00(success):- put_console(c#"a") | nvc01.
otherwise.
nvc00(_):- put_console(c#"*") | nvc01.

nvc01:- true | execute_in_shoen(do_new_vector,{2},R), nvc01(R).
nvc01(success):- put_console(c#"b") | nvc02.
otherwise.
nvc01(_):- put_console(c#"*") | nvc02.

nvc02:- true | execute_in_shoen(do_new_vector,{-1},R), nvc02(R).
nvc02(range_overflow):- put_console(c#"c") | nvc03.
otherwise.
nvc02(_):- put_console(c#"*") | nvc03.

nvc03:- true | execute_in_shoen(do_new_vector,{12.34},R), nvc03(R).
nvc03(illegal_input):- put_console(c#"d") | nvc04.
otherwise.
nvc03(_):- put_console(c#"*") | nvc04.

nvc04:- true | execute_in_shoen(do_new_vector,{atom},R), nvc04(R).
nvc04(illegal_input):- put_console(c#"e") | nvc05.
otherwise.
nvc04(_):- put_console(c#"*") | nvc05.

nvc05:- true | execute_in_shoen(do_new_vector,{[list]},R), nvc05(R).
nvc05(illegal_input):- put_console(c#"f") | nvc06.
otherwise.
nvc05(_):- put_console(c#"*") | nvc06.

nvc06:- true | execute_in_shoen(do_new_vector,{{0,1}},R), nvc06(R).
nvc06(illegal_input):- put_console(c#"g") | nvc07.
otherwise.
nvc06(_):- put_console(c#"*") | nvc07.

nvc07:- true | execute_in_shoen(do_new_vector,{ascii#"String"},R), nvc07(R).
nvc07(illegal_input):- put_console(c#"h") | nvc08.
otherwise.
nvc07(_):- put_console(c#"*") | nvc08.

nvc08:- put_console(key#lf) | vce.

vce:- put_console(ascii#"% B_Vector_Element %%%%%% ") | vce00.

