vce00(success):- put_console(c#"a") | vce01.
otherwise.
vce00(_):- put_console(c#"*") | vce01.

vce01:- true | execute_in_shoen(do_vector_element,{{0,1,2},2},R), vce01(R).
vce01(success):- put_console(c#"b") | vce02.
otherwise.
vce01(_):- put_console(c#"*") | vce02.

vce02:- true | execute_in_shoen(do_vector_element,{{0,1,2},-1},R), vce02(R).
