go:- put_console(ascii#"%%% KL1-B Test for B_Float_Function_2_Args %%%"), put_console(key#lf) | min.

min:- put_console(ascii#"% B_Float_Min %%%%%%%%%%% ") | min00.

min00:- true | min00(12.34,12.34).
