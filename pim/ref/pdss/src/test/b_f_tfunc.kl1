cos00:- true | cos00(3.141592654).
cos00(X):- true | Z$:=cos(X), cos00ans(Z).
cos00ans(Z):- -1.0-1.0e-5$<Z, Z$< -1.0+1.0e-5, put_console(c#"a") | cos01.
otherwise.
cos00ans(_):- put_console(c#"*") | cos01.

cos01:- true | cos01($~(3.141592654/float(2))).
cos01(X):- true | Z$:=cos(X), cos01ans(Z).
cos01ans(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"b") | cos02.
otherwise.
