atn2:- put_console(ascii#"% B_Float_Atan2 %%%%%%%%% ") | atn200.

atn200:- true | atn200(1.0,1.0).
atn200(X,Y):- true | Z$:=atan(X/Y), atn200(Z).
atn200(Z):- 0.785398-1.0e-6$<Z, Z$< 0.785398+1.0e-6, put_console(c#"a") | atn201.
otherwise.
atn200(_):- put_console(c#"*") | atn201.

atn201:- true | atn201(0.5,1.0).
atn201(X,Y):- true | Z$:=atan(X/Y), atn201(Z).
atn201(Z):- 0.463648-1.0e-6$<Z, Z$< 0.463648+1.0e-6, put_console(c#"b") | atn202.
otherwise.
atn201(_):- put_console(c#"*") | atn202.

atn202:- true | atn202(0.0,1.0).
atn202(X,Y):- true | Z$:=atan(X/Y), atn202(Z).
atn202(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"c") | atn203.
otherwise.
atn202(_):- put_console(c#"*") | atn203.

atn203:- put_console(key#lf) | done.

done:- true | true.
