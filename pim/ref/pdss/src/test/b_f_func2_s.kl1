max09:- put_console(key#lf) | pow.

pow:- put_console(ascii#"% B_Float_Pow %%%%%%%%%%% ") | pow00.

pow00:- true | Z$:= X** Y, unify(X,Y,12.34,0.0), pow00(Z).
pow00(Z):- 1.0-1.0e-5$<Z, Z$< 1.0+1.0e-5, put_console(c#"a") | pow01.
otherwise.
pow00(_):- put_console(c#"*") | pow01.

pow01:- true | Z$:= X** Y, unify(X,Y,12.34,2.0), pow01(Z).
pow01(Z):- 152.276-1.0e-3$<Z, Z$< 152.276+1.0e-3, put_console(c#"b") | pow02.
otherwise.
pow01(_):- put_console(c#"*") | pow02.

