pow06:- true | Z$:= X** Y, unify(X,Y,-12.34,2.0), pow06(Z).
pow06(Z):- 152.276-1.0e-3$<Z, Z$< 152.276+1.0e-3, put_console(c#"g") | pow07.
otherwise.
pow06(_):- put_console(c#"*") | pow07.

pow07:- true | Z$:= X** Y, unify(X,Y,-12.34,-2.0), pow07(Z).
pow07(Z):- 0.00656704-1.0e-8$<Z, Z$< 0.00656704+1.0e-8, put_console(c#"h") | pow08.
otherwise.
pow07(_):- put_console(c#"*") | pow08.

pow08:- put_console(key#lf) | done.

done:- true | true.

unify(X,Y,A,B):- true | X=A, Y=B.
