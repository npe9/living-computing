%%% KL1-B Test for B_Float_Function_2_Args (Suspend) %%%
% B_Float_Min %%%%%%%%%%% abcdefghi
% B_Float_Max %%%%%%%%%%% abcdefghi
% B_Float_Pow %%%%%%%%%%% abcdefgh

:- module b_f_func2_s.
:- public go/0.

go:- put_console(ascii#"%%% KL1-B Test for B_Float_Function_2_Args (Suspend) %%%"), put_console(key#lf) | min.

min:- put_console(ascii#"% B_Float_Min %%%%%%%%%%% ") | min00.

min00:- true | Z$:=min(X,Y), unify(X,Y,12.34,12.34), min00(Z).
min00(Z):- 12.34-1.0e-4$<Z, Z$< 12.34+1.0e-4, put_console(c#"a") | min01.
otherwise.
min00(_):- put_console(c#"*") | min01.

min01:- true | Z$:=min(X,Y), unify(X,Y,12.34,0.0), min01(Z).
min01(Z):- 0.0-1.0e-5$<Z, Z$< 0.0+1.0e-5, put_console(c#"b") | min02.
otherwise.
min01(_):- put_console(c#"*") | min02.

