otherwise.
min05(_):- put_console(c#"*") | min06.

min06:- true | Z$:=min(X,Y), unify(X,Y,-12.34,12.34), min06(Z).
min06(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"g") | min07.
otherwise.
min06(_):- put_console(c#"*") | min07.

min07:- true | Z$:=min(X,Y), unify(X,Y,-12.34,0.0), min07(Z).
min07(Z):- -12.34-1.0e-4$<Z, Z$< -12.34+1.0e-4, put_console(c#"h") | min08.
