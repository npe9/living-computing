%%% KL1-B Test for B_Float_Tri_Function (Exception) %%%
% B_Float_Sin %%%%%%%%%%% abcdefg
% B_Float_Cos %%%%%%%%%%% abcdefg
% B_Float_Tan %%%%%%%%%%% abcdefg
% B_Float_Asin %%%%%%%%%% abcdefg
% B_Float_Acos %%%%%%%%%% abcdefg
% B_Float_Atan %%%%%%%%%% abcdefg
% B_Float_Sinh %%%%%%%%%% abcdefg
