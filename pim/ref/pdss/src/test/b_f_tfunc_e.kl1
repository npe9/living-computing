done:- true | true.

execute_in_shoen(P,A,R):- vector(A,L) |
	'Sho-en':execute({b_f_tfunc_e,P,L},A, 0,0, -1, C0,R0),
	C0 = [add_resource(100),start|C],
	shoen_wait(R0,R,C).

shoen_wait([resource_added,started|R0],R,C):- true | shoen_check(R0,R,C).

shoen_check([terminated|_],R,C):- true |
	R=success, C=[].
shoen_check([exception(0,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=illegal_input, C=[abort].
shoen_check([exception(5,_,NewCode,NewArgv)|_],R,C):- true |
	NewCode=[], R=floating_point_error, C=[abort].

do_sin(X,Z):- true | Z$:=sin(X).
do_cos(X,Z):- true | Z$:=cos(X).
do_tan(X,Z):- true | Z$:=tan(X).
do_asin(X,Z):- true | Z$:=asin(X).
do_acos(X,Z):- true | Z$:=acos(X).
do_atan(X,Z):- true | Z$:=atan(X).
do_sinh(X,Z):- true | Z$:=sinh(X).
do_cosh(X,Z):- true | Z$:=cosh(X).
do_tanh(X,Z):- true | Z$:=tanh(X).
do_atan2(X,Y,Z):- true | Z$:=atan(X/Y).
