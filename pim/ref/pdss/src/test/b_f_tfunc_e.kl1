:- module b_f_tfunc_e.
:- public go/0
,do_sin/2,do_cos/2,do_tan/2,do_asin/2,do_acos/2,do_atan/2,do_sinh/2,do_cosh/2,do_tanh/2,do_atan2/3.

go:- put_console(ascii#"%%% KL1-B Test for B_Float_Tri_Function (Exception) %%%"), put_console(key#lf) | sin.

sin:- put_console(ascii#"% B_Float_Sin %%%%%%%%%%% ") | sin00.

sin00:- true | execute_in_shoen(do_sin,{3.141592654,Z},R), sin00(R,Z).
sin00(success,_):- put_console(c#"a") | sin01.
otherwise.
sin00(_,_):- put_console(c#"*") | sin01.

sin01:- true | execute_in_shoen(do_sin,{0.0,Z},R), sin01(R,Z).
sin01(success,_):- put_console(c#"b") | sin02.
otherwise.
sin01(_,_):- put_console(c#"*") | sin02.

sin02:- true | execute_in_shoen(do_sin,{1234,Z},R), sin02(R,Z).
sin02(illegal_input,_):- put_console(c#"c") | sin03.
otherwise.
sin02(_,_):- put_console(c#"*") | sin03.

sin03:- true | execute_in_shoen(do_sin,{atom,Z},R), sin03(R,Z).
sin03(illegal_input,_):- put_console(c#"d") | sin04.
otherwise.
sin03(_,_):- put_console(c#"*") | sin04.

sin04:- true | execute_in_shoen(do_sin,{[list],Z},R), sin04(R,Z).
sin04(illegal_input,_):- put_console(c#"e") | sin05.
otherwise.
sin04(_,_):- put_console(c#"*") | sin05.

sin05:- true | execute_in_shoen(do_sin,{{0,1},Z},R), sin05(R,Z).
sin05(illegal_input,_):- put_console(c#"f") | sin06.
otherwise.
sin05(_,_):- put_console(c#"*") | sin06.

sin06:- true | execute_in_shoen(do_sin,{ascii#"String",Z},R), sin06(R,Z).
sin06(illegal_input,_):- put_console(c#"g") | sin07.
otherwise.
sin06(_,_):- put_console(c#"*") | sin07.

