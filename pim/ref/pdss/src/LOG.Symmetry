% ls
DISTRIBUTE	README		doc.e/		mpimos/		test/
INSTALL		README.J	doc.j/		pdsscmp*
INSTALL.J	compiler/	emacs/		pimos_utl/
LOG		compiler_pl/	emulator/	runtime/
Makefile	debug_utl/	macro/		sample/
% 
% 
% make
	cd emulator	; make all
	touch pdss.h
	cc -O -c pdss.c
	cc -O -c option.c
	cc -O -c emulate.c
	cc -O -c blt_basic.c
	cc -O -c blt_float.c
	cc -O -c blt_shoen.c
	cc -O -c blt_iodev.c
	cc -O -c blt_code.c
	cc -O -c blt_system.c
	cc -O -c deref.c
	cc -O -c passive.c
	cc -O -c unify.c
	cc -O -c goal.c
	cc -O -c shoen.c
	cc -O -c exception.c
	cc -O -c memory.c
	cc -O -c atom.c
	cc -O -c module.c
	cc -O -c dcode.c
	cc -O -c float.c
	cc -O -c string.c
	cc -O -c gc.c
	cc -O -c gc_ctrl.c
	cc -O -c gc_cell.c
	cc -O -c gc_code.c
	cc -O -c gc_dead.c
	cc -O -c mrbgc.c
	cc -O -c instr.c
	cc -O -c invassm.c
	cc -O -c assemble.c
	cc -O -c saveload.c
	cc -O -c native.c
	cc -O -c tracer.c
	cc -O -c print.c
	cc -O -c io.c
	cc -O -c iosub.c
	cc -O -c timer.c
	cc -O -c path.c
	cc -O -c ctype.c
	cc -O -o pdss.x -D"MAKEDATE=\"`date`\"" version.c pdss.o option.o emulate.o blt_basic.o blt_float.o blt_shoen.o blt_iodev.o blt_code.o blt_system.o deref.o passive.o unify.o goal.o shoen.o exception.o memory.o atom.o module.o dcode.o float.o string.o gc.o gc_ctrl.o gc_cell.o gc_code.o gc_dead.o mrbgc.o instr.o invassm.o assemble.o saveload.o native.o tracer.o print.o io.o iosub.o timer.o path.o ctype.o -lm
	mv -f pdss.x pdss
	rm -f version.o
	cc -O -c pdssasm.c
	cc -O -o pdssasm.x -D"MAKEDATE=\"`date`\"" version.c pdssasm.o memory.o atom.o module.o instr.o assemble.o saveload.o float.o ctype.o -lm
	mv -f pdssasm.x pdssasm
	rm -f version.o
	cc -O -c pdssmerge.c
	cc -o pdssmerge.x pdssmerge.o
	mv -f pdssmerge.x pdssmerge
	sh -c "test ! -d compiler_pl || (cd compiler_pl ; make all)"
	echo "compile('pdss_sys.pl'), make_kl1cmp_for_pdss." | sicstus
