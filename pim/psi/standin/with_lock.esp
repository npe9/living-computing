% SCAFFOLDING stand-in for SIMPOS's class `with_lock`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: TM-065 p.13
% (and TM-061 p.7) name it only as a class that the real class `file`
% inherits, with `as_permanent_object` and `as_resource`; no method of it
% is printed or held.  Every method is INTERPOLATED (labelled) from:
%   - pimfep's fep_device_table and fep_node_table (natures `as_resource,
%     with_lock`): each table method sends `:lock(Table)`, does its work,
%     and ends with a last call `:unlock(Table)`;
%   - kappa2 `kernel/dbo/KP_DBOBF.ESP` (natures `as_resource, with_lock`,
%     ICOT Free Software, held), which brackets its work the same way with
%     `:lock_with_hook/1` and `:unlock_with_hook/1` (not stood in);
%   - the instance-level counterpart of as_class_with_lock (this
%     directory), whose :lock has :unlock as its alternative (kappa2
%     LOADER.ESP:145-146).  That with_lock's :lock does the same is an
%     INFERENCE.
%   - docs/simpos/required/classes.tsv:193, 267, 296: lock/1, locked/1 and
%     unlock/1 are sent through this nature;
%   - an instance-level user in held IFS source: kwic-esp
%     src/functions.esp:763-836, class fncRightOf (natures `as_resource,
%     with_lock`, :768-769), sends :lock/1 (:825, :832, :836), :unlock/1
%     (:796), :locked/1 (:802) and :locked/2 (:821, `:locked(Ri,
%     LockedProcess)`, not stood in).  It shows a waiting message around
%     the :lock at :827-836, so the real :lock blocks;
%   - TR-056 PDF p26 (folio 24): mutual exclusion "is implemented by an
%     object lock, so that each object has a stream for a lock"; TR-524
%     PDF p4 (folio 3): in the first SIMPOS file system "each user process
%     blocks a critical region using lock and unlock primitives".
% Model (OURS): a count in an instance slot; one process, so no wait
% (the real :lock blocks, above).

class with_lock has

instance

% INTERPOLATED: the representation (OURS).
attribute lock_count := 0;

% INTERPOLATED from: the fep_device_table brackets and LOADER.ESP:145-146
% (see above).
:lock(Object) :-
        N = Object!lock_count,
        Object!lock_count := N + 1;
:lock(Object) :-
        :unlock(Object),
        fail;

% INTERPOLATED from: fep_device_table's last call `:unlock(Table)`.
% Unlocking an object that is not locked succeeds (OURS).
:unlock(Object) :-
        N = Object!lock_count,
        0 < N, !,
        Object!lock_count := N - 1;
:unlock(Object);

% :lock_with_hook(Object), :unlock_with_hook(Object) -- window M4
% (2026-11-25), INTERPOLATED from: kappa2 kernel/dbo/KP_DBOBF.ESP (above:
% it brackets its work with them as fep_device_table does with
% lock/unlock) and pimfep##pimos_window_editor lock/2 @3f8 and unlock/2
% @3e8 (held cells: the window's text buffer, natures as_resource and
% with_lock here, is locked so around putb/4, getl/3, ungetb/4 and after
% attention/1).  What the hook is is UNKNOWN; here (OURS) each is lock/1
% and unlock/1.
:lock_with_hook(Object) :- :lock(Object);
% INTERPOLATED as lock_with_hook/1 above (the same USAGE; body OURS).
:unlock_with_hook(Object) :- :unlock(Object);

% INTERPOLATED from: the class-level :locked/1 (LOADER.ESP:134).
:locked(Object) :-
        N = Object!lock_count,
        0 < N;

end.
