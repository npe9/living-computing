% SCAFFOLDING, OURS: the screen of a Pmacs editor window, compiled by
% psi/espc.py into the package `simpos`.  `pmacs_display` is NOT a SIMPOS
% class name: Pmacs's display classes are lost (window.md §0.3, §2.11;
% IPSJ 22404 counts 93 Pmacs classes, none held).  Window milestone M10
% (2026-11-26).
%
% THE SCREEN FORM (SCREENSHOT: IPSJ 36239 p5-6; IPSJ 114012 Fig. 2;
% esp.wmv@108-149; window.md §2.11, §4.6): the text, then a reversed mode
% line, then an echo line below it.  Here the window's pane (window_pane.
% esp) is split by rows (OURS): the text in the first Rows - 2, the mode
% line in the next, the echo line in the last.
%   - THE MODE LINE (window.md §2.11, its fields from the screenshots):
%     `PMACS(fundamental)(C,R) *-N* Name Path --Top--`.  PMACS the editor
%     name; the major mode in parentheses, here always `fundamental`
%     (OURS: Emacs's name; the screenshots show `esp` for an .esp file and
%     no other mode is seen); `(C,R)` in the video's round brackets
%     (A00; the 1986 screenshots have `[w,h]`, VARIANT), here the text's
%     columns and rows (INFERENCE, window.md: "window size in
%     characters?"); `*-N*` the buffer's number in the pool
%     (editor_text_buffer.esp, INFERENCE); the buffer's name and the full
%     pathname of its file (the 1986 screenshot shows both, `demo
%     i3psi7::>sys>user>hiroyuki>demo.esp`; here without a host, as
%     retrieve/4 answers); `--Top--` when the first line shows, `--Bot--`
%     when the last does (OURS), `--N%--` otherwise, N the first shown
%     line's share of the lines (OURS: what Pmacs's percentage counts is
%     not printed; `--74%--` is seen).  Reversed: drawn, then the row
%     inverted by exclusive_or (as the menus' boxes are).  Cut at the
%     pane's width.
%   - THE ECHO LINE: the editor's last message (standard_editor message/2:
%     `Read! <path>` SCREENSHOT, the others OURS), cut at the width.
%   - THE TEXT: the buffer's lines from the first shown one, each cut at
%     the width (OURS: no continuation mark); the window's block cursor at
%     the point (window_pane.esp's cursor; a point past the last column
%     shows none).  The first shown line moves only to keep the point's
%     line on the screen (OURS: Emacs recentres).
% REDISPLAY (OURS): only what changed is drawn: each row's codes are kept
% and compared, so a key typed in a line redraws that row, and a moved
% point only moves the cursor.  Every drawing is a pane method, so it goes
% through the coordinator's uncover/unpeel (the output permission) as all
% window text does.

class pmacs_display has

% :create(#pmacs_display, Pane, Cols, Rows, Status, D) -- OURS selector:
% the screen of a pane of Cols x Rows cells; Status `off` (the held
% status_window(off) option) leaves the mode line out, so the echo line
% follows the text.
% INTERPOLATED (selector and body OURS): see the head comment.
:create(Class, Pane, Cols, Rows, Status, D) :-
        :new(Class, D),
        D!pane := Pane, D!cols := Cols, D!status := Status,
        text_rows(Status, Rows, T),
        D!rows := T;

instance

% OURS (see the head comment): the pane, the text's width and height in
% cells, the first shown line, the codes shown in each text row (a list of
% lists; none: not drawn), in the mode line and in the echo line (none:
% not drawn), the message to show.
attribute pane := 0, cols := 0, rows := 0, status := on, top := 0, shown := none,
          mode := none, echoed := none, message := [];
% pmacs.md §4.7 (2026-11-27), OURS: the views (1, or 2 after
% two_windows/1), the lower view's first shown line, its rows' codes and
% the upper view's mode line (none: not drawn).
attribute views := 1, top2 := 0, shown2 := none, mode2 := none;

% :redisplay(D, Buffer) -- OURS selector: the screen made to show Buffer.
% INTERPOLATED (selector and body OURS): see REDISPLAY in the head comment.
:redisplay(D, B) :-
        view(D, B, 0, D!rows, D!top, Top, D!shown, Shown, Ln, Col),
        D!top := Top, D!shown := Shown,
        mode_line(D, B, D!status, D!rows, Top, D!rows, mode, Next),
        echo_line(D, Next),
        :set_cursor(D!pane, Col, Ln - Top);

% :redisplay(D, B, Other, Active) -- pmacs.md §4.7 (2026-11-27), OURS
% selector: the screen split in two views (split/2), B in the active one
% (upper or lower), Other in the other; each view its text rows and a
% mode line, the upper's above the lower's text, then the echo line;
% the cursor in the active view.  INFERENCE (Emacs analogy, C-x 2: the
% held selector two_windows/1, cil ds_edt.esp:1037; pmacs.md §4.7).
% INTERPOLATED (selector and body OURS): see the note above.
:redisplay(D, B, Other, Active) :-
        halves(D!rows, H1, H2),
        which(Active, B, Other, Up, Low),
        view(D, Up, 0, H1, D!top, Top1, D!shown, Shown1, Ln1, Col1),
        D!top := Top1, D!shown := Shown1,
        mode_line(D, Up, on, H1, Top1, H1, mode2, _),
        value(H1 + 1, R2),
        view(D, Low, R2, H2, D!top2, Top2, D!shown2, Shown2, Ln2, Col2),
        D!top2 := Top2, D!shown2 := Shown2,
        mode_line(D, Low, D!status, D!rows, Top2, H2, mode, Next),
        echo_line(D, Next),
        cursor(D, Active, Col1, Ln1 - Top1, Col2, Ln2 - Top2 + R2);

% :split(D, On) -- pmacs.md §4.7, OURS selector: two views (On `on`),
% or one (`off`); fails for `on` when the text has fewer than 3 rows.
% Every row is drawn again at the next redisplay.  OURS.
% INTERPOLATED (selector and body OURS): see the note above.
:split(D, on) :- D!rows >= 3, !, D!views := 2, D!top2 := D!top, :forget(D);
:split(D, off) :- D!views := 1, :forget(D);

% :view_rows(D, Active, R0, H, Top) -- pmacs.md §4.6, OURS selector: the
% active view's first pane row, text rows and first shown line (for
% cursor_with_mouse/1 and the page commands).  OURS.
% INTERPOLATED (selector and body OURS): see the note above.
:view_rows(D, _, 0, H, Top) :- D!views == 1, !, H = D!rows, Top = D!top;
:view_rows(D, upper, 0, H1, Top) :- !, halves(D!rows, H1, _), Top = D!top;
:view_rows(D, lower, R0, H2, Top) :- halves(D!rows, H1, H2), value(H1 + 1, R0), Top = D!top2;

% :set_view_top(D, Active, Top) -- pmacs.md §4.6, OURS selector: the
% active view's first shown line (the page commands), every row of the
% view drawn again.  OURS.
% INTERPOLATED (selector and body OURS): see the note above.
:set_view_top(D, lower, Top) :- D!views == 2, !, D!top2 := Top, D!shown2 := none;
:set_view_top(D, _, Top) :- D!top := Top, D!shown := none;

% :message(D, String) -- OURS selector: the echo line's text from now on
% (drawn at the next redisplay).
% INTERPOLATED (selector and body OURS): see THE ECHO LINE.
:message(D, S) :- string(S, N, _), codes(S, 0, N, Codes), D!message := Codes;

% :forget(D) -- OURS selector: nothing is on the screen any more (the
% pane was drawn again): every row is drawn at the next redisplay.
% INTERPOLATED (selector and body OURS): see REDISPLAY.
:forget(D) :- D!shown := none, D!mode := none, D!echoed := none,
        D!shown2 := none, D!mode2 := none;

local

text_rows(off, R, 1) :- R < 2, !;
text_rows(off, R, T) :- !, value(R - 1, T);
text_rows(_, R, 1) :- R < 3, !;
text_rows(_, R, T) :- value(R - 2, T);

% the mode line (none with status off) at row R, for a view of H rows
% whose first shown line is Top, its codes cached in the slot Cache;
% Next, the row after it
mode_line(_, _, off, R, _, _, _, R) :- !;
mode_line(D, B, _, R, Top, H, Cache, Next) :-
        count_lines(B!text, 1, Lines),
        mode_codes(D, B, Lines, Top, H, Mode),
        cached(D, Cache, Was),
        drawn_line(D, R, Mode, Was, reverse),
        cache(D, Cache, Mode),
        value(R + 1, Next);

cached(D, mode, X) :- X = D!mode;
cached(D, mode2, X) :- X = D!mode2;

cache(D, mode, X) :- D!mode := X;
cache(D, mode2, X) :- D!mode2 := X;

% the echo line at row R
echo_line(D, R) :-
        cut(D!message, D!cols, Echo),
        drawn_line(D, R, Echo, D!echoed, copy),
        D!echoed := Echo;

% one view: B's lines from its first shown line Top0 (moved to keep the
% point's line Ln in its H rows: Top) drawn from pane row R0 where they
% differ from Shown0 (none: all); Col the point's column
view(D, B, R0, H, Top0, Top, Shown0, Shown, Ln, Col) :-
        Text = B!text,
        line_of(Text, B!point, Ln, Col),
        scrolled(Ln, Top0, H, Top),
        kept(Top, Top0, Shown0, Old),
        drop_lines(Text, Top, Rest),
        taken(Rest, H, D!cols, Rows),
        drawn_rows(D, Rows, Old, R0, Shown);

kept(T, T0, Old, Old) :- T == T0, !;
kept(_, _, _, none);

halves(T, H1, H2) :- value((T - 1) / 2, H1), value(T - 1 - H1, H2);

which(upper, B, O, B, O);
which(lower, B, O, O, B);

cursor(D, upper, C, R, _, _) :- :set_cursor(D!pane, C, R);
cursor(D, lower, _, _, C, R) :- :set_cursor(D!pane, C, R);

value(V, V);

% the line (from 0) and column of position P
line_of(Text, P, Ln, Col) :- walk(Text, P, 0, 0, Ln, Col);

walk(_, 0, L, C, L, C) :- !;
walk([10 | R], P, L, _, Ln, Col) :- !, walk(R, P - 1, L + 1, 0, Ln, Col);
walk([_ | R], P, L, C, Ln, Col) :- walk(R, P - 1, L, C + 1, Ln, Col);

% the first shown line keeps line Ln in the H rows from Top0
scrolled(Ln, Top0, _, Ln) :- Ln < Top0, !;
scrolled(Ln, Top0, H, T) :- Ln >= Top0 + H, !, value(Ln - H + 1, T);
scrolled(_, Top0, _, Top0);

drop_lines(Text, 0, Text) :- !;
drop_lines([], _, []) :- !;
drop_lines([10 | R], N, Rest) :- !, drop_lines(R, N - 1, Rest);
drop_lines([_ | R], N, Rest) :- drop_lines(R, N, Rest);

% N rows: the next lines' codes, each cut at Cols ([] past the end)
taken(_, 0, _, []) :- !;
taken(Text, N, Cols, [Row | Rows]) :-
        a_line(Text, Line, Rest), cut(Line, Cols, Row),
        taken(Rest, N - 1, Cols, Rows);

a_line([], [], []) :- !;
a_line([10 | R], [], R) :- !;
a_line([C | R], [C | L], Rest) :- a_line(R, L, Rest);

cut(_, 0, []) :- !;
cut([], _, []) :- !;
cut([C | R], N, [C | L]) :- cut(R, N - 1, L);

count_lines([], N, N);
count_lines([10 | R], N0, N) :- !, count_lines(R, N0 + 1, N);
count_lines([_ | R], N0, N) :- count_lines(R, N0, N);

% each text row drawn where it differs from what is shown
drawn_rows(_, [], _, _, []);
drawn_rows(D, [Row | Rows], Old, R, [Row | Shown]) :-
        old_row(Old, Was, Older),
        drawn_line(D, R, Row, Was, copy),
        drawn_rows(D, Rows, Older, R + 1, Shown);

old_row(none, none, none) :- !;
old_row([W | Ws], W, Ws) :- !;
old_row([], none, none);

drawn_line(_, _, Codes, Was, _) :- same(Codes, Was), !;
drawn_line(D, R, Codes, _, Op) :- :draw_row(D!pane, R, Codes, Op);

same([], []);
same([X | A], [Y | B]) :- X == Y, same(A, B);

% the mode line's codes (see THE MODE LINE)
mode_codes(D, B, Lines, Top, H, Codes) :-
        number_codes(D!cols, Cs), number_codes(H, Rs),
        number_codes(B!number, Ns),
        name_codes(B, Name), path_codes(B, Path),
        place(Top, H, Lines, Place),
        string_codes("PMACS(fundamental)(", P1),
        string_codes(",", P2), string_codes(") *-", P3), string_codes("* ", P4),
        string_codes(" ", P5),
        append(P1, Cs, A1), append(A1, P2, A2), append(A2, Rs, A3),
        append(A3, P3, A4), append(A4, Ns, A5), append(A5, P4, A6),
        append(A6, Name, A7), append(A7, P5, A8), append(A8, Path, A9),
        append(A9, Place, All),
        cut(All, D!cols, Codes);

name_codes(B, Codes) :- string_codes(B!name, Codes);

path_codes(B, []) :- B!file == 0, !;
path_codes(B, Codes) :- F = B!file, string_codes(F!full_name, Codes);

place(0, _, _, Codes) :- !, string_codes(" --Top--", Codes);
place(Top, H, Lines, Codes) :- Top + H >= Lines, !, string_codes(" --Bot--", Codes);
place(Top, _, Lines, Codes) :-
        quotient(Top * 100, Lines, Q), number_codes(Q, Ds),
        string_codes(" --", A), string_codes("%--", B),
        append(A, Ds, A1), append(A1, B, Codes);

string_codes(S, Codes) :- string(S, N, _), codes(S, 0, N, Codes);

codes(_, I, N, []) :- I >= N, !;
codes(S, I, N, [C | Cs]) :- string_element(S, I, C), codes(S, I + 1, N, Cs);

% the JIS digits of N >= 0 (16#2330 is `0`, as espc's #"0")
number_codes(N, [C]) :- N < 10, !, digit(N, C);
number_codes(N, Cs) :-
        value(N / 10, Q), value(N - Q * 10, R),
        number_codes(Q, Qs), digit(R, C),
        append(Qs, [C], Cs);

digit(N, C) :- Zero = 16#"2330", value(Zero + N, C);

% N / D for a D in a register, by subtraction (OURS arithmetic: espc
% divides only by a constant)
quotient(N, D, 0) :- N < D, !;
quotient(N, D, Q) :- quotient(N - D, D, Q0), value(Q0 + 1, Q);

append([], L, L);
append([X | R], L, [X | T]) :- append(R, L, T);

end.
