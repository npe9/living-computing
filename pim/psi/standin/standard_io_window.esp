% SCAFFOLDING stand-in for SIMPOS's class `standard_io_window`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: the window
% classes are lost (docs/simpos/subsystems/window.md), and NO DISPLAY IS
% MODELLED.  Step 3l, route step B6 (the window system), MINIMAL: what
% pimfep##pimos_login_requester sends before it waits for its first
% answer.  A window here is a transcript (the lines put, newest first) and
% an input stream (the keyboard, OURS: a `stream`, TM-100 Fig. 3.6, so a
% read waits until a term is put).
% USAGE (held cells, read 2026-11-25), pimfep##pimos_login_requester:
%   - local initiate/1 @af-d7: `:create(#standard_io_window, Opts, W)`
%     (the argument order of the cells @af-b4: A0 the options, A1 the new
%     window, as pmacs_window's create/3; Opts pool[10]: size {ch,40} by {ch,7}, position manipulator, nature
%     [with_icon]), set_font/2, set_label_font/2, set_title/2,
%     activate/1;
%   - local read/4 @dc-12c: clear/1, show/1, `:putl(W, "Enter FEP node
%     name--------->")`, `:read(W, Code)` @f3 (ONE character code: the
%     next local, check_code/4 @1a5, compares it with the integer 0x2121,
%     the JIS space, and its last clause @1e9-1eb gives it back with
%     `:input_data(W, Code)`), then `:getl(W, Line)` @100; the same for
%     the user name (@10a-11b); for the password `inhibit_echo/1` @122,
%     read_password/3's loop ($or$0/4 @32a-34c: `:read(W, C)` per
%     character, ending at code 13), `permit_echo/1` @129, `clear/1` @12c;
%   - local wait/1 @15d-16e: beep/1 twice, clear_buffer/1, read/2;
%   - local exit_program/1 @285-28e: kill/1.
% Everything below is OURS in its body; each method's selector is held.
%
% Step 3m: KEYBOARD INPUT (OURS path, shaped by the documented model):
%   - read/2 returns a character code (PRINTED-INTERFACE TM-125 p18,
%     docs/simpos/subsystems/window.md §2.7: "Code is a character code");
%     the codes are 16-bit JIS (INFERENCE: check_code/4 tests the JIS
%     space 0x2121, and the typed line is compared with the pool's 16-bit
%     "local", "exit", "close"); RETURN is 13 (INFERENCE: read_password's
%     loop ends at 13, @344);
%   - keyboard input goes to the SELECTED window (PROSE TM-225 p11, TM-115
%     p111; window.md §2.7, §4.1); the coordinator receives the keyboard
%     events (PRINTED prose TR-061, TR-046 PDF p26-p28) and keeps the
%     typed codes on its stream `keyboard` (OURS, coordinator.esp; since
%     window M7 each window's own stream, below); a
%     window becomes the selected one when it is shown (INFERENCE from
%     TM-225 p10-11, window.md §4.1: SHOW "changes the selected window",
%     and the selected window is on top and has the keyboard); a read on a window that is not selected waits (window.md
%     §4.1, 1.0 rule: only the selected window can be read; since M7
%     it waits until keys come to its own stream, below);
%   - input_data/2 "push[es] a synthetic event onto the window's input"
%     (USAGE, window.md §2.7).  Here the window's own queue `pending` is
%     read before the keyboard, and input_data/2 adds at its END (INFERENCE
%     from the two held senders: check_code/4's last clause gives back the
%     one code just read, and insert_string/4 @18d-1a0 gives a menu item's
%     string element 0 first, so the string keeps its order only if each
%     code goes behind the last);
%   - getl/2 reads codes to 13 and answers the string of the codes before
%     it, 16-bit (INFERENCE: the line is compared with equal_string to
%     16-bit pool strings; that 13 ends a line as it ends the password is
%     INFERENCE); window M11 (2026-11-26, OURS, for the live view): a
%     typed BS (key#bs, 8) or DEL (key#del, 127) takes the line's last
%     code back and, with echo on, rubs its character out (window_pane
%     rub_out/1), and is not echoed itself; with no code typed yet it does
%     nothing (INFERENCE that the PSI's line read had a rubout: no getl
%     body is held; no other line editing is modelled, OURS);
%   - echo: a code taken from the keyboard is echoed unless echo is
%     inhibited (INFERENCE from inhibit_echo/1 and permit_echo/1 bracketing
%     the password's reads); codes from `pending` are not echoed again
%     (OURS).  What is on the screen is not modelled; the echoed codes and
%     the lines put are kept in `history` (OURS), which clear/1 does not
%     empty, so a test can read the whole dialogue: a string is a line
%     put, an integer a code echoed, the atom `beep` a beep, newest first
%     (plain terms: kl0 copies the cells of a stored list, not of a
%     vector, so a vector's bindings would be lost on backtracking).
%
% Window M3/M5 (2026-11-25): THE WINDOW IS DRAWN.  Beside the transcript
% and history (kept: the step 3l/3m tests read them), the window owns a
% `pane` (window_pane.esp, OURS), its part of the screen, made when the
% window is first activated or shown; the pane draws on the display
% device through simpos##bitmap_display (psi/windev.py).  What each
% method draws, all OURS bodies under held selectors:
%   - activate/1, show/1: the window appears (border, label strip, rule)
%     at its size option in cells of its font, {size,{ch,C},{ch,R}} (the
%     held option, @af-b4), placed by its position option; the held
%     {position, manipulator} (the user sweeps the place, window.md
%     §4.5) centres it (OURS; on the mouse since M6, below).  No size option:
%     40 x 10 cells (OURS).  With no set_font/2 yet, the device's
%     substitute for the default font_13 (OURS, psi/windev.py).  The
%     label is drawn in the window's font (the held requester gives the
%     same font to set_font/2 and set_label_font/2, @c2-c6; OURS
%     otherwise);
%   - show/1 also selects: the previously selected window's cursor goes,
%     this window's block cursor appears (TM-126 p7, PROSE);
%   - set_title/2: the title in the label strip;
%   - putl/2: the line at the cursor, then a newline (window_pane.esp
%     for wrap, scroll, key#lf);
%   - an echoed code: drawn at the cursor; RETURN (13) as a newline
%     (INFERENCE: getl/2's line ends there); the password, read with echo
%     inhibited, draws nothing;
%   - clear/1: the inside cleared, the cursor home;
%   - kill/1: the window's rectangle cleared (OURS).
%
% Window M4/M6 (2026-11-25), all OURS bodies: the window registers with
% the coordinator when it opens (add_window/3: its number N, so the status
% band's box names it `standard_io_window/N`) and leaves on kill/1
% (remove_window/2); show/1 selects it through the coordinator
% (select_window/2, which also redraws the box); the left button on it
% selects it (contains/3); a key the coordinator gives it while selected
% (typed/2) goes on the coordinator's keyboard stream, where read/2 and
% getl/2 take it, as before (since M7 on the window's own stream).  The {position, manipulator} placement now
% centres the window on the mouse (window_pane.esp): at the mouse's start
% (640, 472) that is the old centred place, (417, 411).

% Window M7 (2026-11-25), keyboard focus and the manipulator, OURS bodies:
%   - each window reads its own input stream (`input`): typed/2 puts the
%     key there, and the coordinator sends typed/2 to the selected window
%     only (PROSE TM-225 p11, TM-115 p111: the selected window has the
%     keyboard).  Until M7 the keys went on the coordinator's one stream,
%     so the older of two waiting requesters took the next key.  A read
%     on a window that is not selected waits until keys come to it;
%   - kill/1 takes the pane off through the coordinator's stack
%     (take_off/2), so the windows above it are lifted first;
%   - reshape/5 keeps the manipulator's rectangle and has_been_reshaped/1
%     makes the pane again there (cells that fit, title, the transcript's
%     lines), unless a MOVE has already moved the pane there.

class standard_io_window has

% :create(#standard_io_window, Options, W) -- INTERPOLATED (body OURS):
% the options are kept, not acted on.
:create(Class, Options, W) :-
        :new(Class, W),
        W!options := Options,
        :create(#stream, Input),
        W!input := Input,
        permission(Options, P),
        W!permission := P,
        title_option(Options, W);

instance

% OURS representation (see above).  `input` (step 3l): since window M7
% the window's own input stream, where typed/2 puts the keys given to it
% while it is selected (the head comment, "Window M7, keyboard focus").
attribute options := [], font := 0, label_font := 0, title := 0,
          active := 0, shown := 0, transcript := [], input := 0,
          pending := [], echo := on, history := [], beeps := 0,
          killed := 0, pane := 0, number := 0;
% window M7, OURS: the rectangle given by reshape/5 ([X, Y, Wd, Ht]; []
% none).
attribute place := [];
% window M7, the output permission (out, wait, show or notify; window.md
% §4.1, coordinator.esp "OUTPUT PERMISSION"): the held create option
% `permission(P)` (USAGE: 63 `out`, 13 `show`) or set_permission/2; `out`
% when neither is given (OURS: TM-225 p11 makes ① wait the default).
attribute permission := out;

% MENDELS (2026-11-27): deactivate/1, INTERPOLATED: the selector
% PRINTED-INTERFACE TM-125 p16 (window.md §2.1); the body OURS, as pmacs_window's (off the screen,
% kept; activate/1 draws it again): kill/1's without the kill
% LABEL: RECONSTRUCTED-FROM-MANUAL (the selector, TM-125 p16; the body OURS)
:deactivate(W) :- W!active := 0, erased(W), :remove_window(#coordinator, W);

% MENDELS (2026-11-27): the window's name, distinct from its title
% (window.md §2.2: TM-125 Fig. 4 has separate LABEL and NAME attributes).
% OURS representation: 0 while no name is set.
attribute name := 0;

% INTERPOLATED: set_name/2 USAGE (euod RULED/ruled1.esp:623, the call
% shape); the body OURS: kept.
% LABEL: INFERENCE (the body OURS)
:set_name(W, N) :- W!name := N;

% INTERPOLATED: name/2 from MENDELS loader.esp load_MENDEL/2 (`:is_object(
% #symbolizer, W), :name(W, _)`: a test that the loader has run, its
% second clause loading the package otherwise).  The body OURS: the name
% set_name/2 gave; it fails while none is set (0).
% LABEL: INFERENCE
:name(W, N) :- W!name \== 0, N = W!name;

% INTERPOLATED (body OURS) from initiate/1 @c2.
:set_font(W, F) :- W!font := F;

% INTERPOLATED (body OURS) from initiate/1 @c6.
:set_label_font(W, F) :- W!label_font := F;

% INTERPOLATED (body OURS) from initiate/1 @cc.
:set_title(W, T) :- W!title := T, drawn_title(W);

% INTERPOLATED (body OURS) from initiate/1 @d7.
:activate(W) :- W!active := 1, open(W);

% INTERPOLATED (body OURS) from read/4 @e8: clear empties the transcript.
:clear(W) :- W!transcript := [], drawn(W, clear);

% INTERPOLATED (body OURS) from read/4 @eb: show marks the window shown;
% step 3m: it selects the window (window.md §4.1, TM-225 p10-11: showing
% a window "changes the selected window"; that show/1 always does is
% OURS).
:show(W) :-
        W!shown := 1, open(W),
        :select_window(#coordinator, W);

% :putl(W, Line) -- INTERPOLATED (body OURS) from read/4 @ef: the line
% joins the transcript (and, step 3m, the history).
:putl(W, Line) :-
        W!transcript := [Line | W!transcript],
        W!history := [Line | W!history],
        drawn_line(W, Line);

% MENDELS (2026-11-27): write_line/2 and write_lines/2, INTERPOLATED (the
% selectors PRINTED-INTERFACE TM-112 p16, window.md §2.3; USAGE MENDELS
% graph_sel.esp:32-33 on a standard_io_window made with no superior; the
% bodies OURS): the string at the cursor, no newline after it (a key#lf
% in it breaks the line, window_pane.esp put_string/2), kept with the
% transcript's lines (OURS: a line written in parts is kept in parts).
% LABEL: RECONSTRUCTED-FROM-MANUAL (TM-112 p16; the body OURS)
:write_line(W, S) :-
        W!transcript := [S | W!transcript],
        W!history := [S | W!history],
        drawn_string(W, S);
% INTERPOLATED (selector PRINTED-INTERFACE TM-112 p16; body as write_line/2)
% LABEL: RECONSTRUCTED-FROM-MANUAL (TM-112 p16, TM-134 p70; as write_line/2)
:write_lines(W, S) :- :write_line(W, S);

% MENDELS (2026-11-27): erase_cursor/1, INTERPOLATED (selector USAGE
% graph_sel.esp:34, window.md §2.3; body OURS): kept; the block cursor is
% drawn only while the window is selected (window_pane.esp).
% LABEL: INFERENCE (the name; kept, OURS)
:erase_cursor(W) :- W!text_cursor := off;

% MENDELS, OURS: erase_cursor/1's flag.
attribute text_cursor := on;

% MENDELS (2026-11-27): set_superior/2, INTERPOLATED (selector and
% arguments PRINTED-INTERFACE TM-125 p15 "set the superior window"; USAGE
% MENDELS graph_sel.esp:152; body OURS): kept, not acted on: this stand-in
% draws every standard_io_window as a top window (its superior(..) create
% option is not acted on either).
% LABEL: RECONSTRUCTED-FROM-MANUAL (TM-125 p15; kept only, OURS)
:set_superior(W, S) :- W!superior := S;

% MENDELS, OURS: the superior set (0: none).
attribute superior := 0;

% :read(W, Code) -- step 3m, INTERPOLATED (body OURS) from read/4 @f3
% and read_password/3: the next character code (see above); with none,
% the process waits.
:read(W, Code) :- next_code(W, Code);

% :getl(W, Line) -- step 3m, INTERPOLATED (body OURS) from read/4 @100,
% @11b: the codes up to RETURN (13), as a new 16-bit string.
:getl(W, Line) :-
        line(W, Codes),
        count(Codes, 0, N),
        new_string(Line, N, 16),
        fill(Codes, Line, 0);

% :input_data(W, Code) -- step 3m, INTERPOLATED (body OURS) from
% check_code/4 @1e9-1eb and insert_string/4 @199: Code joins the end of
% the window's own input queue.
:input_data(W, Code) :- append(W!pending, [Code], P), W!pending := P;

% step 3m, INTERPOLATED (body OURS) from read/4 @122.
:inhibit_echo(W) :- W!echo := off;

% step 3m, INTERPOLATED (body OURS) from read/4 @129.
:permit_echo(W) :- W!echo := on;

% step 3m, INTERPOLATED (body OURS) from wait/1 @164, @167: a beep is
% counted and kept in the history.
:beep(W) :- W!beeps := W!beeps + 1, W!history := [beep | W!history];

% step 3m, INTERPOLATED (body OURS) from wait/1 @16a: discard the pending
% input (window.md §2.7 "discard pending input", USAGE).
:clear_buffer(W) :- W!pending := [];

% step 3m, INTERPOLATED (body OURS) from exit_program/1 @28e.
:kill(W) :-
        W!killed := 1, W!active := 0, erased(W),
        :remove_window(#coordinator, W);

% :right_click(W, X, Y) -- window M10 (selector and body OURS): the
% coordinator's right button on the window; a plain window binds nothing
% to it (a Pmacs window opens its EDITOR MENU, pmacs_window.esp).
% INTERPOLATED (selector and body OURS): see above.
:right_click(W, X, Y);
% :left_click(W, X, Y) -- pmacs.md §4.6 (2026-11-27; selector and body
% OURS): the coordinator's left button on the window already selected; a
% plain window binds nothing to it (a Pmacs window moves its point there,
% pmacs_window.esp).
% INTERPOLATED (selector and body OURS): see above.
:left_click(W, X, Y);

% :reshape(W, X, Y, Width, Height) -- window M7, INTERPOLATED (body OURS)
% from window.md §2.1 reshape/5 `(W,X,Y,Wd,Ht)`, "move and resize at
% once" (USAGE cal-esp cpwindow.esp:85): the new outer rectangle is kept;
% has_been_reshaped/1 acts on it (the window manipulator sends both,
% coordinator.esp).
:reshape(W, X, Y, Wd, Ht) :- W!place := [X, Y, Wd, Ht];

% :has_been_reshaped(W) -- window M7, INTERPOLATED (body OURS) from
% window.md §2.1, §2.12: the reshape notifier's callback, sent after the
% geometry is set; its default primary is not printed (psi/README.md
% "Open").  OURS here: when the kept rectangle is not the pane's (a
% RESHAPE; a MOVE has moved the pane already), the pane is made again
% there, as many cells of its font as fit inside (at least 1 x 1), with
% the title and the lines of the transcript (the lines put since the
% last clear, oldest first: the echoed codes are not kept, so a typed
% line is lost), and the cursor if the window is selected.
:has_been_reshaped(W) :- W!pane == 0, !;
:has_been_reshaped(W) :- W!place = [X, Y, Wd, Ht], P = W!pane,
        X == P!x, Y == P!y, Wd == P!w, Ht == P!h, !;
:has_been_reshaped(W) :- W!place = [X, Y, Wd, Ht], !,
        P = W!pane,
        cells(Wd - 6, P!cw, Cols),
        cells(Ht - P!ch - 9, P!ch, Rows),
        erased(W),
        :create(#window_pane, X, Y, Cols, Rows, W!font, Q),
        W!pane := Q,
        drawn_title(W),
        reverse(W!transcript, [], Lines),
        put_lines(Q, Lines),
        reselect(W);
:has_been_reshaped(_);

% :set_permission(W, P) -- window M7, INTERPOLATED (body OURS) from
% window.md §2.2 `set_permission/2 (W,out|show|...)` (USAGE gog-esp
% DISPB3.ESP:377) and the four permissions of TM-125 p6 and the ATTRIBUTE
% dialogue (out, wait, show, notify; TM-125 p7 Fig. 4): fails on any
% other.
:set_permission(W, P) :- permission_name(P), W!permission := P;

% :has_been_selected(W) -- window M7, INTERPOLATED (body OURS): the
% select notifier's callback (window.md §2.1, §2.12: kappa pbwin's
% after-demon on it proves a SIMPOS primary; paragraph
% profiler_view_window defines its own).  The coordinator sends it after
% a window is selected (select_window/2).  This default primary does
% nothing (OURS); a held subclass's own method or demon runs instead or
% after it.
:has_been_selected(W);

% :deselect_window(W) -- window M5, INTERPOLATED (selector and body OURS)
% from TM-126 p7 (PROSE, window.md §4.1): another window was selected,
% so this one's cursor goes.
:deselect_window(W) :- drawn(W, deselect);

% Window M4/M6 (selectors and bodies OURS): the coordinator's side of
% selection (select_window/2: the cursor drawn), the keyboard (a key
% typed while this window is selected goes on the window's own input
% stream, which next_code reads: window M7; step 3m put it on the
% coordinator's keyboard stream), the mouse's hit test and
% the status band's name (coordinator.esp).
% INTERPOLATED (selector and body OURS): selected; basis above and in
% the head comment.
:selected(W) :- drawn(W, select);
% INTERPOLATED (selector and body OURS): typed; basis above and in
% the head comment.
:typed(W, Code) :- :put(W!input, Code);
% INTERPOLATED (selector and body OURS): contains; basis above and in
% the head comment.
:contains(W, X, Y) :- W!pane \== 0, :contains(W!pane, X, Y);
% INTERPOLATED (selector and body OURS): status_name; basis above and in
% the head comment.
:status_name(W, "standard_io_window", N) :- N = W!number;

% Window M8 (2026-11-26), GRAPHICS (window.md §2.5, owner `as_graphics`,
% INFERENCE; the plan's M8).  The selectors and argument forms are
% window.md §2.5's, each cited there: draw_line/5 and /8
% (PRINTED-INTERFACE TM-125 p17, TM-785 p40), /6 (VARIANT: paragraph's Op,
% gog's Width; an integer is taken as the width), /7 (USAGE gog
% KE_WINDOW.ESP:454); draw_rectangle/5, /7, /8 (TM-125 p17; IPSJ 36239 p5
% `...,1,filled,exclusive_or`); draw_filled_rectangle/6 and /8 (USAGE
% paragraph, TM-785 p40; the /8's sixth argument is unknown and ignored);
% draw_string/4, /5 (VARIANT: 1985's Op, the held Font; an op name is taken
% as the op), /6 (USAGE paragraph c_p_meter); transfer/8 (USAGE cil
% es_gin.esp:855); execute_graphics_command/2, a list of {Name, {Args}}
% (USAGE paragraph p_icon.esp:61, :176; g_window.esp:141-142 the
% five-element draw_string, :169 the seven-element draw_filled_rectangle
% with a held pattern); get_mouse_position/3 (SCREENSHOT
% IPSJ 36239 p5; USAGE).  The default op is exclusive_or ("default is
% exclusive or", PRINTED-INTERFACE TM-125 p17); the default line is 1 dot,
% solid.  OURS bodies, drawn by the pane (window_pane.esp "Window M8").
% Refused loudly (graphics_refused/2 is no method, OURS): a line style
% other than solid, a rectangle style other than solid or filled, a fill
% pattern that is neither fix, a named pattern nor a pattern string, a
% command execute_graphics_command/2 does not know, and drawing on a
% window that is not on the screen.
% Window M8's rest (2026-11-26), PATTERNS: draw_filled_rectangle/8 takes,
% beside fix, the named patterns light_paint, dotted, mesh, small_mesh,
% left_hatch and right_hatch (window.md §2.5; light_paint's dots
% HELD-DERIVED from paragraph's saved images, the others' looks OURS:
% window_pane.esp named/3) and a held pattern string: paragraph bar_v.esp
% set_pattern/2 makes one by new_string(S, 256, 16) and set_pattern1/4, /6,
% /10, which write each word four times running (words N..N+3 the first,
% N+4..N+7 the second, ...).  The string is read as a 64 x 64 tile, 4 words
% a row, so every row repeats one word and the rows cycle through the
% words given (INFERENCE: the 4-fold repeat is what makes a row of 64 dots;
% read as 1 word a row, `16#"5555", 16#"AAAA"` would be stripes 4 rows
% high, not the 50% mesh the pair is everywhere else).  Drawn by the pane
% (window_pane.esp pattern_in/7) with styled lines of the frozen device.
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_line.
:draw_line(W, X1, Y1, X2, Y2) :- line(W, X1, Y1, X2, Y2, 1, solid, exclusive_or);
:draw_line(W, X1, Y1, X2, Y2, A) :- integer(A), !,
        line(W, X1, Y1, X2, Y2, A, solid, exclusive_or);
:draw_line(W, X1, Y1, X2, Y2, Op) :- line(W, X1, Y1, X2, Y2, 1, solid, Op);
:draw_line(W, X1, Y1, X2, Y2, Wd, St) :- line(W, X1, Y1, X2, Y2, Wd, St, exclusive_or);
:draw_line(W, X1, Y1, X2, Y2, Wd, St, Op) :- line(W, X1, Y1, X2, Y2, Wd, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_rectangle.
:draw_rectangle(W, X, Y, Wd, Ht) :- rectangle(W, X, Y, Wd, Ht, 1, solid, exclusive_or);
:draw_rectangle(W, X, Y, Wd, Ht, L, St) :- rectangle(W, X, Y, Wd, Ht, L, St, exclusive_or);
:draw_rectangle(W, X, Y, Wd, Ht, L, St, Op) :- rectangle(W, X, Y, Wd, Ht, L, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_filled_rectangle.
:draw_filled_rectangle(W, X, Y, Wd, Ht, Op) :- pane_of(W, P), :fill_in(P, X, Y, Wd, Ht, Op);
:draw_filled_rectangle(W, X, Y, Wd, Ht, _, fix, Op) :- !,
        pane_of(W, P), :fill_in(P, X, Y, Wd, Ht, Op);
:draw_filled_rectangle(W, X, Y, Wd, Ht, _, Pt, Op) :- :pattern(#window_pane, Pt), !,
        pane_of(W, P), :pattern_in(P, X, Y, Wd, Ht, Pt, Op);
:draw_filled_rectangle(W, _, _, _, _, _, Pattern, _) :- :graphics_refused(W, Pattern);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_string.
:draw_string(W, X, Y, S) :- pane_of(W, P), :draw_string_in(P, X, Y, S, 0, exclusive_or);
:draw_string(W, X, Y, S, Op) :- op_name(Op), !, pane_of(W, P), :draw_string_in(P, X, Y, S, 0, Op);
:draw_string(W, X, Y, S, Font) :- pane_of(W, P), :draw_string_in(P, X, Y, S, Font, exclusive_or);
:draw_string(W, X, Y, S, Font, Op) :- pane_of(W, P), :draw_string_in(P, X, Y, S, Font, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): transfer.
:transfer(W, SX, SY, DX, DY, Wd, Ht, Op) :-
        pane_of(W, P), :transfer_in(P, SX, SY, DX, DY, Wd, Ht, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): execute_graphics_command.
:execute_graphics_command(W, []) :- !;
:execute_graphics_command(W, [{Name, Args} | Cs]) :-
        stack_vector(Args, N), !,
        command(W, Name, N, Args),
        :execute_graphics_command(W, Cs);
:execute_graphics_command(W, _) :- :graphics_refused(W, command);
% Window M8's rest (2026-11-26), IMAGES: restore_image/6 `(W, S, X, Y,
% Width, Height)` (USAGE paragraph p_imag.esp:22 restore/7, p_v_imag.esp
% :19, :252) draws an image string, opaque (window_pane.esp image_in/6);
% get_label_height/2 (USAGE paragraph p_imag.esp:619 adjust_pos/3, cil
% ds_brs.esp:280; window.md §2.2) answers the label strip's height, the
% font's cell plus 2 (window_pane.esp's layout, OURS).
% restore_full_color_image/6 is not stood in (the colour form is never
% reached on the 1-plane screen, bitmap.esp); save_image/6 is, below.
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): restore_image.
:restore_image(W, S, X, Y, Wd, Ht) :- pane_of(W, P), :restore_image_in(P, S, X, Y, Wd, Ht);
% INTERPOLATED (selector: window.md section 2.2, cited above; body OURS):
% get_label_height.
:get_label_height(W, H) :- pane_of(W, P), value(P!ch + 2, H);
% Window M8's stops, step 2 (2026-11-26), READING DOTS BACK on the device's
% read (the 2026-11-26 extension, OURS, owner-approved; window_pane.esp
% read_in/6, point_in/4): save_image/6 `(W, String, X, Y, Width, Height)`
% (USAGE paragraph p_imag.esp:198, p_v_imag.esp:228) fills the caller's
% 16-bit string, ceil(Width/16) words a row x Height (one plane:
% get_plane_count is 1 here, bitmap.esp), restore_image/6's layout;
% get_point_value/4 `(W, X, Y, ^Value)` and set_point_value/4 `(W, X, Y,
% Value)` (PRINTED-INTERFACE TM-125 p17: "the value (0/1) of the pixel";
% the value is the saved images' sense, 1 = white, INFERENCE 2026-11-26,
% window_pane.esp read_in/6; so set as a 1 x 1 fill, reset for 1 and set
% for 0, OURS; another value refuses loudly).  save_image/6 and
% restore_image/6 take (X, Y) from the pane's image origin
% (window_pane.esp save_image_in/6: MEASURED (3, 8) above-left of the
% inside of a window never shown).
% INTERPOLATED (selector and arguments: window.md section 2.5, cited
% above; body OURS): save_image.
:save_image(W, S, X, Y, Wd, Ht) :- pane_of(W, P), :save_image_in(P, S, X, Y, Wd, Ht);
% INTERPOLATED (selector and arguments: TM-125 p17, cited above; body
% OURS): get_point_value.
:get_point_value(W, X, Y, V) :- pane_of(W, P), :point_in(P, X, Y, V);
% INTERPOLATED (selector and arguments: TM-125 p17, cited above; body
% OURS): set_point_value.
:set_point_value(W, X, Y, 1) :- !, pane_of(W, P), :fill_in(P, X, Y, 1, 1, reset);
:set_point_value(W, X, Y, 0) :- !, pane_of(W, P), :fill_in(P, X, Y, 1, 1, set);
:set_point_value(W, _, _, _) :- :graphics_refused(W, point_value);
% Window M8's rest (2026-11-26), SHAPES (window.md §2.5): draw_circle/7
% `(W, CX, CY, R, Width, Style, Op)` (PRINTED WINCS p3), draw_ellipse/8
% `(W, CX, CY, RX, RY, Width, Style, Op)`, draw_arc/9 and draw_fan/9
% `(W, CX, CY, R, A1, A2, Width, Style, Op)`, draw_elliptical_arc/10
% `(W, CX, CY, RX, RY, A1, A2, Width, Style, Op)`, draw_filled_circle/7
% `(W, CX, CY, R, _, Pattern, Op)`, draw_filled_fan/9 `(W, CX, CY, R, A1,
% A2, _, Pattern, Op)` (each PRINTED-INTERFACE TM-785 p40, the vector
% data/2 gives, the arity INFERENCE from its length); draw_filled_circle/5
% `(W, CX, CY, R, Op)` (USAGE gog DISPB2.ESP:94); draw_filled_ellipse/8
% `(W, CX, CY, RX, RY, _, Pattern, Op)` (USAGE icotext) and /6 `(W, CX,
% CY, RX, RY, Op)` (USAGE gog), and /7 `(W, CX, CY, RX, RY, Pattern, Op)`
% (INFERENCE: TM-785 p40 prints a six-element vector `{200, 0, 100, 1,
% dotted, set}`, one element short; the method's own comment); draw_graph/2 and
% draw_polygon/2 `(W, [(X, Y), ...])` (USAGE kwic scrolls.esp:1135),
% /9 `(W, Points, _, _, _, _, Width, Style, Op)` (TM-785 p40: elements 1-4
% are unknown and ignored).  The angles are whole degrees, anticlockwise
% from the centre's right; the dots are window_pane.esp shape_in/9's,
% fan_in/8's and lines_in/5's (OURS).  A polygon is closed, a graph is
% not (OURS: the held draw_graph/2 caller closes its own marks).  The /2
% forms are 1 dot, solid, exclusive_or (TM-125 p17's defaults).  Refused
% loudly: a style other than solid, a width under 1, an op that is not an
% op name (TM-785 p40's integer ops are colours; the screen has none),
% a negative angle, a pattern that is neither fix nor a pattern.
% Window M8's rest, COPY: copy/9 `(W, Src, SX, SY, DX, DY, Width, Height,
% Op)` (USAGE icotext util_scroll.esp:211: from Src's (SX, SY) to W's
% (DX, DY), the direction INFERENCE, window.md §2.5) between two shown
% windows (window_pane.esp copy_in/9).  Refused loudly: Src not a shown
% window (util_scroll's own source is a 2000 x 2000 `hide_window` never
% shown; since step 3 of m8_stops.md such a window is a surface pane, but
% 2000 x 2000 is 250,000 words and bitmap memory 65,536: bitmap_memory;
% a smaller one refuses surface_copy), an op that is not an op name.  The
% other held form `(W, DX, DY, Src, SX, SY, Width, Height, Matrix)`
% (util_scroll.esp :218, :222) is stood in for whole scales since step 4
% ("THE MATRIX FORM" below).
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): copy.
% Window M8's stops, step 4 (2026-11-26), THE MATRIX FORM: copy/9 `(W, DX,
% DY, Src, SX, SY, Width, Height, Matrix)` (USAGE icotext util_scroll.esp
% :218-224, :245-251; docs/simpos/m8_stops.md §5).  Matrix {A, B, C, D, E,
% F} is read as a row-major 2 x 3 affine map from the source rectangle's
% top-left to (DX, DY), x' = A x + B y + C, y' = D x + E y + F (INFERENCE:
% the only layout that puts the held vectors' equal scales {2,0,0,0,2,0}
% at x and y).  Width x Height is the source's extent.  Stood in: whole
% scales A, E >= 1 with B = C = D = F = 0 (the one held matrix a caller
% reaches is {2,0,0,0,2,0}), nearest dot, opaque (window_pane.esp
% magnify_in/10, OURS).  Refused loudly: rotation or shear (B or D not
% 0), an offset, a scale below 1 or not whole (the held Min/Max and the
% commented-out 0.8 and 1.5), a destination leaving the inside.
% magnify/? and expand/9 (TM-785 p20 PROSE, euod def.esp:909 USAGE) are not
% stood in: no source fixes their arguments.
% INTERPOLATED (selector and arguments: USAGE, cited above; body OURS):
% copy.
:copy(W, DX, DY, Src, SX, SY, Wd, Ht, {A, 0, 0, 0, E, 0}) :-
        integer(DX), integer(A), integer(E), A >= 1, E >= 1, !,
        pane_of(W, P), pane_of(Src, Q), :magnify_in(P, Q, SX, SY, Wd, Ht, DX, DY, A, E);
:copy(W, Src, SX, SY, DX, DY, Wd, Ht, Op) :- integer(Src), !, :graphics_refused(W, matrix_copy);
:copy(W, Src, SX, SY, DX, DY, Wd, Ht, Op) :- op_name(Op), !,
        pane_of(W, P), pane_of(Src, Q), on_frame(W, P), on_frame(W, Q),
        :copy_in(P, Q, SX, SY, DX, DY, Wd, Ht, Op);
:copy(W, _, _, _, _, _, _, _, Op) :- :graphics_refused(W, Op);
% Window M8's stops, step 2 (2026-11-26), PAINT: paint/5 `(W, X, Y,
% Pattern, Op)` (USAGE kappa2 user_if/pb/pdim.esp:606 `:paint(OPicon1, 1,
% 1, Pattern1, set)`, gog DISPPBMS.esp:117, cil es_gin.esp:1761) fills the
% region around (X, Y): a seed fill (INFERENCE from the name and the one-dot
% seed), the region the 4-connected dots of the seed's value (OURS and
% INFERENCE: window_pane.esp paint_in/5), Pattern fix or a pattern through
% Op.  Refused loudly: an op that is not an op name, a pattern that is
% neither fix nor a pattern (as the filled shapes).
% INTERPOLATED (selector: window.md section 2.5, cited above; body OURS):
% paint.
:paint(W, X, Y, Pt, Op) :- op_name(Op), fill_pattern(Pt), !,
        pane_of(W, P), :paint_in(P, X, Y, Pt, Op);
:paint(W, _, _, Pt, _) :- :graphics_refused(W, Pt);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_circle.
:draw_circle(W, CX, CY, R, Wd, St, Op) :- outline(W, CX, CY, R, R, Wd, all, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_ellipse.
:draw_ellipse(W, CX, CY, RX, RY, Wd, St, Op) :- outline(W, CX, CY, RX, RY, Wd, all, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_arc.
:draw_arc(W, CX, CY, R, A1, A2, Wd, St, Op) :- angles(W, A1, A2), !,
        outline(W, CX, CY, R, R, Wd, {A1, A2}, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_elliptical_arc.
:draw_elliptical_arc(W, CX, CY, RX, RY, A1, A2, Wd, St, Op) :- angles(W, A1, A2), !,
        outline(W, CX, CY, RX, RY, Wd, {A1, A2}, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_fan.
:draw_fan(W, CX, CY, R, A1, A2, Wd, solid, Op) :-
        angles(W, A1, A2), drawing(W, Wd, Op), !,
        pane_of(W, P), :fan_in(P, CX, CY, R, A1, A2, Wd, Op);
:draw_fan(W, _, _, _, _, _, _, St, _) :- :graphics_refused(W, St);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_filled_circle.
:draw_filled_circle(W, CX, CY, R, Op) :- filled(W, CX, CY, R, R, all, fix, Op);
:draw_filled_circle(W, CX, CY, R, _, Pt, Op) :- filled(W, CX, CY, R, R, all, Pt, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_filled_ellipse.  Window M8's stops resolved (2026-11-26,
% docs/simpos/m8_stops.md §6): the held forms are /8 `(W, CX, CY, RX, RY,
% _, Pattern, Op)` (USAGE icotext imi_draw_win.esp:250-282, six sites
% `(...,0,fix,set|reset)`, and its util_scroll.esp:116-117, :315-316
% forwarders), the element after RY unknown and ignored as the filled
% circle's /7 ignores its own; and /6 `(W, CX, CY, RX, RY, Op)` (USAGE gog
% CGS_DEMO.ESP:416, :424), pattern fix as draw_filled_circle/5.  The /7
% `(W, CX, CY, RX, RY, Pattern, Op)` rests only on TM-785 p40's six-element
% vector, one element short of the held /8 layout (m8_stops.md §6): its
% order is INFERENCE, no held caller sends it, and it is kept.
:draw_filled_ellipse(W, CX, CY, RX, RY, Op) :- filled(W, CX, CY, RX, RY, all, fix, Op);
:draw_filled_ellipse(W, CX, CY, RX, RY, Pt, Op) :- filled(W, CX, CY, RX, RY, all, Pt, Op);
:draw_filled_ellipse(W, CX, CY, RX, RY, _, Pt, Op) :- filled(W, CX, CY, RX, RY, all, Pt, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_filled_fan.
:draw_filled_fan(W, CX, CY, R, A1, A2, _, Pt, Op) :- angles(W, A1, A2), !,
        filled(W, CX, CY, R, R, {A1, A2}, Pt, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_graph.
:draw_graph(W, Ps) :- polyline(W, Ps, 0, 1, solid, exclusive_or);
:draw_graph(W, Ps, _, _, _, _, Wd, St, Op) :- polyline(W, Ps, 0, Wd, St, Op);
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): draw_polygon.
:draw_polygon(W, Ps) :- polyline(W, Ps, 1, 1, solid, exclusive_or);
:draw_polygon(W, Ps, _, _, _, _, Wd, St, Op) :- polyline(W, Ps, 1, Wd, St, Op);
% the mouse in the window's inside, in dots (the window's units: no
% set_inside_units/3 is stood in)
% INTERPOLATED (selector and arguments: window.md section 2.5, cited above;
% body OURS): get_mouse_position.
:get_mouse_position(W, X, Y) :-
        pane_of(W, P), C = #coordinator,
        value(C!mouse_x - P!left, X), value(C!mouse_y - P!top, Y);

% Window M8, MARKERS (window.md §2.6, owner `as_markers`, INFERENCE): the
% selectors and arguments are PRINTED-INTERFACE TM-125 p17 (create_marker/2
% `(W,^M)`, draw_marker/2, erase_marker/2, move_marker/4 `(W,M,X,Y)`,
% set_marker_type/3 `(W,M,box|line)`, set_marker_size/4, get_marker_list/2);
% create_marker/7 `(W,X,Y,Width,Height,Type,^M)` is the CESP substitute's
% form (linguist with_marker.esp:21-25, an analogy only).  The bodies are
% OURS: a marker is drawn with exclusive_or (TM-125 p17's default op), so
% drawing it twice takes it off and what was under it comes back -- a box
% is the rectangle's 1-dot outline (draw_rectangle/5), a line runs from
% the marker's top-left to its bottom-right corner (draw_line/5), reverse
% inverts the area; create_marker/2 makes a 16 x 16 box at (0, 0) (OURS);
% a marker is made not drawn; moving, retyping or resizing a drawn marker
% takes it off and draws it again.  get_marker_position/4 (UNSPECIFIED,
% window.md §2.6) is not stood in.
attribute markers := [];

% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): create_marker.
:create_marker(W, M) :- :create_marker(W, 0, 0, 16, 16, box, M);
:create_marker(W, X, Y, Wd, Ht, Type, M) :- marker_type(Type), !,
        :create(#marker, W, X, Y, Wd, Ht, Type, M),
        append(W!markers, [M], Ms),
        W!markers := Ms;
:create_marker(W, _, _, _, _, Type, _) :- :graphics_refused(W, Type);
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): draw_marker.
:draw_marker(W, M) :- M!shown == 1, !;
:draw_marker(W, M) :- marker_drawn(W, M), M!shown := 1;
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): erase_marker.
:erase_marker(W, M) :- M!shown == 0, !;
:erase_marker(W, M) :- marker_drawn(W, M), M!shown := 0;
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): move_marker.
:move_marker(W, M, X, Y) :- S = M!shown,
        :erase_marker(W, M), M!x := X, M!y := Y, again(W, M, S);
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): set_marker_type.
:set_marker_type(W, M, Type) :- marker_type(Type), !, S = M!shown,
        :erase_marker(W, M), M!type := Type, again(W, M, S);
:set_marker_type(W, _, Type) :- :graphics_refused(W, Type);
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): set_marker_size.
:set_marker_size(W, M, Wd, Ht) :- S = M!shown,
        :erase_marker(W, M), M!w := Wd, M!h := Ht, again(W, M, S);
% INTERPOLATED (selector and arguments: window.md section 2.6, cited
% above; body OURS): get_marker_list, the window's markers in the order
% made.
:get_marker_list(W, Ms) :- Ms = W!markers;

local

% the window's own queue first, then the window's own input stream (M7:
% the keys the coordinator gave it while it was selected, typed/2)
next_code(W, Code) :- pop(W!pending, Code, Rest), !, W!pending := Rest;
next_code(W, Code) :-
        :get(W!input, Code),
        echo(W, Code);

pop([C | R], C, R);

append([], L, L);
append([X | R], L, [X | T]) :- append(R, L, T);

echo(W, Code) :- W!echo == on, !, W!history := [Code | W!history],
        drawn_code(W, Code);
echo(_, _);

% window M3/M5 (OURS, see the head comment): the pane, made once
open(W) :- P = W!pane, P \== 0, P!surface == 0, !;
open(W) :-
        cell_size(W, Cols, Rows),
        position(W!options, X, Y),
        :create(#window_pane, X, Y, Cols, Rows, W!font, P),
        S = W!pane,
        W!pane := P,
        :add_window(#coordinator, W, N),
        W!number := N,
        drawn_title(W),
        shown_surface(S, P);

% window M8's stops, step 3 (OURS): a window drawn on before activate/1
% shows what it drew (the surface pane's dots copied into the new pane's
% inside, its area freed)
shown_surface(0, _) :- !;
shown_surface(S, P) :- :shown_in(S, P);

% the pane's size in cells: the size option in cells, or in dots (as many
% cells of the font as fit, at least 1 x 1, OURS)
cell_size(W, Cols, Rows) :- dots(W!options, Wd, Ht), !,
        :cell_of(#window_pane, W!font, Cw, Ch),
        cells(Wd, Cw, Cols), cells(Ht, Ch, Rows);
cell_size(W, Cols, Rows) :- size(W!options, Cols, Rows);

size(Options, 40, 10) :- unbound(Options), !;
size([{size, {ch, C}, {ch, R}} | _], C, R) :- !;
size([_ | Os], C, R) :- !, size(Os, C, R);
size(_, 40, 10);

% MENDELS (2026-11-27): the create option title(T), USAGE (MENDELS
% loader.esp:12-15, 74-77 `title("WAIT !")`; window.md's option table),
% as set_title/2 would give it (OURS)
% LABEL: INFERENCE
title_option(Options, _) :- unbound(Options), !;
title_option([{title, T} | _], W) :- !, W!title := T;
title_option([_ | Os], W) :- !, title_option(Os, W);
title_option(_, _);

% the held option permission(P) (window M7); out when none
permission(Options, out) :- unbound(Options), !;
permission([{permission, P} | _], P) :- permission_name(P), !;
permission([_ | Os], P) :- !, permission(Os, P);
permission(_, out);

permission_name(out);
permission_name(wait);
permission_name(show);
permission_name(notify);

position(Options, manipulator, 0) :- unbound(Options), !;
position([{position, X, Y} | _], X, Y) :- !;
position([{position, manipulator} | _], manipulator, 0) :- !;
position([_ | Os], X, Y) :- !, position(Os, X, Y);
position(_, manipulator, 0);

drawn_title(W) :- W!pane \== 0, W!title \== 0, !, :set_title(W!pane, W!title);
drawn_title(_);

drawn(W, What) :- W!pane \== 0, !, pane_do(What, W!pane);
drawn(_, _);

pane_do(clear, P) :- :clear(P);
pane_do(select, P) :- :select(P);
pane_do(deselect, P) :- :deselect(P);

% window M7: the pane leaves the screen through the coordinator's stack
erased(W) :- P = W!pane, P \== 0, P!surface \== 0, !, :free(P), W!pane := 0;
erased(W) :- W!pane \== 0, !, :take_off(#coordinator, W);
erased(_);

% the cells of size C that fit in N dots, at least 1
cells(N, C, 1) :- N < C + C, !;
cells(N, C, K) :- cells(N - C, C, K0), value(K0 + 1, K);

value(V, V);

% window M8 (OURS, see "Window M8" above)
pane_of(W, P) :- P = W!pane, P \== 0, !;
% window M8's stops, step 3 (OURS): a window drawn on before it is shown
% draws into a surface pane (window_pane.esp create_surface/5), its inside
% the window's size option in dots (the held `size(Wd, Ht)`, paragraph
% p_imag.esp:171) or in cells (`{size, {ch, C}, {ch, R}}`, 40 x 10 when
% none); activate/1 copies it into the shown pane (open/1).  A killed
% window refuses.
pane_of(W, P) :- W!killed == 0, !,
        inside_size(W, Iw, Ih),
        :create_surface(#window_pane, Iw, Ih, W!font, P),
        W!pane := P;
pane_of(W, _) :- :graphics_refused(W, not_shown);

% window M8's stops, step 3 (OURS): copy/9 between two windows runs on the
% frame only; a window not shown (a surface pane) refuses loudly
% (surface_copy: icotext util_scroll.esp:211 copies from its never-shown
% 2000 x 2000 canvas, which bitmap memory cannot hold before H8 anyway)
on_frame(_, P) :- P!surface == 0, !;
on_frame(W, _) :- :graphics_refused(W, surface_copy);

inside_size(W, Iw, Ih) :- dots(W!options, Iw, Ih), !;
inside_size(W, Iw, Ih) :-
        size(W!options, Cols, Rows),
        :cell_of(#window_pane, W!font, Cw, Ch),
        times(Cols, Cw, Iw), times(Rows, Ch, Ih);

dots(Options, _, _) :- unbound(Options), !, fail;
dots([{size, Wd, Ht} | _], Wd, Ht) :- integer(Wd), integer(Ht), !;
dots([_ | Os], Wd, Ht) :- dots(Os, Wd, Ht);

times(N, C, P) :- times(N, C, 0, P);
times(0, _, P, P) :- !;
times(N, C, P0, P) :- times(N - 1, C, P0 + C, P);

line(W, X1, Y1, X2, Y2, Wd, solid, Op) :- !,
        pane_of(W, P), :draw_line_in(P, X1, Y1, X2, Y2, Wd, Op);
line(W, _, _, _, _, _, St, _) :- :graphics_refused(W, St);

rectangle(W, X, Y, Wd, Ht, L, solid, Op) :- !,
        pane_of(W, P), :frame_in(P, X, Y, Wd, Ht, L, Op);
rectangle(W, X, Y, Wd, Ht, _, filled, Op) :- !,
        pane_of(W, P), :fill_in(P, X, Y, Wd, Ht, Op);
rectangle(W, _, _, _, _, _, St, _) :- :graphics_refused(W, St);

% window M8's rest, shapes (OURS, see "SHAPES" above)
outline(W, CX, CY, RX, RY, Wd, As, solid, Op) :- drawing(W, Wd, Op), !,
        pane_of(W, P), :shape_in(P, CX, CY, RX, RY, Wd, As, fix, Op);
outline(W, _, _, _, _, _, _, St, _) :- :graphics_refused(W, St);

filled(W, CX, CY, RX, RY, As, Pt, Op) :- op_name(Op), fill_pattern(Pt), !,
        pane_of(W, P), :shape_in(P, CX, CY, RX, RY, 0, As, Pt, Op);
filled(W, _, _, _, _, _, Pt, _) :- :graphics_refused(W, Pt);

fill_pattern(fix) :- !;
fill_pattern(Pt) :- :pattern(#window_pane, Pt);

drawing(W, Wd, Op) :- integer(Wd), Wd >= 1, op_name(Op), !;
drawing(W, Wd, _) :- integer(Wd), Wd >= 1, !, :graphics_refused(W, op);
drawing(W, _, _) :- :graphics_refused(W, width);

angles(W, A1, A2) :- integer(A1), integer(A2), A1 >= 0, A2 >= 0, !;
angles(W, _, _) :- :graphics_refused(W, angle);

polyline(W, Ps, Close, Wd, solid, Op) :- drawing(W, Wd, Op), !,
        pane_of(W, P), :lines_in(P, Ps, Close, Wd, Op);
polyline(W, _, _, _, St, _) :- :graphics_refused(W, St);

op_name(set);
op_name(reset);
op_name(exclusive_or);
op_name(copy);
op_name(reverse);

% one command of execute_graphics_command/2: the method of that name
% with the vector's elements, sent to the window itself
command(W, draw_line, 4, A) :- !,
        el(A, 0, X1), el(A, 1, Y1), el(A, 2, X2), el(A, 3, Y2),
        :draw_line(W, X1, Y1, X2, Y2);
command(W, draw_line, 5, A) :- !,
        el(A, 0, X1), el(A, 1, Y1), el(A, 2, X2), el(A, 3, Y2), el(A, 4, B),
        :draw_line(W, X1, Y1, X2, Y2, B);
command(W, draw_line, 6, A) :- !,
        el(A, 0, X1), el(A, 1, Y1), el(A, 2, X2), el(A, 3, Y2), el(A, 4, Wd),
        el(A, 5, St),
        :draw_line(W, X1, Y1, X2, Y2, Wd, St);
command(W, draw_line, 7, A) :- !,
        el(A, 0, X1), el(A, 1, Y1), el(A, 2, X2), el(A, 3, Y2), el(A, 4, Wd),
        el(A, 5, St), el(A, 6, Op),
        :draw_line(W, X1, Y1, X2, Y2, Wd, St, Op);
command(W, draw_rectangle, 4, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, Wd), el(A, 3, Ht),
        :draw_rectangle(W, X, Y, Wd, Ht);
command(W, draw_rectangle, 7, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, Wd), el(A, 3, Ht), el(A, 4, L),
        el(A, 5, St), el(A, 6, Op),
        :draw_rectangle(W, X, Y, Wd, Ht, L, St, Op);
command(W, draw_filled_rectangle, 5, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, Wd), el(A, 3, Ht), el(A, 4, Op),
        :draw_filled_rectangle(W, X, Y, Wd, Ht, Op);
command(W, draw_filled_rectangle, 7, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, Wd), el(A, 3, Ht), el(A, 4, U),
        el(A, 5, Pt), el(A, 6, Op),
        :draw_filled_rectangle(W, X, Y, Wd, Ht, U, Pt, Op);
command(W, draw_string, 3, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, S),
        :draw_string(W, X, Y, S);
command(W, draw_string, 4, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, S), el(A, 3, B),
        :draw_string(W, X, Y, S, B);
command(W, draw_string, 5, A) :- !,
        el(A, 0, X), el(A, 1, Y), el(A, 2, S), el(A, 3, F), el(A, 4, Op),
        :draw_string(W, X, Y, S, F, Op);
% window M8's rest: the shapes (TM-785 p40's vectors)
command(W, draw_circle, 6, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, Wd), el(A, 4, St), el(A, 5, Op),
        :draw_circle(W, CX, CY, R, Wd, St, Op);
command(W, draw_filled_circle, 4, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, Op),
        :draw_filled_circle(W, CX, CY, R, Op);
command(W, draw_filled_circle, 6, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, U), el(A, 4, Pt), el(A, 5, Op),
        :draw_filled_circle(W, CX, CY, R, U, Pt, Op);
command(W, draw_ellipse, 7, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, RX), el(A, 3, RY), el(A, 4, Wd), el(A, 5, St), el(A, 6, Op),
        :draw_ellipse(W, CX, CY, RX, RY, Wd, St, Op);
% TM-785 p40's printed draw_filled_ellipse vector {200, 0, 100, 1, dotted,
% set} has six elements (read again at 600 dpi: not an OCR error), one
% short of the held /8 layout {CX, CY, RX, RY, _, Pattern, Op}, and no
% held method takes that arity (docs/simpos/m8_stops.md §6: none of the
% 18 SIMPOS archives, cil, paragraph or the 5 CESP archives has a /7).
% Which element was lost cannot be recovered, so it is refused loudly
% (OURS).  The seven-element vector is the held /8's.
command(W, draw_filled_ellipse, 6, _) :- !, :graphics_refused(W, draw_filled_ellipse);
command(W, draw_filled_ellipse, 7, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, RX), el(A, 3, RY), el(A, 4, U), el(A, 5, Pt), el(A, 6, Op),
        :draw_filled_ellipse(W, CX, CY, RX, RY, U, Pt, Op);
command(W, draw_arc, 8, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, A1), el(A, 4, A2), el(A, 5, Wd), el(A, 6, St), el(A, 7, Op),
        :draw_arc(W, CX, CY, R, A1, A2, Wd, St, Op);
command(W, draw_fan, 8, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, A1), el(A, 4, A2), el(A, 5, Wd), el(A, 6, St), el(A, 7, Op),
        :draw_fan(W, CX, CY, R, A1, A2, Wd, St, Op);
command(W, draw_filled_fan, 8, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, R), el(A, 3, A1), el(A, 4, A2), el(A, 5, U), el(A, 6, Pt), el(A, 7, Op),
        :draw_filled_fan(W, CX, CY, R, A1, A2, U, Pt, Op);
command(W, draw_elliptical_arc, 9, A) :- !,
        el(A, 0, CX), el(A, 1, CY), el(A, 2, RX), el(A, 3, RY), el(A, 4, A1), el(A, 5, A2), el(A, 6, Wd), el(A, 7, St), el(A, 8, Op),
        :draw_elliptical_arc(W, CX, CY, RX, RY, A1, A2, Wd, St, Op);
command(W, draw_graph, 8, A) :- !,
        el(A, 0, Ps), el(A, 1, U1), el(A, 2, U2), el(A, 3, U3), el(A, 4, U4), el(A, 5, Wd), el(A, 6, St), el(A, 7, Op),
        :draw_graph(W, Ps, U1, U2, U3, U4, Wd, St, Op);
command(W, draw_polygon, 8, A) :- !,
        el(A, 0, Ps), el(A, 1, U1), el(A, 2, U2), el(A, 3, U3), el(A, 4, U4), el(A, 5, Wd), el(A, 6, St), el(A, 7, Op),
        :draw_polygon(W, Ps, U1, U2, U3, U4, Wd, St, Op);
command(W, Name, _, _) :- :graphics_refused(W, Name);

el(A, I, V) :- vector_element(A, I, V);

% markers (OURS, see "MARKERS" above)
marker_type(box);
marker_type(line);
marker_type(reverse);

marker_drawn(W, M) :- T = M!type, T == box, !,
        :draw_rectangle(W, M!x, M!y, M!w, M!h);
marker_drawn(W, M) :- T = M!type, T == line, !,
        value(M!x + M!w - 1, X2), value(M!y + M!h - 1, Y2),
        :draw_line(W, M!x, M!y, X2, Y2);
marker_drawn(W, M) :-
        :draw_filled_rectangle(W, M!x, M!y, M!w, M!h, exclusive_or);

again(W, M, 1) :- !, :draw_marker(W, M);
again(_, _, _);

reverse([], L, L);
reverse([X | R], L0, L) :- reverse(R, [X | L0], L);

put_lines(_, []);
put_lines(P, [L | Ls]) :- :put_string(P, L), :new_line(P), put_lines(P, Ls);

reselect(W) :- S = #coordinator!selected, S == W, !, :select(W!pane);
reselect(_);

drawn_line(W, Line) :- W!pane \== 0, !, :put_string(W!pane, Line), :new_line(W!pane);
drawn_line(_, _);

drawn_string(W, S) :- W!pane \== 0, !, :put_string(W!pane, S);
drawn_string(_, _);

drawn_code(W, 13) :- W!pane \== 0, !, :new_line(W!pane);
drawn_code(_, C) :- rubout(C), !;
drawn_code(W, C) :- W!pane \== 0, !, :put_code(W!pane, C);
drawn_code(_, _);

% a typed line, kept newest first while it is read (window M11: BS and DEL
% take the last code back, the head comment)
line(W, Codes) :- line(W, [], R), reverse(R, [], Codes);
line(W, R, Codes) :- next_code(W, C), rest(W, C, R, Codes);
rest(_, 13, R, R) :- !;
rest(W, C, [_ | R], Codes) :- rubout(C), !, rubbed(W), line(W, R, Codes);
rest(W, C, [], Codes) :- rubout(C), !, line(W, [], Codes);
rest(W, C, R, Codes) :- line(W, [C | R], Codes);

rubout(8);
rubout(127);

rubbed(W) :- W!echo == on, W!pane \== 0, !, :rub_out(W!pane);
rubbed(_);

count([], N, N);
count([_ | R], N0, N) :- count(R, N0 + 1, N);

fill([], _, _);
fill([C | R], S, I) :- set_string_element(S, I, C), fill(R, S, I + 1);

end.
