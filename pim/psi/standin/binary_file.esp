% SCAFFOLDING stand-in for SIMPOS's class `binary_file`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS.  Step 3l,
% route step B5 (docs/simpos/boot_route.md).  MINIMAL: a file as the
% directory's retrieve returns it, with what the held callers on the route
% ask of it.
%
% PRINTED (TR-524 PDF p37, folio 36, App. A, page image read 2026-11-25):
% the class head of binary_file, natures remote_binary_file,
% binary_file_accessor, local_binary_file, p_binary_file, logical_file,
% with_retrieval, and external methods read/4, add/4, accessor/2,
% submit_add/5, wait/4, each a :g_call to the remote-or-local file
% manager.  None of those is stood in (the ROAM layer is lost); the
% natures are not declared here (OURS: no stand-in exists for them).
% TR-524 PDF p9 (folio 8): "binary files which are text files".
% Representation (OURS): name, version, size (bytes), full name, and the
% contents as a string of 16-bit codes (only for the text files the route
% reads, psi/simpos_fs.py); 0 otherwise.

class binary_file has

instance

% OURS representation (see the head comment).
attribute name := 0, version := 0, size := 0, full_name := 0, contents := 0;
% Window M10 (OURS): the directory the file is in (psi/simpos_fs.py mount
% sets it), for a save's new version.  :new_version(File, Contents, New)
% is a kl0 model (psi/kl0.py Machine.file_new_version, OURS selector):
% a new binary_file beside File with the next version and the text
% Contents (TR-524 PDF p9: versions are assigned by the file system and
% incremented every time a file is newly created).
attribute directory := 0;

% :is_directory(File) / :not_directory(File) -- INTERPOLATED from the held
% call sites pimfep##pimos_file local remove/2 @1d7-1e3 and
% check_file_size/1 @3d1-3e4 (directory.esp): a file is not a directory.
:is_directory(File) :- fail;
% INTERPOLATED: see is_directory/1 just above.
:not_directory(File);

% :size(File, Size) -- INTERPOLATED from the held calls in
% pimfep##pimos_file check_file_size/1 @3dc-3e2 (size/2 after
% not_directory/1, then compared with 1 by blt 55/54) and
% get_describe_info/2 @3c6-3c9; the unit, bytes, is OURS (the archive
% member's length).
:size(File, Size) :- Size = File!size;

% :full_name(File, Name) -- INTERPOLATED (selector OURS): the absolute
% pathname with its version, as retrieve/4 returns it (TR-524 PDF p9).
:full_name(File, Name) :- Name = File!full_name;

end.
