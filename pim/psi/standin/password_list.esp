% SCAFFOLDING stand-in for the object a SIMPOS process's password list is
% (class name OURS: `password_list`, after the process accessor
% password_list/2), compiled by psi/espc.py into the package `simpos`.  It
% is NOT SIMPOS: nothing of it is printed or held.  Step 3l, route step B7.
% USAGE (held cells, read 2026-11-25): pimfep##simpos_user setup_process/2
% @ee-102: `:password_list(Process, PL)`, `:set_access_mode(PL, Mode)` with
% the user's initial mode, `:set_passwords(PL, Passwords)` with the third
% argument of the user's passwords/3.  So the list is an object with an
% access mode and passwords (INFERENCE).  The process stand-in makes one
% on first use (process.esp password_list/2).

class password_list has

instance

% OURS representation.
attribute access_mode := 0, passwords := [];

% INTERPOLATED from setup_process/2 @f6-f9 (see above).
:set_access_mode(PL, Mode) :- PL!access_mode := Mode;
% INTERPOLATED (selector OURS, the reader of set_access_mode/2).
:access_mode(PL, Mode) :- Mode = PL!access_mode;
% INTERPOLATED from setup_process/2 @ff-102 (see above).
:set_passwords(PL, Passwords) :- PL!passwords := Passwords;
% INTERPOLATED (selector OURS, the reader of set_passwords/2).
:passwords(PL, Passwords) :- Passwords = PL!passwords;

end.
