% SCAFFOLDING stand-in for SIMPOS's class `standard_io_buffer`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: no body of it
% is printed or held.  MENDELS (IFS No.61, psi/mendels.py, 2026-11-27).
% MINIMAL: a text buffer that terms and strings are written to and read
% from, for MENDELS's conversions between a string and a term
% (esp_device.esp to_string/3, to_term/3; esp_util.esp put_message/2).
%
% PRINTED: the 1990 ESP manual, program-e.tex 6733-6745 (Example 3:
% create/2, putl/2, gett/2, putt/2, getl/2 and what they give).  The text
% methods (reset/1, reread/1, putl/2, putt/2, gett/2, getl/2) are kl0
% models, psi/mendels_simpos.py, whose docstring has each one's grade
% (PRINTED, INFERENCE from MENDELS's use, OURS).

class standard_io_buffer has

% :create(#standard_io_buffer, B) -- PRINTED: program-e.tex 6736-6737 (`?-
% :create(#standard_io_buffer,B).`); the body OURS: an empty buffer.
% LABEL: RECONSTRUCTED-FROM-MANUAL (the body OURS)
:create(Class, B) :-
        :new(Class, B),
        B!text := "",
        B!position := 0;

instance

% OURS representation: the text written and the read position in it.
attribute text := 0, position := 0;

% MENDELS (2026-11-27): the operator pool (0 until asked for).
attribute operators := 0;

% :get_parsing_operator(B, ^Pool) -- INTERPOLATED (selector and arguments
% USAGE MENDELS extern.esp:99-102, flat_data.esp:50-60 (the pool then
% receives add_operator/4), io_win.esp:151-154 (get, add, then
% set_parsing_operator/2); window.md §2.4 "operator pool for gett",
% INFERENCE; docs/simpos/subsystems/gaps.md G7; body OURS): the buffer's
% operator pool, made empty the first time (operator_pool.esp).  The
% reader of gett/2 (psi/mendels_simpos.py) does not consult it: a term
% that needs an added operator is refused there, loudly.
% LABEL: INFERENCE (the pool read for gett, USAGE; the pool OURS)
:get_parsing_operator(B, P) :- B!operators \== 0, !, P = B!operators;
:get_parsing_operator(B, P) :- :create(#operator_pool, P), B!operators := P;

% :set_parsing_operator(B, Pool) -- INTERPOLATED (selector and arguments
% USAGE MENDELS io_win.esp:154, window.md §2.4; body OURS): the pool kept.
% LABEL: INFERENCE (USAGE; the body OURS)
:set_parsing_operator(B, P) :- B!operators := P;

end.
