% SCAFFOLDING stand-in for SIMPOS's class `string`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: no part of
% `string` is printed.  Its two methods are the only ones held programs
% send (docs/simpos/required/classes.tsv: append/3, 1,039 call sites in
% 14 programs; copy/3, 7), and each is INTERPOLATED (labelled).
% Built-ins used (KL0, each with a known-plaintext row in
% psi/kl0_opcodes.tsv): string/3 (blt 0b), new_string/3 (blt 1c),
% string_element/3 (blt 23), set_string_element/3 (blt 2b).
% Model (OURS): the elements of a new string are the first string's size
% (step 3n, see append/3), 16-bit for an empty list (type 16, as
% p_tgraph.esp's `new_string(N,L,16)`); lengths are counted one by one,
% because adding two registers has no witnessed opcode.

class string has

% :append(#string, [S1, S2, ...], S) -- S is a new string holding the
% elements of S1, S2, ... in order.
% INTERPOLATED from: the call sites, e.g. paragraph p_what.esp
% `:append(#string,[S1,"::",S2,":",S3],S0)` and kappa2 inwin.esp
% `:append(#string,["INPUT WINDOW ","<TYPE : ",Type,">"],Title)` (a list
% of strings in, a string out; 1,039 sites, requirements.tsv), and the
% held SIMPOS source ported to CESP (morphana _simpos/pathname.esp:80,
% :86 and name.esp:110, :139, :257, e.g. `:append(#string,[Key,
% string#".",Version_string],Name)`).  Only strings are taken as
% elements (OURS).
% Step 3n: the new string's element size is the first string's (16 for
% an empty list), INTERPOLATED from pimfep##fep_message_assembler
% assemble/3 @56-75: it appends a 32-bit header (new_string(.., 32) @58)
% and 32-bit argument strings (substring/7 to 32 bits, @122) into the
% message, whose elements are words (PIMOS's packet, ref/pimm/fep.py
% pack_message; get_command/3 @14-1c reads a message only if it is 32-bit).
:append(Class, List, S) :-
        total(List, 0, L),
        size(List, T),
        new_string(S, L, T),
        fill(List, S, 0, _);

% :copy(#string, S, C) -- C is a new string with S's elements and type.
% INTERPOLATED from: the call sites (cal-esp grmenu.esp:186, kappa2 x3,
% kwic-esp x3; requirements.tsv) and the name.  The held SIMPOS source
% e_string.esp:67-70 (morphana _simpos/) copies, then changes the copy
% element by element (replace/4): the copy is a fresh string, mutable
% apart from the original.
:copy(Class, S, C) :-
        string(S, N, T),
        new_string(C, N, T),
        copy(S, 0, N, C, 0, _);

local
size([], 16) :- !;
size([X|_], T) :- string(X, _, T);
total([], L, L);
total([X|R], L0, L) :- string(X, N, _), count(N, L0, L1), total(R, L1, L);
count(0, L, L) :- !;
count(N, L0, L) :- count(N-1, L0+1, L);
fill([], S, P, P);
fill([X|R], S, P0, P) :- string(X, N, _), copy(X, 0, N, S, P0, P1), fill(R, S, P1, P);
copy(X, N, N, S, P, P) :- !;
copy(X, I, N, S, P0, P) :-
        string_element(X, I, E),
        set_string_element(S, P0, E),
        copy(X, I+1, N, S, P0+1, P);
end.
