% SCAFFOLDING stand-in for SIMPOS's class `message`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: no code of
% `message` is printed; its nature and slots are printed in prose
% (TR-056, below; labelled PRINTED (prose)).  Every method is
% INTERPOLATED (labelled) from:
%   - TR-056 p.12 (PDF p14, §4(2)): a message "has a sender slot ..., a
%     receiver slot ..., and a body (an object to be sent).  Class
%     'message' inherits class 'as_message' to include the first two
%     slots";
%   - TM-100 p.14 (PDF p16): "A message is defined by class 'message'";
%   - docs/simpos/required/classes.tsv (row `message`): the held programs
%     send it create/2, create/4, new/2 and set_content/2, and pimscsi's
%     cmt (nature `simpos##message`) sends get_content/2 to itself.
% Model (OURS): the body in a slot named `body`, read and written by
% get_content/2 and set_content/2 (the held selectors).  create/4 is not
% stood in: no pimfep or pimscsi method reaches it (create/2: step 3m).

class message has

% PRINTED (prose): TR-056 PDF p14, folio 12, "Class 'message' inherits
% class 'as_message' to include the first two slots".
nature as_message;

% :create(#message, M) -- step 3m, INTERPOLATED from the held sends on the
% local login's path (pimfep, cells read 2026-11-25):
% as_pimos_login_requester send_message/4 @2fd-301 and receive_block/7
% @538-53c, pimos_remote_login_server receive_block/3 @50d-511 and
% send_reply/4 @5f6-5fa; each then sets the content (set_content/2).  A
% new message with no content (OURS).
:create(Class, Message) :- :new(Class, Message);

instance

% PRINTED (prose): TR-056 PDF p14, folio 12, "a body (an object to be
% sent)"; the slot's NAME `body` is OURS.
attribute body;

% INTERPOLATED from: the held set_content/2 (required/classes.tsv) and
% TR-056 p.12's body.
:set_content(Message, Content) :-
        Message!body := Content;
% INTERPOLATED from: pimscsi##cmt's get_content/2 sends, and TR-056 p.12.
:get_content(Message, Content) :-
        Content = Message!body;

end.
