% SCAFFOLDING stand-in for SIMPOS's class `alarm_watch`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: no part of
% `alarm_watch` is printed or held, and NO CLOCK IS MODELLED.  Every method
% is INTERPOLATED (labelled) from:
%   - gog-kl1 ESP/PLAYSLOT.ESP:81-86 (ICOT Free Software, IFS
%     exper-apps/pimos/gog-kl1.tar.Z), commented "timer wait":
%     `:create(#alarm_watch,Watch), :create(#time,Time),
%     :set_value(Time,0,0,S,M), :on_after(Watch,Time), :wait(Watch)`;
%     DISP_KIFU.ESP:29-54 and CH_CLOCK.ESP:35 the same pattern ("read
%     waiting loop timer");
%   - pimfep##pimos_timer's local on_after/4 (held .ptf @10c):
%     `:create(#alarm_watch,W), :create(#time,T), :set_count(T,N),
%     :on_after(W,T), :wait(W)`, then a message is put on the timer's
%     stream;
%   - docs/simpos/required/classes.tsv (row `alarm_watch`): create/2,
%     on_after/2, on_at/2, wait/1.
% Model (OURS): one process and no clock, so the alarm is set and wait/1
% returns at once, as if the time had passed.  on_at/2 since step 3o.

class alarm_watch has

% INTERPOLATED from: `:create(#alarm_watch,Watch)` (see above).
:create(Class, Watch) :-
        :new(Class, Watch);

instance

% INTERPOLATED: the representation (OURS): the time object last set.
attribute alarm := 0;

% INTERPOLATED from: `:on_after(Watch,Time)` (PLAYSLOT.ESP:85, pimos_timer
% on_after/4).
:on_after(Watch, Time) :-
        Watch!alarm := Time;
% INTERPOLATED (step 3o, 2026-11-26) from: pimfep##pimos_timer's local
% on_at/4 (held .ptf @136-14e, read 2026-11-26 with fepread/ptfread.py:
% `:create(#alarm_watch,W)`, `:create(#time,T)`, `:set_count(T,N)`,
% `:on_at(W,T)`, then wait/1, as its on_after/4 @10c-127) and the
% classes.tsv row (on_at/2).  As on_after/2: the time is kept, and with no
% clock wait/1 returns at once (OURS), so a 302 alarm comes at once.
:on_at(Watch, Time) :-
        Watch!alarm := Time;
% INTERPOLATED from: `:wait(Watch)` (PLAYSLOT.ESP:86).  OURS: it returns
% at once (no clock, one process).
:wait(Watch);

% Step 3m (docs/simpos/boot_route.md §6): the local login's receive.  Two
% held senders, the same shape on each side (pimfep, cells read
% 2026-11-25): as_pimos_login_requester receive_block/7 @547-558 and
% pimos_remote_login_server receive_block/3 @526-537:
%   :create(#message, T), :set_content(T, timeout),
%   :set_count(Time, Count * 1000),
%   :who_is_connecting_to(Port, L), :get_contents(L, [Peer]),
%   :on_after(Watch, Time, Peer, Port, T),
%   :wait_and_return(Watch, M), :get_content(M, C), :cancel(Watch),
% and then each takes C apart: the atom `timeout` (receive_timeout), the
% atom `close`, or a string (check_local_message/5 @704-71e).  So the
% watch is armed to deliver the message T on Port, as from Peer, when
% the time has passed, and wait_and_return/2 answers the first message
% that reaches Port: the peer's or the alarm's (INFERENCE).  OURS: no
% clock, so the alarm's message is never sent and wait_and_return/2
% waits on the port for the peer (a port is a stream: TM-100 Fig. 3.8,
% nature channel, Fig. 3.7, nature stream).

attribute port := 0, from := 0, message := 0;

% INTERPOLATED (see above): arm the alarm (kept, never fired: OURS).
:on_after(Watch, Time, From, Port, Message) :-
        Watch!alarm := Time, Watch!from := From, Watch!port := Port,
        Watch!message := Message;

% INTERPOLATED (see above): the next message on the armed port.
:wait_and_return(Watch, Message) :- :get(Watch!port, Message);

% INTERPOLATED (see above): disarm.
:cancel(Watch) :- Watch!alarm := 0, Watch!port := 0;

end.
