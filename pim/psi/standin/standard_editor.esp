% SCAFFOLDING stand-in for SIMPOS's class `standard_editor` (Pmacs's
% editor object), compiled by psi/espc.py into the package `simpos`.
% It is NOT SIMPOS: no part of it is printed.  It is MINIMAL: of the
% selectors held code sends to an editor (docs/simpos/subsystems/
% window.md §2.11 and its usage table: get_window/2, current_buffer/2,
% set_current_buffer/2, select_buffer/2, clear_input/1, exception/2,
% carriage_return/1, ...) only get_window/2 was here at first, because 21
% methods of pimfep##pimos_window_editor stop at it (kl0 census --fep,
% 2026-11-24).  pimos_window_editor's natures, as its template writes
% them, are `simpos##standard_editor, pimfep##as_pimos_device`, so this
% is the unloaded ancestor that holds the method (the other one,
% simpos##as_program, is reached through as_pimos_device).
%
% Model (OURS): the editor's window in one slot.  In SIMPOS the window
% and its editor are made together (window.md §2.11: disc/exshow.esp:24
% sends create/3, then `:get_editor(W, E)` at :28; corrected 2026-11-24,
% docs/simpos/source_check_2026-11-24.md row SA42).  The pmacs_window
% stand-in (pmacs_window.esp) makes one with its editor and sets this
% slot; an editor made any other way (as the census makes receivers,
% with new/2) keeps the constant 0, and kl0 refuses the next send, to
% the window, as "receiver a slot constant".
%
% WINDOW M10 (2026-11-26): PMACS PROPER.  The editor's commands and its
% key bindings.
%   THE BINDING TABLES ARE HELD IN FORM (window.md §2.11, §5.2, USAGE):
%   instance clauses `:command(Editor, Input, Method)`, with the prefix
%   tables `:control_x(Editor, Input, Method)` and `:control_c(..)`:
%     - pimfep##pimos_window_editor command/3 (the held .ptf, cells
%       @17-26, read 2026-11-26 with psi/fepread/ptfread.py): a switch on
%       the input, the integer 3 to `attention` and the atom `exit` to
%       `exit`.  So an input is a key code or an atom, and 3 is what a
%       PIMOS window's control-C is (docs/fep_services.md §2.6, the {Id, 3}
%       reply), which this file's codes give control#"c" (psi/espc.py
%       KEY_CODES, OURS, G2);
%     - cal-esp deb2.12/dedit.esp:105-120 (held IFS source):
%       `:command(Editor,mouse#ll,debugger_menu)`, the control_c table and
%       `:control_x(Editor,control#"z",exit)`;
%     - cal2.12/cal_pmacs.esp `:command(Editor,pf#11,cal_menu)` and
%       `:cal_menu(_)`: the method is sent to the editor with no other
%       argument;
%     - papyrus demo/EDITOR/my_save.esp.1:16-17 `:command(Editor,save,
%       save)` (a menu's atom as input) and `:control_c(Editor,#"s",save)`;
%     - kappa2 utility/fmp/KMACS.ESP:67 `:command(E, mouse#r, kappa_menu)`.
%   A held subclass's clauses come first: primaries combine as
%   alternatives in inheritance order (TM-388 §3.4, psi/librarian.py), so
%   the interpreter's first answer is the subclass's binding, then these.
%   THE DEFAULT BINDINGS BELOW ARE OURS (gap G6, the plan's Q6: Pmacs's
%   own table is lost; Pmacs is "Emacs-like", IPSJ 114007, PROSE), a
%   minimal Emacs subset.  Two are HELD in form: `exit` to exit
%   (pimos_window_editor's) and control_x control#"z" to exit (dedit's,
%   a user table, taken here as the default too: INFERENCE).  mouse#r to
%   show_menu is INFERENCE: show_menu/1 is a pmacs_standard_editor
%   selector (papyrus USAGE, window.md §2.11), and kappa's KMACS rebinds
%   mouse#r to its own menu.  The EDITOR MENU's items are atoms bound
%   like papyrus's `save` (show_menu/1, below).
%   THE COORDINATOR'S PRINTED TABLE (window.md §5.1, TR-046 p28) takes
%   control#"k", "l", "a", "s", "m", "b", "v", "r", "w" before any window
%   sees them; the coordinator stand-in models only the system menu
%   (coordinator.esp), so every key reaches the editor here, and C-a, C-b
%   and C-k bind as Emacs's.  How Pmacs shared those keys with the
%   coordinator is UNKNOWN (open in psi/README.md "Window M10").
%   THE COMMANDS: each an editor method of one argument (the editor), as
%   cal_menu/1; their names are Emacs's (OURS), some HELD as selectors
%   (USAGE, window.md §2.11's table): beginning_of_line/1,
%   backward_character/1, goto_beginning/1, select_buffer/1,2,
%   list_buffers/1, show_menu/1, insert/2, current_buffer/2,
%   set_current_buffer/2, exception/2, carriage_return/1, read_file/4
%   (exshow :27).  A command that fails (the point at the end) beeps
%   (OURS).
%   FILES: read_file/4 retrieves the file with the directory's retrieve/4
%   (its fourth argument the full pathname: INFERENCE, TR-524 App. A's
%   FullPathname; exshow leaves it unbound) and shows "Read! " and the
%   full pathname in the echo line (SCREENSHOT esp.wmv@108-149: `Read!
%   >sys>user>demo>8pzl.esp.1`, window.md §2.11).  A save writes a NEW
%   VERSION (TR-524 PDF p9, PROSE: versions are incremented every time a
%   file is newly created; binary_file new_version/3, a kl0 model) and
%   shows "Written! " and its full pathname (the word OURS).

class standard_editor has

% PMACS RECONSTRUCTION (2026-11-27): THE YANK BUFFER (pmacs.md §4.3).
% INFERENCE that the killed texts are one store for every editor: the
% ESP manual overview (PDF p25) says "the system manages the text buffer
% of each Pmacs window consistently. Therefore, character strings can be
% operated in the same way by programs, and text data can be exchanged
% between windows or programs in the same way as Pmacs" -- an exchange
% between windows, not a kill store, which it does not mention; Emacs's
% one kill ring is the other half of the inference.  Here a class slot,
% newest first (the place OURS).  The held
% named yank buffers (`#editor_yank_buffer`, cil ds_bep.esp:2312, :3515)
% are another store, not stood in.
% INTERPOLATED (representation OURS): see the note above.
attribute yanks := [];

% :push_yank(#standard_editor, String) -- OURS selector: String the
% newest killed text (pmacs.md §4.3).
% INTERPOLATED (selector and body OURS): see THE YANK BUFFER above.
:push_yank(Class, S) :- Class!yanks := [S | Class!yanks];
% :top_yank(#standard_editor, String) -- OURS selector: the newest
% killed text; fails when nothing was killed (pmacs.md §4.3).
% INTERPOLATED (selector and body OURS): see THE YANK BUFFER above.
:top_yank(Class, S) :- [S | _] = Class!yanks;

% :create(#Class, Window, Interpreter, ^Editor) -- MENDELS's method editor
% (2026-11-28), INTERPOLATED (selector and arguments USAGE: MENDELS
% med_pmacs.esp:132 `:create(#med_pmacs_editor, Win, InterP, Editor)`,
% cal-esp deb2.12/pmod.esp:34, disc system_data.esp:116, utter
% Tour/WIN.esp:97, each an editor class of the program's own, heir of
% standard_editor, for a pmacs_window and its interpreter; window.md
% §2.14 counts 18 sends of c:create/4 to standard_editor; body OURS): a
% new editor of Class for Window.  The interpreter is not kept (the held
% senders give the editor to it by set_editor/2 or its slot).
% LABEL: INFERENCE (from the held senders; the body OURS)
:create(Class, Window, _, Editor) :-
        :new(Class, Editor),
        Editor!window := Window;

instance

% INTERPOLATED: the representation (OURS; see above).
attribute window := 0;

% :get_window(Editor, Window) -- the editor's window.
% INTERPOLATED from: window.md §2.11 ("editor -> window", 188 uses);
% the call sites kappa2 utility/fmp/KMACS.ESP:84, :106 and others
% (`:get_window(Editor,Window)`, then window methods on Window); the held
% compiled sends in pimfep##pimos_window_editor (21 methods, 2026-11-24).
:get_window(Editor, Window) :- Window = Editor!window;

% :clear_buffer(Editor, Buffer, From) -- MENDELS's method editor
% (2026-11-28), INTERPOLATED (selector and arguments USAGE MENDELS
% med_pmacs.esp:276 reset/1, kappa2 user_if/pb/inwin.esp:272 and
% exwin.esp:68, always `(Editor, Buffer, 0)`; body OURS): Buffer's text
% from position From to its end deleted (the third argument read as a
% position: INFERENCE, every held sender passes 0, so the whole text).
% LABEL: INFERENCE (from the held senders; the body OURS)
:clear_buffer(Editor, B, From) :-
        :end_of_buffer(B, E),
        :delete(B, From, E);

% :carriage_return(Editor) -- window M4 (2026-11-25), INTERPOLATED (body
% INFERENCE) from: pimfep##pimos_window_editor's held before- and
% after-demons on it (@2bd, @2c8; window.md §2.11-2.12: "input-line end",
% the demons prove a SIMPOS primary), and getl_from_buffer/3 @413-449,
% which the after-demon reaches and which finds the line by searching the
% buffer for code 10 from the input region's start.  So the primary ends
% the typed line: a key#lf (10) at the point of the window's text buffer
% (editor_text_buffer.esp).  Bound to RETURN (key#cr, below, OURS).
% Window M10: in the buffer the editor visits (current_buffer/2).
:carriage_return(Editor) :-
        :current_buffer(Editor, B),
        :insert_code(B, 10);

% WINDOW M10: THE DEFAULT BINDINGS (OURS, see the head comment).
% INTERPOLATED (bodies OURS): see THE BINDING TABLES in the head comment.
:command(Editor, key#cr, carriage_return);
:command(Editor, exit, exit);
:command(Editor, control#"f", forward_character);
:command(Editor, control#"b", backward_character);
:command(Editor, control#"n", next_line);
:command(Editor, control#"p", previous_line);
:command(Editor, control#"a", beginning_of_line);
:command(Editor, control#"e", end_of_line);
:command(Editor, control#"d", delete_character);
:command(Editor, control#"k", kill_line);
:command(Editor, key#del, delete_backward_character);
:command(Editor, key#bs, delete_backward_character);
:command(Editor, key#right, forward_character);
:command(Editor, key#left, backward_character);
:command(Editor, key#down, next_line);
:command(Editor, key#up, previous_line);
:command(Editor, control#"x", control_x);
:command(Editor, control#"c", control_c);
:command(Editor, mouse#r, show_menu);
% PMACS RECONSTRUCTION (2026-11-27, pmacs.md §3.2): C-v and ESC v
% RECONSTRUCTED-FROM-MANUAL (KWIC manual kwod.tex:229-238: ctrl-V, meta-V,
% "conforming to SIMPOS-pmacs's cursor movement commands"; ESC as Emacs's
% meta is OURS), the others INFERENCE (Emacs analogy: ESP manual overview
% PDF p25), mouse#l OURS (the first click selects the window).
% INTERPOLATED (bodies OURS): see pmacs.md §3.2.
:command(Editor, control#"@", mark);
:command(Editor, control#"w", kill_region);
:command(Editor, control#"y", yank);
:command(Editor, control#"v", view_next_screen);
:command(Editor, key#esc, escape);
:command(Editor, mouse#l, cursor_with_mouse);
% the EDITOR MENU's items (show_menu/1)
:command(Editor, abort, abort);
:command(Editor, list_buffers, list_buffers);
:command(Editor, save_all_files, save_all_files);
:command(Editor, set_font, set_font_by_menu);
:command(Editor, set_echo_font, set_echo_font_by_menu);
:command(Editor, set_window_size, set_window_size_by_menu);
:command(Editor, from_whiteboard, from_whiteboard);
:command(Editor, to_whiteboard, to_whiteboard);
% INTERPOLATED (bodies OURS): see THE BINDING TABLES in the head comment.
:control_x(Editor, control#"s", save_file);
:control_x(Editor, control#"z", exit);
:control_x(Editor, control#"c", exit);
:control_x(Editor, control#"b", list_buffers);
:control_x(Editor, #"b", select_buffer);
% PMACS RECONSTRUCTION (2026-11-27, pmacs.md §3.2), INFERENCE (Emacs
% analogy; C-x C-f's prompt `Find File:` SCREENSHOT esp.wmv, window.md
% §2.11).
% INTERPOLATED (bodies OURS): see pmacs.md §3.2.
:control_x(Editor, control#"x", exchange_point);
:control_x(Editor, control#"f", find_file);
:control_x(Editor, control#"w", write_file);
:control_x(Editor, #"2", two_windows);
:control_x(Editor, #"1", one_window);
:control_x(Editor, #"o", other_window);
% INTERPOLATED (bodies OURS): ESC, Emacs's meta (OURS); v from the KWIC
% manual (RECONSTRUCTED-FROM-MANUAL, see above), w INFERENCE.
:escape(Editor, #"v", view_previous_screen);
:escape(Editor, #"w", copy_region);

% WINDOW M10: THE COMMANDS (bodies OURS; see the head comment).
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:forward_character(Editor) :- buffer(Editor, B), :forward_character(B);
% INTERPOLATED (selector HELD, body OURS): see THE COMMANDS.
:backward_character(Editor) :- buffer(Editor, B), :backward_character(B);
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:next_line(Editor) :- buffer(Editor, B), :column(B, C), :next_line(B, C);
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:previous_line(Editor) :- buffer(Editor, B), :column(B, C), :previous_line(B, C);
% INTERPOLATED (selector HELD, body OURS): see THE COMMANDS.
:beginning_of_line(Editor) :- buffer(Editor, B), :beginning_of_line(B);
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:end_of_line(Editor) :- buffer(Editor, B), :end_of_line(B);
% INTERPOLATED (selector HELD, cal_pmacs run/4; body OURS): see THE COMMANDS.
:goto_beginning(Editor) :- buffer(Editor, B), :move_to_first(B);
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:delete_character(Editor) :-
        buffer(Editor, B), :current_position(B, P), :end_of_buffer(B, E),
        P < E, :delete(B, P, P + 1);
% INTERPOLATED (selector OURS, body OURS): see THE COMMANDS.
:delete_backward_character(Editor) :-
        buffer(Editor, B), :current_position(B, P),
        P > 0, :delete(B, P - 1, P);
% INTERPOLATED (selector OURS, body OURS): Emacs's C-k, the rest of the
% line, or its newline at its end.  2026-11-27: the text killed is the
% newest in the yank buffer (INFERENCE, Emacs analogy, pmacs.md §4.3).
:kill_line(Editor) :-
        buffer(Editor, B), :current_position(B, P), :end_of_line(B),
        :current_position(B, E), :move_to(B, P),
        killed(B, P, E, To),
        cut_to_yank(Editor, B, P, To);
% INTERPOLATED (selector HELD, body OURS): a string or one code at the
% point (`:insert(B, key#lf)` on a buffer, MENDELS, window.md §2.11).
:insert(Editor, X) :- buffer(Editor, B), inserted(B, X);
% INTERPOLATED (selector HELD, body OURS): the buffer the editor visits.
:current_buffer(Editor, B) :-
        W = Editor!window, :get_interpreter(W, I), :buffer(I, B);
% INTERPOLATED (selector HELD, body OURS): the editor visits B.
:set_current_buffer(Editor, B) :- :set_input_buffer(Editor!window, B);
% INTERPOLATED (selector HELD, body OURS): the editor visits B.
:select_buffer(Editor, B) :- :set_input_buffer(Editor!window, B);
% INTERPOLATED (selector HELD, body OURS): Pmacs asks for a buffer's
% name; here the next pooled buffer after the current one (OURS: no
% prompt is stood in), its name in the echo line.
:select_buffer(Editor) :-
        buffer(Editor, B),
        :get_buffer_instance_list(#editor_text_buffer, L),
        next_in(L, B, L, N),
        :select_buffer(Editor, N),
        :get_name(N, Name),
        :append(#string, ["Buffer: ", Name], S),
        :message(Editor, S);
% INTERPOLATED (selector HELD, body OURS): the pooled buffers' names and
% numbers in the echo line (OURS look: Pmacs's buffer list is not shown
% anywhere held).
:list_buffers(Editor) :-
        :get_buffer_instance_list(#editor_text_buffer, L),
        names(L, Parts),
        :append(#string, ["Buffers:" | Parts], S),
        :message(Editor, S);
% INTERPOLATED (selector OURS, body OURS): see FILES in the head comment.
:save_file(Editor) :- buffer(Editor, B), saved(Editor, B);
% INTERPOLATED (selector OURS from the EDITOR MENU's "Save All Files",
% body OURS): every pooled buffer read from a file and modified.
:save_all_files(Editor) :-
        :get_buffer_instance_list(#editor_text_buffer, L),
        all_saved(Editor, L);
% PMACS RECONSTRUCTION (2026-11-27): the selectors held code sends to a
% Pmacs editor, and the commands bound to them (docs/simpos/subsystems/
% pmacs.md, each label citing its section).
% :mark(Editor) -- HELD selector (papyrus my_syntax.esp.1:29, after
% goto_beginning/1; my_changer.esp.1:110, after move_to/2; kappa2
% user_if/pb/inwin.esp:298): the mark at the point.  RECONSTRUCTED-FROM-
% MANUAL that Pmacs has a mark (KWIC manual classSpec.doc:1317-1318);
% its being set at the point INFERENCE (Emacs analogy, C-@; pmacs.md
% §4.2); `Mark set` in the echo line INFERENCE (Emacs's words).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.2.
:mark(Editor) :- buffer(Editor, B), :set_mark(B), :message(Editor, "Mark set");
% :exchange_point(Editor) -- HELD selector (my_syntax.esp.1:34): the
% point and the mark change places; fails with no mark.  INFERENCE
% (Emacs analogy, C-x C-x), pmacs.md §4.2, §4.4.
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.2.
:exchange_point(Editor) :-
        buffer(Editor, B), :get_mark(B, M), :current_position(B, P),
        :move_to(B, M), :set_mark_at(B, P);
% :next_term(Editor) -- HELD selector (my_syntax.esp.1:36, after
% exchange_point/1 and two backward_character/1): the next ESP term made
% the region, the point at its start and the mark at its end (editor_
% text_buffer term_region/3); fails when no term follows.  INFERENCE
% (Emacs analogy, mark-defun; the only model found under which the held
% loop advances one term each pass, pmacs.md §4.4).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.4.
:next_term(Editor) :-
        buffer(Editor, B), :term_region(B, S, E),
        :move_to(B, S), :set_mark_at(B, E);
% :kill_region(Editor) -- OURS selector (C-w): the text between the
% point and the mark killed into the yank buffer.  INFERENCE (Emacs
% analogy), pmacs.md §4.3.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.3.
:kill_region(Editor) :-
        buffer(Editor, B), :get_mark(B, M), :current_position(B, P),
        ordered(P, M, From, To),
        cut_to_yank(Editor, B, From, To);
% :copy_region(Editor) -- OURS selector (ESC w): the region's text the
% newest in the yank buffer, the text kept.  INFERENCE (Emacs analogy),
% pmacs.md §4.3.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.3.
:copy_region(Editor) :-
        buffer(Editor, B), :get_mark(B, M), :current_position(B, P),
        ordered(P, M, From, To),
        :see_position(B, From, To - From, S),
        :push_to_yank(Editor, S, forward);
% :push_to_yank(Editor, String, Direction) -- HELD selector (papyrus
% my_delete.esp.1:48, `:push_to_yank(Editor,String,forward)`, String the
% text of a proof part read by see_position/4 just before the part is
% deleted): String the newest text in the yank buffer, one store for
% every editor (INFERENCE, THE YANK BUFFER above);
% Direction is `forward` or `backward` (INFERENCE: Emacs's kill-append
% direction, text taken after or before the point; it changes nothing
% here, pmacs.md §4.3).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.3.
:push_to_yank(Editor, S, D) :- direction(D), :push_yank(#standard_editor, S);
% :yank(Editor) -- OURS selector (C-y): the newest killed text at the
% point, the mark before it and the point after it; fails when nothing
% was killed.  INFERENCE (Emacs analogy), pmacs.md §4.3.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.3.
:yank(Editor) :-
        :top_yank(#standard_editor, S),
        buffer(Editor, B), :current_position(B, P),
        :insert_string(B, S), :set_mark_at(B, P);
% :clear_input(Editor) -- HELD selector (kappa2 user_if/pb/typewin.esp:
% 325, before clear_buffer/1 and move_to_first/1; utility/rep/REPINDEX.
% ESP:392, :443, :495, REPDB.ESP:107, :132, REPRECORD.ESP:103, before a
% dump is written into the buffer): what was typed and not yet read is
% dropped (the window's interpreter clear_input/1).  INFERENCE (the name
% and those uses: the buffer is cleared by other sends; Emacs's
% discard-input; pmacs.md §4.9).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.9.
:clear_input(Editor) :- :get_interpreter(Editor!window, I), :clear_input(I);
% :cursor_with_mouse(Editor) -- HELD selector (papyrus my_point.esp.1:23,
% bound with `:command(Editor,mouse#l,goal_with_mouse)` and followed by
% current_buffer/2 and current_position/2): the point to the character
% under the last click in the window (its line and column; the line's
% end if it is shorter).  INFERENCE (that use; pmacs.md §4.6).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.6.
:cursor_with_mouse(Editor) :-
        :mouse_cell(Editor!window, Line, Col),
        buffer(Editor, B), :move_to_cell(B, Line, Col);
% :view_next_screen(Editor), :view_previous_screen(Editor) -- OURS
% selectors on the editor (C-v, ESC v): the window's page commands
% (pmacs_window, HELD selectors; RECONSTRUCTED-FROM-MANUAL, the KWIC
% manual kwod.tex:229-238, pmacs.md §4.6).
% INTERPOLATED (selector OURS, behaviour RECONSTRUCTED-FROM-MANUAL): above.
:view_next_screen(Editor) :- :view_next_screen(Editor!window);
% INTERPOLATED (selector OURS, behaviour RECONSTRUCTED-FROM-MANUAL): above.
:view_previous_screen(Editor) :- :view_previous_screen(Editor!window);
% :two_windows(Editor) -- HELD selector (cil ds_edt.esp:1037, :1048, when
% get_activate_window_count/2 answers 1, before editing a file "in other
% window"; papyrus rule_editor.esp.1:30 overrides it with an empty
% primary): the window shows two views of the buffer, the upper one
% active.  INFERENCE (those uses; Emacs analogy C-x 2; pmacs.md §4.7).
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.7.
:two_windows(Editor) :- :split(Editor!window);
% :other_window(Editor) -- HELD selector (window.md §2.11; 8 uses): the
% other view active (the window's exchange_window/1).  INFERENCE (Emacs
% analogy C-x o), pmacs.md §4.7.
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.7.
:other_window(Editor) :- :exchange_window(Editor!window);
% :one_window(Editor) -- OURS selector (C-x 1): one view again.
% INFERENCE (Emacs analogy), pmacs.md §4.7.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.7.
:one_window(Editor) :- :unsplit(Editor!window);
% :find_file(Editor, Pathname) -- HELD selector (cil ds_edt.esp:915, a
% file chosen in a directory listing, "If it finds a file, it enter into
% an edit mode"; papyrus my_load.esp.1:243, :262): the editor visits the
% file: a buffer already visiting it, else a new pooled buffer named
% after the file's identifier with the file read into it (`Read! <full
% pathname>` in the echo line, as read_file/4); a pathname no file has
% gives an empty buffer that a save writes there (`New File`, OURS
% words).  RECONSTRUCTED-FROM-MANUAL that a Pmacs buffer has a name of
% its own (PIMOS manual man15 PDF p72, p75 select_buffer: a window's
% text buffer by name, made when missing; p91: a window's title "but not
% the text buffer name of the PMACS"); the name the file's identifier
% SCREENSHOT (IPSJ 36239 p5: buffer `demo`, file demo.esp); the rest
% INFERENCE (Emacs analogy, C-x C-f), pmacs.md §4.8.
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.8.
:find_file(Editor, Path) :-
        :retrieve(#directory, F, Path, Full), :not_directory(F), !,
        :get_buffer_instance_list(#editor_text_buffer, L),
        found(Editor, L, F, Full);
:find_file(Editor, Path) :-
        new_buffer(Path, B),
        B!path := Path,
        :select_buffer(Editor, B),
        :message(Editor, "New File");
% :find_file(Editor) -- OURS selector (C-x C-f): the pathname read in
% the echo line after `Find File:` (SCREENSHOT esp.wmv, window.md §2.11;
% the window's read_with_prompt/3), then find_file/2.  INFERENCE,
% pmacs.md §4.8.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.8.
:find_file(Editor) :-
        :read_with_prompt(Editor!window, ["Find File:"], Path),
        :find_file(Editor, Path);
% :write_file(Editor, Buffer, Name, Pathname) -- HELD selector (cil
% ds_edt.esp:760: a buffer with no file name written to the name read
% after a prompt with a default, then `:set_file_name(Buffer, Pathname)`,
% so Pathname is the full pathname written): Buffer's text written as a
% new version of Name (its latest version + 1, or version 1 of a new
% file in Name's directory), the buffer now that file's, unmodified,
% `Written! <full pathname>` in the echo line.  RECONSTRUCTED-FROM-
% MANUAL by analogy only: PIMOS manual man15 PDF p73 (a write-mode open
% of an existing file "the file with the same name is created and opened
% in higher version"), TR-524 PDF p9 (versions); the rest INFERENCE
% (Emacs analogy, C-x C-w), pmacs.md §4.8.
% INTERPOLATED (selector HELD, body INFERENCE): pmacs.md §4.8.
:write_file(Editor, B, Name, Full) :-
        target(Name, F),
        :contents(B, Text),
        :new_version(F, Text, New),
        :saved(B, New),
        B!path := 0,
        :full_name(New, Full),
        :append(#string, ["Written! ", Full], S),
        :message(Editor, S);
% :write_file(Editor) -- OURS selector (C-x C-w): the pathname read
% after `Write File:` (OURS words, as find_file/1's), then write_file/4
% on the buffer the editor visits.  INFERENCE, pmacs.md §4.8.
% INTERPOLATED (selector OURS, body INFERENCE): pmacs.md §4.8.
:write_file(Editor) :-
        :read_with_prompt(Editor!window, ["Write File:"], Name),
        buffer(Editor, B),
        :write_file(Editor, B, Name, _);

% INTERPOLATED (selector HELD, exshow :27; body OURS): see FILES.
:read_file(Editor, B, File, Full) :-
        :retrieve(#directory, F, File, Full),
        :load_file(B, F),
        :append(#string, ["Read! ", Full], S),
        :message(Editor, S);
% INTERPOLATED (selector HELD in form, pimos_window_editor's and dedit's
% bindings; body OURS): the command loop ends after it
% (editor_command_interpreter.esp).
:exit(Editor);
% INTERPOLATED (selector OURS, the EDITOR MENU's ABORT): nothing.
:abort(Editor);
% INTERPOLATED (selector HELD; pmacs_window_editor show_menu/1 USAGE,
% body OURS): the EDITOR MENU at the mouse (coordinator editor_menu/3).
% Its items are verbatim from IPSJ 36239 p5 (SCREENSHOT, 2.50; window.md
% §2.11; TM-229 p6 has `Set Same Font` for the fifth, VARIANT), one
% column (OURS).  Each item's value is an atom the window's input gets
% when it is chosen, bound by the table above.  Only ABORT, List Buffers
% and Save All Files are stood in: the other five are bound to methods no
% class has, so choosing one is refused loudly ("not in the stand-in").
:show_menu(Editor) :-
        :editor_menu(#coordinator, Editor!window,
                     [[{"ABORT", abort}, {"List Buffers", list_buffers},
                       {"Save All Files", save_all_files}, {"Set Font", set_font},
                       {"Set Echo Font", set_echo_font},
                       {"Set Window Size", set_window_size},
                       {"From Whiteboard", from_whiteboard},
                       {"To Whiteboard", to_whiteboard}]]);
% INTERPOLATED (selector HELD, "show an error message", window.md §2.11;
% body OURS): in the echo line.
:exception(Editor, Message) :- :message(Editor, Message);
% :message(Editor, String) -- OURS selector: String in the window's echo
% line (pmacs_window echo/2).
% INTERPOLATED (selector and body OURS): see THE COMMANDS.
:message(Editor, String) :- :echo(Editor!window, String);
% :undefined_key(Editor, Input) -- OURS selector: an input no table binds
% (and not a character): a beep and a message (OURS words).
% INTERPOLATED (selector and body OURS): see THE COMMANDS.
:undefined_key(Editor, _) :- :beep(Editor!window), :message(Editor, "Undefined key");
% :command_failed(Editor, Method) -- OURS selector: a command that
% failed: a beep (OURS).
% INTERPOLATED (selector and body OURS): see THE COMMANDS.
:command_failed(Editor, _) :- :beep(Editor!window);

local

buffer(Editor, B) :- :current_buffer(Editor, B);

killed(_, P, E, E) :- E > P, !;
killed(B, P, _, To) :- :end_of_buffer(B, L), P < L, value(P + 1, To);

% the text From .. To killed: deleted, and the newest in the yank buffer
cut_to_yank(Editor, B, From, To) :-
        :see_position(B, From, To - From, S),
        :delete(B, From, To),
        :push_to_yank(Editor, S, forward);

value(V, V);

% the region's ends, the first not after the second
ordered(P, M, P, M) :- P =< M, !;
ordered(P, M, M, P);

% find_file/2's file F (full pathname Full) in the pool L: a buffer
% already visiting it, else a new one (pmacs.md §4.8)
found(Editor, L, _, Full) :- visiting(L, Full, B), !, :select_buffer(Editor, B);
found(Editor, _, F, Full) :-
        new_buffer(F!name, B),
        :load_file(B, F),
        :select_buffer(Editor, B),
        :append(#string, ["Read! ", Full], S),
        :message(Editor, S);

visiting([B | _], Full, B) :- F = B!file, F \== 0, N = F!full_name, equal_string(N, Full), !;
visiting([_ | Bs], Full, B) :- visiting(Bs, Full, B);

% a new pooled buffer named after the pathname's identifier, or after
% the whole pathname when that name is taken (OURS)
new_buffer(Path, B) :- ident(Path, Name), :create(#editor_text_buffer, B, Name, 0), !;
new_buffer(Path, B) :- :create(#editor_text_buffer, B, Path, 0);

% the identifier of a pathname: its last name, up to the first `.`
% (`demo` for demo.esp, SCREENSHOT IPSJ 36239 p5, pmacs.md §4.8)
ident(Path, Name) :-
        string(Path, N, _), codes(Path, 0, N, Codes),
        last_name(Codes, Codes, Last),
        up_to_period(Last, Id),
        Id \== [],
        string_of(Id, Name);

% the codes after the last `>` or `:`
last_name([], Last, Last);
last_name([C | R], _, Last) :- separator(C), !, last_name(R, R, Last);
last_name([_ | R], L, Last) :- last_name(R, L, Last);

% the codes before the last `>` or `:`, with it when it is `:` (a
% logical name's directory), without it when it is `>`; none: []
dir_part(Codes, Dir) :- last_sep(Codes, 0, none, I), I \== none, !, keep_dir(Codes, I, Dir);
dir_part(_, []);

last_sep([], _, I, I);
last_sep([C | R], K, _, I) :- separator(C), !, last_sep(R, K + 1, K, I);
last_sep([_ | R], K, I0, I) :- last_sep(R, K + 1, I0, I);

keep_dir(Codes, I, Dir) :- take(Codes, I, Before), nth(Codes, I, C), with_sep(C, Before, Dir);

with_sep(C, Before, Dir) :- colon(C), !, append(Before, [C], Dir);
with_sep(_, Before, Before);

take(_, 0, []) :- !;
take([C | R], N, [C | T]) :- take(R, N - 1, T);

nth([C | _], 0, C) :- !;
nth([_ | R], N, C) :- nth(R, N - 1, C);

append([], L, L);
append([X | R], L, [X | T]) :- append(R, L, T);

up_to_period([], []);
up_to_period([C | _], []) :- dot(C), !;
up_to_period([C | R], [C | T]) :- up_to_period(R, T);

% `>` and `:`, ASCII or JIS (OURS codes)
separator(62);
separator(16#"2164");
separator(C) :- colon(C);

colon(58);
colon(16#"2127");

dot(46);
dot(16#"2125");

codes(_, I, N, []) :- I >= N, !;
codes(S, I, N, [C | Cs]) :- string_element(S, I, C), codes(S, I + 1, N, Cs);

string_of(Codes, S) :- count(Codes, 0, N), new_string(S, N, 16), fill(Codes, S, 0);

count([], N, N);
count([_ | R], N0, N) :- count(R, N0 + 1, N);

fill([], _, _);
fill([C | R], S, I) :- set_string_element(S, I, C), fill(R, S, I + 1);

% write_file/4: the file a buffer is written to: the pathname's file if
% it has one, else a new file (no version yet) in its directory, which
% new_version/3 gives version 1 (pmacs.md §4.8)
target(Name, F) :- :retrieve(#directory, F, Name, _), :not_directory(F), !;
target(Name, F) :-
        string(Name, N, _), codes(Name, 0, N, Codes),
        dir_part(Codes, DirCodes), string_of(DirCodes, DirName),
        last_name(Codes, Codes, Last), Last \== [], string_of(Last, File),
        :retrieve(#directory, D, DirName, _), :is_directory(D),
        :new(#binary_file, F),
        F!name := File, F!directory := D;

direction(forward);
direction(backward);

inserted(B, X) :- integer(X), !, :insert_code(B, X);
inserted(B, X) :- :insert_string(B, X);

% the buffer after B in the pool (the first after the last)
next_in([B, N | _], B, _, N) :- !;
next_in([B], B, [N | _], N) :- !;
next_in([_ | R], B, L, N) :- next_in(R, B, L, N);

names([], []);
names([B | Bs], [" ", Name | Parts]) :- :get_name(B, Name), names(Bs, Parts);

saved(Editor, B) :- F = B!file, F \== 0, !,
        :contents(B, Text),
        :new_version(F, Text, New),
        :saved(B, New),
        :full_name(New, Full),
        :append(#string, ["Written! ", Full], S),
        :message(Editor, S);
saved(Editor, B) :- P = B!path, P \== 0, !, :write_file(Editor, B, P, _);
saved(Editor, _) :- :message(Editor, "No file");

all_saved(_, []);
all_saved(Editor, [B | Bs]) :- B!modified == 1, B!file \== 0, !,
        saved(Editor, B), all_saved(Editor, Bs);
all_saved(Editor, [_ | Bs]) :- all_saved(Editor, Bs);

end.
