% SCAFFOLDING, OURS: the allocator of the display's save areas, compiled by
% psi/espc.py into the package `simpos`.  `save_memory` is NOT a SIMPOS
% class name: the class that kept SIMPOS's save areas is lost
% (docs/simpos/subsystems/window.md §0.3).  Window milestone M7
% (2026-11-25): a pop-up (menu_pane.esp) and a window (window_pane.esp)
% save the dots under them when they are drawn and restore them when they
% go, instead of clearing their rectangle.
%
% Basis:
%   - PROSE TM-225 p10, TM-126 p5 (window.md §4.1 "Implementation"): a
%     hidden window's image is kept in a per-window save area in bitmap
%     memory, and restacking copies between the save areas and frame
%     memory.  That a pop-up saves what is under it and puts it back is
%     the same mechanism used for the pop-up (INFERENCE: the 1.0 rule
%     "uncovered areas are not cleared", TM-115 p29, p111, says the
%     uncovered area is not cleared either);
%   - the device: winfb's `save id x y w h base` and `restore id R`
%     (psi/winfb.py, frozen; bsv/WinFbBox.bsv runs them in lockstep),
%     reached as simpos##bitmap_display save/7 and restore/3
%     (psi/windev.py).  16 slots, 65,536 words of 16 bits, ceil(w/16)
%     words a row: winfb's numbers, OURS (the plan §2.3);
%   - the allocation, OURS: the lowest free slot and the lowest base where
%     the area fits between the areas in use (first fit, the areas kept
%     sorted by base).  Nothing here checks the limits: an area past the
%     memory's end, or a seventeenth area, is sent as it is and the device
%     refuses it (winfb BADSAVE, a kl0 Refusal), so running out of save
%     memory is loud, never a silent clear.
%
% An area is the list [Id, Base, Size], Size in words: a list, not a
% vector, because kl0 copies a list stored in a slot with its variables'
% values but stores a vector as it is, so a vector's elements would come
% unbound when the storing process backtracks (psi/kl0.py resolve_value;
% the same hazard as pmacs_request.esp's, window M4 J9).

class save_memory has

% OURS: the areas in use, sorted by base.
attribute used := [];

% :save(#save_memory, X, Y, W, H, Area) -- OURS (selector and body): the
% dots of the rectangle saved; Area names them.
% INTERPOLATED (selector and body OURS): save; basis above and in the
% head comment.
:save(Class, X, Y, W, H, [Id, Base, Size]) :-
        times(H, (W + 15) / 16, 0, Size),
        slot(Class!used, 0, Id),
        base(Class!used, 0, Size, Base),
        :save(#bitmap_display, Id, X, Y, W, H, Base),
        insert(Class!used, [Id, Base, Size], Used),
        Class!used := Used;

% :save_under(#save_memory, X, Y, W, H, Area) -- MENDELS's resume/0
% (2026-11-28; selector and body OURS): what lies under a window about to
% be drawn at the rectangle, saved as save/6 would, but only the part
% that holds other windows.  TM-225 p10 (PROSE, window.md §4.1): it is a
% HIDDEN WINDOW's image, all of it or its hidden part, that is kept in a
% save area; the screen behind the windows is not a window's image
% (INFERENCE: it is the empty screen, drawn back by clearing).  So the
% saved rectangle is the bounding box of the rectangle's overlaps with
% the windows on the screen (the coordinator's stack, their panes on the
% frame and not lifted) and with the status band (the frame's rows 944 to
% 1,023, status_band.esp: drawn, so kept, OURS).  Area is save/6's when
% the box is the whole rectangle, else [cut, X, Y, W, H, Inner] (Inner the
% box's save/6 area, or 0 when nothing lies under it); restore/2 and
% put_back/2 clear the rectangle and draw Inner back.  Used for the frame
% of a mixin window (window_pane.esp create_frame/8, basic_window.esp)
% only: the older panes (window_pane.esp create/7, and lay/1 on every
% restack) still save the whole rectangle, as the window M7 tests pin
% (OURS; bringing them over is open).  Until this step
% the whole rectangle was saved: MENDELS's base, 1,280 x 944, needs
% 75,520 words that way, more than the device's 65,536
% (docs/simpos/subsystems/window.md §7, the save-memory decision).
% INTERPOLATED (selector and body OURS): save_under; basis above.
:save_under(Class, X, Y, W, H, Area) :-
        C = #coordinator,
        boxed(C!windows, X, Y, X + W, Y + H, none, Box),
        band(X, Y, X + W, Y + H, Box, Box1),
        under_area(Class, X, Y, W, H, Box1, Area);

% :restore(#save_memory, Area) -- OURS (selector and body): the saved dots
% drawn back where they were (copy), and the area freed.
% INTERPOLATED (selector and body OURS): restore; basis above and in the
% head comment.
:restore(Class, [cut, X, Y, W, H, Inner]) :- !,
        :fill(#bitmap_display, X, Y, W, H, reset),
        restored_inner(Class, Inner);
:restore(Class, [Id, Base, Size]) :-
        :restore(#bitmap_display, Id, copy),
        without(Class!used, Id, Used),
        Class!used := Used;

% :restore(#save_memory, Area, Op) -- window M8's rest (selector and body
% OURS): as restore/2, the saved dots drawn through Op (the device's
% restore takes an op, psi/winfb.py), the area freed.
% INTERPOLATED (selector and body OURS): restore; basis above and in the
% head comment.
:restore(Class, [Id, Base, Size], Op) :-
        :restore(#bitmap_display, Id, Op),
        without(Class!used, Id, Used),
        Class!used := Used;

% :put_back(#save_memory, Area) -- window M7, OURS (selector and body):
% the saved dots drawn back where they were (copy); the area stays in
% use (window_pane.esp move_to/3 draws it back twice).
% INTERPOLATED (selector and body OURS): put_back; basis above and in the
% head comment.
:put_back(Class, [cut, X, Y, W, H, Inner]) :- !,
        :fill(#bitmap_display, X, Y, W, H, reset),
        put_back_inner(Class, Inner);
:put_back(Class, [Id, _, _]) :-
        :restore(#bitmap_display, Id, copy);

% :allocate(#save_memory, Size, Area) -- window M8's stops, step 3 (OURS
% selector and body): Size words of bitmap memory kept for a drawing
% surface (window_pane.esp create_surface/6), from the same first-fit list
% as the save areas, so the two never share a word.  A surface has no
% device slot: its Id is -1 - Base (unique, never a slot).  Fails when no
% gap of Size words is left below 65,536 (the device's bitmap memory,
% psi/winfb.py; until H8 moves it to SDRAM).
% INTERPOLATED (selector and body OURS): allocate; basis above.
:allocate(Class, Size, [Id, Base, Size]) :-
        base(Class!used, 0, Size, Base),
        Base + Size =< 65536,
        value(0 - 1 - Base, Id),
        insert(Class!used, [Id, Base, Size], Used),
        Class!used := Used;

% :free(#save_memory, Area) -- window M8's stops, step 3 (OURS selector
% and body): a surface's words given back.
% INTERPOLATED (selector and body OURS): free; basis above.
:free(Class, [Id, _, _]) :-
        without(Class!used, Id, Used),
        Class!used := Used;

local

value(V, V);

times(0, _, P, P) :- !;
times(N, C, P0, P) :- times(N - 1, C, P0 + C, P);

% the lowest slot id no area in use has (16 when all are: the device
% refuses it)
slot(Used, I, I) :- not_used(Used, I), !;
slot(Used, I, Id) :- slot(Used, I + 1, Id);

not_used([], _);
not_used([[I, _, _] | _], I) :- !, fail;
not_used([_ | R], I) :- not_used(R, I);

% the lowest base from B0 where Size words fit before the next area
base([], B, _, B);
base([[_, B1, _] | _], B, Size, B) :- B + Size =< B1, !;
base([[_, B1, S1] | R], _, Size, Base) :- base(R, B1 + S1, Size, Base);

insert([], A, [A]);
insert([[I1, B1, S1] | R], [I, B, S], [[I, B, S], [I1, B1, S1] | R]) :- B < B1, !;
insert([X | R], A, [X | T]) :- insert(R, A, T);

without([], _, []);
without([[I, _, _] | R], I, R) :- !;
without([X | R], I, [X | T]) :- without(R, I, T);

% save_under/6's box (OURS, see there): none, or [X0, Y0, X1, Y1]
boxed([], _, _, _, _, B, B);
boxed([Win | Ws], X0, Y0, X1, Y1, B0, B) :-
        P = Win!pane, P \== 0, P!image == 0, P!surface == 0, !,
        met(P!x, P!y, P!x + P!w, P!y + P!h, X0, Y0, X1, Y1, B0, B1),
        boxed(Ws, X0, Y0, X1, Y1, B1, B);
boxed([_ | Ws], X0, Y0, X1, Y1, B0, B) :- boxed(Ws, X0, Y0, X1, Y1, B0, B);

band(X0, Y0, X1, Y1, B0, B) :- met(0, 944, 1280, 1024, X0, Y0, X1, Y1, B0, B);

% the box B0 grown by the overlap of two rectangles, if they overlap
met(AX0, AY0, AX1, AY1, X0, Y0, X1, Y1, B0, B) :-
        high(AX0, X0, L), high(AY0, Y0, T), lower(AX1, X1, R), lower(AY1, Y1, D),
        L < R, T < D, !, grown(B0, L, T, R, D, B);
met(_, _, _, _, _, _, _, _, B, B);

grown(none, L, T, R, D, [L, T, R, D]) :- !;
grown([L0, T0, R0, D0], L, T, R, D, [L1, T1, R1, D1]) :-
        lower(L0, L, L1), lower(T0, T, T1), high(R0, R, R1), high(D0, D, D1);

high(A, B, A) :- A >= B, !;
high(_, B, B);
lower(A, B, A) :- A =< B, !;
lower(_, B, B);

under_area(_, X, Y, W, H, none, [cut, X, Y, W, H, 0]) :- !;
under_area(Class, X, Y, W, H, [L, T, R, D], Area) :-
        value(X + W, XW), value(Y + H, YH),
        L == X, T == Y, R == XW, D == YH, !,
        :save(Class, X, Y, W, H, Area);
under_area(Class, X, Y, W, H, [L, T, R, D], [cut, X, Y, W, H, Inner]) :-
        :save(Class, L, T, R - L, D - T, Inner);

restored_inner(_, 0) :- !;
restored_inner(Class, Inner) :- :restore(Class, Inner);
put_back_inner(_, 0) :- !;
put_back_inner(Class, Inner) :- :put_back(Class, Inner);

end.
