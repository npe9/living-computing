% SCAFFOLDING, OURS: the screen part of one text window, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: `window_pane`
% is not a SIMPOS class name, and no window-system class body is held
% (docs/simpos/subsystems/window.md §0.3).  Window milestones M3/M5
% (docs/simpos/window_environment_plan.md §4.1): the window stand-ins
% (standard_io_window.esp, pmacs_window.esp) keep their SIMPOS-visible
% state and hand the drawing to a pane; the pane decides every rectangle,
% glyph position, scroll and cursor, and sends only the device primitives
% of simpos##bitmap_display (psi/windev.py: kl0 models, each one command
% of the frozen winfb set).  So the window manager is ESP, as SIMPOS's was
% on the PSI/UX (Giho 9106 p86, PROSE: the SIMPOS window manager made the
% drawing requests, a window server outside SIMPOS drew them).
%
% THE LOOK, each choice with its basis (window.md §4.2-§4.3 and the plan
% §3's common look):
%   - white screen, black text: SCREENSHOT simpos.wmv@0-10, esp.wmv@110-121
%     (window.md §4.2);
%   - a single-line border, 2 dots: PRINTED-INTERFACE TM-125 p15 (the
%     default border width, window.md §2.2, §4.3); no shadow (SCREENSHOT);
%   - margins of 1 dot: PRINTED-INTERFACE TM-125 p16 (window.md §2.2);
%   - the label: a strip inside the top border, the title left-aligned in
%     the label font, a rule under it (SCREENSHOT simpos.wmv@0, @117,
%     @124, window.md §4.3).  The strip is one cell high plus 2 dots, the
%     title 1 dot below the border and at the text's left edge, the rule
%     1 dot: OURS;
%   - the text cursor a solid block (SCREENSHOT IPSJ 36239 p5, simpos.wmv@0,
%     window.md §2.3, §4.3), the size of the font's space character (PROSE
%     TM-115 p16-17, window.md §2.2), drawn by exclusive_or (OURS) only
%     while the window is the selected one (TM-126 p7, PROSE: the selected
%     window's cursor blinks; it does not blink here, OURS);
%   - text in character cells, rows from the top (TM-125 level, window.md
%     §2.3); a line that reaches the last column goes on in the next row
%     (OURS); a newline past the last row scrolls the text up one row by a
%     copy and clears the last row (scroll/2's "positive = up",
%     PRINTED-INTERFACE TM-125 p16; that output scrolls is INFERENCE);
%   - code 10 (key#lf) in a string breaks the line and 13 (key#cr) returns
%     to column 0 (INFERENCE from window.md §2.3: write_lines/2 breaks at
%     key#lf, and SIMPOS's newline is the pair cr, lf);
%   - glyphs are drawn `copy` (opaque, OURS), so text overwrites what is
%     under it; a code the font lacks shows the font's 0xffff box (the
%     device's MISSING, never silent).
% Coordinates are dots on the device's frame; the pane is not clipped
% against other windows.  Window M7 (2026-11-25): the dots under the pane
% are saved before it is drawn (save_memory.esp, the save areas of TM-225
% p10 and TM-126 p5, PROSE, window.md §4.1) and restored when it is
% erased, so a window killed over another leaves the other's dots as they
% were when it was covered (until the output permission `out`, what the
% covered window wrote meanwhile was lost).  Since the pane is not
% clipped, the selected window's block cursor (drawn by exclusive_or) is
% taken off before a new pane is drawn (coordinator cursor_aside/1, OURS),
% so it is neither saved under the new pane nor later toggled over it.
% Window M7, output to a covered window: each output method (set_title,
% put_string, put_code, put_codes, new_line, clear) first asks the
% coordinator to uncover the pane (coordinator uncover/3: the windows
% above lifted, if one overlaps it), draws, and lays them back.  So the
% covered part goes into the save areas above and only the shown part
% appears: TM-225 p10-11's ② and TM-125 p6's OUTPUT, the held
% `permission(out)` (63 USAGE sites, window.md §4.1).  That every window
% has this permission is OURS (TM-225's default is ①, wait).  Since
% window M7's rest the window's own permission decides (wait, show and
% notify too; coordinator.esp "OUTPUT PERMISSION"), `out` the default.
% Window M7 (2026-11-25): restacking.  A pane can be lifted off (its own
% dots saved, what was under it drawn back), laid back on top and moved
% (lift/1, lay/1, move_to/3); the coordinator orders them (coordinator.esp
% "THE STACK"), so killing a window that lies under a newer one lifts the
% newer one first and no stale dots are drawn.

class window_pane has

% :create(#window_pane, X, Y, Cols, Rows, Font, Pane) -- INTERPOLATED
% (selector and body OURS) from the layout above: a pane of Cols x Rows
% cells of Font at the outer top-left (X, Y), or, when X is the atom
% `manipulator`, centred on the mouse cursor (the odd dot to the upper
% left) and kept on the screen (OURS: the held option {position,
% manipulator} lets the user sweep the outline with the mouse, window.md
% §4.5; window M6: when the user swept an outline through the system
% menu's `create` (coordinator.esp), the window's top-left is the
% outline's, kept on the screen, its size its own; otherwise it goes
% where the mouse is when it is made.  The cursor starts at the screen's
% centre, coordinator.esp, so a run with no mouse event centres the
% window, as before M6).  Font is a font stand-in or 0
% (the device's OURS substitute for the default font_13).  The pane is
% drawn at once: cleared, bordered, its rule.
:create(Class, X, Y, Cols, Rows, Font, Pane) :-
        :new(Class, Pane),
        metrics(Font, Id, Cw, Ch),
        Pane!font := Id, Pane!cw := Cw, Pane!ch := Ch,
        Pane!cols := Cols, Pane!rows := Rows,
        times(Cols, Cw, 0, Iw), times(Rows, Ch, 0, Ih),
        Pane!iw := Iw, Pane!ih := Ih,
        Pane!w := Iw + 6, Pane!h := Ih + Ch + 9,
        place(Pane, X, Y),
        Pane!left := Pane!x + 3, Pane!top := Pane!y + Ch + 6,
        Pane!cx := Pane!left, Pane!cy := Pane!top,
        :cursor_aside(#coordinator),
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Area),
        Pane!under := Area,
        frame(Pane);

instance

% OURS representation: the outer rectangle (x, y, w, h), the inside's
% top-left (left, top) and size in dots (iw, ih), the cell (cw, ch) and
% the font's device id, the size in cells, the cursor's cell (col, row)
% and its top-left dot (cx, cy), whether the cursor is wanted (selected)
% and whether it is drawn now, and the title drawn.  The cursor's dot is
% kept beside its cell, and every position is a sum, because espc refused
% X*Y on two registers when this was written (it emits blt 42 since
% 2026-11-25; psi/README.md, the register-cache section).
attribute x := 0, y := 0, w := 0, h := 0, left := 0, top := 0,
          iw := 0, ih := 0, cw := 0, ch := 0, font := 0, cols := 0,
          rows := 0, col := 0, row := 0, cx := 0, cy := 0, want := off,
          cursor := off, title := 0;
% window M7, OURS: the save area holding the dots under the pane; while
% the pane is lifted off the screen for a restack, the area holding its
% own dots (0: on the screen).
attribute under := 0, image := 0;

% Window M7, restacking (OURS selectors and bodies; the mechanism PROSE
% TM-225 p10 and TM-126 p5, window.md §4.1 "Implementation": a hidden
% window's image is kept in a save area, and restacking copies between
% the save areas and the frame).  The coordinator (coordinator.esp,
% "the stack") calls them on the panes top-down and bottom-up, so a
% pane is always the top one of those on the screen when it is lifted,
% laid or moved: its rectangle shows its own dots, and its save area
% `under` the dots of what is below it.
%
% :lift(Pane) -- the top pane taken off: its own dots saved, what was
% under it drawn back.
% INTERPOLATED (selector and body OURS): lift; basis above.
:lift(Pane) :-
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Image),
        Pane!image := Image,
        :restore(#save_memory, Pane!under),
        Pane!under := 0;

% :lay(Pane) -- a lifted pane put back on top: what is under it saved,
% its own dots drawn back.
% INTERPOLATED (selector and body OURS): lay; basis above.
:lay(Pane) :-
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Under),
        Pane!under := Under,
        :restore(#save_memory, Pane!image),
        Pane!image := 0;

% :lifted(Pane) -- the pane is off the screen for a restack.
% INTERPOLATED (selector and body OURS): lifted; basis above.
:lifted(Pane) :- Pane!image \== 0;

% :overlaps(Pane, Other) -- the two outer rectangles share a dot.
% INTERPOLATED (selector and body OURS): overlaps; basis above.
:overlaps(Pane, Other) :-
        Pane!x < Other!x + Other!w, Other!x < Pane!x + Pane!w,
        Pane!y < Other!y + Other!h, Other!y < Pane!y + Pane!h;

% :move_to(Pane, X, Y) -- the manipulator's MOVE ("move by mouse",
% PRINTED-INTERFACE TM-125 p8, window.md §4.4): the top pane's outer
% top-left goes to (X, Y), kept on the screen, its dots with it.  The
% device's restore draws an area back where it was saved (winfb, frozen),
% so the dots go across by a copy in the frame (OURS order): the pane's
% dots saved; what was under it drawn back (the area kept); what is
% under the new place saved; the pane's dots drawn at the old place and
% copied to the new; the moved dots saved; the old place's under drawn
% back again; the moved dots drawn back over it.
% INTERPOLATED (selector and body OURS): move_to; basis above.
:move_to(Pane, X0, Y0) :-
        :get_size(#bitmap_display, Sw, Sh),
        on_screen(X0, Pane!w, Sw, X),
        on_screen(Y0, Pane!h, Sh, Y),
        moved(Pane, X, Y);

% :set_title(Pane, Title) -- INTERPOLATED (body OURS) from window.md §2.2
% set_title/2 (PRINTED-INTERFACE TM-125 p15) and §4.3 (the label strip):
% the strip is cleared and the title drawn in it, cut to the strip.
:set_title(Pane, Title) :-
        Pane!title := Title,
        :uncover(#coordinator, Pane, Lifted),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + 2, Pane!w - 4,
              Pane!ch + 2, reset),
        label(Pane, Title),
        :unpeel(#coordinator, Lifted);

% :put_string(Pane, String) -- INTERPOLATED (body OURS) from window.md
% §2.3 write_line/2 and §2.4 putl/2: each code at the cursor, which moves
% on.
:put_string(Pane, String) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        string(String, N, _),
        put_codes(Pane, String, 0, N),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :put_code(Pane, Code) -- INTERPOLATED (body OURS) from window.md §2.3
% write/2 (PRINTED-INTERFACE TM-125 p16): one character at the cursor.
:put_code(Pane, Code) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        put_char(Pane, Code),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :put_codes(Pane, Codes) -- window M4, INTERPOLATED (selector and body
% OURS) from window.md §2.3 write/2: a list of codes at the cursor, as
% put_string/2 (the Pmacs buffer's text, editor_text_buffer.esp).
:put_codes(Pane, Codes) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        put_list(Pane, Codes),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :contains(Pane, X, Y) -- window M6 (selector and body OURS): (X, Y) is
% inside the pane's outer rectangle (the mouse's hit test,
% coordinator.esp).
% INTERPOLATED (selector and body OURS): contains; basis above and in
% the head comment.
:contains(Pane, X, Y) :-
        X >= Pane!x, X < Pane!x + Pane!w,
        Y >= Pane!y, Y < Pane!y + Pane!h;

% :new_line(Pane) -- INTERPOLATED (body OURS) from window.md §2.3 (the
% newline) and §2.4 putl/2 ("then a newline").
:new_line(Pane) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        newline(Pane),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :clear(Pane) -- INTERPOLATED (body OURS) from window.md §2.3 clear/1
% ("clear the window and home the cursor", INFERENCE there).
:clear(Pane) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        :fill(#bitmap_display, Pane!left, Pane!top, Pane!iw, Pane!ih, reset),
        Pane!col := 0, Pane!row := 0,
        Pane!cx := Pane!left, Pane!cy := Pane!top,
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :select(Pane) and :deselect(Pane) -- INTERPOLATED (body OURS) from
% TM-126 p7 (PROSE, window.md §4.1): the selected window shows its
% cursor.
:select(Pane) :- Pane!want := on, cursor_on(Pane);
% INTERPOLATED (body OURS): see select/1.
:deselect(Pane) :- cursor_off(Pane), Pane!want := off;

% :erase(Pane) -- INTERPOLATED (body OURS) from window.md §2.1 kill/1:
% the window leaves the screen; since window M7 the dots under it are
% restored from its save area (until M6 the rectangle was cleared).
:erase(Pane) :-
        Pane!want := off, Pane!cursor := off,
        :restore(#save_memory, Pane!under),
        Pane!under := 0;

local

moved(Pane, X, Y) :- X == Pane!x, Y == Pane!y, !;
moved(Pane, X, Y) :-
        W = Pane!w, H = Pane!h, Old = Pane!under,
        :save(#save_memory, Pane!x, Pane!y, W, H, Image),
        :put_back(#save_memory, Old),
        :save(#save_memory, X, Y, W, H, Under),
        :restore(#save_memory, Image),
        :copy(#bitmap_display, Pane!x, Pane!y, W, H, X, Y, copy),
        :save(#save_memory, X, Y, W, H, Moved),
        :restore(#save_memory, Old),
        :restore(#save_memory, Moved),
        Pane!under := Under,
        value(X - Pane!x, Dx), value(Y - Pane!y, Dy),
        Pane!x := X, Pane!y := Y,
        Pane!left := Pane!left + Dx, Pane!top := Pane!top + Dy,
        Pane!cx := Pane!cx + Dx, Pane!cy := Pane!cy + Dy;

% N x C as a sum (OURS: see the slots)
times(0, _, P, P) :- !;
times(N, C, P0, P) :- times(N - 1, C, P0 + C, P);

metrics(0, Id, Cw, Ch) :- !, :default_font(#bitmap_display, Id, Cw, Ch);
metrics(Font, Id, Cw, Ch) :- Id = Font!id, Cw = Font!width, Ch = Font!height;

place(Pane, manipulator, _) :-
        :placement(#coordinator, X, Y), !,
        :get_size(#bitmap_display, Sw, Sh),
        on_screen(X, Pane!w, Sw, Px),
        on_screen(Y, Pane!h, Sh, Py),
        Pane!x := Px, Pane!y := Py;
place(Pane, manipulator, _) :- !,
        :get_size(#bitmap_display, Sw, Sh),
        C = #coordinator,
        on_screen(C!mouse_x - (Pane!w + 1) / 2, Pane!w, Sw, X),
        on_screen(C!mouse_y - (Pane!h + 1) / 2, Pane!h, Sh, Y),
        Pane!x := X, Pane!y := Y;
place(Pane, X, Y) :- Pane!x := X, Pane!y := Y;

on_screen(V, _, _, 0) :- V < 0, !;
on_screen(V, W, S, V) :- V + W =< S, !;
on_screen(_, W, S, V) :- S >= W, !, value(S - W, V);
on_screen(_, _, _, 0);

value(V, V);

% the rectangle set, its inside reset (a 2-dot border), the rule under
% the label strip
frame(Pane) :-
        :fill(#bitmap_display, Pane!x, Pane!y, Pane!w, Pane!h, set),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + 2, Pane!w - 4,
              Pane!h - 4, reset),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + Pane!ch + 4,
              Pane!w - 4, 1, set);

label(Pane, Title) :-
        string(Title, N, _), !,
        label_codes(Pane, Title, 0, N, Pane!left);
label(_, _);

label_codes(_, _, I, N, _) :- I >= N, !;
label_codes(Pane, _, _, _, X) :- X + Pane!cw > Pane!x + Pane!w - 3, !;
label_codes(Pane, Title, I, N, X) :-
        string_element(Title, I, C),
        :glyph(#bitmap_display, Pane!font, C, X, Pane!y + 3, copy),
        label_codes(Pane, Title, I + 1, N, X + Pane!cw);

put_codes(_, _, I, N) :- I >= N, !;
put_codes(Pane, S, I, N) :-
        string_element(S, I, C),
        put_char(Pane, C),
        put_codes(Pane, S, I + 1, N);

put_list(_, []);
put_list(Pane, [C | Cs]) :- put_char(Pane, C), put_list(Pane, Cs);

put_char(Pane, 10) :- !, newline(Pane);
put_char(Pane, 13) :- !, Pane!col := 0, Pane!cx := Pane!left;
put_char(Pane, C) :-
        Pane!col >= Pane!cols, !,
        newline(Pane),
        put_char(Pane, C);
put_char(Pane, C) :-
        :glyph(#bitmap_display, Pane!font, C, Pane!cx, Pane!cy, copy),
        Pane!col := Pane!col + 1, Pane!cx := Pane!cx + Pane!cw;

% the next row, or (on the last) the text up one row and the last cleared
newline(Pane) :-
        Pane!col := 0, Pane!cx := Pane!left,
        Pane!row + 1 < Pane!rows, !,
        Pane!row := Pane!row + 1, Pane!cy := Pane!cy + Pane!ch;
newline(Pane) :-
        :copy(#bitmap_display, Pane!left, Pane!top + Pane!ch,
              Pane!iw, Pane!ih - Pane!ch, Pane!left, Pane!top, copy),
        :fill(#bitmap_display, Pane!left, Pane!top + Pane!ih - Pane!ch,
              Pane!iw, Pane!ch, reset);

% the block cursor: drawn by exclusive_or, so drawing it twice erases it
cursor_off(Pane) :- Pane!cursor == on, !, block(Pane), Pane!cursor := off;
cursor_off(_);

cursor_on(Pane) :-
        Pane!want == on, Pane!cursor == off, Pane!col < Pane!cols, !,
        block(Pane), Pane!cursor := on;
cursor_on(_);

block(Pane) :-
        :fill(#bitmap_display, Pane!cx, Pane!cy, Pane!cw, Pane!ch,
              exclusive_or);

end.
