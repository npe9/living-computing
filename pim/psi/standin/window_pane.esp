% SCAFFOLDING, OURS: the screen part of one text window, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: `window_pane`
% is not a SIMPOS class name, and no window-system class body is held
% (docs/simpos/subsystems/window.md §0.3).  Window milestones M3/M5
% (docs/simpos/window_environment_plan.md §4.1): the window stand-ins
% (standard_io_window.esp, pmacs_window.esp) keep their SIMPOS-visible
% state and hand the drawing to a pane; the pane decides every rectangle,
% glyph position, scroll and cursor, and sends only the device primitives
% of simpos##bitmap_display (psi/windev.py: kl0 models, each one command
% of the frozen winfb set).  So the window manager is ESP, as SIMPOS's was
% on the PSI/UX (Giho 9106 p86, PROSE: the SIMPOS window manager made the
% drawing requests, a window server outside SIMPOS drew them).
%
% THE LOOK, each choice with its basis (window.md §4.2-§4.3 and the plan
% §3's common look):
%   - white screen, black text: SCREENSHOT simpos.wmv@0-10, esp.wmv@110-121
%     (window.md §4.2);
%   - a single-line border, 2 dots: PRINTED-INTERFACE TM-125 p15 (the
%     default border width, window.md §2.2, §4.3); no shadow (SCREENSHOT);
%   - margins of 1 dot: PRINTED-INTERFACE TM-125 p16 (window.md §2.2);
%   - the label: a strip inside the top border, the title left-aligned in
%     the label font, a rule under it (SCREENSHOT simpos.wmv@0, @117,
%     @124, window.md §4.3).  The strip is one cell high plus 2 dots, the
%     title 1 dot below the border and at the text's left edge, the rule
%     1 dot: OURS;
%   - the text cursor a solid block (SCREENSHOT IPSJ 36239 p5, simpos.wmv@0,
%     window.md §2.3, §4.3), the size of the font's space character (PROSE
%     TM-115 p16-17, window.md §2.2), drawn by exclusive_or (OURS) only
%     while the window is the selected one (TM-126 p7, PROSE: the selected
%     window's cursor blinks; it does not blink here, OURS);
%   - text in character cells, rows from the top (TM-125 level, window.md
%     §2.3); a line that reaches the last column goes on in the next row
%     (OURS); a newline past the last row scrolls the text up one row by a
%     copy and clears the last row (scroll/2's "positive = up",
%     PRINTED-INTERFACE TM-125 p16; that output scrolls is INFERENCE);
%   - code 10 (key#lf) in a string breaks the line and 13 (key#cr) returns
%     to column 0 (INFERENCE from window.md §2.3: write_lines/2 breaks at
%     key#lf, and SIMPOS's newline is the pair cr, lf);
%   - glyphs are drawn `copy` (opaque, OURS), so text overwrites what is
%     under it; a code the font lacks shows the font's 0xffff box (the
%     device's MISSING, never silent).
% Coordinates are dots on the device's frame; the pane is not clipped
% against other windows.  Window M7 (2026-11-25): the dots under the pane
% are saved before it is drawn (save_memory.esp, the save areas of TM-225
% p10 and TM-126 p5, PROSE, window.md §4.1) and restored when it is
% erased, so a window killed over another leaves the other's dots as they
% were when it was covered (until the output permission `out`, what the
% covered window wrote meanwhile was lost).  Since the pane is not
% clipped, the selected window's block cursor (drawn by exclusive_or) is
% taken off before a new pane is drawn (coordinator cursor_aside/1, OURS),
% so it is neither saved under the new pane nor later toggled over it.
% Window M7, output to a covered window: each output method (set_title,
% put_string, put_code, put_codes, new_line, clear) first asks the
% coordinator to uncover the pane (coordinator uncover/3: the windows
% above lifted, if one overlaps it), draws, and lays them back.  So the
% covered part goes into the save areas above and only the shown part
% appears: TM-225 p10-11's ② and TM-125 p6's OUTPUT, the held
% `permission(out)` (63 USAGE sites, window.md §4.1).  That every window
% has this permission is OURS (TM-225's default is ①, wait).  Since
% window M7's rest the window's own permission decides (wait, show and
% notify too; coordinator.esp "OUTPUT PERMISSION"), `out` the default.
% Window M7 (2026-11-25): restacking.  A pane can be lifted off (its own
% dots saved, what was under it drawn back), laid back on top and moved
% (lift/1, lay/1, move_to/3); the coordinator orders them (coordinator.esp
% "THE STACK"), so killing a window that lies under a newer one lifts the
% newer one first and no stale dots are drawn.

class window_pane has

% :create(#window_pane, X, Y, Cols, Rows, Font, Pane) -- INTERPOLATED
% (selector and body OURS) from the layout above: a pane of Cols x Rows
% cells of Font at the outer top-left (X, Y), or, when X is the atom
% `manipulator`, centred on the mouse cursor (the odd dot to the upper
% left) and kept on the screen (OURS: the held option {position,
% manipulator} lets the user sweep the outline with the mouse, window.md
% §4.5; window M6: when the user swept an outline through the system
% menu's `create` (coordinator.esp), the window's top-left is the
% outline's, kept on the screen, its size its own; otherwise it goes
% where the mouse is when it is made.  The cursor starts at the screen's
% centre, coordinator.esp, so a run with no mouse event centres the
% window, as before M6).  Font is a font stand-in or 0
% (the device's OURS substitute for the default font_13).  The pane is
% drawn at once: cleared, bordered, its rule.
:create(Class, X, Y, Cols, Rows, Font, Pane) :-
        :new(Class, Pane),
        metrics(Font, Id, Cw, Ch),
        Pane!font := Id, Pane!cw := Cw, Pane!ch := Ch,
        Pane!cols := Cols, Pane!rows := Rows,
        times(Cols, Cw, 0, Iw), times(Rows, Ch, 0, Ih),
        Pane!iw := Iw, Pane!ih := Ih,
        Pane!w := Iw + 6, Pane!h := Ih + Ch + 9,
        place(Pane, X, Y),
        Pane!left := Pane!x + 3, Pane!top := Pane!y + Ch + 6,
        Pane!cx := Pane!left, Pane!cy := Pane!top,
        :cursor_aside(#coordinator),
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Area),
        Pane!under := Area,
        frame(Pane);

% :create_surface(#window_pane, Iw, Ih, Font, Pane) -- window M8's stops,
% step 3 (selector and body OURS; m8_stops.md §2, §7): the pane of a
% window drawn on before it is shown, or never shown (paragraph p_imag.esp
% go1-go6 draw into windows they never activate; TM-125 ch.4 PROSE: the
% bare_window mixin "allocates the bitmap area").  Its inside, Iw x Ih
% dots, is an area of bitmap memory (save_memory.esp allocate/3, ceil(Iw/16)
% words a row), cleared (OURS: TM-115 p44 says 1.0's bitmap areas are not
% cleared on allocation; a cleared one is the stand-in's choice), with its
% inside at the area's (0, 0): left = top = 0, no border, no title.  The
% drawing methods reach it through coordinator.esp uncover/3, which aims
% the device at the area (aim/1) and unpeel/2 back at the frame.  A size
% bitmap memory cannot hold refuses loudly (graphics_refused/2,
% bitmap_memory): its 65,536 words are block RAM until H8 (SDRAM).
% INTERPOLATED (selector and body OURS): create_surface; basis above.
:create_surface(Class, Iw, Ih, Font, Pane) :-
        value((Iw + 15) / 16, N), times(Ih, N, 0, Size),
        Iw > 0, Ih > 0, :allocate(#save_memory, Size, Area), !,
        :new(Class, Pane),
        metrics(Font, Id, Cw, Ch),
        Pane!font := Id, Pane!cw := Cw, Pane!ch := Ch,
        Pane!iw := Iw, Pane!ih := Ih, Pane!w := Iw, Pane!h := Ih,
        Pane!pitch := N, Pane!surface := Area,
        cells(Iw, Cw, Cols), cells(Ih, Ch, Rows),
        Pane!cols := Cols, Pane!rows := Rows,
        :aim(Pane),
        :fill(#bitmap_display, 0, 0, Iw, Ih, reset),
        :surface(#bitmap_display, frame);
:create_surface(_, _, _, _, _) :- :graphics_refused(#window_pane, bitmap_memory);

% :create_frame(#window_pane, X, Y, W, H, Font, Sash, Pane) -- MENDELS's
% window mixins (2026-11-27; selector and body OURS): the pane of a
% top-level window made of the mixin stand-ins (basic_window.esp), its
% outer rectangle W x H dots at (X, Y), kept on the screen, and Sash
% [Border, Label, Margin, Title]: a 2-dot border when Border is on (TM-125
% p15, the default border width), a label strip with Title in Font (0: the
% device's default) and a rule under it when Label is on (as create/7's),
% a 1-dot margin inside when Margin is on (TM-125 p14 Table 1); the
% inside is what is left (left, top, iw, ih).  The dots under it are saved
% and it is drawn at once, as create/7's.  It has no text cells (cols =
% rows = 0, so no block cursor is drawn); the windows' own stand-ins draw
% in it.
% INTERPOLATED (selector and body OURS): create_frame; basis above.
% LABEL: OURS (the look of basic_window.esp)
:create_frame(Class, X, Y, W, H, Font, [Border, Label, Margin, Title], Pane) :-
        :new(Class, Pane),
        metrics(Font, Id, Cw, Ch),
        Pane!font := Id, Pane!cw := Cw, Pane!ch := Ch,
        Pane!w := W, Pane!h := H,
        :get_size(#bitmap_display, Sw, Sh),
        on_screen(X, W, Sw, Px), on_screen(Y, H, Sh, Py),
        Pane!x := Px, Pane!y := Py,
        flag_dots(Border, 2, B), flag_dots(Margin, 1, M),
        flag_dots(Label, Ch + 4, L),
        Pane!left := Px + B + M, Pane!top := Py + B + L + M,
        Pane!iw := W - B - B - M - M, Pane!ih := H - B - B - L - M - M,
        Pane!cx := Pane!left, Pane!cy := Pane!top,
        Pane!title := Title,
        :cursor_aside(#coordinator),
        % MENDELS's resume/0 (2026-11-28, OURS): only the part that holds
        % other windows (save_memory.esp save_under/6)
        :save_under(#save_memory, Px, Py, W, H, Area),
        Pane!under := Area,
        framed(Pane, B, L, Title);

% :cell_of(#window_pane, Font, Cw, Ch) -- window M8's stops (selector and
% body OURS): the cell of Font (0: the device's default), as create/7
% lays it out.
% INTERPOLATED (selector and body OURS): cell_of; basis above.
:cell_of(_, Font, Cw, Ch) :- metrics(Font, _, Cw, Ch);

% :pattern(#window_pane, Pattern) -- window M8's rest (selector and body
% OURS): Pattern is one pattern_in/7 draws: a name below, or a held
% pattern string of 256 words.
% INTERPOLATED (selector and body OURS): pattern; basis above and at
% pattern_in/7.
:pattern(_, P) :- named(P, 0, _), !;
:pattern(_, P) :- string(P, N, _), N == 256;

% :outer_size(#window_pane, Cols, Rows, Font, W, H) -- window M9 (selector
% and body OURS): the outer size in dots of a pane of Cols x Rows cells of
% Font (0: the device's default), as create/7 lays it out.
% INTERPOLATED (selector and body OURS): outer_size; basis above.
:outer_size(_, Cols, Rows, Font, W, H) :-
        metrics(Font, _, Cw, Ch),
        times(Cols, Cw, 0, Iw), times(Rows, Ch, 0, Ih),
        value(Iw + 6, W), value(Ih + Ch + 9, H);

instance

% OURS representation: the outer rectangle (x, y, w, h), the inside's
% top-left (left, top) and size in dots (iw, ih), the cell (cw, ch) and
% the font's device id, the size in cells, the cursor's cell (col, row)
% and its top-left dot (cx, cy), whether the cursor is wanted (selected)
% and whether it is drawn now, and the title drawn.  The cursor's dot is
% kept beside its cell, and every position is a sum, because espc refused
% X*Y on two registers when this was written (it emits blt 42 since
% 2026-11-25; psi/README.md, the register-cache section).
attribute x := 0, y := 0, w := 0, h := 0, left := 0, top := 0,
          iw := 0, ih := 0, cw := 0, ch := 0, font := 0, cols := 0,
          rows := 0, col := 0, row := 0, cx := 0, cy := 0, want := off,
          cursor := off, title := 0;
% window M7, OURS: the save area holding the dots under the pane; while
% the pane is lifted off the screen for a restack, the area holding its
% own dots (0: on the screen).
attribute under := 0, image := 0;
% window M8's stops, step 3, OURS: a surface pane's area of bitmap memory
% (save_memory.esp [Id, Base, Size]; 0: the pane is on the frame) and its
% words a row.
attribute surface := 0, pitch := 0;
% MENDELS's title (2026-11-28), OURS: the inside shown inverted (yes after
% invert/1, the window's background black): text is drawn white on black.
attribute inverted := no;

% :invert(Pane) -- MENDELS's title (2026-11-28; selector and body OURS):
% the inside's dots inverted and the text drawn inverted from now on (a
% second invert/1 turns it back).  standard_io_window.esp background/2.
% INTERPOLATED (selector and body OURS): invert; basis above.
:invert(Pane) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        :fill(#bitmap_display, Pane!left, Pane!top, Pane!iw, Pane!ih, exclusive_or),
        flipped(Pane!inverted, F), Pane!inverted := F,
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :characters_in(Pane, Chars, Op, Font) -- MENDELS's title (2026-11-28;
% selector OURS; the list's form PRINTED-INTERFACE TM-785 PDF p40,
% draw_characters `[{Code, X, Y, W, H}, ...]`): each code's glyph of Font
% (0: the pane's) made into a W x H box at (X, Y), the glyph's dots
% repeated floor(W / cell width) by floor(H / cell height) times (nearest
% dot, magnify_in/10, OURS), drawn opaque at the box's top-left; on an
% inverted pane the box is inverted after.  Op `set` only (MENDELS
% title.esp:98); another op, or a box that leaves the inside, refuses
% loudly.
% INTERPOLATED (selector and body OURS): characters_in; basis above.
:characters_in(_, [], _, _) :- !;
:characters_in(Pane, [{C, X, Y, W, H} | Cs], set, Font) :- !,
        character(Pane, C, X, Y, W, H, Font),
        :characters_in(Pane, Cs, set, Font);
:characters_in(Pane, _, Op, _) :- :graphics_refused(Pane, Op);

% :aim(Pane) -- window M8's stops, step 3 (selector and body OURS): the
% device's surfaces set to the pane's: its area, or the frame.
% INTERPOLATED (selector and body OURS): aim; basis at create_surface/5.
:aim(Pane) :- Pane!surface = [_, Base, _], !,
        :surface(#bitmap_display, Base, Pane!pitch, Pane!iw, Pane!ih);
:aim(_) :- :surface(#bitmap_display, frame);

% :shown_in(Pane, Q) -- window M8's stops, step 3 (selector and body OURS):
% the surface pane's dots copied into the inside of the shown pane Q (cut
% to the smaller of the two), and its area freed.  The copy is the
% device's (windev show/7), under uncover/3 as any drawing.
% INTERPOLATED (selector and body OURS): shown_in; basis at
% create_surface/5.
:shown_in(Pane, Q) :- Pane!surface = [_, Base, _], !,
        low_end(Pane!iw, Q!iw, W), low_end(Pane!ih, Q!ih, H),
        :uncover(#coordinator, Q, Lifted),
        cursor_off(Q),
        :show(#bitmap_display, Base, Pane!pitch, W, H, Q!left, Q!top),
        cursor_on(Q),
        :unpeel(#coordinator, Lifted),
        :free(Pane);
:shown_in(_, _);

% :free(Pane) -- window M8's stops, step 3 (selector and body OURS): a
% surface pane's area given back (a killed window that was never shown).
% INTERPOLATED (selector and body OURS): free; basis at create_surface/5.
:free(Pane) :- Pane!surface \== 0, !,
        :free(#save_memory, Pane!surface), Pane!surface := 0;
:free(_);

% Window M7, restacking (OURS selectors and bodies; the mechanism PROSE
% TM-225 p10 and TM-126 p5, window.md §4.1 "Implementation": a hidden
% window's image is kept in a save area, and restacking copies between
% the save areas and the frame).  The coordinator (coordinator.esp,
% "the stack") calls them on the panes top-down and bottom-up, so a
% pane is always the top one of those on the screen when it is lifted,
% laid or moved: its rectangle shows its own dots, and its save area
% `under` the dots of what is below it.
%
% :lift(Pane) -- the top pane taken off: its own dots saved, what was
% under it drawn back.
% INTERPOLATED (selector and body OURS): lift; basis above.
:lift(Pane) :-
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Image),
        Pane!image := Image,
        :restore(#save_memory, Pane!under),
        Pane!under := 0;

% :lay(Pane) -- a lifted pane put back on top: what is under it saved,
% its own dots drawn back.
% INTERPOLATED (selector and body OURS): lay; basis above.
:lay(Pane) :-
        :save(#save_memory, Pane!x, Pane!y, Pane!w, Pane!h, Under),
        Pane!under := Under,
        :restore(#save_memory, Pane!image),
        Pane!image := 0;

% :lifted(Pane) -- the pane is off the screen for a restack.
% INTERPOLATED (selector and body OURS): lifted; basis above.
:lifted(Pane) :- Pane!image \== 0;

% :overlaps(Pane, Other) -- the two outer rectangles share a dot.
% INTERPOLATED (selector and body OURS): overlaps; basis above.
:overlaps(Pane, Other) :-
        Pane!x < Other!x + Other!w, Other!x < Pane!x + Pane!w,
        Pane!y < Other!y + Other!h, Other!y < Pane!y + Pane!h;

% :move_to(Pane, X, Y) -- the manipulator's MOVE ("move by mouse",
% PRINTED-INTERFACE TM-125 p8, window.md §4.4): the top pane's outer
% top-left goes to (X, Y), kept on the screen, its dots with it.  The
% device's restore draws an area back where it was saved (winfb, frozen),
% so the dots go across by a copy in the frame (OURS order): the pane's
% dots saved; what was under it drawn back (the area kept); what is
% under the new place saved; the pane's dots drawn at the old place and
% copied to the new; the moved dots saved; the old place's under drawn
% back again; the moved dots drawn back over it.
% INTERPOLATED (selector and body OURS): move_to; basis above.
:move_to(Pane, X0, Y0) :-
        :get_size(#bitmap_display, Sw, Sh),
        on_screen(X0, Pane!w, Sw, X),
        on_screen(Y0, Pane!h, Sh, Y),
        moved(Pane, X, Y);

% :set_title(Pane, Title) -- INTERPOLATED (body OURS) from window.md §2.2
% set_title/2 (PRINTED-INTERFACE TM-125 p15) and §4.3 (the label strip):
% the strip is cleared and the title drawn in it, cut to the strip.
:set_title(Pane, Title) :-
        Pane!title := Title,
        :uncover(#coordinator, Pane, Lifted),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + 2, Pane!w - 4,
              Pane!ch + 2, reset),
        label(Pane, Title),
        :unpeel(#coordinator, Lifted);

% :put_string(Pane, String) -- INTERPOLATED (body OURS) from window.md
% §2.3 write_line/2 and §2.4 putl/2: each code at the cursor, which moves
% on.
:put_string(Pane, String) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        string(String, N, _),
        put_codes(Pane, String, 0, N),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :put_code(Pane, Code) -- INTERPOLATED (body OURS) from window.md §2.3
% write/2 (PRINTED-INTERFACE TM-125 p16): one character at the cursor.
:put_code(Pane, Code) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        put_char(Pane, Code),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :rub_out(Pane) -- window M11 (2026-11-26), INTERPOLATED (selector and
% body OURS) from getl/2's rubout (standard_io_window.esp's head): the
% character before the cursor erased and the cursor back on its cell (a
% typed line's BS or DEL, standard_io_window.esp getl/2); at column 0 the
% last cell of the row above (a line wraps only when its row is full);
% nothing at the pane's first cell.
:rub_out(Pane) :-
        back(Pane), !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        moved_back(Pane),
        :fill(#bitmap_display, Pane!cx, Pane!cy, Pane!cw, Pane!ch, reset),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:rub_out(_);

% :put_codes(Pane, Codes) -- window M4, INTERPOLATED (selector and body
% OURS) from window.md §2.3 write/2: a list of codes at the cursor, as
% put_string/2 (the Pmacs buffer's text, editor_text_buffer.esp).
:put_codes(Pane, Codes) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        put_list(Pane, Codes),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :contains(Pane, X, Y) -- window M6 (selector and body OURS): (X, Y) is
% inside the pane's outer rectangle (the mouse's hit test,
% coordinator.esp).
% INTERPOLATED (selector and body OURS): contains; basis above and in
% the head comment.
:contains(Pane, X, Y) :-
        X >= Pane!x, X < Pane!x + Pane!w,
        Y >= Pane!y, Y < Pane!y + Pane!h;

% :new_line(Pane) -- INTERPOLATED (body OURS) from window.md §2.3 (the
% newline) and §2.4 putl/2 ("then a newline").
:new_line(Pane) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        newline(Pane),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :clear(Pane) -- INTERPOLATED (body OURS) from window.md §2.3 clear/1
% ("clear the window and home the cursor", INFERENCE there).
:clear(Pane) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        blank_op(Pane, Op),
        :fill(#bitmap_display, Pane!left, Pane!top, Pane!iw, Pane!ih, Op),
        Pane!col := 0, Pane!row := 0,
        Pane!cx := Pane!left, Pane!cy := Pane!top,
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :draw_row(Pane, Row, Codes, Op) -- window M10 (selector and body OURS),
% for a Pmacs window's screen (pmacs_display.esp): text row Row cleared and
% Codes drawn in it from column 0, the ones past the last column left
% out; with Op `reverse` the row is then inverted by exclusive_or (the
% reversed mode line, window.md §2.11, SCREENSHOT).  The cursor is not
% moved.
% INTERPOLATED (selector and body OURS): basis above.
:draw_row(Pane, Row, Codes, Op) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        value(Pane!top + Row * Pane!ch, Y),
        :fill(#bitmap_display, Pane!left, Y, Pane!iw, Pane!ch, reset),
        row_glyphs(Pane, Codes, 0, Pane!left, Y),
        row_reversed(Pane, Y, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :set_cursor(Pane, Col, Row) -- window M10 (selector and body OURS): the
% cursor to cell (Col, Row) (a Pmacs window's point, pmacs_display.esp).
% INTERPOLATED (selector and body OURS): basis above.
:set_cursor(Pane, Col, Row) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        Pane!col := Col, Pane!row := Row,
        value(Pane!left + Col * Pane!cw, X), value(Pane!top + Row * Pane!ch, Y),
        Pane!cx := X, Pane!cy := Y,
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :select(Pane) and :deselect(Pane) -- INTERPOLATED (body OURS) from
% TM-126 p7 (PROSE, window.md §4.1): the selected window shows its
% cursor.
:select(Pane) :- Pane!want := on, cursor_on(Pane);
% INTERPOLATED (body OURS): see select/1.
:deselect(Pane) :- cursor_off(Pane), Pane!want := off;

% :erase(Pane) -- INTERPOLATED (body OURS) from window.md §2.1 kill/1:
% the window leaves the screen; since window M7 the dots under it are
% restored from its save area (until M6 the rectangle was cleared).
:erase(Pane) :-
        Pane!want := off, Pane!cursor := off,
        :restore(#save_memory, Pane!under),
        Pane!under := 0;

% Window M8 (2026-11-26): GRAPHICS in the pane's inside (window.md §2.5,
% the plan's M8).  Coordinates are dots from the inside's top-left
% (PRINTED-INTERFACE TM-125 p17, window.md §2.5 "coordinates are dots in
% the inside area"); the ops are the device's (set, reset, exclusive_or,
% copy, reverse; psi/windev.py).  Each method goes through uncover/3 and
% unpeel/2 like the text methods, so a covered window's drawing obeys its
% output permission, and takes the block cursor off around the drawing.
% Clipping to the inside (OURS): a fill, and so a horizontal or vertical
% line and a rectangle, is cut to the inside; a slanted line is drawn only
% when it lies wholly inside, and refuses loudly otherwise (the device's
% line has no clip of its own but the frame's); a glyph is drawn only
% when its cell lies wholly inside; a transfer's two areas must lie
% inside, or it refuses loudly.  graphics_refused/2 is not a method of
% any class (OURS), so such a send is refused "not in the stand-in",
% never silently dropped.

% :draw_line_in(Pane, X1, Y1, X2, Y2, Width, Op) -- INTERPOLATED
% (selector and body OURS) from window.md §2.5 draw_line/8 (TM-125 p17,
% TM-785 p40): a solid line Width dots wide.  A horizontal or vertical
% line is a fill; the width goes up from an x-major line and right from a
% y-major one (the PSI's geometry, line_in/7, INFERENCE 2026-11-26; the
% device's line widens down or right, so line_in/7 compensates).
% A slanted line leaving the inside is refused BEFORE uncover/3, as
% transfer_in/8's areas are, so a covered window's lifted panes are never
% left lifted by the refusal.
:draw_line_in(Pane, X1, Y1, X2, Y2, Wd, Op) :-
        drawable(Pane, X1, Y1, X2, Y2, Wd), !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        line_in(Pane, X1, Y1, X2, Y2, Wd, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:draw_line_in(Pane, _, _, _, _, _, _) :- :graphics_refused(Pane, line);

% :fill_in(Pane, X, Y, Width, Height, Op) -- INTERPOLATED (selector and
% body OURS) from window.md §2.5 draw_filled_rectangle/6: the rectangle
% filled, cut to the inside.
:fill_in(Pane, X, Y, W, H, Op) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        fill_cut(Pane, X, Y, W, H, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :frame_in(Pane, X, Y, Width, Height, Line, Op) -- INTERPOLATED
% (selector and body OURS) from window.md §2.5 draw_rectangle/8: the
% rectangle's outline, Line dots wide inward (OURS), as four fills that
% do not overlap (so exclusive_or draws each dot once).
:frame_in(Pane, X, Y, W, H, L, Op) :-
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        fill_cut(Pane, X, Y, W, L, Op),
        fill_cut(Pane, X, Y + H - L, W, L, Op),
        fill_cut(Pane, X, Y + L, L, H - L - L, Op),
        fill_cut(Pane, X + W - L, Y + L, L, H - L - L, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :string_in(Pane, X, Y, String, Font, Op) -- INTERPOLATED (selector and
% body OURS) from window.md §2.5 draw_string/4-6: the string's first
% letter's cell top-left at (X, Y) (PRINTED-INTERFACE TM-125 p17), one
% cell of the font a letter; Font 0 is the pane's font.  The stand-ins'
% own cell text (standard_choice_window.esp) is drawn so.  A letter whose
% glyph would leave the inside is not drawn.
:string_in(Pane, X, Y, S, Font, Op) :- string_drawn(Pane, X, Y, S, Font, Op, cell);

% :draw_string_in(Pane, X, Y, String, Font, Op) -- 2026-11-26 (selector
% OURS): draw_string/4-6, as string_in/6 but each glyph lies its record's
% bias rows below Y (f822 word 6, 3 for test_11; windev bias/4).
% INFERENCE: the HELD profiler_icon_image1, 2 and
% profiler_mono_selector_image hold test_11's glyphs 3 rows below the
% draw_string Y of p_imag.esp draw_label/5 and p_v_imag.esp box/6, so the
% printed "top-left" is the font's line top, the glyph cell below it.
% INTERPOLATED (selector and body OURS): draw_string_in; basis above.
:draw_string_in(Pane, X, Y, S, Font, Op) :- string_drawn(Pane, X, Y, S, Font, Op, line);

% :transfer_in(Pane, SX, SY, DX, DY, Width, Height, Op) -- INTERPOLATED
% (selector and body OURS) from window.md §2.5 transfer/8 (USAGE cil
% es_gin.esp:855): a block moved inside the window.
:transfer_in(Pane, SX, SY, DX, DY, W, H, Op) :-
        inside(Pane, SX, SY, W, H), inside(Pane, DX, DY, W, H), !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        :copy(#bitmap_display, Pane!left + SX, Pane!top + SY, W, H,
              Pane!left + DX, Pane!top + DY, Op),
        white_xor(Pane, DX, DY, W, H, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:transfer_in(Pane, _, _, _, _, _, _, _) :- :graphics_refused(Pane, transfer);


% :pattern_in(Pane, X, Y, Width, Height, Pattern, Op) -- window M8's rest
% (2026-11-26), INTERPOLATED (selector and body OURS) from window.md §2.5
% draw_filled_rectangle/8: the rectangle, cut to the inside, filled with a
% pattern through Op.  A pattern is a tile of rows of 16-bit words, MSB
% leftmost (the frame's order): a named one (standard_io_window.esp
% "PATTERNS", its look OURS) is 4 rows of one word, a held pattern string
% (256 words) 64 rows of 4 words (INFERENCE, standard_io_window.esp).  The
% tile is anchored at the inside's top-left (OURS).  Each row is drawn as
% styled lines of the frozen device line (psi/windev.py line/8, winfb's
% style operand): one line when the row's words are equal, else one a
% 16-dot piece; a piece whose word is 0 is not sent.  A 0 dot of the
% pattern leaves the frame's dot as it was, whatever Op (OURS: the
% device's line plots only the style's 1 dots).
:pattern_in(Pane, X, Y, W, H, P, Op) :-
        cut(X, X + W, Pane!iw, X1, W1), cut(Y, Y + H, Pane!ih, Y1, H1),
        W1 > 0, H1 > 0, !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        pattern_rows(Pane, P, X1, X1 + W1 - 1, Y1, Y1 + H1, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:pattern_in(_, _, _, _, _, _, _);

% :image_in(Pane, S, X, Y, Width, Height) -- window M8's rest (2026-11-26),
% INTERPOLATED (selector and body OURS) from window.md §2.5's image
% methods: restore_image/6 (USAGE paragraph p_imag.esp:22, p_v_imag.esp:19)
% draws the image string S at (X, Y), Width x Height dots, ceil(Width/16)
% words a row, MSB leftmost (the held image classes: profiler_icon_image3
% is 112 words for its 16 x 112, p_m_image3.esp and p_imag.esp h3 := 112;
% the row order and the bit order are INFERENCE: the frame's own).  A 1
% in the string is a WHITE dot (INFERENCE, 2026-11-26: read_in/6 and
% psi/README.md "The PSI's line geometry"), the frame's 0.  OURS look:
% the image is opaque (the area set, then the 1 dots reset); each
% row is sent as styled lines of the frozen device line (windev line/8),
% one for each run of equal non-zero words.  The image must lie wholly
% inside and S hold its words, or the method refuses loudly.
:image_in(Pane, S, X, Y, W, H) :-
        inside(Pane, X, Y, W, H), value((W + 15) / 16, N),
        string(S, L, _), value(H * N, Need), L >= Need, !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        fill_cut(Pane, X, Y, W, H, set),
        image_rows(Pane, S, X, Y, W, N, 0, H),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:image_in(Pane, _, _, _, _, _) :- :graphics_refused(Pane, image);

% :shape_in(Pane, CX, CY, RX, RY, Width, Angles, Pattern, Op) -- window
% M8's rest (2026-11-26), INTERPOLATED (selector and body OURS) from
% window.md §2.5's centre-first shapes (draw_circle/7 PRINTED WINCS p3;
% draw_ellipse, draw_arc, draw_elliptical_arc, draw_fan and the filled
% forms PRINTED-INTERFACE TM-785 p40, their elements 0 and 1 the centre:
% TM-785 p33-35's modify/6 adjusts X at 0 and Y at 1).  No source shows
% which dots a shape covers; THE DOTS ARE OURS, each defined by integer
% arithmetic that psi/test_espc.py's reference repeats dot by dot:
%   - a disc of radius R: the dots (x, y) from the centre with
%     x*x + y*y =< R*R + R; an ellipse RX x RY: on each row y (|y| =< RY)
%     the disc of radius RY's half-width h there, scaled to RX * h / RY
%     (truncated);
%   - Width 0 fills; Width W > 0 is the outline W dots wide inward: the
%     ellipse less the ellipse (RX - W) x (RY - W) (nothing less when
%     either is negative);
%   - Angles: `all`, or {A1, A2}, whole degrees >= 0, from A1 to A2
%     anticlockwise (TM-785 p13-14 PROSE: the arc is drawn anticlockwise),
%     0 at the centre's right (INFERENCE; the TM-785 p40 values are 280,
%     40, 95, 170).  Ck and Sk are the cosine and sine of Ak times 1024,
%     rounded (OURS table sine/2); a dot (x, u) (u up) is in when it is not
%     clockwise of A1 and not anticlockwise of A2 (C1*u - S1*x >= 0 and
%     C2*u - S2*x =< 0): both when the sweep is at most 180 degrees,
%     either when it is more; equal angles (mod 360) are the whole shape;
%   - drawn a row at a time as spans that do not overlap (so exclusive_or
%     draws each dot once), each cut to the inside; Pattern fix fills
%     them, any other pattern draws them as pattern_in/7 does.
:shape_in(Pane, CX, CY, RX, RY, Wd, As, Pat, Op) :-
        sector(As, Sec),
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        value(RY - Wd, RI),
        shape_rows(Pane, CX, CY, RX, RY, Wd, RI, Sec, Pat, Op, 0, RY, RI),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

% :fan_in(Pane, CX, CY, R, A1, A2, Width, Op) -- window M8's rest
% (2026-11-26), INTERPOLATED (selector and body OURS) from window.md §2.5
% draw_fan/9 (PRINTED-INTERFACE TM-785 p40): the arc of shape_in/9, Width
% dots wide, and the two radii from the centre to the circle at A1 and A2
% (each draw_line_in/7's line, Width dots wide; the end the centre plus R
% times the angle's cosine and minus R times its sine, over 1024, rounded:
% OURS).  The dots where the radii meet the arc and each other are drawn
% by each (OURS: under exclusive_or they cancel).  A radius leaving the
% inside is refused before anything is lifted.
:fan_in(Pane, CX, CY, R, A1, A2, Wd, Op) :-
        rim(CX, CY, R, A1, X1, Y1), rim(CX, CY, R, A2, X2, Y2),
        drawable(Pane, CX, CY, X1, Y1, Wd), drawable(Pane, CX, CY, X2, Y2, Wd), !,
        sector({A1, A2}, Sec),
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        value(R - Wd, RI),
        shape_rows(Pane, CX, CY, R, R, Wd, RI, Sec, fix, Op, 0, R, RI),
        line_in(Pane, CX, CY, X1, Y1, Wd, Op),
        line_in(Pane, CX, CY, X2, Y2, Wd, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:fan_in(Pane, _, _, _, _, _, _, _) :- :graphics_refused(Pane, fan);

% :lines_in(Pane, Points, Close, Width, Op) -- window M8's rest
% (2026-11-26), INTERPOLATED (selector and body OURS) from window.md §2.5
% draw_graph/2, /9 and draw_polygon/2, /9: the polyline through Points (a
% list of (X, Y), the term ','(X, Y): USAGE kwic scrolls.esp:1135), each
% segment draw_line_in/7's line, Width dots wide; Close 1 (the polygon,
% OURS) adds the segment from the last point back to the first.  A dot
% two segments share is drawn by both (OURS).  Drawn only when every
% segment may be drawn (a slanted one lies wholly inside), else refused
% loudly before anything is lifted, as draw_line_in/7.
:lines_in(Pane, Ps, Close, Wd, Op) :-
        closed(Ps, Close, Qs), segments_drawable(Pane, Qs, Wd), !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        segments(Pane, Qs, Wd, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:lines_in(Pane, _, _, _, _) :- :graphics_refused(Pane, line);

% :copy_in(Pane, Src, SX, SY, DX, DY, Width, Height, Op) -- window M8's
% rest (2026-11-26), INTERPOLATED (selector and body OURS) from window.md
% §2.5 copy/9 (USAGE icotext util_scroll.esp:211 `:copy(W, W!hide_window,
% W!posX, W!posY, 0, 0, SizeX, SizeY, copy)`: from the second window's
% (SX, SY) to the first's (DX, DY), the direction INFERENCE): the block of
% the source pane's inside drawn into this pane's inside through Op.  Both
% areas must lie wholly inside, else the method refuses loudly before
% anything is lifted.  With only the frozen device (screen copy, save and
% restore): the source's dots are saved while it is uncovered (A); then,
% with this pane uncovered, its block (D) and the screen under the
% source's block (B) are saved, A is drawn back at the source's place, the
% block copied to this pane `copy` and saved (E), B and D drawn back, and
% E drawn through Op (save_memory.esp restore/3).  So neither window's
% other dots change, whatever lies over or between them (OURS).
:copy_in(Pane, Src, SX, SY, DX, DY, W, H, Op) :-
        inside(Src, SX, SY, W, H), inside(Pane, DX, DY, W, H), !,
        value(Src!left + SX, AX), value(Src!top + SY, AY),
        value(Pane!left + DX, BX), value(Pane!top + DY, BY),
        :uncover(#coordinator, Src, L1),
        cursor_off(Src),
        :save(#save_memory, AX, AY, W, H, A),
        cursor_on(Src),
        :unpeel(#coordinator, L1),
        :uncover(#coordinator, Pane, L2),
        cursor_off(Pane),
        :save(#save_memory, BX, BY, W, H, D),
        :save(#save_memory, AX, AY, W, H, B),
        :restore(#save_memory, A),
        :copy(#bitmap_display, AX, AY, W, H, BX, BY, copy),
        :save(#save_memory, BX, BY, W, H, E),
        :restore(#save_memory, B),
        :restore(#save_memory, D),
        :restore(#save_memory, E, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, L2);
:copy_in(Pane, _, _, _, _, _, _, _, _) :- :graphics_refused(Pane, copy);

% Window M8's stops, step 2 (2026-11-26): READING DOTS BACK, on the device's
% read (psi/windev.py read/7, winfb's 2026-11-26 extension, OURS and
% owner-approved: docs/simpos/m8_stops.md §3, §4).  Each read goes through
% uncover/3 and unpeel/2 and takes the block cursor off, as a drawing does,
% so the dots read are the window's own.  The device reads 1 = black (the
% frame's); the words given to the program are 1 = WHITE (INFERENCE,
% 2026-11-26, psi/README.md "The PSI's line geometry": the HELD
% profiler_icon_image1..6 and profiler_mono_selector_image were saved by
% save_image/6 from drawings whose `set` lines, `set` strings and `reset`
% fills are known; in all seven the `set` dots are 0 and the `reset` dots
% 1), so each word read is inverted (its pad dots stay 0).
%
% :read_in(Pane, S, X, Y, Width, Height) -- INTERPOLATED (selector and body
% OURS) from window.md §2.5 save_image/6 (USAGE paragraph p_imag.esp:198,
% the inverse of restore_image/6): the inside's rectangle into the string S
% from element 0, ceil(Width/16) words a row, MSB leftmost, the pad dots 0
% (image_in/6's layout).  The rectangle must lie wholly inside and S hold
% its words, or the method refuses loudly.
:read_in(Pane, S, X, Y, W, H) :-
        inside(Pane, X, Y, W, H), value((W + 15) / 16, N),
        string(S, L, _), value(H * N, Need), L >= Need, !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        :read(#bitmap_display, Pane!left + X, Pane!top + Y, W, H, S, _),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted),
        rem16(W, R), last_mask(R, M),
        white_rows(S, N, M, 0, H);
:read_in(Pane, _, _, _, _, _) :- :graphics_refused(Pane, read);

% :save_image_in(Pane, S, X, Y, Width, Height) and
% :restore_image_in(Pane, S, X, Y, Width, Height) -- 2026-11-26 (selectors
% OURS): save_image/6 and restore_image/6's (X, Y) are taken from the
% pane's IMAGE ORIGIN, not its inside's top-left.  MEASURED on the HELD
% profiler_icon_image1..6: their windows (standard_io_window, label,
% margin and border off, never shown, p_imag.esp go1-go6) saved at
% (X + 4, Y + 8) the dots drawn at (X + 1, Y), so the origin lies 3 dots
% left of and 8 rows above the inside (the cause unknown).  INFERENCE
% that the image methods address the window's outer rectangle: the HELD
% profiler_mono_selector_image, saved at (0, 0) of a titled window, holds
% the title strip, its inside starting 24 rows down, and p_imag.esp
% adjust_pos/3 moves a restore by get_label_height/2 - 24.  Here a surface
% pane (never shown) has the measured origin (3, 8); a shown pane's is its
% inside's top-left (OURS: the shown frame's layout is OURS, and the held
% type_switch_icon draw/6 places its image against draw_box/5 lines by
% that layout, test_win_m8_images).
% INTERPOLATED (selector and body OURS): save_image_in; basis above.
:save_image_in(Pane, S, X, Y, W, H) :-
        image_origin(Pane, OX, OY), :read_in(Pane, S, X - OX, Y - OY, W, H);
% INTERPOLATED (selector and body OURS): restore_image_in; basis above.
:restore_image_in(Pane, S, X, Y, W, H) :-
        image_origin(Pane, OX, OY), :image_in(Pane, S, X - OX, Y - OY, W, H);

% :point_in(Pane, X, Y, ^Value) -- INTERPOLATED (selector OURS) from TM-125
% p17's get_point_value/4 (PRINTED-INTERFACE: "the value (0/1) of the
% pixel"; body OURS): a 1 x 1 read.  A dot outside the inside refuses.
:point_in(Pane, X, Y, V) :-
        inside(Pane, X, Y, 1, 1), !,
        new_string(S, 1, 16),
        :read_in(Pane, S, X, Y, 1, 1),
        string_element(S, 0, Wd), bit(0, Wd, V);
:point_in(Pane, _, _, _) :- :graphics_refused(Pane, point);

% :magnify_in(Pane, Q, SX, SY, Width, Height, DX, DY, A, E) -- window M8's
% stops, step 4 (selector and body OURS; standard_io_window.esp "THE
% MATRIX FORM"): Q's Width x Height dots at (SX, SY) read (read_in/6),
% each source dot made A x E dots (nearest dot), drawn opaque at Pane's
% (DX, DY) a row at a time (image_in/6).  Both rectangles must lie inside,
% or the method refuses loudly.
% INTERPOLATED (selector and body OURS): magnify_in; basis above.
:magnify_in(Pane, Q, SX, SY, W, H, DX, DY, A, E) :-
        inside(Q, SX, SY, W, H), value(W * A, W2), value(H * E, H2),
        inside(Pane, DX, DY, W2, H2), !,
        value((W + 15) / 16, N), value(N * H, Size), new_string(S, Size, 16),
        :read_in(Q, S, SX, SY, W, H),
        value((W2 + 15) / 16, N2), new_string(R, N2, 16),
        magnified(Pane, S, N, W, R, N2, W2, A, E, DX, DY, 0, H);
:magnify_in(Pane, _, _, _, _, _, _, _, _, _) :- :graphics_refused(Pane, matrix_copy);

% :paint_in(Pane, X, Y, Pattern, Op) -- INTERPOLATED (selector OURS) from
% window.md §2.5 paint/5 (USAGE kappa2 user_if/pb/pdim.esp:606
% `:paint(OPicon1, 1, 1, Pattern1, set)`, gog DISPPBMS.esp:117, cil
% es_gin.esp:1761): a seed fill.  THE REGION IS INFERENCE AND OURS: no
% source says which dots paint/5 fills.  Here (docs/simpos/m8_stops.md §4)
% it is the dots 4-connected to (X, Y) inside the inside whose value is
% the seed's (OURS: a boundary-colour form would take one more argument,
% which no held caller passes; 4-connected, INFERENCE: an 8-connected fill
% leaks through a one-dot diagonal outline, such as gog's triangle).  The
% region is found first (a scanline fill, its rows read as needed, one
% device read a row) and then drawn row by row as span/6 draws a filled
% shape's spans (Pattern fix or a pattern, through Op), so a pattern's 0
% dots, which leave the frame as it was, cannot feed the search.  A seed
% outside the inside paints nothing (OURS).
:paint_in(Pane, X, Y, Pt, Op) :-
        X >= 0, Y >= 0, X < Pane!iw, Y < Pane!ih, !,
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        value(Pane!ih, H),
        new_heap_vector(Rows, H), new_heap_vector(Spans, H),
        dot_at(Pane, Rows, X, Y, V),
        seeds(Pane, Rows, Spans, V, [{X, Y}]),
        painted(Pane, Spans, 0, Pt, Op),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);
:paint_in(_, _, _, _, _);

local

% window M8's stops, reading dots back (OURS, see read_in/6, paint_in/5)
% the dot of word Wd at B (0 = its MSB, the leftmost dot): espc divides by
% constants only (immediates 0..255, so the larger powers in steps), one
% clause a position
bit(0, Wd, D) :- !, value(Wd / 128 / 128 / 2, Q), odd(Q, D);
bit(1, Wd, D) :- !, value(Wd / 128 / 128, Q), odd(Q, D);
bit(2, Wd, D) :- !, value(Wd / 128 / 64, Q), odd(Q, D);
bit(3, Wd, D) :- !, value(Wd / 64 / 64, Q), odd(Q, D);
bit(4, Wd, D) :- !, value(Wd / 128 / 16, Q), odd(Q, D);
bit(5, Wd, D) :- !, value(Wd / 128 / 8, Q), odd(Q, D);
bit(6, Wd, D) :- !, value(Wd / 128 / 4, Q), odd(Q, D);
bit(7, Wd, D) :- !, value(Wd / 128 / 2, Q), odd(Q, D);
bit(8, Wd, D) :- !, value(Wd / 128, Q), odd(Q, D);
bit(9, Wd, D) :- !, value(Wd / 64, Q), odd(Q, D);
bit(10, Wd, D) :- !, value(Wd / 32, Q), odd(Q, D);
bit(11, Wd, D) :- !, value(Wd / 16, Q), odd(Q, D);
bit(12, Wd, D) :- !, value(Wd / 8, Q), odd(Q, D);
bit(13, Wd, D) :- !, value(Wd / 4, Q), odd(Q, D);
bit(14, Wd, D) :- !, value(Wd / 2, Q), odd(Q, D);
bit(15, Wd, D) :- odd(Wd, D);

odd(Q, D) :- value(Q - (Q / 2) * 2, D);

% the dot (X, Y) of the inside, from row Y's words (read once: Rows holds
% 0 or the row's string)
dot_at(Pane, Rows, X, Y, V) :-
        row_of(Pane, Rows, Y, S),
        value(X / 16, K), string_element(S, K, Wd),
        value(X - K * 16, B), bit(B, Wd, D), V = D;

row_of(_, Rows, Y, S) :- vector_element(Rows, Y, S), S \== 0, !;
row_of(Pane, Rows, Y, S) :-
        value((Pane!iw + 15) / 16, N), new_string(S, N, 16),
        :read(#bitmap_display, Pane!left, Pane!top + Y, Pane!iw, 1, S, _),
        set_vector_element(Rows, Y, S);

% the scanline search: a stack of seeds; a seed of value V not yet in a
% span gives its row's maximal run [L, R] (Spans holds each row's list of
% {L, R}), and each run of V dots in [L, R] on the rows above and below
% gives a seed
seeds(_, _, _, _, []) :- !;
seeds(Pane, Rows, Spans, V, [{X, Y} | Q]) :-
        dot_at(Pane, Rows, X, Y, V), vector_element(Spans, Y, Ss), not_in(Ss, X), !,
        left_end(Pane, Rows, V, X, Y, L), right_end(Pane, Rows, V, X, Y, R),
        set_vector_element(Spans, Y, [{L, R} | Ss]),
        next_row(Pane, Rows, V, L, R, Y - 1, Q, Q1),
        next_row(Pane, Rows, V, L, R, Y + 1, Q1, Q2),
        seeds(Pane, Rows, Spans, V, Q2);
seeds(Pane, Rows, Spans, V, [_ | Q]) :- seeds(Pane, Rows, Spans, V, Q);

not_in(0, _) :- !;                      % a row with no span yet (the vector's 0)
not_in([], _) :- !;
not_in([{L, _} | Ss], X) :- X < L, !, not_in(Ss, X);
not_in([{_, R} | Ss], X) :- X > R, not_in(Ss, X);

left_end(Pane, Rows, V, X, Y, L) :-
        X > 0, dot_at(Pane, Rows, X - 1, Y, V), !, left_end(Pane, Rows, V, X - 1, Y, L);
left_end(_, _, _, X, _, X);

right_end(Pane, Rows, V, X, Y, R) :-
        X + 1 < Pane!iw, dot_at(Pane, Rows, X + 1, Y, V), !,
        right_end(Pane, Rows, V, X + 1, Y, R);
right_end(_, _, _, X, _, X);

next_row(_, _, _, _, _, Y, Q, Q) :- Y < 0, !;
next_row(Pane, _, _, _, _, Y, Q, Q) :- Y >= Pane!ih, !;
next_row(Pane, Rows, V, L, R, Y, Q, Q1) :- runs(Pane, Rows, V, L, R, Y, 0, Q, Q1);

runs(_, _, _, X, R, _, _, Q, Q) :- X > R, !;
runs(Pane, Rows, V, X, R, Y, In, Q, Q1) :-
        dot_at(Pane, Rows, X, Y, V), !,
        pushed(In, X, Y, Q, Q0),
        runs(Pane, Rows, V, X + 1, R, Y, 1, Q0, Q1);
runs(Pane, Rows, V, X, R, Y, _, Q, Q1) :- runs(Pane, Rows, V, X + 1, R, Y, 0, Q, Q1);

pushed(0, X, Y, Q, [{X, Y} | Q]) :- !;
pushed(_, _, _, Q, Q);

% the region drawn: each row's spans (disjoint: a seed inside a span is
% never searched again), top to bottom
painted(Pane, _, Y, _, _) :- Y >= Pane!ih, !;
painted(Pane, Spans, Y, Pt, Op) :-
        vector_element(Spans, Y, Ss), spans(Pane, Ss, Y, Pt, Op),
        painted(Pane, Spans, Y + 1, Pt, Op);

spans(_, 0, _, _, _) :- !;
spans(_, [], _, _, _) :- !;
spans(Pane, [{L, R} | Ss], Y, Pt, Op) :- span(Pane, L, R, Y, Pt, Op), spans(Pane, Ss, Y, Pt, Op);

% window M8's stops, step 4 (OURS, see magnify_in/10): source row J
% spread into R, then R drawn E times
magnified(_, _, _, _, _, _, _, _, _, _, _, J, H) :- J >= H, !;
magnified(Pane, S, N, W, R, N2, W2, A, E, DX, DY, J, H) :-
        zeroed(R, 0, N2),
        value(J * N, Base),
        spread(S, Base, 0, W, A, R),
        value(DY + J * E, Y),
        rows_of(Pane, R, DX, Y, W2, 0, E),
        magnified(Pane, S, N, W, R, N2, W2, A, E, DX, DY, J + 1, H);

zeroed(_, K, N) :- K >= N, !;
zeroed(R, K, N) :- set_string_element(R, K, 0), zeroed(R, K + 1, N);

spread(_, _, I, W, _, _) :- I >= W, !;
spread(S, Base, I, W, A, R) :-
        value(I / 16, K), string_element(S, Base + K, Wd),
        value(I - K * 16, B), bit(B, Wd, 1), !,
        value(I * A, X), dots_set(R, X, X + A),
        spread(S, Base, I + 1, W, A, R);
spread(S, Base, I, W, A, R) :- spread(S, Base, I + 1, W, A, R);

dots_set(_, X, E) :- X >= E, !;
dots_set(R, X, E) :-
        value(X / 16, K), value(X - K * 16, B), weight(B, P),
        string_element(R, K, Old), value(Old + P, New), set_string_element(R, K, New),
        dots_set(R, X + 1, E);

rows_of(_, _, _, _, _, I, E) :- I >= E, !;
rows_of(Pane, R, X, Y, W, I, E) :-
        :image_in(Pane, R, X, Y + I, W, 1), rows_of(Pane, R, X, Y, W, I + 1, E);

% the weight of dot B of a word (0 = its MSB)
weight(0, 16#"8000") :- !;
weight(1, 16#"4000") :- !;
weight(2, 16#"2000") :- !;
weight(3, 16#"1000") :- !;
weight(4, 16#"0800") :- !;
weight(5, 16#"0400") :- !;
weight(6, 16#"0200") :- !;
weight(7, 16#"0100") :- !;
weight(8, 16#"0080") :- !;
weight(9, 16#"0040") :- !;
weight(10, 16#"0020") :- !;
weight(11, 16#"0010") :- !;
weight(12, 16#"0008") :- !;
weight(13, 16#"0004") :- !;
weight(14, 16#"0002") :- !;
weight(15, 1);

% exclusive_or between two areas acts on the PSI's dots, 1 = white
% (INFERENCE, 2026-11-26: paragraph p_imag.esp draw_label/5's mono path,
% copy, light_paint reset, then exclusive_or, gives the HELD
% profiler_icon_image1 and 2 only so: psi/README.md "The PSI's line
% geometry").  On the frame (1 = black) that is the complement of the
% device's exclusive_or, so the destination is inverted after it.  The
% other ops between areas are the device's (OURS: no held dot decides
% them).
white_xor(Pane, DX, DY, W, H, exclusive_or) :- !,
        :fill(#bitmap_display, Pane!left + DX, Pane!top + DY, W, H, exclusive_or);
white_xor(_, _, _, _, _, _);

% the words read, inverted to 1 = white (see read_in/6): each full word
% from 16#"FFFF", a row's last word from M, the mask of its R dots
last_mask(0, 16#"FFFF") :- !;
last_mask(R, M) :- value(R - 1, R1), weight(R1, B), value(16#"FFFF" - B + 1, M);

white_rows(_, _, _, J, H) :- J >= H, !;
white_rows(S, N, M, J, H) :-
        value(J * N, Base), white_words(S, Base, N, M, 0),
        white_rows(S, N, M, J + 1, H);

white_words(S, Base, N, M, K) :- K + 1 >= N, !,
        value(Base + K, I), string_element(S, I, W), value(M - W, V),
        set_string_element(S, I, V);
white_words(S, Base, N, M, K) :-
        value(Base + K, I), string_element(S, I, W), value(16#"FFFF" - W, V),
        set_string_element(S, I, V),
        white_words(S, Base, N, M, K + 1);

% a pane's image origin (see save_image_in/6): (3, 8) above-left of a
% surface pane's inside (MEASURED), the inside's top-left on the screen
image_origin(Pane, 3, 8) :- Pane!surface = [_, _, _], !;
image_origin(_, 0, 0);

% window M8's rest, images (OURS, see image_in/6)
image_rows(_, _, _, _, _, _, J, H) :- J >= H, !;
image_rows(Pane, S, X, Y, W, N, J, H) :-
        value(J * N, Base),
        image_runs(Pane, S, X, Y + J, W, N, Base, 0),
        image_rows(Pane, S, X, Y, W, N, J + 1, H);

image_runs(_, _, _, _, _, N, _, K) :- K >= N, !;
image_runs(Pane, S, X, Y, W, N, Base, K) :-
        string_element(S, Base + K, 0), !,
        image_runs(Pane, S, X, Y, W, N, Base, K + 1);
image_runs(Pane, S, X, Y, W, N, Base, K) :-
        string_element(S, Base + K, Wd),
        run_end(S, Base, N, K, Wd, E),
        value(X + K * 16, X1), value(X + E * 16 + 15, X2a), low_end(X2a, X + W - 1, X2),
        :line(#bitmap_display, Pane!left + X1, Pane!top + Y, Pane!left + X2,
              Pane!top + Y, 1, Wd, reset),
        image_runs(Pane, S, X, Y, W, N, Base, E + 1);

run_end(S, Base, N, K, Wd, E) :- K + 1 < N, string_element(S, Base + K + 1, Wd), !,
        run_end(S, Base, N, K + 1, Wd, E);
run_end(_, _, _, K, _, K);

% window M8's rest, patterns (OURS, see pattern_in/7)
pattern_rows(_, _, _, _, Y, E, _) :- Y >= E, !;
pattern_rows(Pane, P, X1, X2, Y, E, Op) :-
        row_words(P, Y, W0, W1, W2, W3),
        pattern_row(Pane, X1, X2, Y, W0, W1, W2, W3, Op),
        pattern_rows(Pane, P, X1, X2, Y + 1, E, Op);

% a named pattern's row (4 rows of one word), a string's (64 rows of 4)
row_words(P, Y, W, W, W, W) :- named(P, 0, _), !,
        rem4(Y, R), named(P, R, W);
row_words(P, Y, W0, W1, W2, W3) :-
        rem64(Y, R), value(R * 4, I),
        string_element(P, I, W0), string_element(P, I + 1, W1),
        string_element(P, I + 2, W2), string_element(P, I + 3, W3);

pattern_row(Pane, X1, X2, Y, W, W, W, W, Op) :- !,
        styled(Pane, X1, X2, Y, W, Op);
pattern_row(Pane, X1, X2, Y, W0, W1, W2, W3, Op) :-
        pieces(Pane, X1, X2, Y, {W0, W1, W2, W3}, Op);

pieces(_, X, X2, _, _, _) :- X > X2, !;
pieces(Pane, X, X2, Y, Ws, Op) :-
        rem16(X, R), value(X + 15 - R, E0), low_end(E0, X2, E),
        rem64(X, Q), value(Q / 16, K), vector_element(Ws, K, W),
        styled(Pane, X, E, Y, W, Op),
        pieces(Pane, E + 1, X2, Y, Ws, Op);

low_end(A, B, A) :- A =< B, !;
low_end(_, B, B);

% one row piece from X1 to X2 (inside dots) whose dots are the word W at
% the tile's columns: the style is W turned left by X1's column in it
styled(_, _, _, _, 0, _) :- !;
styled(Pane, X1, X2, Y, W, Op) :-
        rem16(X1, S), rotated(W, S, St),
        :line(#bitmap_display, Pane!left + X1, Pane!top + Y, Pane!left + X2,
              Pane!top + Y, 1, St, Op);

% W turned left by S bits in 16, one bit at a time (OURS arithmetic: espc
% emits no shift, and X/Y only by a constant)
rotated(W, 0, W) :- !;
rotated(W, S, R) :- turned(W, W1), rotated(W1, S - 1, R);

turned(W, R) :- W >= 16#"8000", !, Top = 16#"FFFF", value(W + W - Top, R);
turned(W, R) :- value(W + W, R);

% the named patterns, a word for each of 4 rows.  The names are the held
% and printed ones (window.md §2.5 "Fill pattern"): light_paint (USAGE
% paragraph p_imag.esp go1/1, bar_v.esp set_pattern/2), dotted (bar_v.esp
% set_pattern/2; TM-785 p40), right_hatch (USAGE bar2_v.esp:263), mesh,
% left_hatch, small_mesh (PRINTED-INTERFACE TM-785 p40).
% light_paint's dots are HELD-DERIVED: paragraph's image classes were made
% by filling a window `fix, set`, then `light_paint, reset`, drawing on it
% and save_image/6 (p_imag.esp go1/1 :175-198, p_v_imag.esp :151-152,
% :228).  The saved words are 1 for white (INFERENCE, 2026-11-26, from
% the same images: read_in/6), so their background words ARE light_paint:
% profiler_mono_selector_image has 16#"7777" on every even row of its
% inside and 16#"DDDD" on every odd one (MEASURED on the held .ptf,
% test_win_m8_images), and profiler_icon_image1..6 show the same lattice
% anchored at the inside's top-left once their image origin (3, 8) is
% taken off (save_image_in/6).  So light_paint is anchored at the inside's
% top-left (INFERENCE: both windows agree) and covers 3 dots in 4.  Until
% 2026-11-26 it was the complement, 8888 and 2222, read with the saved
% words taken as 1 = black.  The other names' looks are OURS: no source
% shows a dot of them.
named(light_paint, 0, 16#"7777") :- !;
named(light_paint, 2, 16#"7777") :- !;
named(light_paint, _, 16#"DDDD") :- !;
named(dotted, 0, 16#"AAAA") :- !;
named(dotted, 2, 16#"AAAA") :- !;
named(dotted, _, 0) :- !;
% rough_dotted (USAGE kappa2 user_if/pb/pdim.esp:1094 get_paint_pattern/2,
% fcell.esp; paragraph g_window.esp, bar2_v.esp; kl1graph screen.esp;
% added 2026-11-26, docs/simpos/m8_stops.md §4).  No held image shows a
% dot of it.  Its DENSITY is INFERENCE: sparser than dotted, as the held
% scales order them (examds diag/sl_draw.win: 0 < CL =< 0.2 rough_dotted,
% 0.2 < CL =< 0.4 dotted; paragraph pmeter/rmon.esp make_pattern/2: 2 a
% 2-in-128 pattern, 3 rough_dotted, 4 dotted).  Its dots are OURS: one in
% 8, every 4 columns on every other row, the rows 2 columns apart.
named(rough_dotted, 0, 16#"8888") :- !;
named(rough_dotted, 2, 16#"2222") :- !;
named(rough_dotted, _, 0) :- !;
named(mesh, 0, 16#"FFFF") :- !;
named(mesh, _, 16#"8888") :- !;
named(small_mesh, 0, 16#"AAAA") :- !;
named(small_mesh, 2, 16#"AAAA") :- !;
named(small_mesh, _, 16#"5555") :- !;
named(left_hatch, 0, 16#"8888") :- !;
named(left_hatch, 1, 16#"4444") :- !;
named(left_hatch, 2, 16#"2222") :- !;
named(left_hatch, _, 16#"1111") :- !;
named(right_hatch, 0, 16#"1111") :- !;
named(right_hatch, 1, 16#"2222") :- !;
named(right_hatch, 2, 16#"4444") :- !;
named(right_hatch, _, 16#"8888");

% the remainder of V >= 0 by 4, 16 and 64
rem4(V, R) :- value(V - V / 4 * 4, R);
rem16(V, R) :- value(V - V / 16 * 16, R);
rem64(V, R) :- value(V - V / 64 * 64, R);

moved(Pane, X, Y) :- X == Pane!x, Y == Pane!y, !;
moved(Pane, X, Y) :-
        W = Pane!w, H = Pane!h, Old = Pane!under,
        :save(#save_memory, Pane!x, Pane!y, W, H, Image),
        :put_back(#save_memory, Old),
        :save(#save_memory, X, Y, W, H, Under),
        :restore(#save_memory, Image),
        :copy(#bitmap_display, Pane!x, Pane!y, W, H, X, Y, copy),
        :save(#save_memory, X, Y, W, H, Moved),
        :restore(#save_memory, Old),
        :restore(#save_memory, Moved),
        Pane!under := Under,
        value(X - Pane!x, Dx), value(Y - Pane!y, Dy),
        Pane!x := X, Pane!y := Y,
        Pane!left := Pane!left + Dx, Pane!top := Pane!top + Dy,
        Pane!cx := Pane!cx + Dx, Pane!cy := Pane!cy + Dy;

% N x C as a sum (OURS: see the slots)
times(0, _, P, P) :- !;
times(N, C, P0, P) :- times(N - 1, C, P0 + C, P);

% the cells of size C that fit in N dots, at least 1 (a surface pane's)
cells(N, C, 1) :- N < C + C, !;
cells(N, C, K) :- cells(N - C, C, K0), value(K0 + 1, K);

metrics(0, Id, Cw, Ch) :- !, :default_font(#bitmap_display, Id, Cw, Ch);
metrics(Font, Id, Cw, Ch) :- Id = Font!id, Cw = Font!width, Ch = Font!height;

place(Pane, manipulator, _) :-
        :placement(#coordinator, X, Y), !,
        :get_size(#bitmap_display, Sw, Sh),
        on_screen(X, Pane!w, Sw, Px),
        on_screen(Y, Pane!h, Sh, Py),
        Pane!x := Px, Pane!y := Py;
place(Pane, manipulator, _) :- !,
        :get_size(#bitmap_display, Sw, Sh),
        C = #coordinator,
        on_screen(C!mouse_x - (Pane!w + 1) / 2, Pane!w, Sw, X),
        on_screen(C!mouse_y - (Pane!h + 1) / 2, Pane!h, Sh, Y),
        Pane!x := X, Pane!y := Y;
place(Pane, X, Y) :- Pane!x := X, Pane!y := Y;

on_screen(V, _, _, 0) :- V < 0, !;
on_screen(V, W, S, V) :- V + W =< S, !;
on_screen(_, W, S, V) :- S >= W, !, value(S - W, V);
on_screen(_, _, _, 0);

value(V, V);

% window M8 (see "Window M8" above).  The PSI's line geometry, re-derived
% 2026-11-26 from the HELD profiler_icon_image1..6 (paragraph p_imag.esp
% go1-go6) and checked on the HELD profiler_mono_selector_image
% (psi/README.md "The PSI's line geometry"):
%   - both end points are drawn (INFERENCE, image 4);
%   - a slanted line's dots are the nearest to the true line, and a dot
%     exactly half-way between two rounds TOWARD THE FIRST END POINT
%     (INFERENCE: image 4's eight slope-1/2 lines, all four directions, and
%     the selector's y-major triangles).  The device's line (winfb, the
%     frozen command set) rounds a tie away from its first end point, so
%     the line is sent from (X2, Y2) to (X1, Y1);
%   - a line Wd dots wide is Wd single lines side by side, going UP from
%     an x-major line (horizontal included) and RIGHT from a y-major one
%     (INFERENCE, images 4-6 and the selector: every wide line there is
%     axis-aligned, drawn left to right or top to bottom, so a line drawn
%     the other way is OURS, and "left of the direction drawn" fits too).
%     The device widens an x-major line downward, so it gets Y - Wd + 1.
line_in(Pane, X1, Y1, X2, Y2, Wd, Op) :- Y1 == Y2, !,
        low_span(X1, X2, X, W), fill_cut(Pane, X, Y1 - Wd + 1, W, Wd, Op);
line_in(Pane, X1, Y1, X2, Y2, Wd, Op) :- X1 == X2, !,
        low_span(Y1, Y2, Y, H), fill_cut(Pane, X1, Y, Wd, H, Op);
line_in(Pane, X1, Y1, X2, Y2, Wd, Op) :-
        x_major(X1, Y1, X2, Y2), !,
        :line(#bitmap_display, Pane!left + X2, Pane!top + Y2 - Wd + 1,
              Pane!left + X1, Pane!top + Y1 - Wd + 1, Wd, Op);
line_in(Pane, X1, Y1, X2, Y2, Wd, Op) :-
        :line(#bitmap_display, Pane!left + X2, Pane!top + Y2,
              Pane!left + X1, Pane!top + Y1, Wd, Op);

x_major(X1, Y1, X2, Y2) :-
        low_span(X1, X2, _, W), low_span(Y1, Y2, _, H), W >= H;

drawable(_, _, Y1, _, Y2, _) :- Y1 == Y2, !;
drawable(_, X1, _, X2, _, _) :- X1 == X2, !;
drawable(Pane, X1, Y1, X2, Y2, Wd) :-
        low_span(X1, X2, X, W), low_span(Y1, Y2, Y, H), W >= H, !,
        inside(Pane, X, Y - Wd + 1, W, H + Wd - 1);
drawable(Pane, X1, Y1, X2, Y2, Wd) :-
        low_span(X1, X2, X, W), low_span(Y1, Y2, Y, H),
        inside(Pane, X, Y, W + Wd - 1, H);

low_span(A, B, A, W) :- A =< B, !, value(B - A + 1, W);
low_span(A, B, B, W) :- value(A - B + 1, W);

fill_cut(Pane, X, Y, W, H, Op) :-
        cut(X, X + W, Pane!iw, X1, W1), cut(Y, Y + H, Pane!ih, Y1, H1),
        W1 > 0, H1 > 0, !,
        :fill(#bitmap_display, Pane!left + X1, Pane!top + Y1, W1, H1, Op);
fill_cut(_, _, _, _, _, _);

% [V, E) cut to [0, M): its low end and length
cut(V, E, M, Lo, L) :- low(V, Lo), high(E, M, Hi), value(Hi - Lo, L);

low(V, 0) :- V < 0, !;
low(V, V);

high(E, M, M) :- E > M, !;
high(E, _, E);

inside(Pane, X, Y, W, H) :-
        X >= 0, Y >= 0, X + W =< Pane!iw, Y + H =< Pane!ih;

font_of(Pane, 0, Id, Cw, Ch) :- !, Id = Pane!font, Cw = Pane!cw, Ch = Pane!ch;
font_of(_, Font, Id, Cw, Ch) :- Id = Font!id, Cw = Font!width, Ch = Font!height;

string_drawn(Pane, X, Y, S, Font, Op, Place) :-
        font_of(Pane, Font, Id, Cw, Ch),
        :uncover(#coordinator, Pane, Lifted),
        cursor_off(Pane),
        string(S, N, _),
        letters(Pane, S, 0, N, X, Y, Id, Cw, Ch, Op, Place),
        cursor_on(Pane),
        :unpeel(#coordinator, Lifted);

letters(_, _, I, N, _, _, _, _, _, _, _) :- I >= N, !;
letters(Pane, S, I, N, X, Y, Id, Cw, Ch, Op, Place) :-
        string_element(S, I, C), drop(Place, Id, C, B),
        inside(Pane, X, Y + B, Cw, Ch), !,
        :glyph(#bitmap_display, Id, C, Pane!left + X, Pane!top + Y + B, Op),
        letters(Pane, S, I + 1, N, X + Cw, Y, Id, Cw, Ch, Op, Place);
letters(Pane, S, I, N, X, Y, Id, Cw, Ch, Op, Place) :-
        letters(Pane, S, I + 1, N, X + Cw, Y, Id, Cw, Ch, Op, Place);

% rows from Y to the glyph: none for cell text, the bias for draw_string
drop(cell, _, _, 0) :- !;
drop(line, Id, C, B) :- :bias(#bitmap_display, Id, C, B);

% the rectangle set, its inside reset (a 2-dot border), the rule under
% the label strip
frame(Pane) :-
        :fill(#bitmap_display, Pane!x, Pane!y, Pane!w, Pane!h, set),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + 2, Pane!w - 4,
              Pane!h - 4, reset),
        :fill(#bitmap_display, Pane!x + 2, Pane!y + Pane!ch + 4,
              Pane!w - 4, 1, set);

% create_frame/8 (OURS): the dots a flag stands for; the frame drawn
flag_dots(on, D, D) :- !;
flag_dots(_, _, 0);

framed(Pane, 0, L, Title) :- !,
        :fill(#bitmap_display, Pane!x, Pane!y, Pane!w, Pane!h, reset),
        frame_label(Pane, 0, L, Title);
framed(Pane, B, L, Title) :-
        :fill(#bitmap_display, Pane!x, Pane!y, Pane!w, Pane!h, set),
        :fill(#bitmap_display, Pane!x + B, Pane!y + B, Pane!w - B - B,
              Pane!h - B - B, reset),
        frame_label(Pane, B, L, Title);

frame_label(_, _, 0, _) :- !;
frame_label(Pane, B, _, Title) :-
        :fill(#bitmap_display, Pane!x + B, Pane!y + B + Pane!ch + 2,
              Pane!w - B - B, 1, set),
        string(Title, N, _), !,
        frame_title(Pane, Title, 0, N, Pane!x + B + 1, Pane!y + B + 1,
                    Pane!x + Pane!w - B);
frame_label(_, _, _, _);

frame_title(_, _, I, N, _, _, _) :- I >= N, !;
frame_title(Pane, _, _, _, X, _, R) :- X + Pane!cw > R, !;
frame_title(Pane, T, I, N, X, Y, R) :-
        string_element(T, I, C),
        :glyph(#bitmap_display, Pane!font, C, X, Y, copy),
        frame_title(Pane, T, I + 1, N, X + Pane!cw, Y, R);

label(Pane, Title) :-
        string(Title, N, _), !,
        label_codes(Pane, Title, 0, N, Pane!left);
label(_, _);

label_codes(_, _, I, N, _) :- I >= N, !;
label_codes(Pane, _, _, _, X) :- X + Pane!cw > Pane!x + Pane!w - 3, !;
label_codes(Pane, Title, I, N, X) :-
        string_element(Title, I, C),
        :glyph(#bitmap_display, Pane!font, C, X, Pane!y + 3, copy),
        label_codes(Pane, Title, I + 1, N, X + Pane!cw);

put_codes(_, _, I, N) :- I >= N, !;
put_codes(Pane, S, I, N) :-
        string_element(S, I, C),
        put_char(Pane, C),
        put_codes(Pane, S, I + 1, N);

% window M10 (OURS, see draw_row/4)
row_glyphs(_, [], _, _, _) :- !;
row_glyphs(Pane, _, C, _, _) :- C >= Pane!cols, !;
row_glyphs(Pane, [Code | Codes], C, X, Y) :-
        :glyph(#bitmap_display, Pane!font, Code, X, Y, copy),
        row_glyphs(Pane, Codes, C + 1, X + Pane!cw, Y);

row_reversed(Pane, Y, reverse) :- !,
        :fill(#bitmap_display, Pane!left, Y, Pane!iw, Pane!ch, exclusive_or);
row_reversed(_, _, _);

put_list(_, []);
put_list(Pane, [C | Cs]) :- put_char(Pane, C), put_list(Pane, Cs);

put_char(Pane, 10) :- !, newline(Pane);
put_char(Pane, 13) :- !, Pane!col := 0, Pane!cx := Pane!left;
put_char(Pane, C) :-
        Pane!col >= Pane!cols, !,
        newline(Pane),
        put_char(Pane, C);
put_char(Pane, C) :-
        text_op(Pane, Op),
        :glyph(#bitmap_display, Pane!font, C, Pane!cx, Pane!cy, Op),
        Pane!col := Pane!col + 1, Pane!cx := Pane!cx + Pane!cw;

% rub_out/1's cell: the one before the cursor
back(Pane) :- Pane!col > 0, !;
back(Pane) :- Pane!row > 0;
moved_back(Pane) :- Pane!col > 0, !,
        Pane!col := Pane!col - 1, Pane!cx := Pane!cx - Pane!cw;
moved_back(Pane) :-
        Pane!row := Pane!row - 1, Pane!cy := Pane!cy - Pane!ch,
        Pane!col := Pane!cols - 1, Pane!cx := Pane!left + (Pane!cols - 1) * Pane!cw;

% the next row, or (on the last) the text up one row and the last cleared
newline(Pane) :-
        Pane!col := 0, Pane!cx := Pane!left,
        Pane!row + 1 < Pane!rows, !,
        Pane!row := Pane!row + 1, Pane!cy := Pane!cy + Pane!ch;
newline(Pane) :-
        :copy(#bitmap_display, Pane!left, Pane!top + Pane!ch,
              Pane!iw, Pane!ih - Pane!ch, Pane!left, Pane!top, copy),
        blank_op(Pane, Op),
        :fill(#bitmap_display, Pane!left, Pane!top + Pane!ih - Pane!ch,
              Pane!iw, Pane!ch, Op);

% MENDELS's title (OURS): text and blank dots on an inverted pane
text_op(Pane, reverse) :- Pane!inverted == yes, !;
text_op(_, copy);
blank_op(Pane, set) :- Pane!inverted == yes, !;
blank_op(_, reset);
flipped(yes, no) :- !;
flipped(_, yes);

character(Pane, C, X, Y, W, H, Font) :-
        font_of(Pane, Font, _, Cw, Ch),
        value(W / Cw, A), value(H / Ch, E), A >= 1, E >= 1,
        :create_surface(#window_pane, Cw, Ch, Font, Q),
        new_string(S, 1, 16), set_string_element(S, 0, C),
        :string_in(Q, 0, 0, S, 0, copy),
        :magnify_in(Pane, Q, 0, 0, Cw, Ch, X, Y, A, E),
        :free(Q),
        inverted_box(Pane, X, Y, A * Cw, E * Ch), !;
character(Pane, _, _, _, _, _, _) :- :graphics_refused(Pane, characters);

inverted_box(Pane, X, Y, W, H) :- Pane!inverted == yes, !,
        :uncover(#coordinator, Pane, Lifted),
        :fill(#bitmap_display, Pane!left + X, Pane!top + Y, W, H, exclusive_or),
        :unpeel(#coordinator, Lifted);
inverted_box(_, _, _, _, _);

% the block cursor: drawn by exclusive_or, so drawing it twice erases it
cursor_off(Pane) :- Pane!cursor == on, !, block(Pane), Pane!cursor := off;
cursor_off(_);

cursor_on(Pane) :-
        Pane!want == on, Pane!cursor == off, Pane!col < Pane!cols, !,
        block(Pane), Pane!cursor := on;
cursor_on(_);

block(Pane) :-
        :fill(#bitmap_display, Pane!cx, Pane!cy, Pane!cw, Pane!ch,
              exclusive_or);

% window M8's rest, shapes (OURS, see shape_in/9)
shape_rows(_, _, _, _, RY, _, _, _, _, _, Y, _, _) :- Y > RY, !;
shape_rows(Pane, CX, CY, RX, RY, Wd, RI, Sec, Pat, Op, Y, HO, HI) :-
        shrink(RY, Y, HO, HO1), half(RX, RY, HO1, A),
        inner(RX, Wd, RI, Y, HI, HI1, B),
        row_spans(Pane, CX, CY - Y, Y, A, B, Sec, Pat, Op),
        lower_row(Pane, CX, CY, Y, A, B, Sec, Pat, Op),
        shape_rows(Pane, CX, CY, RX, RY, Wd, RI, Sec, Pat, Op, Y + 1, HO1, HI1);

lower_row(_, _, _, 0, _, _, _, _, _) :- !;
lower_row(Pane, CX, CY, Y, A, B, Sec, Pat, Op) :-
        value(0 - Y, U), row_spans(Pane, CX, CY + Y, U, A, B, Sec, Pat, Op);

% the disc of radius R's half-width on row Y, from the row before's X
shrink(R, Y, X, X) :- X * X =< R * R + R - Y * Y, !;
shrink(R, Y, X, H) :- shrink(R, Y, X - 1, H);

% the ellipse's half-width: the disc's H scaled by RX / RY
half(RX, 0, _, RX) :- !;
half(RX, RY, H, A) :- udiv(RX * H, RY, A);

% the inner ellipse's half-width on row Y, or none
inner(RX, Wd, RI, Y, HI, HI1, B) :-
        Wd > 0, RI >= 0, RX - Wd >= 0, Y =< RI, !,
        shrink(RI, Y, HI, HI1), half(RX - Wd, RI, HI1, B);
inner(_, _, _, _, HI, HI, none);

row_spans(Pane, CX, Y, U, A, none, Sec, Pat, Op) :- !,
        value(0 - A, L), sector_span(Pane, CX, Y, U, L, A, Sec, Pat, Op);
row_spans(Pane, CX, Y, U, A, B, Sec, Pat, Op) :-
        value(0 - A, L), value(0 - B - 1, R),
        sector_span(Pane, CX, Y, U, L, R, Sec, Pat, Op),
        sector_span(Pane, CX, Y, U, B + 1, A, Sec, Pat, Op);

% the part of the span L..R (from the centre) of row Y in the sector
sector_span(_, _, _, _, L, R, _, _, _) :- L > R, !;
sector_span(Pane, CX, Y, _, L, R, all, Pat, Op) :- !,
        span(Pane, CX + L, CX + R, Y, Pat, Op);
sector_span(Pane, CX, Y, U, L, R, Sec, Pat, Op) :-
        sector_row(Sec, U, L1, H1, L2, H2),
        piece(Pane, CX, Y, L, R, L1, H1, Pat, Op),
        piece(Pane, CX, Y, L, R, L2, H2, Pat, Op);

piece(Pane, CX, Y, L, R, Lo, Hi, Pat, Op) :-
        greater(L, Lo, A), lesser(R, Hi, B), A =< B, !,
        span(Pane, CX + A, CX + B, Y, Pat, Op);
piece(_, _, _, _, _, _, _, _, _);

greater(A, B, A) :- A >= B, !;
greater(_, B, B);
lesser(A, B, A) :- A =< B, !;
lesser(_, B, B);

% a sector's row U as two intervals of x that do not overlap (the second
% maybe empty): both half-planes (sweep =< 180) or either (sweep > 180)
sector_row({C1, S1, C2, S2, 0}, U, L, H, 1, 0) :- !,
        left_of(C1, S1, U, La, Ha), right_of(C2, S2, U, Lb, Hb),
        greater(La, Lb, L), lesser(Ha, Hb, H);
sector_row({C1, S1, C2, S2, _}, U, L1, H1, L2, H2) :-
        left_of(C1, S1, U, La, Ha), right_of(C2, S2, U, Lb, Hb),
        either(La, Ha, Lb, Hb, L1, H1, L2, H2);

either(La, Ha, Lb, Hb, L, H, 1, 0) :-
        La =< Ha, Lb =< Hb, La =< Hb + 1, Lb =< Ha + 1, !,
        lesser(La, Lb, L), greater(Ha, Hb, H);
either(La, Ha, Lb, Hb, La, Ha, Lb, Hb);

% {x : C*U - S*x >= 0} on row U, as [Lo, Hi]
left_of(C, 0, U, Lo, Hi) :- !, value(C * U, P), sides(P, Lo, Hi);
left_of(C, S, U, Lo, Hi) :- S > 0, !, endless(Lo, _), floor_div(C * U, S, Hi);
left_of(C, S, U, Lo, Hi) :- endless(_, Hi), ceil_div(0 - C * U, 0 - S, Lo);

% {x : C*U - S*x =< 0} on row U
right_of(C, 0, U, Lo, Hi) :- !, value(0 - C * U, P), sides(P, Lo, Hi);
right_of(C, S, U, Lo, Hi) :- S > 0, !, endless(_, Hi), ceil_div(C * U, S, Lo);
right_of(C, S, U, Lo, Hi) :- endless(Lo, _), floor_div(0 - C * U, 0 - S, Hi);

sides(P, Lo, Hi) :- P >= 0, !, endless(Lo, Hi);
sides(_, 1, 0);

endless(Lo, Hi) :- Hi = 30000, value(0 - Hi, Lo);

% division by a register (espc emits X/Y only by a constant, OURS): the
% quotient of N >= 0 by D > 0 by doubling, and the floor and ceiling of
% N / D for D > 0
udiv(N, D, 0) :- N < D, !;
udiv(N, D, Q) :- doubled(D, 1, N, T, B), udiv(N - T, D, Q0), value(Q0 + B, Q);

doubled(T, B, N, T1, B1) :- T + T =< N, !, doubled(T + T, B + B, N, T1, B1);
doubled(T, B, _, T, B);

floor_div(N, D, Q) :- N >= 0, !, udiv(N, D, Q);
floor_div(N, D, Q) :- udiv(0 - N + D - 1, D, Q0), value(0 - Q0, Q);

ceil_div(N, D, Q) :- floor_div(0 - N, D, Q0), value(0 - Q0, Q);

% one row piece X1..X2 of row Y (inside dots), cut to the inside: filled,
% or drawn with a pattern as pattern_in/7's rows
span(Pane, X1, X2, Y, fix, Op) :- !, fill_cut(Pane, X1, Y, X2 - X1 + 1, 1, Op);
span(Pane, X1, X2, Y, Pat, Op) :-
        Y >= 0, Y < Pane!ih, cut(X1, X2 + 1, Pane!iw, X, W), W > 0, !,
        row_words(Pat, Y, W0, W1, W2, W3),
        pattern_row(Pane, X, X + W - 1, Y, W0, W1, W2, W3, Op);
span(_, _, _, _, _, _);

% polylines (lines_in/5)
closed(Ps, 0, Ps) :- !;
closed([P | Ps], 1, [P | Qs]) :- ended(Ps, P, Qs);

ended([], P, [P]);
ended([Q | Ps], P, [Q | Qs]) :- ended(Ps, P, Qs);

segments_drawable(Pane, [P1, P2 | R], Wd) :- !,
        point(P1, X1, Y1), point(P2, X2, Y2),
        drawable(Pane, X1, Y1, X2, Y2, Wd),
        segments_drawable(Pane, [P2 | R], Wd);
segments_drawable(_, [_], _) :- !;
segments_drawable(_, [], _);

segments(Pane, [P1, P2 | R], Wd, Op) :- !,
        point(P1, X1, Y1), point(P2, X2, Y2),
        line_in(Pane, X1, Y1, X2, Y2, Wd, Op),
        segments(Pane, [P2 | R], Wd, Op);
segments(_, _, _, _);

% a point: (X, Y), the term ','(X, Y), is the vector {',', X, Y} (TM-388
% p.26: a compound term is a vector); {X, Y} too (OURS)
point(P, X, Y) :- stack_vector(P, N), N == 3, !, vector_element(P, 1, X), vector_element(P, 2, Y);
point(P, X, Y) :- vector_element(P, 0, X), vector_element(P, 1, Y);

% an angle's cosine and sine times 1024 (OURS: rounded, the table below)
unit(A, C, S) :-
        value(A / 90, Q), value(A - Q * 90, R), value(90 - R, R2),
        sine(R, SR), sine(R2, CR), quadrant(Q, SR, CR, C, S);

quadrant(0, SR, CR, CR, SR) :- !;
quadrant(1, SR, CR, C, CR) :- !, value(0 - SR, C);
quadrant(2, SR, CR, C, S) :- !, value(0 - CR, C), value(0 - SR, S);
quadrant(_, SR, CR, SR, S) :- value(0 - CR, S);

% the sector of the angles: all, or {C1, S1, C2, S2, Wide}
sector(all, all) :- !;
sector({A1, A2}, Sec) :- degrees(A1, D1), degrees(A2, D2), arc_of(D1, D2, Sec);

arc_of(D, D, all) :- !;
arc_of(D1, D2, {C1, S1, C2, S2, Wide}) :-
        unit(D1, C1, S1), unit(D2, C2, S2), sweep(D1, D2, Sw), wide(Sw, Wide);

sweep(D1, D2, S) :- D2 >= D1, !, value(D2 - D1, S);
sweep(D1, D2, S) :- Full = 360, value(D2 + Full - D1, S);

wide(S, 1) :- S > 180, !;
wide(_, 0);

% the point on the circle of radius R at angle A (from the centre)
rim(CX, CY, R, A, X, Y) :-
        degrees(A, D), unit(D, C, S),
        Half = 512, floor_div(R * C + Half, 1024, DX), floor_div(R * S + Half, 1024, DY),
        value(CX + DX, X), value(CY - DY, Y);

% the angle in 0..359
degrees(A, D) :- Full = 360, udiv(A, Full, Q), value(A - Q * Full, D);

% sine(D, V): V = round(1024 * sin(D degrees)), D = 0..90 (OURS table)
sine(0, 0) :- !;
sine(1, 18) :- !;
sine(2, 36) :- !;
sine(3, 54) :- !;
sine(4, 71) :- !;
sine(5, 89) :- !;
sine(6, 107) :- !;
sine(7, 125) :- !;
sine(8, 143) :- !;
sine(9, 160) :- !;
sine(10, 178) :- !;
sine(11, 195) :- !;
sine(12, 213) :- !;
sine(13, 230) :- !;
sine(14, 248) :- !;
sine(15, 265) :- !;
sine(16, 282) :- !;
sine(17, 299) :- !;
sine(18, 316) :- !;
sine(19, 333) :- !;
sine(20, 350) :- !;
sine(21, 367) :- !;
sine(22, 384) :- !;
sine(23, 400) :- !;
sine(24, 416) :- !;
sine(25, 433) :- !;
sine(26, 449) :- !;
sine(27, 465) :- !;
sine(28, 481) :- !;
sine(29, 496) :- !;
sine(30, 512) :- !;
sine(31, 527) :- !;
sine(32, 543) :- !;
sine(33, 558) :- !;
sine(34, 573) :- !;
sine(35, 587) :- !;
sine(36, 602) :- !;
sine(37, 616) :- !;
sine(38, 630) :- !;
sine(39, 644) :- !;
sine(40, 658) :- !;
sine(41, 672) :- !;
sine(42, 685) :- !;
sine(43, 698) :- !;
sine(44, 711) :- !;
sine(45, 724) :- !;
sine(46, 737) :- !;
sine(47, 749) :- !;
sine(48, 761) :- !;
sine(49, 773) :- !;
sine(50, 784) :- !;
sine(51, 796) :- !;
sine(52, 807) :- !;
sine(53, 818) :- !;
sine(54, 828) :- !;
sine(55, 839) :- !;
sine(56, 849) :- !;
sine(57, 859) :- !;
sine(58, 868) :- !;
sine(59, 878) :- !;
sine(60, 887) :- !;
sine(61, 896) :- !;
sine(62, 904) :- !;
sine(63, 912) :- !;
sine(64, 920) :- !;
sine(65, 928) :- !;
sine(66, 935) :- !;
sine(67, 943) :- !;
sine(68, 949) :- !;
sine(69, 956) :- !;
sine(70, 962) :- !;
sine(71, 968) :- !;
sine(72, 974) :- !;
sine(73, 979) :- !;
sine(74, 984) :- !;
sine(75, 989) :- !;
sine(76, 994) :- !;
sine(77, 998) :- !;
sine(78, 1002) :- !;
sine(79, 1005) :- !;
sine(80, 1008) :- !;
sine(81, 1011) :- !;
sine(82, 1014) :- !;
sine(83, 1016) :- !;
sine(84, 1018) :- !;
sine(85, 1020) :- !;
sine(86, 1022) :- !;
sine(87, 1023) :- !;
sine(88, 1023) :- !;
sine(89, 1024) :- !;
sine(90, 1024);

end.
