% SCAFFOLDING stand-in for SIMPOS's class `coordinator`, compiled by
% psi/espc.py into the package `simpos`.  It is NOT SIMPOS: the class is
% lost (docs/simpos/subsystems/window.md, shell.md §1.1).  Step 3l, route
% steps B6 and B8 (docs/simpos/boot_route.md).  MINIMAL: a coordinator
% process that reads the login file, holds the system menu built from it,
% answers information/3, and starts a menu item's program in a new
% process.
%
% PRINTED (prose and 1984 code; page images and listings):
%   - TR-061 (Kurokawa, Tojo, "Coordinator -- the Kernel of the
%     Programming System for the PSI", 84.04) and TR-046 PDF p26-p28: the
%     coordinator receives the keyboard and mouse events through a
%     translation table; the printed default_translation_table maps
%     `mouse#rr` and `control#"s"` to the coordinator action
%     {invoke_system_menu, _, _, _} (TR-046_p28.esp, TR-061_p13.esp);
%   - TM-134 p66, p71; TM-112 p16; TM-181 p3 (shell.md §4.3): a double
%     right click opens the system menu; an item starts a program in a
%     new process; the 1.0 dialogue `:create(#c,O). :create(#process,P).
%     :activate(P,O).` (TM-134 p71) is how a program is started in a new
%     process;
%   - TM-181 p3, TM-229 p5-p6 (shell.md §4.1): login sets the system-menu
%     items, the logical names, runs an initialisation program;
%   - TM-785 p6, p25; TM-786 p5 (shell.md §4.2): the login file's `menu`
%     item gives the EXPERTS part of the system menu.
% USAGE: `:information(#coordinator, Key, Value)`, the value of a user item
% of the login file (shell.md §2.5 and the §4.2 table: kwic-esp
% src/systems.esp:297, 327, 364, dbUtil.esp:225; pimfep##pimos_fep_superviser
% full_pathname/1 @1c9-1ce, pimfep##pimos_login_requester close/2 @149-14e,
% check_code/4, is_not_exit/1, initiate_additional_function/1).
% INFERENCE: information/3 fails when the item is absent (every held
% caller has a fallback clause, shell.md §2.5).
% OURS throughout, labelled: the coordinator's state in class slots (one
% coordinator per machine); its event stream and the events
% `invoke_system_menu` (the printed action's name), {select, Label} (the
% menu's answer, OURS) and, step 3m, {key, Code} (a key typed, OURS: the
% code put on the keyboard stream for the selected window); the menu as login.com's item columns (the 1984
% system_menu of TR-046 PDF p27, with its multi_column_menu, is not
% built: its menu_item and multi_column_menu classes are lost); the order
% of the login file's items as they are read.
%
% Window M4/M6 (2026-11-25), OURS throughout, labelled:
%   - THE MOUSE: the events {mouse, Button, X, Y} (Button one of the
%     held mouse#l ll m mm r rr names, window.md §3.5) and {move, X, Y},
%     the plan's §4.3 event format; the cursor's place in class slots,
%     starting at the screen's centre (640, 472).  `mouse#rr` opens the
%     system menu (PRINTED TR-046 p28, the translation table; PROSE TM-112
%     p16, p19), drawn at the mouse (menu_pane.esp); with the menu open a
%     move boxes the item under the mouse and `mouse#l` on an item starts
%     it (step 3l's path), off the items closes the menu; with no menu
%     `mouse#l` selects the window under the mouse (PROSE TM-126 p7,
%     TM-225 p11: a click goes to the shown window under the mouse
%     cursor; that a left click selects is INFERENCE from the plan §4.3
%     "mouse#l on a window -> visit").  The other buttons do nothing here.
%     `invoke_system_menu` (step 3l's event) opens the menu at the mouse
%     too, and {select, Label} (step 3l's answer) closes it;
%   - THE WINDOWS: select_window/2, add_window/3 and remove_window/2, sent
%     by the window stand-ins (standard_io_window.esp, pmacs_window.esp):
%     the selected window's cursor (deselect_window/1 for the one before,
%     selected/1 for the new one), the status band's box (status_band.esp:
%     the window's `<class>/<n>`, n counted from 1 as windows are drawn),
%     the shown windows newest first for the mouse's hit test (since
%     M7 the stacking order, top first: below);
%   - THE KEYBOARD: a {key, Code} goes to the selected window's typed/2
%     (standard_io_window: since M7 its own input stream, until M7 the
%     coordinator's keyboard stream; pmacs_window: its command
%     interpreter's input), or the keyboard stream when none is selected
%     (since M7 passed on to the next window selected, below);
%   - THE STATUS BAND: drawn when the coordinator starts (draw_status/1,
%     from coordinator_program.esp).
%
% Window M6, create and kill (2026-11-25), OURS in form, the dialogue from
% the video: choosing a program on the system menu is followed by a
% pop-up titled with the program's name (simpos.wmv@49-60:
% `file_manipulator`, `create` and `k...`) or `WHICH ?` (prolog.wmv@14-15:
% `create`, `kill`), and `create` by an outline swept with the mouse, the
% new window appearing there (simpos.wmv@53-56); SCREENSHOT, the sequence
% INFERENCE (subsystems/notes/video.md §2-§3, window.md §4.5).  The
% sweep is two corner clicks with the outline following the mouse between
% them, as the window manipulator's RESHAPE: "point at the top-left and
% bottom-right corners with the mouse" (PRINTED-INTERFACE TM-125 p8,
% window.md §4.4, §5.3 "sweep two corners: RESHAPE, or place a new
% window").  Here:
%   - the pop-up comes only when the program already has a window
%     (INFERENCE from `WHICH ?` and the video's file_manipulator_2, made
%     while file_manipulator_1 was shown); otherwise the item starts the
%     program at once, as since step 3l (so the M4 tape's path is
%     unchanged);
%   - the pop-up is a menu_pane titled with the item's label, the items
%     `create` and `kill` (SCREENSHOT), at the mouse;
%   - `create`: the next left click is one corner, a move draws the
%     outline from it to the mouse, a 1-dot rectangle by exclusive_or (so
%     drawing it again erases it exactly, OURS), the next left click the
%     other corner; the outline is erased and the program started; its
%     window, made with {position, manipulator}, takes the swept
%     rectangle's top-left (window_pane.esp, placement/3).  The held
%     requester fixes its size ({size,{ch,40},{ch,7}}), so the swept size
%     is not used (OURS);
%   - `kill`: the newest process started from that item that has a window
%     is exterminated (process.esp exterminate/1) and its windows killed
%     (their kill/1: each restores what was under it, save_memory.esp);
%   - the right button cancels a sweep (and opens the menu).
% Window M7, the stack and the manipulator (2026-11-25), OURS in form:
%   - THE STACK: `windows` is the stacking order, top first.  Every
%     restack lifts panes top-down and lays them back bottom-up
%     (window_pane.esp lift/1, lay/1), each pane's own dots and the dots
%     under it in save areas: the mechanism of PROSE TM-225 p10, TM-126
%     p5 (window.md §4.1 "Implementation": a hidden window's image is kept
%     in a save area; restacking copies between the save areas and the
%     frame).  A restack that would change no dot (the window overlaps
%     none of those it passes) only reorders the list.  Kill (take_off/2),
%     a selection (raise), HIDE (lower) and pmacs_window's redraw
%     (peel/3, unpeel/2) go through it;
%   - SELECTION RAISES: the selected window is the top of the stack and
%     has the keyboard (PROSE TM-225 p11, TRANSLATION; that a selection
%     raises is INFERENCE from it);
%   - THE KEYBOARD (since M7): a key goes to the selected window's own
%     input stream (its typed/2); keys typed while none is selected wait
%     on the coordinator's stream and go, oldest first, to the next window
%     selected (type_ahead/2, OURS);
%   - THE MANIPULATOR: the middle button over a window opens a pop-up
%     titled `WINDOW MANIPULATOR` at the mouse, for that window (OURS:
%     TM-125 p8 invokes the manipulator from the system menu, whose held
%     login.com items have none; the middle button moves a pimfep window,
%     USAGE window.md §5.3).  Its items, verbatim from TM-125 p8
%     (PRINTED-INTERFACE, window.md §4.4), four of twelve: SHOW "show the
%     whole of a partly shown window" (raise and select); HIDE "move it to
%     the bottom of the window list" (a selected window's cursor goes
%     while it is on top, then the new top is selected: INFERENCE, TM-225
%     p11); RESHAPE "point at the top-left and bottom-right corners with
%     the mouse" (two corner clicks, the rubber band as create's); MOVE
%     "move by mouse" (an outline of the window's size follows the mouse,
%     a left click places its top-left; the dots go with it,
%     window_pane.esp move_to/3).  MOVE and RESHAPE raise and select the
%     window, then send reshape/5 and the callback has_been_reshaped/1
%     (window.md §2.1, §2.12: the reshape notifier calls it after the
%     geometry is set).  Output to a covered window: permission `out`
%     for every window (uncover/3, window_pane.esp's head).  Not
%     modelled: the other permissions and the other eight items.
% The windows' owners (the process that made each, `:self(#process, P)`
% at add_window/3) and the programs started ([Name, P]) are kept for kill,
% as lists (kl0 keeps a list's values in a slot; a vector would keep its
% variables, psi/kl0.py resolve_value).

class coordinator has

% OURS state (see above).
attribute items := [], menu := [], shown := 0, started := [], events := 0,
          process := 0, keyboard := 0, selected := 0;
% Window M4/M6, OURS (see the head comment): the shown windows, newest
% first; how many were drawn; the mouse; the open menu's pane (0: none).
attribute windows := [], count := 0, mouse_x := 640, mouse_y := 472,
          menu_pane := 0;
% Window M6, create and kill, OURS (see the head comment): the dialogue's
% state ([] none, [which, Name], [sweep, Name], [corner, Name, X, Y]), the
% outline drawn ([] or [X, Y, W, H]), the swept placement for the next
% window ([] or [X, Y, W, H]), the programs started ([Name, P], newest
% first) and the windows' owners ([W, P]).
attribute dialogue := [], outline := [], placement := [], programs := [],
          owners := [];
% Window M7, output permission (OURS, see the head comment): the writers
% held back, [W, S, Kind] (Kind the window's permission when it asked:
% wait or notify; notified once its notify window was shown), each
% waiting on its stream S.
attribute waiters := [];
% Step 3m, OURS: `keyboard`, a stream of the character codes typed (the
% keyboard handler's output, B4: its class is lost), read by the selected
% window (standard_io_window.esp) until window M7, since then holding only
% the keys typed while no window is selected (type_ahead/2); `selected`,
% that window (0: none).
% INTERPOLATED from TR-061 and TR-046 PDF p26-p28 (PRINTED prose and
% code): the coordinator receives the keyboard events; keys the
% translation table does not take go to the selected window (TM-225 p11,
% PROSE TRANSLATION: "the selected window has keyboard input").

% :start(#coordinator) -- OURS (selector and body): make the coordinator's
% event stream and its process, running coordinator_program, as kappa2's
% held handshake starts a background process (ITRSES.ESP:111-116,
% ANALOGY): create/3 and activate/2 (TM-100 Fig. 3.1, PRINTED).
% INTERPOLATED from TR-061's "the coordinator" as a process of its own
% (shell.md §1.1).
:start(Class) :-
        :create(#stream, Events),
        Class!events := Events,
        :create(#stream, Keyboard),
        Class!keyboard := Keyboard,
        :create(#coordinator_program, Prog),
        :create(#process, P, [free, free, free, free]),
        Class!process := P,
        :activate(P, Prog);

% :information(#coordinator, Key, Value) -- INTERPOLATED (USAGE above).
:information(Class, Key, Value) :- item(Class!items, Key, Value);

% :read_login_file(#coordinator) -- INTERPOLATED (OURS selector) from
% TM-181 p3 and TM-229 p5-p6 (prose) and the held login file syntax
% (shell.md §4.2.2): read me:login.com; `menu` gives the menu's columns,
% `define` the logical names of the process's world (applied with the
% world's define/3, as simpos_user create/4 does for "me"), every other
% head a user item.  A missing login file leaves the menu empty (OURS).
:read_login_file(Class) :-
        :create(#standard_input_file, In, "me:login.com"), !,
        read_items(Class, In),
        :close_input(In);
:read_login_file(Class);

% :event(#coordinator, Event) -- INTERPOLATED (OURS selector): one event,
% as the coordinator process takes it from its stream.
:event(Class, Event) :- handle(Class, Event), !, settled(Class);

% :select_window(#coordinator, W) -- window M4/M6 (selector and body
% OURS; see the head comment): W becomes the selected window.
% INTERPOLATED (selector and body OURS): select_window; basis above and in
% the head comment.
:select_window(Class, W) :-
        S = Class!selected, S == W, !,
        raise(Class, W),
        :selected(W),
        wake(Class);
:select_window(Class, W) :-
        deselect(Class!selected),
        raise(Class, W),
        Class!selected := W,
        :selected(W),
        :status_name(W, Kind, N),
        :show_selected(#status_band, Kind, N),
        type_ahead(Class, W),
        :has_been_selected(W),
        wake(Class);

% :add_window(#coordinator, W, N) -- window M4/M6 (selector and body
% OURS): W is drawn; N its number.
% INTERPOLATED (selector and body OURS): add_window; basis above and in
% the head comment.
:add_window(Class, W, N) :-
        value(Class!count + 1, N),
        Class!count := N,
        Class!windows := [W | Class!windows],
        :self(#process, P),
        Class!owners := [[W, P] | Class!owners];

% :remove_window(#coordinator, W) -- window M4/M6 (selector and body
% OURS): W has left the screen; if it was selected, none is.
% INTERPOLATED (selector and body OURS): remove_window; basis above and in
% the head comment.
:remove_window(Class, W) :-
        without(Class!windows, W, Ws),
        Class!windows := Ws,
        disowned(Class!owners, W, Os),
        Class!owners := Os,
        unselect(Class, W);

% :cursor_aside(#coordinator) -- window M6/M7 (selector and body OURS):
% before a new pane is drawn, the selected window's cursor is taken off
% (its deselect_window/1), as the panes are not clipped (window_pane.esp).
% INTERPOLATED (selector and body OURS): cursor_aside; basis above and in
% the head comment.
:cursor_aside(Class) :- S = Class!selected, S \== 0, on_screen(S), !,
        :deselect_window(S);
:cursor_aside(_);

% :take_off(#coordinator, W) -- window M7 (selector and body OURS, see
% the head comment, "the stack"): W's pane leaves the screen (its kill/1):
% the windows above it are lifted if one of them overlaps it, its pane
% erased (what was under it drawn back), and they are laid back.
% INTERPOLATED (selector and body OURS): take_off; basis above and in
% the head comment.
:take_off(Class, W) :-
        above(Class!windows, W, Above),
        peel(W!pane, Above, Lifted),
        :erase(W!pane),
        unpeel(Lifted),
        wake(Class);

% :peel(#coordinator, W, Lifted) and :unpeel(#coordinator, Lifted) --
% window M7 (selectors and bodies OURS): every window above W lifted, top
% first, so W's pane can be drawn again as the top one (pmacs_window.esp
% drawn_again: a new pane in its place); then laid back.
% INTERPOLATED (selector and body OURS): peel; basis above and in the
% head comment.
:peel(Class, W, Lifted) :-
        above(Class!windows, W, Lifted),
        lift_all(Lifted);
% INTERPOLATED (selector and body OURS): unpeel; basis above and in the
% head comment.
:unpeel(Class, {M, O, Lifted}) :- !,
        unpeel(Lifted), menu_on(M), outline_on(O);
:unpeel(Class, Lifted) :- unpeel(Lifted);

% :uncover(#coordinator, Pane, Lifted) -- window M7 (selector and body
% OURS): before a window's pane draws output, the windows above it are
% lifted if one of them overlaps it (output permission `out`,
% window_pane.esp's head); unpeel/2 lays them back.  A pane of no shown
% window (not yet added, or a census instance) lifts nothing.
% INTERPOLATED (selector and body OURS): uncover; basis above and in the
% head comment.
:uncover(Class, Pane, {M, O, Lifted}) :-
        owner(Class!windows, Pane, W), !,
        permitted(Class, W),
        above(Class!windows, W, Above),
        lifting(Pane, Above, Lifted),
        outline_off(Class, O),
        menu_off(Class, Pane, Lifted, M),
        lift_all(Lifted);
:uncover(Class, Pane, {M, O, []}) :-
        outline_off(Class, O),
        menu_off(Class, Pane, [], M);

% :placement(#coordinator, X, Y) -- window M6 (selector and body OURS,
% see the head comment): the top-left of the outline swept for the next
% window, given once; fails when none was swept.
% INTERPOLATED (selector and body OURS): placement; basis above and in
% the head comment.
:placement(Class, X, Y) :-
        Class!placement = [X, Y | _],
        Class!placement := [];

% :draw_status(#coordinator) -- window M6 (selector and body OURS): the
% status band (status_band.esp).
% INTERPOLATED (selector and body OURS): draw_status; basis above and in
% the head comment.
:draw_status(Class) :- :draw(#status_band);

local

value(V, V);

% one event (since window M7's permissions, :event/2 then wakes the
% writers that may now write and offers a pending notify window)
handle(Class, invoke_system_menu) :- !,
        open_menu(Class);
handle(Class, {key, Code}) :- !,
        key(Class!selected, Code, Class);
handle(Class, {select, Label}) :- !,
        Class!shown \== 0,
        find_item(Class!shown, Label, Name),
        close_menu(Class),
        start(Class, Name);
% window M6 (OURS, see the head comment)
handle(Class, {mouse, Button, X, Y}) :- !,
        Class!mouse_x := X, Class!mouse_y := Y,
        click(Class, Button, X, Y);
handle(Class, {move, X, Y}) :- !,
        Class!mouse_x := X, Class!mouse_y := Y,
        moved(Class, Class!menu_pane, Class!dialogue, X, Y);

settled(Class) :- wake(Class), offer(Class);

start(Class, Name) :-
        :get_class_object(#library, Name, Program_class),
        :create(Program_class, Program),
        :create(#process, P),
        :activate(P, Program),
        Class!started := [P | Class!started],
        Class!programs := [[Name, P] | Class!programs];

% the system menu: open (drawn at the mouse), closed (erased)
open_menu(Class) :-
        close_menu(Class),
        Class!shown := Class!menu,
        :create(#menu_pane, "SYSTEM MENU", Class!menu, Class!mouse_x,
                Class!mouse_y, M),
        Class!menu_pane := M;

close_menu(Class) :- Class!menu_pane == 0, !, Class!shown := 0;
close_menu(Class) :-
        :erase(Class!menu_pane),
        Class!menu_pane := 0, Class!shown := 0;

click(Class, rr, _, _) :- !, cancel(Class), open_menu(Class);
click(Class, l, X, Y) :- Class!menu_pane \== 0, !, menu_click(Class, Class!dialogue, X, Y);
click(Class, l, X, Y) :- Class!dialogue \== [], !, corner(Class, Class!dialogue, X, Y);
click(Class, l, X, Y) :- !, visit(Class, Class!windows, X, Y);
click(Class, m, X, Y) :- !, cancel(Class), manipulator(Class, Class!windows, X, Y);
click(_, _, _, _);

% the system menu's item; then the create/kill pop-up's (head comment)
menu_click(Class, [], X, Y) :-
        :item_at(Class!menu_pane, X, Y, Label, Name), !,
        close_menu(Class),
        chosen(Class, Label, Name, X, Y);
menu_click(Class, [which, Name], X, Y) :-
        :item_at(Class!menu_pane, X, Y, _, Action), !,
        close_menu(Class),
        which(Class, Action, Name);
menu_click(Class, [manipulator, W], X, Y) :-
        :item_at(Class!menu_pane, X, Y, _, Item), !,
        close_menu(Class),
        Class!dialogue := [],
        manipulate(Class, Item, W);
% window M7: the manipulator's PERMISSION and MENU submenus, and a
% notify window's choice
menu_click(Class, [permission, W], X, Y) :-
        :item_at(Class!menu_pane, X, Y, _, Permission), !,
        close_menu(Class),
        Class!dialogue := [],
        :set_permission(W, Permission);
menu_click(Class, [windows], X, Y) :-
        :item_at(Class!menu_pane, X, Y, _, W), !,
        close_menu(Class),
        Class!dialogue := [],
        :select_window(Class, W);
menu_click(Class, [notify, W], X, Y) :-
        :item_at(Class!menu_pane, X, Y, _, Choice), !,
        close_menu(Class),
        Class!dialogue := [],
        notified(Class, Choice, W);
menu_click(Class, _, _, _) :- close_menu(Class), Class!dialogue := [];

chosen(Class, Label, Name, X, Y) :-
        running(Class!owners, Class!programs, Name, _), !,
        :create(#menu_pane, Label, [[{"create", create}, {"kill", kill}]], X, Y, M),
        Class!menu_pane := M,
        Class!dialogue := [which, Name];
chosen(Class, _, Name, _, _) :- start(Class, Name);

which(Class, create, Name) :- !, Class!dialogue := [sweep, Name];
which(Class, kill, Name) :- Class!dialogue := [], kill_program(Class, Name);

% the first corner, then the second: the outline erased, the program
% started at the swept place
corner(Class, [sweep, Name], X, Y) :- !,
        Class!dialogue := [corner, Name, X, Y];
corner(Class, [corner, Name, X1, Y1], X2, Y2) :- !,
        unoutline(Class),
        span(X1, X2, X, W), span(Y1, Y2, Y, H),
        Class!placement := [X, Y, W, H],
        Class!dialogue := [],
        start(Class, Name);
% window M7: RESHAPE's corners, MOVE's place
corner(Class, [reshape, Win], X, Y) :- !,
        Class!dialogue := [reshape_corner, Win, X, Y];
corner(Class, [reshape_corner, Win, X1, Y1], X2, Y2) :- !,
        unoutline(Class),
        span(X1, X2, X, W), span(Y1, Y2, Y, H),
        Class!dialogue := [],
        reshape(Class, Win, X, Y, W, H);
corner(Class, [move, Win], X, Y) :-
        unoutline(Class),
        Class!dialogue := [],
        move(Class, Win, X, Y);

moved(_, M, _, X, Y) :- M \== 0, !, :box_at(M, X, Y);
% window M7: MOVE's outline, the window's size, its top-left at the mouse
moved(Class, _, [move, Win], X, Y) :- !,
        unoutline(Class),
        P = Win!pane,
        outline(Class, X, Y, P!w, P!h);
moved(Class, _, [corner, _, X1, Y1], X2, Y2) :- !,
        unoutline(Class),
        span(X1, X2, X, W), span(Y1, Y2, Y, H),
        outline(Class, X, Y, W, H);
moved(Class, _, [reshape_corner, _, X1, Y1], X2, Y2) :- !,
        unoutline(Class),
        span(X1, X2, X, W), span(Y1, Y2, Y, H),
        outline(Class, X, Y, W, H);
moved(_, _, _, _, _);

cancel(Class) :- unoutline(Class), Class!dialogue := [];

% the low end and the width of the dots from A to B, both included
span(A, B, A, W) :- A =< B, !, value(B - A + 1, W);
span(A, B, B, W) :- value(A - B + 1, W);

% the outline: a 1-dot rectangle by exclusive_or; none narrower than 2
outline(Class, X, Y, W, H) :- W >= 2, H >= 2, !,
        rect(X, Y, W, H),
        Class!outline := [X, Y, W, H];
outline(_, _, _, _, _);

unoutline(Class) :- Class!outline = [X, Y, W, H], !,
        rect(X, Y, W, H),
        Class!outline := [];
unoutline(_);

rect(X, Y, W, H) :-
        :fill(#bitmap_display, X, Y, W, 1, exclusive_or),
        :fill(#bitmap_display, X, Y + H - 1, W, 1, exclusive_or),
        :fill(#bitmap_display, X, Y + 1, 1, H - 2, exclusive_or),
        :fill(#bitmap_display, X + W - 1, Y + 1, 1, H - 2, exclusive_or);

% the newest program Name started that has a window
running(Owners, [[Name, P] | _], Name, P) :- owns(Owners, P), !;
running(Owners, [_ | R], Name, P) :- running(Owners, R, Name, P);

owns([[_, P1] | _], P) :- P1 == P, !;
owns([_ | R], P) :- owns(R, P);

kill_program(Class, Name) :-
        running(Class!owners, Class!programs, Name, P), !,
        :exterminate(P),
        kill_windows(Class!owners, P);
kill_program(_, _);

kill_windows([], _);
kill_windows([[W, P1] | R], P) :- P1 == P, !, :kill(W), kill_windows(R, P);
kill_windows([_ | R], P) :- kill_windows(R, P);

disowned([], _, []);
disowned([[X, _] | R], W, R) :- X == W, !;
disowned([X | R], W, [X | T]) :- disowned(R, W, T);

% window M7, THE STACK (OURS, see the head comment).  `windows` is the
% stacking order, top first.  Every restack goes through lift/1 and lay/1
% of window_pane.esp, top-down and bottom-up, so each pane is the top one
% on the screen when its dots are saved or drawn back.  A restack that
% would change no dot (the window moved past overlaps none of the windows
% it passes) only reorders the list, so nothing is sent to the device.

% the windows above W, top first
above([], _, []);
above([X | _], W, []) :- X == W, !;
above([X | R], W, [X | A]) :- above(R, W, A);

below([], _, []);
below([X | R], W, R) :- X == W, !;
below([_ | R], W, B) :- below(R, W, B);

% the windows above P's window, all lifted if one of them overlaps it
peel(P, Above, Above) :- overlapped(P, Above), !, lift_all(Above);
peel(_, _, []);

overlapped(P, [U | _]) :- on_screen(U), :overlaps(P, U!pane), !;
overlapped(P, [_ | Us]) :- overlapped(P, Us);

lift_all([]);
lift_all([U | Us]) :- :lift(U!pane), lift_all(Us);

% laid back bottom first (the list is top first)
unpeel([]);
unpeel([U | Us]) :- unpeel(Us), :lay(U!pane);

owner([W | _], Pane, W) :- P = W!pane, P == Pane, !;
owner([_ | Ws], Pane, W) :- owner(Ws, Pane, W);

on_screen(W) :- P = W!pane, P \== 0, P!image == 0;

member(X, [Y | _]) :- X == Y, !;
member(X, [_ | R]) :- member(X, R);

% bring to front (SHOW, and a selection: TM-225 p11, the selected window
% is top of the stack)
raise(Class, W) :- Class!windows = [T | _], T == W, !;
raise(Class, W) :- member(W, Class!windows), !,
        above(Class!windows, W, Above),
        without(Class!windows, W, Rest),
        Class!windows := [W | Rest],
        peel(W!pane, Above, Lifted),
        raised(W, Lifted);
raise(_, _);

raised(_, []) :- !;
raised(W, Lifted) :- :lift(W!pane), unpeel(Lifted), :lay(W!pane);

% to the bottom (HIDE: TM-125 p8 "move it to the bottom of the window
% list"); every window lifted, W laid first, the others over it
lower(Class, W) :- last(Class!windows, L), L == W, !;
lower(Class, W) :- member(W, Class!windows), !,
        Old = Class!windows,
        below(Old, W, Below),
        without(Old, W, Rest),
        append(Rest, [W], New),
        Class!windows := New,
        lowered(W, Old, Rest, Below);
lower(_, _);

lowered(W, Old, Rest, Below) :- overlapped(W!pane, Below), !,
        lift_all(Old),
        :lay(W!pane),
        unpeel(Rest);
lowered(_, _, _, _);

last([X], X) :- !;
last([_ | R], X) :- last(R, X);

append([], L, L);
append([X | R], L, [X | T]) :- append(R, L, T);

% window M7, THE MANIPULATOR (OURS menu, TM-125 p8's items; see the head
% comment): opened by the middle button over a window, for that window
manipulator(Class, Ws, X, Y) :- under_mouse(Ws, X, Y, W), !,
        close_menu(Class),
        :create(#menu_pane, "WINDOW MANIPULATOR",
                [[{"SHOW", show}, {"HIDE", hide}, {"RESHAPE", reshape},
                  {"MOVE", move}, {"EXPAND", expand}, {"MENU", menu},
                  {"PERMISSION", permission}, {"EXIT", exit}]], X, Y, M),
        Class!menu_pane := M,
        Class!dialogue := [manipulator, W];
manipulator(_, _, _, _);

under_mouse([W | _], X, Y, W) :- :contains(W, X, Y), !;
under_mouse([_ | Ws], X, Y, W) :- under_mouse(Ws, X, Y, W);

manipulate(Class, show, W) :- !, :select_window(Class, W);
manipulate(Class, hide, W) :- !, hide(Class, W);
manipulate(Class, reshape, W) :- !, Class!dialogue := [reshape, W];
manipulate(Class, move, W) :- !, Class!dialogue := [move, W];
manipulate(Class, expand, W) :- !, expand(Class, W);
manipulate(Class, menu, _) :- !,
        listed(Class!windows, Items),
        submenu(Class, "WINDOWS", Items, [windows]);
manipulate(Class, permission, W) :- !,
        submenu(Class, "PERMISSION",
                [{"out", out}, {"wait", wait}, {"show", show},
                 {"notify", notify}], [permission, W]);
manipulate(_, exit, _) :- !;
manipulate(_, _, _);

% a submenu at the mouse (TM-125 p8: MENU "select the window using the
% submenu of windows list", PERMISSION "reset the window output
% permission by sub-menu"; a pop-up as the manipulator's, OURS)
submenu(Class, Title, Items, Dialogue) :-
        :create(#menu_pane, Title, [Items], Class!mouse_x, Class!mouse_y, M),
        Class!menu_pane := M,
        Class!dialogue := Dialogue;

% MENU's items: each window by its title (its status name's class when
% it has none), top first (OURS)
listed([], []);
listed([W | Ws], [{T, W} | Is]) :- named(W, T), listed(Ws, Is);

named(W, T) :- T = W!title, string(T, N, _), N > 0, !;
named(W, Kind) :- :status_name(W, Kind, _);

% EXPAND "expand the window size as large as possible but not hide
% another fully shown window" (TM-125 p8).  OURS: the fully shown windows
% that it does not overlap now are the obstacles; the left edge goes out
% to the nearest obstacle (or the screen's edge) beside the window's rows,
% then the right edge; then the top and the bottom, beside the new
% columns.  The window is then raised, selected and reshaped as by
% RESHAPE.
expand(Class, W) :-
        Q = W!pane,
        obstacles(Class, Class!windows, W, Q, Os),
        :get_size(#bitmap_display, Sw, Sh),
        value(Q!y + Q!h, Y1), value(Q!x + Q!w, X1),
        left(Os, Q!y, Y1, Q!x, 0, L),
        right(Os, Q!y, Y1, X1, Sw, R),
        up(Os, L, R, Q!y, 0, U),
        down(Os, L, R, Y1, Sh, D),
        reshape(Class, W, L, U, R - L, D - U);

obstacles(_, [], _, _, []);
obstacles(Class, [U | Us], W, Q, Os) :- U == W, !, obstacles(Class, Us, W, Q, Os);
obstacles(Class, [U | Us], W, Q, [P | Os]) :-
        on_screen(U), P = U!pane, apart(P, Q), shown(Class, U), !,
        obstacles(Class, Us, W, Q, Os);
obstacles(Class, [_ | Us], W, Q, Os) :- obstacles(Class, Us, W, Q, Os);

apart(P, Q) :- :overlaps(P, Q), !, fail;
apart(_, _);

shown(Class, U) :- covered(Class, U), !, fail;
shown(_, _);

left([], _, _, _, L, L);
left([O | Os], Y0, Y1, X0, L0, L) :-
        O!y < Y1, Y0 < O!y + O!h, value(O!x + O!w, E), E =< X0, E > L0, !,
        left(Os, Y0, Y1, X0, E, L);
left([_ | Os], Y0, Y1, X0, L0, L) :- left(Os, Y0, Y1, X0, L0, L);

right([], _, _, _, R, R);
right([O | Os], Y0, Y1, X1, R0, R) :-
        O!y < Y1, Y0 < O!y + O!h, O!x >= X1, O!x < R0, !,
        right(Os, Y0, Y1, X1, O!x, R);
right([_ | Os], Y0, Y1, X1, R0, R) :- right(Os, Y0, Y1, X1, R0, R);

up([], _, _, _, U, U);
up([O | Os], L, R, Y0, U0, U) :-
        O!x < R, L < O!x + O!w, value(O!y + O!h, E), E =< Y0, E > U0, !,
        up(Os, L, R, Y0, E, U);
up([_ | Os], L, R, Y0, U0, U) :- up(Os, L, R, Y0, U0, U);

down([], _, _, _, D, D);
down([O | Os], L, R, Y1, D0, D) :-
        O!x < R, L < O!x + O!w, O!y >= Y1, O!y < D0, !,
        down(Os, L, R, Y1, O!y, D);
down([_ | Os], L, R, Y1, D0, D) :- down(Os, L, R, Y1, D0, D);

% window M7, OUTPUT PERMISSION (see the head comment).  A window's
% output waits, is shown or notifies only while the window is covered (a
% window above it overlaps it); `out` writes at once into the covered
% window (uncover/3 lifts the windows above).  The coordinator's own
% process never waits (its redraws: has_been_reshaped/1, a selection's
% cursor; OURS), so a writer is always another process.
permitted(Class, W) :- covered(Class, W), !, held_back(Class, W, W!permission);
permitted(_, _);

covered(Class, W) :- above(Class!windows, W, Above), overlapped(W!pane, Above);

held_back(_, _, out) :- !;
held_back(Class, _, _) :- manager(Class), !;
held_back(Class, W, show) :- !,
        :select_window(Class, W),
        permitted(Class, W);
held_back(Class, W, Kind) :-
        :create(#stream, S),
        append(Class!waiters, [[W, S, Kind]], Ws),
        Class!waiters := Ws,
        offer(Class),
        :get(S, _),
        permitted(Class, W);

manager(Class) :- P = Class!process, P \== 0, :self(#process, Q), P == Q;

% the writers that may write now (not covered, or their permission
% changed to out or show) are woken, in the order they asked
wake(Class) :- Class!waiters == [], !;
wake(Class) :- woken(Class, Class!waiters, Ws), Class!waiters := Ws;

woken(_, [], []);
woken(Class, [[W, S, _] | R], Ws) :- free(Class, W), !,
        :put(S, go),
        woken(Class, R, Ws);
woken(Class, [X | R], [X | Ws]) :- woken(Class, R, Ws);

free(_, W) :- P = W!permission, P == out, !;
free(_, W) :- P = W!permission, P == show, !;
free(Class, W) :- covered(Class, W), !, fail;
free(_, _);

% NOTIFY: a temporary window at the mouse (TM-125 p6-7: "NOTIFY WINDOW",
% prepared by the system; a temporary window appears at the mouse
% cursor), titled with the window's title (OURS), offering `wait` and
% `show` (TM-225 p11 ④: the user chooses ① or ③ by mouse; the words are
% the ATTRIBUTE dialogue's, TM-125 p7 Fig. 4).  One at a time, and only
% when no other pop-up or sweep is open (OURS): it waits for the next
% quiet moment (offer/1 after every event).  `show` raises and selects
% the window, whose writer then goes on; `wait` (or a click off the
% items) leaves the writer waiting until the window is uncovered.
offer(Class) :- Class!menu_pane == 0, Class!dialogue == [],
        notices(Class!waiters, W, Ws), !,
        Class!waiters := Ws,
        named(W, T),
        :create(#menu_pane, T, [[{"wait", wait}, {"show", show}]],
                Class!mouse_x, Class!mouse_y, M),
        Class!menu_pane := M,
        Class!dialogue := [notify, W];
offer(_);

notices([[W, S, notify] | R], W, [[W, S, notified] | R]) :- !;
notices([X | R], W, [X | T]) :- notices(R, W, T);

notified(Class, show, W) :- !, :select_window(Class, W);
notified(_, _, _);

% window M7: what lies over a pane while it writes.  The windows above
% it that overlap it are lifted (lifting/3, then lift_all/1); an open
% pop-up (a temporary window: "never hidden by an ordinary window", it
% saves what it covers, TM-125 p6-7) lies over every window, so it is
% lifted first when it overlaps the pane or a window lifted, and laid
% back last (its lift/1, lay/1); a sweep's outline (exclusive_or) is
% taken off before anything and drawn again after, so no text is drawn
% into it.  OURS order.
lifting(P, Above, Above) :- overlapped(P, Above), !;
lifting(_, _, []);

menu_off(Class, P, Lifted, M) :- M = Class!menu_pane, M \== 0,
        menu_over(M, P, Lifted), !,
        :lift(M);
menu_off(_, _, _, 0);

menu_over(M, P, _) :- :overlaps(P, M), !;
menu_over(M, _, [U | _]) :- :overlaps(U!pane, M), !;
menu_over(M, P, [_ | Us]) :- menu_over(M, P, Us);

menu_on(0) :- !;
menu_on(M) :- :lay(M);

outline_off(Class, [X, Y, W, H]) :- Class!outline = [X, Y, W, H], !,
        rect(X, Y, W, H);
outline_off(_, []);

outline_on([]) :- !;
outline_on([X, Y, W, H]) :- rect(X, Y, W, H);

% HIDE: the selected window loses its cursor while it is still on top;
% once it is lowered the new top window is selected (INFERENCE: TM-225
% p11, the selected window is top of the stack)
hide(Class, W) :- S = Class!selected, S == W, !,
        :deselect_window(W),
        Class!selected := 0,
        lower(Class, W),
        Class!windows = [T | _],
        :select_window(Class, T);
hide(Class, W) :- lower(Class, W);

% MOVE and RESHAPE: the window raised and selected, then moved (its dots
% go with it, window_pane.esp move_to/3) or given its new rectangle;
% either way told so by the held callback has_been_reshaped/1 (window.md
% §2.1, §2.12: the reshape notifier calls it after the geometry is set)
move(Class, W, X, Y) :-
        :select_window(Class, W),
        P = W!pane,
        :move_to(P, X, Y),
        :reshape(W, P!x, P!y, P!w, P!h),
        :has_been_reshaped(W);

reshape(Class, W, X, Y, Wd, Ht) :-
        :select_window(Class, W),
        :reshape(W, X, Y, Wd, Ht),
        :has_been_reshaped(W);

% the newest window under the mouse is selected; none: nothing changes
visit(_, [], _, _);
visit(Class, [W | _], X, Y) :- :contains(W, X, Y), !, :select_window(Class, W);
visit(Class, [_ | Ws], X, Y) :- visit(Class, Ws, X, Y);

key(0, Code, Class) :- !, :put(Class!keyboard, Code);
key(W, Code, _) :- :typed(W, Code);

% window M7: the keys typed while no window was selected go, oldest
% first, to the window selected next (OURS); none when the coordinator
% was never started (no keyboard stream: a census or a direct send)
type_ahead(Class, _) :- Class!keyboard == 0, !;
type_ahead(Class, W) :- :try_to_get(Class!keyboard, Code), !,
        :typed(W, Code),
        type_ahead(Class, W);
type_ahead(_, _);

% the window selected before loses its cursor
deselect(0) :- !;
deselect(S) :- :deselect_window(S);

unselect(Class, W) :- S = Class!selected, S == W, !,
        Class!selected := 0,
        :show_selected(#status_band, 0, 0);
unselect(_, _);

without([], _, []);
without([X | R], W, R) :- X == W, !;
without([X | R], W, [X | T]) :- without(R, W, T);

read_items(Class, In) :- :end_of_input(In), !;
read_items(Class, In) :-
        :gett(In, Clause), !,
        apply(Class, Clause),
        read_items(Class, In);
read_items(_, _);

apply(Class, {':-', menu, {items_list, Columns}}) :- !,
        Class!menu := Columns;
apply(Class, {':-', define, Definitions}) :- !,
        :world(#process, World),
        define(World, Definitions);
apply(Class, {':-', Key, Value}) :-
        Class!items := [[Key | Value] | Class!items];

define(World, {',', A, B}) :- !, define(World, A), define(World, B);
define(World, {':=', Name, Directories}) :- :define(World, Name, Directories);

item([[Key | Value] | _], Key, Value) :- !;
item([_ | Items], Key, Value) :- item(Items, Key, Value);

find_item([Column | Columns], Label, Name) :- find_in(Column, Label, Name), !;
find_item([_ | Columns], Label, Name) :- find_item(Columns, Label, Name);

find_in([{L, Name} | _], Label, Name) :- equal_string(L, Label), !;
find_in([_ | Items], Label, Name) :- find_in(Items, Label, Name);

end.
