% SCAFFOLDING stand-in for SIMPOS's class `pmacs_window` (the Pmacs editor
% window), compiled by psi/espc.py into the package `simpos`.  It is NOT
% SIMPOS: no part of it is printed or held, and NO DISPLAY IS MODELLED.
% It is MINIMAL: creation, get_editor/2, and (step 3f) the geometry,
% title, font and display methods of window.md §2.1-2.3 as slots and
% no-ops.  The text protocol (putl/2, putf/3, getl/2, ...; docs/simpos/
% subsystems/window.md §2.4, §2.11), get_interpreter/2 and the
% has_been_reshaped/1 callback are not stood in, so a caller stops
% there.  INTERPOLATED (labelled) from:
%   - window.md §2.11 (corrected 2026-11-24 by docs/simpos/
%     source_check_2026-11-24.md, row SA36): disc/exshow.esp:24 (held
%     IFS source) sends create/3, `:create(#pmacs_window,[title(Buf)|
%     Init],W)`, then `:get_editor(W,E)` at :28 (window -> its editor, a
%     standard_editor), `:get_window(E, W)` (editor -> window); create/4,
%     `:create(#pmacs_window, Opts, _, W)` with the third argument
%     unbound, is kwic-esp src/inEditor1.esp:151 and mendels
%     comp_win.esp:54-62 (both re-read 2026-11-25: Opts carry
%     `nature([with_superior_input_buffer])` and `superior(..)`); over
%     the IFS sources create/3 is the common form (about 85 sends against
%     3 of create/4, source check row SA36);
%   - pimfep##pimfep_message_log dump_log/1, sorted_log/1,
%     sorted_log_string/1 and pimos_fep_superviser log_window/2 (held
%     .ptf): `:create(#pmacs_window, Opts, W)`, then `:activate(W)` and
%     `:putl(W, ...)`;
%   - docs/simpos/required/classes.tsv (row `pmacs_window`): class methods
%     create/3, create/4, create_with_input/4,5;
%   - (step 3e) pimfep##pimos_window create_pimos_window/3 (held .ptf, run
%     by kl0 2026-11-24): it sends `:create(#pimos_window,
%     [{size,70,110}, {editor,#pimos_window_editor}], _, W)` (and
%     `{buffer,Name}` before the editor option when given a name), then
%     sets `W!activity := 1`.  pimos_window declares no slot `activity`,
%     so the slot is pmacs_window's.
% Model (OURS): the window and its editor are made together and point at
% each other.  An `{editor, Class}` option names the editor's class
% (standard_editor without one); the other options are ignored.  What
% `activity` means is UNKNOWN; it starts at 0.

class pmacs_window has

% INTERPOLATED from: the pimfep `:create(#pmacs_window, Opts, W)` sends;
% the editor option from pimos_window create_pimos_window/3 (step 3e).
:create(Class, Options, Window) :-
        :new(Class, Window),
        editor_class(Options, Editor_class),
        :new(Editor_class, Editor),
        Window!editor := Editor,
        Editor!window := Window;
% INTERPOLATED from: kwic-esp src/inEditor1.esp:151 and mendels
% comp_win.esp:54-62 `:create(#pmacs_window, Opts, _, W)` (held IFS
% source; Opts with `nature([with_superior_input_buffer])` and
% `superior(..)`, window.md §2.11); the third argument is left unbound,
% as every held caller leaves it.  The options are ignored (OURS).
:create(Class, Options, Unused, Window) :-
        :create(Class, Options, Window);

instance

% INTERPOLATED: the representation (OURS).
attribute editor := 0;

% INTERPOLATED (step 3e) from: pimos_window create_pimos_window/3, which
% sets it to 1 after creating the window; meaning UNKNOWN.
attribute activity := 0;

% INTERPOLATED from: window.md §2.11 `:get_editor(W, E)`.
:get_editor(Window, Editor) :-
        Editor = Window!editor;

% Step 3f: the window's geometry, title and font, and the display
% methods, as pimfep##pimos_window_editor sends them to its window (kl0
% census --fep --recipes, 2026-11-25).  The selectors and argument forms
% are from window.md §2.1-2.3 (PRINTED-INTERFACE: TM-125 p15-16 for
% set_size/3, set_position/3, set_title/2, activate/1, show/1, hide/1,
% deactivate/1; TM-115 p50 and p63 for get_size/3 and get_position/3;
% TM-112 p16 for set_font/2; USAGE for reshape/5, set_text_size/3,
% get_text_size/3, get_title/2, get_font/2, beep/1, flash/1).  Model
% (OURS): each value is a slot, set by the setter and read back by the
% getter; nothing is displayed, so the display methods succeed and do
% nothing.  The initial values are OURS (0, an empty title); the font
% starts as 0, since no font object is stood in.  What `manipulator` in
% place of a coordinate does (the user places the window, TM-125 p15) is
% not modelled: it is stored like a number.

% INTERPOLATED: the representation (OURS); see the note above.
attribute x := 0, y := 0, width := 0, height := 0,
          columns := 0, rows := 0, title := "", font := 0;

% INTERPOLATED from: window.md §2.1 set_position/3 (TM-125 p15).
:set_position(Window, X, Y) :-
        Window!x := X, Window!y := Y;
% INTERPOLATED from: window.md §2.1 get_position/3 (TM-115 p63).
:get_position(Window, X, Y) :-
        X = Window!x, Y = Window!y;
% INTERPOLATED from: window.md §2.1 set_size/3 (TM-125 p15).
:set_size(Window, W, H) :-
        Window!width := W, Window!height := H;
% INTERPOLATED from: window.md §2.1 get_size/3 (TM-115 p50).
:get_size(Window, W, H) :-
        W = Window!width, H = Window!height;
% INTERPOLATED from: window.md §2.1 reshape/5 `(W,X,Y,Wd,Ht)`, "move and
% resize at once" (USAGE cal-esp cpwindow.esp:85).
:reshape(Window, X, Y, W, H) :-
        Window!x := X, Window!y := Y,
        Window!width := W, Window!height := H;
% INTERPOLATED from: window.md §2.1 set_text_size/3 `(W,Cols,Rows)`
% (USAGE pimfep device reshape/7).
:set_text_size(Window, C, R) :-
        Window!columns := C, Window!rows := R;
% INTERPOLATED from: window.md §2.1 get_text_size/3 (USAGE pimfep
% get_inside_size/3).
:get_text_size(Window, C, R) :-
        C = Window!columns, R = Window!rows;
% INTERPOLATED from: window.md §2.2 set_title/2 (TM-125 p15).
:set_title(Window, T) :-
        Window!title := T;
% INTERPOLATED from: window.md §2.2 get_title/2 (USAGE, 111 uses).
:get_title(Window, T) :-
        T = Window!title;
% INTERPOLATED from: window.md §2.2 set_font/2 (TM-112 p16).
:set_font(Window, F) :-
        Window!font := F;
% INTERPOLATED from: window.md §2.2 get_font/2 (USAGE).
:get_font(Window, F) :-
        F = Window!font;
% INTERPOLATED from: window.md §2.1 activate/1 (TM-125 p16); nothing is
% displayed here.
:activate(Window) ;
% INTERPOLATED from: window.md §2.1 deactivate/1 (TM-125 p16).
:deactivate(Window) ;
% INTERPOLATED from: window.md §2.1 show/1 (TM-125 p16).
:show(Window) ;
% INTERPOLATED from: window.md §2.1 hide/1 (TM-125 p16).
:hide(Window) ;
% INTERPOLATED from: window.md §2.3 beep/1 (USAGE, 69 uses).
:beep(Window) ;
% INTERPOLATED from: window.md §2.3 flash/1 (USAGE, pimfep
% pimos_window_editor).
:flash(Window) ;

local

% The editor's class: the first `{editor, Class}` option (OURS: the
% option's form is pimos_window's), else standard_editor.  An unbound
% option list or option is not an editor option (it is not bound to one).
editor_class(Options, #standard_editor) :- unbound(Options), !;
editor_class([Option|_], Class) :- editor_option(Option, Class), !;
editor_class([_|Options], Class) :- !, editor_class(Options, Class);
editor_class(_, #standard_editor);

editor_option(Option, _) :- unbound(Option), !, fail;
editor_option({editor, Class}, Class);

end.
