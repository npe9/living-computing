% SCAFFOLDING stand-in for SIMPOS's class `pmacs_window` (the Pmacs editor
% window), compiled by psi/espc.py into the package `simpos`.  It is NOT
% SIMPOS: no part of it is printed or held, and NO DISPLAY IS MODELLED.
% It is MINIMAL: creation and get_editor/2 only.  The window protocol
% (activate/1, putl/2, putf/3, getl/2, ...; docs/simpos/subsystems/
% window.md §2.4, §2.11) is not stood in, so a caller stops at its first
% window method.  INTERPOLATED (labelled) from:
%   - window.md §2.11 (corrected 2026-11-24 by docs/simpos/
%     source_check_2026-11-24.md, row SA36): disc/exshow.esp:24 (held
%     IFS source) sends create/3, `:create(#pmacs_window,[title(Buf)|
%     Init],W)`, then `:get_editor(W,E)` at :28 (window -> its editor, a
%     standard_editor), `:get_window(E, W)` (editor -> window); create/4,
%     `:create(#pmacs_window, Opts, _, W)` with the third argument
%     unbound, is kwic-esp src/inEditor1.esp:151 and mendels
%     comp_win.esp:54-62 (both re-read 2026-11-25: Opts carry
%     `nature([with_superior_input_buffer])` and `superior(..)`); over
%     the IFS sources create/3 is the common form (about 85 sends against
%     3 of create/4, source check row SA36);
%   - pimfep##pimfep_message_log dump_log/1, sorted_log/1,
%     sorted_log_string/1 and pimos_fep_superviser log_window/2 (held
%     .ptf): `:create(#pmacs_window, Opts, W)`, then `:activate(W)` and
%     `:putl(W, ...)`;
%   - docs/simpos/required/classes.tsv (row `pmacs_window`): class methods
%     create/3, create/4, create_with_input/4,5;
%   - (step 3e) pimfep##pimos_window create_pimos_window/3 (held .ptf, run
%     by kl0 2026-11-24): it sends `:create(#pimos_window,
%     [{size,70,110}, {editor,#pimos_window_editor}], _, W)` (and
%     `{buffer,Name}` before the editor option when given a name), then
%     sets `W!activity := 1`.  pimos_window declares no slot `activity`,
%     so the slot is pmacs_window's.
% Model (OURS): the window and its editor are made together and point at
% each other.  An `{editor, Class}` option names the editor's class
% (standard_editor without one); the other options are ignored.  What
% `activity` means is UNKNOWN; it starts at 0.

class pmacs_window has

% INTERPOLATED from: the pimfep `:create(#pmacs_window, Opts, W)` sends;
% the editor option from pimos_window create_pimos_window/3 (step 3e).
:create(Class, Options, Window) :-
        :new(Class, Window),
        editor_class(Options, Editor_class),
        :new(Editor_class, Editor),
        Window!editor := Editor,
        Editor!window := Window;
% INTERPOLATED from: kwic-esp src/inEditor1.esp:151 and mendels
% comp_win.esp:54-62 `:create(#pmacs_window, Opts, _, W)` (held IFS
% source; Opts with `nature([with_superior_input_buffer])` and
% `superior(..)`, window.md §2.11); the third argument is left unbound,
% as every held caller leaves it.  The options are ignored (OURS).
:create(Class, Options, Unused, Window) :-
        :create(Class, Options, Window);

instance

% INTERPOLATED: the representation (OURS).
attribute editor := 0;

% INTERPOLATED (step 3e) from: pimos_window create_pimos_window/3, which
% sets it to 1 after creating the window; meaning UNKNOWN.
attribute activity := 0;

% INTERPOLATED from: window.md §2.11 `:get_editor(W, E)`.
:get_editor(Window, Editor) :-
        Editor = Window!editor;

local

% The editor's class: the first `{editor, Class}` option (OURS: the
% option's form is pimos_window's), else standard_editor.  An unbound
% option list or option is not an editor option (it is not bound to one).
editor_class(Options, #standard_editor) :- unbound(Options), !;
editor_class([Option|_], Class) :- editor_option(Option, Class), !;
editor_class([_|Options], Class) :- !, editor_class(Options, Class);
editor_class(_, #standard_editor);

editor_option(Option, _) :- unbound(Option), !, fail;
editor_option({editor, Class}, Class);

end.
