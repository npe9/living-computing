% SCAFFOLDING, OURS: the status line at the bottom of the screen, compiled
% by psi/espc.py into the package `simpos`.  `status_band` is NOT a SIMPOS
% class name: the class that drew it is lost.  Window milestone M6
% (2026-11-25).  As window_pane.esp, it sends only the
% simpos##bitmap_display primitives (psi/windev.py).
%
% THE LOOK, each choice with its basis (window.md §4.2, the plan §3):
%   - a black band across the bottom of the screen, below all windows, two
%     rows of text: SCREENSHOT melco.wmv@50 (2.50), esp.wmv@108-109 (A00),
%     TM-153 PDF p28 Fig. 7 (2.00), FSTJ 26(1) p99 Fig. 9 (4.2);
%   - row 1 `USER : name`, row 2 `SIMPOS Version v`, in white: the same
%     screenshots;
%   - a reverse box (white, black text) naming the window that has the
%     keyboard (INFERENCE, window.md §4.2: the middle box; TM-126 p7 PROSE
%     "the selected window's name is shown on the bottom line"; gap G14);
%     the name `<class>/<n>` (SCREENSHOT FSTJ 26(1) p99,
%     `editor_buffer_window/19`; the plan §3 "Window names");
%   - the band is the frame's rows below the 1,280 x 944 screen, 944 to
%     1,023 (OURS: the plan §1.1 puts the band below the logical screen,
%     its height S a parameter; here S fills winfb's 1,024-row frame);
%   - the rows 8 dots and 30 dots below the band's top, the text 8 dots
%     from the left, the box at x = 400 (OURS);
%   - the status-line font is not held (the plan §1.4): test_11 (OURS);
%   - the version: `V7`, the same OURS value as ref/pimm/fep.py's 240
%     answer ("SIMPOS V7"; docs/fep_services.md §6.3: the PSI asks
%     simpos##version, not held);
%   - the date, window M6 (2026-11-25): `DD-Mon-YY Weekday hh:mm:ss` at
%     the right of row 2 (SCREENSHOT TM-153 PDF p28 Fig. 7, `25-Jan-86
%     Saturday 13:01:36`, row 2 right, subsystems/listings/
%     TM-153_p23_p28_recheck.txt; the same form in TM-115 p25 `23-May-85
%     Thursday 20:22:44` and FSTJ 26(1) p99 `12-Sep-89 Tuesday 10:25:41`,
%     shell.md §4.4).  The month's three letters and the weekday's full
%     name are as in those three; the other months' and days' spellings
%     are the English names (INFERENCE).  Its right edge 8 dots from the
%     frame's (OURS, as the left text's 8).  The date is the PSI's
%     date_time (date_time.esp: day 33742 = 20-May-93, a Thursday, time 0,
%     the PIM/m FEP's OURS clock), read once when the band is drawn (the
%     time does not run: OURS, no clock is modelled);
%   - not drawn: `SWAPPED` and `spool`.  The screenshots show them (row 1
%     right, TM-153 p28: SWAPPED an inverse box, spool boxed; FSTJ p99:
%     both inverse; Giho 8609 p16), but no source read says what turns
%     either on or off (2026-11-25: window.md §4.2, shell.md §4.4,
%     notes/ipsj.md, notes/tm115.md, the plan §3), so there is no state to
%     draw them from; no swapping or spooler is modelled either.

class status_band has

% :draw(#status_band) -- OURS: the band, with the name of the process's
% user (simpos user/2, local_name/2: user.esp), blank when it has none.
% INTERPOLATED (selector and body OURS): draw; basis above and in
% the head comment.
:draw(Class) :-
        :default_font(#bitmap_display, Id, Cw, Ch),
        :fill(#bitmap_display, 0, 944, 1280, 80, set),
        user(U),
        text(Id, Cw, "USER : ", 8, 952, X),
        name(Id, Cw, U, X, 952),
        text(Id, Cw, "SIMPOS Version V7", 8, 974, _),
        date(Id, Cw);

% :show_selected(#status_band, Kind, N) -- OURS: the box names the window
% Kind/N (Kind a string), or is cleared when Kind is 0.
% INTERPOLATED (selector and body OURS): show_selected; basis above and in
% the head comment.
:show_selected(Class, Kind, N) :-
        :default_font(#bitmap_display, Id, Cw, Ch),
        :fill(#bitmap_display, 400, 950, 440, Ch + 4, set),
        boxed(Id, Cw, Ch, Kind, N);

local

% the date at the right of row 2 (see the head comment)
date(Id, Cw) :-
        :now(#date_time, D),
        :get_value(D, Y, Mo, Da, H, Mi, S, _),
        :get_count(D, Days, _),
        weekday(Days, Wd), day_name(Wd, Name),
        month_name(Mo, Mn),
        quotient(Y, 100, 0, C), times(C, 100, 0, Yc),
        string(Name, Nl, _),
        times(Nl + 19, Cw, 0, Tw),
        right_edge(R),
        two(Id, Cw, Da, R - Tw, X1),
        text(Id, Cw, "-", X1, 974, X2),
        text(Id, Cw, Mn, X2, 974, X3),
        text(Id, Cw, "-", X3, 974, X4),
        two(Id, Cw, Y - Yc, X4, X5),
        text(Id, Cw, " ", X5, 974, X6),
        text(Id, Cw, Name, X6, 974, X7),
        text(Id, Cw, " ", X7, 974, X8),
        two(Id, Cw, H, X8, X9),
        text(Id, Cw, ":", X9, 974, X10),
        two(Id, Cw, Mi, X10, X11),
        text(Id, Cw, ":", X11, 974, X12),
        two(Id, Cw, S, X12, _);

right_edge(1272);

% N < 100 as two digits, white on black, from X on row 2
two(Id, Cw, N, X, X1) :-
        quotient(N, 10, 0, T),
        times(T, 10, 0, T10),
        digit(T, D1), digit(N - T10, D2),
        :glyph(#bitmap_display, Id, D1, X, 974, reverse),
        :glyph(#bitmap_display, Id, D2, X + Cw, 974, reverse),
        value(X + Cw + Cw, X1);

% the day of the week of day count N, 0 = Sunday: day 0, 01-Jan-1901, was
% a Tuesday; (N + 2) mod 7, by subtraction in steps (espc has no
% immediate above 255)
weekday(N, W) :- seven_k(K), mod7(N + 2, K, W);
mod7(N, K, W) :- N >= K, !, mod7(N - K, K, W);
mod7(N, K, W) :- K > 7, !, smaller(K, K1), mod7(N, K1, W);
mod7(N, _, N);
smaller(7000, 700) :- !;
smaller(700, 70) :- !;
smaller(70, 7);
seven_k(7000);

day_name(0, "Sunday");
day_name(1, "Monday");
day_name(2, "Tuesday");
day_name(3, "Wednesday");
day_name(4, "Thursday");
day_name(5, "Friday");
day_name(6, "Saturday");

month_name(1, "Jan");
month_name(2, "Feb");
month_name(3, "Mar");
month_name(4, "Apr");
month_name(5, "May");
month_name(6, "Jun");
month_name(7, "Jul");
month_name(8, "Aug");
month_name(9, "Sep");
month_name(10, "Oct");
month_name(11, "Nov");
month_name(12, "Dec");

user(Name) :- :user(#user, U), U \== 0, !, :local_name(U, Name);
user(0);

name(_, _, 0, _, _) :- !;
name(Id, Cw, S, X, Y) :- text(Id, Cw, S, X, Y, _);

boxed(_, _, _, 0, _) :- !;
boxed(Id, Cw, Ch, Kind, N) :-
        string(Kind, K, _),
        digits(N, Ds),
        count(Ds, 0, Nd),
        times(K + Nd + 3, Cw, 0, W),
        :fill(#bitmap_display, 400, 950, W, Ch + 4, reset),
        box_left(L),
        text_on(Id, Cw, Kind, L + Cw, 952, X),
        slash(Slash),
        :glyph(#bitmap_display, Id, Slash, X, 952, copy),
        codes(Id, Cw, Ds, X + Cw, 952);

% white text on the black band (glyphs `reverse`: opaque, inverted)
text(Id, Cw, S, X, Y, X1) :- string(S, N, _), glyphs(Id, Cw, S, 0, N, X, Y, reverse, X1);
% black text in the white box
text_on(Id, Cw, S, X, Y, X1) :- string(S, N, _), glyphs(Id, Cw, S, 0, N, X, Y, copy, X1);

glyphs(_, _, _, I, N, X, _, _, X) :- I >= N, !;
glyphs(Id, Cw, S, I, N, X, Y, Op, X1) :-
        string_element(S, I, C),
        :glyph(#bitmap_display, Id, C, X, Y, Op),
        glyphs(Id, Cw, S, I + 1, N, X + Cw, Y, Op, X1);

codes(_, _, [], _, _);
codes(Id, Cw, [C | Cs], X, Y) :-
        :glyph(#bitmap_display, Id, C, X, Y, copy),
        codes(Id, Cw, Cs, X + Cw, Y);

% the JIS digits of N >= 0, most significant first (row 23, 16#2330 + d)
digits(N, Ds) :- digits(N, [], Ds);
digits(N, Acc, [D | Acc]) :- N < 10, !, digit(N, D);
digits(N, Acc, Ds) :-
        quotient(N, 10, 0, Q),
        times(Q, 10, 0, T),
        digit(N - T, D),
        digits(Q, [D | Acc], Ds);

digit(N, D) :- zero(Z), value(Z + N, D);
zero(9008);

value(V, V);

slash(8511);

box_left(400);

quotient(D, Q, R, R) :- D < Q, !;
quotient(D, Q, R0, R) :- quotient(D - Q, Q, R0 + 1, R);

times(0, _, P, P) :- !;
times(N, C, P0, P) :- times(N - 1, C, P0 + C, P);

count([], N, N);
count([_ | R], N0, N) :- count(R, N0 + 1, N);

end.
