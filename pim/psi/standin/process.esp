% SCAFFOLDING stand-in for SIMPOS's class `process`, compiled by
% psi/espc.py into the package `simpos` so that held code's sends to
% simpos##process resolve.  It is NOT SIMPOS: the real class is lost.
% Each method is labelled PRINTED (verbatim, with its source) or
% INTERPOLATED (ours, with what it was interpolated from), so it can be
% replaced if real source turns up.
%
% PRINTED: TM-100 Figure 3.1 "Part of class 'process'" (PDF p7-10,
% printed folios 5-8; listings docs/simpos/printed/listings/
% tm0100_p07.esp-p10.esp): the natures, the class slots, create/2,
% create_core/3, the instance slots, activate/2, resume/2 and suspend/2,
% verbatim (layout as printed, comments shortened).  The figure is "part
% of" the class and "not complete" (TM-100 p5).  One printed oddity:
% create/2 calls `:create_core(PROCESS, ...)` with PROCESS in capitals, a
% fresh variable (tm0100_p08.esp transcriber's note: probably a typo for
% Class).  Until step 3k it was kept as printed, and create/2 stopped at
% create_core/3 sent to the unbound PROCESS.  Since step 3k it runs as
% `Class`, a CORRECTED line with the printed text kept in its comment.
%
% The printed instance slots are initialised by code (five
% `:create(#list, L)` / `:create(#process_clock, C)` predicates).  kl0's
% new/2 runs them (TM-388 §3.5 pp.49-50); the classes they create are
% the INTERPOLATED stand-ins list.esp and process_clock.esp.  The
% natures with_link and waiting_frame are INTERPOLATED empty stand-ins
% (with_link.esp, waiting_frame.esp): TM-100 says only what they are
% for (PDF p10, p14), not what they hold.
%
% Added (INTERPOLATED, labelled below): the class slot `current`,
% self/2, inhibit_interrupt/1, allow_interrupt/1, tag_catch/5, /6, /9,
% create/3, allow_forced_event/1 and inhibit_forced_event/1; step 3j:
% status/3 and clear_masks/1, and create/3 now makes a context.
% Model (INTERPOLATED): the running process is kept in the class slot
% `current`, made on first use.  Since step 3i it is the boot process,
% an instance of the stand-in boot_process.esp.  create/3 makes further
% process objects, dormant.  Since step 3j the printed activate/2 makes
% one ready, and kl0's dispatcher (OURS, psi/README.md "Step 3j") runs it
% when the running process suspends or ends; that needs the boot process
% to have come under the supervisor (its own create/2 and activate/2).

    class  process  has

    % PRINTED: TM-100 Fig. 3.1, PDF p7 (natures; with_link and
    % waiting_frame are INTERPOLATED empty stand-ins)
    nature      with_link,
                waiting_frame ;

    % PRINTED: TM-100 Fig. 3.1, PDF p7 (both class slots)
    attribute   ready_queue,
                instance_array ;
                % Relates a process to its context_number.

    % INTERPOLATED: holds the running process; not a printed slot.
    attribute   current := 0 ;

    % PRINTED: TM-100 Fig. 3.1, PDF p8, with one labelled correction.
    % CORRECTED (step 3k, 2026-11-25): the printed second line reads
    %         :create_core(PROCESS, Process, Context), ! ;
    % with PROCESS in capitals, a variable the clause does not bind (its
    % head binds Class).  It runs here as `Class`, the transcriber's
    % reading (tm0100_p08.esp note).  The page image was re-read
    % (docs/simpos/source_check_2026-11-24.md §10.2): the printed text is
    % as recorded above.
    :create(Class, Process) :- !,
            % Make an instance and initiate it.  If hardware processes
            % are exhausted, then fail.
        :create(#context, Context_number, Stack_number, Context),
        :create_core(Class, Process, Context), ! ;

    % PRINTED: TM-100 Fig. 3.1, PDF p8
    :create_core(Class, Process, Context) :-
        :new(Class, Process),
        :get_number(Context, Context_number),
        set_vector_element(#process!instance_array,
                                Context_number, Process),
        :self(#process, Self_process),
        Process!context := Context,
        Process!priority := 0,
        Process!sub_priority := 0,
        Process!parent_process := Self_process,
        :add_child(Self_process, Process),
        Process!world := Self_process!world,
        Process!user := Self_process!user,
        Process!status := dormant, ! ;

    % :self(#process, P) -- P is the calling process.
    % INTERPOLATED from: the call sites `:self(#process, Process)` in the
    % printed stream:get/2 (TM-100 Fig. 3.6, PDF p15) and in the printed
    % process:create_core/3 (TM-100 Fig. 3.1, PDF p8), both of which use P
    % as a process instance; the class-predicate form matches TR-056 p25's
    % `:world(#process,World)`; 46 pimfep methods send it (psi/README.md,
    % "The ESP compiler").  The body is not printed anywhere held.
    % Step 3i: when no process exists yet, the one made is the boot
    % process (INTERPOLATED: TM-100 p6, "created and activated by the
    % hardware, not by another process, when the system is bootstrapped";
    % boot_process.esp), so the machine's first process is a
    % boot_process, as on the PSI.  Before step 3i it was a plain process.
    :self(Class, P) :- P = Class!current, P \== 0, !;
    :self(Class, P) :- :boot(#boot_process, P), Class!current := P;

    % :inhibit_interrupt(#process) / :allow_interrupt(#process) bracket a
    % critical section.
    % INTERPOLATED from: the call sites in the printed stream:put/2 and
    % get/2 (TM-100 Fig. 3.6) and process:activate/resume/suspend (Fig.
    % 3.1), always paired, always on the class; the instance slot
    % mask_count ("the number of interrupt mask nestings", Fig. 3.1 PDF
    % p8).  One process and no interrupts are modelled here, so both
    % succeed and do nothing.
    :inhibit_interrupt(Class) ;
    % INTERPOLATED: see inhibit_interrupt/1 just above.
    :allow_interrupt(Class) ;

    % :create(#process, Process, Areas) -- a new process, dormant, whose
    % parent is the calling process.
    % INTERPOLATED from:
    %   - the call sites: kappa2 kernel/itr/ITRSES.ESP:114 and
    %     utility/mop/MOPMANAGER.ESP:170 `:create(#process,Process,
    %     [free,free,free,free])`, utility/tool/LOADER.ESP:53
    %     `[free,default,free,middle]`, each followed by
    %     `:activate(Process, Program)`; pimfep##as_pimos_device
    %     process/4 (held cells @1a-29, read 2026-11-24):
    %     `:create(#process, P, [free,default,free,small])`, then its local
    %     setup_process/3;
    %   - the printed create_core/3 (TM-100 Fig. 3.1, PDF p8), whose slot
    %     settings it repeats (step 3j added the hardware context, step
    %     3k :add_child; see below).
    % What the four-element list means is not known; it is ignored.
    % INFERENCE: four area-limit check settings, one per stack.  The same
    % atoms open set_area_limit_execution/6, commented "area limit check
    % free" (gog-esp and gog-kl1 CGS_MAIN.ESP:70, gog-esp FEP.ESP:21:
    % `:set_area_limit_execution(Pr,free,free,free,free,nil,nil)`), and
    % TR-079 PDF p9 (Fig. 2, folio 8) draws four stacks: control, global,
    % local and trail.
    % Step 3j: the hardware context is made as the printed create/2 makes
    % it, `:create(#context, Context_number, Stack_number, Context)`, and
    % stored in the printed slot (create_core/3's `Process!context :=
    % Context`); context.esp is INTERPOLATED.  So the 64th process is not
    % made (create fails, as create/2's comment says).
    :create(Class, Process, Areas) :-
        :create(#context, Context_number, Stack_number, Context),
        :new(Class, Process),
        Process!context := Context,
        :self(#process, Self_process),
        Process!priority := 0,
        Process!sub_priority := 0,
        Process!parent_process := Self_process,
        :add_child(Self_process, Process),
        Process!world := Self_process!world,
        Process!user := Self_process!user,
        Process!status := dormant, ! ;
    % Step 3k: create/3 now sends :add_child(Self_process, Process) where
    % the printed create_core/3 does (TM-100 Fig. 3.1, PDF p8), since
    % add_child/2 is now stood in (below).

    % :world(#process, World) -- the calling process's world.  PRINTED
    % interface (TR-056 PDF p25, folio 23: "Though this is a class
    % predicate, this call returns the working world of the calling
    % process"); the body is INTERPOLATED (step 3l).
    :world(Class, World) :- :self(Class, P), World = P!world ;

    % :get_number(#process, Process, N) -- step 3l.  INTERPOLATED
    % (INFERENCE) from its held senders: pimfep##pimos_login_requester
    % title_string/1 @2a4-2ae (`:self(#process, P)`, then this, the number
    % turned into a string for the window's title) and pimmcsp##
    % pseudo_pe_process get_pe_process_number/2 @220-226.  N is the number
    % of the process's context, the index the printed create_core/3 files
    % it under in instance_array (TM-100 Fig. 3.1, PDF p8): INFERENCE.
    :get_number(Class, Process, N) :- :get_number(Process!context, N) ;

    instance

    % PRINTED: TM-100 Fig. 3.1, PDF p8 (all instance slots)
    attribute   context,    % Hardware PCB
                % (CORRECTED step 3k: first transcribed "Hardware PC";
                % TM-100 PDF p8 page image re-read, source_check §10.2)
                priority,   % Corresponds to interrupt level
                sub_priority,
                mask_count          := 0,
                        % The number of interrupt mask nestings
                suspend_reason  := nil,
              ( suspend_reasons := List :- :create(#list, List) ),
                suspend_flag    := nil,
                status          := nil,
                        % nil(=dead), dormant, suspended, ready, (active)
                        % and some others
                parent_process,
              ( children_processes  := List :- :create(#list, List) ),
                killer_process,     % which terminates this process
              ( invocation_stack    := List :- :create(#list, List) ),
              ( resources           := List :- :create(#list, List) ),
                world,
                user,
                interpreter_instance,
                        % Interpreter instance which runs on this process
              ( clock     := Clock :- :create(#process_clock, Clock) ) ;
                        % The elapse time of this process

    % INTERPOLATED: a slot not printed in Fig. 3.1, from the accessors
    % below.
    attribute   password_list ;

    % Slot accessors.  INTERPOLATED from: the held compiled calls in
    % pimfep##as_pimos_device's local setup_process/3 (@183-1b5, read
    % 2026-11-24), which reads sub_priority/2, user/2, password_list/2
    % and world/2 from the calling process (`:self(#process,P)`) and sets
    % set_sub_priority/2, set_user/2, set_password_list/2 and set_world/2
    % on the new one; the slots sub_priority, user and world are PRINTED
    % (TM-100 Fig. 3.1, PDF p8), password_list is not (above).  A getter
    % gives the slot's value, a setter replaces it (OURS).
    :sub_priority(Process, X) :- X = Process!sub_priority ;
    % INTERPOLATED: see the slot accessors just above.
    :set_sub_priority(Process, X) :- Process!sub_priority := X ;
    % INTERPOLATED: see the slot accessors above.
    :user(Process, X) :- X = Process!user ;
    % INTERPOLATED: see the slot accessors above.
    :set_user(Process, X) :- Process!user := X ;
    % INTERPOLATED: see the slot accessors above.
    :world(Process, X) :- X = Process!world ;
    % INTERPOLATED: see the slot accessors above.
    :set_world(Process, X) :- Process!world := X ;
    % INTERPOLATED: see the slot accessors above.
    % Step 3l: a process with no list yet gets one (OURS: made on first
    % use, as simpos_user setup_process/2 @ee-f9 sends set_access_mode/2
    % to the answer; standin/password_list.esp).
    :password_list(Process, X) :- X = Process!password_list, X \== 0, ! ;
    :password_list(Process, X) :-
        :new(#password_list, X), Process!password_list := X ;
    % INTERPOLATED: see the slot accessors above.
    :set_password_list(Process, X) :- Process!password_list := X ;

    % :allow_forced_event(Process) / :inhibit_forced_event(Process).
    % INTERPOLATED from: the held compiled calls -- pimfep##pimos_timer's
    % local allow_forced_event/1 (@101: `:allow_forced_event(P), ! ; true`),
    % called from do_on_after/4 and do_on_at/4 with the process that
    % tag_catch/9 passed in, so the receiver is a process instance; the
    % selectors allow_forced_event/1 (10 sends) and inhibit_forced_event/1
    % (8) in pimmcsp (docs/simpos/required/ptf_unattributed_selectors.tsv);
    % the pairing with tag_catch/9's abort path (a forced event is read
    % here as an abort delivered to the process: INFERENCE).  One process
    % and no abort are modelled, so both succeed and do nothing.
    :allow_forced_event(Process) ;
    % INTERPOLATED: see allow_forced_event/1 just above.
    :inhibit_forced_event(Process) ;

    % :tag_catch(Process, Object, Method, Args, Tag) and its 6- and
    % 9-argument forms run the goal :Method(Object, Args...) as a catch
    % point for Tag; a throw of Tag returns control here (and, in the
    % 9-argument form, runs :Abort_method(Abort_object, Abort_args...)).
    % INTERPOLATED from:
    %   - the call forms in held source: kappa2 inwin.esp:301
    %     `:tag_catch(Process,INwin,getl,{Value0},abort_input)`; cal-esp
    %     deb2.12/cm.esp:320 `:tag_catch(Proc, nil, D_obj,
    %     get_goal_with_cancel_situation, {Proc,Args}, break)`; kwic-esp
    %     search_F.esp:142 `:tag_catch(Me, Me, catch, {ItemString, Search,
    %     Method, Args}, Tag)`, thrown by `:raise(#throw, quit_search)`;
    %   - the held compiled call in pimfep##pimos_timer on_after/4 and
    %     on_at/4 (registers read 2026-11-24): `:tag_catch(Process, "",
    %     Timer, do_on_after, {X,Z,Process}, Timer, abort_timer,
    %     {X,Process}, pimos_abort)`, X and Z on_after's first and third
    %     arguments; the abort side is fep_services.md
    %     §6.7 (70 sends :abort(Handler, pimos_abort, DeviceProcess); the
    %     interrupted request is answered {Id, 6} by abort_timer/3);
    %   - TR-285 §4.2 (PDF p9-10): catch and throw are built on the
    %     multiple-level cut and enforced failure; resumption points are
    %     recorded in the process's situation stack;
    %   - TM-388 p.46: the goal is a dynamic call, :refute(Object, Method,
    %     ArgVector), a method of class `class` (kl0's refute/3);
    %   - TM-100 was checked (the transcribed listings
    %     docs/simpos/printed/listings/tm0100_p04-p18): it is silent on
    %     tag_catch, catch, throw and abort.
    % What the second argument of the 6- and 9-argument forms is (nil, "")
    % is not known; it is ignored.  No throw is modelled (one process,
    % nothing sends :abort), so the catch point is never used: each form
    % just runs the goal.
    :tag_catch(Process, Object, Method, Args, Tag) :-
        :refute(Object, Method, Args);
    % INTERPOLATED: the 6-argument form; see tag_catch/5 just above.
    :tag_catch(Process, Name, Object, Method, Args, Tag) :-
        :refute(Object, Method, Args);
    % INTERPOLATED: the 9-argument form; see tag_catch/5 above.  The abort
    % goal (Abort_object, Abort_method, Abort_args) is not run: no throw.
    :tag_catch(Process, Name, Object, Method, Args,
               Abort_object, Abort_method, Abort_args, Tag) :-
        :refute(Object, Method, Args);

    % :status(Process, Old, New) -- if Process's status is Old, it becomes
    % New; otherwise fail.  Step 3j.
    % INTERPOLATED from its five call sites, none with a body:
    %   - PRINTED: activate/2 below, `:status(Process, dormant,
    %     on_activate), !` (TM-100 Fig. 3.1, PDF p8), followed later by
    %     `Process!status := ready`;
    %   - HELD, pimmcsp##pseudo_pe_process release/1 @17a-17e:
    %     `:status(Self, dormant, on_release)`, then the boot process is
    %     asked to release Self; release/1 is sent by terminate/1 @1ca
    %     after terminate_core/1;
    %   - HELD, the same class's $or$5/2 @3a9-3bc (reached from
    %     terminate_core/1 through $or$4/2 @37d): clause 1
    %     `:status(P, suspended, dormant)`; clause 2 (the try_me_else
    %     alternative) `:status(P, ready, dormant)`, then a removal
    %     (remove_only/2, $or$6/2).  A terminated process becomes dormant
    %     (TR-056 PDF p18, folio 16: dormant "when it has just been created
    %     or terminated").
    % So the second argument is the status expected and the third the one
    % it becomes (INFERENCE from $or$5/2, whose third argument is a status,
    % `dormant`); on_activate and on_release are transient statuses, the
    % "and some others" of the printed slot comment (Fig. 3.1, PDF p8).  A
    % mismatch fails: $or$5/2's second clause is reached only when
    % clause 1's status/3 fails.  The interrupt bracket is OURS (a test and
    % a set, made one step as the printed suspend/2 and resume/2 bracket
    % theirs).
    :status(Process, Old, New) :-
        :inhibit_interrupt(#process),
        (   Process!status == Old, !,
            Process!status := New,
            :allow_interrupt(#process)
        ;   :allow_interrupt(#process), !,
            fail ) ;

    % :clear_masks(Process) -- no interrupt mask is in force.  Step 3j.
    % INTERPOLATED from: its one call, in the printed activate/2 below
    % (TM-100 Fig. 3.1, PDF p9), and the printed slot mask_count := 0,
    % "The number of interrupt mask nestings" (PDF p8).
    :clear_masks(Process) :- Process!mask_count := 0 ;

    % PRINTED: TM-100 Fig. 3.1, PDF p8-9
    :activate(Process, Program) :-
            % Give Program to Process, and make it ready.
        :status(Process, dormant, on_activate), !,
        :entry_of_invoke(Program, Entry),
        :set_entry_point(Process!context, Entry),
        :activate(Process!context),
        :set_priority(Process!context, 0),
        :clear_masks(Process),
        :inhibit_interrupt(#process),
        Process!status := ready,
        :add(#process!ready_queue, Process),
        :allow_interrupt(#process), ! ;

    % PRINTED: TM-100 Fig. 3.1, PDF p9
    :resume(Process, Reason) :-
            % Remove Reason from 'suspend_reasons'.  If there's no
            % such Reason, then fail.  If 'suspend_reasons' becomes
            % empty, then make Process ready.  If already resumed,
            % then do nothing.
        :inhibit_interrupt(#process),
        %CHECK REASON
        (   Process!status == suspended, !,
            (   Reason = stream(Stream), !,
                Process!suspend_reason := nil,
                (   Process!suspend_flag == nil, !,
                    Process!status := ready,
                    :add(#process!ready_queue, Process)
                ;   true ),
                :allow_interrupt(#process)
            ;   :remove(Process!suspend_reasons, Reason), !,
                (   :empty(Process!suspend_reasons), !,
                    Process!suspend_flag := nil
                ;   true ),
                (   Process!suspend_reason == nil,
                    Process!suspend_flag == nil, !,
                    Process!status := ready,
                    :add(#process!ready_queue, Process)
                ;   true ),
                :allow_interrupt(#process)
            ;   :allow_interrupt(#process), !,
                fail )
        ;   Process!status == ready, !,
            :allow_interrupt(#process)
        ;   :allow_interrupt(#process), !,
            fail ),
        ! ;

    % PRINTED: TM-100 Fig. 3.1, PDF p9-10 (`Reason == stream(Stream)` in
    % the second branch as printed)
    :suspend(Process, Reason) :-
            % Add Reason to 'suspend_reasons'.  If Process is ready,
            % then make it suspended.
        :inhibit_interrupt(#process),
        %CHECK REASON
        (   Process!status == ready, !,
            (   Reason = stream(Stream), !,
                Process!suspend_reason := Stream
            ;   :add_last(Process!suspend_reasons, Reason),
                Process!suspend_flag := on ),
            Process!status := suspended,
            :remove(#process!ready_queue, Process),
            :allow_interrupt(#process)
        ;   Process!status == suspended, !,
            (   Reason == stream(Stream), !,
                Process!suspend_reason := Stream
            ;   :add_last(Process!suspend_reasons, Reason),
                Process!suspend_flag := on ),
            :allow_interrupt(#process)
        ;   :allow_interrupt(#process), !,
            fail ),
        ! ;

    % :add_program(Process, Program) -- push Program onto the process's
    % invocation stack.
    % INTERPOLATED (step 3e) from: the printed as_program:assign/1 (TM-100
    % Fig. 3.3, PDF p11: "Push Program into 'invocation_stack'"), its only
    % caller; the printed slot invocation_stack, a list (Fig. 3.1, PDF
    % p8); TM-100's prose (PDF p11) "the program is pushed onto the
    % invocation stack of the process".  The top is the list's first
    % element (OURS).
    :add_program(Process, Program) :-
        :add_first(Process!invocation_stack, Program) ;

    % :remove_program(Process, Program) -- pop the top program.
    % INTERPOLATED (step 3e) from: the printed as_program:resign/1 and
    % resign_core/1 ("Pop Program from 'invocation_stack'"), which pass an
    % unbound Any_program; TM-100 PDF p11 "the program is popped".  Fails
    % on an empty stack (OURS).
    :remove_program(Process, Program) :-
        :remove_first(Process!invocation_stack, Program) ;

    % :no_program(Process) -- the invocation stack is empty.
    % INTERPOLATED (step 3e) from: the printed as_program:resign/1
    % (`:no_program(Process), !, :die(Process)`, "If it is the root
    % program, then the process dies") and TM-100 PDF p11 "If the stack
    % becomes empty, the process terminates".
    :no_program(Process) :-
        :empty(Process!invocation_stack) ;

    % :invocation_stack(Process, Stack) -- the invocation stack itself,
    % the list object (its first element the running program).
    % INTERPOLATED (step 3g), as the slot accessors above, from: the
    % printed slot invocation_stack, a list (TM-100 Fig. 3.1, PDF p8);
    % the held source kappa-p.tar.Z src/emu/kappaPITR.esp:13-14
    % (`:self(#process, Proc), :get_first(Proc!invocation_stack, Prog)`,
    % then Prog!kappa_in_stream: the first element is the program that
    % called); the held compiled caller pimfep##pimos_tcpip_socket
    % create_socket/9 (@4d-59: `:self(#process,P)`,
    % `:invocation_stack(P,L)`, `:get_first(L,Prog)`, the same sequence
    % through a method).  That the method answers the list object, not a
    % copy, is OURS.
    :invocation_stack(Process, Stack) :- Stack = Process!invocation_stack ;

    % :children(Process, List) -- the list of the process's children.
    % INTERPOLATED (step 3h), as invocation_stack/2, from: the printed
    % slot children_processes, a list, and create_core/3's
    % `:add_child(Self_process, Process)` (TM-100 Fig. 3.1, PDF p8); the
    % held source kappa2 utility/fmp/FMP.ESP:621-625 (`:self(#process,
    % SelfProcess), :children(SelfProcess, ChildrenProcessList), (
    % :empty(ChildrenProcessList), ...`: a list object) and KFILMP.ESP:
    % 202-203; the held compiled callers pimfep##pimos_scsi_front_end
    % local exterminate_child/0 (@50e-51e: `:self(#process,P)`,
    % `:children(P,L)`, `:get_contents(L,Cs)`) and
    % pimmcsp##remote_device_manager exit/1 (@8b-97, the same).  That the
    % method answers the slot's list object is OURS.  add_child/2 was not
    % stood in until step 3k, so the list stayed empty.
    :children(Process, List) :- List = Process!children_processes ;

    % :add_child(Parent, Child) / :remove_child(Parent, Child).
    % INTERPOLATED (step 3k): add_child/2 from its printed call in
    % create_core/3 (`:add_child(Self_process, Process)`, TM-100 Fig. 3.1,
    % PDF p8) and the printed slot children_processes, a list;
    % remove_child/2 from its one held send, pimmcsp##pseudo_pe_process
    % release_core's $or$3/1 @36c-374 (`:remove_child(P!parent_process,
    % P)` in the first clause of a try_me_else whose second clause
    % proceeds, so a failure is tolerated there).  Appending, and
    % removing by identity, are OURS (the list stand-in's add/2 and
    % remove/2).
    :add_child(Parent, Child) :- :add(Parent!children_processes, Child) ;
    % INTERPOLATED (step 3k): see add_child/2 just above.
    :remove_child(Parent, Child) :- :remove(Parent!children_processes, Child) ;

    % :die(Process) -- the process terminates.
    % INTERPOLATED (step 3e) from: the printed as_program:resign/1 (above)
    % and the printed status slot's comment "nil(=dead)" (Fig. 3.1, PDF
    % p8).  Only the status is set: no context, children or resources are
    % released (none is modelled).
    :die(Process) :-
        Process!status := nil ;

    end.
