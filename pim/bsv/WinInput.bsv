// The window input box (H5, docs/simpos/window_hardware_plan.md §3.1-§3.3):
// PS/2 receivers on their clock and data pins, the keyboard's decoder
// (scan code set 2 through the §3.1 table, WinKeyTable.bsv, generated by
// tools/wininput.py) and the mouse's (3-byte packets to an absolute,
// clamped position), merged into one queue of event records.  ALL OURS:
// the PSI's keyboard and mouse hung off its console processor (TM-153
// PDF p23) and nothing of their wire is held.  tools/wininput.py is the
// reference: its header freezes the record format, the tables and the
// error codes, and bsv/run_win_input.sh checks this file against it.
//
// The PS/2 frame (SECONDARY, the IBM PC AT keyboard interface as commonly
// published): the device drives the clock, 10-16.7 kHz; 11 bits, a start
// bit 0, 8 data bits LSB first, odd parity, a stop bit 1; the host samples
// data on the clock's falling edge.  Both lines are open-collector with
// pull-ups, idle high.
//
// Structure (the box pattern):
//   mkWinPs2Rx      the pins in: two-flop synchronizers, a clock filter
//                   (the clock must hold its new level `filt` cycles), the
//                   11 bits, parity and stop checked, a frame cut off when
//                   no clock edge comes for `timeout` cycles
//   mkWinKbdDec     bytes to key records: E0, F0 and Pause's E1 prefixes,
//                   Shift/Ctrl/Alt state, winKey (the §3.1 table)
//   mkWinMouseDec   packets to move and button records
//   mkWinInput      both, a millisecond counter (`msDiv` cycles a ms) for
//                   the records' T, one merged output
//   mkWinPs2Dev     a PS/2 DEVICE model (the benches': it drives the pins
//                   as a keyboard or mouse does, faults on request)
// On the board (US2, one port: plan §3.1, R3) the keyboard receiver takes
// usb_fpga_bd_dp (clock) and usb_fpga_bd_dn (data): INFERENCE, the passive
// USB-PS/2 adapter's usual wiring (D+ clock, D- data), unchecked on this
// board.  A real PS/2 mouse streams only after the host sends it F4
// (enable reporting): host-to-device sending is NOT built, so the mouse
// receiver is exercised in Bluesim only, and the board check is deferred
// with H7 (plan §6).
package WinInput;

import FIFOF::*;
import GetPut::*;
import Vector::*;
import WinKeyTable::*;

typedef struct {
   Bit#(8) kind; Bit#(16) a; Bit#(16) b; Bit#(16) c; Bit#(8) flags; Bit#(16) t;
} WinEvent deriving (Bits, Eq, FShow);

Bit#(8) evJis = 1;
Bit#(8) evName = 2;
Bit#(8) evPf = 3;
Bit#(8) evButton = 4;
Bit#(8) evMove = 5;
Bit#(8) evError = 6;
Bit#(16) errParity = 1;
Bit#(16) errStop = 2;
Bit#(16) errCut = 3;
Bit#(16) errUnmapped = 4;
Bit#(16) errSync = 5;

function WinEvent ev(Bit#(8) k, Bit#(16) a, Bit#(16) b, Bit#(16) c, Bit#(8) f) =
   WinEvent { kind: k, a: a, b: b, c: c, flags: f, t: 0 };

// ---------------------------------------------------------------------
typedef union tagged { Bit#(8) Byte; Bit#(16) Err; } Ps2Rx deriving (Bits);

interface WinPs2Rx;
   (* always_ready, always_enabled *) method Action pins(Bit#(1) clk, Bit#(1) dat);
   interface Get#(Ps2Rx) out;
endinterface

module mkWinPs2Rx#(Integer filt, Integer timeout)(WinPs2Rx);
   Wire#(Bit#(1)) cW <- mkBypassWire;
   Wire#(Bit#(1)) dW <- mkBypassWire;
   Reg#(Bit#(1)) c1 <- mkReg(1);
   Reg#(Bit#(1)) c2 <- mkReg(1);
   Reg#(Bit#(1)) d1 <- mkReg(1);
   Reg#(Bit#(1)) d2 <- mkReg(1);
   Reg#(Bit#(1)) cf <- mkReg(1);            // the filtered clock
   Reg#(UInt#(8)) fc <- mkReg(0);
   Reg#(UInt#(4)) n <- mkReg(0);            // bits taken
   Reg#(Bit#(10)) sh <- mkReg(0);
   Reg#(UInt#(20)) idle <- mkReg(0);
   FIFOF#(Ps2Rx) q <- mkUGSizedFIFOF(8);

   function Action put(Ps2Rx x) = action
      if (q.notFull) q.enq(x);
      else $display("WinPs2Rx: queue full, a byte dropped");
   endaction;

   (* fire_when_enabled, no_implicit_conditions *)
   rule sample;
      c1 <= cW; c2 <= c1; d1 <= dW; d2 <= d1;
      Bool fall = False;
      if (c2 != cf) begin
         if (fc == fromInteger(filt - 1)) begin
            cf <= c2; fc <= 0;
            fall = c2 == 0;
         end
         else fc <= fc + 1;
      end
      else fc <= 0;
      if (fall) begin
         idle <= 0;
         if (n == 10) begin
            // the 11th bit, the stop bit; sh = parity, d7..d0, start
            n <= 0;
            Bit#(8) b = sh[8:1];
            if (d2 != 1) put(tagged Err errStop);
            else if ((reduceXor(b) ^ sh[9]) != 1) put(tagged Err errParity);
            else put(tagged Byte b);
         end
         else begin
            sh <= {d2, sh[9:1]};
            n <= n + 1;
         end
      end
      else if (n != 0) begin
         if (idle == fromInteger(timeout)) begin
            n <= 0; idle <= 0;
            put(tagged Err errCut);
         end
         else idle <= idle + 1;
      end
   endrule

   method Action pins(Bit#(1) clk, Bit#(1) dat);
      cW <= clk; dW <= dat;
   endmethod
   interface Get out;
      method ActionValue#(Ps2Rx) get if (q.notEmpty);
         q.deq;
         return q.first;
      endmethod
   endinterface
endmodule

// ---------------------------------------------------------------------
module mkWinKbdDec#(Get#(Ps2Rx) rx)(Get#(WinEvent));
   FIFOF#(WinEvent) out <- mkFIFOF;
   Reg#(Bool) e0 <- mkReg(False);
   Reg#(Bool) brk <- mkReg(False);
   Reg#(UInt#(3)) e1 <- mkReg(0);
   Reg#(Bit#(2)) shift <- mkReg(0);         // left, right
   Reg#(Bit#(2)) ctrl <- mkReg(0);
   Reg#(Bit#(2)) alt <- mkReg(0);

   rule step;
      let x <- rx.get;
      case (x) matches
         tagged Err .e: begin
            out.enq(ev(evError, e, 0, 0, 0));
            e0 <= False; brk <= False;
         end
         tagged Byte .b: begin
            if (e1 != 0) begin
               e1 <= e1 - 1;
               if (e1 == 6) out.enq(ev(evName, nameAbort, 0, 0, 0));   // E1 14 77: Pause
            end
            else if (b == 'he1) e1 <= 7;
            else if (b == 'he0) e0 <= True;
            else if (b == 'hf0) brk <= True;
            else begin
               e0 <= False; brk <= False;
               WinKeyEntry k = winKey(e0, b);
               Bit#(2) side = e0 ? 2 : 1;
               Bit#(2) sideR = (b == 'h59) ? 2 : 1;     // Shift: 12 left, 59 right
               Bool sh = shift != 0;
               Bit#(8) fl = {6'b0, pack(alt != 0), pack(ctrl != 0)};
               case (k.cls)
                  KShift: shift <= brk ? (shift & ~sideR) : (shift | sideR);
                  KCtrl: ctrl <= brk ? (ctrl & ~side) : (ctrl | side);
                  KAlt: alt <= brk ? (alt & ~side) : (alt | side);
                  KNop: noAction;
                  KNone: out.enq(ev(evError, errUnmapped, zeroExtend(b), 0, e0 ? 1 : 0));
                  default: if (!brk) begin
                     case (k.cls)
                        KChr: begin
                           Bit#(16) j = sh ? k.hi : k.lo;
                           if (ctrl != 0 && (j == jisJ || j == jisJu))
                              out.enq(ev(evName, nameLf, 0, 0, 0));
                           else if (ctrl != 0 && (j == jisG || j == jisGu))
                              out.enq(ev(evName, nameBell, 0, 0, 0));
                           else out.enq(ev(evJis, j, 0, 0, fl));
                        end
                        KName: out.enq(ev(evName, k.lo, 0, 0, 0));
                        KPf: out.enq(ev(evPf, (sh && k.hi != 'hffff) ? k.hi : k.lo, 0, 0, 0));
                     endcase
                  end
               endcase
            end
         end
      endcase
   endrule

   return toGet(out);
endmodule

// ---------------------------------------------------------------------
module mkWinMouseDec#(Get#(Ps2Rx) rx)(Get#(WinEvent));
   FIFOF#(WinEvent) out <- mkSizedFIFOF(4);
   Reg#(Bit#(16)) x <- mkReg(640);
   Reg#(Bit#(16)) y <- mkReg(472);
   Reg#(Bit#(3)) btns <- mkReg(0);
   Reg#(UInt#(2)) n <- mkReg(0);
   Reg#(Bit#(8)) b0 <- mkReg(0);
   Reg#(Bit#(8)) bx <- mkReg(0);
   // a finished packet, then up to three button changes after the move
   Reg#(Bool) pend <- mkReg(False);
   Reg#(UInt#(2)) bi <- mkReg(0);

   function Bit#(16) clamp(Int#(18) v, Integer hi) =
      v < 0 ? 0 : (v > fromInteger(hi) ? fromInteger(hi) : truncate(pack(v)));

   rule step (!pend);
      let r <- rx.get;
      case (r) matches
         tagged Err .e: begin
            out.enq(ev(evError, e, 0, 0, 'h80));
            n <= 0;
         end
         tagged Byte .b: begin
            if (n == 0) begin
               if (b[3] == 0) out.enq(ev(evError, errSync, zeroExtend(b), 0, 'h80));
               else begin b0 <= b; n <= 1; end
            end
            else if (n == 1) begin bx <= b; n <= 2; end
            else begin
               n <= 0;
               Int#(18) dx = unpack(signExtend({b0[4], bx}));
               Int#(18) dy = unpack(signExtend({b0[5], b}));
               Int#(18) nx = unpack(zeroExtend(x)) + dx;
               Int#(18) ny = unpack(zeroExtend(y)) - dy;     // PS/2's Y counts up
               Bit#(16) cx = clamp(nx, 1279);
               Bit#(16) cy = clamp(ny, 1023);
               x <= cx; y <= cy;
               if (dx != 0 || dy != 0) out.enq(ev(evMove, 0, cx, cy, 0));
               pend <= True; bi <= 0;
            end
         end
      endcase
   endrule

   rule buttons (pend);
      Bit#(3) nb = b0[2:0];
      if (nb[bi] != btns[bi])
         out.enq(ev(evButton, zeroExtend(pack(bi)), x, y, zeroExtend(nb[bi])));
      if (bi == 2) begin
         pend <= False; btns <= nb;
      end
      else bi <= bi + 1;
   endrule

   return toGet(out);
endmodule

// ---------------------------------------------------------------------
interface WinInput;
   (* always_ready, always_enabled *) method Action kbd(Bit#(1) clk, Bit#(1) dat);
   (* always_ready, always_enabled *) method Action mouse(Bit#(1) clk, Bit#(1) dat);
   interface Get#(WinEvent) events;
endinterface

// filt: the clock filter, cycles; timeout: cycles with no clock edge that
// cut a frame; msDiv: cycles a millisecond.  The board: 25 MHz, a PS/2
// bit 60-100 us (1,500-2,500 cycles), so filt 8 and timeout 25,000 (1 ms,
// ten bit times); msDiv 25,000.
module mkWinInput#(Integer filt, Integer timeout, Integer msDiv)(WinInput);
   WinPs2Rx krx <- mkWinPs2Rx(filt, timeout);
   WinPs2Rx mrx <- mkWinPs2Rx(filt, timeout);
   Get#(WinEvent) kdec <- mkWinKbdDec(krx.out);
   Get#(WinEvent) mdec <- mkWinMouseDec(mrx.out);
   FIFOF#(WinEvent) q <- mkSizedFIFOF(8);
   Reg#(UInt#(20)) div <- mkReg(0);
   Reg#(Bit#(16)) ms <- mkReg(0);

   (* fire_when_enabled, no_implicit_conditions *)
   rule tick;
      if (div == fromInteger(msDiv - 1)) begin div <= 0; ms <= ms + 1; end
      else div <= div + 1;
   endrule
   (* descending_urgency = "fromKbd, fromMouse" *)
   rule fromKbd;
      let e <- kdec.get;
      e.t = ms;
      q.enq(e);
   endrule
   rule fromMouse;
      let e <- mdec.get;
      e.t = ms;
      q.enq(e);
   endrule

   method Action kbd(Bit#(1) clk, Bit#(1) dat) = krx.pins(clk, dat);
   method Action mouse(Bit#(1) clk, Bit#(1) dat) = mrx.pins(clk, dat);
   interface events = toGet(q);
endmodule

// ---------------------------------------------------------------------
// The device model.  A request: the byte, a fault (0 none, 1 parity
// inverted, 2 stop bit 0, 3 cut: the start and 8 data bits, then the
// clock stops high, 4 a one-cycle clock glitch inside bit 3), and a wait in cycles before its first clock edge.
// Each bit: data set, the clock held high `half` cycles, low `half`
// cycles (the host samples at the falling edge), so a bit is 2 x half.
typedef struct { Bit#(8) b; Bit#(4) fault; Bit#(32) delay; } Ps2DevReq deriving (Bits);

interface WinPs2Dev;
   interface Put#(Ps2DevReq) req;
   method Bit#(1) clk;
   method Bit#(1) dat;
   method Bool idle;
endinterface

module mkWinPs2Dev#(Integer half)(WinPs2Dev);
   FIFOF#(Ps2DevReq) q <- mkSizedFIFOF(4);
   Reg#(Bool) busy <- mkReg(False);
   Reg#(Bit#(32)) w <- mkReg(0);
   Reg#(Bit#(11)) sh <- mkReg('1);
   Reg#(Bool) glitch <- mkReg(False);
   Reg#(UInt#(4)) nb <- mkReg(0);            // bits still to send
   Reg#(UInt#(16)) ph <- mkReg(0);
   Reg#(Bit#(1)) c <- mkReg(1);
   Reg#(Bit#(1)) d <- mkReg(1);

   rule load (!busy);
      let r = q.first;
      q.deq;
      Bit#(1) pb = ~reduceXor(r.b) ^ (r.fault == 1 ? 1 : 0);
      Bit#(1) stop = r.fault == 2 ? 0 : 1;
      sh <= {stop, pb, r.b, 1'b0};
      nb <= r.fault == 3 ? 9 : 11;
      glitch <= r.fault == 4;
      w <= r.delay; ph <= 0; busy <= True;
   endrule
   rule run (busy);
      if (w != 0) w <= w - 1;
      else if (nb == 0) begin
         // the line idle a bit time after the frame
         if (ph == fromInteger(2 * half - 1)) begin busy <= False; ph <= 0; end
         else ph <= ph + 1;
         c <= 1; d <= 1;
      end
      else begin
         if (ph == 0) d <= sh[0];
         // fault 4: a one-cycle low glitch on the clock in bit 3's high
         // half (the receiver's filter must ignore it)
         if (glitch && nb == 7 && ph == fromInteger(half / 2)) c <= 0;
         if (glitch && nb == 7 && ph == fromInteger(half / 2 + 1)) c <= 1;
         if (ph == fromInteger(half)) c <= 0;
         if (ph == fromInteger(2 * half - 1)) begin
            c <= 1; ph <= 0; sh <= sh >> 1; nb <= nb - 1;
         end
         else ph <= ph + 1;
      end
   endrule

   interface req = toPut(q);
   method Bit#(1) clk = c;
   method Bit#(1) dat = d;
   method Bool idle = !busy && !q.notEmpty;
endmodule

endpackage
