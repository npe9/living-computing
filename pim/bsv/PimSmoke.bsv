// PimSmoke.bsv -- Bluesim smoke test for one PIM/m processing unit.
//
// Loads the images generated by asm/pimasm.py (generated/*.hex) at
// elaboration, runs the diagnostic program, and checks the result.
//
// The diagnostic is model-derived, not a historical PIM/m program:
// the corpus acquired in docs/ has no PIM/m listing or binary, and
// no KL1-B encoding table.  It exercises the documented mechanisms
// that are implemented: fetch/decode, the 40-bit tagged word, ALU,
// local store, MRB set, pipelined dereference, a two-cycle tag jump,
// an unconditional branch and halt.
//
// Run from bsv/: ./run_smoke.sh

package PimSmoke;

import PimTypes::*;
import PimStages::*;
import PimPU::*;

(* synthesize *)
module mkPimSmoke(Empty);
  LocalStore store <- mkLocalStore("generated/program.hex");
  PimPU pu <- mkPimPU(store);

  Reg#(Bit#(32)) step <- mkReg(0);
  Reg#(Bool) started <- mkReg(False);
  Reg#(Bool) checked <- mkReg(False);
  Reg#(Bool) reported <- mkReg(False);
  Reg#(Bool) ok <- mkReg(True);

  function Action check(String label, Word got, Word want) =
    action
      if (got == want)
        $display("PASS %s = 0x%010x", label, got);
      else
        $display("FAIL %s = 0x%010x, want 0x%010x", label, got, want);
    endaction;

  rule start (!started);
    pu.start();
    started <= True;
  endrule

  rule run (started && !pu.halted() && !pu.error() && step < 10000);
    step <= step + 1;
  endrule

  rule finishRun (started && !checked &&
                  (pu.halted() || pu.error() || step == 10000));
    let allOk = !pu.error() && pu.halted() &&
                pu.readReg(6'd2) == wordInt(42) &&
                pu.readReg(6'd4) == mkWord(tagInt, True, 42) &&
                pu.readReg(6'd5) == mkWord(tagInt, True, 42) &&
                pu.readReg(6'd7) == wordInt(0) &&
                pu.readMem(16'd100) == wordInt(42);
    if (pu.error()) $display("FAIL: decode error (undefined opcode)");
    if (!pu.halted()) $display("FAIL: did not halt within 10000 steps");
    check("a2", pu.readReg(6'd2), wordInt(42));
    check("a4_mrb", pu.readReg(6'd4), mkWord(tagInt, True, 42));
    check("a5", pu.readReg(6'd5), mkWord(tagInt, True, 42));
    check("a7_skipped", pu.readReg(6'd7), wordInt(0));
    check("mem100", pu.readMem(16'd100), wordInt(42));
    $display("steps = %0d, pc = %0d", step, pu.pc());
    ok <= allOk;
    checked <= True;
  endrule

  rule report (checked && !reported);
    if (ok) $display("PimSmoke: PASS");
    else    $display("PimSmoke: FAIL");
    reported <= True;
    $finish;
  endrule
endmodule

endpackage
