# pim_decode_error_bug.sby -- same check with the errorSeen latch
# replaced by False, so the undefined opcode is swallowed.  Expected:
# FAIL with a VCD witness.
# Paths in [files] resolve against the sby process cwd, the repository
# root (pim/); run `sby -f bsv/formal/pim_decode_error_bug.sby` from there.
[options]
mode bmc
depth 80
vcd on

[engines]
smtbmc yices

[script]
read_verilog -formal -sv pim_decode_error_formal.v mkPimPUFormal.v RegFileLoad.v
prep -top pim_decode_error_formal

[files]
pim_decode_error_formal.v bsv/formal/pim_decode_error_formal.v
mkPimPUFormal.v bsv/formal/build/decode_bug/mkPimPUFormal.v
RegFileLoad.v bsv/RegFileLoad.v
generated/decode.hex bsv/formal/formal_images/decode_error_decode.hex
generated/jump.hex bsv/formal/formal_images/decode_error_jump.hex
generated/program.hex bsv/formal/formal_images/decode_error_program.hex
generated/wcs.hex bsv/formal/formal_images/decode_error_wcs.hex
