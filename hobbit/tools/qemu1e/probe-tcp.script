# qemu1e.py script: serve the kfs on QEMU user networking (slirp,
# guest 10.0.2.15) and probe it from the host with p9probe.py through a
# hostfwd of tcp 564.  Run from build/qemu by probe-tcp.sh.
wait boot from 30
type \n
wait root is from 60
type \n
wait user 60
type glenda\n
wait password 10
type password\n
wait ^% 60
type rc /serve 10.0.2.15 255.255.255.0\n
wait ^serving 120
screen
host python3 ../../tools/qemu1e/p9probe.py 127.0.0.1 ${P9PORT:-5640} ${P9TAR:-/tmp/p9/plan9-1e.tar.bz2} --walk release.list lib/ndb/local hobbit/s9term 386/9pc rc/bin/termrc sys/lib/troff/font/devpost/Hb sys/lib/troff/font/devpost/HB sys/src/cda/lde/main.c sys/src/cda/LDE/main.c adm/mkext.log
screen
