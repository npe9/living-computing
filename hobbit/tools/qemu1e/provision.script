# qemu1e.py script: boot the floppy system and run /kfsinit on it.
# b.com's prompt; the default is fd!0!9dos
wait boot from 30
type \n
# 9dos's boot program; the default is local!#f/fd0disk (dossrv)
wait root is from 60
type \n
wait user 60
type glenda\n
wait password 10
type password\n
wait ^% 60
type rc /kfsinit\n
wait kfsinit done 7200
screen
