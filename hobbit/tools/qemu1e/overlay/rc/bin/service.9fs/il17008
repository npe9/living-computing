#!/bin/rc
# qemu1e addition (not in the 1e release): serve the kfs as a terminal's
# root on il!*!17008 (lib/ndb/local: il=9fs port=17008), which is what a
# terminal's boot program dials (sys/src/9/boot/ip.c connectil).
# Run by aux/listen as a trusted service (-t), in the listener's name
# space, where /n/kfs is the kfs.  exportfs -s serves its / with no
# tree-name preamble and answers Tnop/Tsession (exportfs/exportsrv.c).
# listen dups the connection onto fd 2 as well: stderr goes to a file
# in the kfs's /adm (its /tmp is mode 555), not into the 9P stream.
# Everything is bound inside the kfs first: once / is replaced,
# rc finds commands (bind too) only in the kfs's own /bin.
# The network's names (fs9, cpu9, $auth) for the machines whose root
# this is: the release's /lib/ndb/local plus tools/qemu1e/ndb.local,
# made by floppies.sh as the floppy's /lib/ndb/served.  The kfs's own
# file stays the release's.
bind /lib/ndb/served /n/kfs/lib/ndb/local
bind /n/kfs/386/bin /n/kfs/bin
bind -a /n/kfs/rc/bin /n/kfs/bin
bind '#c' /n/kfs/dev
bind /n/kfs /
exec /bin/exportfs -s >[2] /adm/il17008.err
