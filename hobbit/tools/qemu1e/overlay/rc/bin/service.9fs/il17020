#!/bin/rc
# qemu1e addition: the release's /rc/bin/service.auth/il17020 (#!/bin/aux/fsauth),
# the fsauth authentication service (auth(6); sys/src/auth/fsauth.srv.c), with
# the kfs's path: this listener's /bin is the floppy's.  It reads the
# keys from keyfs on /mnt/keys, started by /serve.
exec /n/kfs/386/bin/aux/fsauth
