#!/bin/rc
# qemu1e addition: the release's /rc/bin/service.auth/il17023 (#!/bin/aux/chal),
# the chal authentication service (auth(6); sys/src/auth/chal.srv.c), with
# the kfs's path: this listener's /bin is the floppy's.  It reads the
# keys from keyfs on /mnt/keys, started by /serve.
exec /n/kfs/386/bin/aux/chal
