# glenda's lib/profile, copied into /usr/glenda/lib by /authinit
# (tools/qemu1e/authinit.rc; docs/qemu_1e_server.md 5d).
# By default it does nothing, so a log-in ends at rc on the console
# (net_test.py, il_term_test.py, p9join.py --hub wait for `% ` there).
# When $home/lib/8half exists, a terminal runs 8½ as the release's
# /usr/tor/lib/profile does: tor's binds, font and prompt, and his
# bin/rc/8½start's window, given to -i directly (8½ main.c runs it
# with rc -c).
if(~ $service terminal && test -f $home/lib/8half){
	bind -c $home/tmp /tmp
	bind -a $home/bin/rc /bin
	bind -a $home/bin/$cputype /bin
	font = /lib/font/bit/pelm/euro.9.font
	prompt=('term% ' '	')
	fn term%{ $* }
	exec 8½ -i 'window ''0 0 785 602'' rc' -s -f $font
}
