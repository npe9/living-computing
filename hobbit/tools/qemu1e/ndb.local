
#
# qemu1e additions (appended to the distribution floppy's /lib/ndb/local
# by build.sh).  The network is private to QEMU: a dgram netdev between
# the server and a terminal (docs/qemu_1e_server.md).  ip/bootp answers
# only machines listed here with an ether= and a bootf= (bootp.c main,
# lookup); its reply's vendor field is "p9  ipmask fs auth ipgw"
# (bootp.c doreply), which is what /boot reads (boot/ip.c ipconfig).
#
# 10/8 is class A: ipinfo (sys/src/libndb/ipinfo.c) first looks up the
# class network, ip=10.0.0.0, for an ipmask, then the subnet that mask
# gives for fs=, auth=, ipgw=.
ip=10.0.0.0 ipmask=255.255.255.0
ip=10.9.0.0 ipmask=255.255.255.0
	fs=fs9 auth=fs9 ipgw=fs9

# the server: QEMU's default NE2000 address
sys=fs9
	dom=fs9.qemu1e
	ip=10.9.0.1 ether=525400123456
	proto=il

# the Hobbit terminal (s9term on the Bluespec model).  The ether address
# is a placeholder until the model's SONIC address is fixed.
sys=hobbit
	dom=hobbit.qemu1e
	ip=10.9.0.2 ether=525400000b0b
	bootf=/hobbit/s9term
	proto=il

# a second QEMU running the shipped 9pc as a terminal (the test client)
sys=term386
	dom=term386.qemu1e
	ip=10.9.0.3 ether=525400123457
	bootf=/386/9pc
	proto=il

# the CPU server: 9pccpu, built in the guest (cpukernel.sh); its key
# is in fs9's /adm/keys as the host cpu9 (authinit.rc).  ip/bootp
# answers only an entry with a bootf=; a CPU server's /boot does not
# load it (boot.c: newkernel() only when cpuflag == 0).
sys=cpu9
	dom=cpu9.qemu1e
	ip=10.9.0.4 ether=525400123458
	bootf=/386/9pccpu
	proto=il
