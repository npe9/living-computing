        B,   I60116             ! -BELOW LB.
I60114 BDFZ, I60115
        LX,  $X15, 3.0           ! -LB COMP FAILED. FETCH FROM LB-1
        SIC, SEN                 ! -FAILS TO SET DF. IX 15 CONTAINS
        B,   SERS                ! -LOCN 3.0 AT TIME OF FITCH.
        B,   $+1.0
        BD,  I60111
        SIC, SEN0+.32
        B,   SSW                 ! -TO SSIP
        BD,  I60122
I60115 Z,   $X13                ! -CLR INT 2.
        SV,  $X13, I60AD2
I60116 LVI, $X13, I60117
        SVA, $X13, I60107
        LVI, $X3, I60119
        SVA, $X3, I6010A
        BDFZ, $+.32
        Z,   $MASK
        Z,   $IND
        SR,  $X1, $IA
        TI,  1, BOUND0, 3.0
        V+I, $X2, 2.0
        BE,  $+.32
        LX,  $X13, 0($X2)        ! -FETCH FRM LB+1, UB-1, BC IS 0.
        BD,  $+.32
        SV,  $X1, $IA
        BD,  I60119
I60117 SV,  $X1, $IA
        LV,  $X13, I60AD3       ! -DID WE INTRPT LAST TIME THRU.
        BXVZ, I60118
        LX,  $X15, 3.0
        SIC, SEN                 ! -INTERRUPTED TWICE ON A FETCH BETWEEN
        B,   SERS                ! -UB AND LB, IX 15 CONTAINS CONTENTS OF
        B,   I60122             ! -LOCN 3.0 AT TIME OF FETCH.
I60118 V+I, $X13, (8)777777.40
