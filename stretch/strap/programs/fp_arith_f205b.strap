        BZB, $SB+.4, $+2.   ! is sign bit equal 0
        SIC, SEN
        B, SERS
        B, $+.32   ! F205B5: MS+ACS+A+0,N+1
        L(U), FPK19
        -MG(U), FPK4
        CT0110(BU,60), FPK4, 68   ! check no. in acc
        SIC, SEN
        BRGZ, SERS
        BZB, $SB+.4, $+2.   ! is sign bit equal 0
        SIC, SEN
        B, SERS
        B, $+.32   ! F205B6: MS+ACS+A+0,N+1
        L(U), FPK4
        -MG(U), FPK19
        CT0110(BU,60), FPK29, 68   ! check no. in acc
        SIC, SEN
        BRGZ, SERS
        BZB, $SB+.4, $+2.   ! is sign bit equal 0
        SIC, SEN
        B, SERS
        B, $+.32   ! F205B7: MS+ACS+0,N+A+1
        L(U), FPK19
        -MGA(U), FPK4
        CT0110(BU,60), FPK4, 68   ! check no. in acc
        SIC, SEN
        BRGZ, SERS
        BZB, $SB+.4, $+2.   ! is sign bit equal 0
        SIC, SEN
        B, SERS
                                ! F205B8: MS+ACS+0,N+A+1 (no separator in the listing)
        L(U), FPK4
        -MGA(U), FPK19
        CT0110(BU,60), FPK29, 68   ! check no. in acc
        SIC, SEN
        BRGZ, SERS
        BZB, $SB+.4, $+2.   ! is sign bit equal 0
        SIC, SEN
        B, SERS
        B, $+.32   ! F205B9: MS+N+A+0,ACS+1
        LN(U), FPK19
        +MG(U), FPK4
        CT0110(BU,60), FPK22, 68   ! check no. in acc
        SIC, SEN
        BRGZ, SERS
        BB, $SB+.4, $+2.   ! is sign bit equal 1
        SIC, SEN
        B, SERS
        B, $+.32   ! F205B10: MS+N+A+0,ACS+1
