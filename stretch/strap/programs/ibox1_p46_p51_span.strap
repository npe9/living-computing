        B,$                  ! -ALL 1 S
IBR158  VF,(8)777777.70      ! -EQUALS NOP,-.32
        VF,(8)777777.70      ! -EQUALS NOP,-.32
IBR159  LX,$X1,IBRA21        ! -SET UP XW
IBR160  CBRZ-,$X1,IBR168     ! -COUNT 6 TO 5, NO B OR REF.
