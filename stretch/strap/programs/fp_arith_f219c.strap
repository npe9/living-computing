! jb_af1c F219 "NOISY MODE TEST ROUTINE", sub-blocks P3 through S,
! p.172 (octal 021575.00-021636.00): add double with equal exponents,
! add double to magnitude, load double and load double with flag.
!
! F219B carried K through P2 and stopped at 021574.40.  Noisy mode is
! still on -- the routine sets it once, back in F219A -- so this
! program re-establishes it one word before the block starts, and
! every address from 021575.00 matches the listing column.
!
! WHERE THE NOISY ONES ACTUALLY SHOW.  F219B's blocks were mostly the
! NEGATIVE half of the rule: multiply and divide and store root want
! the clean answer, because the positions noisy mode fills lie below
! the 48 bits the result keeps.  P3 through S are the positive half.
! Every one of them is a DOUBLE-precision operation whose low 48 bits
! are a real part of the answer and are checked by their own CT, so
! the ones that normalization shifts in are visible -- and in two of
! these blocks they are the ENTIRE content of the low half.
!
! F219P3  ADD DOUBLE, exponents equal.  FPK5 loaded double
!         unnormalized with FPK32's fraction written into the low half
!         by the C0011, plus FPK39 at the same exponent.  Both halves
!         are checked against FPK32's fraction.
!
! F219Q1  ADD DOUBLE TO MAGNITUDE, the same shape as F219P1 and the
!         same expected pair (FPK99 high, FPK32 low): with both
!         operands positive, +MG must give what + gave.  That is the
!         point -- it is checking that the magnitude modifier does not
!         disturb a case where it has nothing to do.
!
! F219Q2  ADD DOUBLE TO MAGNITUDE, exponents UNEQUAL, and the sharpest
!         noisy test in the block.  The accumulator is FPK16 at +19
!         with FK125's fraction in its low half; the memory operand is
!         FPK18 at +6, so the alignment shift is 13.  The 96-bit sum
!         comes out 0x00007ffffffffffffffffffff -- thirteen leading
!         zeros -- and normalizing it left thirteen gives
!         0xffffffffffff_ffffffffe000.  The expected low half is
!         FPK32's 0xffffffffffff, so the last THIRTEEN bits of the
!         answer are noisy-mode ones and nothing else.  This block
!         also checks the exponent field on its own, twelve bits at
!         offset 116 against FK2, which carries +6.
!
! F219R1  LOAD DOUBLE with between 0 and 48 leading zeros.  FPK16's
!         fraction has NINETEEN leading zeros; normalized it becomes
!         FPK17's 0xaaaaaaa80000 at exponent 0, and the low half --
!         which LOAD DOUBLE sets to zero before normalizing -- ends up
!         0x00000007ffff, which is nineteen ones.  FK128 is that
!         constant, and it exists in the pool for no other purpose.
!
! F219R2  LOAD DOUBLE of FPK31, whose fraction is zero.  "If the
!         96-bit intermediate sum has a zero fraction, normalization,
!         if specified, will be suppressed" -- so nothing shifts, no
!         ones enter, and both halves come back as FPK31 gave them.
!         The negative case sitting immediately beside R1's positive
!         one, which is how this diagnostic prefers to make a point.
!
! F219S   LOAD DOUBLE WITH FLAG.  FPK56 = +0.29cbb829cbb9 at +4 with
!         all three flag bits set; two leading zeros, so the answer is
!         FPK76's 0xa72ee0a72ee4 at +2 with a low half of
!         0x000000000003 -- the two noisy ones -- which is FPK58's
!         fraction.  The high-half CT covers sixty bits from offset
!         68, IBM 0-59, which stops short of the flag byte, so DLWF's
!         keeping of FPK56's flags does not disturb it.

! -- SSIP framework substitutes: SERS (octal 1304) -> FAIL halt,
! -- SEN (octal 1310) -> scratch.
        SLC, (8)1304.0
SERS    BEW, $
        SLC, (8)1310.0
SEN     DD(BU,64,8), 0

! -- constants (pools pp.176-179) --
        SLC, (8)22012.0
FPK5    DD(BU,64,8), (8)0001025252525252525240
        SLC, (8)22025.0
FPK16   DD(BU,64,8), (8)0011400000052525252520
FPK17   DD(BU,64,8), (8)0000125252525240000000
FPK18   DD(BU,64,8), (8)0003176525252525252520
        SLC, (8)22044.0
FPK31   DD(BU,64,8), (8)0031000000000000000000
FPK32   DD(BU,64,8), (8)0001177777777777777760
        SLC, (8)22050.0
FPK35   DD(BU,64,8), (8)0001125252525252525240
        SLC, (8)22053.0
FPK38   DD(BU,64,8), (8)0031052525252525252520
FPK39   DD(BU,64,8), (8)0001052525252525252520
        SLC, (8)22075.0
FPK56   DD(BU,64,8), (8)0002024713560247135627
        SLC, (8)22077.0
FPK58   DD(BU,64,8), (8)0000400000000000000070
        SLC, (8)22117.0
FPK76   DD(BU,64,8), (8)0001123456701234567100
        SLC, (8)22140.0
        DD(BU,64,8), (8)0030525252525252525320
FPK99   DD(BU,64,8), (8)0000525252525252525260
        SLC, (8)22144.0
FK2     DD(BU,64,8), (8)0003052535777777777760
        SLC, (8)22336.0
FK125   DD(BU,64,8), (8)0003052527777777777760
        SLC, (8)22342.0
FK128   DD(BU,64,8), (8)0000000000000037777760

! One word before the block, so F219P3's first instruction lands on
! 021575.00 exactly: F219 sets noisy mode once, in F219A, and this
! program has to re-establish it.
        SLC, (8)21574.0
SAP25   BB1, $NM, $+1.0
! -- ADD DOUBLE CHECK, continued --
! F219P3 - exp mem + exp acc
        DL(U), FPK5
        C0011(BU,48), FPK32+.12, 20          ! set the accumulator's low half
        D+(N), FPK39
        CT0110(BU,48), FPK32+.12, 68         ! high half
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20         ! low half
        SIC, SEN
        BRGZ, SERS
! -- ADD DOUBLE TO MAGNITUDE CHECK --
! F219Q1 - exp mem + exp acc + +48
        DL(U), FPK38
        C0011(BU,48), FPK38+.12, 20
        D+MG(N), FPK35
        CT0110(BU,48), FPK99+.12, 68         ! high half
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20         ! low half
        SIC, SEN
        BRGZ, SERS
! F219Q2 - exp mem unequal to exp acc
        DL(U), FPK16
        C0011(BU,48), FK125+.12, 20
        D+MG(N), FPK18
        CT0110(BU,12), FK2, 116              ! the exponent field on its own
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 68         ! high half
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20         ! low half: thirteen noisy ones
        SIC, SEN
        BRGZ, SERS
! -- LOAD DOUBLE CHECK --
! F219R1 - 0 < leading 0 s < 48
        DL(N), FPK16
        CT0110(BU,60), FPK17, 68
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK128+.12, 20         ! low half: nineteen noisy ones
        SIC, SEN
        BRGZ, SERS
! F219R2 - 48 leading 0 s: a zero fraction is not normalized
        DL(N), FPK31
        CT0110(BU,60), FPK31, 68
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK31+.12, 20
        SIC, SEN
        BRGZ, SERS
! -- LOAD DOUBLE WITH FLAG CHECK --
! F219S - 0 < leading 0 s < 48
        DLWF(N), FPK56
        CT0110(BU,60), FPK76, 68
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK58+.12, 20         ! low half: two noisy ones
        SIC, SEN
        BRGZ, SERS
! F219S does not end with its two CTs.  The next page opens with three
! more checks that belong to it: DLWF takes the operand's flag bits
! into the sign byte AND sets the data-flag indicators TF, UF and VF,
! and those three are what the CTs cannot see -- both CT windows (IBM
! 0-59 and 60-107) stop short of the flag byte.  Transcribing only to
! the bottom of p.172 would have left DLWF's whole difference from DL
! untested here, which an injection confirmed before these lines were
! added: dropping the operand's flags changed nothing the block could
! see.  FPK56 carries all three flag bits, so all three must be on.
        SIC, SEN
        BZTF, SERS                           ! error if data flag inds. off
        SIC, SEN
        BZUF, SERS
        SIC, SEN
        BZVF, SERS
PASS    BEW, $
        END, SAP25
