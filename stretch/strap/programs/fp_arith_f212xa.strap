! jb_af1c F212-X "ADD TO FRACTION ROUTINE", sub-block F212XA
! "ARITHMETIC CHECKS", pp.122-123 (octal 016651.00-016740.00, the
! block's own exit "BD,$+1.0"), transcribed verbatim.  This is the
! first program to exercise F+, which the model did not implement.
!
! F+ (Reference Manual p.101): "The operation is the same as ADD
! DOUBLE except that the exponent of the operand in the accumulator is
! used for both the addressed operand and the operand in the
! accumulator... When the accumulator operand is a value in the XFP or
! XFN range, the fraction addition is not performed."
!
! Every sub-test builds a 96-bit accumulator the same way -- DL(U)
! loads the high half and the sign byte, then C0011(BU,48) writes the
! low half -- runs one F+(U), and compares both halves.
!
! The nine sub-tests split into two groups by what the ACCUMULATOR is:
!
!   NO ADDITION (a flagged accumulator; the result must be exactly the
!   accumulator that went in, and the addressed operand's own exponent
!   -- whatever range it is in -- is discarded without effect):
!     XA1  acc FK23 (XFP +2047) + FK24 (XFP +1791)   "XFP RNG"
!     XA2  acc FK23 (XFP +2047) + FK38 (N   +1023)   "XFP + N RNGS"
!     XA3  acc FK23 (XFP +2047) + FPK2 (XFN -2047)   "XFP + XFN RNGS"
!     XA7  acc FK25 (XFN -1791) + FK21 (XFP +2047)   "XFN + XFP RNGS"
!     XA8  acc FK25 (XFN -1791) + FK37 (N   +959)    "XFN + N RNGS"
!     XA9  acc FK49 (XFN -1024) + FK50 (XFN -1997)   "XFN RNG"
!
!   ADDITION PERFORMED (an unflagged accumulator).  XA4 is the one
!   that pins the rule down: the OPERAND is XFP, so a model that
!   tested the ranges before substituting the exponent would skip the
!   addition here and fail.
!     XA4  acc FPK35 (N +2, aaaaaaaaaaaa / low ffffffffffff)
!          + FK24  (XFP +1791, 555555555555)
!          -> aaa..+555.. = ffffffffffff high, ffffffffffff low, exp +2
!     XA5  the same sum with FPK38 (N +50, 555555555555) as the
!          operand -- the operand's exponent is discarded either way
!     XA6  acc FPK34 (N +2, 000000000001 / low ffffffffffff)
!          + FPK2  (XFN -2047, ffffffffffff)
!          -> the 96-bit sum 000000000001_ffffffffffff
!                          + ffffffffffff_000000000000
!             is 1_000000000000_ffffffffffff: the carry leaves the
!             fraction and is LOST.  The listing demands high
!             000000000000 (FPK67), low ffffffffffff (FPK32), an
!             UNCHANGED exponent of +2, and "BZLC,SERS -- ERROR IF LC
!             INDICATOR OFF".  This is the only LC row in F212XA.
!
! All nine expected results were computed from the pool constants and
! checked against the listing's own comparison operands before running.
!
! TRANSCRIPTION NOTE: XA2's comment reads "-EXP++50", but the operand
! it writes is FK38 at 022210, whose exponent is +1023; FPK38 at
! 022053 is the constant with +50, and it is XA5 that uses it.  The
! range annotation over XA2 ("XFP + N RNGS") is correct and FK38 is in
! the N range, so only the "+50" is loose.  It cannot change the
! expected result either way: XA2's accumulator is XFP, so no addition
! happens and the operand's exponent is discarded.  Transcribed as
! printed.

! -- SSIP framework substitutes: SERS (octal 1304) -> FAIL halt,
! -- SEN (octal 1310) -> scratch.
        SLC, (8)1304.0
SERS    BEW, $
        SLC, (8)1310.0
SEN     DD(BU,64,8), 0

! -- constants (pools pp.176-178) --
        SLC, (8)22007.0
FPK2    DD(BU,64,8), (8)1777777777777777777760
        SLC, (8)22045.0
FPK32   DD(BU,64,8), (8)0001177777777777777760
        SLC, (8)22047.0
FPK34   DD(BU,64,8), (8)0001000000000000000020
FPK35   DD(BU,64,8), (8)0001125252525252525240
        SLC, (8)22053.0
FPK38   DD(BU,64,8), (8)0031052525252525252520
        SLC, (8)22107.0
FPK67   DD(BU,64,8), (8)0001000000000000000000
        SLC, (8)22167.0
FK21    DD(BU,64,8), (8)1777403777777777777760
FK22    DD(BU,64,8), (8)0400177777777777777760
FK23    DD(BU,64,8), (8)1777525252525252525240
FK24    DD(BU,64,8), (8)1577452525252525252520
FK25    DD(BU,64,8), (8)1577777777777777777760
        SLC, (8)22207.0
FK37    DD(BU,64,8), (8)0737577777777777777760
FK38    DD(BU,64,8), (8)0777572525252525252520
        SLC, (8)22223.0
FK49    DD(BU,64,8), (8)1000377777777777777760
FK50    DD(BU,64,8), (8)1746777777777777777760

        SLC, (8)16651.0
SAP14   DL(U), FK23                          ! F212XA1 - exps in XFP rng
        C0011(BU,48), FK22+.12, 20           ! set the accumulator's low half
        F+(U), FK24                          ! exp ++1791
        CT0110(BU,60), FK23, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK22+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FK23                          ! F212XA2 - exps in XFP + N rngs
        C0011(BU,48), FK22+.12, 20
        F+(U), FK38                          ! exp ++50 (see note: FK38 is +1023)
        CT0110(BU,60), FK23, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK22+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FK23                          ! F212XA3 - exps in XFP + XFN rngs
        C0011(BU,48), FK22+.12, 20
        F+(U), FPK2                          ! exp +-2047
        CT0110(BU,60), FK23, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK22+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FPK35                         ! F212XA4 - exps in N + XFP rngs
        C0011(BU,48), FPK32+.12, 20
        F+(U), FK24                          ! exp ++1791
        CT0110(BU,60), FPK32, 68             ! result exp + +2, fract + 1-s
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FPK35                         ! F212XA5 - exps in N rng
        C0011(BU,48), FPK32+.12, 20
        F+(U), FPK38                         ! exp ++50
        CT0110(BU,60), FPK32, 68             ! result exp.++2, fract+1-s
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FPK34                         ! F212XA6 - exps in N + XFN rngs
        C0011(BU,48), FPK32+.12, 20
        F+(U), FPK2                          ! exp +-2047
        CT0110(BU,60), FPK67, 68             ! high order result fract+0-s, exp++2
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FPK32+.12, 20         ! low order fract+1-s
        SIC, SEN
        BRGZ, SERS
        SIC, SEN
        BZLC, SERS                           ! error if LC indicator off
        DL(U), FK25                          ! F212XA7 - exps in XFN + XFP rngs
        C0011(BU,48), FK25+.12, 20
        F+(U), FK21                          ! exp ++2047
        CT0110(BU,60), FK25, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK25+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FK25                          ! F212XA8 - exps in XFN + N rngs
        C0011(BU,48), FK25+.12, 20
        F+(U), FK37                          ! exp +959
        CT0110(BU,60), FK25, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK25+.12, 20
        SIC, SEN
        BRGZ, SERS
        DL(U), FK49                          ! F212XA9 - exps in XFN rng
        C0011(BU,48), FK49+.12, 20
        F+(U), FK50                          ! exp +-1997
        CT0110(BU,60), FK49, 68              ! result + opnd originally in acc.
        SIC, SEN
        BRGZ, SERS
        CT0110(BU,48), FK49+.12, 20
        SIC, SEN
        BRGZ, SERS
PASS    BEW, $                               ! 016740.00: the block's exit "BD,$+1.0"
        END, SAP14
