BIT62   XW,0,0,2
BIT63   XW,0,0,1
!
! ====================================================================
! PDF p.116: the deck's SYN table, then its END.  No storage, no
! locations -- the listing prints each one's VALUE instead
! ("1301.00+  +00000000").  Transcribed from the SOURCE column; the
! VALUE column is the check (see the verify script's SYMBOLS).
! ====================================================================
SSW     SYN,(8)1301.0       ! 1301.00+
ERS     SYN,(8)1302.0       ! 1302.00+
SERS    SYN,(8)1304.0       ! 1304.00+
RET     SYN,(8)1306.40      ! 1306.40+   a BIT address
RET1    SYN,(8)1307.0       ! 1307.00+
RET2    SYN,(8)1307.40      ! 1307.40+
SEN     SYN,(8)1310.0       ! 1310.00+
SEN0    SYN,(8)1311.0       ! 1311.00+   SENO on p.114 aliases THIS
DPET13  SYN,(8)1437.0       ! 1437.00+
INT     SYN,(8)1353.0       ! 1353.00+
IDF1    SYN,(8)1443.0       ! 1443.00+
IDF2    SYN,(8)1444.40      ! 1444.40+
        END,(8)14000.0      ! prints "14000.00" at 024622.00
