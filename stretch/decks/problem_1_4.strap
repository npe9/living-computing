        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7

        END, START
