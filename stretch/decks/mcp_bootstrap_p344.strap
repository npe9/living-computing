        SIC,AOCTLB                                           ! line 31
        B,AOCTLC                                             ! line 32
        SF(BU,24)(V+I),.56($14)                              ! line 33
        LFI(BU,16),(8)033023                                 ! line 34  -FT
        SF(BU,16)(V+I),.24($14)                              ! line 35
        LVI,$1,ABUFF+14.                                     ! line 36
        SIC,AFTRMB                                           ! line 37
        B,AFTRMT                                             ! line 38
        SIC,AWRITB                                           ! line 39
