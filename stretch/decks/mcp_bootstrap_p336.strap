! mcp_bootstrap_p336.strap -- MCP printed page 336: the debugger's
! set-instruction-counter request (PSC .. PSC1: convert the key address,
! insert it in the SIC word, log it) and PH, the HOLD-light routine,
! lines 1-46.
!
! docs/MCP_Mar63_250-445.pdf PDF p.86, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$DUMP  CARD ID VA000053  DIST. OF 3/01
!  3/01  PAGE NUMBER 336"; the heading row's LOCATION field is BLANK
! (line 1 is a banner remark).
!
! THE PAGE.  46 lines, every line number prints a "*" after it.  Lines
! 1-2, 5, 16, 18, 20, 26, 34-36, 41 are remark cards.  Located rows run
! contiguous from 234456.40 (line 3) to 234506.40 (line 46, B, a half
! word; next location 234507.00), then blank paper.  "*" after the
! LOCATION on lines 15 and 33.  No TAIL card.
!
! JOIN.  p.335 (no deck; tools/page_sheet.py 335) ends with B,PE4 at
! 234456.00 (a half word): contiguous with line 3.  p.337 (sheet) opens
! P DKL at 234507.00: contiguous with line 46.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * line 3 "SIC,PA02": the third glyph prints open.  Written PA02,
!     digit zero: C22-6728-1 PDF p.221 Table 8 (PA1 "Requestor from
!     PA02.") sets it as a narrow oval, the width of the 2, not a round
!     letter O; the original C22-6728 PDF p.210 sets the same narrow
!     glyph (its OCR reads "PAO2"; the -1 OCR reads "PA02").  The same
!     table names PA1, PSC, PSC3, SICBU and PH.  No landed deck spells it.
!   * "PCNOUT" (lines 10, 37, 40) = PONOUT: lines 7, 12, 24, 25, 38
!     print it with closed O's; landed p.293 line 42 defines PONOUT.
!   * line 6 "SIC BU" = SICBU (blanks ignored; landed p.116 VF).
!   * line 21 "POAS" = POAS (landed p.292 line 15 SYN,2.11).
!   * line 29 ", P C CEF2" = PCDEF2 (D with its stem worn; line 44
!     prints DEF2 plainly; binary 000012.00 = PCDEF2 10.0).
!   * line 45 ",PChW5" = PCW5 (binary 232650.00 = p.293 line 48).
!   * line 31 hex "CE" = 0E: B,1.0($14)'s I field is 14 and the byte's
!     high nibble is 0 as on line 46, which prints "0E" plainly.
!   * octal / hex fields with an open round read 0 throughout.
!
! EXTERNALS.  From landed decks (forms copied), except PA02 and PA1
! (not landed; values from this page's binary).
!
! CARD SERIALS.  VA000053 .. VA000097.  Lines 3 and 4 BOTH print
! VA000055, so line N prints VA0000(52+N) through line 3 and
! VA0000(51+N) from line 4 to line 46 (VA000097).

DMCP    SYN, 32.0                    ! landed p.108 "D MCP SYN,32.0"; B lines 27, 42 000040.10
DWS     SYN, 1.33                    ! landed p.104; ,DWS lines 28, 43 000001.41
PCDEF2  SYN, 10.0                    ! landed p.137; ,PCDEF2 lines 29, 44 000012.00
SICBU   SYN, (8)215361.0             ! landed (p.116 VF); ST line 6 215361.00
SLRBU   SYN, (8)215324.0             ! landed p.116 line 21; Z line 8 215334.22
POAS    SYN,2.11                     ! landed p.292 line 15, as defined there
PHOLDS  SYN,2.16                     ! landed p.292 line 20, as defined there; CM1111 line 38 232632.20
PSETIC  SYN(BU,64,8), (8)232607.0    ! landed p.293 line 35 DD(BU,64,8); LX line 9 232607.04
PNSLIN  SYN(BU,64), (8)232613.0      ! landed p.293 line 41 DRZ(BU,64),(13); LX line 39 232613.04
PONOUT  SYN(BU,64), (8)232630.0      ! landed p.293 line 42 DRZ(BU,64),(13); SX line 40 232630.05
PCW4    SYN, (8)232647.0             ! landed p.293 line 47 CW; ,PCW4 line 30 232647.00
PCW5    SYN, (8)232650.0             ! landed p.293 line 48 CW; ,PCW5 line 45 232650.00
PA02    SYN, (8)234677.40            ! not landed; SIC line 3 234677.40, BIT-EXACT
PA1     SYN, (8)234666.0             ! not landed; B line 4 234666.10, half word only

        SLC, (8)234456.40
! line  1  - ---------------------------------------------------------
! line  2  -           -SET INSTRUCTION COUNTER
PSC     SIC,PA02                                             ! line  3
        B,PA1                                                ! line  4  -OBTAIN NEW BINARY ADDRESS IN ADDRESS PORTION
! line  5  -OF $R. $L=0.
        ST(BU,24),SICBU,40                                   ! line  6  -NO INSERT IC FOR MAINSTREAM RETURN
        ST(BU,24),PONOUT+6.0,40                              ! line  7
        Z,SLRBU+8.0                                          ! line  8
        LX,$2,PSETIC                                         ! line  9  -SET UP NMEMONIC SET IC
PSC3    SX,$2,PONOUT+3.0                                     ! line 10
        L(BU,32),PNSLIN+1.0,0                                ! line 11
        ST(BU,32),PONOUT+1.0                                 ! line 12  -LFT NUMERIC SWITCHES
PSC5    LVI,$2,49152.                                        ! line 13  -2 14 + 2 15
        SV,$2,10.0                                           ! line 14  -SET ZERO BITS = 0011
        ST(DU,48,8),$L,8                                     ! line 15  -EXPAND 1ST 6 4 BIT DEC CHARACTERS TO
! line 16                    -8 BIT BYTES WITH ZERO BITS = 001
        CI0011(BU,8),(2)00111010,72                          ! line 17  -INSERT 1 ZERO BIT + 7 BITS OF
! line 18                    -PERIOD.
        ST(DU,16,8),$L+0.56,0                                ! line 19  -EXPAND 2 DECIMAL CHARACTERS TO 8 BIT
! line 20                    -BYTES
        BZB,PNSLIN+POAS,PSC1                                 ! line 21  -TO INSERT (0)
        +I(BU,24),(8)04514623,32                             ! line 22  -INSERT 0 BIT + 23 BITS OF (D)
PSC2    CI0011(BU,9),(8)776,23                               ! line 23  -INSERT 24TH BIT OF) + END CODE
        CM0101(BU,64),PONOUT+4.0,63                          ! line 24
        CM0101(BU,40),PONOUT+5.0,23                          ! line 25
! line 26  -
        B,DMCP                                               ! line 27  -LOG MESSAGE
        ,DWS                                                 ! line 28
        ,PCDEF2                                              ! line 29
        ,PCW4                                                ! line 30
        B,1.0($14)                                           ! line 31
PSC1    +I(BU,24),(8)04522223,32                             ! line 32  -INSERT 0 BIT + 23BITS OF (0)
        B,PSC2                                               ! line 33
! line 34  -
! line 35  - ---------------------------------------------------------
! line 36  -           -HOLD
PH      Z,PONOUT+2.0                                         ! line 37
        CM1111(BU,1),PONOUT+PHOLDS                           ! line 38  -TURN ON HOLD LITE
        LX,$2,PNSLIN                                         ! line 39  -DISPLAY KEY SETTINGS
        SX,$2,PONOUT                                         ! line 40  -LEAVE NUM DISPLAY ALONE
! line 41  -
        B,DMCP                                               ! line 42  -TURN ON HOLD LITE
        ,DWS                                                 ! line 43
        ,PCDEF2                                              ! line 44
        ,PCW5                                                ! line 45
        B,1.0($14)                                           ! line 46

