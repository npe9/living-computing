! mcp_bootstrap_p229.strap -- MCP printed page 229: the Input Program's
! tape-operate section (V STTS1 .. V TDSP), lines 1-50.
!
! docs/MCP_Mar63_001-249.pdf PDF p.236, read at 400 dpi, 900 dpi for
! doubtful glyphs.  Header, READ: "TIME CLOCK 00054041  PUNID 11D11MCP
! CARD ID CA000709  DIST. OF 3/01  3/01  PAGE NUMBER 229"; the heading
! row's LOCATION field is 224730, line 1's word.
!
! THE PAGE.  50 lines, every one located, contiguous from 224730.00 to
! 224763.00 (a full-word BZB; next word 224764.00).  Remarks are octal-ish
! sequence numbers -0706 .. -0750 (no -0713 is printed: line 9 prints
! none and line 10 prints -0714); some rows print only a dash.
!
! >>> "V TDP1" IS NOT "V TOP1". <<<  Lines 14 and 50 print the same
! BZB,V SQNC(V U),V T?P1 with the same first half word 000003.01 83, but
! line 14's second half is 224744.34 (V TOP1 = line 22, 224744.00) and
! line 50's is 224772.74.  At 900 dpi line 50's glyph has a straight
! left stem (D), line 14's and line 22's are round (O, printed open as
! C).  So line 50 branches to V TDP1 = 224772.40, defined on a later
! page; value from this page's binary only.  Line 50 also prints the
! first symbol "V SGNC"/"V SCNC" (worn Q) where line 14 prints a Q with
! its tail; same binary, written VSQNC both times.  Neither VSQNC nor
! VTDP1 is landed -- the Q rests on line 14's ink.
!
! LENGTH FROM THE FINAL SYMBOL.  These statements write no dds and print
! the length of the LAST symbol in the address: "The data description of
! the final symbol ... applies to the whole combination" (C22-6531
! printed p.11).  V OPB, V RDY and V OP are SYN(BU,1), as their defining
! cards print (OCR of pp.231/234/236, not landed); V OPB = .25 and
! V RDY = .26 are bit addresses, unchanged by the point in front of them
! (C22-6578 printed p.64).
!
! Octal-field opens (CCCCC0.62, 2247??.CC) are 0.  Hex bytes printed
! with an open round, written 0 by what the statement assembles to:
! line 4 "C1", lines 23/24 "C0", line 12 "2C 5C" (= 20 50, as line 13's
! 20 D0), line 27 "CC FC" (= 00 F0 at 900 dpi: the C is the same open
! round as the octal 0s beside it), line 50 "CC".  Line 27 prints "CMOCOO": the connective is
! CM0000 (only digits stand there; cf. line 44's CM1111).
!
! >>> CARD SERIALS. <<<  Right-hand serials run ?A000709 .. ?A000754,
! prefix glyph as p.221 (DA by the C/D rule, read 0A); header CA000709.
! Four pairs share a serial: lines 7/8 (715), 22/23 (729), 29/30
! (735), 33/34 (738) -- B,$MCP plus its parameter half word, or SIC plus
! the branch.  Asterisks after the LOCATION on lines 1, 21, 43; after
! the remark on lines 13 (-0717*), 23 (-0725*), 32 (-0733*), 36 (-0736*).

VP      SYN, $1                      ! landed p.213 line 26 "V P SYN,$1"
VU      SYN, $3                      ! landed p.213 line 25 "V U SYN,$3"
VT1     SYN, $4                      ! landed p.213 line 27
VT2     SYN, $6                      ! landed p.213 line 29
VT4     SYN, $8                      ! landed p.213 line 31
VT5     SYN, $9                      ! landed p.213 line 28
VH      SYN, 32                      ! landed p.213 line 7, an INTEGER
VX1     SYN, (8)0.40                 ! landed p.213 line 12 = VX.VH; LV line 11 .62
VSU     SYN, 6.0                     ! landed p.213 line 18; SV line 39 000006.15
VRCNT   SYN, 7.0                     ! landed p.213 line 20; Z line 42 000007.22
VSTR    SYN, (8)10.0                 ! landed p.213 line 22 = VFCNT.VH = 8.0; B line 43
VXXRG   SYN, (8)777777.40            ! landed p.213 line 8 = 262143.VH; SV line 41 .47
VXG     SYN, (8)224135.0             ! landed p.214 line 50; LV line 40 224135.20
VPD     SYN, (8)225427.0             ! landed; LX line 45
VQ      SYN, (8)225346.0             ! landed p.221 (half word only); LVI line 9
VWTTS   SYN, (8)224721.40            ! landed p.221 (half word only); CB+ line 1 .43
VSC     SYN, (8)225250.0             ! landed; LVI line 2
VACT    SYN, (8)224655.0             ! landed; B line 24
DUNLD   SYN, 8.32                    ! landed p.104 line 36; line 34 000010.40
VTSB    SYN, (8)225221.0             ! LVI line 6, half word only (p.231 "V TSB VF,0" not landed)
VOP     SYN(BU,1), 3.                ! p.234/p.236 print V OP SYN(BU,1),3. (OCR; not landed)
VOPB    SYN(BU,1), .25               ! p.234 line 46 prints V OPB SYN(BU,1),.25 (OCR; not landed)
VSQNC   SYN, (8)3.01                 ! BZB lines 14/50 000003.01, this page's binary only
VTQ     SYN, (8)6.0                  ! LV line 16 .20, SV line 20 .23, half word only
VTDQ    SYN, (8)6.40                 ! SV line 21 000006.63, half word only; prints V TCQ, D worn to C (p.230 prints TDQ, beside VTDP3/VTDP4)
VSURT   SYN, (8)225201.0             ! SV/LX/SX lines 18,26,37,46,49 (p.231 SYN not landed)
VRDY    SYN(BU,1), .26               ! p.231 prints V RDY SYN(BU,1),.26 (OCR; not landed)
VDS     SYN, (8)3.40                 ! LR line 48 000003.50 (J=4 is .10), half word only
VTDP1   SYN, (8)224772.40            ! BZB line 50 second half 224772.74 (TOP1 gives .34 on line 14)

        SLC, (8)224730.0
        CB+,VP,VWTTS                                         ! line  1  -0706
        LVI,VU,VSC                                           ! line  2  -0707
