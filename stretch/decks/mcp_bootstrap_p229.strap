VTOP    LV,VT5,VX1(VU)                                       ! line 11  -TAPE OPERATE -0715
        L,VOP(VU)                                            ! line 12  -0716
        ST,VT1.VOPB                                          ! line 13  -0717*
        BZB,VSQNC(VU),VTOP1                                  ! line 14  -0718
        LVI,VT1,0                                            ! line 15  -0719
        LV,VT4,VTQ(VU)                                       ! line 16  -0720
        BXVZ,VTOP2                                           ! line 17  -0721
        SV,VT5,VSURT(VT4)                                    ! line 18  -0722
        B,VTOP1                                              ! line 19  -0723
VTOP2   SV,VT5,VTQ(VU)                                       ! line 20  -0724
        SV,VT5,VTDQ(VU)                                      ! line 21
VTOP1   SIC,(VP)                                             ! line 22
        B,VTMV                                               ! line 23  -0725*
        B,VACT                                               ! line 24  -0726
VTMV    LR,VT1,VU                                            ! line 25  -TAPE MOTIVATIEN -0727
        SX,VT1,VSURT(VT5)                                    ! line 26  -0728
        CM0000,VSURT.VRDY(VT5)                               ! line 27  -0729
        BXF,VTMV1                                            ! line 28  -0730
        B,$MCP                                               ! line 29
        ,$REW                                                ! line 30  -0731
        ,(VT5)                                               ! line 31  -0732
        B,(VP)                                               ! line 32  -0733*
VTMV1   B,$MCP                                               ! line 33
        ,DUNLD                                               ! line 34  -0734
        ,(VT5)                                               ! line 35  -0735
        B,(VP)                                               ! line 36  -0736*
VTA     LX,VT1,VSURT(VT2)                                    ! line 37  -0737
        SR,VT1,VU                                            ! line 38  -PUT DS IN U -0738
        SV,VT2,VSU(VU)                                       ! line 39  -SEND SU TO DESTINATI -0739
        LV,VT4,VXG(VT2)                                      ! line 40  -0740
        SV,VU,VXXRG(VT4)                                     ! line 41  -0741
        Z,VRCNT(VU)                                          ! line 42  -0742
        B,VSTR(VU)                                           ! line 43  -START UNIT AT DESTIN -0743
VTDSP   CM1111,VSURT.VRDY(VT5)                               ! line 44  -0744
        LX,VP,VPD                                            ! line 45  -0745
        LX,VT1,VSURT(VT5)                                    ! line 46  -0746
        SR,VT1,VU                                            ! line 47  -0747
        LR,VT1,VDS(VU)                                       ! line 48  -0748
        SX,VT1,VSURT(VT5)                                    ! line 49  -0749
        BZB,VSQNC(VU),VTDP1                                  ! line 50  -0750

