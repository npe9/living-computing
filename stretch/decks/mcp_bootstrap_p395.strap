! mcp_bootstrap_p395.strap -- MCP printed page 395: the $EOJ program's
! (JC4) temporary storage and symbols (WSPLL .. YTBIT), then THE COMPILE
! AND GO SUB ROUTINES (Y COJB .. YCIODC).
!
! docs/MCP_Mar63_250-445.pdf PDF p.145, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZA000651  DIST. OF 3/01
!  3/01  PAGE NUMBER 395"; the heading row's LOCATION field is BLANK
! (line 1 is a remark).
!
! >>> STILL $EOJ. <<<  PUNID 22$EOJ, card series ZA, low core.  No SLC,
! no new PUNID, no TAIL on the page; the SLC below is scaffolding for
! line 5's printed LOCATION (line 4 is a CNOP with no location).
!
! THE PAGE.  56 lines, every line number prints a "*"; a "*" after the
! LOCATION on lines 5, 12, 14, 37 and 52.  Contiguous 020706.00 ..
! 020776.00 (line 56, a half word; next 020776.40, where p.396's SLC
! starts), except lines 16-23: eight SYNs printing their own values
! (231443.00, 231426.xx, 020202.40, 020707.00, 020226.00) that do not
! move the counter.
!   lines  1-3, 24-26  remarks.
!   lines  4, 11       CNOP.
!   lines  5-14        (AX)DD messages/buffers and WSPLL1 DRZ(U),8.
!   line  15           YYJCL ,YUCBF1+.54 (a half word).
!   lines 16-23        SYNs.  Their printed dds: YJCDB1 U,64,4; YLOL1,
!                      YLOL2, YTBIT N,64,4; YBCRD, YRESTR, YC4B BU,64,8;
!                      YJCDBU U,64,4 (printed octal "100", "04"/"10").
!   lines 27-56        code and data.
!
! ENTRY-MODE DATA counted on the ink at a 40 px/char pitch from the
! comma (each X is the terminator; the counts are what the next
! LOCATION requires): line 5 "1"+7 blanks; line 7 "- TIME  "; line 8
! 8 blanks, ",", 2 blanks, "DATE", 1 blank; line 9 8 blanks, ",", 4
! blanks, "VERSION", 4 blanks; line 10 8 blanks; lines 12-14 48 blanks.
!
! CARD SERIALS.  ZA000651 .. ZA000706, one per line, no gaps or
! repeats.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * YLOL1/YLOL2 (labels lines 17-18 print "YLCL1"/"YLCL2", open;
!     line 23 reads "YLOL2"): spelled as every $EOJ stand-in spells them
!     (pp.271, 386).
!   * YCOJB/YCOJB1/YCOJB2: C22-6728 names YCOJB, YCOJB1, YCOJB2.
!     Line 27 prints "Y COJB", line 31 "Y DUM" (blank in the name).
!   * YJCDB1/YJCDBU print "YJCDB1"/"YJCCBU" with D worn: C22-6728
!     YJCDBU; neighbours' stand-ins.
!   * YDFCTA (lines 49, 52): reads D; the sheet's "YOFCTA" rejected.
!   * KSILO (prints "KSILC"/"KSIL0"): landed p.171.
!   * Octal fields' open rounds are 0 (e.g. line 48 "414030.C6").
!   * Line 48's last hex byte prints "7C" (900 dpi: the same open round
!     as its octal ".C6"); LFI's low nibble is the index, none printed:
!     written 70.
!
! >>> MERGE NOTE. <<<  This page DEFINES YLOL1, YLOL2 and YTBIT by SYN
! to YLLSAV (a DR(N)), so they carry (N) -- printed N,64,4.  Earlier
! $EOJ pages stand them in plain (YLOL1/2, pp.271, 386) or SYN(BU,1)
! (YTBIT, pp.273, 391, 392, which also write (BU,1) on the use).
!
! EXTERNALS: stand-ins are checked by the merge.  YCCIN copies p.396's
! DDI stand-in (its line 29 "(AX)DDI(BU,12,6),PCX" = 4763).

SCNFCG  SYN(BU,1), (8)215001.02      ! landed p.103
TASIGN  SYN, (8)021164.0             ! $EOJ's TASIGN; B line 30, half word only
TPPRUN  SYN(BU), (8)232232.0         ! landed p.288 XW
TRJECT  SYN(BU,1), 0.37              ! landed p.62
KSILO   SYN(BU,64), (8)220451.0      ! landed p.171 DR(BU,64)
WJ4PFF  SYN(BU,64,8), (8)020274.40   ! $EOJ p.388 line 28 BZBZ label; BB line 34, half word only
YMOJM3  SYN(BU), (8)020566.0         ! p.394 (AX)DD(BU); LVI line 35, half word only
TMOVE   SYN, (8)022326.0             ! $EOJ's TMOVE; B line 42, half word only
YUCBF1  SYN(BU,64,8), (8)231366.0    ! p.273 DRZ(BU,64),(8); line 15 231366.66
YUCBF2  SYN(BU,64,8), (8)231376.0    ! p.273 DRZ(BU,64),(13); L line 47 231400.00 = +2.0
YCCIN   SYN(BU,12,6), (8)4763        ! p.396 line 29 DDI stand-in; LFI line 48 476300.00
DMCP    SYN, 32.0                    ! landed
DFETCH  SYN, 66.32                   ! landed p.105
SJCTWS  SYN(B,25,1), (8)215020.0     ! landed p.103 VF
WJOR2   SYN(U), (8)231443.0          ! p.274 DRZ(U),15
YLLSAV  SYN(N), (8)231426.0          ! p.274 DR(N),(1)
WJC4G2  SYN(BU,64,8), (8)020202.40   ! $EOJ p.386 line 12 CM1111 label
WRESTR  SYN(BU,64,8), (8)020226.0    ! $EOJ p.386 CM1111 label

        SLC, (8)020706.00
! line  1  - ****************************************************
! line  2  -           TEMPORARY STORAGE + SYMBOLS FOR JC4
! line  3  - ****************************************************
        CNOP                                                 ! line  4
WSPLL   (AX)DD(BU),1       X                                 ! line  5  -
WSPLL1  DRZ(U),8                                             ! line  6  -FOR JOB NAME
YC4DTS  (AX)DD(BU),- TIME  X                                 ! line  7
YC4TIM  (AX)DD(BU),        ,  DATE X                         ! line  8
YC4DTE  (AX)DD(BU),        ,    VERSION    X                 ! line  9
YC4DTI  (AX)DD(BU),        X                                 ! line 10
        CNOP                                                 ! line 11
YC4SMB  (AX)DD(BU),                                                X ! line 12
        (AX)DD(BU),                                                X ! line 13
        (AX)DD(BU),                                                X ! line 14
YYJCL   ,YUCBF1+.54                                          ! line 15
YJCDB1  SYN,WJOR2                                            ! line 16  -A6 JOB CARD.
YLOL1   SYN,YLLSAV                                           ! line 17
YLOL2   SYN,YLLSAV +.32                                      ! line 18
YBCRD   SYN,WJC4G2                                           ! line 19
YJCDBU  SYN,WSPLL1                                           ! line 20
YRESTR  SYN,WRESTR                                           ! line 21
YC4B    SYN,YRESTR                                           ! line 22
YTBIT   SYN,YLOL2+.25                                        ! line 23
! line 24  - ****************************************************
! line 25  -  ********** THE COMPILE AND GO SUB ROUTINES *************
! line 26  - ****************************************************
YCOJB   BZBZ,SCNFCG,$+2.                                     ! line 27  printed "Y COJB"
        CM1111(BU,1),YDUM                                    ! line 28  -IF THERE IS A MACHINE CONF. CHANGE
        LVI,$15,YDUM                                         ! line 29
        B,TASIGN                                             ! line 30  -(TO PRINT MESSAGES BEFORE COMPILING
YDUM    XW,0,0,7                                             ! line 31  -SPEC. ENTRY TO ASSIGN TO RETURN WITHOUT STATUS  printed "Y DUM"
        LV,$15,TPPRUN                                        ! line 32
        BZB,TRJECT($15),YCOJB2                               ! line 33
        BB,KSILO+1.18,WJ4PFF                                 ! line 34
        LVI,$14,YMOJM3                                       ! line 35
        CT1100(BU,2),KSILO+1.21                              ! line 36
        BZRZ,WJ4PFF                                          ! line 37
        KV,$14,0($15)                                        ! line 38
        BXL,WJ4PFF                                           ! line 39
YCOJB2  BB,KSILO+1.19,YCOJB1                                 ! line 40
        LVI,$15,YCPREJ                                       ! line 41
        B,TMOVE                                              ! line 42
YCPREJ  XW,0,0,1,0                                           ! line 43
YCOJB1  LVI,$15,0                                            ! line 44
        SVA,$15,YCIODC                                       ! line 45
        Z,KSILO+7.0                                          ! line 46
        L(BU,48),YUCBF2+2.0                                  ! line 47
        LFI(BU,12),YCCIN,48                                  ! line 48
        ST(BU,48),YDFCTA,12                                  ! line 49
        B,DMCP                                               ! line 50
        ,DFETCH                                              ! line 51
YDFCTA  DR(BU),(1)                                           ! line 52
        ,0                                                   ! line 53
        LVE, ,SJCTWS                                         ! line 54
        ,0                                                   ! line 55
YCIODC  ,0                                                   ! line 56

