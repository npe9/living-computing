!CHECK 232105.40 | 000000.61 87 232176.74 0E | line 24 LREEL1 BB1,LRLBIT(LXSU),LNORM
!CHECK 232106.40 | 000002.00 83 060000.06 70 | line 26 LF(BU,48),2.0(LIODX)
!CHECK 232107.40 | 231702.00 80 060600.21 10 | line 27 K,LBLANK
!CHECK 232110.40 | 232176.76 C6 | line 28 BAEZ,LNORM
!CHECK 232111.00 | 231545.62 80 232114.74 02 | line 29 BB,LOVBIT,LREEL2-0.32
!CHECK 232112.00 | 000000.00 86 000000.20 50 | line 30 L(BU,64),0.0(LXFR),0.0
