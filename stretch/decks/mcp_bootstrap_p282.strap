!CHECK 232114.40 | 000000.22 06 | line 34 Z,0.0(LXFR)
!CHECK 232115.00 | 000002.00 83 000000.02 A6 | line 35 LREEL2 TI,1,2.0(LIODX),0.0(LXFR)
!CHECK 232116.00 | 000000.24 34 | line 36 LV,LWORKX,0.0(LXPP)
!CHECK 232116.40 | 000000.62 87 007027.20 50 | line 37 L(BU,7),.50(LXSU),46
