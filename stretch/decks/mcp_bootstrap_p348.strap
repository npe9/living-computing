! mcp_bootstrap_p348.strap -- MCP printed page 348: the $DUMP program's
! AINITL (initialise the print image by TI), the AINTLB/AFTRMB link
! words, AFTRMT (format the 3-wide panel field through AOCTLB/AOCTLC,
! APNLP5 loop of 2), ALSRQ / APUMP1 (the panel-dump request decision:
! CM tests of APANEL.19 and ANORMP.19, B,DMCP ,DRET), APUML7, ADLWER,
! APUMP7, AUNERR, and ANDXWD (index-word print: TI APXW, ANDX3, ANDX2),
! lines 1-50.
!
! docs/MCP_Mar63_250-445.pdf PDF p.98, read at 400 dpi, names at 900
! dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 22$DUMP  CARD ID
! VB000264  DIST. OF 3/01  3/01  PAGE NUMBER 348"; the heading row's
! LOCATION field is 235205, line 1's word.
!
! $DUMP OVERLAY (PUNID 22$DUMP, card IDs VB...), the same program as
! pp.335-347; no new PUNID, no SLC to a new origin.  No TAIL.
!
! THE PAGE.  50 lines; every line number prints a "*".  "*" after the
! LOCATION on lines 13, 29, 45.  No remarks, no remark cards.  Located
! rows contiguous from 235205.40 (line 1) to 235251.00 (line 50, LCI, a
! half word; next 235251.40), then blank paper.
!
! JOIN.  p.347 (tools/page_sheet.py 347) ends with B,AOCTLH at
! 235205.00, a half word: next 235205.40 = line 1.  p.349's sheet opens
! with ANDX1 at 235251.40: contiguous.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "ACCTLC" (lines 8, 13): second glyph open; the SICs on lines 7
!     and 12 print AOCTLB and pp.343-345 spell the pair AOCTLB/AOCTLC:
!     written AOCTLC.
!   * "ANCXWD" (line 36 NAME): the third glyph prints without a stem
!     at 900 dpi; the ANDX- family on this page (ANDX3, ANDX2, ANDX5,
!     B,ANDX1 with a plain D) and C22-6728 (typeset "ANDXWD") settle
!     it: written ANDXWD.  "ANCX3"/"ANCX2" read the same way: ANDX3,
!     ANDX2.
!   * "ADLWER" (line 28): kept D as p.343 spells it (BB ... ADLWER).
!   * "ALSRQ" (lines 17, 35): tail of the Q prints; p.343 spells ALSRQ.
!   * octal / hex fields with an open round read 0 ("CO", "FO", "DO",
!     ".CC" = .00).  Lines 17 and 42 print LVI's byte "C1" with an
!     open round; LVI can only assemble 01, which line 36 prints with
!     a closed 0 (900 dpi): 01.
!
! EXTERNALS.  Landed instruction labels (p.342: APUML6, APUMP9, ADMP1;
! p.343: APUMP6, APANEL) carry the dds of their defining card's length.
! The rest are not landed; values from this page's binary.
!
! CARD SERIALS.  VB000264 .. VB000307.  Shared serials, every one a
! pair of half words: lines 7-8 (270), 12-13 (274), 22-23 (283), 42-43
! (302), 44-45 (303), 48-49 (306).  None skipped.

AOCTLB  SYN, (8)235376.40            ! not landed; SIC lines 7,12 235376.40, BIT-EXACT
AOCTLC  SYN, (8)235373.40            ! not landed; B lines 8,13 235373.50, half word only (printed "ACCTLC")
ABUFF   SYN, (8)236044.0             ! not landed; TI line 20 ABUFF+15. = 236063.00, word only
APLC    SYN, (8)236216.0             ! not landed; TI line 1 236216.00, word only
ABLNK   SYN, (8)236220.0             ! not landed; TI line 2 236220.00, word only
APXW    SYN, (8)236217.0             ! not landed; TI lines 37-40 236217.00, word only
APUML6  SYN(BU,32,8), (8)234704.00   ! landed p.342 line 2 (B,$)
APUMP6  SYN(BU,32,8), (8)234753.00   ! landed p.343 line 25 (LV)
APUMP9  SYN(BU,32,8), (8)234717.40   ! landed p.342 line 18 (LVE)
ADMP1   SYN(BU,64,8), (8)234713.00   ! landed p.342 line 11 (BB)
APANEL  SYN(BU,32,8), (8)234763.00   ! landed p.343 line 40 (NOP)
DMCP    SYN, 32.0                    ! landed p.108 "D MCP SYN,32.0"
DRET    SYN, 33.0                    ! landed p.105
ANORMP  SYN, (8)235174.40            ! not landed; CM lines 28,31,33 ANORMP.19 = 235174.63, BIT-EXACT
APCOL1  SYN, (8)236105.0             ! not landed; LVI line 36 236105.35, half word only
ANDX5   SYN, (8)235274.40            ! not landed; NOP line 41 235274.70, half word only
AWDCMP  SYN, (8)235330.0             ! not landed; B line 43 235330.10, half word only
ANDX1   SYN, (8)235251.40            ! not landed (p.349 line 1); B line 45 235251.50, half word only
AHOTP   SYN, (8)236161.0             ! not landed; LV line 46 236161.34, half word only
ALCRFB  SYN, (8)235373.0             ! not landed; SIC line 48 235373.00, half word only
ALCRF   SYN, (8)235370.0             ! not landed; B line 49 235370.10, half word only

        SLC, (8)235205.40
AINITL  TI,1,APLC,($14)                                      ! line  1
        TI,1,ABLNK,1.($14)                                   ! line  2
        TI,15,1.($14),2.($14)                                ! line  3
AINTLB  B,$                                                  ! line  4
AFTRMT  L(BU,1)(V+I),.1($1),40                               ! line  5
        LF(BU,15,3)(V+I),.15($1)                             ! line  6
        SIC,AOCTLB                                           ! line  7
        B,AOCTLC                                             ! line  8
        SF(BU,48)(V+I),.48($14)                              ! line  9
        LCI,$1,2                                             ! line 10
APNLP5  LF(BU,24,3)(V+I),.24($1)                             ! line 11
        SIC,AOCTLB                                           ! line 12
        B,AOCTLC                                             ! line 13
        ST(BU,64)(V+I),1.($14)                               ! line 14
        CB,$1,APNLP5                                         ! line 15
AFTRMB  B,$                                                  ! line 16
ALSRQ   LVI,$4,APUMP1                                        ! line 17
        SVA,$4,APUML6                                        ! line 18
        B,APUMP6+2.32                                        ! line 19
APUMP1  TI,16,ABUFF+15.,$0                                   ! line 20
        CM1111(BU,1),APANEL.19                               ! line 21
        B,DMCP                                               ! line 22
        ,DRET                                                ! line 23
APUML7  LV,$0,APUMP9                                         ! line 24
        CM0000(BU,6),$0.19                                   ! line 25
        CM1111(BU,1),APANEL.19                               ! line 26
        B,ADMP1                                              ! line 27
ADLWER  CM0000(BU,1),ANORMP.19                               ! line 28
        CM1111(BU,1),APANEL.19                               ! line 29
        B,APUMP6                                             ! line 30
APUMP7  CM1111(BU,1),ANORMP.19                               ! line 31
        B,APUML6                                             ! line 32
AUNERR  CM0000(BU,1),ANORMP.19                               ! line 33
        CM1111(BU,1),APANEL.19                               ! line 34
        B,ALSRQ                                              ! line 35
ANDXWD  LVI,$14,APCOL1                                       ! line 36
        TI,1,APXW,1.($14)                                    ! line 37
        TI,1,APXW,5.($14)                                    ! line 38
        TI,1,APXW,9.($14)                                    ! line 39
        TI,1,APXW,13.($14)                                   ! line 40
ANDX3   NOP,ANDX5                                            ! line 41
ANDX2   LVI,$15,$+1.                                         ! line 42
        B,AWDCMP                                             ! line 43
        LCI,$13,1                                            ! line 44
        B,ANDX1                                              ! line 45
        LV,$14,AHOTP                                         ! line 46
        CM0000(BU,19),$11                                    ! line 47
        SIC,ALCRFB                                           ! line 48
        B,ALCRF                                              ! line 49
        LCI,$13,4                                            ! line 50

!SYM AINITL 235205.40
!SYM AINTLB 235210.40
!SYM AFTRMT 235211.00
!SYM APNLP5 235215.40
!SYM AFTRMB 235221.00
!SYM ALSRQ  235221.40
!SYM APUMP1 235223.00
!SYM APUML7 235226.00
!SYM ADLWER 235231.00
