        ST(BU,32),YMLJM+1.56                                 ! line 25
        LVI,$15,$+1.0                                        ! line 26
        BD,SCA8                                              ! line 27
        VF,ALDBF+13.32                                       ! line 28
        CF,8                                                 ! line 29
        VF,YMLJM+3.0                                         ! line 30
        LV,$9,YLJSLT                                         ! line 31
        CM0000(BU,12),$9                                     ! line 32
        V+,$9,$9                                             ! line 33
        V+,$9,$9                                             ! line 34
        TI,4,YLJM1($9),YLJM1                                 ! line 35
        LVI,$10,YMLJM                                        ! line 36
        B,YRLLOG                                             ! line 37
        CNOP                                                 ! line 38
YLEM1   (AX)DD(BU),-NO BRANCH CARD IN CURRENT DECK-X         ! line 39
        (AX)DD(BU), JOB REJECTED.                  X         ! line 40
YMLJM   (AX)DD(BU),-LOAD. REJ. CD.     ID          X         ! line 41
YLJM1   DRZ(BU),(4)                                          ! line 42
        (AX)DD(BU), CHECKSUM ERROR.                X         ! line 43
        (AX)DD(BU), SEQUENCE ERROR.                X         ! line 44
        (AX)DD(BU), ILLEGAL TYPE OF CARD.          X         ! line 45
        (A*)DD(BU),ILLEGAL NON-BSS FUNCTION        *         ! line 46
        (AX)DD(BU), TRIED TO LOAD OUTSIDE LIMITS.  X         ! line 47
        (AX)DD(BU), C OR P CARD INCORRECTLY PUNCHEDX         ! line 48
        (AX)DD(BU), FIRST C CARD HAS NO ORIGIN.    X         ! line 49
        (AX)DD(BU),NO ORIGIN IN FIRST CARD.        X         ! line 50
YSUKM   (AX)DD(BU),-JOB CANNOT BE RUN BECAUSE OF INPUT DIFFICULTIES.X ! line 51
        (AX)DD(BU),              X                           ! line 52
CDSKBF  DRZ(N),(512)                                         ! line 53  - ***** DISK FETCH BUFFER *****
ZFINIS  VF,0                                                 ! line 54

