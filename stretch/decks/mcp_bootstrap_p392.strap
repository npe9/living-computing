!CHECK 020452.40 | 020646.25 01 | line 24 YLCERR LVI,$10,YLCEM
!CHECK 020453.00 | 020111.63 01 | line 25 LVI,$9,YC4B5
!CHECK 020453.40 | 020457.50 00 | line 26 B,YBCERR
!CHECK 020454.00 | 020656.25 01 | line 27 YIDCER LVI,$10,YICEM
!CHECK 020454.40 | 020132.23 01 | line 28 LVI,$9,YIODSO
!CHECK 020455.00 | 231373.64 80 030600.06 70 | line 29 LF(BU,24,6),YUTOE
!CHECK 020456.00 | 020660.50 80 040000.12 F0 | line 30 SF(BU,32),YICEM+.168
!CHECK 020457.00 | 020457.50 00 | line 31 B,YBCERR
!CHECK 020457.40 | 231462.00 80 014000.20 50 | line 37 YBCERR L(BU,12),YBCBU
!CHECK 020460.40 | 110000.00 80 414000.23 10 | line 38 KFI(BU,12),(2)001001000000 (a "*" after the location)
!CHECK 020461.40 | 020463.76 C0 | line 39 BZAE,$+2.0
!CHECK 020462.00 | 231426.71 80 001000.36 F0 | line 40 CM1111(BU,1),YTBIT
!CHECK 020463.00 | 000000.10 09 | line 41 B,0.0($9)
!CHECK 020463.40 | 420000.00 80 414000.23 10 | line 42 KFI(BU,12),(2)100010000000
!CHECK 020464.40 | 020220.36 C6 | line 43 BAEZ,YBRLOG
!CHECK 020465.00 | 020656.25 04 | line 44 KVI,$10,YICEM
!CHECK 020465.40 | 020220.32 C0 | line 45 BZXE,YBRLOG
!CHECK 020466.00 | 215324.30 90 | line 46 KV,$12,SLRBU
!CHECK 020466.40 | 020470.32 42 | line 47 BXL,YBLMOK
!CHECK 020467.00 | 215324.31 30 | line 48 SV,$12,SLRBU
!CHECK 020467.40 | 215005.31 30 | line 49 SV,$12,SBAPP
!CHECK 020470.00 | 000001.31 0A | line 50 YBLMOK KCI,$12,1.0
