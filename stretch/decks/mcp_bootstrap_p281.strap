!CHECK 232047.00 | 231624.21 0D | line 29 LCHAN V-I,LXSC,LSYMC
!CHECK 232047.40 | 000011.21 30 | line 30 SV,LXSC,$R
!CHECK 232050.00 | 000000.71 87 007027.20 D0 | line 31 ST(BU,7),0.57(LXSU),46
!CHECK 232051.00 | 000004.00 83 060000.20 50 | line 32 L(BU,48),4.0(LIODX)
!CHECK 232052.00 | 231702.00 80 060000.21 10 | line 33 K(BU,48),LBLANK
