!SYM   TM2AM    005333.00
!SYM   TM3A     005334.40
!SYM   TM3C     005336.00
!SYM   TM3B     005342.40
!SYM   TSORT    005344.00
!SYM   TSORT1   005344.40
!SYM   TSORT4   005346.00
!SYM   TSORT2   005347.40
!SYM   TSORT5   005351.00
!SYM   TSORT3   005354.40
