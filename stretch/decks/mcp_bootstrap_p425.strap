! mcp_bootstrap_p425.strap -- MCP printed page 425: the $EOJ program's
! reassembly of the tape ASSIGN routine, the IOD-card scan against the
! unit name table (TM1X .. TM1E) and the start of "GENERATE THE UNIT
! AREA TABLES" (TMU .. B,TMREJB).
!
! docs/MCP_Mar63_250-445.pdf PDF p.175, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZF000380  DIST. OF 3/01
!  3/01  PAGE NUMBER 425"; the heading row's LOCATION field is 022416,
! line 1's word.
!
! >>> CARD SERIES ZF (as p.424), PUNID 22$EOJ.  No SLC, no PUNID on the
! page; the origin below is line 1's printed LOCATION.  No TAIL. <<<
!
! THE PAGE.  55 lines, every line number prints a "*"; a further "*"
! after the LOCATION on lines 1, 16, 36, 48 (recorded, not interpreted).
! Contiguous 022416.00 .. 022465.40 (line 55, a half word; next location
! 022466.00).  p.424 ends at 022415.40 (its header), so line 1 continues
! it.  Lines 23, 29-32 are remarks (29-31 the boxed banner "GENERATE THE
! UNIT AREA TABLES").  The same source as volume 1 pp.89-90, with
! lines 6-12 (the TM6BL blank test, TM1X) and 49-50 ($TC -> TRMTC) new.
!
! CARD SERIALS.  ZF000380 .. ZF000434, one per line, consecutive.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!  * line 2 "TMCOG" = TMDOG (D worn to C, open O): p.424 line 47 defines
!    TMDOG; binary 022413.74 = 022413.40 + BZRZ's .34.
!  * line 19 prints "TM1C" = TM1D (worn D): line 21 prints TM1D, and
!    both rows' addresses agree (022504.74 BZB, 022504.76 BAE); volume 1
!    p.90's spelling.  TM1DA/TM1DAA (38, 41, 53) read D, worn.
!  * line 36 "-(BL,18)" = -(BU,18) (U worn open at the bottom); length
!    field prints 022 = 18.
!  * line 26 prints "(BU,64]" -- a worn ")".
!  * hex "C0"/"0C" bytes: BZB rows (19, 38, 41) print h2 "0C"/"CC": BZB
!    can make only 00 there (p.409 BZB rows print 00); the open 0.  The
!    BZRZ/BZAE "C0" bytes are real C0.
!  * lines 7 and 9 "BZAE,TM1X-   NO": the "-" right after the statement
!    is the comment mark (C28-6129 PDF p.5); remark "NO".
!  * line 12 label prints "TM1X" with no space (others "T M1A" etc.).
!
! EXTERNALS.  Copied in their DEFINING forms from the scratch neighbours
! (p.418: TMXn index names, TM6BL DD, TBAMCP SYN,SMAXUB, TDKSAV VF,
! TUNXW XW; p.419: the IOD/unit-table field SYNs; p.420: TRELB) and the
! resident pages (p.288/289).  Each agrees with this page's binary.

TMX1    SYN,$1                       ! p.418 line 22; LVI line 54 .03
TMXB    SYN,$3                       ! p.418 line 24; byte 83
TMXC    SYN,$4                       ! p.418 line 25; byte 84
TMXD    SYN,$5                       ! p.418 line 26; SV line 33 .13
TMXE    SYN,$6                       ! p.418 line 27; byte 86
TMXF    SYN,$7                       ! p.418 line 28; byte 87
TMXG    SYN,$8                       ! p.418 line 29; byte 88
TMXI    SYN,$10                      ! p.418 line 31; byte 8A
TICH    SYN(BU,48),4.0               ! p.419 line 25
TIUN    SYN(BU,48),5.0               ! p.419 line 26
TITYCD  SYN(BU,4),2.60               ! p.419 line 24
TIREF   SYN(BU,12),0.52              ! p.419 line 19
TUNTYP  SYN(BU,4),0.60               ! p.419 line 1
TUNME   SYN(BU,48),25.0              ! p.419 line 3
TCHNM   SYN(BU,48),0.0               ! p.419 line 51
TFIAAC  SYN(BU,18),3.0               ! p.419 line 44
TCHANN  SYN(BU,7),0.12               ! p.419 line 40
TUNITN  SYN(BU,3),0.47               ! p.419 line 41
TSYSTM  SYN(BU,1),7.25               ! p.419 line 45
TFRLAD  SYN(BU,18),8.0               ! p.419 line 46
TCREEL  SYN(BU,18),8.32              ! p.419 line 47
TREELK  SYN(BU,7),8.57               ! p.419 line 48
TRMTC   SYN(BU,26),1.32              ! p.419 line 43; SF line 50 000001.40
TRELB   SYN(BU,1),0.27               ! p.420 line 21
TMULTI  SYN(BU,1),0.27               ! landed p.289 line 7
TABSCH  SYN(BU,18),0.46              ! landed p.288 line 37
TABSUN  SYN(BU,3),0.07               ! landed p.288 line 32
TTYPE   SYN(BU,4),0.03               ! landed p.288 line 31
SXCHAN  SYN(BU), (8)215002.0         ! landed p.103 line 28 "SXCHAN XW,0"; line 36 215002.00
TCHSXW  SYN,SXCHAN                   ! landed p.289 line 5 (defining form)
SMAXUB  SYN(B,25,1), (8)215225.0     ! landed p.116 "S MAXUB VF,0.0"; KV line 52 215225.16
TBAMCP  SYN,SMAXUB                   ! p.418 line 18 (defining form)
TM6BL   SYN(BU,48,6), (8)022132.15   ! p.418 line 13 (AX)DD(BU,48,6) at 022132.15; KF lines 8, 10
TDKSAV  SYN(B,25,1), (8)022153.0     ! p.418 line 43 "TDKSAV VF,0"; SV lines 18, 28 022153.21
TUNXW   SYN(BU), (8)022154.0         ! p.418 line 49 XW; M+1 line 27 TUNXW+28 = 022154.34
TMDOG   SYN, (8)022413.40            ! p.424 line 47 label; BZRZ line 2 022413.74, half word only
TM1D    SYN, (8)022504.40            ! not seen; BZB line 19 022504.74, BAE line 21 .76, half word only
TM1DA   SYN, (8)022470.40            ! not seen; BZB line 38 022470.74, half word only
TM1DAA  SYN, (8)022466.0             ! not seen; BZB line 41 .34, BXL line 53 .32, half word only
TMREJB  SYN, (8)022721.0             ! not seen; B line 55 022721.10, half word only

        SLC, (8)022416.00
        LF(BU),0.0(TMXC)                                     ! line  1  -IS SIOL SLOT ALREADY USED
        BZRZ,TMDOG                                           ! line  2  -YES - REPORT ILLEGAL IOD CARD TO JC (printed "TMCOG")
        L,TICH(TMXI),16                                      ! line  3  -GET CHAN FIELD OF IOD CARD
        LF,TIUN(TMXI),80                                     ! line  4  -GET THE UNIT NAME - TAPE ONLY
        LF,TITYCD(TMXI)                                      ! line  5  -GET THE TYPE FIELD CODED
        KFI(BU,4,6),8                                        ! line  6  -LOOK FOR A TAPE IOD
        BZAE,TM1X                                            ! line  7  -   NO
        KF,TM6BL,16                                          ! line  8  -YES
        BZAE,TM1X                                            ! line  9  -   NO
        KF,TM6BL,80                                          ! line 10  -
        BAE,TMU                                              ! line 11  -IF BOTH CHAN/UNIT FIELDS ARE BLANK
TM1X    V+I,TMXG,0.0                                         ! line 12  -TO RE-ACTIVATE IX INDICATORS
        BXCZ,TM1E                                            ! line 13  -IF ZERO ENTRY
TM1A    KF,TCHNM(TMXG),16                                    ! line 14  -COMPARE AGAINST TABLE
        BZAE,TM1B                                            ! line 15  -IF UNLIKE ENTRY
        KF,TUNTYP(TMXG)                                      ! line 16  -COMPARE EQUIP FEILD
        BZAE,TM1B                                            ! line 17  -IF NOT ALIKE
        SV,TMXG,TDKSAV                                       ! line 18
        BZB,TITYCD(TMXI),TM1D                                ! line 19  -IF NOT TAPE (printed "TM1C")
        KF,TUNME(TMXG),80                                    ! line 20  -TAPE COMPARE UNIT NAME
        BAE,TM1D                                             ! line 21  -UNIT AREA TABLE GENERATED
TM1B    CB+,TMXG,TM1A                                        ! line 22
! line 23  -
TM1E    LF,TIREF(TMXI),04                                    ! line 24  -GET THE REF. NUMBER
        SF(BU,64),TUNME(TMXG),64                             ! line 25
        CM0101(BU,64),0.0(TMXG)                              ! line 26  -STORE NEW ENTRY IN TABLE
        M+1(BU,18),TUNXW+28                                  ! line 27  -STEP TABLE COUNTER
        SV,TMXG,TDKSAV                                       ! line 28
! line 29  - ----------------------------------------------------------
! line 30  -              GENERATE THE UNIT AREA TABLES
! line 31  - ----------------------------------------------------------
! line 32  -
TMU     SV,TMXD,TFIAAC(TMXE)                                 ! line 33  - SET UP THE FILE AREA  ACT. ADDR.
        L,TABSCH(TMXB),46                                    ! line 34  -GET THE ADDR OF THE ASSIGNED CHAN
        LX,TMXG,$R                                           ! line 35  -CHAN TABLE ADDR TO IX
        -(BU,18),TCHSXW,46                                   ! line 36  -COMPUTE THE CHANNEL NUMBER (printed "(BL,18)")
        ST,TCHANN(TMXE),46                                   ! line 37
        BZB,TMULTI(TMXG),TM1DA                               ! line 38  -IF NOT A MULTI UNIT CHAN
        L,TABSUN(TMXB),46                                    ! line 39  -GET THE UNIT NUMBER
        ST,TUNITN(TMXE),46                                   ! line 40  -AND PLACE IN UNIT AREA TBL
        BZB,TTYPE(TMXB),TM1DAA                               ! line 41  -IF THE TYPE IS NOT TAPE
        CM1111,TSYSTM(TMXE)                                  ! line 42  -SET THE SYSTEM TAPE BIT FOR INITIAL
        C0011(BU,18),TMXF                                    ! line 43  -GET REEL POOL ADDRESS
        CM0101,TFRLAD(TMXE)                                  ! line 44  -AND STORE IN UNIT AREA
        CM0101,TCREEL(TMXE)                                  ! line 45
        M+1,TREELK(TMXE)                                     ! line 46  -SET THE REEL COUNT TO ONE
        Z,0.0(TMXF)                                          ! line 47  -ZERO THE FIRST REEL SLOT
        CM1111(BU,1),TRELB(TMXF)                             ! line 48
        LF(BU,26),$TC                                        ! line 49
        SF(BU,26),TRMTC(TMXE)                                ! line 50
        V+I,TMXF,1.0                                         ! line 51  -STEP REEL POOL INDEX
        KV,TMXF,TBAMCP                                       ! line 52  -IS THE REEL POOL EXCEEDING BOUNDS
        BXL,TM1DAA                                           ! line 53  -NO
        LVI,TMX1,4.0                                         ! line 54  -YES SO NOTE IT JC
        B,TMREJB                                             ! line 55  -AND REJECT JOB

!SYM TM1X   022427.00
!SYM TM1A   022430.00
!SYM TM1B   022436.00
!SYM TM1E   022436.40
!SYM TMU    022443.00
