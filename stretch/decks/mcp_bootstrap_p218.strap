!CHECK 224310.40 | 224312.31 42 | line 26 BXVZ,V SC4
!CHECK 224311.00 | 000026.26 50 | line 27 LC,V S2,V T2
!CHECK 224311.40 | 777777.03 C9 | line 28 V SQ2 CB-,V P,V M1(V P)
!CHECK 224312.00 | 000033.22 30 | line 29 V SC4 LV,V T5,V S2
!CHECK 224312.40 | 225246.25 10 | line 30 SX,V S1,V TX
!CHECK 224313.00 | 000001.03 0D | line 31 V-I,V P,1.0
!CHECK 224313.40 | 000005.10 03 | line 32 B,V NX(V U)
!CHECK 224314.00 | 225250.07 01 | line 34 V SQ LVI,V U,V SC
!CHECK 224314.40 | 000000.00 81 | line 35 SIC,(V P)
!CHECK 224315.00 | 224702.10 00 | line 36 B,V CCM as printed
!CHECK 224315.40 | 225246.24 10 | line 37 LX,V S1,V TX
!CHECK 224316.00 | 000000.00 81 | line 38 SIC,(V P)
!CHECK 224316.40 | 224670.50 00 | line 39 B,V SETUP
!CHECK 224317.00 | 225246.25 10 | line 40 SX,V S1,V TX
!CHECK 224317.40 | 000000.15 05 | line 41 V+I,V T2,C
!CHECK 224320.00 | 224311.71 42 | line 42 BXVZ,V SQ2
!CHECK 224320.40 | 000000.55 33 | line 43 SV,V T2,V X1(V U)
