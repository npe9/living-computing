!  31*  221124.40   000001.15 0D                  JJSKP1  V-I,6,1.                                                 LB000029
!  32*  221125.00 * 000026.00 80  022023.20 10             +(BU,18),$6,38        -BLOCK CONTROL                     LB000030
!  33*  221126.00   221142.40 80                           SIC,JADOUT                                              LB000031
!  34*  221126.40   221140.50 00                           B,JADIN                                                 LB000031
!  35*  221127.00   000000.51 04                  JDISCK  KVI,$4,.32            -IF DISK, NO                       LB000032
!  36*  221127.40   221131.72 C2                           BXE,JPICK1            -CHAINING                          LB000033
!  37*  221130.00   000021.03 70                           SR,$1,$1              -CHAINED ADDR.                     LB000034
!  38*  221130.40   221131.63 40                           BZXF,JPICK1           -END OF CHAIN                      LB000035
!  39*  221131.00   221112.00 48                           CB,$0,JMORCW                                            LB000036
!  40*  221131.40   000035.00 30                  JPICK1  LV,0,$13                                                 LB000037
!  41*  221132.00   000003.01 05                           V+I,0,3.                                                 LB000038
!  42*  221132.40   000003.41 3C                           SV,0,3.32($12)        -CW ADD IN FET TO LAT              LB000039
!  43*  221133.00   221133.00 80  000000.06 70    JPICK   LF(BU,64),$           -INITIAL CW                        LB000040
!  44*  221134.00   400000.00 80  406024.06 70             LFI(BU,6),(2)100000,40  -SET STATUS BITS                 LB000041
!  45*  221135.00   777776.67 82  001023.46 70             LF(BU,1),-1.09($2),39 -SEOP BIT                          LB000042
!  46*  221136.00   000003.00 8D  000000.12 F0             SF(BU,64),SCW($13)    -CW TO FAT SLOTS                   LB000043
!  47*  221137.00   000004.00 8D  000000.12 F0             SF(BU,64),SCCW($13)                                      LB000044
!  48*  221140.00   221140.10 00                  B1RA    B,$                   -EXIT PRESET BY SIC                LB000045
!  49*  221140.40 * 000011.32 80  023023.23 10    JADIN   KF(BU,19),SLOWA,38    -TEST ADDR. FOR                    LB000046
!  50*  221141.40   000011.55 80  023023.23 50             KFR(BU,19),SUPPB,38   -RANGE                             LB000047
!  51*  221142.40   221142.76 C2                  JADOUT  BAE,$                 -AE WHEN OK                        LB000048
!  52*  221143.00   010007.35 01                  BCWERR  LVI,$14,SCWINV                                           LB000049
!  53*  221143.40   217451.40 80                           SIC,S DISIC                                              LB000050
!  54*  221144.00   217372.10 00                           B,S DISP                                                 LB000050
!  55*  000011.32+  +00000000      BU,100,10       S LOWA  SYN,$R.26                                                LB000051
!  56*  000011.55+  +00000000      BU,100,10       S UPPB  SYN,$R.45                                                LB000052

! ---------------------------------------------------------------
! THE DECLARED CHECKS.  Fifty-one !CHECK rows for the fifty-one
! emitting lines -- the whole page, not a sample -- and thirteen
! !SYM rows for the thirteen names the page defines.
! ---------------------------------------------------------------
!SYM   BCWCR    221102.00
!SYM   JMORCW   221112.00
!SYM   JJSKP    221117.40
!SYM   JJSKP1   221124.40
!SYM   JDISCK   221127.00
!SYM   JPICK1   221131.40
!SYM   JPICK    221133.00
!SYM   B1RA     221140.00
!SYM   JADIN    221140.40
!SYM   JADOUT   221142.40
!SYM   BCWERR   221143.00
!SYM   SLOWA    000011.32
!SYM   SUPPB    000011.55

!CHECK 221102.00 | 221133.01 D0 | line 4 B CWC R SVA,$0,JPICK -ADDR OF CW -- FIRST ROW OF THE PAGE; the heading-row LOCATION field is BLANK (line 1 is a banner) so this row's location is asserted by the deck's hard SLC and corroborated by decks p.151/p.153, which SYN BCWCR at (8)221102.0 off their printed "B,B CWCR" rows compiling 221102.10 00
!CHECK 221102.40 | 215001.04 80 221131.74 02 | line 5 BB,SL,JPICK1 -BRANCH IF MCP -- the printed ".C4" is an octal field and cannot hold a C, so it is .04; S L is printed p.103's (BU,1) level-of-instruction bit at 215001.04
!CHECK 221103.40 | 000020.22 80 007000.07 70 | line 6 CT0011(BU,7),$X0+.18 -CHECK IF ADDR. OF CW -- the mnemonic's two round glyphs read as letter O at 900 dpi; "CTOO11" is not an operation (classify_connective takes four BINARY digits) and "CT0011" is, so the assembler eliminates the wrong reading outright
!CHECK 221104.40 | 221143.34 C0 | line 7 BZRZ,BCWERR -- the byte's first glyph is round with NO left stem, against line 4's D0 which has one; both bytes are then checked here
!CHECK 221105.00 | 215230.00 80 022027.20 50 | line 8 L(BU,18),SUPPER,46 -- SUPPER is printed p.116's S TLR; the address half word reads it to the bit as 215230.00
!CHECK 221106.00 | 215230.40 80 022027.30 10 | line 9 -(BU,18),SLOWER,46 -- SLOWER is S TLR+0.32 = 215230.40, which is what this row prints
!CHECK 221107.00 | 000011.00 50 | line 10 LC,$0,$R -MAX NO OF CONTROL WORDS -- printed "COOO11.CC 50"; both C runs are octal fields and are 0
!CHECK 221107.40 | 000020.02 30 | line 11 LV,$1,$X0 -- the printed last glyph reads C; "$XC" is not a register ($XN takes N=0-15) and $X0 is index register 0 at word 0o20, which is the 000020 this row prints
!CHECK 221110.00 | 215230.00 80 022000.20 50 | line 12 L(BU,18),S UPPER -SET BOUNDS IN $R -- written with the printed blank, which the assembler accepts in an operand
!CHECK 221111.00 | 215230.40 80 022011.46 70 | line 13 LF(BU,18),S LOWER,19 -- THIS LOCATION CARRIES THE PAGE'S FIRST UNEXPLAINED ASTERISK
!CHECK 221112.00 | 000021.00 80 022023.06 70 | line 14 JMORCW LF(BU,18),$1,38 -CW ADDR. -- the loop head; line 39's CB,$0,JMORCW prints 221112.00 48 and reads this location back
!CHECK 221113.00 | 221142.40 80 | line 15 SIC,JADOUT -- first statement of card LB000015; a SIC's half word carries the full 24-bit bit address (Reference Manual printed p.41) so this row pins JADOUT to the BIT at 221142.40, matching its own label row on line 51
!CHECK 221113.40 | 221140.50 00 | line 16 B,JADIN -- second statement of card LB000015; .50 is JADIN's .40 plus B's .10, so only the half word of JADIN shows here (line 49's label row is what pins it)
!CHECK 221114.00 | 000000.02 11 | line 17 LX,$1,0.0($1) -ACTUAL CW
!CHECK 221114.40 | 000021.33 80 221117.74 00 | line 18 BZB,$1.27,JJSKP -IF NO SKIP BIT -- a full word starting on an ODD half word; its target 221117.74 is JJSKP's 221117.40 plus the branch's .34
!CHECK 221115.40 | 000000.51 04 | line 19 KVI,4,.32
!CHECK 221116.00 | 221117.72 C2 | line 20 BXE,JJSKP
!CHECK 221116.40 | 000001.07 04 | line 21 KVI,$3,1.0 -READ = 1.0 -- printed "COOCO1.C7"; three octal-field C's in one row, all 0
!CHECK 221117.00 | 221127.32 C2 | line 22 BXE,JDISCK
!CHECK 221117.40 | 000021.00 80 022023.06 70 | line 23 JJSKP LF(BU,18),$1,38 -GET 1ST ADDRESS -- bit-identical to line 14, a different card at a different location printing the same word
!CHECK 221120.40 | 221142.40 80 | line 24 SIC,JADOUT -- first statement of card LB000023; THE NAME IS PRINTED HERE WITH AN OPEN ROUND GLYPH ("JADCUT") and on line 33 with a CLOSED one, the same statement in the same character position on one page, which is what settles it as JADOUT
!CHECK 221121.00 | 221140.50 00 | line 25 B,JADIN -- second statement of card LB000023
!CHECK 221121.40 | 000026.03 50 | line 26 SC,$1,$6 -COMPUTE
!CHECK 221122.00 | 221124.70 40 | line 27 BZXCZ,JJSKP1 -LASTADDRESS WHEN UNDER -- the mnemonic assembles, so the ELIMINATOR rung is SILENT here and the spelling rests on the ink; the operand 221124.70 is JJSKP1's 221124.40 plus .30
!CHECK 221122.40 | 000000.51 04 | line 28 KVI,4,.32 -BLOCK CONTROL -- bit-identical to lines 19 and 35
!CHECK 221123.00 | 000021.32 80 221143.34 02 | line 29 BB,$1.26,BCW ERR -TEST MULTI BIT -- the operand is printed WITH A BLANK and is written that way here; it is the same symbol as lines 7 and 30 spell closed up
!CHECK 221124.00 | 221143.32 C2 | line 30 BXE,BCWERR -BR IF DISK CW IS ZERO
!CHECK 221124.40 | 000001.15 0D | line 31 JJSKP1 V-I,6,1.
!CHECK 221125.00 | 000026.00 80 022023.20 10 | line 32 +(BU,18),$6,38 -BLOCK CONTROL -- THIS LOCATION CARRIES THE PAGE'S SECOND UNEXPLAINED ASTERISK
!CHECK 221126.00 | 221142.40 80 | line 33 SIC,JADOUT -- first statement of card LB000031; the O is CLOSED here and open on line 24
!CHECK 221126.40 | 221140.50 00 | line 34 B,JADIN -- second statement of card LB000031
!CHECK 221127.00 | 000000.51 04 | line 35 JDISCK KVI,$4,.32 -IF DISK, NO
!CHECK 221127.40 | 221131.72 C2 | line 36 BXE,JPICK1 -CHAINING
!CHECK 221130.00 | 000021.03 70 | line 37 SR,$1,$1 -CHAINED ADDR.
!CHECK 221130.40 | 221131.63 40 | line 38 BZXF,JPICK1 -END OF CHAIN
!CHECK 221131.00 | 221112.00 48 | line 39 CB,$0,JMORCW -- reads line 14's location back as 221112.00
!CHECK 221131.40 | 000035.00 30 | line 40 JPICK1 LV,0,$13 -- the printed index field reads C and can only hold a digit, so it is 0; mcp_ocr reads this LOCATION as 221131.46 and the eye and the arithmetic both say 221131.40
!CHECK 221132.00 | 000003.01 05 | line 41 V+I,0,3.
!CHECK 221132.40 | 000003.41 3C | line 42 SV,0,3.32($12) -CW ADD IN FET TO LAT -- the byte's low nibble is the index, 12 = 0xC, which is what settles 3C against 30.  THIS IS THE LAST ROW THE SURVEY AND mcp_ocr SEE; the page runs twelve rows further
!CHECK 221133.00 | 221133.00 80 000000.06 70 | line 43 JPICK LF(BU,64),$ -INITIAL CW -- the "$" is this row's own location, so the address half word is a self-check on the counter: it prints 221133.00, the location column's own value
!CHECK 221134.00 | 400000.00 80 406024.06 70 | line 44 LFI(BU,6),(2)100000,40 -SET STATUS BITS -- (2)100000 is 6 bits left-justified in the 24-bit A24 field, which is bit 8388608 = word 0o400000 bit 0, exactly as printed
!CHECK 221135.00 | 777776.67 82 001023.46 70 | line 45 LF(BU,1),-1.09($2),39 -SEOP BIT -- -(64+9) bits as a 24-bit bit address is 16777143 = word 0o777776 bit 0o67; no other low digit than 9 gives the printed 777776.67
!CHECK 221136.00 | 000003.00 8D 000000.12 F0 | line 46 SF(BU,64),SCW($13) -CW TO FAT SLOTS -- S CW is printed p.102's (BU,64) at word 3
!CHECK 221137.00 | 000004.00 8D 000000.12 F0 | line 47 SF(BU,64),SCCW($13) -- S CCW is printed p.102's (BU,64) at word 4
!CHECK 221140.00 | 221140.10 00 | line 48 B1RA B,$ -EXIT PRESET BY SIC -- a branch to its own location, so the operand half word is a second reading of the location column; decks p.151 and p.153 both SIC this symbol and a SIC prints the full 24-bit address, so they pin it to the bit at 221140.00 and agree with this row
!CHECK 221140.40 | 000011.32 80 023023.23 10 | line 49 JADIN KF(BU,19),SLOWA,38 -TEST ADDR. FOR -- THIS LOCATION CARRIES THE PAGE'S THIRD UNEXPLAINED ASTERISK; the address half word 000011.32 is S LOWA's own printed value on line 55
!CHECK 221141.40 | 000011.55 80 023023.23 50 | line 50 KFR(BU,19),SUPPB,38 -RANGE -- the address half word 000011.55 is S UPPB's own printed value on line 56
!CHECK 221142.40 | 221142.76 C2 | line 51 JADOUT BAE,$ -AE WHEN OK -- branch to its own location, so .76 is 221142.40 plus BAE's .36
!CHECK 221143.00 | 010007.35 01 | line 52 BCWERR LVI,$14,SCWINV -- S CWINV is printed p.107 line 12's SYN,(16)1007.0, !SYM 010007.00
!CHECK 221143.40 | 217451.40 80 | line 53 SIC,S DISIC -- first statement of card LB000050; a SIC prints the full 24-bit bit address, so this row is a BIT-EXACT reading of S DISIC at 217451.40, agreeing with the four landed decks that SYN it there
!CHECK 221144.00 | 217372.10 00 | line 54 B,S DISP -- second statement of card LB000050; .10 is S DISP's .00 plus B's .10.  LAST EMITTING ROW OF THE PAGE, a HALF word, SO THE COUNTER LEAVES AT 221144.40 -- which is Z STEVL, the symbol TEN landed decks SYN at (8)221144.40, so printed p.182 must open there
