B3MCP   BZB,SCHOP($10),KDONE         ! line 13
        KVI,$4,.32                   ! line 14
        BXE,KCBUSY                   ! line 15  -IF DISK, WAIT FOR EOP
        BB,SSETUP($11),B3FAT         ! line 16
        BB,SSEL($11),B3FAT           ! line 17
        KV,13,SFIAAC($12)            ! line 18
        BZXE,B3FAT                   ! line 19  -IF NOT EQUAL TO FILE AREA TABLE
B3TRY   LCI,$X6,3.0                  ! line 20  -TO TRY CCW 3 TIMES
        CCW,0.0($14),0.0($1)         ! line 21
        LF(BU,1),3.24($13)           ! line 22  -SEOP BIT
        SF(BU,1),0.24($1)            ! line 23
        BZEKJZ,KSUPP                 ! line 24
        CB,6,B3TRY+.32               ! line 25
        B,KREJT                      ! line 26  (same card as 25)
B3ER1   LVI,14,SCCWAD                ! line 27  -CW DEST ADDR INVALID
        SIC,SDISIC                   ! line 28
        B,SDISP                      ! line 29  (same card as 28)
KDONE   KVI,4,1.32                   ! line 30  -IS EQUIPMENT READER
        BXE,B3TRY                    ! line 31  -IF SO, CCW
B3FAT   LX,0,SCCW($13)               ! line 32  -COPIED CW TO DEST ADDR
        SX,0,0.0($1)                 ! line 33
