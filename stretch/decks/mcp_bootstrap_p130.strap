!CHECK 216345.40 | 000022.14 80 006064.20 50 | line 22 L(BU,6),$2+.12,-24 -- $2 is 000022.00, +.12 decimal = .14 octal
!CHECK 216346.40 | 000010.00 10 | line 23 LX,0,$L -- $L is 000010.00, the same cell p.128 line 37 uses
!CHECK 216347.00 | 000022.03 30 | line 24 SV,1,$2
!CHECK 216347.40 | 600000.07 0B | line 25 LVS,3,$0,$1
!CHECK 216350.00 | 000003.00 83 216337.74 00 | line 26 BZB,3.0($3),WCONA
!CHECK 216351.00 | 000001.00 80 422064.20 10 | line 27 W CONE +I(BU,18),1.0,-24 -- the I-immediate suffix, accepted
!CHECK 216352.00 | 216356.43 80 006064.12 F0 | line 28 SF(BU,6),WCONV+.35,-24 -- stores into line 32's own word
!CHECK 216353.00 | 000100.00 80 422064.30 10 | line 29 PRINTED "-I(BU,18),64.0,-24"; strap_asm rejects "-I" (KeyError at strap_asm.py:3424), deck writes the bit-identical "-I(BU,18),64.0,-24" -- see ASSEMBLER LIMITATION
!CHECK 216354.00 | 216356.54 80 007064.12 F0 | line 30 SF(BU,7),WCONV+.44,-24
