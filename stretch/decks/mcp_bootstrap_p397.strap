! mcp_bootstrap_p397.strap -- MCP printed page 397: the $EOJ program's
! special-BSS branch (KFI,YBSSID .. B,TJUNAS) and its data: the XWs
! YPPDKS / YDKCRS / YPPBSD, the YTWSTA blank word, YCIDBT, and the
! NOLIST / NOPUNCH alphabetic words.
!
! docs/MCP_Mar63_250-445.pdf PDF p.147, read at 400 dpi, 900 dpi for
! the name column.  Header, READ: "TIME CLOCK 00054041  PUNID 22$EOJ
! CARD ID ZA000763  DIST. OF 3/01  3/01  PAGE NUMBER 397"; the heading
! row's LOCATION field is 021044, line 1's word.
!
! >>> NOT SCOMD. <<<  PUNID 22$EOJ, card series ZA, low core (02104x-
! 02106x).  No SLC printed on the page -- the origin below is line 1's
! printed LOCATION.  No TAIL.
!
! THE PAGE.  23 lines, every line number prints a "*"; a "*" after the
! LOCATION on line 11.  Contiguous 021044.00 .. 021062.00 (line 23's
! (AX)DD(BU,48,6), ending at 021062.60), then blank paper.  Line 10 is
! a DDI at "000000.00+" and occupies nothing; line 22's CNOP takes
! 021061.41 to 021062.00.  No remark-only lines.
!
! >>> LINE 10'S DDI IS NOT HANDED TO THE ASSEMBLER. <<<  It prints
!   10*  000000.00+  +00622222   BU,22 ,06   YBSSID  (AX)DDI(BU,18,6),BSSX
! (the dds printed in octal: 22 = 18 bits, 06 = byte size 6).  strap_asm
! refuses DDI; as decks/mcp_bootstrap_p226.strap does for VD15, the
! deck carries a stand-in "YBSSID SYN(BU,18,6), (8)622222" -- the
! printed value -- so line 1's KFI,YBSSID can assemble (622222.00 80:
! the 18-bit immediate LEFT-justified in the address).  It is NOT the
! printed card.
!
! >>> CARD SERIALS. <<<  ZA000763 .. ZA000785, one per line, no gaps
! and no repeats.
!
! GLYPHS.
!  * "KSILC+8." (line 3) is KSILO (landed p.171 DR); 220461 = 220451+8.
!  * "YUKCRS"/"YLKCRS" (line 17): the second glyph at 900 dpi has a
!    straight left stem and a faint right bow -- a worn D, written
!    YDKCRS.  Nothing on the page references it; the "C" after K is
!    open and stays C (no closed glyph; unsettled C/O).
!  * "YCIDBT" (line 20): C open, D closed; written as printed, C
!    unsettled (no reference on this page).
!  * "YNCPUN" (line 23): written YNOPUN (its value is NOPUNCH; the
!    $EOJ staging decks' stand-ins and C22-6728 spell YNOPUN).
!  * "SYSMCD" (lines 6, 11): SYSMOD, landed p.103; binary 215001.10.
!  * Octal fields' open rounds ("021C52.36", "C00002.00+") are 0.
!    Line 2's hex "C0" is a real C0 (BZAE assembles it); line 9's
!    "C0" prints the same open round and is 00 -- B,TJUNAS has no
!    index, and lines 13 and 15 print the identical card as "00".
!
! The data cards' blanks are DATA (entry mode): "NOLIST  X" carries two
! blanks and "NOPUNCH X" one, to fill 8 six-bit characters each.
!
! STAND-INS:
!   YBSSID  this page's DDI (line 10), value as printed -- see above.
!   KSILO, SYSMOD  landed p.171 / p.103.
!   TJUNAS  copies the staging stand-in (023006.0, half word only).
!   YL1, WJ4PFF, YC4B5, YTSP  $EOJ instruction labels (staging decks:
!           YL1 SV, WJ4PFF BZBZ, YC4B5 SIC, YTSP NOP), (BU,32,8).

YBSSID  SYN(BU,18,6), (8)622222      ! STAND-IN for line 10's DDI -- see header
KSILO   SYN(BU,64), (8)220451.0      ! landed p.171 DR(BU,64),(K QUANT); LX line 3 KSILO+8. 220461.34
YL1     SYN(BU,32,8), (8)020120.40   ! $EOJ SV label; LVI line 5 020120.77, half word only
SYSMOD  SYN(BU,2), (8)215001.10      ! landed p.103 line 18 SYN(BU,2),SCOMRG+.8; BB line 6 215001.10
TJUNAS  SYN, (8)023006.0             ! not landed; B line 9 023006.10, half word only
WJ4PFF  SYN(BU,32,8), (8)020274.40   ! $EOJ BZBZ label; LVI line 7 020274.77, half word only
YTSP    SYN(BU,32,8), (8)020317.40   ! $EOJ NOP label; CM1111(BU,1) line 8, BIT-EXACT
YC4B5   SYN(BU,32,8), (8)020111.40   ! $EOJ SIC label; LVI line 14 020111.77, half word only

        SLC, (8)021044.00
        KFI,YBSSID                                           ! line  1
        BZAE,YBB                                             ! line  2
        LX,$14,KSILO+8.                                      ! line  3  -TAKE P.+. LIMITS FROM KSILO
        LX,$13,YPPBSD                                        ! line  4  -SO JC WILL LOOK AT FIRST CARD OF AN ARC
        LVI,$15,YL1                                          ! line  5
        BB,SYSMOD,TJUNAS                                     ! line  6  -IF BYPASS
        LVI,$15,WJ4PFF                                       ! line  7  -IF OVERLAP
        CM1111(BU,1),YTSP                                    ! line  8  -SET UP FOR SPEC. BSS CASE
        B,TJUNAS                                             ! line  9
! YBSSID (AX)DDI(BU,18,6),BSSX                               ! line 10  NOT ASSEMBLED (DDI refused) -- see header
YBB     BB,SYSMOD,$+2.0                                      ! line 11
        LVI,$15,WJ4PFF                                       ! line 12
        B,TJUNAS                                             ! line 13
        LVI,$15,YC4B5                                        ! line 14
        B,TJUNAS                                             ! line 15
YPPDKS  XW,2.,34,0,7                                         ! line 16
YDKCRS  XW,-15.,0,0,7                                        ! line 17  printed "YUKCRS" -- worn D
YPPBSD  XW,-13.,34,0,7                                       ! line 18  -SO JC WILL LOOK AT FIRST CARD OF AN ARC
YTWSTA  (AX)DD(BU,48,6),))))))))X                            ! line 19
YCIDBT  DD(BU,1),(2)0                                        ! line 20
YNLST   (AX)DD(BU,48,6),NOLIST  X                            ! line 21
        CNOP                                                 ! line 22
YNOPUN  (AX)DD(BU,48,6),NOPUNCH X                            ! line 23  printed "YNCPUN"

!SYM YBB    021052.00
!SYM YPPDKS 021055.00
!SYM YDKCRS 021056.00
!SYM YPPBSD 021057.00
!SYM YTWSTA 021060.00
!SYM YCIDBT 021060.60
!SYM YNLST  021060.61
!SYM YNOPUN 021062.00
!CHECK 021044.00 | 622222.00 80 422600.23 10 | line 1 KFI,YBSSID
!CHECK 021045.00 | 021052.36 C0 | line 2 BZAE,YBB
!CHECK 021045.40 | 220461.34 10 | line 3 LX,$14,KSILO+8. (printed "KSILC")
!CHECK 021046.00 | 021057.32 10 | line 4 LX,$13,YPPBSD
!CHECK 021046.40 | 020120.77 01 | line 5 LVI,$15,YL1
!CHECK 021047.00 | 215001.10 80 023006.34 02 | line 6 BB,SYSMOD,TJUNAS
!CHECK 021050.00 | 020274.77 01 | line 7 LVI,$15,WJ4PFF
!CHECK 021050.40 | 020317.40 80 001000.36 F0 | line 8 CM1111(BU,1),YTSP
!CHECK 021051.40 | 023006.10 00 | line 9 B,TJUNAS (byte prints "C0": open round = 0, no index)
!CHECK 021052.00 | 215001.10 80 021054.34 02 | line 11 YBB BB,SYSMOD,$+2.0 (a "*" prints after the location)
!CHECK 021053.00 | 020274.77 01 | line 12 LVI,$15,WJ4PFF
!CHECK 021053.40 | 023006.10 00 | line 13 B,TJUNAS
!CHECK 021054.00 | 020111.77 01 | line 14 LVI,$15,YC4B5
!CHECK 021054.40 | 023006.10 00 | line 15 B,TJUNAS
!CHECK 021055.00 | 000002.00+ 111 000042 000000 | line 16 YPPDKS XW,2.,34,0,7
!CHECK 021056.00 | 000017.00- 111 000000 000000 | line 17 YDKCRS XW,-15.,0,0,7
!CHECK 021057.00 | 000015.00- 111 000042 000000 | line 18 YPPBSD XW,-13.,34,0,7
!CHECK 021060.60 | 0 | line 20 YCIDBT DD(BU,1),(2)0 | 1
