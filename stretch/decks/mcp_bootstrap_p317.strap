! mcp_bootstrap_p317.strap -- MCP printed page 317: DISK FETCH, the
! two-word search X 2WD LK / X VFL LK / X GOBAK, the restart-area and
! compiled-program fetches (XTRCT R, XTRCT C), the read C READ / C RD BR,
! the index read C NDX F, and the routine's data (YNRBIT, the control
! words C NDX CW / CW DC RD, the X TENTB SYNs, A DSK RD, the VFs).
!
! docs/MCP_Mar63_250-445.pdf PDF p.68, read at 400 dpi, doubtful glyphs
! at 900 dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 11D11MCP  CARD
! ID SB000256  DIST. OF 3/C1  3/01  PAGE NUMBER 317"; the heading row's
! LOCATION field is 234150, line 1's word.
!
! THE PAGE.  56 lines; every line number prints a "*".  No TAIL card.
! "*" after the LOCATION on lines 5, 24, 40, 51.  Code is contiguous
! from 234150.00 (line 1) to 234212.00 (line 55, VF; next 234212.40,
! which is X N FOST's landed stand-in address -- p.318 should open
! there).  Lines 49, 50, 56 are SYNs on X TENTB (233670.40, 233672.00,
! 233674.40) and do not move the counter.
!   line 46  YNRBIT DD(BU,1),0 at 234205.40 prints "0" left of NAME.
!   line 51  A DSK RD DRZ(BU,1),1 prints 000000.01: the reservation's
!            SIZE (one bit), no !CHECK (printed pp.84, 109, 119
!            convention); line 52's 234210.40 confirms it.
! JOIN.  p.316 has no scratch deck: contiguity with it is NOT
! established here (p.316 should end at 234150.00).
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * line 5 "X GCBAK - C.32" = XGOBAK-0.32: lines 8 and 12 print
!     GOBAK with the O plain; 234155.50 = 234156.00 - .32 + B's 8 bits.
!   * lines 23, 35 "B, C MCP" = B,DMCP (D stem worn; 000040.10, and line
!     17 prints "B,D MCP" whole).  Line 24 ",DLCCS" = DLOCS (000003.01).
!   * lines 27, 28 "CMOCOO" = CM0000 (connective digits; as p.313).
!   * lines 26 ", C", 38 ",0", 52 "VF,C", 48 "512, C": the open round
!     glyph alone is the digit 0 (no MCP symbol "C"; rows print zeros).
!     Lines 53-55 print "VF, 0" with the round closed.
!   * line 29 "CW DC RD" = CWDCRD (p.312/313 spelling; line 48's label).
!   * line 22 "XTRCT C": the last glyph is a real C at 900 dpi (terminals
!     as the first C), not a worn D.
!   * hex bytes "FC" (16, 27, 28), "DO" (15, 34), "AC" (29) are F0, D0,
!     A0: the same open round as the 0s of the octal fields beside them;
!     TI's low nibble is I2 and no second index is printed (as p.313
!     line 36).  Octal-field rounds are 0.
!   * line 48's printed control-word flag field "C00" is 000.
!   * names spaced by the drum written closed up.
!
! CARD SERIALS.  SB000256 .. SB000306.  Shared serials: lines 1-2
! (256), 3-4 (257), 8-9 (261), 30-31 (282), 42-43 (293).  None skipped.
! p.313 ended at SB000126; pp.314-316 lie between.
!
! EXTERNALS.  CBUFF, CLUK, CDSKBF, CINDEX, CWRD, PROSA copy the p.312 /
! p.313 stand-ins; XTENTB and CSCNOP are p.311's definitions.

DMCP    SYN, 32.0                    ! landed p.108 "D MCP SYN,32.0"; B lines 17, 23, 35 000040.10
DRD     SYN, 1.0                     ! landed p.104 "D RD"; line 18 000001.00
DLOCS   SYN, 3.01                    ! landed p.104 line 15 "D LOC S"; lines 24, 36 000003.01
PROSA   SYN, 1.0                     ! not landed; p.313 form; lines 19, 25, 37 000001.00, BIT-EXACT
CBUFF   SYN, (8)234214.0             ! not landed; p.313 form; CM0000 l.27 / SF l.39 234214.00, BIT-EXACT
CLUK    SYN, (8)234402.0             ! not landed; p.313 form; CM0000 l.28 / ST l.40 234402.00, BIT-EXACT
CDSKBF  SYN, (8)235464.0             ! not landed; L l.33 CDSKBF+3.0 = 235467.00, XW l.48 235464.00
CINDEX  SYN, (8)234222.0             ! not landed; p.312 form; CW l.47 234222.00
CWRD    SYN, (8)234416.0             ! not landed; p.313 form; ,CWRD l.20 234416.00, TI l.29/41 .02
XTENTB  SYN(BU,45), (8)233667.00     ! staged p.311 line 6 DD(BU,45); SYNs l.49/50/56
CSCNOP  SYN(BU,64,8), (8)233700.40   ! staged p.311 line 13 BBZ; B l.45 CSCNOP+1.0 = 233701.50

        SLC, (8)234150.00
X2WDLK  KV,3, 0.0($5)                                        ! line  1
        BXE, XVFLLK                                          ! line  2  -SEQUENTIAL SEARCH
        V+IC,5,2.0                                           ! line  3
        BZXCZ, X2WDLK                                        ! line  4  -COMPARE VFS FIRST
        B, XGOBAK - 0.32                                     ! line  5
XVFLLK  SX,3, $L                                             ! line  6
        K(BU,48),0.0($5), -48                                ! line  7  -THEN COMPARE FULL 48 BITS
        BAE, XGOBAK                                          ! line  8
        V+IC,5, 2.0                                          ! line  9
        BZXCZ, $-2.0                                         ! line 10
        LVI,5, 0.0                                           ! line 11
XGOBAK  B, $                                                 ! line 12
XTRCTR  BEW, $                                               ! line 13  -ROUTINE FOR FETCHING RESTART AREA
CREAD   LI(BU,24),20.,1                                      ! line 14
        ST(BU,25),CUKCNT                                     ! line 15
CRD1    CM1111(BU,1),ADSKRD                                  ! line 16
        B,DMCP                                               ! line 17
        ,DRD                                                 ! line 18
        ,PROSA                                               ! line 19
        ,CWRD                                                ! line 20
CRDBR   B,$                                                  ! line 21
XTRCTC  BEW, $                                               ! line 22  -DITTO COMPILED PROGRAM
CNDXF   B, DMCP                                              ! line 23  -LOCATE FIRST ARC OF DICT
        ,DLOCS                                               ! line 24
        , PROSA                                              ! line 25
        , 0                                                  ! line 26
        CM0000(BU,12),CBUFF                                  ! line 27
        CM0000(BU,18),CLUK                                   ! line 28
        TI,1,CWDCRD,CWRD                                     ! line 29  -READ 1ST ARC OF DICT INTO BUFFER
        SIC,CRDBR                                            ! line 30
        B,CREAD                                              ! line 31
        BB,ADSKRD,$                                          ! line 32
        L(BU,12), CDSKBF + 3.0, -18                          ! line 33  -LOAD ARC ADDRESS OF INDEX
        ST(BU,18), $ + 2.32, -18                             ! line 34  -AND STORE IT IN CALLING SEQUENCE
        B, DMCP                                              ! line 35  -LOCATE ARC HOLDING INDEX
        ,DLOCS                                               ! line 36
        , PROSA                                              ! line 37
        ,0                                                   ! line 38
        SF(BU,12),CBUFF,-18                                  ! line 39
        ST(BU,18),CLUK,-18                                   ! line 40
        TI,1,CNDXCW,CWRD                                     ! line 41
        SIC,CRDBR                                            ! line 42
        B,CREAD                                              ! line 43  -READ INDEX INTO CORE
        BB,ADSKRD,$                                          ! line 44
        B, CSCNOP + 1.0                                      ! line 45  -RETURN TO BEGINNING OF ROUTINE
YNRBIT  DD(BU,1),0                                           ! line 46  -TO PREVENT A READ.
CNDXCW  CW, CINDEX,40,0                                      ! line 47
CWDCRD  XW, CDSKBF, 512, 0                                   ! line 48  -CONTROL WORD FOR DICTIONARY READ
CNORM   SYN(BU,24), XTENTB + 1.32                            ! line 49
CSARTY  SYN(BU,48), XTENTB + 3.0                             ! line 50  -TYPE-AREA IN CALLING SEQUENCE
ADSKRD  DRZ(BU,1),1                                          ! line 51
CUKCNT  VF,0                                                 ! line 52
CBETA   VF, 0                                                ! line 53  -RELATIVE AREA FWA
CGAMMA  VF, 0                                                ! line 54  -CORE FWA
CN      VF, 0                                                ! line 55  -NUMBER OF WORDS REQUESTED
CNPRIM  SYN(BU,24), XTENTB + 5.32                            ! line 56  -NUMBER OF WORDS READ FROM DISK

