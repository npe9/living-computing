!CHECK 216620.40 | 000000.70 8A 003000.00 F0 | line  9 P CON E1 CM0000(BU,3), S UNIT($10) -- printed form, assembles as printed
!CHECK 216621.40 | 000000.04 3A | line 10 LV,$2,0($10)
!CHECK 216622.00 | 000000.47 82 001000.00 F0 | line 11 CM0000(BU,1),S SEL($2) -- printed form, assembles as printed
!CHECK 216623.00 | 000001.47 82 001000.36 F0 | line 12 CM1111(BU,1),S SEL+1.($2) -- printed blanks + operator rejected; deck writes SSEL+1.
!CHECK 216624.00 | 000000.26 3A | line 13 P RENT LV,$11,S UN A($10) -- printed S UN A rejected in an address field; deck writes SUNA
!CHECK 216624.40 | 000000.30 3B | line 14 LV,$12,S UN A($11) -- printed S UN A; deck writes SUNA
!CHECK 216625.00 | 216633.35 D0 | line 15 SVA,$14,WRESL1
!CHECK 216625.40 | 216633.00 80 000004.02 AC | line 16 TI,1,WRESL1,SIOINS($12)
!CHECK 216626.40 | 000000.32 8A 001000.36 F0 | line 17 CM1111(BU,1),SCHOP($10),0 -- printed CLOSED UP, no substitution; the trailing ,0 is printed and was tested, not dropped
!CHECK 216627.40 | 000000.37 8B 001000.36 F0 | line 18 CM1111(BU,1),SSETUP($11),0 -- printed closed up
!CHECK 216630.40 | 000000.71 8B 001000.36 F0 | line 19 CM1111(BU,1),SRD($11),0 -- printed closed up
!CHECK 216631.40 | 216644.37 01 | line 20 LVI,$15,PCONE2
!CHECK 216632.00 | 000005.37 3C | line 21 SV,$15,SRETAD($12)
!CHECK 216632.40 | 000000.30 00 | line 22 CNOP
!CHECK 216633.00 | 000000.00 80 216635.01 00 | line 23 WRESL1 RD,0,WPCW -- location carries the second asterisk
!CHECK 216634.00 | 216242.03 01 | line 24 LVI,$1,KSUPP -- KSUPP from p.128; offset within the half word unobservable
!CHECK 216634.40 | 221261.10 00 | line 25 B,MIOREJ -- MIOREJ back-derived here; half word 0 observed, bit within it is not
!CHECK 216635.00 | 216743.00+ 000 000015 216635 | line 26 WPCW CW,PTEMBF,13,WPCW -- 000015 is 13 decimal; the refill is WPCW itself
!CHECK 216636.00 | 217024.03 01 | line 27 P EPGK E LVI,$1, P EPGK -- printed P EPGK rejected in an address field; deck writes PEPGK
!CHECK 216636.40 | 000004.05 01 | line 28 LVI,$2, 4.0
!CHECK 216637.00 | 216640.50 00 | line 29 B, P ERR EX -- printed P ERR EX rejected; deck writes PERREX
!CHECK 216637.40 | 217030.03 01 | line 30 LVI,$1,PUK
!CHECK 216640.00 | 000004.05 01 | line 31 LVI,$2,4.0
!CHECK 216640.40 | 215470.40 80 | line 32 P ERR EX SIC, S COM IC -- deck writes SCOMIC; the .40 half word IS checked here
!CHECK 216641.00 | 215470.10 00 | line 33 B , S COMM -- deck writes SCOMM; same word, half word 0
!CHECK 216641.40 | 000000.00 81 | line 34 ,0($1) -- a statement with an EMPTY operation field; strap_asm accepts the printed form and emits 81
!CHECK 216642.00 | 000000.00 82 | line 35 ,0($2) -- printed form, accepted
!CHECK 216642.40 | 216242.10 00 | line 36 B, K SUPP -- printed K SUPP rejected; deck writes KSUPP
!CHECK 216643.00 | 216624.06 C6 | line 37 BCSZ,PRENT
!CHECK 216643.40 | 216624.10 00 | line 38 B,PRENT -SAFETY FACTOR
!CHECK 216644.00 | 000000.37 8B 001000.00 F0 | line 39 P CON E2 CM0000(BU,1),SSETUP($11) -- no trailing ,0 here, and the bits differ from line 18 only in the connective
!CHECK 216645.00 | 000000.71 8B 001000.00 F0 | line 40 CM0000(BU,1),SRD($11)
!CHECK 216646.00 | 000000.32 8A 001000.00 F0 | line 41 CM0000(BU,1),SCHOP($10)
!CHECK 216647.00 | 215240.11 80 216636.34 06 | line 42 BBZ, STLR +8.9, P EPGK E -- deck writes PEPGKE; the printed 216636.34 is what proves the target is PEPGKE (216636.00) and not PEPGK (217024.00); location carries the second asterisk
!CHECK 216650.00 | 215240.12 80 216637.74 06 | line 43 BBZ,STLR+8.10,PERREX-1.0 -- 216637.74, leading 1 = the half-word select, so PERREX is at .40
!CHECK 216651.00 | 215240.15 80 216643.34 06 | line 44 BBZ,STLR+8.13,PCONE2-1.0
!CHECK 216652.00 | 215240.11 80 005031.20 50 | line 46 L(BU,5),STLR+8.9,50 -- the bare decimal bit offset 9 prints octal .11
!CHECK 216653.00 | 040000.00 80 404031.63 10 | line 47 KFI(BU,4),(2)0001,51 -- the three-operand KFI with an explicit offset; printed form, accepted
!CHECK 216654.00 | 216735.36 C0 | line 48 BZAE,G ODBOC -- deck writes GODBOC; the name is settled in the header, not guessed
!CHECK 216654.40 | 216745.77 80 216722.34 00 | line 50 BZB,P TEMBF+2.63,P PPRET -- deck writes PTEMBF/PPPRET; 63 decimal prints .77 octal
!CHECK 216655.40 | 216746.00 80 010000.06 70 | line 52 C0011(BU,8),P TEMBF+3.0 -- deck writes PTEMBF
!CHECK 216656.40 | 774000.00 80 410000.23 10 | line 53 KFI(BU,8),(2)1111 1110 -- >>> THIS ROW IS LEFT FAILING ON PURPOSE. <<< strap_asm reads the blank inside the radix literal as a term separator and computes (2)1111 + 1110 = 1125, giving 312000.00; the printed datum is 11111110 = 774000.00. (2)11111110 assembles correctly, and the identical statement at printed p.138 line 48 prints the identical bits. See the header.
!CHECK 216657.40 | 216736.76 C2 | line 54 BAE,P DBRET -- deck writes PDBRET; 216736.76, leading 1 = the half-word select, so PDBRET is at .40, which p.137 line 12 prints
!CHECK 216660.00 | 000000.26 3A | line 55 LV,$11,S UNA($10) -- the page spells the SAME symbol two ways, S UN A on line 13 and S UNA here, and both compile identically
!CHECK 216660.40 | 000000.30 3B | line 56 LV,$12,S UNA($11)
