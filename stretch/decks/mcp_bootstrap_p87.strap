! mcp_bootstrap_p87.strap -- MCP INITIALIZATION, printed page 87:
! THE DUMMY TABLES FOR THE UN-ASSIGNMENT.
! docs/MCP_Mar63_001-249.pdf PDF p.94, header "PAGE NUMBER 87".
!
! CONTIGUOUS AT BOTH ENDS.  printed p.86 ends at 004765.76 and this
! page's line 5 CNOP is at 004766.40; its last line, 26, is an XW at
! 005013.00, one word before printed p.88's first line -- 005014.00,
! which is T MOVE.
!
! >>> "T WORM" IS AN O AND NOT A C, AND THE GLYPH ALONE DOES NOT SAY
! SO. <<<  At 900 dpi the label at line 26 reads "T WCRM": its third
! character has a break in the upper right.  The REFERENCES at lines
! 16, 17, 22 and 23 print the same symbol with a closed round O,
! identical to the O in "T BOID" on the line above.  Cropped to the
! same magnification and set side by side, the label's glyph is a WORN
! O -- a C in this font has a far larger opening.  They must be one
! symbol, and the undamaged instances say which.
!
! That is the same hazard strap/mcp_crop.sh's header records for B
! against 8, in another pair: compare an ambiguous glyph against a
! known-good instance of each candidate in the same font and row,
! rather than deciding it in isolation.

        SLC, (8)4766.40

        CNOP                         ! line 5
TDSIO   VF, TCAT                     ! line 6
        VF, TBIRD                    ! line 7  -SAVE TAPES
        VF, TCOT                     ! line 8
        VF, TBOID                    ! line 9
TCAT    DRZ(N), 2                    ! line 11 -DUMMY UNIT AREA
TBIRD   DRZ(N), 2                    ! line 13 -DUMMY FILE AREA
        XW, (.31)3                   ! line 14 -SET TO SAVE
        DRZ(N), 3                    ! line 15 -MORE FOR THE ...
        VF, TWORM                    ! line 16
        VF, TWORM                    ! line 17
        DD(BU,7), (16)01             ! line 18
TCOT    DRZ(N), 2                    ! line 20
TBOID   DRZ(N), 6                    ! line 21
        VF, TWORM                    ! line 22
        VF, TWORM                    ! line 23
        DD(BU,7), (16)01             ! line 24
TWORM   XW, (.26)3                   ! line 26 -THE DUMMY REEL POOL

