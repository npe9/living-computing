! line  8  -
LPPURF  XW,TPURFT,TUPPC,$                                    ! line  9  -NOT OVERLAP PP REF. TBL.
        XW,TUIORQ,TUIOC,$                                    ! line 10  -NOT OVERLAP I/O REQ. TBL.
        XW,TUFRE,TUFRC,$                                     ! line 11  -NOT OVERLAP FIRST REEL TBL.
LPPREF  XW,TPREFT,TPPC,$                                     ! line 12
LIOTBX  XW,TIOREQ,TIOC,$                                     ! line 13  printed "LICTBX"
LFSTRX  XW,TFSTRE,TFRC,$                                     ! line 14
LSYMUX  XW,LSYMU,32-2,$                                      ! line 15  -SYMBOLIC TAPE INDEX REFILL
LSYMCX  XW,LSYMC,16-2,$                                      ! line 16  -SYMBOLIC CHANNEL INDEX REFILL
LNTPUX  XW,LNTPU,16-2,$                                      ! line 17  -NON-TAPE INDEX REFILL
LXTYPE  XW,LDISK,9,$                                         ! line 18  -THE TYPE CODE INDEX
! line 19  -------------------------------------------------------------
! line 20  -          SWAP AREA FOR EIGHT MCP-DECODE INDICES.
! line 21  -
LTY     XW                                                   ! line 22  ("*" after the location)
        XW,TPREFT,TPPC,LPPREF                                ! line 23
        XW,TIOREQ,TIOC,LIOTBX                                ! line 24  printed "TICREC,TIOC,LICTBX"
        XW,TFSTRE,TFRC,LFSTRX                                ! line 25
        XW,LSYMU,32-2,LSYMUX                                 ! line 26
        XW,LSYMC,16-2,LSYMCX                                 ! line 27
        XW,LNTPU,16-2,LNTPUX                                 ! line 28
        XW                                                   ! line 29
! line 30  -------------------------------------------------------------
! line 31  -          TABLE INDICES
! line 32  -
LIODX   SYN,$3                                               ! line 33  -INDEX FOR GETTING IOD IMAGE
LXPP    SYN,$4                                               ! line 34  -P.P. REFERENCE TABLE INDEX
LXIO    SYN,$5                                               ! line 35  -I.O. REQUEST TABLE INDEX
LXFR    SYN,$6                                               ! line 36  -FIRST REEL NUMBER TABLE INDEX
LXSU    SYN,$7                                               ! line 37  -SYMBOLIC TAPE UNIT TABLE INDEX
LXSC    SYN,$8                                               ! line 38  -SYMBOLIC CHANNEL TABLE INDEX
LXNT    SYN,$9                                               ! line 39  -NON-TAPE TABLE INDEX
LWORKX  SYN,$10                                              ! line 40  -WORKING INDEX
! line 41  -------------------------------------------------------------
! line 42  -          COUNTERS AND BITS
! line 43  -
LNO6    VF,.06                                               ! line 44  -FOR IX BUMMPING (sic)
LTAPEC  DRZ(BU,7),(1)                                        ! line 45  -TAPE REEL COUNTER ("*" after the location)
LIOSCR  DRZ(BU,9),(1)                                        ! line 46  -IODSQ COUNTER
LFINB   DD(BU,1),1                                           ! line 47  -FINAL BIT
LNTB    DD(BU,1),0                                           ! line 48  -NON-TAPE BIT
LCOUNT  DRZ(BU,7),(1)                                        ! line 49  -COUNT OF RLSYMS
LOVBIT  DD(BU,1),0                                           ! line 50  -OVERLAPPED JOB BIT (printed "L CVBIT")
LBLZOR  (AX)DD(BU,8,8),0X                                    ! line 51  -BCD-8ZERO (printed "L BLZCR")
LINFAD  DD(BU,1),0                                           ! line 52  -INFINITE-DISK ADDRESS

