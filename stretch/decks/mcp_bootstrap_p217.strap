        KF(BU,48),RJOB                                       ! line 25
        BAE,RBREAK                                           ! line 26
        KF(BU,48),RCOMD                                      ! line 27
        BZAE,RSWITC                                          ! line 28
RBREAK  LV,VT5,VS2                                           ! line 29
        BXVZ,VSC5                                            ! line 30  -0233
        SIC,(VP)                                             ! line 31
        CB+,VP,VNXT                                          ! line 32  -0234
        LVI,VS2,0                                            ! line 33  -0235
VSC5    LVNI,VT5,VNOP                                        ! line 34  -0236
        SIC,(VP)                                             ! line 35
        CB+,VP,VNX+VSC                                       ! line 36  -0237
        LVI,VU,VSC                                           ! line 37  -0238
VSC5A   SX,VS1,VTX                                           ! line 38  -0239
VSC1A   B,VSC7                                               ! line 39  -0240
        B,$.VH                                               ! line 40  -0241
        SX,VS2,VTX1                                          ! line 41  -0242
        SIC,SPRIMR                                           ! line 42
        BD,SPRIME                                            ! line 43  -0243
        ,SJC1                                                ! line 44  -0244
        BE,$.32                                              ! line 45  -0245
        BBZ,VSCR3.19,VSQ2                                    ! line 46  -0246
!                                                              line 47  NAME "-", no location  -0247
VSCR1   LVI,VU,VSC                                           ! line 48  -0248
        LX,VS1,VTX                                           ! line 49  -0249
        LX,VS2,VTX1                                          ! line 50  -0250

