! ---------------------------------------------------------------
! THE ROWS AS PRINTED BY THE DRUM, for anyone re-reading the scan:
! line  5 "COCCC1.13 C1", line 12 "COCCCO.13 CC", line 13
! "22C064.32 CC", line 30 "22C344.32 C2", line 35 "CCCCCO.45 CD",
! line 24's name "RECC" and line 28's "RNCECC".  Every one of those
! C's in an octal field is a 0; the hex bytes are argued in GLYPHS.
! ---------------------------------------------------------------

!SYM   RHD      220325.00
!SYM   RLD      220326.00
!SYM   RTAPE    220332.40
!SYM   REVEN    220334.40
!SYM   RODD     220335.40
!SYM   RECC     220340.00
!SYM   RNOECC   220342.00
!SYM   RSFMOD   220344.00
!SYM   RALLPS   220346.00
!CHECK 220325.00 | 000001.13 01 | line 5 RHD LVI,5,1.0 -- SFDEN code 01 = High density (C22-6728-1 printed p.271); printed "COCCC1.13 C1"
!CHECK 220325.40 | 220326.50 00 | line 6 B,RLD.32 -- internal forward reference; 0o50 = RLD's word + 32 bits + the branch's own 0o10
!CHECK 220326.00 | 000003.13 01 | line 7 RLD LVI,5,3.0 -- SFDEN code 11 = Low density; same card shape as line 5 with the datum changed
!CHECK 220326.40 | 000011.13 30 | line 8 SV,5,$R -- $R is register word 0o11; 0o13 is the index-5 field, identical on lines 21 and 32
!CHECK 220327.00 | 000002.33 8D 002027.20 D0 | line 9 ST(BU,2),SFDEN($13),46 -- first group is SFDEN's own address to the BIT (0o33 = 2.27); second group's bits 44-50 are 0101110 = 46; low nibble D is index $13
!CHECK 220330.00 | 000000.50 8B 001000.36 F0 | line 10 CM1111(BU,1),SVER($11) -- 001000.36 F0 is byte for byte what printed p.18 prints six times for CM1111(BU,1); 000000.50 checks SVER at 0.40
!CHECK 220331.00 | 000007.52 3C | line 11 LV,5,SFILEK($12) -- 0o52 = 0o40 (SFILEK's bit 32) + 0o12 (LV, index 5); the low nibble C is index $12 and is a REAL C, against line 12's dropped 0
!CHECK 220331.40 | 000000.13 0C | line 12 KVNI,5,0 -- printed "CC" and it is 0C: dropped leading zero, real C (see GLYPHS 1)
!CHECK 220332.00 | 220064.32 C0 | line 13 BZXE,KILEGL -- printed "CC" and it is C0, the OPPOSITE split from line 12; 0o32 is BZXE's own byte-address bits over KILEGL's .00
!CHECK 220332.40 | 000004.11 04 | line 14 RTAPE KVI,4,4.0 -- 0o11 is the index-4 immediate field; this card carries line 15 as its second statement (IN000013)
!CHECK 220333.00 | 220064.32 C0 | line 15 BZXE,KILEGL -- the same card as line 13 printed a second time on this page, same character positions, same ink verdict
!CHECK 220333.40 | 000015.47 01 | line 16 LVI,3,13.32 -- 0o15 = 13 decimal; 0o47 = 0o40 (bit 32) + 0o07 (index 3 immediate)
!CHECK 220334.00 | 220727.50 00 | line 17 B,KNI+1.0 -- K NI is not defined by any landed deck; this row is where its 220726.40 is read from (0o50 = half word 32 + the branch's 0o10)
!CHECK 220334.40 | 000002.13 01 | line 18 REVEN LVI,5,2.0 -- SFMODE code 10 = Even parity (C22-6678-1 printed p.10)
!CHECK 220335.00 | 220336.10 00 | line 19 B,RODD.32 -- lands on line 21, one half word into the RODD tail
!CHECK 220335.40 | 000003.13 01 | line 20 RODD LVI,5,3.0 -- SFMODE code 11 = Odd parity; printed name "RCCD" (O dropped, first D worn through)
!CHECK 220336.00 | 000011.13 30 | line 21 SV,5,$R -- identical to line 8 and line 32
!CHECK 220336.40 | 000002.60 8D 002027.20 D0 | line 22 ST(BU,2),SFMODE($13),46 -- 0o60 = 48 checks SFMODE at 2.48 to the bit; the second group is identical to line 9's, which is the ",46" checked twice
!CHECK 220337.40 | 220332.50 00 | line 23 B,RTAPE -- backward reference to line 14; 0o50 = RTAPE's .40 + the branch's 0o10
!CHECK 220340.00 | 000001.13 01 | line 24 RECC LVI,5,1.0 -- SFMODE code 01 = Odd parity with ECC; byte for byte line 5's word (this LOCATION carries the second asterisk)
!CHECK 220340.40 | 000004.11 04 | line 25 KVI,4,4.0 -- byte for byte line 14's word
!CHECK 220341.00 | 220342.72 C0 | line 26 BZXE,RNOECC.32 -- 0o72 = 0o40 (RNOECC + 32 bits) + 0o32 (BZXE), an internal forward reference that checks RNOECC's word
!CHECK 220341.40 | 220344.10 00 | line 27 B,RSFMOD -- forward reference to line 32, bit 18 clear
!CHECK 220342.00 | 000003.13 01 | line 28 RNOECC LVI,5,3.0 -- the SAME datum as RODD, because "no ECC" IS odd parity (C22-6678-1 printed p.10)
!CHECK 220342.40 | 000001.51 04 | line 29 KVI,4,1.32 -- 0o51 = 0o40 (bit 32) + 0o11 (index 4 immediate), against line 25's bare 0o11
!CHECK 220343.00 | 220344.32 C2 | line 30 BXE,RSFMOD -- THE DISCRIMINATOR FOR LINES 13/15/26: a clean closed 2 beside the C fixes BZXE/BXE's high nibble as a real C
!CHECK 220343.40 | 000002.11 04 | line 31 KVI,4,2.0 -- same operation as lines 25 and 29 with a third datum
!CHECK 220344.00 | 000011.13 30 | line 32 RSFMOD SV,5,$R -- the mode tail's first half word; identical to lines 8 and 21
!CHECK 220344.40 | 000002.60 8D 002027.20 D0 | line 33 ST(BU,2),SFMODE($13),46 -- line 22's card printed a second time on this page, identical in both groups
!CHECK 220345.40 | 220333.10 00 | line 34 B,RTAPE.32 -- RTAPE.32 rounds out of 220332.40 into 220333.00, which checks RTAPE's half word from the other side
!CHECK 220346.00 | 000000.45 0D | line 35 RALLPS V-I,2,.32 -- printed "CD" and it is 0D; printed p.168 line 6 carries the same card at 220350.40
!CHECK 220346.40 | 215265.05 30 | line 36 SV,2,STIC -- 0o05 is SV's index-2 field, so only STIC's word 215265 is observed here
!CHECK 220347.00 | 220017.50 00 | line 37 B,W23K -- bit 18 set agrees with W23K's 220017.40; the counter leaves this page at 220347.40
