!   line 19   220335.00    220336.10 00                           B,RODD.32                                               IN000017
!   line 20   220335.40    000003.13 01            RODD           LVI,5,3.0                                               IN000018
!   line 21   220336.00    000011.13 30                           SV,5,$R                                                 IN000019
