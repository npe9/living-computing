! ---------------------------------------------------------------
! THE CHECKS.  Thirteen !SYM -- every NAME this page prints -- and
! fifty !CHECK rows, one per printed line.  No line on this page is
! an SLC or any other pseudo-op that emits nothing, so 50 = 50.
! ---------------------------------------------------------------
!SYM   MED1     215535.00
!SYM   MED1A    215537.00
!SYM   MED2A    215543.00
!SYM   MR3AD    215546.00
!SYM   MTC1     215546.40
!SYM   MTC2A    215552.00
!SYM   MTC3     215557.00
!SYM   MTC3A    215562.40
!SYM   MTC3B    215563.00
!SYM   MTC4A    215564.40
!SYM   M9       215566.00
!SYM   MKMCPA   215566.40
!SYM   MMK2     215567.00
!SYM   SPRIME   215570.00
!SYM   SPRIMR   215571.00
!CHECK 215526.40 | 000002.05 31 | line  1 SV,$2,2.0($1)
!CHECK 215527.00 | 000000.00 81 004066.60 50 | line  2 L(BU,4),0.0($1),-19
!CHECK 215530.00 | 215265.04 30 | line  3 LV,2,S TIC
!CHECK 215530.40 | 000022.10 30 | line  4 LV,4,$2
!CHECK 215531.00 | 000010.04 B0 | line  5 V+,$2,$L
!CHECK 215531.40 | 000001.45 31 | line  6 SV,$2,1.32($1)
!CHECK 215532.00 | 215265.05 30 | line  7 SV,2,S TIC
!CHECK 215532.40 | 000021.34 80 022066.60 D0 | line  8 ST(BU,18),$1+.28,-19 (location carries an asterisk)
!CHECK 215533.40 | 000021.06 30 | line  9 LV,$3,$1
!CHECK 215534.00 | 215566.06 B0 | line 10 V+,$3,M 9
!CHECK 215534.40 | 000002.43 05 | line 11 V+I,$1,2.32
!CHECK 215535.00 | 000000.40 84 140000.20 50 | line 12 M ED 1 L(V+I)(BU,32),.32($4)
!CHECK 215536.00 | 000000.40 81 240000.20 D0 | line 13 ST(V+IC)(BU,32),.32($1)
!CHECK 215537.00 | 215546.70 46 | line 14 M ED 1A BXCZZ,M TC 1
!CHECK 215537.40 | 215637.06 B0 | line 15 V+,$3,M C 1
!CHECK 215540.00 | 000000.00 83 215535.34 00 | line 16 BZB,0.0($3),M ED 1
!CHECK 215541.00 | 215543.11 D0 | line 17 SVA,4,M ED 2A
!CHECK 215541.40 | 000000.51 05 | line 18 V+I,4,.32
!CHECK 215542.00 | 000021.00 80 215246.10 E0 | line 19 SWAPI,4,$1,S TLR+14.0
!CHECK 215543.00 | 215543.01 B0 | line 20 M ED 2A LVE,$0,$
!CHECK 215543.40 | 000021.00 80 215246.10 E0 | line 21 SWAPI,4,$1,S TLR+14.0
