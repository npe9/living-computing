RWEE    LV,VU,.32($13)                                       ! line 18
        LVI,$15,REBSP1                                       ! line 19
        B,DMCP                                               ! line 20
        VF,DSPFL                                             ! line 21  printed "CSPFL"
        LVE,,VSU(VU)                                         ! line 22
        B,RK4P32                                             ! line 23
RWBSP   LV,VU,0.32($13)                                      ! line 24
        LV,$15,VRCNT(VU)                                     ! line 25
        BZXVZ,REBSP1                                         ! line 26
        B,DMCP                                               ! line 27
        VF,DRD                                               ! line 28
        LVE,,VSU(VU)                                         ! line 29
        VF,RESKIP                                            ! line 30
        LVI,$15,RERDUK                                       ! line 31
        SVA,$15,3.32($13)                                    ! line 32
        LVI,$15,READ                                         ! line 33
        B,RTN                                                ! line 34
RERG    LC,$14,RETRY                                         ! line 35
        CBZ,$14,RENGJB                                       ! line 36
        SC,$14,RETRY                                         ! line 37
        B,DMCP                                               ! line 38
        VF,DERGS                                             ! line 39  printed "CERGS"
        LVE,,VSU(VU)                                         ! line 40  printed "VSL(VU)"
RERGBR  B,$                                                  ! line 41
RETEST  LV,$2,-1.0($13)                                      ! line 42
        BZXVZ,REREX                                          ! line 43
        LVI,$2,REDOBL                                        ! line 44
        SVA,$2,4.32($13)                                     ! line 45
        B,RESPAC                                             ! line 46
RENGJB  LVI,$14,RKC+1.0                                      ! line 47
        SVA,$14,RETRY                                        ! line 48
        CM1111(BU,1),RKCRWT.19                               ! line 49

