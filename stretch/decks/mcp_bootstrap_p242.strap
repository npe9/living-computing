        B,RWREST                                             ! line  5
RWTONG  LCI,$15,RKD+1.0                                      ! line  6  printed "RW TCNG"
        BZB1,REJJOB+.63,RWSTOR                               ! line  7
RWSBSP  LV,VU,0.32($13)                                      ! line  8
