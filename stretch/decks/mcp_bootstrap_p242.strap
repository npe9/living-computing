REREX   SYN(BU,32,8), (8)227612.40   ! p.243 (scratch) line 11 label of LVI (half word): (BU,32,8), C22-6531 printed p.10
REDOBL  SYN, (8)230265.40            ! LVI line 44 .45 = .40 + 2*2+1, this page's binary only
RESPAC  SYN(BU,32,8), (8)227613.40   ! p.243 (scratch) line 13 label of B (half word): (BU,32,8), C22-6531 printed p.10
RKC     SYN, 3.0                     ! as p.244 (scratch) writes it, volume OCR "RKC SYN, 3.0"; LVI line 47 RKC+1.0 = 000004
RKCRWT  SYN(BU,32,8), (8)227642.0    ! p.243 (scratch) line 56 label of NOP (half word); CM1111 line 49 .19 = 227642.23, BIT-EXACT

        SLC, (8)227552.0
        Z,RWEXIT-2.0                                         ! line  1  printed "-2.C"
RWSET   LVI,$15,RWEE                                         ! line  2
        SVA,$15,RWEXIT+3.32                                  ! line  3
