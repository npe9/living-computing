        SIC,RERGBR                                           ! line 10
        B,RERG                                               ! line 11
RWNOEG  B,DMCP                                               ! line 12  printed "RW NCEG"
        VF,DW                                                ! line 13
        LVE,,VSU(VU)                                         ! line 14
        VF,VWCW                                              ! line 15
        LVI,$15,RESTOR                                       ! line 16
