! mcp_bootstrap_p302.strap -- MCP printed page 302: THE COMMENTATOR,
! disabled and IF entry points (MCOMD, JCOMM), lines 1-54.
!
! docs/MCP_Mar63_250-445.pdf PDF p.53, read at 400 dpi, doubtful glyphs
! at 900 dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 11D11MCP  CARD
! ID SA000001  DIST. OF 3/01  3/01  PAGE NUMBER 302" (round glyphs in
! numeric fields read 0).  The heading row's LOCATION field is BLANK
! (line 1 is a banner).  CARD ID SA000001 -- a new card-ID series
! begins on this page (p.297 ran QJ...).
!
! THE PAGE.  54 lines, every line number prints a "*" after it.  Lines
! 1-3 a banner ("COMMENTATOR" between two rows of asterisks).  Line 4
! "SLC,$" prints 233150.00 and a "*"; this deck restates it as a hard
! SLC.  Lines 5-7, 14-16 and 22 are remarks.  Located rows run
! contiguous from 233150.00 (line 8) to 233201.40 (line 54, B,MPPBSY, a
! half word; next location 233202.00), then blank paper.  "*" after the
! LOCATION on lines 4, 29 and 49.
!
! JOIN.  The SLC,$ says the previous page's location counter stood at
! 233150.00; the p.301 scratch deck ends at 233147.40 (next 233150.00),
! so the join is contiguous (neither page landed yet).  Landed forward
! references agree: p.184's MCOMD (233150.0) and JCOMM (233154.0).  The
! p.303 scratch deck opens at 233202.00, contiguous.  Every stand-in
! below agrees with the address the p.303-p.309 scratch decks define.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "MCCMD" (line 8) = MCOMD, "JCCMM" (line 17) = JCOMM, "JJCIN"
!     (line 23) = JJOIN, "M CTL" (line 48) = MCTL: C22-6728 names MCOMD,
!     JCOMM, JJOIN and MCTL; landed p.184 SYNs MCOMD and JCOMM at these
!     addresses; line 13 prints the reference "B,JJOIN".
!   * "JDCL1" / "JDCL2" (labels, lines 28, 30) = JDOL1 / JDOL2: the
!     references on lines 25 and 27 print "JDOL1" / "JDOL2", line 27's O
!     CLOSED at 900 dpi; both compile to the label's location (233162.41
!     / 233163.41), so they are one symbol each.  No manual or other page
!     names them.
!   * "$XC" / "$XO" everywhere = $X0 (system symbol); "SV,O,JSETL" (line
!     33) = SV,0; "VF,C" (line 42) = VF,0; "CMOCOO" (lines 17, 23) =
!     CM0000 (connective digits); octal fields "CCCCCC.CC" read 0; hex
!     "CO", "BO", "DO", "OD", "FO" = C0/00, B0, D0, 0D, F0.
!   * the B rows' op byte (lines 39, 46, 54) prints "CO" / "C0": written
!     00, as p.297 does -- B assembles byte 00 on every landed B row.
!   * line 8 "JWAIT.1": printed with no "+" at 900 dpi; written as
!     printed (point notation, one bit past JWAIT), compiles 233666.01.
!
! EXTERNALS.  Index registers JXTEM ($4), JXIN1 ($1), JXCNSL ($3) from
! this page's J fields (see each comment).  Everything else from landed
! decks or this page's binary.
!
! CARD SERIALS.  SA000001 .. SA000053.  Lines 1-31 print SA0000NN; line
! 32 (BADZ,$+.32, whose statement is indented one column) ALSO prints
! SA000031, and from there line N prints SA0000(N-1): line 54 is
! SA000053.  None skipped; one serial duplicated.

JWAIT   SYN, (8)233666.00            ! landed p.184 form, no dds; CM line 17 233666.00 BIT-EXACT
JIF     SYN, (8)233666.01            ! not landed; BB line 34 233666.01, BIT-EXACT
JRECEP  SYN, (8)233666.02            ! not landed; CM line 23 233666.02, BIT-EXACT
JIOBSY  SYN, (8)233666.04            ! landed p.184; BB line 47 233666.04
SCOMIC  SYN, (8)215470.40            ! landed pp.116, 179; LVE line 10
STLR    SYN, (8)215230.              ! landed p.116; TI line 18 STLR+14.0 = 215246.00
STIC    SYN, (8)215265.0             ! landed p.116; lines 19, 21, 38
KSUPP   SYN, (8)216242.              ! landed p.128; B line 39 216242.10
JCNAD   SYN, (8)215006.0             ! landed; LV line 50 215006.06
JDEXRG  SYN, (8)233456.0             ! not landed; TI line 9 233456.00, word address only
MCOMIC  SYN, (8)233213.40            ! not landed; SVA line 12 233213.41, half word only
JXTEM   SYN, $4                      ! not landed; LV line 35 / KVI line 36 J field = 4
JXIN1   SYN, $1                      ! not landed; LVI lines 40, 44, 48, 51 J field = 1
JXCNSL  SYN, $3                      ! not landed; LV line 50 J = 3, W line 53 byte 83
JSTKP   SYN, (8)233454.0             ! not landed; LV line 35 233454.10 (J=4), half word only
JSTACK  SYN, (8)233476.0             ! not landed; KVI line 36 JSTACK+80.0 = 233616.11, half word only
JSTKR   SYN, (8)233224.40            ! not landed; B line 41 233224.50, half word only
JDWTST  SYN, (8)233245.0             ! not landed; B line 45 233245.10, half word only
JTSTEX  SYN, (8)233211.40            ! not landed; B line 46 233211.50, half word only
MBSY    SYN, (8)233214.0             ! not landed; BB line 47 233214.34, half word only
JSTCW   SYN, (8)233252.40            ! not landed; B line 49 233252.50, half word only
JIOGO   SYN, (8)233337.40            ! not landed; B line 52 233337.50, half word only
JSCWD1  SYN, (8)233452.0             ! not landed; W line 53 233452.03, word address only
MPPBSY  SYN, (8)233217.40            ! not landed; B line 54 233217.50, half word only

        SLC, (8)233150.00
! line  1  - ************************************************************
! line  2  - ****************** COMMENTATOR ******************
! line  3  - ************************************************************
        SLC,$                                                ! line  4  (prints 233150.00 *)
! line  5  -
! line  6  - *****COMMENTATOR DISABLED ENTRY POINT*****
! line  7  -
MCOMD   CM1111(BU,1),JWAIT.1                                 ! line  8  (printed "MCCMD")
        TI,16,$X0,JDEXRG                                     ! line  9  -SAVE INDEX REGISTERS
        LVE,$X0,SCOMIC                                       ! line 10  -ADVANCE SCOMIC TO EXIT SETTING
        V+I,$X0,1.0                                          ! line 11
        SVA,$X0,MCOMIC                                       ! line 12
        B,JJOIN                                              ! line 13  -MERGE WITH IF ENTRY
! line 14  -
! line 15  - *****COMMENTATOR IF ENTRY POINT*****
! line 16  -
JCOMM   CM0000(BU,2),JWAIT                                   ! line 17  -SET WAIT AND IF ENTRY BITS  (printed "JCCMM")
        TI,15,STLR+14.0,$1                                   ! line 18  -RESTORE INDICES $1-$15
        LV,$X0,STIC                                          ! line 19  -ADVANCE STIC TO EXIT SETTING
        V+I,$X0,1.32                                         ! line 20
        SV,$X0,STIC                                          ! line 21
! line 22  - *****DISABLED ENTRY JOINS HERE*****
JJOIN   CM0000(BU,2),JRECEP                                  ! line 23  -SET RECEPTOR AND STACK BITS  (printed "JJCIN")
        V-I,$X0,.32                                          ! line 24  -COMPUTE LOCATION OF N(J)
        SVA,$X0,JDOL1                                        ! line 25
        V-I,$X0,.32                                          ! line 26  -COMPUT LOCATION OF FWA(I)
        SVA,$X0,JDOL2                                        ! line 27
JDOL1   LVE,$X0,$                                            ! line 28  -COMPUTE N(J)  (printed "JDCL1")
        SV,$X0,JSETL+.32                                     ! line 29  (prints 233163.00 *)
JDOL2   LVE,$X0,$                                            ! line 30  -COMPUTE FWA(I)  (printed "JDCL2")
        BUSAZ,$+.32                                          ! line 31
        BADZ,$+.32                                           ! line 32  (indented; serial repeats SA000031)
        SV,0,JSETL                                           ! line 33
        BB,JIF,JRRRRR                                        ! line 34
        LV,JXTEM,JSTKP                                       ! line 35
        KVI,JXTEM,JSTACK+80.0                                ! line 36
        BXL,JRRRRR                                           ! line 37
        M-1(BU,17),STIC                                      ! line 38
        B,KSUPP                                              ! line 39
JRRRRR  LVI,JXIN1,$+1.0                                      ! line 40
        B,JSTKR                                              ! line 41
JSETL   VF,0                                                 ! line 42  -PRESET TO FWA(I)
        CF,0                                                 ! line 43  -PRESET TO N(J)
        LVI,JXIN1,$+1.0                                      ! line 44  -TEST FOR NECESSITY OF WRITE
        B,JDWTST                                             ! line 45
        B,JTSTEX                                             ! line 46  -RETURN,NO WRITE NEEDED
        BB,JIOBSY,MBSY                                       ! line 47  -IS COMMENTATOR BUSY
MCTL    LVI,JXIN1,$+1.0                                      ! line 48  -COMPUTE CONTROL WORD CHAIN  (printed "M CTL")
        B,JSTCW                                              ! line 49  (prints 233176.40 *)
        LV,JXCNSL,JCNAD                                      ! line 50  -CONSOLE CHANNEL ADDRESS
        LVI,JXIN1,$+1.0                                      ! line 51
        B,JIOGO                                              ! line 52
JRITE   W,0.0(JXCNSL),JSCWD1                                 ! line 53  -JIOGO ISSUES WRITE
        B,MPPBSY                                             ! line 54  -RETURN IF CBJ

