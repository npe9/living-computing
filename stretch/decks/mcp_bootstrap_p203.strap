!CHECK 222226.00 | 215570.04 00 | line 17 BC,SPRIME as printed (D worn; byte prints C0)
!CHECK 222226.40 | 000104.00 80 | line 18 ,$ABEOJ
!CHECK 222227.00 | 222144.00 00 | line 19 BE,ARET
!CHECK 222227.40 | 223744.14 80 001000.00 F0 | line 21 C START CMOCOO(BU,1),AEOJI (a "*" after the location; h2 prints 001000.CC FC)
!CHECK 222230.40 | 000027.00 80 223753.22 A0 | line 22 TI,9,$7,CXR7
!CHECK 222231.40 | 222110.25 B0 | line 23 LVE,$10,SCSPRT+3. (byte read B0 at 900 dpi: flat left stem, unlike line 22's round 80)
!CHECK 222232.00 | 222110.64 50 | line 24 LC,$10,SCSPRT+3.32
!CHECK 222232.40 | 000027.22 00 | line 25 Z,$7
!CHECK 222233.00 | 222110.40 80 022027.20 50 | line 26 L(BU,18),SCSPRT+3.32,46
!CHECK 222234.00 | 210000.00 80 406012.21 90 | line 27 *I(BU,6),17,20
!CHECK 222235.00 | 222105.04 80 222240.74 02 | line 28 BB,SCSPRT.4,RNOLCK-
!CHECK 222236.00 | 000010.00 80 000040.06 70 | line 29 LF(BU,64),$L,64 (byte prints 7C)
!CHECK 222237.00 | 222223.34 C0 | line 30 BZRZ,ACHERR
!CHECK 222237.40 | 222222.40 80 | line 31 SIC,ACHKBR
!CHECK 222240.00 | 222217.10 00 | line 32 B,ACHK (byte prints C0)
!CHECK 222240.40 | 222577.20 10 | line 33 RNOLCK LX,$8,CWA-
!CHECK 222241.00 | 000000.25 0A | line 34 CACS1 KCI,$10,C as printed
!CHECK 222241.40 | 222253.72 C2 | line 35 BXE,CACS2
!CHECK 222242.00 | 000020.23 02 | line 36 LCI,$9,16 (byte prints C2)
!CHECK 222242.40 | 223743.00 80 222254.74 02 | line 37 BB,CBTA,CAOS3 (a "*" after the location)
!CHECK 222243.40 | 000001.00 8A 100000.06 70 | line 38 C TRANS LF(BU,64,8)(V+I),1.($10)
!CHECK 222244.40 | 000000.60 88 160600.12 F0 | line 39 SF(BU,48,6) (V+I),.48($8)
!CHECK 222245.40 | 222243.62 48 | line 40 CB,$9,CTRANS
!CHECK 222246.00 | 000001.00 8A 250000.06 70 | line 41 LF(BU,40,8)(V+IC),1.($10) (byte prints 7C)
!CHECK 222247.00 | 000000.36 88 136600.12 F0 | line 42 SF(BU,30,6)(V+I),.30($8)
!CHECK 222250.00 | 000001.21 08 | line 43 C-I,$8,1
!CHECK 222250.40 | 222251.70 42 | line 45 BXCZ,CACS4
!CHECK 222251.00 | 222241.10 00 | line 46 B,CAOS1
!CHECK 222251.40 | 223743.00 80 001000.36 F0 | line 47 CACS4 CM1111,CBTA
!CHECK 222252.40 | 000030.02 00 | line 48 R,$8 (byte prints C0)
!CHECK 222253.00 | 222241.10 00 | line 49 B,CAOS1
!CHECK 222253.40 | 222577.21 10 | line 50 CACS2 SX,$8,CWA
!CHECK 222254.00 | 222144.10 00 | line 51 B,ARET
