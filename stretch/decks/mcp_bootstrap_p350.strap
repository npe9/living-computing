        LVI,$14,AMNMBF                                       ! line 30
        SIC,AINTLB                                           ! line 31
        B,AINITL                                             ! line 32
        LV,$14,AMNTOP                                        ! line 33
        LVI,$11,17.                                          ! line 34
        KV,$2,ADMPND                                         ! line 35
        BXL,$+1.                                             ! line 36
        LV,$2,ADMPND                                         ! line 37
        V-I,$2,.32                                           ! line 38
