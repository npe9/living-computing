!   line  3  003314.00  003317.00+ 000 000024 003314   T PPREF XW
!   line  4  003315.00  003317.00+ 000 000024 003314   T PPRUN XW
!   line  5  003316.00  000000.00+ 000 000000 000000   XW
!   line  6  003317.00  003373.00+ 000 001100 000000   T PREFT XW
!   line 19  003370.00  000000.00+ 000 000000 000000   T PURFT XW,0
!   line 20  003371.00  000000.00+ 000 000000 000000   XW,0
!   line 21  003372.00  000000.00+ 000 000100 000000   XW,0(.39)1
!   line 29  003513.00  000000.40+                     VF,0.32
