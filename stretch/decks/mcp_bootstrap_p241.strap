        KVI,$15,RKB+RKC+2.0                                  ! line 29
        BZXE,RWEXBR                                          ! line 30
        LVI,$15,RWEXIT                                       ! line 31
        SIC,RDSWBR                                           ! line 32
        B,RDSWTC                                             ! line 33
        BZB,RWEXBR.19,RWSET-.32                              ! line 34
        LVE,$14,1.32($2)                                     ! line 35
        LWF(U),($14)                                         ! line 36
        ST(U),RWEXIT-2.0                                     ! line 37
RWEXBR  NOP,RWSET                                            ! line 38
        LVI,$15,RWSBSP                                       ! line 39
RWREST  SVA,$15,RWEXIT+5.32                                  ! line 40
        LC,$15,RWTRY                                         ! line 41
        CBZ,$15,RWTONG                                       ! line 42
RWSTOR  SC,$15,RWTRY                                         ! line 43
        CM1111(BU,1),RWEXBR.19                               ! line 44
        B,DMCP                                               ! line 45
        VF,DBSP                                              ! line 46
        LVE,,VSU(VU)                                         ! line 47
        B,RETN                                               ! line 48

