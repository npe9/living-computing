! -*********************************************************************  ! line  3
! -                                                                       ! line  4
        SLC, (8)227524.31            ! line  5  printed "SLC,$" at 227524.31 * (p.240 VF at 227524.00 + 25 bits)
RKA     SYN,3.0                                              ! line  6  printed "3.C"
RKB     SYN,3.0                                              ! line  7
RKC     SYN,3.0                                              ! line  8
RKD     SYN,3.0                                              ! line  9  printed "RKC" (worn D)
RKF     SYN,3.0                                              ! line 10  printed "3.C"
RKH     SYN,3.0                                              ! line 11  H, right stem worn
RKSUK   LV,$13,RKSBRC                                        ! line 12
        V-I,$13,4.0                                          ! line 13
        LV,VU,0.32($13)                                      ! line 14
        BB,2.9($13),RUNLD                                    ! line 15
