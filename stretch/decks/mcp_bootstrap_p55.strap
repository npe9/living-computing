!   line  2  003106.40  000000.62 87  007000.20 D0   ST(BU,7)
!   line  3  003107.40  002601.31 80  007000.22 B0   M+1,L TAPEC
!   line  4  003110.40  002733.74 80  004000.20 50   L(BU,4)
!   line  5  003111.40  000000.03 85  004000.20 D0   ST(BU,4),T TYPE
!   line  6  003112.40  002566.20 10                 LX,L XSC
!   line  7  003113.00  000000.00 88  060000.20 50   L OOPSC L(BU,48)
!   line  8  003114.00  003117.34 C6                 BRZZ,L IOD4
