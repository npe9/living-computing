!   line 27  003132.00  000000.13 85  007000.20 D0   ST(BU,7),T RLSYM
!   line 28  003133.00  000032.22 00                 Z,L WORKX
!   line 29  003133.40  000032.16 80  007000.20 D0   ST(BU,7)
!   line 30  003134.40  002606.70 8A  010000.22 B0   M+1(BU,8)
!   line 31  003135.40  002601.53 80  007000.20 D0   ST(BU,7),L COUNT
!   line 32  003136.40  002657.21 05                 V+I,L SYMC-1.
!   line 33  003137.00  003055.50 00                 B,L FOUND
!   line 34  003137.40  000004.00 83  060000.06 70   L SET  LF(BU,48)
!   line 35  003140.40  002736.00 80  060000.23 10   KF(BU,48),L BLANK
!   line 36  003141.40  003142.76 C0                 BZAE,L SETA
!   line 37  003142.00  003237.74 C0                 BZRZ,L NORM
!   line 38  003142.40  002566.20 10                 L SETA  LX
!   line 39  003143.00  000000.71 87  007027.20 50   L(BU,7)
!   line 40  003144.00  000011.20 B0                 V+,L XSC,$R
!   line 41  003144.40  000000.00 88  060000.20 50   L(BU,48)
!   line 42  003145.40  000004.00 83  060000.21 10   K(BU,48)
!   line 43  003146.40  003237.76 C6                 BAEZ,L NORM
!   line 44  003147.00  003103.50 00                 B,L ETA
