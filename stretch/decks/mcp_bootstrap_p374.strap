! mcp_bootstrap_p374.strap -- MCP printed page 374: SYSTEM COMMAND
! package (PUNID 22SCOMD), the IOCHANGE routine: the tail of the
! channel-operating test (Z PETE), two "ABNORMAL EOJ" messages, the
! ADD UNIT SECTION (Z ADD UN .. Z TYPR5), the four equipment-type words
! (Z NO TYP .. Z PU TYP), and the opening of the ADD CHANNEL SECTION.
!
! docs/MCP_Mar63_250-445.pdf PDF p.124, read at 400 dpi, names at 900
! dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 22SCOMD  CARD ID
! WA000641  DIST. OF 3/01  3/01  PAGE NUMBER 374"; the heading row's
! LOCATION field is 235254, line 1's word.
!
! THE PAGE.  49 lines, contiguous 235254.40 .. 235325.00 (line 49, a
! half word; next 235325.40), then blank paper.  Every line number
! prints a "*"; a "*" also prints after the LOCATION on lines 8, 17,
! 32 and 49.  No TAIL, no SLC, no PUNID change: still SCOMD.
!   lines  1-6   code (BXVZ, SX, Z PETE's BE/BD, BB, B).
!   lines  7-10  CNOP, Z SPL01 (A*)DD(BU,64,8) 40 characters (5 words),
!                CNOP (emits nothing), Z QUZ49 (IQS*)DD(BU) 40 chars.
!   lines 11-12  remark cards ("-" in NAME); banner on 12.
!   lines 13-41  ADD UNIT SECTION code.
!   lines 42-45  four (A*)DD(BU,48,6) words, 8 characters each before
!                the "*" (the blanks are data: each span is 48 bits).
!   lines 46-47  remark cards; banner on 47.
!   lines 48-49  Z ADD CH.
! JOIN: p.373 is being transcribed in parallel; this deck states its
! origin hard.  p.375 should open at 235325.40.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * line 17 "B,ZCONE" written ZDONE: D worn to C (line 10 prints its
!     own "DD" as "DC" in the same column); C22-6728 names ZDONE (5x),
!     no ZCONE anywhere.  External, not landed -- coordinator: check
!     the defining page.
!   * line 22 "Z RC TYP" = ZRDTYP: defined on line 43, and line 22's
!     binary 235321.60 is that address.
!   * line 10 label "Z QUZ49" (Vision read GUZ49/CUZ49): the glyph has
!     Q's tail at 900 dpi, as in Z NX QUZ (line 27).  Not referenced.
!   * line 8 label "Z SPL01": digit 0/1 (numbered); not referenced.
!   * line 1 "J NOP X" = JNOPX (C22-6728, 36x).  line 18 "JFLDB"
!     (C22-6728: "an area JFLDB").  line 6 "Z QUES 2" = ZQUES2.
!   * "CMOC00" / "CMOCOO" (lines 15-16) = CM0000 (connective mask; open
!     0s).  Text "ECJ", "ABNCRMAL" = EOJ, ABNORMAL (English; open O).
!   * hex bytes printed "CO" on the B rows 17 and 26 = 00 (B can only
!     assemble 0 there; lesson 6); line 30's "FC" = F0 (lines 25, 35
!     print F0 for the same statement).  The BZAE rows' "C0" (23, 28,
!     33) and BAE's "C2" (21) are REAL C's: the statement assembles them.
!
! EXTERNALS.  SCHOP, SMULTI, SVER, SRD, SEQUIP, SCHAVL, SUNAVL: landed
! p.99 forms.  ZREQUN/ZREQCH: index registers $6/$8 from this page's
! binary (low nibble of the index byte; LV,ZREQUN,ZREQCH addresses
! word 000030 = $8).  JNOPX, ZQUES2, ZDONE, ZEREX1, JFLDB: not landed
! (other SCOMD pages); values from this page's binary, half word only.
!
! CARD SERIALS.  WA000641 .. WA000689, one per line, none shared or
! skipped (line 34's prints a stray "," after it).

SCHOP   SYN(BU,1), 0.26              ! landed p.99 -CHAN OPERATING; BB line 5 .32
SMULTI  SYN(BU,1), 0.27              ! landed p.99 line 24 -MULTI-UNIT CHAN; BZB line 14 .33
SVER    SYN(BU,1), 0.40              ! landed p.99 line 32 -VERIFY FILE STATUS; line 15 .50
SRD     SYN(BU,1), 0.57              ! landed p.99 line 45 -READ; line 16 .71
SEQUIP  SYN(BU,4), 0.52              ! landed p.99 line 38 -EQUIPMENT; lines 25/30/35 .64
SCHAVL  SYN(BU,1), 0.25              ! landed p.99 line 21 -CHANNEL AVAILABILITY; lines 37/48 .31
SUNAVL  SYN(BU,1), 0.28              ! landed p.99 line 26 -UNIT AVAILABILITY; lines 13/40 .34
ZREQUN  SYN, $6                      ! not landed; index byte 86 (lines 13, 15, 16, 40), BIT-EXACT
ZREQCH  SYN, $8                      ! not landed; index byte 88 (lines 5, 14, 25), LV line 19 000030
JNOPX   SYN, (8)234637.0             ! not landed; BXVZ line 1 234637.31, half word only
ZQUES2  SYN, (8)235232.40            ! not landed; B line 6 235232.50, half word only
ZDONE   SYN, (8)235234.0             ! not landed; B line 17 235234.10, half word only (printed "ZCONE")
ZEREX1  SYN, (8)234631.0             ! not landed; B lines 38/41 234631.10, half word only
JFLDB   SYN, (8)234560.0             ! not landed; L line 18 JFLDB+5.0 = 234565.00

        SLC, (8)235254.40
        BXVZ,JNOPX                                           ! line  1  -NOTHING MORE AVAILABLE
        SX,2,$R                                              ! line  2  -RESTORE RT ACC
ZPETE   BE,$+.32                                             ! line  3
        BD,$+.32                                             ! line  4
        BB,SCHOP(ZREQCH),ZPETE                               ! line  5
        B,ZQUES2                                             ! line  6
        CNOP                                                 ! line  7
ZSPL01  (A*)DD(BU,64,8),LABNORMAL EOJ TO P.P. MCP NEEDS CHANNEL.* ! line  8
        CNOP                                                 ! line  9
ZQUZ49  (IQS*)DD(BU),ABNORMAL EOJ TO P.P.  MCP NEEDS CHANNEL.* ! line 10  printed "DC(BU)", "ABNCRMAL ECJ"
! line 11  -
! line 12  -              ********   ADD UNIT SECTION   *******
ZADDUN  BZBZ,SUNAVL(ZREQUN),ZEREX1                           ! line 13
        BZB,SMULTI(ZREQCH),ZINSRT                            ! line 14  -BRANCH IF SINGLE UNIT FOR TYPE
ZFINI4  CM0000(BU,9),SVER(ZREQUN)                            ! line 15  -CLEAR STATUS TABLE
        CM0000(BU,7),SRD(ZREQUN)                             ! line 16
        B,ZDONE                                              ! line 17  printed "ZCONE"
ZINSRT  L(BU,48),JFLDB+5.0                                   ! line 18
        LV,ZREQUN,ZREQCH                                     ! line 19
        KF(BU,48,6),ZNOTYP                                   ! line 20
        BAE,ZFINI4                                           ! line 21
        KF(BU,48,6),ZRDTYP                                   ! line 22  printed "Z RC TYP"
        BZAE,ZNXQUZ                                          ! line 23
        LFI(BU,3),(2)011                                     ! line 24  -READER - 3
        SF(BU,3),SEQUIP(ZREQCH)                              ! line 25
        B,ZFINI4                                             ! line 26
ZNXQUZ  KF(BU,48,6),ZPRTYP                                   ! line 27
        BZAE,ZNXTQZ                                          ! line 28
        LFI(BU,3),(2)100                                     ! line 29  -PRINTER - 4
        SF(BU,3),SEQUIP(ZREQCH)                              ! line 30
        B,ZFINI4                                             ! line 31
ZNXTQZ  KF(BU,48,6),ZPUTYP                                   ! line 32
        BZAE,ZTYPER                                          ! line 33  -ERROR IN TYPE
        LFI(BU,3),(2)101                                     ! line 34  -PUNCH - 5
        SF(BU,3),SEQUIP(ZREQCH)                              ! line 35
        B,ZFINI4                                             ! line 36
ZCHTPE  CM1111,SCHAVL(ZREQCH)                                ! line 37
        B,ZEREX1                                             ! line 38
ZTYPER  BPG1,ZCHTPE                                          ! line 39
        CM1111,SUNAVL(ZREQUN)                                ! line 40
ZTYPR5  B,ZEREX1                                             ! line 41
ZNOTYP  (A*)DD(BU,48,6),        *                            ! line 42
ZRDTYP  (A*)DD(BU,48,6),READER  *                            ! line 43
ZPRTYP  (A*)DD(BU,48,6),PRINTER *                            ! line 44
ZPUTYP  (A*)DD(BU,48,6),PUNCH   *                            ! line 45
! line 46  -
! line 47  -              ******   ADD CHANNEL SECTION   ******
ZADDCH  BZBZ,SCHAVL(ZREQCH),ZEREX1                           ! line 48
        B,ZADDUN+1.0                                         ! line 49

