! mcp_bootstrap_p427.strap -- MCP printed page 427: the $EOJ program's
! reassembly of the tape ASSIGN routine, "GENERATE THE FILE AREA TABLES"
! (TIREF -> TIODRN, the exit table, mode, reel disposition, density) and
! the start of the "DISK ANALYSER" (TMDK .. TMDK1, to +(BU,17),$R+.47).
!
! docs/MCP_Mar63_250-445.pdf PDF p.177, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZF000479  DIST. OF 3/01
!  3/01  PAGE NUMBER 427"; the heading row's LOCATION field is BLANK
! (line 1 is a remark).
!
! >>> CARD SERIES ZF (as pp.424-426), PUNID 22$EOJ.  No SLC, no PUNID
! on the page; the origin below is line 5's printed LOCATION.  No TAIL. <<<
!
! THE PAGE.  54 lines, every line number prints a "*"; a further "*"
! after the LOCATION on lines 22 and 43 (recorded, not interpreted).
! Contiguous 022510.40 .. 022547.00 (line 54, a full word; next
! location 022550.00).  p.425 ends at 022465.40, so p.426 fills
! 022466.00 .. 022510.00 (not seen here).  Remark lines: 1-4 (the boxed
! banner "GENERATE THE FILE AREA TABLES"), 7, 10, 14, 18, 21, 25, 29,
! 33-38 (the boxed banner "DISK ANALYSER").
!
! CARD SERIALS.  ZF000479 .. ZF000532, one per line, consecutive.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!  * labels print with a blank after T: "T M1FUZ" (19), "T M1FAZ" (30),
!    "T MDK" (43), "T MDK1" (51); written TM1FUZ, TM1FAZ, TMDK, TMDK1
!    (as printed in the operands of lines 13, 17, 22, 49).
!  * D printed worn/open (reads C): TIODRN(TMXD) (6), TMXD throughout,
!    TITYCD (13, 22, 30 "TITYCC"), TIMOCD (15, 19), TIDSCD (23 "TICSCD"),
!    TIDNCD (26), TREELD, TDENMD, TFMODE (20 "TFMCDE"), TDKSAV (39),
!    TSBDFT, TMNULD (48, 51 "TMNULC"), TMDK3 (53 "TMCK3"), TMDK1 (49):
!    every one is a symbol defined with D on pp.418-420 (or this page's
!    own labels), and each row's binary is that symbol's field.
!  * open rounds in the octal/hex fields ("CCCCC0.C0", "FC") are 0:
!    every such row assembles to 0 there.  Line 32's BZAE "C0" is a
!    real C0 (as p.425's BZAE rows).
!  * line 54's remark ends "- ARC -": part of the remark.
!
! EXTERNALS.  Copied in their DEFINING forms from the scratch neighbours
! (p.418: TMXn index names, TM6BL DD, TDKSAV VF; p.419: IOD field SYNs,
! TSBDFT SYN(BU,17),TSBDTB; p.420: file-area field SYNs).  TM1FA, TMTRK,
! TMNULD, TMCONV, TMDK3 are defined on pages not yet landed (pp.428-):
! their values come ONLY from this page's binary (half word only).

TMX1    SYN,$1                       ! p.418 line 22; LVI line 49 .43 01
TMXC    SYN,$4                       ! p.418 line 25; SV lines 8-9 .34
TMXD    SYN,$5                       ! p.418 line 26; byte 85
TMXG    SYN,$8                       ! p.418 line 29; LV line 39 .20 30
TMXEE   SYN,$9                       ! p.418 line 30; SV line 8 .23
TMXI    SYN,$10                      ! p.418 line 31; byte 8A
TMXGA   SYN,$11                      ! p.418 line 32; byte 8B
TIREF   SYN(BU,12),0.52              ! p.419 line 19
TIABEX  SYN(BU,18),0.0               ! p.419 line 18
TITYCD  SYN(BU,4),2.60               ! p.419 line 24
TITRK   SYN(BU,1),2.59               ! p.419 line 23
TINO    SYN(BU,48),5.0               ! p.419 line 27
TIMOCD  SYN(BU,2),6.62               ! p.419 line 29
TIDNCD  SYN(BU,2),7.62               ! p.419 line 31
TIDSCD  SYN(BU,2),8.62               ! p.419 line 33
TSBDTB  SYN(BU,32), (8)022240.0      ! p.419 line 11 DRZ(BU,32) at 022240.00
TSBDFT  SYN(BU,17),TSBDTB            ! p.419 line 12, its defining form
TIODRN  SYN(BU,18),0.0               ! p.420 line 8
TTOELO  SYN(BU,18),2.0               ! p.420 line 6
TDENMD  SYN(BU,2),2.27               ! p.420 line 7
TREELD  SYN(BU,3),2.29               ! p.420 line 9
TFMODE  SYN(BU,2),2.48               ! p.420 line 10
TORARC  SYN(BU,17),5.01              ! p.420 line 11
TCUARC  SYN(BU,17),6.01              ! p.420 line 13
TM6BL   SYN(BU,48,6), (8)022132.15   ! p.418 line 13 (AX)DD(BU,48,6); KF line 47
TDKSAV  SYN(B,25,1), (8)022153.0     ! p.418 line 43 "TDKSAV VF,0"; LV line 39 022153.20
TM1FA   SYN, (8)022603.40            ! B line 28 022603.50, BZAE line 32 .76; half word only
TMTRK   SYN, (8)022576.40            ! BB line 42 022576.74; half word only
TMNULD  SYN, (8)022572.0             ! BAE line 48 .36, BRZ line 51 .34; half word only
TMCONV  SYN, (8)022772.40            ! B line 50 022772.50; half word only
TMDK3   SYN, (8)022550.40            ! BB line 53 022550.74; half word only

        SLC, (8)022510.40
! line  1  - ----------------------------------------------------------
! line  2  -              GENERATE THE FILE AREA TABLES
! line  3  - ----------------------------------------------------------
! line  4  -
        L,TIREF(TMXI),46                                     ! line  5  -GENERATE LOC OF SYMB I/O LOC WORD
        CM0101,TIODRN(TMXD),46                               ! line  6  -STORE REF NO. IN FILE AREA TABLE
! line  7  -
        SV,TMXEE,0.0(TMXC)                                   ! line  8  -STORE UNIT AREA ADD IN SYMB I/O TB
        SV,TMXD,0.32(TMXC)                                   ! line  9  -STORE FILE AREA ADD IN SYMB I/O TB
! line 10  -
        C0011,TIABEX(TMXI)                                   ! line 11  -GET TABLE OF EXITS ADDRESS
        CM0101,TTOELO(TMXD)                                  ! line 12  -PLACE IN FILE AREA TABLE
        BB,TITYCD(TMXI),TM1FUZ                               ! line 13  -IF TAPE
! line 14  -
        LF,TIMOCD-1.0(TMXI)                                  ! line 15  -GET CARD MACHINE MODE
        CM0101,TFMODE(TMXD)                                  ! line 16
        B,TM1FAZ                                             ! line 17
! line 18  -
TM1FUZ  LF,TIMOCD(TMXI)                                      ! line 19  -GET THE TAPE MODE
        SF,TFMODE(TMXD)                                      ! line 20
! line 21  -
        BZB,TITYCD(TMXI),TM1FAZ                              ! line 22  -IF THE EQUIP IS NOT TAPE
        C0011,TIDSCD(TMXI)                                   ! line 23  -GET THE REEL DISP
        CM0101,TREELD(TMXD)                                  ! line 24
! line 25  -
        C0011,TIDNCD(TMXI)                                   ! line 26  -GET GIVEN DENSITY
        CM0101,TDENMD(TMXD)                                  ! line 27
        B,TM1FA                                              ! line 28
! line 29  -
TM1FAZ  L,TITYCD(TMXI)                                       ! line 30
        KFI(BU,4),1                                          ! line 31  -LOOK FOR DISK
        BZAE,TM1FA                                           ! line 32  -IF NOT DISK
! line 33  -
! line 34  -
! line 35  - ----------------------------------------------------------
! line 36  -              DISK ANALYSER
! line 37  - ----------------------------------------------------------
! line 38  -
        LV,TMXG,TDKSAV                                       ! line 39  -GET UNIT TABLE ADDRESS
        LV,TMXGA,0.(TMXEE)                                   ! line 40  -FOR LOCATING THE ACCUMULATING DISK CTR.
        L,TSBDFT(TMXGA),64                                   ! line 41  -GET COUNTER
        BB,TITRK(TMXI),TMTRK                                 ! line 42  -IF TRACK
TMDK    ST,TCUARC(TMXD),64                                   ! line 43  -SET CURRENT ARC
        ST,TORARC(TMXD),64                                   ! line 44  -SET ORIGINAL ARC
        ST,TSBDFT(TMXGA),64                                  ! line 45  -SAVE AS TRACK ROUNDS OFF
        L,TINO(TMXI)                                         ! line 46  -GET THE DISK NUMBER
        KF,TM6BL                                             ! line 47  -LOOK FOR DISK NULL-- BLANK
        BAE,TMNULD                                           ! line 48  -IF NULL
        LVI,TMX1,TMDK1                                       ! line 49
        B,TMCONV                                             ! line 50  -GO TO THE CONVERSION ROUTINE
TMDK1   BRZ,TMNULD                                           ! line 51  -IF NULL -- ZERO
        LF,TSBDFT(TMXGA),64                                  ! line 52  -RELOAD ACC
        BB,TITRK(TMXI),TMDK3                                 ! line 53  -IF TRACK
        +(BU,17),$R+.47,64                                   ! line 54  -ADD THE CONVERTED NUMBER - ARC -

!SYM TM1FUZ 022521.00
!SYM TM1FAZ 022530.40
!SYM TMDK   022536.00
!SYM TMDK1  022544.40

