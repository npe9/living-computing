        BZAE,JBDLAB                  ! line 39   -IF NOT SAME LABEL ("SZME" as printed)
! line 40 is a comment card: "***** ENTER HERE IF ONLY WRITE LABEL
! REQUIRED *****"
JRWRIT  LCI,$3,3                     ! line 41   -PREPARE TO REWRITE LABEL
JBACKT  SIC,JBSPX                    ! line 42   -BSP THE TAPE
