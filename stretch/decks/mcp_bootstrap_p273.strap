!CHECK 231346.00 | 000002.37 BE | line 19 LVE,$15,2.0($14)
!CHECK 231346.40 | 231376.00 80 000000.36 2F | line 20 T,$15,YUCBF2,0.0($15)
!CHECK 231347.40 | 000002.50 0E | line 21 B,2.32($14)
!CHECK 231350.00 | 231363.00 80 000033.06 A0 | line 22 YUER TI,3,YUXSAV,$11 (a "*" after the location)
!CHECK 231351.00 | 000002.37 BE | line 23 LVE,$15,2.0($14)
!CHECK 231351.40 | 000000.22 0F | line 24 Z,0.0($15) (byte prints "CF")
!CHECK 231352.00 | 000002.50 0E | line 25 B,2.32($14)
!CHECK 231352.40 | 000000.31 1E | line 30 YNORR SX,$12,0.0($14)
!CHECK 231353.00 | 231426.71 80 001000.00 F0 | line 31 CM0000(BU,1),YTBIT
!CHECK 231354.00 | 231363.00 80 000033.06 A0 | line 32 TI,3,YUXSAV,$11
!CHECK 231355.00 | 000002.37 BE | line 33 LVE,$15,2.0($14)
!CHECK 231355.40 | 231227.36 50 | line 34 LC,$15,YUSB8C
!CHECK 231356.00 | 231357.71 42 | line 35 BXVZ,$+1.32
!CHECK 231356.40 | 231376.00 80 000000.36 2F | line 36 T,$15,YUCBF2,0.0($15)
