        M+1(BU,18),VFCNT(VU)                                 ! line 22  -0582
        SIC,(VP)                                             ! line 23
        CB+,VP,VACT                                          ! line 24  -0583
        B,VNX(VU)                                            ! line 25  -0584
VTEE1   BE,0                                                 ! line 26  -0585
VSTTSX  LV,VT5,VTS(VU)                                       ! line 27  -0586
        CB-,VP,VNXT                                          ! line 28  -0587
VRBLC   LX,VT3,VX2R(VU)                                      ! line 29  -0588
        LV,VT2,(VT3)                                         ! line 30  -0589
        SR,VP,(VT3)                                          ! line 31  -0590
        V+ICR,VT3,.VH                                        ! line 32  -0591
        SX,VT3,VX2R(VU)                                      ! line 33  -0592
        LV,VT5,VT2                                           ! line 34  -0593
        V+,VT2,VX(VU)                                        ! line 35  -0594
        BZXVZ,$.64                                           ! line 36  -0595
        V-I,VT2,34.                                          ! line 37  -0596
        SV,VT2,VX(VU)                                        ! line 38  -0597
        B,VNX(VU)                                            ! line 39  -0598
! VD15  DDI(BU,4),15                                         ! line 40  -0599 NOT ASSEMBLED (DDI refused) -- see header
VEE     B,DMCP                                               ! line 41
        ,DCCW                                                ! line 42  -0600
        LVE,,VSU(VU)                                         ! line 43  -0601
        ,VEE1                                                ! line 44  -0602
        L(BU,18),VEE1,46                                     ! line 45  -0603
        -(BU,18),VCWR+VM1(VU),46                             ! line 46  -0604
        /I,VD15,46                                           ! line 47  -0605
        LV,VT5,$R                                            ! line 48  -0606
        V-I,VT5,34.                                          ! line 49  -0607
        LVE,VT2,VX(VU)                                       ! line 50  -0608

