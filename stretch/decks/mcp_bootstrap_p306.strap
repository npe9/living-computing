! mcp_bootstrap_p306.strap -- MCP printed page 306: the tail of the
! wait-for-I/O routine J TERM (J EKJZ, J TERMS, J FKCS), the RELEASE
! CONSOLE ROUTINE (J RELCN, J NOEKJ), and the first card of the
! CONSOLE I/O ACCEPTANCE ROUTINE (J IOGO); lines 1-52.
!
! docs/MCP_Mar63_250-445.pdf PDF p.57, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 11D11MCP  CARD ID SA000209  DIST. OF 3/01
! 3/01  PAGE NUMBER 306" (round glyphs in numeric fields read 0).  The
! heading row's LOCATION field is 233310, line 1's word.
!
! THE PAGE.  52 lines, every line number printing a "*" after it.
! Located rows run contiguous from 233310.40 (line 1) to 233332.00
! (line 26, a half word), then remark cards 27-33 (no location; a "-"
! in the NAME column), then 233332.40 (line 34) to 233337.00 (line 42),
! remark cards 43-51, and line 52 at 233337.40, a full-word LF (next
! location 233340.40).  Lines 11 (233317.00) and 34 (233332.40) print
! an asterisk after the LOCATION; recorded, not explained.
!
! JOIN.  p.305 and p.307 have no scratch decks yet; contiguity with
! either is NOT established here (line 1 opens at a .40, so p.305
! should end with a half word at 233310.00).
!
! INDEX-REGISTER STAND-INS.  J XIN1, J XIN2, J XCNSL, J XTEM, M XCST are
! defined later in this deck (the volume OCR,
! docs/ocr/MCP_Mar63_250-445.txt, prints "JXIN 2 SYN,$2", "JXCNSL
! SYN,$3", "JXTEM SYN $4", "MXCST SYN$8" at serials SA000410-417, on a
! page not yet landed).  This page's own binary fixes each: LV's J
! field prints 2J (.06 = $3 J XCNSL, .10 = $4 J XTEM, .20 = $8 M XCST);
! LCI's prints 2J+1 (.03 = $1 J XIN1, .05 = $2 J XIN2).
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * octal-field open rounds ("CCC012.C3", "C00000.1C", "233310.4C"...)
!     are 0; every hex byte "CO"/"FC" here is C0/F0 only where the
!     statement assembles it so (line 9 BZRZ C0, line 25 CM1111 F0).
!   * line 52's label prints "J I C G O" open; the routine is J IOGO --
!     line 47's remark prints "B,JIOGO" with a closed O, and C22-6728
!     (MCP Sys Analysis Guide) typesets "The I-O Routine, JIOGO".
!   * "J NOEKJ", "J RELCN", "SEOP", "JCNAD": open rounds read O / D
!     (comment "NO EKJ"; JCNAD landed on printed p.122/p.128).
!   * line 8's "CTI0001" prints its digits open; CTI's mask is binary.
!
! CARD SERIALS.  SA000209 .. SA000259, line N prints SA0002(08+N) except
! that lines 22 and 23 (SIC,K STCS / B,K CSIN, one card -- line 23's B
! is indented one column) BOTH print SA000230, so from line 24 on line N
! prints SA0002(07+N).  None skipped.

JXIN1   SYN,$1                       ! OCR SA000409 "JXIN 1 SYN,$1"; LCI line 1 .03 = 2J+1
JXIN2   SYN,$2                       ! OCR SA000410 "JXIN 2 SYN,$2"; LCI line 34 .05
JXCNSL  SYN,$3                       ! OCR SA000411 "JXCNSL SYN,$3"; LV line 2 .06
JXTEM   SYN,$4                       ! OCR SA000412 "JXTEM SYN $4"; LV line 10 .10
MXCST   SYN,$8                       ! OCR SA000417 "MXCST SYN$8"; LV line 16 .20, V+ line 17 000030
JCNAD   SYN, (8)215006.0             ! landed p.122; LV line 2 215006
SCHANS  SYN, (8)215002.0             ! landed p.103 (SYN,SXCHAN); V+ line 18 215002
SCHOP   SYN(BU,1), 0.26              ! landed p.99 -CHAN OPERATING; BB line 19 .32
KSTCS   SYN, (8)216272.40            ! landed p.122; SIC line 22 BIT-EXACT
KCSIN   SYN, (8)216267.0             ! landed p.128 line 36; B line 23 216267.10
JWAIT   SYN, (8)233666.00            ! landed p.184 stand-in; CM1111 line 25 BIT-EXACT, no dds

        SLC, (8)233310.40
JTERM   LCI,JXIN1,10.0                                       ! line  1  -WILL TRY CCW 10 TIMES
        LV,JXCNSL,JCNAD                                      ! line  2  -GET CONSOLE CHANNEL NUMBER
        CCW,0.0(JXCNSL),JCWTMP                               ! line  3
        BZEKJZ,JEKJZ                                         ! line  4
        CB,JXIN1,JTERM+.32                                   ! line  5  -EKJ,TRY AGAIN
        B,$                                                  ! line  6  -CONSOLE DOWN,10 EKJS IN A ROW
JEKJZ   LF(BU,64),JCWTMP                                     ! line  7  -CW TO $R
        CTI0001(BU,4),(8)740000.0,41                         ! line  8  -EPGK,UK,OR EOP ON
        BZRZ,JFKCS                                           ! line  9
        LV,JXTEM,0.0(JXIN1)                                  ! line 10  -LOCATION OF I/O OP.
        BXVZ,JTERMS                                          ! line 11  (location carries an asterisk)
        BZB,.52(JXTEM),JTERM                                 ! line 12  -IF NOT SEOP,TRY AGAIN
        BB,$R+.24,JTERM                                      ! line 13  -IF SEOP NOT DOWN,TRY AGAIN
        B,JFKCS                                              ! line 14
JCWTMP  XW,0                                                 ! line 15  -STORAGE FOR CCW
JTERMS  LV,MXCST,JCNAD                                       ! line 16
        V+,MXCST,MXCST                                       ! line 17
        V+,MXCST,SCHANS                                      ! line 18
        BB,SCHOP(MXCST),JTERM                                ! line 19  - IF CHANNEL OPERATING
JFKCS   BZB,$R.23,.32(JXIN1)                                 ! line 20
        LV,$14,JCNAD                                         ! line 21
        SIC,KSTCS                                            ! line 22  \ one card, SA000230
        B,KCSIN                                              ! line 23  / printed on both lines
        LF(BU),JCWTMP                                        ! line 24
        CM1111(BU,1),JWAIT                                   ! line 25
        B,.32(JXIN1)                                         ! line 26
!                                                            ! line 27  - (blank remark card)
!       *****RELEASE CONSOLE ROUTINE*****                    ! line 28  - remark card
!                                                            ! line 29  - (blank remark card)
!       LINKAGE...LVI,JXIN2,$+1.0                            ! line 30  - remark card
!       B,JRELCN                                             ! line 31  - remark card
!       RETURN,CONSOLE RELEASED                              ! line 32  - remark card
!                                                            ! line 33  - (blank remark card)
JRELCN  LCI,JXIN2,10.0                                       ! line 34  -WILL TRY REL 10 TIMES  (location carries an asterisk)
        REL(SEOP),0.0(JXCNSL)                                ! line 35  -INDEX HAS CONSOLE CHANNEL NO.
        BZEKJZ,JNOEKJ                                        ! line 36
        CB,JXIN2,JRELCN+.32                                  ! line 37
        B,$                                                  ! line 38  -CONSOLE DOWN,10 EKJS IN A ROW
JNOEKJ  LVI,JXIN1,$+1.0                                      ! line 39  -TEST FOR COMPLETION
        B,JTERM                                              ! line 40
        VF,JRELCN+.32                                        ! line 41
        B,0.0(JXIN2)                                         ! line 42  -EXIT
!                                                            ! line 43  - (blank remark card)
!       *****CONSOLE I/O ACCEPTANCE ROUTINE*****             ! line 44  - remark card
!                                                            ! line 45  - (blank remark card)
!       LINKAGE...LVI,JXIN1,$+1.0                            ! line 46  - remark card
!       B,JIOGO                                              ! line 47  - remark card
!       PRESET I/O COMMAND                                   ! line 48  - remark card
!       RETURN CBJ                                           ! line 49  - remark card
!       RETURN IF ACCEPTED                                   ! line 50  - remark card
!                                                            ! line 51  - (blank remark card)
JIOGO   LF(BU,64),0.0(JXIN1)                                 ! line 52  -PICK UP I/O COM.  (printed "J I C G O")

!SYM JTERM  233310.40
!SYM JEKJZ  233314.00
!SYM JCWTMP 233322.00
!SYM JTERMS 233323.00
!SYM JFKCS  233325.40
!SYM JRELCN 233332.40
!SYM JNOEKJ 233335.40
!SYM JIOGO  233337.40
