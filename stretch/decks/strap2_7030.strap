        L(BU,8), 3.0($9)
        KI(BU,8), 0
        BAE, GFZD
! Box 78: the item's data join the outer data; its operators, renumbered
! after the outer data, stay where they are in GFOPS
        SIC, GFZLK
        B, GFLZC
        L(BU,24), 0($9)
        ST(BU,24), GFCS
        L(BU,24), 1.0($9)
        ST(BU,24), GFCE
        SIC, GFCLK
        B, GFCOPY
        SIC, GFILK
        B, GFIADR
        L(BU,8), GFN
        ST(BU,8), GFPARN
        +(BU,8), 3.8($9)
        ST(BU,8), GFN
        L(BU,8), 3.0($9)
        ST(BU,18), GFCR
        L(BU,24), 2.0($9)
        ST(BU,24), GFT
        LV, $7, GFT
        LC, $8, GFCR
GFCL3   L(BU,5), .4($7)
        +(BU,8), GFPARN
        ST(BU,5), .4($7)
        L(BU,1)(V+I), .9($7)
        CB, $8, GFCL3
        LI(BU,1), 1
        ST(BU,1), GFLAZ
        LI(BU,1), 0
        ST(BU,1), GFLKA
        ST(BU,1), GFSUB
        B, GFCX
! a zero datum, its end held open, the items its S/X
GFZD    SIC, GFZLK
        B, GFLZC
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        LI(BU,24), 0
        ST(BU,24)(V+I), .24($2)
        M+1(BU,8), GFN
        LI(BU,1), 1
        ST(BU,1), GFLAZ
        ST(BU,1), GFLKA
! each item as S/X (p.199 note 2): 1000, its data, the end of its last
! datum and of the data, its operators, no more operators
GFSUBS  LI(BU,8), 0
        ST(BU,8), GFCI
GFSB1   SIC, GFILK
        B, GFIADR
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
        L(BU,24), 0($9)
        ST(BU,24), GFCS
        L(BU,24), 1.0($9)
        ST(BU,24), GFCE
        SIC, GFCLK
