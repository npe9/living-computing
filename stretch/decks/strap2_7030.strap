TBMK    DD(BU,64), 0
TBMC    DD(BU,64), 0
TBSLK   DD(BU,64), 0
TBFLK   DD(BU,64), 0
TBULK   DD(BU,64), 0
TBELK   DD(BU,64), 0
TBMLK   DD(BU,64), 0
! ANEXT's: Afirst (on at the start, p.51), Anextx and Anexta (index
! words), the ID, $2 saved, a work cell.  RSERCH's Azzs (p.53).
AFIRST  DD(BU,64), (16)8000000000000000
ANEXTX  XW, 0, 0, 0
ANEXTA  XW, 0, 0, 0
ANID    DD(BU,64), 0
ANSAV   DD(BU,64), 0
ANT     DD(BU,64), 0
AZZS    DD(BU,64), 0
TBTWO   DD(BU,64), (16)0000020000000000
TBV32   DD(BU,64), (16)0000200000000000
!
! ======== SECTION A1: Pass 1's constants and work areas (p.174) =======
GCEND   SYN, GCCARD+9.0
! LVI loads a half-word address (the bits below .32 are dropped;
! card_reader.strap), so an address with a bit part is loaded with LV from
! an index word:
KNAME   XW, GCCARD+.8, 0, 0
KSTMT   XW, GCCARD+1.8, 0, 0
GETCHZ  DD(BU,64), 0
GCOLK   DD(BU,64), 0
GCNLK   DD(BU,64), 0
GCPLK   DD(BU,64), 0
GCTMP   DD(BU,64), 0
NTMP    DD(BU,64), 0
FEND    DD(BU,64), (16)8000000000000000
FEOF    DD(BU,64), 0
GCOPEN  DD(BU,64), 0
GCCOM   DD(BU,64), 0
GCCMC   DD(BU,64), 0
GCQ     DD(BU,64), 0
GCNC    DD(BU,64), 0
NAMEND  DD(BU,64), 0
NAMEL   DD(BU,64), 0
NAMET   DD(BU,64), 0
NAMEB   DRZ(BU,64), 8
GCCARD  DRZ(BU,64), 10
! GETFLD (p.83 LINKAGE): BCFLDX's value is the coded expression's first
! bit, a full word, and on exit its next bit; BCFXTX the first bit after the
! buffer (not tested yet); GFCHAR bit 0 on if $3 already holds the field's
! first character.  GFSRAD, the radix (p.70), zero means 10.
BCFLDX  XW, 0, 0, 0
BCFXTX  XW, 0, 0, 0
GFCHAR  DD(BU,64), 0
GFSRAD  DD(BU,64), 0
GETFLZ  DD(BU,64), 0
CPLTNZ  DD(BU,64), 0
CPLTSZ  DD(BU,64), 0
GFPLK   DD(BU,64), 0
GFELK   DD(BU,64), 0
GFSAV2  DD(BU,64), 0
GFC     DD(BU,64), 0
GFP0    DD(BU,64), 0
GFSN    DD(BU,64), 0
GFOPN   DD(BU,64), 0
GFNEW   DD(BU,64), 0
GFOP    DD(BU,64), 0
GFOPP   XW, GFOPS, 0, 0
CHXT    DD(BU,64), 0
STX     DD(BU,64), 0
STXD    DD(BU,64), 0
STXK    DD(BU,64), 0
STXF    DD(BU,64), 0
STXC    DD(BU,64), 0
STXP    DD(BU,64), 0
GFKEY   DD(BU,64), 0
GFBLNK  DD(BU,64), (16)1010101010101010
GFSNL   DD(BU,64), 0
GFSVV   DD(BU,64), 0
GFMF    DD(BU,64), 0
GFMPOS  DD(BU,64), 0
GFMK    DD(BU,64), 0
GFMI    DD(BU,64), 0
GFMJ    DD(BU,64), 0
GFBLK   DD(BU,64), 0
! BOPSER's cells (24-bit values at .0 unless shown); LLXW is p.67's Llxw
LLXW    DD(BU,64), 0
BPCB    DD(BU,64), 0
BPNE    DD(BU,64), 0
BPEL    DD(BU,64), 0
BPN     DD(BU,64), 0
BPP     DD(BU,64), 0
BPC     DD(BU,64), 0
BPIB    DD(BU,64), 0
BPDB    DD(BU,64), 0
BPTB    DD(BU,64), 0
BPI     DD(BU,64), 0
BPD     DD(BU,64), 0
BPK     DD(BU,64), 0
BPQ     DD(BU,64), 0
BPPRD   DD(BU,64), 0
BPAT    DD(BU,64), 0
BPCNT   DD(BU,64), 0
BPFST   DD(BU,64), 0
BPDIR   DD(BU,64), 0
BPTST   DD(BU,64), 0
BPZLK   DD(BU,64), 0
BP32    DD(BU,64), (16)0000200000000000
BP64    DD(BU,64), (16)0000400000000000
GFIDP   DD(BU,64), 0
GFDEP   DD(BU,64), 0
GFCK    DD(BU,64), 0
! sub-slice d: a g.p. met (GFGP), its n and r (r 0: none, radix 10), an
! inner expression (GFINR: its null is not the field's), the expression's
! prefix address (GFXS), GFINI's link
GFGP    DD(BU,64), 0
GFGPN   DD(BU,64), 0
GFGPR   DD(BU,64), 0
GFINR   DD(BU,64), 0
GFXS    DD(BU,64), 0
GFGLK   DD(BU,64), 0
! GFLIM: Bcfxtx rounded down to a full word (p.83); GFLONG's link
GFLIM   DD(BU,64), 0
GFLLK   DD(BU,64), 0
GFCN    DD(BU,64), 0
GFCI    DD(BU,64), 0
GFPARN  DD(BU,64), 0
GFCS    DD(BU,64), 0
GFCE    DD(BU,64), 0
GFCL    DD(BU,64), 0
GFCR    DD(BU,64), 0
GFT     DD(BU,64), 0
GFZLK   DD(BU,64), 0
GFCLK   DD(BU,64), 0
GFILK   DD(BU,64), 0
GFSLK   DD(BU,64), 0
! An expression's context, 16 words, saved in GFFRM at each '(' and
! restored at its ')' (CHOSEN layout; the chart's Box 2 "pushes the buffer
! one word"): data count, operator floor, unary and point flags, the first
! datum, the end bit held open (GFLAZ), the last datum absolute (GFLKA) and
! with S/X (GFSUB); the parenthesis' kind (0 a datum's start, 1 after a
! datum, 2 after a point) and items; $2; the slot; the item's start, its
! operators' start (pointer, count).
GFCTX   SYN, $
GFN     DD(BU,64), 0
GFFLR   DD(BU,64), 0
GFUN    DD(BU,64), 0
GFPT    DD(BU,64), 0
GFDOTL  DD(BU,64), 0
GFFRST  DD(BU,64), 0
GFLAZ   DD(BU,64), 0
GFLKA   DD(BU,64), 0
GFSUB   DD(BU,64), 0
GFKND   DD(BU,64), 0
GFNIT   DD(BU,64), 0
GFR2    DD(BU,64), 0
GFSLS   DD(BU,64), 0
GFIDS   DD(BU,64), 0
GFIOB   DD(BU,64), 0
GFIOBN  DD(BU,64), 0
GFCTXX  XW, GFCTX, 0, 0
GFFRMX  XW, GFFRM, 0, 0
GFITMX  XW, GFITM, 0, 0
GFSCRX  XW, GFSCR-32.0, 0, 0
! the operator stack, 16 bits an entry (precedence at .5, code at .8,
! datum number at .11), and the operators put, 9 bits each (p.198 3A-3C)
GFSTK   DRZ(BU,64), 8
GFOPS   DRZ(BU,64), 6
! GFFRM: a context for each depth, 8 x 16 words.  GFITM: each depth's
! items, 8 x 8 x 4 words: first data bit, the bit after, operators'
! pointer, then count (.0), data count (.8), lone absolute datum (.16),
! .n (.17).  GFSCR: each depth's scratch slot, 32 words, depth 1 first.
GFFRM   DRZ(BU,64), 128
GFITM   DRZ(BU,64), 256
GFSCR   DRZ(BU,64), 224
! CPLTNM: PR, the partial result, and the radix and a digit in floating
! point (Box 1, Box 3): exponent 48 (bits 1-10), the value at the low end
! of the fraction (bits 12-59; RefMan printed pp.78-79).  CPZ48, exponent 48
! and fraction 0, aligns PR to an integer (Box 9).
CPPR    DD(BU,64), 0
CPZERO  DD(BU,64), 0
CPRADF  DD(BU,64), (16)0600000000000000
CPDIGF  DD(BU,64), (16)0600000000000000
CPZ48   DD(BU,64), (16)0600000000000000
CPWRK   DD(BU,64), 0
CPLV    DD(BU,64), 0
! the digits as written, in decimal (a radix, a g.p.'s n and r): .0, 24 bits
CPDEC   DD(BU,64), 0
CPDE2   DD(BU,64), 0
CPDE4   DD(BU,64), 0
CPDD    DD(BU,64), 0
! CPLTSY: BSYMBX's value is where the symbol goes (p.74); CPLEN its length
BSYMBX  XW, 0, 0, 0
CPLEN   DD(BU,64), 0
!
! ======== SECTION 1: subroutines unique to Pass 1 (p.174) ==============
!
! XINPUT: the next card image, converted (p.77 boxes 4, 36).  COMREC word 8
! names the code (p.9); only 5, IQS, is written.  The input block is INX's:
! value the next card, count the cards left, ten words each.  The card goes
! to GCNEXT in A8; HAVEN is 1 if there was one.
XINPUT  L(BU,3), COMREC+8.25
        KI(BU,3), 5
        BAE, XIN0
        LI(BU,24), 1
        B, ERROR
XIN0    LI(BU,1), 0
        ST(BU,1), HAVEN
        LX, $13, INX
        KCI, $13, 0
        BXE, XIN9
        LVI, $7, GCNEXT
        LCI, $8, 80
XIN1    L(BU,8)(V+I), .8($13)
        ST(BU,8), XTMP+.13
        LV, $9, XTMP
        L(BU,8), IQSA8($9)
        ST(BU,8)(V+I), .8($7)
        CB, $8, XIN1
        LX, $13, INX
        C-I, $13, 1
        V+I, $13, 10.0
        SX, $13, INX
        LI(BU,1), 1
        ST(BU,1), HAVEN
XIN9    LV, $8, XINLK
        B, 0($8)
!
! GETCHA (Charts BG, BH pp.77-78; p.79).  One character to $3 per call.
! Blanks are skipped (Gcaz off; p.102's Gcaz, blanks significant, is not
! written yet).  At the end of a card block, the false semicolon with FEND
! on (p.79 item 5); at the end of the input, FEOF on (CHOSEN: MAIN stops at
! END; the driver stops here).  $14's value field is the next column of
! GCCARD.  GCCOM: a comment from columns 1-9 of the initial card (no name,
! nothing more to MAIN); GCCMC: a comment from columns 2-9 of a continuation
! card (the name goes on, nothing more to MAIN).
GETCHA  LI(BU,1), 0
        ST(BU,1), FEND
        L(BU,1), GCOPEN
        KI(BU,1), 1
        BAE, GC10
! no card block open: open the next one (box 3: GETCHA's initial entry)
        L(BU,1), HAVEN
        KI(BU,1), 1
        BAE, GC2
        LI(BU,1), 1
        ST(BU,1), FEOF
        B, GCX
GC2     SIC, GCOLK
        B, GCOPN
        LI(BU,1), 1
        ST(BU,1), GCOPEN
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        ST(BU,1), GCCOM
        ST(BU,1), GCCMC
        ST(BU,1), NAMEND
! column 1 (box 10): the comment character makes the card block a comment
        L(BU,8), GCCARD
        KI(BU,8), (8)14
        BAE, GC5
! columns 2-9 (boxes 14-16): a comment character there makes the block a
! comment (p.79); otherwise they are the name
        LV, $7, KNAME
        LCI, $8, 8
GC3     L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC5
        CB, $8, GC3
        LI(BU,18), 8
        ST(BU,18), GCNC
        SIC, GCNLK
        B, GCNAME
! CHOSEN, as strap2's Getcha: the initial card's name loses its trailing
! blanks before a continuation card adds to it (p.79 does not say)
        L(BU,18), NAMET
        ST(BU,18), NAMEL
        LV, $14, KSTMT
        B, GC10
GC5     LI(BU,1), 1
        ST(BU,1), GCCOM
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
! the statement field, columns 10-72 (box 22)
GC10    KVI, $14, GCEND
        BXL, GC20
! the end of the statement field (box 32): a continuation card (box 37)?
        L(BU,1), HAVEN
        KI(BU,1), 1
        BZAE, GC15
        L(BU,8), GCNEXT
        KI(BU,8), (8)54
        BZAE, GC15
        SIC, GCOLK
        B, GCOPN
! a comment block from the initial card: nothing of it to MAIN (p.79:
! "without giving them out to main flow through $3")
        L(BU,1), GCCOM
        KI(BU,1), 1
        BAE, GC14
! columns 2-9: a comment character there (p.79) ends the name part of the
! card; GCNC counts the columns before it
        LV, $7, KNAME
        LCI, $8, 8
        LI(BU,18), 0
        ST(BU,18), GCNC
        ST(BU,1), GCQ
GC16    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC17
        M+1(BU,18), GCNC
        CB, $8, GC16
        B, GC18
GC17    LI(BU,1), 1
        ST(BU,1), GCQ
! the name part continues the name (p.79), until one is blank
GC18    L(BU,1), NAMEND
        KI(BU,1), 1
        BAE, GC19
        L(BU,18), GCNC
        KI(BU,18), 0
        BAE, GC1E
        LV, $7, KNAME
        LC, $8, GCNC
GC1A    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)20
        BZAE, GC1B
        CB, $8, GC1A
GC1E    LI(BU,1), 1
        ST(BU,1), NAMEND
        B, GC19
GC1B    SIC, GCNLK
        B, GCNAME
! after a comment from a continuation card, its later statement fields are
! comment too (p.79)
GC19    L(BU,1), GCCMC
        KI(BU,1), 1
        BAE, GC14
        L(BU,1), GCQ
        KI(BU,1), 1
        BZAE, GC12
! p.79: "A comment character appearing in columns 2-9 of a continuation card
! causes the remaining characters on the card to be treated as a comment";
! MAIN gets the comment character "in $3 as usual"
        LI(BU,1), 1
        ST(BU,1), GCCMC
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC12    LV, $14, KSTMT
        B, GC10
GC14    LVI, $14, GCEND
        B, GC10
! the end of the card block (box 38): the false semicolon
GC15    LI(BU,1), 1
        ST(BU,1), FEND
        LI(BU,1), 0
        ST(BU,1), GCOPEN
        LI(BU,8), (8)35
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC20    L(BU,8)(V+I), .8($14)
        KI(BU,8), (8)20
        BAE, GC10
        SIC, GCPLK
        B, GCPUT
GCX     LV, $8, GETCHZ
        B, 0($8)
!
! GCPUT: the accumulator's byte to $3's value field
GCPUT   ST(BU,8), GCTMP+.16
        LV, $3, GCTMP
        LV, $8, GCPLK
        B, 0($8)
!
! GCOPN: GCNEXT becomes GCCARD, and XINPUT reads the next
GCOPN   LVI, $7, GCNEXT
        LVI, $9, GCCARD
        LCI, $8, 10
GCO1    L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GCO1
        SIC, XINLK
        B, XINPUT
        LV, $8, GCOLK
        B, 0($8)
!
! GCNAME: GCNC (at least 1) columns from column 2 of GCCARD to the name
! buffer (box 20); NAMET is the length to the last character that is not
! blank (strap2: rstrip)
GCNAME  LV, $7, KNAME
        LC, $8, GCNC
GCN1    L(BU,18), NAMEL
        KI(BU,18), 64
        BZAE, GCN2
        LI(BU,24), 2
        B, ERROR
GCN2    ST(BU,18), NTMP+.3
        LV, $9, NTMP
        L(BU,8)(V+I), .8($7)
        ST(BU,8), NAMEB($9)
        M+1(BU,18), NAMEL
        KI(BU,8), (8)20
        BAE, GCN3
        L(BU,18), NAMEL
        ST(BU,18), NAMET
GCN3    CB, $8, GCN1
        LV, $8, GCNLK
        B, 0($8)
!
! GETFLD (Charts BI-BK pp.80-82, text pp.83-86): one field's coded
! expression (Appendix C p.198) at BCFLDX.  Call SIC,GETFLZ; B,GETFLD (p.83).
! The data go in as they are read; each operator waits on GFSTK until one
! of no higher priority comes (p.198: .+ .L .R U- * / + -), and is put,
! with its datum number, in GFOPS; GFZA puts them after the data (Boxes 43,
! 60).  Sub-slice b: parentheses, built in a scratch slot per depth and
! placed at the ')' (docs/strap2_7030.md, CHOSEN).  Sub-slice c: $ and the
! system symbols.  Not yet: g.p. and radix (sub-slice d).
GETFLD  SX, $2, GFSAV2
        LV, $2, BCFLDX
        L(BU,24), BCFXTX
        ST(BU,24), GFLIM
        LI(BU,6), 0
        ST(BU,6), GFLIM+.18
        LI(BU,8), 0
        ST(BU,8), GFSN
        ST(BU,8), GFSRAD
        ST(BU,8), GFDEP
        LI(BU,1), 0
        ST(BU,1), GFINR
        SIC, GFGLK
        B, GFINI
! Boxes 3-4: the first character, unless the user has it (Gfchar)
        L(BU,1), GFCHAR
        KI(BU,1), 1
        BAE, GF1
        SIC, GETCHZ
        B, GETCHA
! Boxes 31, 34-35: nothing before the end of the field, the null prefix
GF1     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFNULL
        KI(BU,8), (8)35
        BAE, GFNULL
        KI(BU,8), (8)14
        BAE, GFNULL
        KI(BU,8), (8)74
        BAE, GFNULL
! the prefix: 1A, and 1B type 000 (p.198)
        SV, $2, GFXS
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
! a datum is expected (S-codes B, O, p.83): a leading plus does nothing; a
! minus is unary, once (U-); a point with no datum before it waits as .R.
! A point is an operator of the top priority (p.198), so it waits on GFSTK
! like the others, and the datum after it is put first.
GFE     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)60
        BZAE, GFE1
        L(BU,1), GFFRST
        KI(BU,1), 1
        BZAE, GFSYN
        LI(BU,1), 0
        ST(BU,1), GFFRST
        SIC, GETCHZ
        B, GETCHA
        B, GFE
GFE1    LI(BU,1), 0
        ST(BU,1), GFFRST
        L(BU,8), GFC+.16
        KI(BU,8), (8)40
        BZAE, GFE2
        L(BU,1), GFUN
        KI(BU,1), 1
        BAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFUN
        LI(BU,3), 3
        ST(BU,3), GFNEW+.53
        LI(BU,3), 4
        B, GFE4
GFE2    L(BU,8), GFC+.16
        KI(BU,8), (8)73
        BZAE, GFE6
        L(BU,1), GFPT
        KI(BU,1), 1
        BAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFPT
        LI(BU,3), 4
        ST(BU,3), GFNEW+.53
        LI(BU,3), 5
GFE4    ST(BU,3), GFNEW+.56
        L(BU,8), GFN
        ST(BU,5), GFNEW+.59
        SIC, GFELK
        B, GFPUSH
        SIC, GFLLK
        B, GFLONG
        SIC, GETCHZ
        B, GETCHA
        B, GFE
GFE6    L(BU,8), GFC+.16
        KI(BU,8), (8)34
        BZAE, GFE3
        LI(BU,8), 0
        B, GFOPEN
GFE3    SIC, GFPLK
        B, GFPRIM
        LI(BU,1), 0
        ST(BU,1), GFUN
! Boxes 58-59: a datum after "a." makes its .L a .+
        L(BU,1), GFDOTL
        KI(BU,1), 1
        BZAE, GFA
        LI(BU,1), 0
        ST(BU,1), GFDOTL
        L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        LI(BU,3), 7
        ST(BU,3), GFSTK-.8($9)
! after a datum (S-code S, p.83): a point (one to a datum: a second ends
! the field, 167 as strap2's 67), a binary operator, or the end
GFA     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)34
        BZAE, GFA5
        LI(BU,8), 1
        B, GFOPEN
GFA5    L(BU,8), GFC+.16
        KI(BU,8), (8)73
        BZAE, GFA1
        L(BU,1), GFPT
        KI(BU,1), 1
        BAE, GFEND
        LI(BU,1), 1
        ST(BU,1), GFPT
        LI(BU,3), 4
        ST(BU,3), GFNEW+.53
        LI(BU,3), 6
        ST(BU,3), GFNEW+.56
        L(BU,8), GFN
        ST(BU,5), GFNEW+.59
        SIC, GFELK
        B, GFPUSH
        SIC, GFLLK
        B, GFLONG
        SIC, GETCHZ
        B, GETCHA
! a datum follows the point: an alphameric character, $ or (
GFA6    SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BAL, GFA0
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BAE, GFA0
        KI(BU,8), (8)34
        BZAE, GFA
        LI(BU,8), 2
        B, GFOPEN
GFA0    LI(BU,1), 1
        ST(BU,1), GFDOTL
        B, GFE3
GFA1    LI(BU,3), 1
        ST(BU,3), GFNEW+.53
        LI(BU,3), 1
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)60
        BAE, GFA2
        LI(BU,3), 0
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)40
        BAE, GFA2
        LI(BU,3), 2
        ST(BU,3), GFNEW+.53
        LI(BU,3), 3
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)54
        BAE, GFA2
        LI(BU,3), 2
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)21
        BAE, GFA2
        B, GFEND
! put each waiting operator of no lower priority, down to this expression's
! floor GFFLR, then this one waits
GFA2    L(BU,8), GFN
        ST(BU,5), GFNEW+.59
GFA3    L(BU,8), GFSN
        K(BU,8), GFFLR
        BAE, GFA4
        SIC, GFELK
        B, GFTOP
        L(BU,3), GFOP+.53
        K(BU,3), GFNEW+.53
        BAL, GFA4
        M-1(BU,8), GFSN
        SIC, GFELK
        B, GFPUT
        B, GFA3
GFA4    LI(BU,1), 0
        ST(BU,1), GFPT
        SIC, GFELK
        B, GFPUSH
        SIC, GFLLK
        B, GFLONG
        SIC, GETCHZ
        B, GETCHA
        B, GFE
! the end of the field: every waiting operator is put
GFEND   L(BU,8), GFSN
        K(BU,8), GFFLR
        BAE, GFEN1
        SIC, GFELK
        B, GFTOP
        M-1(BU,8), GFSN
        SIC, GFELK
        B, GFPUT
        B, GFEND
GFEN1   L(BU,8), GFDEP
        KI(BU,8), 0
        BZAE, GFITEM
GFEN2   L(BU,1), GFGP
        KI(BU,1), 1
        BAE, GFZA
        SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFZA
        KI(BU,8), (8)35
        BAE, GFZA
        KI(BU,8), (8)14
        BAE, GFZA
        KI(BU,8), (8)74
        BAE, GFZA
        LI(BU,24), 167
        B, ERROR
! GFZA (Boxes 43, 60): the end of the data, the operators, no more
! operators, and no g.p. (Box 46: "the bit at the end ... set to zero").
! After a g.p. (Boxes 37-38): 1, n in 6 bits, then its value, an expression
! of its own in the radix r (zero: 10); a field with no data before its
! g.p. is null (as strap2: "(.3)5"), a value with none is not.
GFZA    L(BU,1), GFGP
        KI(BU,1), 1
        BZAE, GFZA0
        L(BU,1), GFINR
        KI(BU,1), 1
        BAE, GFZA0
        L(BU,8), GFN
        KI(BU,8), 0
        BZAE, GFZA0
        LV, $2, GFXS
        LI(BU,5), (8)36
        ST(BU,5)(V+I), .5($2)
        B, GFGPT
GFZA0   SIC, GFZLK
        B, GFLZC
        LI(BU,1), 0
        ST(BU,1)(V+I), .1($2)
        L(BU,18), GFOPN
        KI(BU,18), 0
        BAE, GFZ2
        LVI, $9, GFOPS
        LC, $8, GFOPN
GFZ1    L(BU,9)(V+I), .9($9)
        ST(BU,9)(V+I), .9($2)
        CB, $8, GFZ1
GFZ2    L(BU,1), GFGP
        KI(BU,1), 1
        BAE, GFZ3
        LI(BU,2), 0
        ST(BU,2)(V+I), .2($2)
GFX     SIC, GFLLK
        B, GFLONG
        SV, $2, BCFLDX
        LX, $2, GFSAV2
        LV, $8, GETFLZ
        B, 0($8)
GFZ3    LI(BU,1), 0
        ST(BU,1)(V+I), .1($2)
GFGPT   LI(BU,1), 1
        ST(BU,1)(V+I), .1($2)
        L(BU,8), GFGPN
        ST(BU,6)(V+I), .6($2)
        L(BU,8), GFGPR
        ST(BU,8), GFSRAD
        LI(BU,1), 1
        ST(BU,1), GFINR
        SIC, GFGLK
        B, GFINI
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
! no value (the end of the field) is GFE's: a datum expected, 166
        B, GFE
! GFLONG (Box 55): room in the buffer, $2 not past GFLIM.  Inside a
! parenthesis $2 is in GFSCR, whose slots have their own bound (10).
GFLONG  L(BU,8), GFDEP
        KI(BU,8), 0
        BZAE, GFLN1
        SV, $2, GFT
        L(BU,24), GFT
        K(BU,24), GFLIM
        BAH, GFLN2
GFLN1   LV, $8, GFLLK
        B, 0($8)
GFLN2   LI(BU,24), 11
        B, ERROR
! GFINI: an expression's state empty, at GETFLD and for a g.p.'s value
GFINI   LI(BU,64), 0
        LV, $9, GFCTXX
        LCI, $8, 16
GFI0    ST(BU,64)(V+I), 1.0($9)
        CB, $8, GFI0
        LI(BU,18), 0
        ST(BU,18), GFOPN
        LI(BU,64), 0
        ST(BU,64), GFNEW
        ST(BU,64), GFOP
        LVI, $9, GFOPS
        SV, $9, GFOPP
        LI(BU,1), 1
        ST(BU,1), GFFRST
        LI(BU,1), 0
        ST(BU,1), GFGP
        LV, $8, GFGLK
        B, 0($8)
GFNULL  LI(BU,6), (8)74
        ST(BU,6)(V+I), .6($2)
        B, GFX
GFSYN   LI(BU,24), 166
        B, ERROR
!
! GFPRIM: a number (Boxes 8, 16-17) or a programmer symbol (Boxes 7, 15,
! 25-27), into the coded expression with the end of its datum (2E, 0)
GFPRIM  SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 10
        BAL, GFPN
        KI(BU,8), 36
        BAL, GFPS
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BAE, GFPD
        B, GFSYN
GFPN    SIC, CPLTNZ
        B, CPLTNM
        SIC, GFZLK
        B, GFLZC
        LI(BU,1), 1
        ST(BU,1), GFLKA
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        L(BU,24), CPLV
        ST(BU,24)(V+I), .24($2)
        B, GFPE
! Box 15: ten bits left for the prefix and length; CPLTSY puts the symbol
GFPS    SIC, GFZLK
        B, GFLZC
        LI(BU,1), 0
        ST(BU,1), GFLKA
        SV, $2, GFP0
        LI(BU,10), 0
        ST(BU,10)(V+I), .10($2)
        SV, $2, BSYMBX
        SIC, CPLTSZ
        B, CPLTSY
        LV, $2, BSYMBX
        LV, $9, GFP0
        LI(BU,3), 4
        ST(BU,3)(V+I), .3($9)
        L(BU,8), CPLEN
        ST(BU,7)(V+I), .7($9)
! the end of the datum (2E, 0) is held open: S/X may follow (p.198)
GFPE    LI(BU,1), 1
        ST(BU,1), GFLAZ
        LI(BU,1), 0
        ST(BU,1), GFSUB
        M+1(BU,8), GFN
        LV, $8, GFPLK
        B, 0($8)
!
! GFPUSH: GFNEW onto the operator stack.  GFTOP: the top entry, GFSN's
! less one, to GFOP (the caller lowers GFSN to take it off).  GFPUT: GFOP's
! operator into GFOPS, 1, code, datum number (p.198 3A-3C).
GFPUSH  L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        L(BU,16), GFNEW+.48
        ST(BU,16), GFSTK($9)
        M+1(BU,8), GFSN
        LV, $8, GFELK
        B, 0($8)
GFTOP   L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        L(BU,16), GFSTK-.16($9)
        ST(BU,16), GFOP+.48
        LV, $8, GFELK
        B, 0($8)
GFPUT   LV, $9, GFOPP
        LI(BU,1), 1
        ST(BU,1)(V+I), .1($9)
        L(BU,8), GFOP+.56
        ST(BU,8)(V+I), .8($9)
        SV, $9, GFOPP
        M+1(BU,18), GFOPN
        LV, $8, GFELK
        B, 0($8)
!
! GFLZC: the open datum's end bit (2E, 0), if one is held open
GFLZC   L(BU,1), GFLAZ
        KI(BU,1), 1
        BZAE, GFLZ1
        LI(BU,1), 0
        ST(BU,1), GFLAZ
        ST(BU,1)(V+I), .1($2)
GFLZ1   LV, $8, GFZLK
        B, 0($8)
!
! GFOPEN: a '(' (Box 5), its kind in the accumulator: 0 at a datum's start,
! 1 after a datum, 2 after a datum's point.  The outer context is saved
! (Box 2: "the buffer is pushed down one word"); the parenthesis' items
! are built in this depth's slot of GFSCR and placed at its ')'.
GFOPEN  ST(BU,8), GFT
        L(BU,8), GFDEP
        KI(BU,8), 7
        BZAE, GFO1
        LI(BU,24), 10
        B, ERROR
GFO1    SV, $2, GFR2
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
        B, GFSAVE
        M+1(BU,8), GFDEP
        L(BU,8), GFT
        ST(BU,8), GFKND
        LI(BU,8), 0
        ST(BU,8), GFNIT
        L(BU,8), GFDEP
        ST(BU,8), STXD+.5
        LV, $2, GFSCRX
        V+, $2, STXD
        SV, $2, GFSLS
        SIC, GETCHZ
        B, GETCHA
! an item begins: an expression of its own
GFIS    LI(BU,8), 0
        ST(BU,8), GFN
        L(BU,8), GFSN
        ST(BU,8), GFFLR
        LI(BU,1), 0
        ST(BU,1), GFUN
        ST(BU,1), GFPT
        ST(BU,1), GFDOTL
        ST(BU,1), GFLAZ
        ST(BU,1), GFLKA
        ST(BU,1), GFSUB
        LI(BU,1), 1
        ST(BU,1), GFFRST
        SV, $2, GFIDS
        L(BU,24), GFOPP
        ST(BU,24), GFIOB
        L(BU,18), GFOPN
        ST(BU,18), GFIOBN
        B, GFE
!
! GFITEM: an item ends at ',' or ')' (Box 71; anything else, 167).  Its
! record: data bits, operators, data count, and whether it is one absolute
! datum alone (Box 64) or .n (Boxes 65-66).
GFITEM  SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFIT1
        KI(BU,8), (8)74
        BAE, GFIT1
        LI(BU,24), 167
        B, ERROR
GFIT1   SV, $2, GFT
        L(BU,24), GFT
        -(BU,24), GFSLS
        KI(BU,24), 2048
        BZAH, GFIT2
        LI(BU,24), 10
        B, ERROR
GFIT2   L(BU,8), GFNIT
        KI(BU,8), 8
        BZAE, GFIT3
        LI(BU,24), 10
        B, ERROR
GFIT3   L(BU,8), GFDEP
        ST(BU,8), GFIDP
        L(BU,8), GFNIT
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), GFIDS
        ST(BU,24), 0($9)
        SV, $2, GFT
        L(BU,24), GFT
        ST(BU,24), 1.0($9)
        L(BU,24), GFIOB
        ST(BU,24), 2.0($9)
        L(BU,18), GFIOBN
        ST(BU,18), 2.24($9)
        L(BU,18), GFOPN
        -(BU,18), GFIOBN
        ST(BU,8), 3.0($9)
        L(BU,8), GFN
        ST(BU,8), 3.8($9)
        LI(BU,2), 0
        ST(BU,2), 3.16($9)
        L(BU,24), CPDEC
        ST(BU,24), 3.24($9)
        L(BU,8), GFN
        KI(BU,8), 1
        BZAE, GFIT5
        L(BU,1), GFLKA
        KI(BU,1), 1
        BZAE, GFIT5
        L(BU,1), GFSUB
        KI(BU,1), 0
        BZAE, GFIT5
        L(BU,8), 3.0($9)
        KI(BU,8), 0
        BZAE, GFIT4
        LI(BU,1), 1
        ST(BU,1), 3.16($9)
        B, GFIT5
GFIT4   KI(BU,8), 1
        BZAE, GFIT5
        LV, $7, GFIOB
        L(BU,9), 0($7)
        KI(BU,9), (8)640
        BZAE, GFIT5
        LI(BU,1), 1
        ST(BU,1), 3.17($9)
GFIT5   M+1(BU,8), GFNIT
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BZAE, GFCLOS
        SIC, GETCHZ
        B, GETCHA
        B, GFIS
!
! GFCLOS: the ')' (Boxes 56-83, p.85).  (.n), (.n,r) and (r,.n) are a g.p.
! (Boxes 64-70; C28-6129 p.25, p.30), at any depth but the outer one's
! must be 0 (p.207; 166 as strap2's 66); its value follows the field's
! operators (GFZA).  A lone absolute datum where no S/X may stand is a
! radix (Boxes 79-81, 74), read as written in decimal, as strap2.  An
! item .n otherwise is an ordinary item.  Otherwise, with the outer context back:
! after a datum or its point, S/X of that datum (Boxes 56, 60, 62); at a
! datum's start, one item with an operator joins the outer expression
! (Boxes 76-78, CHOSEN: an operator makes it arithmetic), and anything
! else is S/X on a zero datum (Box 82; MCP p.126's KV,2,($1)).
GFCLOS  L(BU,8), GFKND
        ST(BU,8), GFCK
        L(BU,8), GFNIT
        ST(BU,8), GFCN
        L(BU,8), GFDEP
        ST(BU,8), GFIDP
        LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,8), GFCN
        KI(BU,8), 1
        BZAE, GFCG2
! one item: (.n) a g.p.; lone, not after a datum, a radix
        L(BU,1), 3.17($9)
        KI(BU,1), 1
        BZAE, GFCR0
        L(BU,24), 3.24($9)
        ST(BU,8), GFGPN
        LI(BU,8), 0
        ST(BU,8), GFGPR
        B, GFCGP
GFCR0   L(BU,8), GFCK
        KI(BU,8), 1
        BAE, GFCL2
        L(BU,1), 3.16($9)
        KI(BU,1), 1
        BZAE, GFCL2
        L(BU,24), 3.24($9)
        ST(BU,8), GFSRAD
        B, GFCRX
! two items: (.n,r) or (r,.n)
GFCG2   KI(BU,8), 2
        BZAE, GFCL2
        L(BU,1), 3.17($9)
        KI(BU,1), 1
        BZAE, GFCG3
        L(BU,24), 3.24($9)
        ST(BU,8), GFGPN
        M+1(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,1), 3.16($9)
        KI(BU,1), 1
        BZAE, GFCL2
        L(BU,24), 3.24($9)
        ST(BU,8), GFGPR
        B, GFCGP
GFCG3   L(BU,1), 3.16($9)
        KI(BU,1), 1
        BZAE, GFCL2
        L(BU,24), 3.24($9)
        ST(BU,8), GFGPR
        M+1(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,1), 3.17($9)
        KI(BU,1), 1
        BZAE, GFCL2
        L(BU,24), 3.24($9)
        ST(BU,8), GFGPN
! a g.p.: its items' operators spent (GFOPS back to the first item's
! start), the outer context back, at depth 0 only; the field's operators
! are put and its value read (GFEND, GFZA); after a point the .L stays
GFCGP   LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), 2.0($9)
        ST(BU,24), GFOPP
        L(BU,18), 2.24($9)
        ST(BU,18), GFOPN
        M-1(BU,8), GFDEP
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
        B, GFREST
        LV, $2, GFR2
        L(BU,8), GFDEP
        KI(BU,8), 0
        BZAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFGP
        SIC, GETCHZ
        B, GETCHA
        B, GFEND
! a radix: its item's operators spent, the outer context back; at a datum's start the datum follows
! (a point, a parenthesis or a primary, GFE2); after a point, the datum
! the point joins, a parenthesis there at a datum's start, the .L to be .+
GFCRX   LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), 2.0($9)
        ST(BU,24), GFOPP
        L(BU,18), 2.24($9)
        ST(BU,18), GFOPN
        M-1(BU,8), GFDEP
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
        B, GFREST
        LV, $2, GFR2
        SIC, GETCHZ
        B, GETCHA
        SV, $3, GFC
        L(BU,8), GFCK
        KI(BU,8), 2
        BAE, GFCR2
        B, GFE2
GFCR2   SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)34
        BZAE, GFA6
        LI(BU,1), 1
        ST(BU,1), GFDOTL
        LI(BU,8), 0
        B, GFOPEN
GFCL2   M-1(BU,8), GFDEP
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
