        DD(BU,64), (16)3527372210101010   ! EPGK
        DD(BU,64), (16)0002C9A0C0000000
        DD(BU,64), (16)3529371010101010   ! ERG
        DD(BU,64), (16)000140A040000000
        DD(BU,64), (16)3529371210101010   ! ERGS
        DD(BU,64), (16)000141A040000000
        DD(BU,64), (16)3533331010101010   ! ECC
        DD(BU,64), (16)000400A040000000
        DD(BU,64), (16)3533331210101010   ! ECCS
        DD(BU,64), (16)000401A040000000
        DD(BU,64), (16)3534142427101010   ! EDUMP
        DD(BU,64), (16)001020A040000000
        DD(BU,64), (16)3535101010101010   ! EE
        DD(BU,64), (16)0002CBA0C0000000
        DD(BU,64), (16)3613101010101010   ! FT
        DD(BU,64), (16)000380A040000000
        DD(BU,64), (16)3629353510101010   ! FREE
        DD(BU,64), (16)0002A0A040000000
        DD(BU,64), (16)3633101010101010   ! FC
        DD(BU,64), (16)0000E0A040000000
        DD(BU,64), (16)3633121010101010   ! FCS
        DD(BU,64), (16)0000E1A040000000
        DD(BU,64), (16)3635133338101010   ! FETCH
        DD(BU,64), (16)0010A0A040000000
        DD(BU,64), (16)3635232910101010   ! FELR
        DD(BU,64), (16)000960A040000000
        DD(BU,64), (16)3635332937101010   ! FECRG
        DD(BU,64), (16)0008A0A040000000
        DD(BU,64), (16)3639171427101010   ! FIXUP
        DD(BU,64), (16)000920A040000000
        DD(BU,64), (16)3726253710101010   ! GONG
        DD(BU,64), (16)0002C0A040000000
        DD(BU,64), (16)3726253712101010   ! GONGS
        DD(BU,64), (16)0002C1A040000000
        DD(BU,64), (16)3826233410101010   ! HOLD
        DD(BU,64), (16)001060A040000000
        DD(BU,64), (16)3834101010101010   ! HD
        DD(BU,64), (16)000380A040000000
        DD(BU,64), (16)3834121010101010   ! HDS
        DD(BU,64), (16)000381A040000000
        DD(BU,64), (16)3913101010101010   ! IT
        DD(BU,64), (16)000040A040000000
        DD(BU,64), (16)3921101010101010   ! IJ
        DD(BU,64), (16)0002C2A0C0000000
        DD(BU,64), (16)3922101010101010   ! IK
        DD(BU,64), (16)0002C1A0C0000000
        DD(BU,64), (16)3925341010101010   ! IND
        DD(BU,64), (16)0002C0A040000000
        DD(BU,64), (16)3926343536101010   ! IODEF
        DD(BU,64), (16)000340A040000000
        DD(BU,64), (16)3929101010101010   ! IR
        DD(BU,64), (16)0002D9A0C0000000
        DD(BU,64), (16)3931101010101010   ! IA
        DD(BU,64), (16)000080A040000000
        DD(BU,64), (16)3936101010101010   ! IF
