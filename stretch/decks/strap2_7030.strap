! strap2_7030.strap -- RECONSTRUCTION of STRAP II as a 7030 program.
!
! >>> A RECONSTRUCTION.  IBM's STRAP II was a 7030 program; one page of its
! >>> code survives (CHM 102633945, decks/strap2_chm102633945.strap).  This
! >>> code is written here to C22-6729 (the STRAP II Systems Analysis Guide),
! >>> read in the ink.  docs/strap2_7030.md records every convention with
! >>> its page, or marks it CHOSEN.  The reference for its behaviour is the
! >>> host-side STRAP II, strap/strap2/. <<<
!
! STEP 1 (docs/strap2_7030.md "The order of work"): XINPUT and GETCHA.
! STEP 2 begun: GETFLD (see below).
! MAIN is not written yet.  The test's driver (tests/strap2_7030_drive.strap,
! NOT part of this reconstruction) is assembled after this deck and stands in
! for MAIN: it calls GETCHA to the end of the input and records what GETCHA
! gives.  tests/check_strap2_7030.py runs it on the model against strap2.
!
! LAYOUT: C22-6729 p.174 and Fig. 30 p.209.  SCSTRAP1 is sections 0, A0, A1
! and 1 in that order; SCSTRAP2 (A2, 2) will overlay A1 and 1; A3 holds the
! buffers.  Each section below starts with its banner.
!
! REGISTERS (p.175, both passes).  Only $7, $8 and $9 are free.  In Pass 1
! $3 is the A8 character from GETCHA, $13 belongs to INTOUT (XINPUT here, the
! input routine, CHOSEN) and $14 to GETCHA.  $15 is general linkage; GETCHA's
! own is SIC,GETCHZ (p.79).  CHOSEN: the routines without a LINKAGE paragraph
! read so far (XINPUT, GCOPN, GCNAME, GCPUT) link through memory cells,
! "SIC,cell", read back with LV,$8,cell; B,0($8), as GETCHA's does.  A
! routine the CHM page calls through $15 will take $15.
!
! CHARACTERS.  The input is IQS, COMREC code 5 (p.8); XINPUT converts each
! card to A8, STRAP II's internal code (p.175: "A8 character from GETCHA";
! strap/strap2/a8.py: the 48 set of RefMan printed p.166 in eight bits, and
! the internal false semicolon 0o35).  A8 used below: blank 0o20, quote
! (the comment character, p.79) 0o14, asterisk 0o54, semicolon 0o35.  In a
! VFL immediate an integer is the value: KI(BU,8),(8)54.  An index immediate
! (LVI) is a half-word address, so a character reaches $3 by GCPUT and an
! address with a bit part by LV from an XW.
!
! THE FAILURES.  Each halts at HALTE with a code in ERRC:
!    1 COMREC word 8's code is not 5, IQS (only IQS input is written)
!    2 a name longer than 64 characters (CHOSEN size of NAMEB; strap2 has no
!      limit)
!    9 a form GETFLD does not write yet (a tail, step 4's TAILOR)
!   10 GETFLD's work areas full: parentheses deeper than 7, more than 8
!      items in one, an item over its 2048-bit slot (CHOSEN sizes)
!   11 the coded expression past Bcfxtx (Box 55 GFLONG "CHECK FOR ROOM IN
!      BUFFER", p.81; what GFLONG does then is not written up: CHOSEN, a halt)
!   12 TABMAN: TEC 1 (a compare the guide does not describe), or an argument
!      longer than AL whose rest is not whole characters (Fig. 22's 8n)
!      or a vle for a table whose ADDL cannot hold its address (p.44: 25 bits)
!  100+n STRAP II message n, until the error routine is written (p.176-178):
!      149 a symbol over 128 characters, 156 a system symbol not found
!      (MBSPEC's 129 and CPLTNM's 63, a digit too large for the radix, are
!      notes: NOTEC, NOTEL; p.71: the digit is still used), 166 SYNTAX
!      ERROR, 167 INAPPROPRIATE CHARACTER, 168 a number over 24 bits
!
! STEP 2, sub-slice a (docs/strap2_7030.md): GETFLD (Charts BI-BK
! pp.80-82) over numbers (CPLTNM, Chart BD p.70, in floating point as Box 1
! says), programmer symbols without tails (CPLTSY, Chart BE p.72), and the
! operators + - * / . and unary minus.  REGISTERS: GETFLD's coded
! expression pointer is $2 (p.84 Box 1, p.85 Boxes 34-38: "$2 is spaced");
! p.175 gives $2 to RNX, so GETFLD saves it on entry and restores it on
! exit, as p.175 asks of any register other than $7, $8 and $9.
!
        SLC, (8)2000.0
!
! ======== SECTION 0: subroutines common to Pass 1 and Pass 2 (p.174) ===
ERROR   ST(BU,24), ERRC
HALTE   BEW, $
!
! TABMAN (pp.40-53, Chart RA p.43): SEARCH, ADDORD, ADDUNO.  Entered with
! LVI,15,$+1.0; B,<routine> and the calling sequence after the B (p.47-49):
!   SEARCH: ,tbl ,arg(I) ,al(I); B,not found; normal (found)
!   ADDORD: ,tbl ,arg(I) ,al(I) ,funct(I) ,fl(I); B,already there; B,error;
!           normal
!   ADDUNO: ,tbl ,arg(I) ,al(I) ,funct(I) ,fl(I); normal
! Each parameter is read with LVE, its effective address: arg and funct are
! locations, al and fl lengths in bits (an index register's value, as
! 0($n)).  CHOSEN: I is none of $5-$6, which TABMAN loads while reading.
! The exits follow strap2/tabman.py (Gap 11: ADDORD's normal at 3.32).
! CHOSEN: the search is linear for every table; Box 7's binary search for
! an ordered table of seven or more gives the same answer (the first entry
! not below the argument) in fewer steps, and is not written yet.
! CHOSEN: TABMAN moves bits with its own TBMOV, not MOVE's linkage, which
! would take $15.
SEARCH  SX, $7, TBSAV+7.0
        LI(BU,8), 0
        B, TBHK
ADDORD  SX, $7, TBSAV+7.0
        LI(BU,8), 1
        B, TBHK
ADDUNO  SX, $7, TBSAV+7.0
        LI(BU,8), 2
        B, TBHK
RSERCH  SX, $7, TBSAV+7.0
        LI(BU,8), 3
! Boxes 1-3: $0-$7 saved, Azzc and Azzb zero, the control block to $5
TBHK    ST(BU,8), TBRTN
        SX, $0, TBSAV
        SX, $1, TBSAV+1.0
        SX, $2, TBSAV+2.0
        SX, $3, TBSAV+3.0
        SX, $4, TBSAV+4.0
        SX, $5, TBSAV+5.0
        SX, $6, TBSAV+6.0
        LI(BU,1), 0
        ST(BU,1), AZZC
        ST(BU,1), AZZB
        LVE, $5, 0($15)
        LVE, $6, .32($15)
        SV, $6, TBARG
        L(BU,8), TBRTN
        KI(BU,8), 3
        BAE, TBRS
        LVE, $6, 1.0($15)
        SV, $6, TBAL
        L(BU,24), TBAL
        K(BU,16), 3.16($5)
        BAH, TBHK1
        ST(BU,24), TBDL
        K(BU,16), 3.16($5)
        BZAE, TBHK3
        LI(BU,1), 1
        ST(BU,1), TBRC
        B, TBHK4
TBHK3   LI(BU,1), 0
        ST(BU,1), TBRC
TBHK4   LI(BU,24), 0
        ST(BU,24), TBR
        B, TBHK2
! p.44's third form: al over AL.  The dictionary takes the first AL bits,
! the vle the rest (TBR bits, whole characters: Fig. 22's 8n).
TBHK1   LI(BU,1), 1
        ST(BU,1), TBRC
        L(BU,16), 3.16($5)
        ST(BU,24), TBDL
        L(BU,24), TBAL
        -(BU,16), 3.16($5)
        ST(BU,24), TBR
        L(BU,3), TBR+.21
        KI(BU,3), 0
        BAE, TBHK2
        B, TBTEC
TBHK2   L(BU,8), TBRTN
        KI(BU,8), 0
        BAE, TBS
        LVE, $6, 1.32($15)
        SV, $6, TBFN
        LVE, $6, 2.0($15)
        SV, $6, TBFL
        L(BU,8), TBRTN
        KI(BU,8), 1
        BAE, TBAO
! ADDUNO (p.49): Box 10's +3.0, the exit one half word back: normal 2.32
        SIC, TBULK
        B, TBUNO
        V+I, $15, 2.32
        B, TBX
! ADDORD (p.48): an unordered table, ADDUNO and the error exit (3.0)
TBAO    LI(BU,1), 1
        ST(BU,1), AZZC
        L(BU,1), 2.57($5)
        KI(BU,1), 1
        BZAE, TBAO1
        SIC, TBULK
        B, TBUNO
        V+I, $15, 3.0
        B, TBX
TBAO1   SIC, TBSLK
        B, TBSRCH
        L(BU,1), TBHIT
        KI(BU,1), 1
        BZAE, TBAO2
! found: Boxes 14, 32-33, already there (2.32)
        V+I, $15, 2.32
        B, TBX
! not found: the table moved up one entry at the index words' place, the
! entry put there (Boxes 9, 27-31); normal (3.32, Gap 11)
TBAO2   L(BU,24), TBP
        ST(BU,24), TBMF
        +(BU,16), 3.0($5)
        ST(BU,24), TBMT
        L(BU,24), 2.32($5)
        +(BU,16), 3.0($5)
        ST(BU,24), TBQ
        -(BU,24), TBP
        ST(BU,24), TBMN
        SIC, TBMLK
        B, TBMOV
        L(BU,24), TBQ
        ST(BU,24), 2.32($5)
        SIC, TBELK
        B, TBENT
        V+I, $15, 3.32
        B, TBX
! RSERCH (pp.52-53, Chart RW): the entry whose function address is the
! given one.  CHOSEN linkage (none is printed): ,tbl ,addr(I); not found
! (1.0, Box 6's +1.32); normal, found (1.32, Box 10's +2.0).  The address is
! the effective address.  OPEN: the move to "the location specified in the
! value field of the index register" (Boxes 9, 11-12) is not written; with
! the address itself through I, the two readings collide.
TBRS    LI(BU,1), 1
        ST(BU,1), AZZS
        L(BU,24), 2.0($5)
        ST(BU,24), TBP
TBRS1   L(BU,24), TBP
        K(BU,24), 2.32($5)
        BAH, TBRS3
        SIC, TBFLK
        B, TBFAD
        K(BU,24), TBARG
        BAE, TBRS2
        L(BU,24), TBP
        +(BU,16), 3.0($5)
        ST(BU,24), TBP
        B, TBRS1
TBRS2   L(BU,24), TBP
        ST(BU,24), 1.0($5)
        L(BU,24), TBARG
        ST(BU,24), 0.0($5)
        V+I, $15, 1.32
        B, TBX
TBRS3   V+I, $15, 1.0
        B, TBX
! SEARCH (p.47): found 2.0, not found 1.32
TBS     SIC, TBSLK
        B, TBSRCH
        L(BU,1), TBHIT
        KI(BU,1), 1
        BZAE, TBS1
        V+I, $15, 2.0
        B, TBX
TBS1    V+I, $15, 1.32
! Box 31: $0-$7 restored, the exit
TBX     LX, $0, TBSAV
        LX, $1, TBSAV+1.0
        LX, $2, TBSAV+2.0
        LX, $3, TBSAV+3.0
        LX, $4, TBSAV+4.0
        LX, $5, TBSAV+5.0
        LX, $6, TBSAV+6.0
        LX, $7, TBSAV+7.0
        B, 0($15)
!
! ANEXT (pp.50-51, Chart RB): the next undeleted vle with the ID in bits
! 18-23 of the calling sequence's first half word, from the vle table's
! bottom while Afirst is on (the test turns it off), else from Anexta.
!   LVI,15,$+1.0; B,ANEXT; ID; no more (two half words); normal
! Box 1: only $2 is saved.  Found: its location in Anextx, the next in
! Anexta (Boxes 8-9).
ANEXT   SX, $2, ANSAV
        L(BU,6), .18($15)
        ST(BU,6), ANID
        L(BU,1), AFIRST
        KI(BU,1), 1
        BZAE, AN4
        LI(BU,1), 0
        ST(BU,1), AFIRST
        L(BU,24), AUVTAB+.32
        ST(BU,24), ANT
        LV, $2, ANT
        B, AN5
AN4     LV, $2, ANEXTA
AN5     SV, $2, ANT
        L(BU,24), ANT
        K(BU,24), AUVTAB
        BZAL, AN7
        L(BU,6), .14($2)
        K(BU,6), ANID
        BZAE, AN6
        L(BU,1), 0($2)
        KI(BU,1), 1
        BAE, AN6
        SV, $2, ANEXTX
        L(BU,13), .1($2)
        +(BU,24), ANT
        ST(BU,24), ANEXTA
        LX, $2, ANSAV
        B, 1.32($15)
AN6     L(BU,13), .1($2)
        +(BU,24), ANT
        ST(BU,24), ANT
        LV, $2, ANT
        B, AN5
AN7     LX, $2, ANSAV
        B, .32($15)
!
! TBSRCH (Boxes 4, 7, 11): TBHIT 1 and the index words at the entry, or
! TBHIT 0 and the index words at the first entry not below the argument
! (ordered) or after the table (unordered, or none).  TBP the place.
! Box 4 Acompi: the compares' field length set to the argument's.
TBSRCH  L(BU,1), 2.62($5)
        KI(BU,1), 1
        BAE, TBTEC
        L(BU,24), TBDL
        ST(BU,6), TBCL1+.35
        ST(BU,6), TBCK1+.35
        ST(BU,6), TBCL2+.35
        ST(BU,6), TBCK2+.35
        LV, $6, TBARG
        L(BU,24), 2.0($5)
        ST(BU,24), TBP
        L(BU,1), 2.57($5)
        KI(BU,1), 1
        BAE, TBSU
! ordered: stop at the first entry not below the argument
TBSO    L(BU,24), TBP
        K(BU,24), 2.32($5)
        BAH, TBSAF
        LV, $4, TBP
TBCL1   L(BU,64), .2($4)
TBCK1   K(BU,64), 0($6)
        BAE, TBSOE
        BAH, TBSAT
TBSON   L(BU,24), TBP
        +(BU,16), 3.0($5)
        ST(BU,24), TBP
        B, TBSO
! the dictionary parts equal: the rests decide (al not under AL)
TBSOE   L(BU,1), TBRC
        KI(BU,1), 1
        BZAE, TBSEQ
        SIC, TBRLK
        B, TBRCMP
        L(BU,2), TBRV
        KI(BU,2), 0
        BAE, TBSEQ
        KI(BU,2), 1
        BAE, TBSAT
        B, TBSON
! unordered: stop at the first equal argument
TBSU    L(BU,24), TBP
        K(BU,24), 2.32($5)
        BAH, TBSAF
        LV, $4, TBP
TBCL2   L(BU,64), .2($4)
TBCK2   K(BU,64), 0($6)
        BAE, TBSUE
TBSUN   L(BU,24), TBP
        +(BU,16), 3.0($5)
        ST(BU,24), TBP
        B, TBSU
TBSUE   L(BU,1), TBRC
        KI(BU,1), 1
        BZAE, TBSEQ
        SIC, TBRLK
        B, TBRCMP
        L(BU,2), TBRV
        KI(BU,2), 0
        BAE, TBSEQ
        B, TBSUN
! Box 11: a deleted entry is a miss (ordered: the index words stay there)
TBSEQ   L(BU,1), 0($4)
        KI(BU,1), 1
        BZAE, TBSFD
        L(BU,1), 2.57($5)
        KI(BU,1), 1
        BAE, TBSAF
        B, TBSAT
! Boxes 14, 18-26: found; DX the entry, FX its function
TBSFD   LI(BU,1), 1
        ST(BU,1), TBHIT
        L(BU,24), TBP
        ST(BU,24), 1.0($5)
        SIC, TBFLK
        B, TBFAD
        ST(BU,24), 0.0($5)
        B, TBSRX
TBSAF   L(BU,24), 2.32($5)
        +(BU,16), 3.0($5)
        ST(BU,24), TBP
TBSAT   LI(BU,1), 0
        ST(BU,1), TBHIT
        L(BU,24), TBP
        ST(BU,24), 1.0($5)
        ST(BU,24), 0.0($5)
TBSRX   LV, $3, TBSLK
        B, 0($3)
TBTEC   LI(BU,24), 12
        B, ERROR
!
! TBRCMP: the rest of the entry at TBP (in its vle, Fig. 22's 8n bits; none
! without a vle) against the given rest (TBR bits after TBARG + TBDL), as
! bit strings, a shorter one before a longer it begins.  TBRV: 0 equal, 1
! the entry's higher, 2 lower.  CHOSEN (tabman.py): C28-6129 p.37's unique
! tails.  $4 and $6 are kept.
TBRCMP  LI(BU,24), 0
        ST(BU,24), TBEN
        L(BU,1), .1($4)
        KI(BU,1), 1
        BZAE, TBRC1
        L(BU,24), TBP
        +(BU,16), 3.16($5)
        +(BU,24), TBTWO
        ST(BU,24), TBRQ
        L(BU,16), 3.32($5)
        ST(BU,6), TBRC2+.35
        LV, $7, TBRQ
TBRC2   L(BU,64), 0($7)
        ST(BU,24), TBRQ
        +(BU,24), TBV32
        ST(BU,24), TBEA
        LV, $7, TBRQ
        L(BU,12), .20($7)
        ST(BU,24), TBEN
        +(BU,24), TBEN
        ST(BU,24), TBEN
        +(BU,24), TBEN
        ST(BU,24), TBEN
        +(BU,24), TBEN
        ST(BU,24), TBEN
TBRC1   L(BU,24), TBARG
        +(BU,24), TBDL
        ST(BU,24), TBGA
        L(BU,24), TBR
        ST(BU,24), TBGN
TBRC3   L(BU,24), TBEN
        K(BU,24), TBGN
        BZAH, TBRC4
        L(BU,24), TBGN
TBRC4   KI(BU,24), 64
        BZAH, TBRC5
        LI(BU,24), 64
TBRC5   ST(BU,24), TBRK
        KI(BU,24), 0
        BZAE, TBRC6
        L(BU,24), TBEN
        K(BU,24), TBGN
        BAE, TBRCE
        BAH, TBRCH
        B, TBRCL
TBRC6   ST(BU,6), TBRL+.35
        ST(BU,6), TBRK2+.35
        LV, $7, TBEA
        LV, $2, TBGA
TBRL    L(BU,64), 0($7)
TBRK2   K(BU,64), 0($2)
        BAH, TBRCH
        BZAE, TBRCL
        L(BU,24), TBEA
        +(BU,24), TBRK
        ST(BU,24), TBEA
        L(BU,24), TBGA
        +(BU,24), TBRK
        ST(BU,24), TBGA
        L(BU,24), TBEN
        -(BU,24), TBRK
        ST(BU,24), TBEN
        L(BU,24), TBGN
        -(BU,24), TBRK
        ST(BU,24), TBGN
        B, TBRC3
TBRCE   LI(BU,2), 0
        B, TBRCX
TBRCH   LI(BU,2), 1
        B, TBRCX
TBRCL   LI(BU,2), 2
TBRCX   ST(BU,2), TBRV
        LV, $3, TBRLK
        B, 0($3)
!
! TBFAD: the function address of the entry at TBP into the accumulator.
! A vle (bit 1): Agetv, its signed address in the function field, + 32.
TBFAD   L(BU,24), TBP
        +(BU,16), 3.16($5)
        +(BU,24), TBTWO
        ST(BU,24), TBQ
        LV, $4, TBP
        L(BU,1), .1($4)
        KI(BU,1), 1
        BAE, TBFA1
        L(BU,24), TBQ
        B, TBFA2
TBFA1   L(BU,16), 3.32($5)
        ST(BU,6), TBFA3+.35
        LV, $4, TBQ
TBFA3   L(BU,64), 0($4)
        ST(BU,24), TBVA
        LV, $4, TBVA
        L(BU,12), .20($4)
        ST(BU,24), TBN8
        +(BU,24), TBN8
        ST(BU,24), TBN8
        +(BU,24), TBN8
        ST(BU,24), TBN8
        +(BU,24), TBN8
        +(BU,24), TBVA
        +(BU,24), TBV32
TBFA2   LV, $3, TBFLK
        B, 0($3)
!
! TBUNO, ADDUNO's body (Boxes 13, 19, 22, 24, 27-31): the last entry, if
! deleted, is replaced; else the entry goes after it and LW moves on.
TBUNO   L(BU,24), 2.32($5)
        ST(BU,24), TBP
        K(BU,24), 2.0($5)
        BAL, TBUN1
        LV, $4, TBP
        L(BU,1), 0($4)
        KI(BU,1), 1
        BAE, TBUN2
TBUN1   L(BU,24), TBP
        +(BU,16), 3.0($5)
        ST(BU,24), TBP
        ST(BU,24), 2.32($5)
TBUN2   SIC, TBELK
        B, TBENT
        LI(BU,1), 1
        ST(BU,1), 2.57($5)
        LV, $3, TBULK
        B, 0($3)
!
! TBENT (Box 30 AENTER): the entry at TBP, zeroed; the argument, al bits;
! the function, or (fl over ADDL, p.44) a vle at Auvtab with Fig. 22's head
! and the vle's address in the function field; N one more; DX, FX.
TBENT   L(BU,16), 3.0($5)
        ST(BU,24), TBK
        LV, $4, TBP
TBEN1   LI(BU,32), 0
        ST(BU,32), 0($4)
        V+I, $4, .32
        L(BU,24), TBK
        -(BU,24), TBV32
        ST(BU,24), TBK
        KI(BU,24), 0
        BZAE, TBEN1
        L(BU,24), TBARG
        ST(BU,24), TBMF
        L(BU,24), TBP
        +(BU,24), TBTWO
        ST(BU,24), TBMT
        +(BU,16), 3.16($5)
        ST(BU,24), TBQ
        L(BU,24), TBDL
        ST(BU,24), TBMN
        SIC, TBMLK
        B, TBMOV
        L(BU,24), TBFN
        ST(BU,24), TBMF
        L(BU,24), TBFL
        ST(BU,24), TBMN
        K(BU,16), 3.32($5)
        BAH, TBEN2
        L(BU,24), TBR
        KI(BU,24), 0
        BAH, TBEN2
        L(BU,24), TBQ
        ST(BU,24), TBMT
        SIC, TBMLK
        B, TBMOV
        B, TBEN3
TBEN2   L(BU,16), 3.32($5)
        KI(BU,16), 25
        BAL, TBTEC
        LV, $4, AUVTAB
        LI(BU,32), 0
        ST(BU,32), 0($4)
        L(BU,24), TBFL
        +(BU,24), TBV32
        +(BU,24), TBR
        ST(BU,13), .1($4)
        L(BU,6), 2.25($5)
        ST(BU,6), .14($4)
        L(BU,21), TBR
        ST(BU,12), .20($4)
        SV, $4, TBK
        L(BU,24), TBARG
        +(BU,24), TBDL
        ST(BU,24), TBMF
        L(BU,24), TBK
        +(BU,24), TBV32
        ST(BU,24), TBMT
        L(BU,24), TBR
        ST(BU,24), TBMN
        SIC, TBMLK
        B, TBMOV
        L(BU,24), TBFN
        ST(BU,24), TBMF
        L(BU,24), TBFL
        ST(BU,24), TBMN
        L(BU,24), TBK
        +(BU,24), TBV32
        +(BU,24), TBR
        ST(BU,24), TBMT
        SIC, TBMLK
        B, TBMOV
        L(BU,24), TBK
        +(BU,24), TBV32
        +(BU,24), TBR
        +(BU,24), TBFL
        ST(BU,24), AUVTAB
        L(BU,16), 3.32($5)
        ST(BU,6), TBEN4+.35
        LV, $4, TBQ
        L(BU,24), TBK
TBEN4   ST(BU,64), 0($4)
        LV, $4, TBP
        LI(BU,1), 1
        ST(BU,1), .1($4)
TBEN3   M+1(BU,16), 3.48($5)
        L(BU,24), TBP
        ST(BU,24), 1.0($5)
        SIC, TBFLK
        B, TBFAD
        ST(BU,24), 0.0($5)
        LV, $3, TBELK
        B, 0($3)
!
! TBMOV: TBMN bits from TBMF to TBMT, at most 64 a step, backward when the
! destination is higher (p.41: "forward ... or backward"), so an overlap
! is safe.  The steps' field lengths are set in TBML, TBMS.
TBMOV   L(BU,24), TBMN
        KI(BU,24), 0
        BAE, TBMVX
        ST(BU,24), TBMK
        L(BU,24), TBMT
        K(BU,24), TBMF
        BAE, TBMVX
        BAH, TBMB
! forward
TBMF1   L(BU,24), TBMK
        KI(BU,24), 64
        BZAH, TBMF2
        LI(BU,24), 64
TBMF2   ST(BU,24), TBMC
        ST(BU,6), TBML+.35
        ST(BU,6), TBMS+.35
        LV, $6, TBMF
        LV, $7, TBMT
TBML    L(BU,64), 0($6)
TBMS    ST(BU,64), 0($7)
        L(BU,24), TBMF
        +(BU,24), TBMC
        ST(BU,24), TBMF
        L(BU,24), TBMT
        +(BU,24), TBMC
        ST(BU,24), TBMT
        L(BU,24), TBMK
        -(BU,24), TBMC
        ST(BU,24), TBMK
        KI(BU,24), 0
        BZAE, TBMF1
        B, TBMVX
! backward: from the end
TBMB    L(BU,24), TBMF
        +(BU,24), TBMK
        ST(BU,24), TBMF
        L(BU,24), TBMT
        +(BU,24), TBMK
        ST(BU,24), TBMT
TBMB1   L(BU,24), TBMK
        KI(BU,24), 64
        BZAH, TBMB2
        LI(BU,24), 64
TBMB2   ST(BU,24), TBMC
        ST(BU,6), TBMBL+.35
        ST(BU,6), TBMBS+.35
        L(BU,24), TBMF
        -(BU,24), TBMC
        ST(BU,24), TBMF
        L(BU,24), TBMT
        -(BU,24), TBMC
        ST(BU,24), TBMT
        LV, $6, TBMF
        LV, $7, TBMT
TBMBL   L(BU,64), 0($6)
TBMBS   ST(BU,64), 0($7)
        L(BU,24), TBMK
        -(BU,24), TBMC
        ST(BU,24), TBMK
        KI(BU,24), 0
        BZAE, TBMB1
TBMVX   LV, $3, TBMLK
        B, 0($3)
!
! ======== SECTION A0: common constants and work areas, the I-O work
! ======== areas, the messages (p.174) ==================================
        CNOP
ERRC    DD(BU,64), 0
! NOTEC, NOTEL: messages that are notes (not halts), counted, the last
! one's number kept, until the error routine is written (CHOSEN)
NOTEC   DD(BU,64), 0
NOTEL   DD(BU,64), 0
XINLK   DD(BU,64), 0
XTMP    DD(BU,64), 0
HAVEN   DD(BU,64), 0
GCNEXT  DRZ(BU,64), 10
