        DD(BU,64), (16)3233101010101010   ! BC
        DD(BU,64), (16)0000F9A040000000
        DD(BU,64), (16)3312101010101010   ! CS
        DD(BU,64), (16)0002CDA0C0000000
        DD(BU,64), (16)3326242410101010   ! COMM
        DD(BU,64), (16)0008E0A040000000
        DD(BU,64), (16)3327141010101010   ! CPU
        DD(BU,64), (16)0002C5A0C0000000
        DD(BU,64), (16)3327141210101010   ! CPUS
        DD(BU,64), (16)0002C5A0C0000000
        DD(BU,64), (16)3331101010101010   ! CA
        DD(BU,64), (16)00014CA040000000
