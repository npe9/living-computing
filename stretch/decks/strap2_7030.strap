! strap2_7030.strap -- RECONSTRUCTION of STRAP II as a 7030 program.
!
! >>> A RECONSTRUCTION.  IBM's STRAP II was a 7030 program; one page of its
! >>> code survives (CHM 102633945, decks/strap2_chm102633945.strap).  This
! >>> code is written here to C22-6729 (the STRAP II Systems Analysis Guide),
! >>> read in the ink.  docs/strap2_7030.md records every convention with
! >>> its page, or marks it CHOSEN.  The reference for its behaviour is the
! >>> host-side STRAP II, strap/strap2/. <<<
!
! STEP 1 (docs/strap2_7030.md "The order of work"): XINPUT and GETCHA.
! STEP 2 begun: GETFLD (see below).
! MAIN is not written yet.  The test's driver (tests/strap2_7030_drive.strap,
! NOT part of this reconstruction) is assembled after this deck and stands in
! for MAIN: it calls GETCHA to the end of the input and records what GETCHA
! gives.  tests/check_strap2_7030.py runs it on the model against strap2.
!
! LAYOUT: C22-6729 p.174 and Fig. 30 p.209.  SCSTRAP1 is sections 0, A0, A1
! and 1 in that order; SCSTRAP2 (A2, 2) will overlay A1 and 1; A3 holds the
! buffers.  Each section below starts with its banner.
!
! REGISTERS (p.175, both passes).  Only $7, $8 and $9 are free.  In Pass 1
! $3 is the A8 character from GETCHA, $13 belongs to INTOUT (XINPUT here, the
! input routine, CHOSEN) and $14 to GETCHA.  $15 is general linkage; GETCHA's
! own is SIC,GETCHZ (p.79).  CHOSEN: the routines without a LINKAGE paragraph
! read so far (XINPUT, GCOPN, GCNAME, GCPUT) link through memory cells,
! "SIC,cell", read back with LV,$8,cell; B,0($8), as GETCHA's does.  A
! routine the CHM page calls through $15 will take $15.
!
! CHARACTERS.  The input is IQS, COMREC code 5 (p.8); XINPUT converts each
! card to A8, STRAP II's internal code (p.175: "A8 character from GETCHA";
! strap/strap2/a8.py: the 48 set of RefMan printed p.166 in eight bits, and
! the internal false semicolon 0o35).  A8 used below: blank 0o20, quote
! (the comment character, p.79) 0o14, asterisk 0o54, semicolon 0o35.  In a
! VFL immediate an integer is the value: KI(BU,8),(8)54.  An index immediate
! (LVI) is a half-word address, so a character reaches $3 by GCPUT and an
! address with a bit part by LV from an XW.
!
! THE FAILURES.  Each halts at HALTE with a code in ERRC:
!    1 COMREC word 8's code is not 5, IQS (only IQS input is written)
!    2 a name longer than 64 characters (CHOSEN size of NAMEB; strap2 has no
!      limit)
!    9 a form GETFLD does not write yet (step 2's sub-slices c-d: a $ or
!      system symbol, a tail, a g.p., a radix)
!   10 GETFLD's work areas full: parentheses deeper than 7, more than 8
!      items in one, an item over its 2048-bit slot (CHOSEN sizes)
!  100+n STRAP II message n, until the error routine is written (p.176-178):
!      149 a symbol over 128 characters, 163 a digit too large for the
!      radix (p.71: the digit is still used; here it halts), 166 SYNTAX
!      ERROR, 167 INAPPROPRIATE CHARACTER, 168 a number over 24 bits
!
! STEP 2, sub-slice a (docs/strap2_7030.md): GETFLD (Charts BI-BK
! pp.80-82) over numbers (CPLTNM, Chart BD p.70, in floating point as Box 1
! says), programmer symbols without tails (CPLTSY, Chart BE p.72), and the
! operators + - * / . and unary minus.  REGISTERS: GETFLD's coded
! expression pointer is $2 (p.84 Box 1, p.85 Boxes 34-38: "$2 is spaced");
! p.175 gives $2 to RNX, so GETFLD saves it on entry and restores it on
! exit, as p.175 asks of any register other than $7, $8 and $9.
!
        SLC, (8)2000.0
!
! ======== SECTION 0: subroutines common to Pass 1 and Pass 2 (p.174) ===
ERROR   ST(BU,24), ERRC
HALTE   BEW, $
!
! ======== SECTION A0: common constants and work areas, the I-O work
! ======== areas, the messages (p.174) ==================================
        CNOP
ERRC    DD(BU,64), 0
XINLK   DD(BU,64), 0
XTMP    DD(BU,64), 0
HAVEN   DD(BU,64), 0
GCNEXT  DRZ(BU,64), 10
! IQSA8: IQS code (strap/charsets.py IQS) to A8 (strap/strap2/a8.py), one
! byte per IQS code; a code with no A8 character is 0, as a8() gives.
! Generated from those two tables, 2026-11-12.
IQSA8   SYN, $
        DD(BU,64), (16)1000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)00302B0B2C1C113C
        DD(BU,64), (16)1B1D0C0031313232
        DD(BU,64), (16)3333343435353636
        DD(BU,64), (16)3737383839392121
        DD(BU,64), (16)2222232324242525
        DD(BU,64), (16)2626272728282929
        DD(BU,64), (16)1212131314141515
        DD(BU,64), (16)1616171718181919
        DD(BU,64), (16)0A00010002000300
        DD(BU,64), (16)0400050006000700
        DD(BU,64), (16)080009003B1A2000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
! CHVAL: an A8 character's value as a digit (0-9, A-Z 10-35), one byte per
! A8 code; 63 is not alphameric.  CPLTNM's Box 3 and GETFLD's Boxes 7-8.
! Generated from strap2/a8.py, 2026-11-13.
CHVAL   SYN, $
        DD(BU,64), (16)3F01020304050607
        DD(BU,64), (16)0809003F3F3F3F3F
        DD(BU,64), (16)3F3F1C1D1E1F2021
        DD(BU,64), (16)22233F3F3F3F3F3F
        DD(BU,64), (16)3F13141516171819
        DD(BU,64), (16)1A1B3F3F3F3F3F3F
        DD(BU,64), (16)3F0A0B0C0D0E0F10
        DD(BU,64), (16)11123F3F3F3F3F3F
!
! ======== SECTION A1: Pass 1's constants and work areas (p.174) =======
GCEND   SYN, GCCARD+9.0
! LVI loads a half-word address (the bits below .32 are dropped;
! card_reader.strap), so an address with a bit part is loaded with LV from
! an index word:
KNAME   XW, GCCARD+.8, 0, 0
KSTMT   XW, GCCARD+1.8, 0, 0
GETCHZ  DD(BU,64), 0
GCOLK   DD(BU,64), 0
GCNLK   DD(BU,64), 0
GCPLK   DD(BU,64), 0
GCTMP   DD(BU,64), 0
NTMP    DD(BU,64), 0
FEND    DD(BU,64), 0
FEOF    DD(BU,64), 0
GCOPEN  DD(BU,64), 0
GCCOM   DD(BU,64), 0
GCCMC   DD(BU,64), 0
GCQ     DD(BU,64), 0
GCNC    DD(BU,64), 0
NAMEND  DD(BU,64), 0
NAMEL   DD(BU,64), 0
NAMET   DD(BU,64), 0
NAMEB   DRZ(BU,64), 8
GCCARD  DRZ(BU,64), 10
! GETFLD (p.83 LINKAGE): BCFLDX's value is the coded expression's first
! bit, a full word, and on exit its next bit; BCFXTX the first bit after the
! buffer (not tested yet); GFCHAR bit 0 on if $3 already holds the field's
! first character.  GFSRAD, the radix (p.70), zero means 10.
BCFLDX  XW, 0, 0, 0
BCFXTX  XW, 0, 0, 0
GFCHAR  DD(BU,64), 0
GFSRAD  DD(BU,64), 0
GETFLZ  DD(BU,64), 0
CPLTNZ  DD(BU,64), 0
CPLTSZ  DD(BU,64), 0
GFPLK   DD(BU,64), 0
GFELK   DD(BU,64), 0
GFSAV2  DD(BU,64), 0
GFC     DD(BU,64), 0
GFP0    DD(BU,64), 0
GFSN    DD(BU,64), 0
GFOPN   DD(BU,64), 0
GFNEW   DD(BU,64), 0
GFOP    DD(BU,64), 0
GFOPP   XW, GFOPS, 0, 0
CHXT    DD(BU,64), 0
STX     DD(BU,64), 0
STXD    DD(BU,64), 0
STXK    DD(BU,64), 0
STXF    DD(BU,64), 0
GFIDP   DD(BU,64), 0
GFDEP   DD(BU,64), 0
GFCK    DD(BU,64), 0
GFCN    DD(BU,64), 0
GFCI    DD(BU,64), 0
GFPARN  DD(BU,64), 0
GFCS    DD(BU,64), 0
GFCE    DD(BU,64), 0
GFCL    DD(BU,64), 0
GFCR    DD(BU,64), 0
GFT     DD(BU,64), 0
GFZLK   DD(BU,64), 0
GFCLK   DD(BU,64), 0
GFILK   DD(BU,64), 0
GFSLK   DD(BU,64), 0
! An expression's context, 16 words, saved in GFFRM at each '(' and
! restored at its ')' (CHOSEN layout; the chart's Box 2 "pushes the buffer
! one word"): data count, operator floor, unary and point flags, the first
! datum, the end bit held open (GFLAZ), the last datum absolute (GFLKA) and
! with S/X (GFSUB); the parenthesis' kind (0 a datum's start, 1 after a
! datum, 2 after a point) and items; $2; the slot; the item's start, its
! operators' start (pointer, count).
GFCTX   SYN, $
GFN     DD(BU,64), 0
GFFLR   DD(BU,64), 0
GFUN    DD(BU,64), 0
GFPT    DD(BU,64), 0
GFDOTL  DD(BU,64), 0
GFFRST  DD(BU,64), 0
GFLAZ   DD(BU,64), 0
GFLKA   DD(BU,64), 0
GFSUB   DD(BU,64), 0
GFKND   DD(BU,64), 0
GFNIT   DD(BU,64), 0
GFR2    DD(BU,64), 0
GFSLS   DD(BU,64), 0
GFIDS   DD(BU,64), 0
GFIOB   DD(BU,64), 0
GFIOBN  DD(BU,64), 0
GFCTXX  XW, GFCTX, 0, 0
GFFRMX  XW, GFFRM, 0, 0
GFITMX  XW, GFITM, 0, 0
GFSCRX  XW, GFSCR-32.0, 0, 0
! the operator stack, 16 bits an entry (precedence at .5, code at .8,
! datum number at .11), and the operators put, 9 bits each (p.198 3A-3C)
GFSTK   DRZ(BU,64), 8
GFOPS   DRZ(BU,64), 6
! GFFRM: a context for each depth, 8 x 16 words.  GFITM: each depth's
! items, 8 x 8 x 4 words: first data bit, the bit after, operators'
! pointer, then count (.0), data count (.8), lone absolute datum (.16),
! .n (.17).  GFSCR: each depth's scratch slot, 32 words, depth 1 first.
GFFRM   DRZ(BU,64), 128
GFITM   DRZ(BU,64), 256
GFSCR   DRZ(BU,64), 224
! CPLTNM: PR, the partial result, and the radix and a digit in floating
! point (Box 1, Box 3): exponent 48 (bits 1-10), the value at the low end
! of the fraction (bits 12-59; RefMan printed pp.78-79).  CPZ48, exponent 48
! and fraction 0, aligns PR to an integer (Box 9).
CPPR    DD(BU,64), 0
CPZERO  DD(BU,64), 0
CPRADF  DD(BU,64), (16)0600000000000000
CPDIGF  DD(BU,64), (16)0600000000000000
CPZ48   DD(BU,64), (16)0600000000000000
CPWRK   DD(BU,64), 0
CPLV    DD(BU,64), 0
! CPLTSY: BSYMBX's value is where the symbol goes (p.74); CPLEN its length
BSYMBX  XW, 0, 0, 0
CPLEN   DD(BU,64), 0
!
! ======== SECTION 1: subroutines unique to Pass 1 (p.174) ==============
!
! XINPUT: the next card image, converted (p.77 boxes 4, 36).  COMREC word 8
! names the code (p.9); only 5, IQS, is written.  The input block is INX's:
! value the next card, count the cards left, ten words each.  The card goes
! to GCNEXT in A8; HAVEN is 1 if there was one.
XINPUT  L(BU,3), COMREC+8.25
        KI(BU,3), 5
        BAE, XIN0
        LI(BU,24), 1
        B, ERROR
XIN0    LI(BU,1), 0
        ST(BU,1), HAVEN
        LX, $13, INX
        KCI, $13, 0
        BXE, XIN9
        LVI, $7, GCNEXT
        LCI, $8, 80
XIN1    L(BU,8)(V+I), .8($13)
        ST(BU,8), XTMP+.13
        LV, $9, XTMP
        L(BU,8), IQSA8($9)
        ST(BU,8)(V+I), .8($7)
        CB, $8, XIN1
        LX, $13, INX
        C-I, $13, 1
        V+I, $13, 10.0
        SX, $13, INX
        LI(BU,1), 1
        ST(BU,1), HAVEN
XIN9    LV, $8, XINLK
        B, 0($8)
!
! GETCHA (Charts BG, BH pp.77-78; p.79).  One character to $3 per call.
! Blanks are skipped (Gcaz off; p.102's Gcaz, blanks significant, is not
! written yet).  At the end of a card block, the false semicolon with FEND
! on (p.79 item 5); at the end of the input, FEOF on (CHOSEN: MAIN stops at
! END; the driver stops here).  $14's value field is the next column of
! GCCARD.  GCCOM: a comment from columns 1-9 of the initial card (no name,
! nothing more to MAIN); GCCMC: a comment from columns 2-9 of a continuation
! card (the name goes on, nothing more to MAIN).
GETCHA  LI(BU,1), 0
        ST(BU,1), FEND
        L(BU,1), GCOPEN
        KI(BU,1), 1
        BAE, GC10
! no card block open: open the next one (box 3: GETCHA's initial entry)
        L(BU,1), HAVEN
        KI(BU,1), 1
        BAE, GC2
        LI(BU,1), 1
        ST(BU,1), FEOF
        B, GCX
GC2     SIC, GCOLK
        B, GCOPN
        LI(BU,1), 1
        ST(BU,1), GCOPEN
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        ST(BU,1), GCCOM
        ST(BU,1), GCCMC
        ST(BU,1), NAMEND
! column 1 (box 10): the comment character makes the card block a comment
        L(BU,8), GCCARD
        KI(BU,8), (8)14
        BAE, GC5
! columns 2-9 (boxes 14-16): a comment character there makes the block a
! comment (p.79); otherwise they are the name
        LV, $7, KNAME
        LCI, $8, 8
GC3     L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC5
        CB, $8, GC3
        LI(BU,18), 8
        ST(BU,18), GCNC
        SIC, GCNLK
        B, GCNAME
! CHOSEN, as strap2's Getcha: the initial card's name loses its trailing
! blanks before a continuation card adds to it (p.79 does not say)
        L(BU,18), NAMET
        ST(BU,18), NAMEL
        LV, $14, KSTMT
        B, GC10
GC5     LI(BU,1), 1
        ST(BU,1), GCCOM
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
! the statement field, columns 10-72 (box 22)
GC10    KVI, $14, GCEND
        BXL, GC20
! the end of the statement field (box 32): a continuation card (box 37)?
        L(BU,1), HAVEN
        KI(BU,1), 1
        BZAE, GC15
        L(BU,8), GCNEXT
        KI(BU,8), (8)54
        BZAE, GC15
        SIC, GCOLK
        B, GCOPN
! a comment block from the initial card: nothing of it to MAIN (p.79:
! "without giving them out to main flow through $3")
        L(BU,1), GCCOM
        KI(BU,1), 1
        BAE, GC14
! columns 2-9: a comment character there (p.79) ends the name part of the
! card; GCNC counts the columns before it
        LV, $7, KNAME
        LCI, $8, 8
        LI(BU,18), 0
        ST(BU,18), GCNC
        ST(BU,1), GCQ
GC16    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC17
        M+1(BU,18), GCNC
        CB, $8, GC16
        B, GC18
GC17    LI(BU,1), 1
        ST(BU,1), GCQ
! the name part continues the name (p.79), until one is blank
GC18    L(BU,1), NAMEND
        KI(BU,1), 1
        BAE, GC19
        L(BU,18), GCNC
        KI(BU,18), 0
        BAE, GC1E
        LV, $7, KNAME
        LC, $8, GCNC
GC1A    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)20
        BZAE, GC1B
        CB, $8, GC1A
GC1E    LI(BU,1), 1
        ST(BU,1), NAMEND
        B, GC19
GC1B    SIC, GCNLK
        B, GCNAME
! after a comment from a continuation card, its later statement fields are
! comment too (p.79)
GC19    L(BU,1), GCCMC
        KI(BU,1), 1
        BAE, GC14
        L(BU,1), GCQ
        KI(BU,1), 1
        BZAE, GC12
! p.79: "A comment character appearing in columns 2-9 of a continuation card
! causes the remaining characters on the card to be treated as a comment";
! MAIN gets the comment character "in $3 as usual"
        LI(BU,1), 1
        ST(BU,1), GCCMC
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC12    LV, $14, KSTMT
        B, GC10
GC14    LVI, $14, GCEND
        B, GC10
! the end of the card block (box 38): the false semicolon
GC15    LI(BU,1), 1
        ST(BU,1), FEND
        LI(BU,1), 0
        ST(BU,1), GCOPEN
        LI(BU,8), (8)35
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC20    L(BU,8)(V+I), .8($14)
        KI(BU,8), (8)20
        BAE, GC10
        SIC, GCPLK
        B, GCPUT
GCX     LV, $8, GETCHZ
        B, 0($8)
!
! GCPUT: the accumulator's byte to $3's value field
GCPUT   ST(BU,8), GCTMP+.16
        LV, $3, GCTMP
        LV, $8, GCPLK
        B, 0($8)
!
! GCOPN: GCNEXT becomes GCCARD, and XINPUT reads the next
GCOPN   LVI, $7, GCNEXT
        LVI, $9, GCCARD
        LCI, $8, 10
GCO1    L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GCO1
        SIC, XINLK
        B, XINPUT
        LV, $8, GCOLK
        B, 0($8)
!
! GCNAME: GCNC (at least 1) columns from column 2 of GCCARD to the name
! buffer (box 20); NAMET is the length to the last character that is not
! blank (strap2: rstrip)
GCNAME  LV, $7, KNAME
        LC, $8, GCNC
GCN1    L(BU,18), NAMEL
        KI(BU,18), 64
        BZAE, GCN2
        LI(BU,24), 2
        B, ERROR
GCN2    ST(BU,18), NTMP+.3
        LV, $9, NTMP
        L(BU,8)(V+I), .8($7)
        ST(BU,8), NAMEB($9)
        M+1(BU,18), NAMEL
        KI(BU,8), (8)20
        BAE, GCN3
        L(BU,18), NAMEL
        ST(BU,18), NAMET
GCN3    CB, $8, GCN1
        LV, $8, GCNLK
        B, 0($8)
!
! GETFLD (Charts BI-BK pp.80-82, text pp.83-86): one field's coded
! expression (Appendix C p.198) at BCFLDX.  Call SIC,GETFLZ; B,GETFLD (p.83).
! The data go in as they are read; each operator waits on GFSTK until one
! of no higher priority comes (p.198: .+ .L .R U- * / + -), and is put,
! with its datum number, in GFOPS; GFZA puts them after the data (Boxes 43,
! 60).  Sub-slice a: no parenthesis, $, g.p.
GETFLD  SX, $2, GFSAV2
        LV, $2, BCFLDX
        LI(BU,8), 0
        ST(BU,8), GFSN
        ST(BU,8), GFSRAD
        ST(BU,8), GFDEP
        LI(BU,64), 0
        LV, $9, GFCTXX
        LCI, $8, 16
GFI0    ST(BU,64)(V+I), 1.0($9)
        CB, $8, GFI0
        LI(BU,18), 0
        ST(BU,18), GFOPN
        LI(BU,64), 0
        ST(BU,64), GFNEW
        ST(BU,64), GFOP
        LVI, $9, GFOPS
        SV, $9, GFOPP
        LI(BU,1), 1
        ST(BU,1), GFFRST
! Boxes 3-4: the first character, unless the user has it (Gfchar)
        L(BU,1), GFCHAR
        KI(BU,1), 1
        BAE, GF1
        SIC, GETCHZ
        B, GETCHA
! Boxes 31, 34-35: nothing before the end of the field, the null prefix
GF1     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFNULL
        KI(BU,8), (8)35
        BAE, GFNULL
        KI(BU,8), (8)14
        BAE, GFNULL
        KI(BU,8), (8)74
        BAE, GFNULL
! the prefix: 1A, and 1B type 000 (p.198)
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
! a datum is expected (S-codes B, O, p.83): a leading plus does nothing; a
! minus is unary, once (U-); a point with no datum before it waits as .R.
! A point is an operator of the top priority (p.198), so it waits on GFSTK
! like the others, and the datum after it is put first.
GFE     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)60
        BZAE, GFE1
        L(BU,1), GFFRST
        KI(BU,1), 1
        BZAE, GFSYN
        LI(BU,1), 0
        ST(BU,1), GFFRST
        SIC, GETCHZ
        B, GETCHA
        B, GFE
GFE1    LI(BU,1), 0
        ST(BU,1), GFFRST
        L(BU,8), GFC+.16
        KI(BU,8), (8)40
        BZAE, GFE2
        L(BU,1), GFUN
        KI(BU,1), 1
        BAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFUN
        LI(BU,3), 3
        ST(BU,3), GFNEW+.53
        LI(BU,3), 4
        B, GFE4
GFE2    L(BU,8), GFC+.16
        KI(BU,8), (8)73
        BZAE, GFE6
        L(BU,1), GFPT
        KI(BU,1), 1
        BAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFPT
        LI(BU,3), 4
        ST(BU,3), GFNEW+.53
        LI(BU,3), 5
GFE4    ST(BU,3), GFNEW+.56
        L(BU,8), GFN
        ST(BU,5), GFNEW+.59
        SIC, GFELK
        B, GFPUSH
        SIC, GETCHZ
        B, GETCHA
        B, GFE
GFE6    L(BU,8), GFC+.16
        KI(BU,8), (8)34
        BZAE, GFE3
        LI(BU,8), 0
        B, GFOPEN
GFE3    SIC, GFPLK
        B, GFPRIM
        LI(BU,1), 0
        ST(BU,1), GFUN
! Boxes 58-59: a datum after "a." makes its .L a .+
        L(BU,1), GFDOTL
        KI(BU,1), 1
        BZAE, GFA
        LI(BU,1), 0
        ST(BU,1), GFDOTL
        L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        LI(BU,3), 7
        ST(BU,3), GFSTK-.8($9)
! after a datum (S-code S, p.83): a point (one to a datum: a second ends
! the field, 167 as strap2's 67), a binary operator, or the end
GFA     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)34
        BZAE, GFA5
        LI(BU,8), 1
        B, GFOPEN
GFA5    L(BU,8), GFC+.16
        KI(BU,8), (8)73
        BZAE, GFA1
        L(BU,1), GFPT
        KI(BU,1), 1
        BAE, GFEND
        LI(BU,1), 1
        ST(BU,1), GFPT
        LI(BU,3), 4
        ST(BU,3), GFNEW+.53
        LI(BU,3), 6
        ST(BU,3), GFNEW+.56
        L(BU,8), GFN
        ST(BU,5), GFNEW+.59
        SIC, GFELK
        B, GFPUSH
        SIC, GETCHZ
        B, GETCHA
! a datum follows the point: an alphameric character, $ or (
        SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BAL, GFA0
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BAE, GFA0
        KI(BU,8), (8)34
        BZAE, GFA
        LI(BU,8), 2
        B, GFOPEN
GFA0    LI(BU,1), 1
        ST(BU,1), GFDOTL
        B, GFE3
GFA1    LI(BU,3), 1
        ST(BU,3), GFNEW+.53
        LI(BU,3), 1
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)60
        BAE, GFA2
        LI(BU,3), 0
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)40
        BAE, GFA2
        LI(BU,3), 2
        ST(BU,3), GFNEW+.53
        LI(BU,3), 3
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)54
        BAE, GFA2
        LI(BU,3), 2
        ST(BU,3), GFNEW+.56
        L(BU,8), GFC+.16
        KI(BU,8), (8)21
        BAE, GFA2
        B, GFEND
! put each waiting operator of no lower priority, down to this expression's
! floor GFFLR, then this one waits
GFA2    L(BU,8), GFN
        ST(BU,5), GFNEW+.59
GFA3    L(BU,8), GFSN
        K(BU,8), GFFLR
        BAE, GFA4
        SIC, GFELK
        B, GFTOP
        L(BU,3), GFOP+.53
        K(BU,3), GFNEW+.53
        BAL, GFA4
        M-1(BU,8), GFSN
        SIC, GFELK
        B, GFPUT
        B, GFA3
GFA4    LI(BU,1), 0
        ST(BU,1), GFPT
        SIC, GFELK
        B, GFPUSH
        SIC, GETCHZ
        B, GETCHA
        B, GFE
! the end of the field: every waiting operator is put
GFEND   L(BU,8), GFSN
        K(BU,8), GFFLR
        BAE, GFEN1
        SIC, GFELK
        B, GFTOP
        M-1(BU,8), GFSN
        SIC, GFELK
        B, GFPUT
        B, GFEND
GFEN1   L(BU,8), GFDEP
        KI(BU,8), 0
        BZAE, GFITEM
GFEN2   SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFZA
        KI(BU,8), (8)35
        BAE, GFZA
        KI(BU,8), (8)14
        BAE, GFZA
        KI(BU,8), (8)74
        BAE, GFZA
        LI(BU,24), 167
        B, ERROR
! GFZA (Boxes 43, 60): the end of the data, the operators, no more
! operators, and no g.p. (Box 46: "the bit at the end ... set to zero")
GFZA    SIC, GFZLK
        B, GFLZC
        LI(BU,1), 0
        ST(BU,1)(V+I), .1($2)
        L(BU,18), GFOPN
        KI(BU,18), 0
        BAE, GFZ2
        LVI, $9, GFOPS
        LC, $8, GFOPN
GFZ1    L(BU,9)(V+I), .9($9)
        ST(BU,9)(V+I), .9($2)
        CB, $8, GFZ1
GFZ2    LI(BU,2), 0
        ST(BU,2)(V+I), .2($2)
GFX     SV, $2, BCFLDX
        LX, $2, GFSAV2
        LV, $8, GETFLZ
        B, 0($8)
GFNULL  LI(BU,6), (8)74
        ST(BU,6)(V+I), .6($2)
        B, GFX
GFSYN   LI(BU,24), 166
        B, ERROR
!
! GFPRIM: a number (Boxes 8, 16-17) or a programmer symbol (Boxes 7, 15,
! 25-27), into the coded expression with the end of its datum (2E, 0)
GFPRIM  SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 10
        BAL, GFPN
        KI(BU,8), 36
        BAL, GFPS
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BAE, GFNW
        KI(BU,8), (8)34
        BAE, GFNW
        B, GFSYN
GFNW    LI(BU,24), 9
        B, ERROR
GFPN    SIC, CPLTNZ
        B, CPLTNM
        SIC, GFZLK
        B, GFLZC
        LI(BU,1), 1
        ST(BU,1), GFLKA
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        L(BU,24), CPLV
        ST(BU,24)(V+I), .24($2)
        B, GFPE
! Box 15: ten bits left for the prefix and length; CPLTSY puts the symbol
GFPS    SIC, GFZLK
        B, GFLZC
        LI(BU,1), 0
        ST(BU,1), GFLKA
        SV, $2, GFP0
        LI(BU,10), 0
        ST(BU,10)(V+I), .10($2)
        SV, $2, BSYMBX
        SIC, CPLTSZ
        B, CPLTSY
        LV, $2, BSYMBX
        LV, $9, GFP0
        LI(BU,3), 4
        ST(BU,3)(V+I), .3($9)
        L(BU,8), CPLEN
        ST(BU,7)(V+I), .7($9)
! the end of the datum (2E, 0) is held open: S/X may follow (p.198)
GFPE    LI(BU,1), 1
        ST(BU,1), GFLAZ
        LI(BU,1), 0
        ST(BU,1), GFSUB
        M+1(BU,8), GFN
        LV, $8, GFPLK
        B, 0($8)
!
! GFPUSH: GFNEW onto the operator stack.  GFTOP: the top entry, GFSN's
! less one, to GFOP (the caller lowers GFSN to take it off).  GFPUT: GFOP's
! operator into GFOPS, 1, code, datum number (p.198 3A-3C).
GFPUSH  L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        L(BU,16), GFNEW+.48
        ST(BU,16), GFSTK($9)
        M+1(BU,8), GFSN
        LV, $8, GFELK
        B, 0($8)
GFTOP   L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        L(BU,16), GFSTK-.16($9)
        ST(BU,16), GFOP+.48
        LV, $8, GFELK
        B, 0($8)
GFPUT   LV, $9, GFOPP
        LI(BU,1), 1
        ST(BU,1)(V+I), .1($9)
        L(BU,8), GFOP+.56
        ST(BU,8)(V+I), .8($9)
        SV, $9, GFOPP
        M+1(BU,18), GFOPN
        LV, $8, GFELK
        B, 0($8)
!
! GFLZC: the open datum's end bit (2E, 0), if one is held open
GFLZC   L(BU,1), GFLAZ
        KI(BU,1), 1
        BZAE, GFLZ1
        LI(BU,1), 0
        ST(BU,1), GFLAZ
        ST(BU,1)(V+I), .1($2)
GFLZ1   LV, $8, GFZLK
        B, 0($8)
!
! GFOPEN: a '(' (Box 5), its kind in the accumulator: 0 at a datum's start,
! 1 after a datum, 2 after a datum's point.  The outer context is saved
! (Box 2: "the buffer is pushed down one word"); the parenthesis' items
! are built in this depth's slot of GFSCR and placed at its ')'.
GFOPEN  ST(BU,8), GFT
        L(BU,8), GFDEP
        KI(BU,8), 7
        BZAE, GFO1
        LI(BU,24), 10
        B, ERROR
GFO1    SV, $2, GFR2
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
        B, GFSAVE
        M+1(BU,8), GFDEP
        L(BU,8), GFT
        ST(BU,8), GFKND
        LI(BU,8), 0
        ST(BU,8), GFNIT
        L(BU,8), GFDEP
        ST(BU,8), STXD+.5
        LV, $2, GFSCRX
        V+, $2, STXD
        SV, $2, GFSLS
        SIC, GETCHZ
        B, GETCHA
! an item begins: an expression of its own
GFIS    LI(BU,8), 0
        ST(BU,8), GFN
        L(BU,8), GFSN
        ST(BU,8), GFFLR
        LI(BU,1), 0
        ST(BU,1), GFUN
        ST(BU,1), GFPT
        ST(BU,1), GFDOTL
        ST(BU,1), GFLAZ
        ST(BU,1), GFLKA
        ST(BU,1), GFSUB
        LI(BU,1), 1
        ST(BU,1), GFFRST
        SV, $2, GFIDS
        L(BU,24), GFOPP
        ST(BU,24), GFIOB
        L(BU,18), GFOPN
        ST(BU,18), GFIOBN
        B, GFE
!
! GFITEM: an item ends at ',' or ')' (Box 71; anything else, 167).  Its
! record: data bits, operators, data count, and whether it is one absolute
! datum alone (Box 64) or .n (Boxes 65-66).
GFITEM  SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFIT1
        KI(BU,8), (8)74
        BAE, GFIT1
        LI(BU,24), 167
        B, ERROR
GFIT1   SV, $2, GFT
        L(BU,24), GFT
        -(BU,24), GFSLS
        KI(BU,24), 2048
        BZAH, GFIT2
        LI(BU,24), 10
        B, ERROR
GFIT2   L(BU,8), GFNIT
        KI(BU,8), 8
        BZAE, GFIT3
        LI(BU,24), 10
        B, ERROR
GFIT3   L(BU,8), GFDEP
        ST(BU,8), GFIDP
        L(BU,8), GFNIT
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), GFIDS
        ST(BU,24), 0($9)
        SV, $2, GFT
        L(BU,24), GFT
        ST(BU,24), 1.0($9)
        L(BU,24), GFIOB
        ST(BU,24), 2.0($9)
        L(BU,18), GFIOBN
        ST(BU,18), 2.24($9)
        L(BU,18), GFOPN
        -(BU,18), GFIOBN
        ST(BU,8), 3.0($9)
        L(BU,8), GFN
        ST(BU,8), 3.8($9)
        LI(BU,2), 0
        ST(BU,2), 3.16($9)
        L(BU,8), GFN
        KI(BU,8), 1
        BZAE, GFIT5
        L(BU,1), GFLKA
        KI(BU,1), 1
        BZAE, GFIT5
        L(BU,1), GFSUB
        KI(BU,1), 0
        BZAE, GFIT5
        L(BU,8), 3.0($9)
        KI(BU,8), 0
        BZAE, GFIT4
        LI(BU,1), 1
        ST(BU,1), 3.16($9)
        B, GFIT5
GFIT4   KI(BU,8), 1
        BZAE, GFIT5
        LV, $7, GFIOB
        L(BU,9), 0($7)
        KI(BU,9), (8)640
        BZAE, GFIT5
        LI(BU,1), 1
        ST(BU,1), 3.17($9)
GFIT5   M+1(BU,8), GFNIT
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BZAE, GFCLOS
        SIC, GETCHZ
        B, GETCHA
        B, GFIS
!
! GFCLOS: the ')' (Boxes 56-83, p.85).  A .n item is a g.p. (Boxes 64-70)
! and a lone absolute datum where no S/X may stand a radix (Boxes 79-81,
! 74): both sub-slice d, halt 9.  Otherwise, with the outer context back:
! after a datum or its point, S/X of that datum (Boxes 56, 60, 62); at a
! datum's start, one item with an operator joins the outer expression
! (Boxes 76-78, CHOSEN: an operator makes it arithmetic), and anything
! else is S/X on a zero datum (Box 82; MCP p.126's KV,2,($1)).
GFCLOS  L(BU,8), GFKND
        ST(BU,8), GFCK
        L(BU,8), GFNIT
        ST(BU,8), GFCN
        L(BU,8), GFDEP
        ST(BU,8), GFIDP
        LI(BU,8), 0
        ST(BU,8), GFCI
GFCL1   SIC, GFILK
        B, GFIADR
        L(BU,1), 3.17($9)
        KI(BU,1), 1
        BAE, GFNW
        M+1(BU,8), GFCI
        L(BU,8), GFCI
        K(BU,8), GFCN
        BZAE, GFCL1
        L(BU,8), GFCK
        KI(BU,8), 1
        BAE, GFCL2
        L(BU,8), GFCN
        KI(BU,8), 1
        BZAE, GFCL2
        LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,1), 3.16($9)
        KI(BU,1), 1
        BAE, GFNW
GFCL2   M-1(BU,8), GFDEP
        L(BU,8), GFDEP
        ST(BU,8), STXF+.6
        SIC, GFSLK
        B, GFREST
        LV, $2, GFR2
        L(BU,8), GFCK
        KI(BU,8), 0
        BZAE, GFSUBS
        L(BU,8), GFCN
        KI(BU,8), 1
        BZAE, GFZD
        LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,8), 3.0($9)
        KI(BU,8), 0
        BAE, GFZD
! Box 78: the item's data join the outer data; its operators, renumbered
! after the outer data, stay where they are in GFOPS
        SIC, GFZLK
        B, GFLZC
        L(BU,24), 0($9)
        ST(BU,24), GFCS
        L(BU,24), 1.0($9)
        ST(BU,24), GFCE
        SIC, GFCLK
        B, GFCOPY
        SIC, GFILK
        B, GFIADR
        L(BU,8), GFN
        ST(BU,8), GFPARN
        +(BU,8), 3.8($9)
        ST(BU,8), GFN
        L(BU,8), 3.0($9)
        ST(BU,18), GFCR
        L(BU,24), 2.0($9)
        ST(BU,24), GFT
        LV, $7, GFT
        LC, $8, GFCR
GFCL3   L(BU,5), .4($7)
        +(BU,8), GFPARN
        ST(BU,5), .4($7)
        L(BU,1)(V+I), .9($7)
        CB, $8, GFCL3
        LI(BU,1), 1
        ST(BU,1), GFLAZ
        LI(BU,1), 0
        ST(BU,1), GFLKA
        ST(BU,1), GFSUB
        B, GFCX
! a zero datum, its end held open, the items its S/X
GFZD    SIC, GFZLK
        B, GFLZC
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        LI(BU,24), 0
        ST(BU,24)(V+I), .24($2)
        M+1(BU,8), GFN
        LI(BU,1), 1
        ST(BU,1), GFLAZ
        ST(BU,1), GFLKA
! each item as S/X (p.199 note 2): 1000, its data, the end of its last
! datum and of the data, its operators, no more operators
GFSUBS  LI(BU,8), 0
        ST(BU,8), GFCI
GFSB1   SIC, GFILK
        B, GFIADR
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
        L(BU,24), 0($9)
        ST(BU,24), GFCS
        L(BU,24), 1.0($9)
        ST(BU,24), GFCE
        SIC, GFCLK
        B, GFCOPY
        LI(BU,2), 0
        ST(BU,2)(V+I), .2($2)
        SIC, GFILK
        B, GFIADR
        L(BU,8), 3.0($9)
        KI(BU,8), 0
        BAE, GFSB3
        ST(BU,18), GFCR
        L(BU,24), 2.0($9)
        ST(BU,24), GFT
        LV, $7, GFT
        LC, $8, GFCR
GFSB2   L(BU,9)(V+I), .9($7)
        ST(BU,9)(V+I), .9($2)
        CB, $8, GFSB2
GFSB3   LI(BU,1), 0
        ST(BU,1)(V+I), .1($2)
        M+1(BU,8), GFCI
        L(BU,8), GFCI
        K(BU,8), GFCN
        BZAE, GFSB1
! the items' operators are spent: GFOPS back to the first item's start
        LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), 2.0($9)
        ST(BU,24), GFOPP
        L(BU,18), 2.24($9)
        ST(BU,18), GFOPN
        LI(BU,1), 1
        ST(BU,1), GFSUB
! after a point the .L becomes .+ (Fig. 29 p.201 prints 7.(...) so)
        L(BU,8), GFCK
        KI(BU,8), 2
        BZAE, GFCX
        L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        LI(BU,3), 7
        ST(BU,3), GFSTK-.8($9)
GFCX    LI(BU,1), 0
        ST(BU,1), GFUN
        SIC, GETCHZ
        B, GETCHA
        B, GFA
!
! GFSAVE, GFREST: the context to and from GFFRM at the depth in STXF
GFSAVE  LV, $9, GFFRMX
        V+, $9, STXF
        LV, $7, GFCTXX
        LCI, $8, 16
GFSV1   L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GFSV1
        LV, $8, GFSLK
        B, 0($8)
GFREST  LV, $9, GFFRMX
        V+, $9, STXF
        LV, $7, GFCTXX
        LCI, $8, 16
GFRS1   L(BU,64)(V+I), 1.0($9)
        ST(BU,64)(V+I), 1.0($7)
        CB, $8, GFRS1
        LV, $8, GFSLK
        B, 0($8)
! GFIADR: $9 to item GFCI of depth GFIDP in GFITM
GFIADR  L(BU,8), GFIDP
        ST(BU,8), STXD+.5
        L(BU,8), GFCI
        ST(BU,8), STXK+.8
        LV, $9, GFITMX
        V+, $9, STXD
        V+, $9, STXK
        LV, $8, GFILK
        B, 0($8)
! GFCOPY: the bits from GFCS to GFCE to $2: whole words, then single bits
GFCOPY  L(BU,24), GFCE
        -(BU,24), GFCS
        ST(BU,24), GFCL
        LV, $9, GFCS
        L(BU,18), GFCL
        KI(BU,18), 0
        BAE, GFCP2
        LC, $8, GFCL
GFCP1   L(BU,64)(V+I), 1.0($9)
        ST(BU,64)(V+I), 1.0($2)
        CB, $8, GFCP1
GFCP2   L(BU,6), GFCL+.18
        KI(BU,6), 0
        BAE, GFCP4
        ST(BU,18), GFCR
        LC, $8, GFCR
GFCP3   L(BU,1)(V+I), .1($9)
        ST(BU,1)(V+I), .1($2)
        CB, $8, GFCP3
GFCP4   LV, $8, GFCLK
        B, 0($8)
!
! CPLTNM (Chart BD p.70, p.71).  $3 holds the first digit; the radix is
! GFSRAD.  PR := PR x radix + digit in floating point (Boxes 1-8), while
! the character is alphameric.  CHOSEN: while PR's fraction is zero, PR is
! the digit itself: a zero fraction's exponent grows by 48 at each normalized
! multiply, so after 007's second 0 the 7 was aligned away (found on the
! model); the guide's Box 6 draws only PR x radix + digit.  A digit not
! less than the radix is message
! 63 (p.71: still used; here a halt).  Box 9: PR aligned to exponent 48
! by an unnormalized add puts the integer at the low end of the fraction;
! CPLV gets its 24 bits (Fig. 12; over 24 bits: 168, as strap2).  The
! floating stores are written ST(U): a bare ST takes its mode from the
! symbol's dds, DD(BU,64) here, and stores as VFL (found on the model).
CPLTNM  L(BU,8), GFSRAD
        KI(BU,8), 0
        BZAE, CPN1
        LI(BU,8), 10
CPN1    ST(BU,8), CPRADF+.52
        L(N), CPZERO
        ST(U), CPPR
CPN3    SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BZAL, CPN9
        K(BU,8), CPRADF+.52
        BAL, CPN6
        LI(BU,24), 163
        B, ERROR
CPN6    ST(BU,8), CPDIGF+.52
        L(BU,48), CPPR+.12
        KI(BU,48), 0
        BZAE, CPN7
        L(N), CPDIGF
        B, CPN8
CPN7    L(N), CPPR
        *(N), CPRADF
        +(N), CPDIGF
CPN8    ST(U), CPPR
        SIC, GETCHZ
        B, GETCHA
        B, CPN3
CPN9    L(U), CPPR
        +(U), CPZ48
        ST(U), CPWRK
        L(BU,24), CPWRK+.12
        KI(BU,24), 0
        BAE, CPN10
        LI(BU,24), 168
        B, ERROR
CPN10   L(BU,24), CPWRK+.36
        ST(BU,24), CPLV
        LV, $8, CPLTNZ
        B, 0($8)
!
! CPLTSY (Chart BE p.72, pp.74-75), a programmer symbol: each alphameric
! character to BSYMBX (Boxes 2-9), at most 128 (Box 3, message 49).  A
! tail ($ after the symbol, Box 15) is not written yet.
CPLTSY  LI(BU,8), 0
        ST(BU,8), CPLEN
CPS2    L(BU,8), CPLEN
        KI(BU,8), 128
        BZAE, CPS3
        LI(BU,24), 149
        B, ERROR
CPS3    M+1(BU,8), CPLEN
        SV, $3, GFC
        L(BU,8), GFC+.16
        LV, $9, BSYMBX
        ST(BU,8)(V+I), .8($9)
        SV, $9, BSYMBX
        SIC, GETCHZ
        B, GETCHA
        SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BAL, CPS2
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BZAE, CPS9
        LI(BU,24), 9
        B, ERROR
CPS9    LV, $8, CPLTSZ
        B, 0($8)
!
! ======== STAND-INS FOR MCP (CHOSEN, docs/strap2_7030.md) ==============
!
! COMREC (pp.8-10): word 8, the input file; its code, bits 8.25-8.27, is 5,
! IQS.  Set here, standing for the pre-processor (p.8: "This word must
! always be set up by the pre-processor").  The other words wait for the
! disk.
        CNOP
COMREC  DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), (16)0000005000000000
        DRZ(BU,64), 16
!
! The input block: INX's value is the next card, its count the cards left;
! the cards follow INB, ten words each, in IQS.  A test sets the count and
! puts the cards, then its driver, after INB.
INX     XW, INB, 0, 0
INB     SYN, $
        END
