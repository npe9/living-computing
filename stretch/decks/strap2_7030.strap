! strap2_7030.strap -- RECONSTRUCTION of STRAP II as a 7030 program.
!
! >>> A RECONSTRUCTION.  IBM's STRAP II was a 7030 program; one page of its
! >>> code survives (CHM 102633945, decks/strap2_chm102633945.strap).  This
! >>> code is written here to C22-6729 (the STRAP II Systems Analysis Guide),
! >>> read in the ink.  docs/strap2_7030.md records every convention with
! >>> its page, or marks it CHOSEN.  The reference for its behaviour is the
! >>> host-side STRAP II, strap/strap2/. <<<
!
! STEP 1 (docs/strap2_7030.md "The order of work"): XINPUT and GETCHA.
! MAIN is not written yet.  The test's driver (tests/strap2_7030_drive.strap,
! NOT part of this reconstruction) is assembled after this deck and stands in
! for MAIN: it calls GETCHA to the end of the input and records what GETCHA
! gives.  tests/check_strap2_7030.py runs it on the model against strap2.
!
! LAYOUT: C22-6729 p.174 and Fig. 30 p.209.  SCSTRAP1 is sections 0, A0, A1
! and 1 in that order; SCSTRAP2 (A2, 2) will overlay A1 and 1; A3 holds the
! buffers.  Each section below starts with its banner.
!
! REGISTERS (p.175, both passes).  Only $7, $8 and $9 are free.  In Pass 1
! $3 is the A8 character from GETCHA, $13 belongs to INTOUT (XINPUT here, the
! input routine, CHOSEN) and $14 to GETCHA.  $15 is general linkage; GETCHA's
! own is SIC,GETCHZ (p.79).  CHOSEN: the routines without a LINKAGE paragraph
! read so far (XINPUT, GCOPN, GCNAME, GCPUT) link through memory cells,
! "SIC,cell", read back with LV,$8,cell; B,0($8), as GETCHA's does.  A
! routine the CHM page calls through $15 will take $15.
!
! CHARACTERS.  The input is IQS, COMREC code 5 (p.8); XINPUT converts each
! card to A8, STRAP II's internal code (p.175: "A8 character from GETCHA";
! strap/strap2/a8.py: the 48 set of RefMan printed p.166 in eight bits, and
! the internal false semicolon 0o35).  A8 used below: blank 0o20, quote
! (the comment character, p.79) 0o14, asterisk 0o54, semicolon 0o35.  In a
! VFL immediate an integer is the value: KI(BU,8),(8)54.  An index immediate
! (LVI) is a half-word address, so a character reaches $3 by GCPUT and an
! address with a bit part by LV from an XW.
!
! THE FAILURES.  Each halts at HALTE with a code in ERRC:
!    1 COMREC word 8's code is not 5, IQS (only IQS input is written)
!    2 a name longer than 64 characters (CHOSEN size of NAMEB; strap2 has no
!      limit)
!
        SLC, (8)2000.0
!
! ======== SECTION 0: subroutines common to Pass 1 and Pass 2 (p.174) ===
ERROR   ST(BU,24), ERRC
HALTE   BEW, $
!
! ======== SECTION A0: common constants and work areas, the I-O work
! ======== areas, the messages (p.174) ==================================
        CNOP
ERRC    DD(BU,64), 0
XINLK   DD(BU,64), 0
XTMP    DD(BU,64), 0
HAVEN   DD(BU,64), 0
GCNEXT  DRZ(BU,64), 10
! IQSA8: IQS code (strap/charsets.py IQS) to A8 (strap/strap2/a8.py), one
! byte per IQS code; a code with no A8 character is 0, as a8() gives.
! Generated from those two tables, 2026-11-12.
IQSA8   SYN, $
        DD(BU,64), (16)1000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)00302B0B2C1C113C
        DD(BU,64), (16)1B1D0C0031313232
        DD(BU,64), (16)3333343435353636
        DD(BU,64), (16)3737383839392121
        DD(BU,64), (16)2222232324242525
        DD(BU,64), (16)2626272728282929
        DD(BU,64), (16)1212131314141515
        DD(BU,64), (16)1616171718181919
        DD(BU,64), (16)0A00010002000300
        DD(BU,64), (16)0400050006000700
        DD(BU,64), (16)080009003B1A2000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
!
! ======== SECTION A1: Pass 1's constants and work areas (p.174) =======
GCEND   SYN, GCCARD+9.0
! LVI loads a half-word address (the bits below .32 are dropped;
! card_reader.strap), so an address with a bit part is loaded with LV from
! an index word:
KNAME   XW, GCCARD+.8, 0, 0
KSTMT   XW, GCCARD+1.8, 0, 0
GETCHZ  DD(BU,64), 0
GCOLK   DD(BU,64), 0
GCNLK   DD(BU,64), 0
GCPLK   DD(BU,64), 0
GCTMP   DD(BU,64), 0
NTMP    DD(BU,64), 0
FEND    DD(BU,64), 0
FEOF    DD(BU,64), 0
GCOPEN  DD(BU,64), 0
GCCOM   DD(BU,64), 0
GCCMC   DD(BU,64), 0
GCQ     DD(BU,64), 0
GCNC    DD(BU,64), 0
NAMEND  DD(BU,64), 0
NAMEL   DD(BU,64), 0
NAMET   DD(BU,64), 0
NAMEB   DRZ(BU,64), 8
GCCARD  DRZ(BU,64), 10
!
! ======== SECTION 1: subroutines unique to Pass 1 (p.174) ==============
!
! XINPUT: the next card image, converted (p.77 boxes 4, 36).  COMREC word 8
! names the code (p.9); only 5, IQS, is written.  The input block is INX's:
! value the next card, count the cards left, ten words each.  The card goes
! to GCNEXT in A8; HAVEN is 1 if there was one.
XINPUT  L(BU,3), COMREC+8.25
        KI(BU,3), 5
        BAE, XIN0
        LI(BU,24), 1
        B, ERROR
XIN0    LI(BU,1), 0
        ST(BU,1), HAVEN
        LX, $13, INX
        KCI, $13, 0
        BXE, XIN9
        LVI, $7, GCNEXT
        LCI, $8, 80
XIN1    L(BU,8)(V+I), .8($13)
        ST(BU,8), XTMP+.13
        LV, $9, XTMP
        L(BU,8), IQSA8($9)
        ST(BU,8)(V+I), .8($7)
        CB, $8, XIN1
        LX, $13, INX
        C-I, $13, 1
        V+I, $13, 10.0
        SX, $13, INX
        LI(BU,1), 1
        ST(BU,1), HAVEN
XIN9    LV, $8, XINLK
        B, 0($8)
!
! GETCHA (Charts BG, BH pp.77-78; p.79).  One character to $3 per call.
! Blanks are skipped (Gcaz off; p.102's Gcaz, blanks significant, is not
! written yet).  At the end of a card block, the false semicolon with FEND
! on (p.79 item 5); at the end of the input, FEOF on (CHOSEN: MAIN stops at
! END; the driver stops here).  $14's value field is the next column of
! GCCARD.  GCCOM: a comment from columns 1-9 of the initial card (no name,
! nothing more to MAIN); GCCMC: a comment from columns 2-9 of a continuation
! card (the name goes on, nothing more to MAIN).
GETCHA  LI(BU,1), 0
        ST(BU,1), FEND
        L(BU,1), GCOPEN
        KI(BU,1), 1
        BAE, GC10
! no card block open: open the next one (box 3: GETCHA's initial entry)
        L(BU,1), HAVEN
        KI(BU,1), 1
        BAE, GC2
        LI(BU,1), 1
        ST(BU,1), FEOF
        B, GCX
GC2     SIC, GCOLK
        B, GCOPN
        LI(BU,1), 1
        ST(BU,1), GCOPEN
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        ST(BU,1), GCCOM
        ST(BU,1), GCCMC
        ST(BU,1), NAMEND
! column 1 (box 10): the comment character makes the card block a comment
        L(BU,8), GCCARD
        KI(BU,8), (8)14
        BAE, GC5
! columns 2-9 (boxes 14-16): a comment character there makes the block a
! comment (p.79); otherwise they are the name
        LV, $7, KNAME
        LCI, $8, 8
GC3     L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC5
        CB, $8, GC3
        LI(BU,18), 8
        ST(BU,18), GCNC
        SIC, GCNLK
        B, GCNAME
! CHOSEN, as strap2's Getcha: the initial card's name loses its trailing
! blanks before a continuation card adds to it (p.79 does not say)
        L(BU,18), NAMET
        ST(BU,18), NAMEL
        LV, $14, KSTMT
        B, GC10
GC5     LI(BU,1), 1
        ST(BU,1), GCCOM
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
! the statement field, columns 10-72 (box 22)
GC10    KVI, $14, GCEND
        BXL, GC20
! the end of the statement field (box 32): a continuation card (box 37)?
        L(BU,1), HAVEN
        KI(BU,1), 1
        BZAE, GC15
        L(BU,8), GCNEXT
        KI(BU,8), (8)54
        BZAE, GC15
        SIC, GCOLK
        B, GCOPN
! a comment block from the initial card: nothing of it to MAIN (p.79:
! "without giving them out to main flow through $3")
        L(BU,1), GCCOM
        KI(BU,1), 1
        BAE, GC14
! columns 2-9: a comment character there (p.79) ends the name part of the
! card; GCNC counts the columns before it
        LV, $7, KNAME
        LCI, $8, 8
        LI(BU,18), 0
        ST(BU,18), GCNC
        ST(BU,1), GCQ
GC16    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC17
        M+1(BU,18), GCNC
        CB, $8, GC16
        B, GC18
GC17    LI(BU,1), 1
        ST(BU,1), GCQ
! the name part continues the name (p.79), until one is blank
GC18    L(BU,1), NAMEND
        KI(BU,1), 1
        BAE, GC19
        L(BU,18), GCNC
        KI(BU,18), 0
        BAE, GC1E
        LV, $7, KNAME
        LC, $8, GCNC
GC1A    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)20
        BZAE, GC1B
        CB, $8, GC1A
GC1E    LI(BU,1), 1
        ST(BU,1), NAMEND
        B, GC19
GC1B    SIC, GCNLK
        B, GCNAME
! after a comment from a continuation card, its later statement fields are
! comment too (p.79)
GC19    L(BU,1), GCCMC
        KI(BU,1), 1
        BAE, GC14
        L(BU,1), GCQ
        KI(BU,1), 1
        BZAE, GC12
! p.79: "A comment character appearing in columns 2-9 of a continuation card
! causes the remaining characters on the card to be treated as a comment";
! MAIN gets the comment character "in $3 as usual"
        LI(BU,1), 1
        ST(BU,1), GCCMC
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC12    LV, $14, KSTMT
        B, GC10
GC14    LVI, $14, GCEND
        B, GC10
! the end of the card block (box 38): the false semicolon
GC15    LI(BU,1), 1
        ST(BU,1), FEND
        LI(BU,1), 0
        ST(BU,1), GCOPEN
        LI(BU,8), (8)35
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC20    L(BU,8)(V+I), .8($14)
        KI(BU,8), (8)20
        BAE, GC10
        SIC, GCPLK
        B, GCPUT
GCX     LV, $8, GETCHZ
        B, 0($8)
!
! GCPUT: the accumulator's byte to $3's value field
GCPUT   ST(BU,8), GCTMP+.16
        LV, $3, GCTMP
        LV, $8, GCPLK
        B, 0($8)
!
! GCOPN: GCNEXT becomes GCCARD, and XINPUT reads the next
GCOPN   LVI, $7, GCNEXT
        LVI, $9, GCCARD
        LCI, $8, 10
GCO1    L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GCO1
        SIC, XINLK
        B, XINPUT
        LV, $8, GCOLK
        B, 0($8)
!
! GCNAME: GCNC (at least 1) columns from column 2 of GCCARD to the name
! buffer (box 20); NAMET is the length to the last character that is not
! blank (strap2: rstrip)
GCNAME  LV, $7, KNAME
        LC, $8, GCNC
GCN1    L(BU,18), NAMEL
        KI(BU,18), 64
        BZAE, GCN2
        LI(BU,24), 2
        B, ERROR
GCN2    ST(BU,18), NTMP+.3
        LV, $9, NTMP
        L(BU,8)(V+I), .8($7)
        ST(BU,8), NAMEB($9)
        M+1(BU,18), NAMEL
        KI(BU,8), (8)20
        BAE, GCN3
        L(BU,18), NAMEL
        ST(BU,18), NAMET
GCN3    CB, $8, GCN1
        LV, $8, GCNLK
        B, 0($8)
!
! ======== STAND-INS FOR MCP (CHOSEN, docs/strap2_7030.md) ==============
!
! COMREC (pp.8-10): word 8, the input file; its code, bits 8.25-8.27, is 5,
! IQS.  Set here, standing for the pre-processor (p.8: "This word must
! always be set up by the pre-processor").  The other words wait for the
! disk.
        CNOP
COMREC  DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), (16)0000005000000000
        DRZ(BU,64), 16
!
! The input block: INX's value is the next card, its count the cards left;
! the cards follow INB, ten words each, in IQS.  A test sets the count and
! puts the cards, then its driver, after INB.
INX     XW, INB, 0, 0
INB     SYN, $
        END
