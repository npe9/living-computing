        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFMI
        ST(BU,8), GFMPOS($9)
        M+1(BU,8), GFMK
GFMS2   M+1(BU,8), GFMI
        L(BU,8), GFMI
        KI(BU,8), 8
        BZAE, GFMS1
GFMB1   LI(BU,8), 0
        ST(BU,8), GFMJ
GFMB2   L(BU,8), GFMJ
        K(BU,8), GFMK
        BAE, GFNF
        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFMPOS($9)
