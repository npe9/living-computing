        KI(BU,8), 0
        BAE, GFSB3
        ST(BU,18), GFCR
        L(BU,24), 2.0($9)
        ST(BU,24), GFT
        LV, $7, GFT
        LC, $8, GFCR
GFSB2   L(BU,9)(V+I), .9($7)
        ST(BU,9)(V+I), .9($2)
        CB, $8, GFSB2
GFSB3   LI(BU,1), 0
        ST(BU,1)(V+I), .1($2)
        M+1(BU,8), GFCI
        L(BU,8), GFCI
        K(BU,8), GFCN
        BZAE, GFSB1
! the items' operators are spent: GFOPS back to the first item's start
        LI(BU,8), 0
        ST(BU,8), GFCI
        SIC, GFILK
        B, GFIADR
        L(BU,24), 2.0($9)
        ST(BU,24), GFOPP
        L(BU,18), 2.24($9)
        ST(BU,18), GFOPN
        LI(BU,1), 1
        ST(BU,1), GFSUB
! after a point the .L becomes .+ (Fig. 29 p.201 prints 7.(...) so)
        L(BU,8), GFCK
        KI(BU,8), 2
        BZAE, GFCX
        L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        LI(BU,3), 7
        ST(BU,3), GFSTK-.8($9)
GFCX    L(BU,1), GFDOTL
        KI(BU,1), 1
        BZAE, GFCX1
        LI(BU,1), 0
        ST(BU,1), GFDOTL
        L(BU,8), GFSN
        ST(BU,8), STX+.12
        LV, $9, STX
        LI(BU,3), 7
        ST(BU,3), GFSTK-.8($9)
GFCX1   LI(BU,1), 0
        ST(BU,1), GFUN
        SIC, GETCHZ
        B, GETCHA
        B, GFA
!
! GFSAVE, GFREST: the context to and from GFFRM at the depth in STXF
GFSAVE  LV, $9, GFFRMX
        V+, $9, STXF
        LV, $7, GFCTXX
        LCI, $8, 16
GFSV1   L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GFSV1
        LV, $8, GFSLK
        B, 0($8)
GFREST  LV, $9, GFFRMX
        V+, $9, STXF
        LV, $7, GFCTXX
        LCI, $8, 16
GFRS1   L(BU,64)(V+I), 1.0($9)
        ST(BU,64)(V+I), 1.0($7)
        CB, $8, GFRS1
        LV, $8, GFSLK
        B, 0($8)
! GFIADR: $9 to item GFCI of depth GFIDP in GFITM
GFIADR  L(BU,8), GFIDP
        ST(BU,8), STXD+.5
        L(BU,8), GFCI
        ST(BU,8), STXK+.8
        LV, $9, GFITMX
        V+, $9, STXD
        V+, $9, STXK
        LV, $8, GFILK
        B, 0($8)
! GFCOPY: the bits from GFCS to GFCE to $2: whole words, then single bits
GFCOPY  L(BU,24), GFCE
        -(BU,24), GFCS
        ST(BU,24), GFCL
        LV, $9, GFCS
        L(BU,18), GFCL
        KI(BU,18), 0
        BAE, GFCP2
        LC, $8, GFCL
GFCP1   L(BU,64)(V+I), 1.0($9)
        ST(BU,64)(V+I), 1.0($2)
        CB, $8, GFCP1
GFCP2   L(BU,6), GFCL+.18
        KI(BU,6), 0
        BAE, GFCP4
        ST(BU,18), GFCR
        LC, $8, GFCR
GFCP3   L(BU,1)(V+I), .1($9)
        ST(BU,1)(V+I), .1($2)
        CB, $8, GFCP3
GFCP4   LV, $8, GFCLK
        B, 0($8)
!
! GFPD: a $ (Boxes 15, 22-29; CPLTSY Boxes 1, 5-13, 32-41, pp.74-76).  The
! name, at most 8 characters (p.74), blank-filled in GFKEY; none is $ alone
! (Fig. 14); BOPSER finds it in SYSTAB; else MBSPEC (Box 33), and a name it
! finds is message 129, a note (p.178); still none is 56 (halt 156).
GFPD    SIC, GETCHZ
        B, GETCHA
        L(BU,64), GFBLNK
        ST(BU,64), GFKEY
        LI(BU,8), 0
        ST(BU,8), GFSNL
GFPD1   SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BZAL, GFPD2
        L(BU,8), GFSNL
        KI(BU,8), 8
        BZAL, GFPD3
        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFC+.16
        ST(BU,8), GFKEY($9)
GFPD3   M+1(BU,8), GFSNL
        SIC, GETCHZ
        B, GETCHA
        B, GFPD1
GFPD2   L(BU,8), GFSNL
        KI(BU,8), 0
        BAE, GFDOL
        KI(BU,8), 8
        BAH, GFNF
        SIC, GFBLK
        B, BOPSER
        L(BU,1), GFFND
        KI(BU,1), 1
        BAE, GFSYS
! MBSPEC (Chart BL, pp.92-93): a control indicator for each character of
! the pairs 0/O, 1/I, 2/Z, 5/S, stepped like a binary counter, the first
! character lowest; each step changes one character to its partner or back
        LI(BU,64), 0
        ST(BU,64), GFMF
        LI(BU,8), 0
        ST(BU,8), GFMK
        ST(BU,8), GFMI
GFMS1   L(BU,8), GFMI
        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFKEY($9)
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), MBPAIR($9)
        KI(BU,8), 0
        BAE, GFMS2
        L(BU,8), GFMK
        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFMI
        ST(BU,8), GFMPOS($9)
        M+1(BU,8), GFMK
GFMS2   M+1(BU,8), GFMI
        L(BU,8), GFMI
        KI(BU,8), 8
        BZAE, GFMS1
GFMB1   LI(BU,8), 0
        ST(BU,8), GFMJ
GFMB2   L(BU,8), GFMJ
        K(BU,8), GFMK
        BAE, GFNF
        ST(BU,8), STXC+.13
        LV, $9, STXC
        L(BU,8), GFMPOS($9)
        ST(BU,8), STXP+.13
        LV, $7, STXP
        L(BU,8), GFKEY($7)
        ST(BU,8), CHXT+.13
        LV, $8, CHXT
        L(BU,8), MBPAIR($8)
        ST(BU,8), GFKEY($7)
        L(BU,8), GFMF($9)
        KI(BU,8), 0
        BAE, GFMB3
        LI(BU,8), 0
        ST(BU,8), GFMF($9)
        M+1(BU,8), GFMJ
        B, GFMB2
GFMB3   LI(BU,8), 1
        ST(BU,8), GFMF($9)
        SIC, GFBLK
        B, BOPSER
        L(BU,1), GFFND
        KI(BU,1), 1
        BZAE, GFMB1
        M+1(BU,24), NOTEC
        LI(BU,24), 129
        ST(BU,24), NOTEL
! Boxes 22-24: prefix 11100, value, dds (Fig. 13)
GFSYS   SIC, GFZLK
        B, GFLZC
        LI(BU,5), (8)34
        ST(BU,5)(V+I), .5($2)
        L(BU,24), GFSVV
        ST(BU,24)(V+I), .24($2)
        L(BU,13), GFSVV+.24
        ST(BU,13)(V+I), .13($2)
        LI(BU,1), 0
        ST(BU,1), GFLKA
        B, GFPE
GFNF    LI(BU,24), 156
        B, ERROR
! Boxes 28-29, Fig. 14 p.76: $ alone is the symbol $ and two zero bytes,
! then an absolute zero, with .L and + put at once (p.24: "the coded $ is
! datum $00 ... and an absolute datum of 24 zeros, operator .L and plus").
! CHOSEN as strap2: the length field 3, where Fig. 14 shows 0.
GFDOL   SIC, GFZLK
        B, GFLZC
        LI(BU,10), (8)1003
        ST(BU,10)(V+I), .10($2)
        LI(BU,8), (8)53
        ST(BU,8)(V+I), .8($2)
        LI(BU,17), 0
        ST(BU,17)(V+I), .17($2)
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        LI(BU,24), 0
        ST(BU,24)(V+I), .24($2)
        M+1(BU,8), GFN
        M+1(BU,8), GFN
        LI(BU,3), 6
        ST(BU,3), GFOP+.56
        L(BU,8), GFN
        ST(BU,5), GFOP+.59
        SIC, GFELK
        B, GFPUT
        M-1(BU,8), GFN
        LI(BU,3), 1
        ST(BU,3), GFOP+.56
        L(BU,8), GFN
        ST(BU,5), GFOP+.59
        SIC, GFELK
        B, GFPUT
        LI(BU,1), 1
        ST(BU,1), GFLKA
        B, GFPE
!
! BOPSER (Box 32): GFKEY in SYSTAB by binary search; GFFND, GFSVV
BOPSER  LI(BU,8), 0
        ST(BU,8), GFLO
        ST(BU,1), GFFND
        L(BU,8), SYSTN+.56
        ST(BU,8), GFHI
BOP1    L(BU,8), GFLO
        K(BU,8), GFHI
        BZAL, BOPX
        L(BU,8), GFLO
        +(BU,8), GFHI
        ST(BU,9), GFMID
        L(BU,8), GFMID
        ST(BU,8), GFMDV
        ST(BU,8), STXB+.9
        LV, $9, SYSTBX
        V+, $9, STXB
        L(BU,64), GFKEY
        K(BU,64), 0($9)
        BAE, BOP3
        BAL, BOP2
        L(BU,8), GFMDV
        ST(BU,8), GFLO
        M+1(BU,8), GFLO
        B, BOP1
BOP2    L(BU,8), GFMDV
        ST(BU,8), GFHI
        B, BOP1
BOP3    L(BU,64), 1.0($9)
        ST(BU,64), GFSVV
        LI(BU,1), 1
        ST(BU,1), GFFND
BOPX    LV, $8, GFBLK
        B, 0($8)
!
! CPLTNM (Chart BD p.70, p.71).  $3 holds the first digit; the radix is
! GFSRAD.  PR := PR x radix + digit in floating point (Boxes 1-8), while
! the character is alphameric.  CHOSEN: while PR's fraction is zero, PR is
! the digit itself: a zero fraction's exponent grows by 48 at each normalized
! multiply, so after 007's second 0 the 7 was aligned away (found on the
! model); the guide's Box 6 draws only PR x radix + digit.  A digit not
! less than the radix is message
! 63 (p.71: still used; here a halt).  Box 9: PR aligned to exponent 48
! by an unnormalized add puts the integer at the low end of the fraction;
! CPLV gets its 24 bits (Fig. 12; over 24 bits: 168, as strap2).  The
! floating stores are written ST(U): a bare ST takes its mode from the
! symbol's dds, DD(BU,64) here, and stores as VFL (found on the model).
CPLTNM  L(BU,8), GFSRAD
        KI(BU,8), 0
        BZAE, CPN1
        LI(BU,8), 10
CPN1    ST(BU,8), CPRADF+.52
        L(N), CPZERO
        ST(U), CPPR
        LI(BU,24), 0
        ST(BU,24), CPDEC
CPN3    SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BZAL, CPN9
        K(BU,8), CPRADF+.52
        BAL, CPN6
        LI(BU,24), 163
        B, ERROR
CPN6    ST(BU,8), CPDIGF+.52
        ST(BU,8), CPDD+.16
        L(BU,24), CPDEC
        +(BU,24), CPDEC
        ST(BU,24), CPDE2
        +(BU,24), CPDE2
        ST(BU,24), CPDE4
        +(BU,24), CPDE4
        +(BU,24), CPDE2
        +(BU,24), CPDD
        ST(BU,24), CPDEC
        L(BU,48), CPPR+.12
        KI(BU,48), 0
        BZAE, CPN7
        L(N), CPDIGF
        B, CPN8
CPN7    L(N), CPPR
        *(N), CPRADF
        +(N), CPDIGF
CPN8    ST(U), CPPR
        SIC, GETCHZ
        B, GETCHA
        B, CPN3
CPN9    L(U), CPPR
        +(U), CPZ48
        ST(U), CPWRK
        L(BU,24), CPWRK+.12
        KI(BU,24), 0
        BAE, CPN10
        LI(BU,24), 168
        B, ERROR
CPN10   L(BU,24), CPWRK+.36
        ST(BU,24), CPLV
        LV, $8, CPLTNZ
        B, 0($8)
!
! CPLTSY (Chart BE p.72, pp.74-75), a programmer symbol: each alphameric
! character to BSYMBX (Boxes 2-9), at most 128 (Box 3, message 49).  A
! tail ($ after the symbol, Box 15) is not written yet.
CPLTSY  LI(BU,8), 0
        ST(BU,8), CPLEN
CPS2    L(BU,8), CPLEN
        KI(BU,8), 128
        BZAE, CPS3
        LI(BU,24), 149
        B, ERROR
CPS3    M+1(BU,8), CPLEN
        SV, $3, GFC
        L(BU,8), GFC+.16
        LV, $9, BSYMBX
        ST(BU,8)(V+I), .8($9)
        SV, $9, BSYMBX
        SIC, GETCHZ
        B, GETCHA
        SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BAL, CPS2
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BZAE, CPS9
        LI(BU,24), 9
        B, ERROR
CPS9    LV, $8, CPLTSZ
        B, 0($8)
!
! ======== STAND-INS FOR MCP (CHOSEN, docs/strap2_7030.md) ==============
!
! COMREC (pp.8-10): word 8, the input file; its code, bits 8.25-8.27, is 5,
! IQS.  Set here, standing for the pre-processor (p.8: "This word must
! always be set up by the pre-processor").  The other words wait for the
! disk.
        CNOP
COMREC  DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), (16)0000005000000000
        DRZ(BU,64), 16
!
! The input block: INX's value is the next card, its count the cards left;
! the cards follow INB, ten words each, in IQS.  A test sets the count and
! puts the cards, then its driver, after INB.
INX     XW, INB, 0, 0
INB     SYN, $
        END
