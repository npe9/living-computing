        LV, $7, STXP
        L(BU,8), GFKEY($7)
        ST(BU,8), CHXT+.13
        LV, $8, CHXT
        L(BU,8), MBPAIR($8)
        ST(BU,8), GFKEY($7)
        L(BU,8), GFMF($9)
        KI(BU,8), 0
        BAE, GFMB3
        LI(BU,8), 0
        ST(BU,8), GFMF($9)
        M+1(BU,8), GFMJ
        B, GFMB2
GFMB3   LI(BU,8), 1
        ST(BU,8), GFMF($9)
        SIC, $15
        B, BOPSER
        , SYSCB
        B, GFMB1
        M+1(BU,24), NOTEC
        LI(BU,24), 129
        ST(BU,24), NOTEL
! the found entry's value word, by LLXW
GFSVL   LV, $9, LLXW
        L(BU,64), 0($9)
        ST(BU,64), GFSVV
! Boxes 22-24: prefix 11100, value, dds (Fig. 13)
GFSYS   SIC, GFZLK
        B, GFLZC
        LI(BU,5), (8)34
        ST(BU,5)(V+I), .5($2)
        L(BU,24), GFSVV
        ST(BU,24)(V+I), .24($2)
        L(BU,13), GFSVV+.24
        ST(BU,13)(V+I), .13($2)
        LI(BU,1), 0
        ST(BU,1), GFLKA
        B, GFPE
GFNF    LI(BU,24), 156
        B, ERROR
! Boxes 28-29, Fig. 14 p.76: $ alone is the symbol $ and two zero bytes,
! then an absolute zero, with .L and + put at once (p.24: "the coded $ is
! datum $00 ... and an absolute datum of 24 zeros, operator .L and plus").
! CHOSEN as strap2: the length field 3, where Fig. 14 shows 0.
GFDOL   SIC, GFZLK
        B, GFLZC
        LI(BU,10), (8)1003
        ST(BU,10)(V+I), .10($2)
        LI(BU,8), (8)53
        ST(BU,8)(V+I), .8($2)
        LI(BU,17), 0
        ST(BU,17)(V+I), .17($2)
        LI(BU,3), 6
        ST(BU,3)(V+I), .3($2)
        LI(BU,24), 0
        ST(BU,24)(V+I), .24($2)
        M+1(BU,8), GFN
        M+1(BU,8), GFN
        LI(BU,3), 6
        ST(BU,3), GFOP+.56
        L(BU,8), GFN
        ST(BU,5), GFOP+.59
        SIC, GFELK
        B, GFPUT
        M-1(BU,8), GFN
        LI(BU,3), 1
        ST(BU,3), GFOP+.56
        L(BU,8), GFN
        ST(BU,5), GFOP+.59
        SIC, GFELK
        B, GFPUT
        LI(BU,1), 1
        ST(BU,1), GFLKA
        B, GFPE
!
! BOPSER (Charts BA, BB pp.65-66; p.67 and Figure 11), to
! strap/strap2/bopser.py:  SIC,$15; B,BOPSER; ,cb(I); B,not found; normal
! (found), with the found entry's function address in LLXW's value field.
! The control block (Figure 11) is an index word's shape: the test word's
! address, the entry length (count field), the number of entries (refill
! field); then N words of pairs, N = 18 - LZC of the number of entries
! (CHOSEN; p.67's ceiling(log2) misses an entry of a power-of-two table),
! N half words of increments then N of decrements (CHOSEN), and the table
! (CHOSEN).  $7 the increment list, $8 the entry tested, $9 the decrement
! list (Box 1).  The pairs are Knuth's uniform binary search deltas.
BOPSER  LVE, $8, 0($15)
        SV, $8, BPCB
        L(BU,18), .46($8)
        ST(BU,24), BPNE
        KI(BU,24), 0
        BAE, BPNF
        L(BU,18), .28($8)
        ST(BU,24), BPEL
! Box 3: N, the compares at most, 18 - LZC
        LI(BU,24), 0
        ST(BU,24), BPN
        LI(BU,24), 1
        ST(BU,24), BPP
BPN1    L(BU,24), BPP
        K(BU,24), BPNE
        BAH, BPN2
        M+1(BU,24), BPN
        L(BU,24), BPP
        +(BU,24), BPP
        ST(BU,24), BPP
        B, BPN1
! the lists and the table: cb + 64, cb + 64 + 32N, cb + 64(1 + N)
BPN2    L(BU,24), BPCB
        +(BU,24), BP64
        ST(BU,24), BPIB
        ST(BU,24), BPDB
        ST(BU,24), BPTB
        L(BU,24), BPN
        ST(BU,24), BPC
BPN3    L(BU,24), BPC
        KI(BU,24), 0
        BAE, BPN4
        L(BU,24), BPDB
        +(BU,24), BP32
        ST(BU,24), BPDB
        L(BU,24), BPTB
        +(BU,24), BP64
        ST(BU,24), BPTB
        M-1(BU,24), BPC
        B, BPN3
! Boxes 4-6: the pairs, unless BOPSER's indicator says they are made
BPN4    L(BU,1), .26($8)
        KI(BU,1), 1
        BAE, BPS
! LLNEW (Chart BB): the count, halved; an odd count increased by one,
! before the first halving it needs, after the others
        L(BU,24), BPNE
        ST(BU,24), BPC
        LI(BU,1), 1
        ST(BU,1), BPFST
        LI(BU,24), 0
        ST(BU,24), BPK
        L(BU,24), BPIB
        ST(BU,24), BPI
        L(BU,24), BPDB
        ST(BU,24), BPD
BPL1    L(BU,24), BPK
        K(BU,24), BPN
        BAE, BPL4
        L(BU,1), BPC+.23
        KI(BU,1), 1
        BZAE, BPL3
        L(BU,1), BPFST
        KI(BU,1), 1
        BZAE, BPL2
        LI(BU,1), 0
        ST(BU,1), BPFST
        M+1(BU,24), BPC
        SIC, BPZLK
        B, LLZERO
        B, BPL1
BPL2    SIC, BPZLK
        B, LLZERO
        M+1(BU,24), BPC
        B, BPL1
BPL3    SIC, BPZLK
        B, LLZERO
        B, BPL1
BPL4    LI(BU,1), 1
        ST(BU,1), .26($8)
! Box 7: the first entry tested, (table - length) + the first increment
BPS     LV, $9, 0($8)
        L(BU,64), 0($9)
        ST(BU,64), BPTST
        LV, $7, BPIB
        LV, $9, BPDB
        L(BU,24), BPTB
        -(BU,24), BPEL
        +(BU,24), 0($7)
        ST(BU,24), BPAT
        L(BU,24), BPN
        ST(BU,24), BPCNT
! Boxes 8-15
BPS1    LV, $8, BPAT
        L(BU,64), BPTST
        K(BU,64), 0($8)
        BAE, BPFD
        BAH, BPS2
        LI(BU,1), 1
        ST(BU,1), BPDIR
        B, BPS3
BPS2    LI(BU,1), 0
        ST(BU,1), BPDIR
BPS3    M-1(BU,24), BPCNT
        L(BU,24), BPCNT
        KI(BU,24), 0
        BAE, BPNF
        V+I, $7, 0.32
        V+I, $9, 0.32
        L(BU,1), BPDIR
        KI(BU,1), 1
        BAE, BPS4
        L(BU,24), BPAT
        +(BU,24), 0($7)
        ST(BU,24), BPAT
        B, BPS1
BPS4    L(BU,24), BPAT
        -(BU,24), 0($9)
        ST(BU,24), BPAT
        B, BPS1
! Boxes 16-17: found, the function's address in LLXW
BPFD    L(BU,24), BPAT
        +(BU,24), BP64
        ST(BU,24), LLXW
        B, 1.0($15)
BPNF    B, 0.32($15)
! LLZERO (Chart BB): halve the count; (half x entry length) as the next
! increment, its negative as the next decrement; step both lists
LLZERO  L(BU,23), BPC
        ST(BU,24), BPC
        LI(BU,24), 0
        ST(BU,24), BPPRD
        ST(BU,24), BPQ
BPZ1    L(BU,24), BPQ
        K(BU,24), BPC
        BAE, BPZ2
        L(BU,24), BPPRD
        +(BU,24), BPEL
        ST(BU,24), BPPRD
        M+1(BU,24), BPQ
        B, BPZ1
BPZ2    LV, $7, BPI
        LV, $9, BPD
        L(BU,24), BPPRD
        ST(BU,24), 0($7)
        ST(BU,24), 0($9)
        LI(BU,8), 0
        ST(BU,8), .24($7)
        LI(BU,8), 128
        ST(BU,8), .24($9)
        L(BU,24), BPI
        +(BU,24), BP32
        ST(BU,24), BPI
        L(BU,24), BPD
        +(BU,24), BP32
        ST(BU,24), BPD
        M+1(BU,24), BPK
        LV, $7, BPZLK
        B, 0($7)
!
! CPLTNM (Chart BD p.70, p.71).  $3 holds the first digit; the radix is
! GFSRAD.  PR := PR x radix + digit in floating point (Boxes 1-8), while
! the character is alphameric.  CHOSEN: while PR's fraction is zero, PR is
! the digit itself: a zero fraction's exponent grows by 48 at each normalized
! multiply, so after 007's second 0 the 7 was aligned away (found on the
! model); the guide's Box 6 draws only PR x radix + digit.  A digit not
! less than the radix is message
! 63 (p.71: still used; here a halt).  Box 9: PR aligned to exponent 48
! by an unnormalized add puts the integer at the low end of the fraction;
! CPLV gets its 24 bits (Fig. 12; over 24 bits: 168, as strap2).  The
! floating stores are written ST(U): a bare ST takes its mode from the
! symbol's dds, DD(BU,64) here, and stores as VFL (found on the model).
CPLTNM  L(BU,8), GFSRAD
        KI(BU,8), 0
        BZAE, CPN1
        LI(BU,8), 10
CPN1    ST(BU,8), CPRADF+.52
        L(N), CPZERO
        ST(U), CPPR
        LI(BU,24), 0
        ST(BU,24), CPDEC
CPN3    SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BZAL, CPN9
        K(BU,8), CPRADF+.52
        BAL, CPN6
! p.71, Boxes 3-8: "If the digit equals or exceeds the radix, an error
! message is executed, but the digit is still used in the computation of
! the numeric datum."  Message 63 (p.177), a note as MBSPEC's 129 is, once
! for each such digit (CHOSEN, as the loop is drawn); the digit reloaded.
        M+1(BU,24), NOTEC
        LI(BU,24), 63
        ST(BU,24), NOTEL
        L(BU,8), CHVAL($9)
CPN6    ST(BU,8), CPDIGF+.52
        ST(BU,8), CPDD+.16
        L(BU,24), CPDEC
        +(BU,24), CPDEC
        ST(BU,24), CPDE2
        +(BU,24), CPDE2
        ST(BU,24), CPDE4
        +(BU,24), CPDE4
        +(BU,24), CPDE2
        +(BU,24), CPDD
        ST(BU,24), CPDEC
        L(BU,48), CPPR+.12
        KI(BU,48), 0
        BZAE, CPN7
        L(N), CPDIGF
        B, CPN8
CPN7    L(N), CPPR
        *(N), CPRADF
        +(N), CPDIGF
CPN8    ST(U), CPPR
        SIC, GETCHZ
        B, GETCHA
        B, CPN3
CPN9    L(U), CPPR
        +(U), CPZ48
        ST(U), CPWRK
        L(BU,24), CPWRK+.12
        KI(BU,24), 0
        BAE, CPN10
        LI(BU,24), 168
        B, ERROR
CPN10   L(BU,24), CPWRK+.36
        ST(BU,24), CPLV
        LV, $8, CPLTNZ
        B, 0($8)
!
! CPLTSY (Chart BE p.72, pp.74-75), a programmer symbol: each alphameric
! character to BSYMBX (Boxes 2-9), at most 128 (Box 3, message 49).  A
! tail ($ after the symbol, Box 15) is not written yet.
CPLTSY  LI(BU,8), 0
        ST(BU,8), CPLEN
CPS2    L(BU,8), CPLEN
        KI(BU,8), 128
        BZAE, CPS3
        LI(BU,24), 149
        B, ERROR
CPS3    M+1(BU,8), CPLEN
        SV, $3, GFC
        L(BU,8), GFC+.16
        LV, $9, BSYMBX
        ST(BU,8)(V+I), .8($9)
        SV, $9, BSYMBX
        SIC, GETCHZ
        B, GETCHA
        SV, $3, GFC
        L(BU,8), GFC+.16
        ST(BU,8), CHXT+.13
        LV, $9, CHXT
        L(BU,8), CHVAL($9)
        KI(BU,8), 36
        BAL, CPS2
        L(BU,8), GFC+.16
        KI(BU,8), (8)53
        BZAE, CPS9
        LI(BU,24), 9
        B, ERROR
CPS9    LV, $8, CPLTSZ
        B, 0($8)
!
! ======== STAND-INS FOR MCP (CHOSEN, docs/strap2_7030.md) ==============
!
! COMREC (pp.8-10): word 8, the input file; its code, bits 8.25-8.27, is 5,
! IQS.  Set here, standing for the pre-processor (p.8: "This word must
! always be set up by the pre-processor").  The other words wait for the
! disk.
        CNOP
COMREC  DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), (16)0000005000000000
        DRZ(BU,64), 16
! ======== STEP 4b-i: MAIN, Boxes 2-24 (Chart AA p.14; text pp.19-22) ========
! Read in the ink 2026-11-15: Chart AA (p.14), AB (p.15), AC (p.16), and
! pp.19-23.  Entered SIC,MAINLK; B,MAIN, once per statement.  Returns to
! MAINLK with MSTAT:
!   0  a unit: Boxes 2-23 done, Box 24 found no modifier
!   1  the end of the input (GETCHA's FEOF at Box 5)
!   2  an illegal character (Box 6 at the start, Box 13 in the op): AA.9's
!      "enter coprocessor", not written
!   3  ( first: Box 11, the entry mode, not written
!   4  ' or ; or $ first: AB.17, AB.11 and the suppress character, not written
!   5  Box 18 not found: MIBA (Box 19) and MBSPEC (Box 22) are not written,
!      so the branch-on-indicator family and a misspelling end here; so does
!      a ninth op character (CHOSEN: p.21 collects "eight characters ... or
!      up to the next separator"; the host gives message 1)
!   6  Box 24 found Fmodif on: Boxes 25-26 are step 4b-ii
! Every status but 1 then collects the rest of the statement through its
! semicolon (Box 38 MEDAF, AC p.16), the stand-in for Boxes 27-37.
! REGISTERS (p.12, p.20, p.22): $3 the character (GETCHA), $5 the op index's
! location, $6 the unit's fixed format.  CHOSEN: $10 the next Bop position.
! CHOSEN: Box 2 takes $6 from IBUFFW as it stands (rounding to a full word
! and the coded expressions' start, Bcfldx and Bcfxtx, are step 4b-iii's);
! of the rest of Box 2 this zeros the fixed format (8 words), blanks Bop,
! turns Fmodif off and ZIFALL on.  ZICDID and the error fields are 4b-iv's.
! Box 23 (p.22, Fig. 23 p.192): the entry's second word is the skeleton
! with the op index's word address ORed into bits 0-17 (formats.md C2,
! C10).  ZIOPX takes those 18 bits, as a word address in bits 0-17 of its
! 25-bit field (CHOSEN); ZIOTPT the word with them cleared; $5's value
! field the op index's bit address.  An ambiguous op's word is its floating
! first half and VFL last half (p.22): the unit is the floating one until
! the dds or a secondary says otherwise (pp.22-23), which is 4b-ii.
MAIN    LV, $6, IBUFFW
! Box 2
        L(BU,64), MZERO
        ST(BU,64), 0.0($6)
        ST(BU,64), 1.0($6)
        ST(BU,64), 2.0($6)
        ST(BU,64), 3.0($6)
        ST(BU,64), 4.0($6)
        ST(BU,64), 5.0($6)
        ST(BU,64), 6.0($6)
        ST(BU,64), 7.0($6)
        L(BU,64), MBLANK
        ST(BU,64), BOP
        LI(BU,1), 0
        ST(BU,1), FMODIF
        LI(BU,1), 1
        ST(BU,1), 3.25($6)
        LI(BU,24), 0
        ST(BU,24), MSTAT
        ST(BU,24), MOPN
! Boxes 3-4 (p.20): GETCHA's Fblend (FEND here), "initially on", says the
! previous instruction ended a card block: Fblena on, Fblend off
        L(BU,1), FEND
        KI(BU,1), 1
        BZAE, MA5
        LI(BU,1), 1
        ST(BU,1), FBLENA
        LI(BU,1), 0
        ST(BU,1), FEND
! Box 5
MA5     SIC, GETCHZ
        B, GETCHA
        L(BU,1), FEOF
        KI(BU,1), 1
        BZAE, MA6
        LI(BU,24), 1
        ST(BU,24), MSTAT
        B, MAX
! Box 6: a legal op character goes to Box 12, by p.20's question
! character block, "addressed by the A8 character in the value field of $3"
MA6     BB, QCOP($3), MA12
        SV, $3, MTMP
        L(BU,8), MTMP+.16
! Box 10: ( is the entry mode, Box 11
        KI(BU,8), (8)34
        BZAE, MA8
        LI(BU,24), 3
        B, MAST
! Box 8: a comma, the null op, to the junction before Box 13 with Bop blank
MA8     KI(BU,8), (8)33
        BAE, MA17
        KI(BU,8), (8)14
        BAE, MA4
        KI(BU,8), (8)35
        BAE, MA4
        KI(BU,8), (8)53
        BAE, MA4
        LI(BU,24), 2
        B, MAST
MA4     LI(BU,24), 4
        B, MAST
! Box 12: collect the op characters into Bop
MA12    LVI, $10, BOP
MA12A   M+1(BU,24), MOPN
        L(BU,24), MOPN
        KI(BU,24), 9
        BAE, MA19
        SV, $3, MTMP
        L(BU,8), MTMP+.16
        ST(BU,8)(V+I), .8($10)
        SIC, GETCHZ
        B, GETCHA
        L(BU,1), FEOF
        KI(BU,1), 1
        BAE, MA17
        BB, QCOP($3), MA12A
! Box 13: , ; ' end the op; Box 14: ( sets Fmodif (Box 15); else illegal
        SV, $3, MTMP
        L(BU,8), MTMP+.16
        KI(BU,8), (8)33
        BAE, MA17
        KI(BU,8), (8)35
        BAE, MA17
        KI(BU,8), (8)14
        BAE, MA17
        KI(BU,8), (8)34
        BAE, MA15
        LI(BU,24), 2
        B, MAST
MA15    LI(BU,1), 1
        ST(BU,1), FMODIF
! Box 17: BOPSER on the primary op table
MA17    L(BU,64), BOP
        ST(BU,64), OPKEY
        SIC, $15
        B, BOPSER
        , OPCB
        B, MA19
! Box 23: the skeleton and the op index's location into the unit, and $5
        LV, $9, LLXW
        L(BU,64), 0.0($9)
        ST(BU,64), 6.0($6)
        L(BU,18), 0.0($9)
        ST(BU,18), 5.0($6)
        ST(BU,18), MLOC
        LI(BU,18), 0
        ST(BU,18), 6.0($6)
        LV, $5, MLOC
! Box 24
        L(BU,1), FMODIF
        KI(BU,1), 1
        BZAE, MA38
        LI(BU,24), 6
        B, MAST
! Boxes 19-22 stand-in: not found
MA19    LI(BU,24), 5
MAST    ST(BU,24), MSTAT
! Box 38 MEDAF: the rest of the statement, through its semicolon; a false
! one leaves GETCHA's Fblend on for the next Box 3 (p.20)
MA38    L(BU,1), FEOF
        KI(BU,1), 1
        BAE, MAX
        SV, $3, MTMP
        L(BU,8), MTMP+.16
        KI(BU,8), (8)35
        BAE, MAX
        SIC, GETCHZ
        B, GETCHA
        B, MA38
MAX     LV, $9, MAINLK
        B, 0($9)
!
! MAIN's cells.  BOP is p.21's Bop, eight A8 characters.  QCOP is a
! question character block (p.20: "a 256-bit question block in which the
! bit(s) corresponding to the character(s) indicated have been permanently
! masked on", named Qc...): the legal op characters.  CHOSEN: the
! characters of IBM's printed operation names, letters, digits, + - * /.
        CNOP
MAINLK  DD(BU,64), 0
IBUFFW  DD(BU,64), 0
MSTAT   DD(BU,64), 0
MOPN    DD(BU,64), 0
MTMP    DD(BU,64), 0
MLOC    DD(BU,64), 0
FMODIF  DD(BU,64), 0
FBLENA  DD(BU,64), 0
BOP     DD(BU,64), 0
MZERO   DD(BU,64), 0
MBLANK  DD(BU,64), (16)1010101010101010
QCOP    DD(BU,64), (16)7FE07FC0FFC8FFC0
        DD(BU,64), 0
        DD(BU,64), 0
        DD(BU,64), 0
