SYSTN   DD(BU,64), 193
! MBPAIR: MBSPEC's pairs (p.93 box 2: 0/O, 1/I, 2/Z, 5/S), the partner's
! A8 code for each A8 code, 0 for none.  Generated from optable.MBSPEC_PAIRS.
MBPAIR  SYN, $
        DD(BU,64), (16)0039190000120000
        DD(BU,64), (16)0000260000000000
        DD(BU,64), (16)0000050000000000
        DD(BU,64), (16)0002000000000000
        DD(BU,64), (16)0000000000000A00
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0000000000000000
        DD(BU,64), (16)0001000000000000
!
! ======== SECTION A1: Pass 1's constants and work areas (p.174) =======
GCEND   SYN, GCCARD+9.0
! LVI loads a half-word address (the bits below .32 are dropped;
! card_reader.strap), so an address with a bit part is loaded with LV from
! an index word:
KNAME   XW, GCCARD+.8, 0, 0
KSTMT   XW, GCCARD+1.8, 0, 0
GETCHZ  DD(BU,64), 0
GCOLK   DD(BU,64), 0
GCNLK   DD(BU,64), 0
GCPLK   DD(BU,64), 0
GCTMP   DD(BU,64), 0
NTMP    DD(BU,64), 0
FEND    DD(BU,64), 0
FEOF    DD(BU,64), 0
GCOPEN  DD(BU,64), 0
GCCOM   DD(BU,64), 0
GCCMC   DD(BU,64), 0
GCQ     DD(BU,64), 0
GCNC    DD(BU,64), 0
NAMEND  DD(BU,64), 0
NAMEL   DD(BU,64), 0
NAMET   DD(BU,64), 0
NAMEB   DRZ(BU,64), 8
GCCARD  DRZ(BU,64), 10
! GETFLD (p.83 LINKAGE): BCFLDX's value is the coded expression's first
! bit, a full word, and on exit its next bit; BCFXTX the first bit after the
! buffer (not tested yet); GFCHAR bit 0 on if $3 already holds the field's
! first character.  GFSRAD, the radix (p.70), zero means 10.
BCFLDX  XW, 0, 0, 0
BCFXTX  XW, 0, 0, 0
GFCHAR  DD(BU,64), 0
GFSRAD  DD(BU,64), 0
GETFLZ  DD(BU,64), 0
CPLTNZ  DD(BU,64), 0
CPLTSZ  DD(BU,64), 0
GFPLK   DD(BU,64), 0
GFELK   DD(BU,64), 0
GFSAV2  DD(BU,64), 0
GFC     DD(BU,64), 0
GFP0    DD(BU,64), 0
GFSN    DD(BU,64), 0
GFOPN   DD(BU,64), 0
GFNEW   DD(BU,64), 0
GFOP    DD(BU,64), 0
GFOPP   XW, GFOPS, 0, 0
CHXT    DD(BU,64), 0
STX     DD(BU,64), 0
STXD    DD(BU,64), 0
STXK    DD(BU,64), 0
STXF    DD(BU,64), 0
STXB    DD(BU,64), 0
STXC    DD(BU,64), 0
STXP    DD(BU,64), 0
GFKEY   DD(BU,64), 0
GFBLNK  DD(BU,64), (16)1010101010101010
GFSNL   DD(BU,64), 0
GFSVV   DD(BU,64), 0
GFFND   DD(BU,64), 0
GFLO    DD(BU,64), 0
GFHI    DD(BU,64), 0
GFMID   DD(BU,64), 0
GFMDV   DD(BU,64), 0
GFMF    DD(BU,64), 0
GFMPOS  DD(BU,64), 0
GFMK    DD(BU,64), 0
GFMI    DD(BU,64), 0
GFMJ    DD(BU,64), 0
GFBLK   DD(BU,64), 0
SYSTBX  XW, SYSTAB, 0, 0
GFIDP   DD(BU,64), 0
GFDEP   DD(BU,64), 0
GFCK    DD(BU,64), 0
! sub-slice d: a g.p. met (GFGP), its n and r (r 0: none, radix 10), an
! inner expression (GFINR: its null is not the field's), the expression's
! prefix address (GFXS), GFINI's link
GFGP    DD(BU,64), 0
GFGPN   DD(BU,64), 0
GFGPR   DD(BU,64), 0
GFINR   DD(BU,64), 0
GFXS    DD(BU,64), 0
GFGLK   DD(BU,64), 0
GFCN    DD(BU,64), 0
GFCI    DD(BU,64), 0
GFPARN  DD(BU,64), 0
GFCS    DD(BU,64), 0
GFCE    DD(BU,64), 0
GFCL    DD(BU,64), 0
GFCR    DD(BU,64), 0
GFT     DD(BU,64), 0
GFZLK   DD(BU,64), 0
GFCLK   DD(BU,64), 0
GFILK   DD(BU,64), 0
GFSLK   DD(BU,64), 0
! An expression's context, 16 words, saved in GFFRM at each '(' and
! restored at its ')' (CHOSEN layout; the chart's Box 2 "pushes the buffer
! one word"): data count, operator floor, unary and point flags, the first
! datum, the end bit held open (GFLAZ), the last datum absolute (GFLKA) and
! with S/X (GFSUB); the parenthesis' kind (0 a datum's start, 1 after a
! datum, 2 after a point) and items; $2; the slot; the item's start, its
! operators' start (pointer, count).
GFCTX   SYN, $
GFN     DD(BU,64), 0
GFFLR   DD(BU,64), 0
GFUN    DD(BU,64), 0
GFPT    DD(BU,64), 0
GFDOTL  DD(BU,64), 0
GFFRST  DD(BU,64), 0
GFLAZ   DD(BU,64), 0
GFLKA   DD(BU,64), 0
GFSUB   DD(BU,64), 0
GFKND   DD(BU,64), 0
GFNIT   DD(BU,64), 0
GFR2    DD(BU,64), 0
GFSLS   DD(BU,64), 0
GFIDS   DD(BU,64), 0
GFIOB   DD(BU,64), 0
GFIOBN  DD(BU,64), 0
GFCTXX  XW, GFCTX, 0, 0
GFFRMX  XW, GFFRM, 0, 0
GFITMX  XW, GFITM, 0, 0
GFSCRX  XW, GFSCR-32.0, 0, 0
! the operator stack, 16 bits an entry (precedence at .5, code at .8,
! datum number at .11), and the operators put, 9 bits each (p.198 3A-3C)
GFSTK   DRZ(BU,64), 8
GFOPS   DRZ(BU,64), 6
! GFFRM: a context for each depth, 8 x 16 words.  GFITM: each depth's
! items, 8 x 8 x 4 words: first data bit, the bit after, operators'
! pointer, then count (.0), data count (.8), lone absolute datum (.16),
! .n (.17).  GFSCR: each depth's scratch slot, 32 words, depth 1 first.
GFFRM   DRZ(BU,64), 128
GFITM   DRZ(BU,64), 256
GFSCR   DRZ(BU,64), 224
! CPLTNM: PR, the partial result, and the radix and a digit in floating
! point (Box 1, Box 3): exponent 48 (bits 1-10), the value at the low end
! of the fraction (bits 12-59; RefMan printed pp.78-79).  CPZ48, exponent 48
! and fraction 0, aligns PR to an integer (Box 9).
CPPR    DD(BU,64), 0
CPZERO  DD(BU,64), 0
CPRADF  DD(BU,64), (16)0600000000000000
CPDIGF  DD(BU,64), (16)0600000000000000
CPZ48   DD(BU,64), (16)0600000000000000
CPWRK   DD(BU,64), 0
CPLV    DD(BU,64), 0
! the digits as written, in decimal (a radix, a g.p.'s n and r): .0, 24 bits
CPDEC   DD(BU,64), 0
CPDE2   DD(BU,64), 0
CPDE4   DD(BU,64), 0
CPDD    DD(BU,64), 0
! CPLTSY: BSYMBX's value is where the symbol goes (p.74); CPLEN its length
BSYMBX  XW, 0, 0, 0
CPLEN   DD(BU,64), 0
!
! ======== SECTION 1: subroutines unique to Pass 1 (p.174) ==============
!
! XINPUT: the next card image, converted (p.77 boxes 4, 36).  COMREC word 8
! names the code (p.9); only 5, IQS, is written.  The input block is INX's:
! value the next card, count the cards left, ten words each.  The card goes
! to GCNEXT in A8; HAVEN is 1 if there was one.
XINPUT  L(BU,3), COMREC+8.25
        KI(BU,3), 5
        BAE, XIN0
        LI(BU,24), 1
        B, ERROR
XIN0    LI(BU,1), 0
        ST(BU,1), HAVEN
        LX, $13, INX
        KCI, $13, 0
        BXE, XIN9
        LVI, $7, GCNEXT
        LCI, $8, 80
XIN1    L(BU,8)(V+I), .8($13)
        ST(BU,8), XTMP+.13
        LV, $9, XTMP
        L(BU,8), IQSA8($9)
        ST(BU,8)(V+I), .8($7)
        CB, $8, XIN1
        LX, $13, INX
        C-I, $13, 1
        V+I, $13, 10.0
        SX, $13, INX
        LI(BU,1), 1
        ST(BU,1), HAVEN
XIN9    LV, $8, XINLK
        B, 0($8)
!
! GETCHA (Charts BG, BH pp.77-78; p.79).  One character to $3 per call.
! Blanks are skipped (Gcaz off; p.102's Gcaz, blanks significant, is not
! written yet).  At the end of a card block, the false semicolon with FEND
! on (p.79 item 5); at the end of the input, FEOF on (CHOSEN: MAIN stops at
! END; the driver stops here).  $14's value field is the next column of
! GCCARD.  GCCOM: a comment from columns 1-9 of the initial card (no name,
! nothing more to MAIN); GCCMC: a comment from columns 2-9 of a continuation
! card (the name goes on, nothing more to MAIN).
GETCHA  LI(BU,1), 0
        ST(BU,1), FEND
        L(BU,1), GCOPEN
        KI(BU,1), 1
        BAE, GC10
! no card block open: open the next one (box 3: GETCHA's initial entry)
        L(BU,1), HAVEN
        KI(BU,1), 1
        BAE, GC2
        LI(BU,1), 1
        ST(BU,1), FEOF
        B, GCX
GC2     SIC, GCOLK
        B, GCOPN
        LI(BU,1), 1
        ST(BU,1), GCOPEN
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        ST(BU,1), GCCOM
        ST(BU,1), GCCMC
        ST(BU,1), NAMEND
! column 1 (box 10): the comment character makes the card block a comment
        L(BU,8), GCCARD
        KI(BU,8), (8)14
        BAE, GC5
! columns 2-9 (boxes 14-16): a comment character there makes the block a
! comment (p.79); otherwise they are the name
        LV, $7, KNAME
        LCI, $8, 8
GC3     L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC5
        CB, $8, GC3
        LI(BU,18), 8
        ST(BU,18), GCNC
        SIC, GCNLK
        B, GCNAME
! CHOSEN, as strap2's Getcha: the initial card's name loses its trailing
! blanks before a continuation card adds to it (p.79 does not say)
        L(BU,18), NAMET
        ST(BU,18), NAMEL
        LV, $14, KSTMT
        B, GC10
GC5     LI(BU,1), 1
        ST(BU,1), GCCOM
        LI(BU,18), 0
        ST(BU,18), NAMEL
        ST(BU,18), NAMET
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
! the statement field, columns 10-72 (box 22)
GC10    KVI, $14, GCEND
        BXL, GC20
! the end of the statement field (box 32): a continuation card (box 37)?
        L(BU,1), HAVEN
        KI(BU,1), 1
        BZAE, GC15
        L(BU,8), GCNEXT
        KI(BU,8), (8)54
        BZAE, GC15
        SIC, GCOLK
        B, GCOPN
! a comment block from the initial card: nothing of it to MAIN (p.79:
! "without giving them out to main flow through $3")
        L(BU,1), GCCOM
        KI(BU,1), 1
        BAE, GC14
! columns 2-9: a comment character there (p.79) ends the name part of the
! card; GCNC counts the columns before it
        LV, $7, KNAME
        LCI, $8, 8
        LI(BU,18), 0
        ST(BU,18), GCNC
        ST(BU,1), GCQ
GC16    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)14
        BAE, GC17
        M+1(BU,18), GCNC
        CB, $8, GC16
        B, GC18
GC17    LI(BU,1), 1
        ST(BU,1), GCQ
! the name part continues the name (p.79), until one is blank
GC18    L(BU,1), NAMEND
        KI(BU,1), 1
        BAE, GC19
        L(BU,18), GCNC
        KI(BU,18), 0
        BAE, GC1E
        LV, $7, KNAME
        LC, $8, GCNC
GC1A    L(BU,8)(V+I), .8($7)
        KI(BU,8), (8)20
        BZAE, GC1B
        CB, $8, GC1A
GC1E    LI(BU,1), 1
        ST(BU,1), NAMEND
        B, GC19
GC1B    SIC, GCNLK
        B, GCNAME
! after a comment from a continuation card, its later statement fields are
! comment too (p.79)
GC19    L(BU,1), GCCMC
        KI(BU,1), 1
        BAE, GC14
        L(BU,1), GCQ
        KI(BU,1), 1
        BZAE, GC12
! p.79: "A comment character appearing in columns 2-9 of a continuation card
! causes the remaining characters on the card to be treated as a comment";
! MAIN gets the comment character "in $3 as usual"
        LI(BU,1), 1
        ST(BU,1), GCCMC
        LVI, $14, GCEND
        LI(BU,8), (8)14
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC12    LV, $14, KSTMT
        B, GC10
GC14    LVI, $14, GCEND
        B, GC10
! the end of the card block (box 38): the false semicolon
GC15    LI(BU,1), 1
        ST(BU,1), FEND
        LI(BU,1), 0
        ST(BU,1), GCOPEN
        LI(BU,8), (8)35
        SIC, GCPLK
        B, GCPUT
        B, GCX
GC20    L(BU,8)(V+I), .8($14)
        KI(BU,8), (8)20
        BAE, GC10
        SIC, GCPLK
        B, GCPUT
GCX     LV, $8, GETCHZ
        B, 0($8)
!
! GCPUT: the accumulator's byte to $3's value field
GCPUT   ST(BU,8), GCTMP+.16
        LV, $3, GCTMP
        LV, $8, GCPLK
        B, 0($8)
!
! GCOPN: GCNEXT becomes GCCARD, and XINPUT reads the next
GCOPN   LVI, $7, GCNEXT
        LVI, $9, GCCARD
        LCI, $8, 10
GCO1    L(BU,64)(V+I), 1.0($7)
        ST(BU,64)(V+I), 1.0($9)
        CB, $8, GCO1
        SIC, XINLK
        B, XINPUT
        LV, $8, GCOLK
        B, 0($8)
!
! GCNAME: GCNC (at least 1) columns from column 2 of GCCARD to the name
! buffer (box 20); NAMET is the length to the last character that is not
! blank (strap2: rstrip)
GCNAME  LV, $7, KNAME
        LC, $8, GCNC
GCN1    L(BU,18), NAMEL
        KI(BU,18), 64
        BZAE, GCN2
        LI(BU,24), 2
        B, ERROR
GCN2    ST(BU,18), NTMP+.3
        LV, $9, NTMP
        L(BU,8)(V+I), .8($7)
        ST(BU,8), NAMEB($9)
        M+1(BU,18), NAMEL
        KI(BU,8), (8)20
        BAE, GCN3
        L(BU,18), NAMEL
        ST(BU,18), NAMET
GCN3    CB, $8, GCN1
        LV, $8, GCNLK
        B, 0($8)
!
! GETFLD (Charts BI-BK pp.80-82, text pp.83-86): one field's coded
! expression (Appendix C p.198) at BCFLDX.  Call SIC,GETFLZ; B,GETFLD (p.83).
! The data go in as they are read; each operator waits on GFSTK until one
! of no higher priority comes (p.198: .+ .L .R U- * / + -), and is put,
! with its datum number, in GFOPS; GFZA puts them after the data (Boxes 43,
! 60).  Sub-slice b: parentheses, built in a scratch slot per depth and
! placed at the ')' (docs/strap2_7030.md, CHOSEN).  Sub-slice c: $ and the
! system symbols.  Not yet: g.p. and radix (sub-slice d).
GETFLD  SX, $2, GFSAV2
        LV, $2, BCFLDX
        LI(BU,8), 0
        ST(BU,8), GFSN
        ST(BU,8), GFSRAD
        ST(BU,8), GFDEP
        LI(BU,1), 0
        ST(BU,1), GFINR
        SIC, GFGLK
        B, GFINI
! Boxes 3-4: the first character, unless the user has it (Gfchar)
        L(BU,1), GFCHAR
        KI(BU,1), 1
        BAE, GF1
        SIC, GETCHZ
        B, GETCHA
! Boxes 31, 34-35: nothing before the end of the field, the null prefix
GF1     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)33
        BAE, GFNULL
        KI(BU,8), (8)35
        BAE, GFNULL
        KI(BU,8), (8)14
        BAE, GFNULL
        KI(BU,8), (8)74
        BAE, GFNULL
! the prefix: 1A, and 1B type 000 (p.198)
        SV, $2, GFXS
        LI(BU,4), 8
        ST(BU,4)(V+I), .4($2)
! a datum is expected (S-codes B, O, p.83): a leading plus does nothing; a
! minus is unary, once (U-); a point with no datum before it waits as .R.
! A point is an operator of the top priority (p.198), so it waits on GFSTK
! like the others, and the datum after it is put first.
GFE     SV, $3, GFC
        L(BU,8), GFC+.16
        KI(BU,8), (8)60
        BZAE, GFE1
        L(BU,1), GFFRST
        KI(BU,1), 1
        BZAE, GFSYN
        LI(BU,1), 0
        ST(BU,1), GFFRST
        SIC, GETCHZ
        B, GETCHA
        B, GFE
GFE1    LI(BU,1), 0
        ST(BU,1), GFFRST
        L(BU,8), GFC+.16
        KI(BU,8), (8)40
        BZAE, GFE2
        L(BU,1), GFUN
        KI(BU,1), 1
        BAE, GFSYN
        LI(BU,1), 1
        ST(BU,1), GFUN
        LI(BU,3), 3
        ST(BU,3), GFNEW+.53
