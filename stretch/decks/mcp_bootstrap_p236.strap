VTDQ    SYN,VTQ.VH                                           ! line 23  -0981
        CNOP,                                                ! line 24  -0982
        B,VREOP                                              ! line 25
        B,VRDEE                                              ! line 26  -0984
VCRK    SYN,2                                                ! line 27  -0985
VCR     VF,-34.                                              ! line 28  -0986
        VF,0                                                 ! line 29  -0987
        XW,VRD2,VCRK,VRDX2K                                  ! line 30  -CR2S  -0988
        XW,VRD2,VCRK,VRDX2K                                  ! line 31  -CR2R  -0989
        CW(CD),VBF1,0,$                                      ! line 32  -0990
VRDCW   CW,0                                                 ! line 33  -CWR  -0991
        B,VSQ                                                ! line 34  -0992
        B,VRDIO                                              ! line 35  -0993  (printed "V RDIC")
        ,VCRD                                                ! line 36  -0994
VRDX2K  XW,VRD2,VCRK,VRDX2K                                  ! line 37  -0995
VRD2    BE,34.                                               ! line 38
        DRZ(BU,32),VCRK-1                                    ! line 39  -0996
VTXT    XW,VBF1,34,VTXK                                      ! line 40  -0998
        XW,0                                                 ! line 41  -0999
        VF,0                                                 ! line 42
        VF,0                                                 ! line 43  -1000
VTX     XW,VBF1,34,VTXK                                      ! line 44  -1001
VTX1    XW,0                                                 ! line 45  -1002
VSCK    SYN,6                                                ! line 46  -1003
VSC     VF,0                                                 ! line 47  -1004
        VF,0                                                 ! line 48  -1005
        XW,VSC2Q,VSCK,VSX2K                                  ! line 49  -SC2S  -1006
        XW,VSC2Q,VSCK,VSX2K                                  ! line 50  -SC2R  -1007
        XW,0                                                 ! line 51  -1008
        XW,0                                                 ! line 52  -1009
        B,VEQ                                                ! line 53  -1010
VTXK    XW,VBF1,34,VTXK                                      ! line 54  -1011
VSX2K   XW,VSC2Q,VSCK,VSX2K                                  ! line 55  -1012
