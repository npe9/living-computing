VSQ     SYN(BU,32,8), (8)224314.0    ! landed p.218 label (LVI, half word); B line 34
VRDIO   SYN(BU,32,8), (8)224235.40   ! landed p.216 label (SIC, half word); B line 35 .50
VCRD    SYN, (8)5.0                  ! landed; p.100 card "- VCRD SYN,5."; line 36 000005.00
VEQ     SYN(BU,32,8), (8)224451.40   ! landed p.222 label (LVI, half word); B line 53 .50

        SLC, (8)225216.0
        VF,0                                                 ! line  1  (printed "VF,C")
        VF,0                                                 ! line  2  -0964
