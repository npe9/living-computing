! (line 13 prints the second field of line 12: 225224.01, 0)
        VF,VST                                               ! line 14  -0972*
VTSB2K  XW,VTSB2,VTSBK,VTSB2K                                ! line 15  -0973
        B,VTSAQ                                              ! line 16  -0974
        B,VTA                                                ! line 17  -0975
VTSB2   DRZ(BU,32),VTSBK                                     ! line 18
VOP     SYN(BU,1),3.                                         ! line 19  -0977  (printed "V CP")
