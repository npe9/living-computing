!CHECK 220245.40 | 000000.32 8A 220320.74 02 | line  4 Z FREE BB,S CH OP($10),K K MARK -- the 8A is index $10, the 02 is BB
!CHECK 220246.40 | 220243.40 80 | line  5 Z Z FREE SIC,Z TB RW.32 -- the .40 is the ".32" decimal bit offset printed octal
!CHECK 220247.00 | 220234.50 00 | line  6 B,Z COM RT -- a B adds 0o10, so the target word is 220234.40
!CHECK 220247.40 | 000000.35 8B 001000.36 F0 | line  7 CM1111(BU,1),S UN ASG($11) -- .35 is S UN ASG's 0.29; printed "FC" on line 25 is the same literal and p.18 prints it F0 six times
!CHECK 220250.40 | 215001.06 80 220300.34 02 | line  8 BB,S P INCL,Z F2 -- 215001.06 is SCOMRG+.6 exactly
!CHECK 220251.40 | 000002.36 8D 220301.74 02 | line  9 BB,2.30($13),Z F SAVE -- .36 is bit 30, D is index $13
!CHECK 220252.40 | 000010.60 3C | line 10 LV,8,S C REEL($12) -- .60 is S C REEL's .32 plus LV,8's 0o20; C is index $12
!CHECK 220253.00 | 000000.32 8B 002000.00 F0 | line 11 ZFFLIP CM0000(BU,2),STATI($11) -- printed "0C2000.CC"; both C runs are in octal fields
!CHECK 220254.00 | 000000.33 88 220256.34 00 | line 12 BZB,TRELB($8),ZFRENS -- byte 00 spells BZB (BB 02, BZBZ 04, BB1 0E)
!CHECK 220255.00 | 000000.32 88 220227.34 00 | line 13 BZB,.26($8),ZREWST+1.0 -- the statement's decimal .26 prints octal .32, which is the page's own calibration of that rule
!CHECK 220256.00 | 220313.00 80 220311.04 A0 | line 14 Z FRE NS TI,2,K N SAVE,Z FRO3
!CHECK 220257.00 | 220306.05 01 | line 15 K DFREE LVI,2,Z FRO4 -- .05 is Z FRO4's .00 plus LVI,2's 2N+1 = 5
!CHECK 220257.40 | 220303.13 01 | line 16 LVI,5,K FRE M -- .13 = 11 = 2*5+1; "K FRE M" is "K FREM", blanks are not significant in a STRAP name
!CHECK 220260.00 | 000000.40 8B 220262.34 00 | line 17 BZB,SOWNER($11),ZFRO5B
!CHECK 220261.00 | 022133.31 80 220267.34 04 | line 18 BZBZ,TMFREJ,ZFRO5 -- byte 04 spells BZBZ; the target is line 27's ZFRO5
!CHECK 220262.00 | 220310.17 01 | line 19 Z FRO5B LVI,7,ZFRO2 -- .17 = 15 = 2*7+1
!CHECK 220262.40 | 000000.40 8B 220272.34 02 | line 20 BB,SOWNER($11),ZFRO5 -- >>> THE OPERAND IS PRINTED "ZFRO5" and is written ZFRO5DUP; its target is line 30, NOT line 18's line 27
!CHECK 220263.40 | 220310.17 01 | line 21 LVI,7,Z FRO2 -- the same word as line 19 from a differently spaced name
!CHECK 220264.00 | 221045.00 80 | line 22 SIC,Z ID09X
!CHECK 220264.40 | 221042.10 00 | line 23 B,Z ID09 -- same card as line 22
!CHECK 220265.00 | 000010.17 01 | line 24 ZFRO6 LVI,7,8. -- 0o10 is the value 8, .17 the index
!CHECK 220265.40 | 000000.33 8B 001000.36 F0 | line 25 CM1111(BU,1),SDISPO($11) -- the byte is printed "FC" and is F0: line 7 is the SAME literal in the SAME character position on this page, and printed p.18 prints it six times
!CHECK 220266.40 | 221752.50 00 | line 26 B,K UNLD1+1.32 -- target 221752.40, which is K UNLD1's own $+1.32
!CHECK 220267.00 | 000000.77 8B 220271.34 00 | line 27 ZFRO5 BZB,SOVRES($11),ZFRO5A -- .77 is S OV RES's 0.63
!CHECK 220270.00 | 000000.76 8B 220274.74 02 | line 28 BB,SUNRES($11),ZFRO7 -- .76 is S UN RES's 0.62, one bit below line 27's
!CHECK 220271.00 | 222013.20 80 000000.20 50 | line 29 ZFRO5A L(BU,64),KSCRAC.16 -- .20 is the statement's decimal 16
!CHECK 220272.00 | 000000.77 8B 220274.74 02 | line 30 >>> PRINTED "ZFRO5", written ZFRO5DUP; identical bits to line 28 but for S OV RES vs S UN RES
!CHECK 220273.00 | 220310.00 80 000000.20 D0 | line 31 ST(BU,64),ZFRO2
!CHECK 220274.00 | 220265.10 00 | line 32 B,ZFRO6
!CHECK 220274.40 | 220317.00 80 220310.02 A0 | line 33 ZFRO7 TI,1,ZFR17,ZFRO2
!CHECK 220275.40 | 220320.00 80 010000.20 50 | line 34 L(BU,8),ZFR17+1.0 -- 220320.00 is Z FR17 plus one word
!CHECK 220276.40 | 220311.00 80 010000.20 D0 | line 35 ST(BU,8),ZFRO3
!CHECK 220277.40 | 220265.10 00 | line 36 B,ZFRO6 -- the same word as line 32
!CHECK 220300.00 | 000002.37 8D 220301.74 02 | line 37 Z F 2 BB,2.31($13),Z F SAVE -- .37 is bit 31, one above line 9's .36
!CHECK 220301.00 | 220252.50 00 | line 38 B,ZFFLIP-.32 -- target 220252.40, a half word below Z FFLIP
!CHECK 220301.40 | 220315.00 80 220311.04 A0 | line 39 Z FSAVE TI,2,KSAVE,Z FRO3 -- the same operation as line 14 with K SAVE for K N SAVE
!CHECK 220302.40 | 220257.10 00 | line 40 B,K D FREE -- target 220257.00, line 15
!CHECK 220320.40 | 000000.45 0D | line 50 K K MARK V-I,2,.32 -- printed "OD"; the leading round is in a position every other row on this page prints 0
!CHECK 220321.00 | 215265.05 30 | line 51 SV,2,S TIC -- .05 = 2*2+1 on S TIC's .00
!CHECK 220321.40 | 000000.47 8B 220374.34 02 | line 52 BB,S SEL($11),K E LOOP -- .47 is S SEL's 0.39
!CHECK 220322.40 | 220246.41 01 | line 53 LVI,0,Z Z FREE -- .41 is Z Z FREE's own bit 32 plus LVI,0's 1
!CHECK 220323.00 | 000000.37 8B 220374.34 0E | line 54 BB1,S SET UP($11),K E LOOP -- byte 0E spells BB1 against line 52's BB 02; .37 is S SET UP's 0.31
!CHECK 220324.00 | 000005.01 3C | line 55 SV,0,S RET AD($12) -- word 5 is S RET AD's own, .01 is SV,0's 1, C is index $12
!CHECK 220324.40 | 216242.10 00 | line 56 B,K SUPP -- the last word of the page; the counter leaves at 220325.00
! -- line 41 (CNOP) compiles nothing and carries no check; line 46's
! -- DRZ prints its COUNT 000002.00, which no !CHECK can compare
! -- against storage, exactly as every landed deck with a DR/DRZ does.
