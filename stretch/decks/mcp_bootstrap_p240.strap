!CHECK 227502.40 | 000000.42 3D | line 20 LV,1,.32($13)
!CHECK 227503.00 | 225266.03 04 | line 21 KVI,$1,VWT
!CHECK 227503.40 | 230355.32 C0 | line 22 BZXE,RKSCON
!CHECK 227504.00 | 000005.40 8D | line 23 SIC,5.32($13)
!CHECK 227504.40 | 227512.10 00 | line 24 B,R UNLC1
!CHECK 227505.00 | 224757.43 01 | line 25 LVI,$1,VTDSP
!CHECK 227505.40 | 227524.32 30 | line 26 LV,13,R UNLD2
!CHECK 227506.00 | 000005.43 DD | line 27 SVA,1,5.32($13) (byte prints CD, worn D)
!CHECK 227506.40 | 000000.46 3D | line 28 LV,V U,.32($13)
!CHECK 227507.00 | 000040.10 00 | line 29 B,D MCP
!CHECK 227507.40 | 000001.40 80 | line 30 ,D W
!CHECK 227510.00 | 000006.01 B3 | line 31 LVE,,V SL(V U)
!CHECK 227510.40 | 225272.00 80 | line 32 ,V WCW
!CHECK 227511.00 | 000040.10 00 | line 33 B,D MCP
!CHECK 227511.40 | 000041.00 80 | line 34 ,D RET
!CHECK 227512.00 | 000001.02 3D | line 35 R UNLD1 LV,1,1.($13)
!CHECK 227512.40 | 000040.10 00 | line 36 B,D MCP
!CHECK 227513.00 | 000043.40 80 | line 37 ,D CCMM
!CHECK 227513.40 | 227517.00+ | line 38 VF,RUNM
!CHECK 227514.00 | 000005 | line 39 CF,5
!CHECK 227514.40 | 000040.10 00 | line 40 B,D MCP
!CHECK 227515.00 | 000010.40 80 | line 41 ,D UNLC (a "*" after the location)
!CHECK 227515.40 | 000000.00 81 | line 42 ,0($1)
!CHECK 227516.00 | 000040.10 00 | line 43 B,D MCP
!CHECK 227516.40 | 000041.00 80 | line 44 ,D RET
!CHECK 227524.00 | 000000.00+ | line 47 R UNLD2 VF,0
