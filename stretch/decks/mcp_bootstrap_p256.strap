RWEXIT  SYN(BU,32), (8)227646.0      ! landed p.244 "RWEXIT DRZ(BU,32),4"; KVI line 43, LV line 46
RPRTEX  SYN(BU,32), (8)230220.0      ! p.251 line 53 DRZ(BU,32),4 at 230220.00 (scratch, not landed); lines 42, 45, 51, 52
RKNEG   SYN(BU,32,8), (8)230235.0    ! p.253 label (LVNI, volume OCR; not landed); B line 13 230235.10, half word only
RKS111  SYN, (8)230240.40            ! p.253 label (not landed); B line 18 230240.50, this page's binary only
