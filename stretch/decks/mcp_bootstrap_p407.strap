! mcp_bootstrap_p407.strap -- MCP printed page 407: END OF JOB ($EOJ),
! the machine-configuration-change unit scan (T 9M .. T B9B), the
! save of the unit count index, and the opening of the unit-count
! table sort (T D9A .. BZAH,T D9C), lines 1-50.
!
! docs/MCP_Mar63_250-445.pdf PDF p.157, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZE000461  DIST. OF 3/01
!  3/01  PAGE NUMBER 407".  The heading row's LOCATION field is 021530,
! line 1's word.  Still $EOJ (PUNID 22$EOJ), low core, card series ZE.
!
! THE PAGE.  Contiguous from 021530.40 to 021571.00 (line 50, a half
! word), then blank paper.  Card serials ZE000461..ZE000510, one per
! line, no gap.  Lines 34-36 and 42-45 are remark cards.
!   This is the $EOJ reassembly of the same source as printed p.72
! (decks/mcp_bootstrap_p72.strap lines 19-51), lines 1-33 here = p.72
! lines 19-51 card for card.
!
! LISTING MARKS: lines 12 and 27 print a "*" after the LOCATION.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   line 39 prints "TRCHSC+C.24": the open round is 0 (the octal fields
!     of the same row print 0 open); TRCHSC+0.24 assembles the printed
!     232521.30.  Line 37's "C.32" likewise 0.32.
!   line 15 prints "CTOC11(BU,2)": the connective CT0011, as p.72 line 33.
!   lines 46-50 "T D9A", "TD9B", "TD9", "TD9C": D read at 400 dpi (a
!     straight-backed round, not the open C); p.72/p.74 spell the same
!     family TD9, TD9C, and the BXCZ/BZAH binaries tie TD9/TD9C.
!
! STAND-INS.
!   Resident (body) symbols, copied in the DEFINING form of the landed
!   page: TX1/TX3/TX1BR/TIXF/TIXG/TIXH (p.287), the T.. field SYNs
!   (p.289, p.291), TDISK/TFCHSC/TRCHSC/TCHCUC (p.290), SXCHAN/SYCOCH/
!   SYPRCH (p.103).
!   $EOJ symbols defined on pages not yet landed, from THIS page's
!   binary: TCOMBO, T2COMB (VFs per p.63's source; BIT-EXACT from the
!   * and - rows), TA9D, TM (BB/BZB, half word only), TA10 (BZRZ, half
!   word only), TA9A (CB+, half word only), TD9 (BXCZ), TD9C (BZAH).

TX1     SYN,$10                      ! landed p.287 line 30
TX3     SYN,$2                       ! landed p.287 line 33
TX1BR   SYN,$1                       ! landed p.287 line 32
TIXF    SYN,TX1                      ! landed p.287 line 37
TIXG    SYN,$8                       ! landed p.287 line 38
TIXH    SYN,TX3                      ! landed p.287 line 39
TMULTI  SYN(BU,1),0.27               ! landed p.289 line 7
TCHAVL  SYN(BU,1),0.25               ! landed p.289 line 8
TUNAVL  SYN(BU,1),0.28               ! landed p.289 line 10
TUNASG  SYN(BU,1),0.29               ! landed p.289 line 11
TCHOWN  SYN(BU,1),0.32               ! landed p.289 line 12
TEQUIP  SYN(BU,4),0.52               ! landed p.289 line 15
TUNITK  SYN(BU,4),0.59               ! landed p.289 line 16
TUNRES  SYN(BU,1),0.62               ! landed p.289 line 17
TCHCNT  SYN(BU,4),0.20               ! landed p.291 line 7
TDISK   SYN(BU,8), (8)232513.0       ! landed p.290 line 6 (8)DD(BU,8)
TFCHSC  SYN(BU), (8)232520.0         ! landed p.290 line 37 XW
TRCHSC  SYN(BU), (8)232521.0         ! landed p.290 line 38 XW
TCHCUC  SYN(BU,32), (8)232522.0      ! landed p.290 line 39 DRZ(BU,32)
SXCHAN  SYN(BU), (8)215002.0         ! landed p.103 line 28 "SXCHAN XW,0"
SYCOCH  SYN(B,25,1), (8)215006.0     ! landed p.103 line 37 VF
SYPRCH  SYN(B,25,1), (8)215006.40    ! landed p.103 line 38 VF
TCOMBO  SYN(B,25,1), (8)021163.0     ! $EOJ VF (p.63 source); * line 1, BIT-EXACT
T2COMB  SYN(B,25,1), (8)021163.40    ! $EOJ VF (p.63 source); - line 2, BIT-EXACT
TA9D    SYN, (8)021576.40            ! $EOJ; BB line 9, half word only
TM      SYN, (8)021724.40            ! $EOJ; BZB line 13, half word only
TA10    SYN, (8)021622.0             ! $EOJ; BZRZ line 16, half word only
TA9A    SYN, (8)021526.0             ! $EOJ; CB+ line 33, half word only
TD9     SYN, (8)021575.40            ! $EOJ; BXCZ line 47, half word only
TD9C    SYN, (8)021573.40            ! $EOJ; BZAH line 50, half word only

        SLC, (8)021530.40
        *(BU,24),TCOMBO,40                                   ! line  1  -COMPUTE LOC WITHIN TABLE
        -(BU,24),T2COMB,20                                   ! line  2
        L(BU,64),$R,20                                       ! line  3  -LEFT SHIFT TO VF
        LV,TIXG,$R                                           ! line  4
        LI(BU,1),1                                           ! line  5  -AT LEAST GIVE A COUNT OF ONE
        BZB,TEQUIP(TIXF),T9M                                 ! line  6  -IF A NON TAPE CHAN
        L,TUNITK(TIXF)                                       ! line  7  -GET COUNT FOR MULTI CHAN
T9M     M+,TDISK(TIXG)                                       ! line  8  -ADD CONFIGURATION TO TABLE
        BB,TMULTI(TIXF),TA9D                                 ! line  9  -IF A MULTI CHANNEL
        BB,TCHAVL(TIXF),TA9B                                 ! line 10  -IF CHANNEL NOT AVAILABLE
        BB,TCHOWN(TIXF),TA9BA                                ! line 11  -IF MCP LEVEL IT IS NOT AVAIL TO PP
        BZB,TUNAVL(TIXF),TB9                                 ! line 12  -IF UNIT IS AVAILABLE
TA9B    BZB,TUNASG(TIXF),TM                                  ! line 13  -IF THE UNIT IS ASSIGNED
TA9BA   LVI,TX1BR,TB9                                        ! line 14  -LOAD FOR SUB ROUTINE BRANCH
        CT0011(BU,2),TUNRES(TIXF)                            ! line 15  -IS UNIT RESERVED BY PP
        BZRZ,TA10                                            ! line 16  -YES
TB9     LF,TEQUIP(TIXF)                                      ! line 17
        KFI(BU,4),2                                          ! line 18  -LOOK FOR CONSOLE
        BZAE,TB9A                                            ! line 19  -NO
        LV,TIXG,TIXF                                         ! line 20
        CM1111(BU,1),TIXG+.24                                ! line 21  -SET IX NEG SO TO SUB
        V+,TIXG,SXCHAN                                       ! line 22  -COMPUTE CONSOLE CHANNEL
        SV,TIXG,$R                                           ! line 23
        SF(BU,17),SYCOCH+.2,46                               ! line 24
        B,TB9B                                               ! line 25
TB9A    KFI(BU,4),5                                          ! line 26  -LOOK FOR A PRINTER
        BZAE,TB9B                                            ! line 27  -NO
        LV,TIXG,TIXF                                         ! line 28
        CM1111(BU,1),TIXG+.24                                ! line 29  -SET IX NEG SO TO SUB
        V+,TIXG,SXCHAN                                       ! line 30  -COMPUTE THE PRINTER CHANNEL
        SV,TIXG,$R                                           ! line 31
        SF(BU,17),SYPRCH+.2,46                               ! line 32
TB9B    CB+,TIXF,TA9A                                        ! line 33
! line 34  -
! line 35  -      SAVE THE VALUES OF THE UNIT COUNT INDEX
! line 36  -
        V-I,TIXH,0.32                                        ! line 37  -REDUCE BY A HALF
        SX,TIXH,TRCHSC                                       ! line 38
        CM1111(BU,1),TRCHSC+0.24                             ! line 39  -SET THE IX NEG
        LVI,TIXH,TCHCUC                                      ! line 40  -MODIFY THE VALUE FIELD
        SX,TIXH,TFCHSC                                       ! line 41  -SAVE THE FORWARD SCAN INDEX
! line 42  -
! line 43  -      SORT THE UNIT COUNT TABLE
! line 44  -
! line 45  -
TD9A    LX,TIXF,TIXH                                         ! line 46  -LOAD TRANSIT INDEX
        BXCZ,TD9                                             ! line 47  -IF NO MULTI UNIT TABLE
        LF(BU,32),0.0(TIXH),32                               ! line 48  -LOAD ACC WITH THE TOP WORD
TD9B    KF,TCHCNT(TIXF),40                                   ! line 49
        BZAH,TD9C                                            ! line 50  -IF ACC IS THE SMALLER

!SYM T9M    021537.00
!SYM TA9B   021544.00
!SYM TA9BA  021545.00
!SYM TB9    021547.00
!SYM TB9A   021555.40
!SYM TB9B   021562.40
!SYM TD9A   021566.00
!SYM TD9B   021570.00
