!CHECK 235065.40 | 000000.75 05 | line 31 V+I,$14,.32
!CHECK 235066.00 | 236224.10 80 030000.06 70 | line 32 LF(BU,24),AIND
!CHECK 235067.00 | 000000.40 8E 130000.12 F0 | line 33 SF(BU,24)(V+I),.32($14)
!CHECK 235070.00 | 236151.02 10 | line 34 LX,$1,APNLW2
!CHECK 235070.40 | 000000.10 81 110100.06 70 | line 35 APNLP2 LF(BU,8,1)(V+I),.8($1)
!CHECK 235071.40 | 235376.40 80 | line 36 SIC,AOCTLB
!CHECK 235072.00 | 235373.50 00 | line 37 B,AOCTLC (printed "ACCTLC")
!CHECK 235072.40 | 000001.00 8E 100000.20 D0 | line 38 ST(BU,64)(V+I),1.($14)
