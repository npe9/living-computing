! mcp_bootstrap_p345.strap -- MCP printed page 345: the $DUMP program's
! panel dump: convert $MR / $IA-style panel fields to octal through the
! AOCTLB/AOCTLC subroutine, store them into the print image via $14
! (V+I progressive indexing), then the panel's 3rd line (APNLP2 loop
! over APNLW2, APNLP3 loop of 3), lines 1-50.
!
! docs/MCP_Mar63_250-445.pdf PDF p.95, read at 400 dpi, names at 900
! dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 22$DUMP  CARD ID
! VB000128  DIST. OF 3/01  3/01  PAGE NUMBER 345"; the heading row's
! LOCATION field is 235041, line 1's word.
!
! >>> A DIFFERENT PROGRAM AT OVERLAPPING ADDRESSES. <<<  PUNID 22$DUMP,
! card IDs VB...: this page occupies 235041.00-235103.40, the SAME
! words the octal-card LOADER (PUNID 22LOADER, p.327-328, e.g. AOCTLD
! 235042.40, AOCTL2 235054.40) occupies.  The dump is an overlay
! assembled at the loader's origin; the two never coexist in core.
!
! THE PAGE.  50 lines; every line number prints a "*".  "*" after the
! LOCATION on lines 10, 25, 43.  Line 27 is a remark card ("-" in the
! NAME column, "PANEL   3RD LINE").  Remarks on lines 10 (-SB) and 20
! (-RM).  Located rows contiguous from 235041.00 (line 1) to 235103.40
! (line 50, CB, a half word; next 235104.00), then blank paper.  No TAIL.
!
! JOIN.  p.344 (tools/page_sheet.py 344) ends with LF(BU,6,3)(V+I) at
! 235040.00, a full word: next 235041.00 = line 1.  p.346 opens at
! 235104.00: contiguous.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "ACCTLC" (lines 2, 6, 14, 37, 42, 48): the second glyph prints
!     open; every SIC on this page prints AOCTLB with a CLOSED O (900
!     dpi, lines 1, 47), and the two are the subroutine's link and
!     entry, so the family is AOCTL-: written AOCTLC.  The last glyph
!     is round on the left with no stem (900 dpi, lines 2 and 48),
!     the same as the C in SIC: kept C, not D.  No page defines it.
!   * octal / hex fields with an open round read 0 ("FO" = F0, "DO" =
!     D0, "CO" = 00 on line 30's B, ".CC" = .00).
!
! EXTERNALS.  None is defined by a landed deck (the $DUMP pages start
! after p.329); values from this page's binary.  SIC addresses are
! BIT-EXACT; B addresses less B's .10 give the half word only.
!
! CARD SERIALS.  VB000128 .. VB000168.  Shared serials, every one a
! SIC/B pair: lines 1-2 (128), 5-6 (131), 13-14 (138), 23-24 (147),
! 25-26 (148), 29-30 (151), 36-37 (157), 41-42 (161), 47-48 (166).
! Line 27's remark card is VB000149.  None skipped.

AOCTLB  SYN, (8)235376.40            ! not landed; SIC line 1 235376.40, BIT-EXACT
AOCTLC  SYN, (8)235373.40            ! not landed; B line 2 235373.50, half word only (printed "ACCTLC")
ABUFF   SYN, (8)236044.0             ! not landed; LF line 12 ABUFF+10. = 236056.00, word only
AFTRMB  SYN, (8)235221.0             ! not landed; SIC line 23 235221.00, BIT-EXACT
AFTRMT  SYN, (8)235211.0             ! not landed; B line 24 235211.10, half word only
AWRITB  SYN, (8)235327.40            ! not landed; SIC line 25 235327.40, BIT-EXACT
AWRITE  SYN, (8)235325.40            ! not landed; B line 26 235325.50, half word only
AMNMBF  SYN, (8)236126.0             ! not landed; LVI line 28 236126.35, word only
AINTLB  SYN, (8)235210.40            ! not landed; SIC line 29 235210.40, BIT-EXACT
AINITL  SYN, (8)235205.40            ! not landed; B line 30 235205.50, half word only
AIND    SYN, (8)236224.10            ! not landed; LF(BU,24) line 32 236224.10, BIT-EXACT
APNLW2  SYN(BU), (8)236151.0         ! not landed; LX line 34 236151.02, index word

        SLC, (8)235041.00
        SIC,AOCTLB                                           ! line  1
        B,AOCTLC                                             ! line  2
        SF(BU,24)(V+I),.32($14)                              ! line  3
APNLP1  LF(BU,24,3)(V+I),.24($1)                             ! line  4
        SIC,AOCTLB                                           ! line  5
        B,AOCTLC                                             ! line  6
        ST(BU,64)(V+I),1.8($14)                              ! line  7
        CB,$1,APNLP1                                         ! line  8
        V+I,$14,.32                                          ! line  9
        LFI(BU,16),(8)011062                                 ! line 10  -SB
        SF(BU,16)(V+I),.24($14)                              ! line 11
        LF(BU,8,1),ABUFF+10.                                 ! line 12
        SIC,AOCTLB                                           ! line 13
        B,AOCTLC                                             ! line 14
        BB,ABUFF+10.04,$+2.32                                ! line 15
        LFI(BU,8),(8)60,24                                   ! line 16
        B,$+1.32                                             ! line 17
        LFI(BU,8),(8)40,24                                   ! line 18
        ST(BU,64)(V+I),1.32($14)                             ! line 19
        LFI(BU,16),(8)024444                                 ! line 20  -RM
        SF(BU,16)(V+I),.24($14)                              ! line 21
        LVI,$1,ABUFF+13.                                     ! line 22
        SIC,AFTRMB                                           ! line 23
        B,AFTRMT                                             ! line 24
        SIC,AWRITB                                           ! line 25
        B,AWRITE                                             ! line 26
! -     PANEL   3RD LINE                                       ! line 27
        LVI,$14,AMNMBF                                       ! line 28
        SIC,AINTLB                                           ! line 29
        B,AINITL                                             ! line 30
        V+I,$14,.32                                          ! line 31
        LF(BU,24),AIND                                       ! line 32
        SF(BU,24)(V+I),.32($14)                              ! line 33
        LX,$1,APNLW2                                         ! line 34
APNLP2  LF(BU,8,1)(V+I),.8($1)                               ! line 35
        SIC,AOCTLB                                           ! line 36
        B,AOCTLC                                             ! line 37
        ST(BU,64)(V+I),1.($14)                               ! line 38
        CB,$1,APNLP2                                         ! line 39
        LF(BU,8,1)(V+I),.8($1)                               ! line 40
        SIC,AOCTLB                                           ! line 41
        B,AOCTLC                                             ! line 42
        SF(BU,32)(V+I),.40($14),32                           ! line 43
        SF(BU,32)(V+I),.32($14)                              ! line 44
        LCI,$1,3                                             ! line 45
APNLP3  LF(BU,8,1)(V+I),.8($1)                               ! line 46
        SIC,AOCTLB                                           ! line 47
        B,AOCTLC                                             ! line 48
        ST(BU,64)(V+I),1.($14)                               ! line 49
        CB,$1,APNLP3                                         ! line 50

!SYM APNLP1 235043.00
!SYM APNLP2 235070.40
!SYM APNLP3 235100.40
!CHECK 235041.00 | 235376.40 80 | line 1 SIC,AOCTLB
!CHECK 235041.40 | 235373.50 00 | line 2 B,AOCTLC (printed "ACCTLC")
!CHECK 235042.00 | 000000.40 8E 130000.12 F0 | line 3 SF(BU,24)(V+I),.32($14) (h2 prints "FO")
!CHECK 235043.00 | 000000.30 81 130300.06 70 | line 4 APNLP1 LF(BU,24,3)(V+I),.24($1)
!CHECK 235044.00 | 235376.40 80 | line 5 SIC,AOCTLB
!CHECK 235044.40 | 235373.50 00 | line 6 B,AOCTLC (printed "ACCTLC")
!CHECK 235045.00 | 000001.10 8E 100000.20 D0 | line 7 ST(BU,64)(V+I),1.8($14) (h2 prints "DO")
!CHECK 235046.00 | 235043.02 48 | line 8 CB,$1,APNLP1
!CHECK 235046.40 | 000000.75 05 | line 9 V+I,$14,.32
!CHECK 235047.00 | 044310.00 80 420000.06 70 | line 10 LFI(BU,16),(8)011062
!CHECK 235050.00 | 000000.30 8E 120000.12 F0 | line 11 SF(BU,16)(V+I),.24($14) (h2 prints "FC", open round)
!CHECK 235051.00 | 236056.00 80 010100.06 70 | line 12 LF(BU,8,1),ABUFF+10.
!CHECK 235052.00 | 235376.40 80 | line 13 SIC,AOCTLB
!CHECK 235052.40 | 235373.50 00 | line 14 B,AOCTLC (printed "ACCTLC")
!CHECK 235053.00 | 236056.04 80 235055.74 02 | line 15 BB,ABUFF+10.04,$+2.32
!CHECK 235054.00 | 140000.00 80 410014.06 70 | line 16 LFI(BU,8),(8)60,24
!CHECK 235055.00 | 235056.50 00 | line 17 B,$+1.32
!CHECK 235055.40 | 100000.00 80 410014.06 70 | line 18 LFI(BU,8),(8)40,24
!CHECK 235056.40 | 000001.40 8E 100000.20 D0 | line 19 ST(BU,64)(V+I),1.32($14)
!CHECK 235057.40 | 122220.00 80 420000.06 70 | line 20 LFI(BU,16),(8)024444
!CHECK 235060.40 | 000000.30 8E 120000.12 F0 | line 21 SF(BU,16)(V+I),.24($14)
!CHECK 235061.40 | 236061.03 01 | line 22 LVI,$1,ABUFF+13.
!CHECK 235062.00 | 235221.00 80 | line 23 SIC,AFTRMB
!CHECK 235062.40 | 235211.10 00 | line 24 B,AFTRMT
!CHECK 235063.00 | 235327.40 80 | line 25 SIC,AWRITB
!CHECK 235063.40 | 235325.50 00 | line 26 B,AWRITE
!CHECK 235064.00 | 236126.35 01 | line 28 LVI,$14,AMNMBF
!CHECK 235064.40 | 235210.40 80 | line 29 SIC,AINTLB
