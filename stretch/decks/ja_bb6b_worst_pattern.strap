        NOP,0.0
                NOP,0.0
        CNOP
! @INDEX AND CONTROL WORDS FOR LOWER TEST 6 MEM.
CTLA2   XW,0.,4,CTLA2              ! @PATTERN
CTLB2   XW,64.,16320,CTLC2         ! @STARTING ADDRESS TO SPLIT
CTLC2   XW,16384.,16384,CTLB2      ! @REMAINING ADDRESSES
CTLD2   XW,0.,2,CTLD2              ! @COMPL AND SPLIT CTL
CTLE2   XW,(8)401000.,0,000040     ! @CT
CTLG2   VF,16383.                  ! @SPLIT
CTLH2   VF,32767.                  ! @UPPER LIMIT
CTLI2   XW,64.,32704,CTLI2         ! @ CTL STEPPING THRU LOC CKED
M06AZ2  SYN,M6AZZ2+1.0
M6AZZ2  NOP,0.0
                NOP,0.0
        END,100.
