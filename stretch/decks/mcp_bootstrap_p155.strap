!
! The banner on line 9 is SEVENTEEN asterisks, three blanks,
! "WRITE LABEL", three blanks, SEVENTEEN asterisks -- counted by
! column runs over the 600-dpi render, not by eye.
!
! ---------------------------------------------------------------
! THE CHECKS
! ---------------------------------------------------------------
!SYM   KDENOP   217707.00
!SYM   KWLABL   217711.00
!SYM   ZWLABL   217723.00
!CHECK 217704.40 | 000000.37 8B 001000.36 F0 | line 1 CM1111(BU,1),S SET UP($11) -- .37 is S SET UP's 0.31 octal
!CHECK 217705.40 | 000000.30 00 | line 2 CNOP -- emits because the counter is at an odd half word
!CHECK 217706.00 | 217707.00 10 | line 3 LX,0,$+1.
!CHECK 217706.40 | 000004.01 1C | line 4 SX,0,S IOINS($12) -- printed with no blank; line 17 prints "S IO INS"
!CHECK 217707.00 | 000000.00 8E 000000.05 00 | line 5 K DEN OP CTL,0.0($14),0.0 -- 8E is the index $14
!CHECK 217710.00 | 216242.03 01 | line 6 LVI,1,K SUPP -- the .03 is LVI's operation bits, not K SUPP's offset
!CHECK 217710.40 | 221261.10 00 | line 7 B,M IO REJ (same card as line 6)
!CHECK 217711.00 | 216242.03 01 | line 11 K W LABL LVI,1,K SUPP -- byte-identical to line 6, four lines apart
!CHECK 217711.40 | 000010.62 3C | line 12 LV,9,S C REEL($12) -- .62 is S C REEL's 8.32 (octal .40) plus J=9
!CHECK 217712.00 | 000000.32 89 220064.34 02 | line 13 BB,S FP($9),K ILEGL -- 89 is the index $9
!CHECK 217713.00 | 000000.37 8B 001000.36 F0 | line 15 CM1111(BU,1),S SET UP($11) -- the word line 14's silent CNOP guarantees
!CHECK 217714.00 | 217715.00 10 | line 16 LX,0,$+1.
!CHECK 217714.40 | 000004.01 1C | line 17 SX,0,S IO INS($12) (same card as line 16)
!CHECK 217715.00 | 000000.00 8E 000176.05 00 | line 18 CTL,0.0($14),(8)176. -- FAILS ON PURPOSE, see TWO ROWS ARE LEFT FAILING (A): the printed dotted literal assembles 64x too big, and (8)176 without the dot gives this printed word exactly
!CHECK 217716.00 | 000005.00 8C | line 19 SIC,S RET AD($12) -- 8C is the index $12
!CHECK 217716.40 | 221261.10 00 | line 20 B,M IO REJ (same card as line 19)
!CHECK 217717.00 | 221371.00 80 | line 21 SIC,K K IND -- a bare 24-bit address, so this row pins K K IND to the bit
!CHECK 217717.40 | 221370.10 00 | line 22 B,K IO IND (same card as line 21) -- .10 is B's operation bit
!CHECK 217720.00 | 000002.60 8D 002000.60 50 | line 23 L,S F MODE(EF),1 -- 8D is index 13, which is what reads EF
!CHECK 217721.00 | 217723.34 C2 | line 24 BRZ,Z WLABL -- forward reference to line 27, a real check of this page's counting
!CHECK 217721.40 | 600000.00 80 402000.55 70 | line 25 CTI0110(BU,2),(8)600000.,1 -- the .55 against line 27's .06 is CT's own bit
!CHECK 217722.40 | 217724.74 C0 | line 26 BZRZ,$+2.0 -- target 217724.40, printed .74
!CHECK 217723.00 | 460000.00 80 406000.06 70 | line 27 Z WLABL LFI(BU,6),(8)460000.0 -- LF is the connective C0011, immediate
!CHECK 217724.00 | 217725.50 00 | line 28 B,$+1.32 -- .32 bare is DECIMAL 32 bits, printed .40, plus B's .10
!CHECK 217724.40 | 610000.00 80 406000.16 70 | line 29 CI0111(BU,6),(8)610000. -- C0111 immediate
!CHECK 217725.40 | 000002.33 8D 001003.06 70 | line 30 C0011(BU,1),S F DEN($13),6 -- .33 is S F DEN's 2.27 octal
!CHECK 217726.40 | 217730.74 C0 | line 31 BZRZ,$+2.0 -- byte-identical to line 26
!CHECK 217727.00 | 000000.00 80 003004.76 70 | line 32 C1111(BU,3),,9 -- FAILS ON PURPOSE, see TWO ROWS ARE LEFT FAILING (B): an empty address field silently loses the offset 9, and C1111(BU,3),0,9 gives this printed word exactly
!CHECK 217730.00 | 217731.50 00 | line 33 B,$+1.32
!CHECK 217730.40 | 420000.00 80 406003.16 70 | line 34 CI0111(BU,6),(8)420000.,6 -- same op as line 29, offset 6 shows in the .03
!CHECK 217731.40 | 221201.01 B0 | line 35 LVE,0,R V4 -- B0, not the LV family's 3x
!CHECK 217732.00 | 217765.01 30 | line 36 SV,0,E LAB CW (same card as line 35)
!CHECK 217732.40 | 000007.20 8C 002000.52 F0 | line 37 SF(BU,2),S LABM($12),1 -- SF is CM0101; .20 is S LABM's 7.16 octal
!CHECK 217733.40 | 000007.35 8C 001003.12 F0 | line 38 SF(BU,1),S LAB D($12),6 -- .35 is S LAB D's 7.29 octal
!CHECK 217734.40 | 000006.36 8C 014000.12 F0 | line 39 SF(BU,12),S SCR PM+.30($12) -- the +.30 is DECIMAL 30, printed octal .36
!CHECK 217735.40 | 202020.20 80 430000.20 50 | line 40 LI(BU,24),(8)202020.20 -- 24 bits of BCD blank
!CHECK 217736.40 | 000006.52 8C 026001.12 F0 | line 41 SF(BU,22),S SCR PM.42($12),2 -- the .42 is DECIMAL 42, printed octal .52
!CHECK 217737.40 | 000000.30 00 | line 42 CNOP -- emits, byte-identical to line 2
!CHECK 217740.00 | 217741.00 10 | line 43 LX,0,$+1.0 -- printed ".0" where lines 3 and 16 print "."
!CHECK 217740.40 | 000004.01 1C | line 44 SX,0,S IO INS($12) (same card as line 43)
!CHECK 217741.00 | 000000.00 8E 217765.03 00 | line 45 W,0.0($14),E LAB CW -- the .03 is the operation's bits
!CHECK 217742.00 | 216242.03 01 | line 46 LVI,1,K SUPP -- the third byte-identical copy on this page
!CHECK 217742.40 | 000000.74 8B 001000.00 F0 | line 47 CM0000(BU,1),S CTL($11) -- .74 is S CTL's 0.60 octal
!CHECK 217743.40 | 000000.37 8B 001000.36 F0 | line 48 CM1111,S SET UP(EU) -- identical to lines 1 and 15, which is what reads EU
