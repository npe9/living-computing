! ---- the definitions that go with it ------------------------------
XEDDK   SYN, $-XERRDD      ! p.8 line 31  -SIZE OF ERROR TABLE
XERRIN  XW, XERRDD, XEDDK+1.0, 0   ! p.8 line 32 -XW FOR INITIALIZING
                                    !              ERROR SEARCH
XMSCW1  CW, XZEROS, 3, XMSGCW(.25)1 ! p.8 line 34, verbatim
                                    !  -CW FOR LOWER CONSOLE REGISTERS
XMSGCW  CW, 0, 10, 0       ! p.8 line 35  -CW FOR ERROR MSG
XLR     DR(BU,64),(3)      ! p.8 line 36  -ZERO WORDS FOR CONSOLE LR
XERRCW  CW, 0              ! p.8 line 37  - SLOT FOR COPIED CW
        END, XERRDD
