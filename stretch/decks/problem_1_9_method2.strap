! C22-6578 PROBLEM 1.9, METHOD 2, printed p.11 (PDF 12), read in the ink.
!
!   "Start from the upper and lower co-diagonals of the matrix and
!   proceed through the exchange of the northeast-most and the
!   southwest-most elements."
!
! TPOSE2 ONWARD IS EXACTLY AS PRINTED.  INIT is the deck's, as in
! problem_1_9_method1.strap, whose header says what it fills the matrix
! with and how it is checked.  Note the page writes "N SYN, 100." here
! where Method 1 writes "N SYN, 100.0" -- the same address, A4.8.2(c).
!
! IT VISITS THE PAIRS IN A DIFFERENT ORDER and the two methods must
! leave the same 10,000 words.  That is the page's cross-check.

        SLC, 1000.0
INIT    LX, $4, XW4
        SX, $4, 0($4)
        CB+, $4, $-0.32

TPOSE2  LX, $2, XW2; SX, $2, XW22
        LX, $3, XW3; SX, $3, XW33
SWAPI   SWAPI, 1, 0($2), 0($3)
        V+ICR, $2, N+1.
        V+ICR, $3, N+1.
        BZXCZ, SWAPI
        V+IC, $2, 1.0; SX, $2, XW22
        V+IC, $3, N; SX, $3, XW33
        BZXCZ, SWAPI
HALT    BEW, $
XW2     XW, LOC+1., N-1, XW22
XW3     XW, LOC+N, N-1, XW33
XW22    XW, 0
XW33    XW, 0
N       SYN, 100.
LOC     SYN, 32768.0
XW4     XW, LOC, 10000, 0

! The guards.  They are written here because unwritten core is not zero
! here: under Bluesim it reads 0xAAAAAAAAAAAAAAAA, measured in a DUMP.
        SLC, LOC - 1.0
        DD(BU,64,8), 7
        SLC, LOC + 10000.0
        DD(BU,64,8), 7

        END, INIT
