! mcp_bootstrap_p321.strap -- MCP printed page 321: the LOADER's origin
! card (LX,$4,AXWORG .. B,AORG2) and the ORIGIN AND FLOW CARD LOADER
! (A LOAD .. A LD2), lines 1-50.
!
! docs/MCP_Mar63_250-445.pdf PDF p.72, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22LOADER  CARD ID TA000047  DIST. OF 3/01
!  3/01  PAGE NUMBER 321" (round glyphs in numeric fields read 0).  The
! heading row's LOCATION field is 234457, line 1's word.
!
! THE PAGE.  50 lines; every line number prints a "*" after it.
! Located rows run contiguous from 234457.00 (line 1) to 234521.40
! (line 50, SV, a half word; next location 234522.00), then blank paper.
! "*" after the LOCATION on lines 12, 29 and 45.
!   lines  1-38  origin card: bounds check against ALOWWD/AHGHWD, the
!                skip count, the job-control origin, the sequence and
!                checksum checks, the flow-card test, B,AORG2.
!   line  39     remark card "ORIGIN AND FLOW CARD LOADER" (the NAME
!                column prints "-"); no location.
!   lines 40-50  A LOAD: full words (L/ST (V+I) loop on $4), then the
!                zeroing / partial-word / skip tests.
!   line  42     CNOP at 234512.40 prints 000000.30 00: the half-word
!                NOP that pads ALOAD1 to a full word.
!
! JOIN.  p.320 and p.322 have no scratch deck; contiguity is NOT
! established here.  p.322 should open at 234522.00 with serial
! TA000095.  The loader data block (p.291, staged) supplies ALL and its
! indicator bits, ALDBF, ALDCTR, ALOWWD, AHGHWD -- this page's binaries
! (232543.03 / .04 / .07 / .12, 232552.03, 232553.02 / .42) meet them.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "A LOAC" / "A LCAD" / "ALCAD" (lines 28, 29, 32, 40) = ALOAD: the
!     drum's open O and worn-stem D; line 40 defines it at 234511.40 and
!     BXE line 28 (234511.72), BB line 29 (234511.74), B line 32
!     (234511.50) all print that address.  ALOAD1 (line 43) prints
!     closed.  C22-6728 has ALOADR.
!   * "ACRG1" / "ACRG2" (lines 16, 20, 38) = AORG1 / AORG2: C22-6728
!     prints AORG1.
!   * "ALC8" (line 7) = ALD8: C22-6728 prints ALD8 three times.
!   * "ALD1", "ALD2", "ALD3", "ALD5", "ALD6", "ALDBF" with the D worn
!     (lines 22, 29, 34-37, 41, 46-49).  ALDBF is p.291's spelling.
!   * "AHFWD"/"AHFWCI" (lines 19, 33, 47): AHFWDI is p.291's spelling.
!   * "ALCWWD" (line 9) = ALOWWD (p.291).  "AXWFLW" (line 27): the
!     remark "TEST IF FLOW CARD" -- W, F, L, W are plain ink.
!   * line 46 "BBZ,ASETZI,ASETZ1": the first operand's last glyph is I
!     (the indicator, p.291 ASETZI = ALL.7, binary 232543.07); the
!     second's is a 1 with a flag (a branch target 234541.00), written
!     ASETZ1.
!   * "AERR5A" (lines 8, 10, 17): 5 is plain ink at 400 dpi.
!   * octal / hex fields with an open round read 0 ("CO" = 00, "FC" /
!     "FO" = F0, "C2" stays C2 -- BXE's byte -- "0E", "0A").
!
! EXTERNALS.  None is landed; p.291 (staged) gives ALL's data block;
! every other value comes from this page's binary (each comment says how
! much it fixes).
!
! CARD SERIALS.  TA000047 .. TA000094.  Shared serials: lines 23-24
! (TA000069) and 25-26 (TA000070).  None skipped.

ALL     SYN(N), (8)232543.0          ! p.291 line 9 DRZ(N),1 (staged); BB1 line 20 232543.03
AHFWDI  SYN,ALL.4                    ! p.291 line 12 (staged); CM line 33 232543.04
ASETZI  SYN,ALL.7                    ! p.291 line 15 (staged); BBZ line 46 232543.07
ARBCDI  SYN,ALL.10                   ! p.291 line 18 (staged); BBZ line 49 232543.12
YBCBU   SYN(BU), (8)231462.0         ! p.274 line 19 DR(BU),(15) (staged), as p.291 writes it
ALDBF   SYN,YBCBU                    ! p.291 line 33 (staged); LF line 5 ALDBF.48 = 231462.60
ALDCTR  SYN(N), (8)232552.0          ! p.291 line 34 DRZ(N),1 (staged); SV line 50 232552.03
ALOWWD  SYN(BU,32), (8)232553.0      ! p.291 line 36 DRZ(BU,32),1 (staged); KV line 9 232553.02
AHGHWD  SYN(BU,32), (8)232553.40     ! p.291 line 37 DRZ(BU,32),1 (staged); KV line 7 232553.42
AXWORG  SYN, (8)235255.0             ! not landed; LX line 1 235255.10, half word only
AXWFLW  SYN, (8)235256.0             ! not landed; KV line 27 235256.10, half word only
AERR5A  SYN, (8)235225.0             ! not landed; BXH lines 8, 17 235225.33, half word only
ASEQ1   SYN, (8)234553.40            ! not landed; B line 24 234553.50, half word only
ACHSM   SYN, (8)234563.0             ! not landed; B line 26 234563.10, half word only
ASETZ   SYN, (8)234531.0             ! not landed; BB line 30 234531.34, half word only
ALD1    SYN, (8)234524.40            ! not landed; BBZ line 47 234524.74; SF line 34 ALD1.18 = 234524.62, BIT-EXACT
ASETZ1  SYN, (8)234541.0             ! not landed; BBZ line 46 234541.34, half word only
ALD3    SYN, (8)234527.0             ! not landed; BB line 48 234527.34, half word only
ARNORM  SYN, (8)235001.40            ! not landed; BBZ line 49 235001.74, half word only

        SLC, (8)234457.00
        LX,$4,AXWORG                                         ! line  1  -ORIGIN CARD
        Z,$1                                                 ! line  2
        Z,$5                                                 ! line  3
        Z,$6                                                 ! line  4
        LF(BU,60),ALDBF.48                                   ! line  5  -LOAD COLUMNS 5-9
        SF(BU,24),$1,24                                      ! line  6  -PLACE ORIGIN IN $1
ALD8    KV,1,AHGHWD                                          ! line  7
        BXH,AERR5A                                           ! line  8
        KV,$1,ALOWWD                                         ! line  9
        BXL,AERR5A                                           ! line 10
        SF(BU,24),$5                                         ! line 11  -STORE NO. OF BITS TO BE SKIPPED
        SF(BU,10),$6.14,48                                   ! line 12
        V+,6,$5                                              ! line 13
        V+,6,$1                                              ! line 14
        SF(BU,4),$4.42,54                                    ! line 15  -STORE NO OF WHOLE WORS IN CF
AORG1   KV,$6,AHGHWD                                         ! line 16
        BXH,AERR5A                                           ! line 17
        KFI(BU,6),0,48                                       ! line 18  -TEST IF PARITAL WORD TO BE STORED
        BZAE,AHFWD                                           ! line 19
AORG2   BB1,ALL.3,$+1.32                                     ! line 20  -SAVE INITIAL ORIGIN IN JOB CONTROL-
        SV,$1,3.($15)                                        ! line 21  -CALLING SEQUENCE AS BRANCH ADDR.
        LF(BU,24),ALDBF.24                                   ! line 22  -LOAD COLUMNS 3-4
        SIC,$14                                              ! line 23
        B,ASEQ1                                              ! line 24  -CHECK COLUMN 3 FOR SEQUENCE
        SIC,$14                                              ! line 25
        B,ACHSM                                              ! line 26  -CHECK CHECKSUM COLUMN 4
        KV,$4,AXWFLW                                         ! line 27  -TEST IF FLOW CARD
        BXE,ALOAD                                            ! line 28  -YES-GO TO LOAD
        BB,ALDBF.49,ALOAD                                    ! line 29  -IF SKIP OR ZERO DONE LAST - LOAD
        BB,ALDBF.48,ASETZ                                    ! line 30  -ZERO DONE FIRST
        V+,$1,$5                                             ! line 31  -ADD NO OF BITS SKIPPED TO ORG.
        B,ALOAD                                              ! line 32
AHFWD   CM1111(BU,1),AHFWDI                                  ! line 33  -SET PARTIAL WORD INDICATOR
        SF(BU,6),ALD1.18,48                                  ! line 34  -STORE NO OF BITS IN VFL-
        SF(BU,6),ALD1+1.18,48                                ! line 35  -INSTRUCTIONS IN ALD1
        SF(BU,6),ALD1.35,48                                  ! line 36
        SF(BU,6),ALD1+1.35,48                                ! line 37
        B,AORG2                                              ! line 38  -CONTINUE WITH LOAD ROUTINE
! line 39  - ORIGIN AND FLOW CARD LOADER
ALOAD   KCI,$4,0                                             ! line 40  -ARE THERE FULL WDS TO BE LOADED
        BXE,ALD6                                             ! line 41  -NO-TEST FOR ZEROING AND PARTIAL WORD
        CNOP                                                 ! line 42
ALOAD1  L(BU,64)(V+I),1.($4)                                 ! line 43  -CHANGED TO LOAD ZEROS IN SETZ ROUTINE
        ST(BU,64)(V+I),1.($1)                                ! line 44  -LOAD FULL WORDS
        CB,$4,ALOAD1                                         ! line 45
ALD6    BBZ,ASETZI,ASETZ1                                    ! line 46  -TEST IF ZEROING WAS BEING DONE
        BBZ,AHFWDI,ALD1                                      ! line 47  -TEST IF PARTIAL WD TO BE STORED
ALD5    BB,ALDBF.49,ALD3                                     ! line 48  -TEST IF SKIP OR ZERO STILL TO BE DONE
ALD2    BBZ,ARBCDI,ARNORM                                    ! line 49
        SV,$1,ALDCTR                                         ! line 50

!SYM ALD8   234463.00
!SYM AORG1  234471.00
!SYM AORG2  234473.40
!SYM AHFWD  234504.00
!SYM ALOAD  234511.40
!SYM ALOAD1 234513.00
!SYM ALD6   234515.40
