        Z,   $X12
        Z,   $X13
        Z,   $X14
        Z,   $X15
        Z,   $X2
I48S2   $B,  0
!
! ======================================================================
! PDF p.153, 011320.40-011340.40: 148K0-148K15, each an instruction
! "SX,$Xn,148DMP" and a NOP -- loaded by LX as index words
! ======================================================================
        CNOP
I48K0   SX,  $X0, I48DMP
        NOP
I48K1   SX,  $X1, I48DMP
        NOP
I48K2   SX,  $X2, I48DMP
        NOP
I48K3   SX,  $X3, I48DMP
        NOP
I48K4   SX,  $X4, I48DMP
        NOP
I48K5   SX,  $X5, I48DMP
        NOP
I48K6   SX,  $X6, I48DMP
        NOP
I48K7   SX,  $X7, I48DMP
        NOP
I48K8   SX,  $X8, I48DMP
        NOP
I48K9   SX,  $X9, I48DMP
        NOP
I48K10  SX,  $X10, I48DMP
        NOP
I48K11  SX,  $X11, I48DMP
        NOP
I48K12  SX,  $X12, I48DMP
        NOP
I48K13  SX,  $X13, I48DMP
        NOP
I48K14  SX,  $X14, I48DMP
        NOP
I48K15  SX,  $X15, I48DMP
        NOP
!
! PDF p.153 011372.00 (148ER1, "-V I SELN, C FP, R VFL.") and PDF p.154
! 011373.00 (148DMP)
        SLC, (8)11372.0
I48ER1  XW,  0, 0, 0                  ! -V I SELN, C FP, R VFL.
I48DMP  XW,  0, 0, 0
!
! PDF p.190, 013036.00: 100VO.  The page prints "XW,%8)-777777.77,0,0";
! this assembler takes the sign before the radix, as ax5b_bit_table does.
        SLC, (8)13036.0
I00VO   XW,  -(8)777777.77, 0, 0
        END, I481
