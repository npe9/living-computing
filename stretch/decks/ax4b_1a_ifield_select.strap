! ======================================================================
! PDF p.152, 011310.00-011320.00: 148S1, "SUBROUTINE TO CLEAR ALL IX
! REGS." (Z,$X2 last, as printed), and its return 148S2
! ======================================================================
        SLC, (8)11310.0
I48S1   Z,   $X0                      ! -SUBROUTINE TO CLEAR
        Z,   $X1                      ! -ALL IX REGS.
        Z,   $X3
        Z,   $X4
        Z,   $X5
        Z,   $X6
        Z,   $X7
        Z,   $X8
        Z,   $X9
        Z,   $X10
        Z,   $X11
        Z,   $X12
        Z,   $X13
        Z,   $X14
        Z,   $X15
        Z,   $X2
I48S2   $B,  0
!
! ======================================================================
! PDF p.153, 011320.40-011340.40: 148K0-148K15, each an instruction
! "SX,$Xn,148DMP" and a NOP -- loaded by LX as index words
! ======================================================================
