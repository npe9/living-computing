        DD(BU,64,8), (16)0108000001302000
        DD(BU,64,8), (16)0108000001303000
        DD(BU,64,8), (16)0108000001304000
        DD(BU,64,8), (16)0108000001305000
        DD(BU,64,8), (16)0108000001401000
        DD(BU,64,8), (16)0108000001402000
        DD(BU,64,8), (16)0108000001403000
        DD(BU,64,8), (16)0108000001404000
        DD(BU,64,8), (16)0108000001405000
GUARD   DD(BU,64,8), (16)5555555555555555
        END, START
