!   line  3  004556.40  000000.63 84  001000.36 F0     T P4  CM1111,SMOUNT(TXC)
!   line  4  004557.40  000000.65 84  001000.36 F0     CM1111,SIMNT(TXC)
!   line  5  004560.40  000000.15 01                   LVI,TIXY,0
!   line  6  004561.00  000001.13 01                   LVI,TIXZ,1.0
!   line  7  004561.40  003273.23 80  004563.74 00     BZB,TMODE,TP7
!   line  8  004562.40  000000.13 01                   LVI,TIXZ,0.0
!   line  9  004563.00  000001.15 05                   V+I,TIXY,1.0
