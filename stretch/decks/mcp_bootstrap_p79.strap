!   line 23  004572.00  000043.40 80                   ,DCCMM
!   line 24  004572.40  004445.00 80                   ,TSUBHD
!   line 25  004573.00  000004.00 80                   ,4.0
!   line 26  004573.40  001472.10 00                   T PEN  B,DMCP
!   line 27  004574.00  000043.40 80                   ,DCCMM
!   line 28  004574.40  004432.00 85                   ,TBUFB1(TIXZ)
!   line 29  004575.00  000007.00 86                   ,7.(TIXY)
