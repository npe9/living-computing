!   line 36  004601.40  004604.23 40                   BZXF,TPICA
!   line 37  004602.00  004455.02 80  004604.34 0A     BBN,TNGATE,TPICA
!   line 38  004603.00  003313.04 10                   LX,TXA,TPPURF
!   line 39  004603.40  004461.50 00                   B,TP6
