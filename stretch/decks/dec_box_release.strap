! THE DECIMAL ADDER (mkDecBox: VFL decimal add) RELEASES ITS LEVEL, 2026-11-23
! (docs/microarchitecture_plan.md §1c step 5f stage 3; StretchCore's
! releaseDecBox, boxReleases, liftHoldClocks, deferIboxStores).
!
! THE PAGES.  Perf. Char. Vol. 1 printed p.3-16 (PDF 34), the units'
! "local autonomy"; printed p.3-18 (PDF 36), "The processing time of I-box
! instructions can be largely overlapped by concurrent E-box action".  An
! interruption is taken "before execution of the next instruction" (Ref.
! Manual printed p.48, PDF 51), what the I-box did ahead is undone (Perf.
! Char. Vol. 1 printed p.3-24, PDF 42; Buchholz §15.6), and an I-box store
! prepared after the interrupting level is never made (printed p.3-20, PDF
! 38; Table A-2, PDF 69).
! The interrupting indicator (mask bit 12.23, entry 23):
!   PF, printed p.60: "significant bits of the data field from storage
!   overlap the left end" of the accumulator, "the high-order bits of the
!   result are dropped" -- 9876 added at offset 120
!   (decks/vfl_decimal_add.strap's A7)
!
!   L: the box's level interrupts; the trail X7, X8 stays 0 and WHEREL is
!      the instruction after it.
!   S: the same, then an SX into STWS: the SX starts in
!      the box's hold clocks (seen with a temporary $display, removed),
!      waits in a store level, and is cancelled.  STWS = 0, X9 = 0,
!      WHERES is the instruction after the box's.
!   T: disabled; an ST level and an SX into its word (the SX waits in a
!      store level, ahead of the box's level), then 24 LVIs that do not
!      depend on the box: those the I-box reaches while the box holds its
!      level run beside it (the release's time: with the box's switch
!      off they wait for the answer).
!   I: disabled, no interruption: an LX of the accumulator ($R) and a Z
!      of it must each wait for the box's answer (the interlock).
! CYCLES/MEMREADS are MODEL behaviour.  The run line in tests/run_tests.sh
! has the observed injections.
        SLC, (8)4100.0
START   BD,  $+.32                   ! disable while IA and the mask are set
        LVI, $X13, TBL
        SV,  $X13, $IA
        BBZ, $PF,  $+1.0
        BB1, 12.23, $+1.0            ! the mask bit := ONE
        LVI, $X6,  1                 ! the value the SX stores
        BE,  $+.32                   ! ENABLE
! CASE L: the box's level interrupts.
        L(DU,8,4), D12
        +(DU,16,4), D9876, 120      ! PF on: the interruption
NEXTL   LVI, $X7, 1                  ! the trail
        LVI, $X8, 1
DONEL   BD,  $+.32                   ! entry 23 branches here
        BBZ, $PF,  $+1.0
        LVI, $X13, TBL2
        SV,  $X13, $IA
        BE,  $+.32
! CASE S: an SX in the box's hold clocks.
        L(DU,8,4), D12
        +(DU,16,4), D9876, 120      ! PF on: the interruption
NEXTS   SX,  $X6, STWS               ! must leave no trace
        LVI, $X9, 1
DONES   BD,  $+.32                   ! entry 23 branches here
        BBZ, $PF,  $+1.0
! CASE T: disabled; I-box work that does not depend on the box.
        L(DU,8,4), D12
        ST(BU,64), TMPT, 0           ! a level storing TMPT
        +(DU,8,4), D34
        SX,  $X3, TMPT               ! a store level, behind it
        LVI, $X10, 1                 ! beside the held level
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        LVI, $X10, 1
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        LVI, $X10, 1
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        LVI, $X10, 1
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        LVI, $X10, 1
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        LVI, $X10, 1
        LVI, $X11, 1
        LVI, $X12, 1
        LVI, $X14, 1
        ST(BU,64), TOUT, 0
! CASE I: disabled; the interlock.
        L(DU,8,4), D12
        +(DU,8,4), D34
        LX,  $X1, $R                 ! must wait for the answer
        SX,  $X1, OUTL
        L(DU,8,4), D12
        +(DU,8,4), D34
        Z,   $R                      ! must come after the answer
        ST(BU,64), ZOUT, 0
        B,   PASS
PASS    BEW, $
        SLC, (8)6300.0
D9876   DD(BU,64), (16)9876000000000000
D12     DD(BU,64), (16)1200000000000000
D34     DD(BU,64), (16)3400000000000000
        SLC, (8)6400.0
WHEREL  DD, 0                        ! the counter case L's interruption left
WHERES  DD, 0                        ! ... case S's
STWS    DD, 0
OUTL    DD, 0
ZOUT    DD, 0
TOUT    DD, 0
TMPT    DD, 0
        SLC, (8)6500.0
TBL     DD, 0
        SLC, (8)6527.0
RTNL    SIC, WHEREL
        B,   DONEL
        SLC, (8)6600.0
TBL2    DD, 0
        SLC, (8)6627.0
RTNS    SIC, WHERES
        B,   DONES
        END, START
