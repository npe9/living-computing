        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        SLC, 1250.0
        DD(BU,64,8), 7
CHICK   DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
        DD(BU,64,8), 7
