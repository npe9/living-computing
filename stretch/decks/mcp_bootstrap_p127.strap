SL      SYN(BU,1), (8)215001.4   ! dds from the page that PRINTS the definition,
                                     ! p.103 line 14; added 2026-11-02 -- the merged
                                     ! MCP-body image refused without it,
                                     ! because a connective or VFL operation
                                     ! that writes NO dds takes its length from
                                     ! the SYMBOL, so the merge would have had
                                     ! to pick one silently.

SM      SYN(BU,1), (8)215001.5   ! dds from the page that PRINTS the definition,
                                     ! p.103 line 15 "S M SYN(BU,1),S COM RG+0.05"; added 2026-11-02 -- the merged
                                     ! MCP-body image refused without it,
                                     ! because a connective or VFL operation
                                     ! that writes NO dds takes its length from
                                     ! the SYMBOL, so the merge would have had
                                     ! to pick one silently.

