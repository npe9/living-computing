! mcp_bootstrap_p88.strap -- MCP INITIALIZATION, printed page 88:
! THE - MOVE - SUB-ROUTINE.
! docs/MCP_Mar63_001-249.pdf PDF p.95, header "PAGE NUMBER 88" --
! read, not assumed: the top line prints "CARD ID 18000271 ... PAGE
! NUMBER 88", and 18000271 is line 1's own serial.
!
! CONTIGUOUS WITH printed p.87, whose last line (26) is T WORM, an XW
! at 005013.00.  This page's first compiled line, 6, is T MOVE at
! 005014.00, one word later.
!
! Fifty-six lines, forty-four of which compile.  Three boxed headings:
! lines 2-4 "THE - MOVE - SUB-ROUTINE", lines 18-20 "CONVERT THE
! NECESSARY FIELDS OF THE IOD CARD", and the rules at 5, 14, 32, 47.
! Card serials run 18000271 (line 1) to 18000326 (line 56), so the
! line number is the serial minus 18000270 -- which is how the 56-line
! count was confirmed rather than estimated.
!
! >>> WHAT THE ROUTINE DOES. <<<  T MOVE saves the indexes with a
! SWAPI into T SIOXW (printed p.83 line 40), clears the IOD-card error
! flag T ERFLG (p.83 line 14), loads the control word through $15 and
! rejects a dispatcher reject.  It then tests the card's op-code field
! T IOP against the BCD literal T MIOD ("IOD", p.83 line 9) and, if it
! is an IOD card, converts the card's TYPE and MODE fields to codes by
! scanning the tables printed on pp.85 and 86: T SCIX1/T SCBK1 index
! and back up the TYPE scan (p.85 lines 29-30), T SCIX2/T SCBK2 the
! MODE scan (p.86 lines 5-6).  A hit stores the scan table's code into
! T ITYCD / T IMOCD; a miss bumps the error-flag index T MXGA by 16.0
! (type) or 04.0 (mode) and falls into the same store.  Tape goes to
! T MNGA for the tape mode scan; card machines take the shorter scan
! first and a disk (KFI(BU,4),001 -- "DISK 1" is exactly the code
! p.85 line 35 prints) branches away to T MNG.
!
! >>> THE 0/C GLYPH PAIR IS NOT DECIDABLE BY SHAPE ON THIS PAGE. <<<
! Line 41's op byte prints with an open right side, identical to the
! C of line 25's "C2"; line 53 is the SAME statement, V+I,TMXGA,04.0,
! and prints a closed 0.  Rendered side by side at 1200 dpi the SAME
! field, 000004, prints open in one row and closed in the other, so
! the opening is ink and not a glyph.  Every such byte here was
! settled by assembling the statement, not by looking harder: the
! assembler puts 05 on both V+I rows, 01 (not C1) on line 21's LVI,
! and 00 (not C0) on every bare B.
!
! AND OTHER PAGES' PRINTS AGREE, which is what keeps that from being
! circular -- the oracle exists so the listing checks strap_asm, not
! the other way round.  Lines 21, 28, 42, 46 and 54 are the five whose
! trailing byte the eye could not decide here; each has an
! independently transcribed witness elsewhere in the corpus.  Bare
! "B,SYMBOL" prints ".x0 00" on forty-nine rows across printed
! pp.44-80, and LVI prints "01" on printed p.38 lines 11/16/22, p.56
! line 56, p.57 lines 1/14/17/25, p.66 and p.75.  Line 41's 05 has two
! unambiguous twins on this page itself, lines 27 and 53.
!
! >>> LINES 44 AND 56 PRINT THE SAME WORD FROM DIFFERENT STATEMENTS.
! Line 44 is C0011(BU,2),0.0(TMXG) and line 56 is LF(BU,2),0.0(TMXG),
! and both print 000000.00 88  002000.06 70.  That is not a mis-read:
! strap_asm assembles the two to the identical word.
!
! >>> TWO LISTING MARKS: lines 23 and 39 carry an asterisk after the
! location.
!
! Four symbols point FORWARD, off this page, and are carried as SYN
! stand-ins at the addresses the branch rows print:
!   T MNG  005072.40 (lines 35, 46)   T M6   005264.40 (line 17)
!   T M2   005313.00 (line 13)        T MREJ 005402.00 (line 11)

        SLC, (8)5014.0

! ---- index names, printed p.83 lines 28/30/31 ---------------------
TMXI    SYN, $10                     ! -CONTROL WORD INDEX
TMXG    SYN, $8                      ! -TEMPORARY INDEX
TMXGA   SYN, $11                     ! -TEMPORARY INDEX
! ---- words, printed p.83 ------------------------------------------
TSIOXW  SYN, (8)4633.0               ! p.83 line 40 DRZ(BU,64),(15)
TERFLG  SYN, (8)4632.0               ! p.83 line 14 VF,0
TMIOD   SYN(BU,24,6), (8)4630.14     ! p.83 line  9 (AX)DD(BU,24,6),IOD
! ---- IOD card field offsets, printed p.84 -------------------------
TIOP    SYN(BU,24), 1.0              ! -OP CODE FIELD
TITY    SYN(BU,42), 2.0              ! -THE TYPE FIELD
TITYCD  SYN(BU,4), 2.60              ! -THE TYPE FIELD CODE
TIMO    SYN(BU,30), 6.0              ! -THE MODE FIELD
TIMOCD  SYN(BU,2), 6.62              ! -THE MODE FIELD CODE
! ---- scan tables, printed pp.85 and 86 ----------------------------
TSCIX1  SYN, (8)4743.0               ! p.85 line 29
TSCBK1  SYN, (8)4744.0               ! p.85 line 30
TSCIX2  SYN, (8)4753.0               ! p.86 line  5
TSCBK2  SYN, (8)4754.0               ! p.86 line  6
! ---- forward, onto printed p.89 and after -------------------------
TMNG    SYN, (8)5072.40
TM6     SYN, (8)5264.40
TM2     SYN, (8)5313.0
TMREJ   SYN, (8)5402.0

        SLC, (8)5014.0

! ---- THE - MOVE - SUB-ROUTINE -------------------------------------
TMOVE   SWAPI, 12, $1, TSIOXW        ! line 6  -SAVE INDEXES
        CM0000(BU,18), TERFLG        ! line 8  -RESET THE IOD CARD
                                      !           ERROR IND
        LX, TMXI, 0.0($15)           ! line 9  -GET CONTROL WORD FOR
                                      !           ENTRY CK
        CT0011(BU,18), 0.46($15)     ! line 10
        BZRZ, TMREJ                  ! line 11 -IF A DISPATCHER REJECT
        CM0000(BU,1), TMXI+24        ! line 12 -SET THE SIGN PLUS
        BXVLZ, TM2                   ! line 13 -IF INITIAL ENTRY
TM1     C0011, TIOP(TMXI)            ! line 15 -LOAD OP CODE FOR TEST
        KF, TMIOD                    ! line 16 -TEST FOR IOD
        BZAE, TM6                    ! line 17 -NOT AN IOD CARD

! ---- CONVERT THE NECESSARY FIELDS OF THE IOD CARD -----------------
        LVI, TMXGA, 0.0              ! line 21 -RESET THE ERROR FLAG
                                      !           INDEX
        LX, TMXG, TSCIX1             ! line 22 -GET THE NUMBER OF SCAN
        C0011, TITY(TMXI)            ! line 23 -GET TYPE FIELD
TMLOK1  KF(V+IC)(BU,42,6), .47(TMXG) ! line 24
        BAE, TMOK1                   ! line 25
        BZXCZ, TMLOK1                ! line 26
        V+I, TMXGA, 16.0             ! line 27 -A TYPE FIELD ERROR
        B, TGET1                     ! line 28
TMOK1   V+, TMXG, TSCBK1             ! line 29
TGET1   LF(BU,5), 0.0(TMXG)          ! line 30
        SF(BU,5), TITYCD-1(TMXI)     ! line 31 -STORE THE TYPE CODE
        BB, TITYCD(TMXI), TMNGA      ! line 33 -GO IF TAPE
        KFI(BU,4), 001               ! line 34 -LOOK FOR A DISK
        BAE, TMNG                    ! line 35 -YES
        LX, TMXG, TSCIX2             ! line 36 -LOAD FOR MODE SCAN
                                      !           FOR CARD MACHINES
        LF, TIMO-1.0(TMXI)           ! line 37 -GET CARD MACHINE MODE
TMLOK2  KF(V+IC)(BU,30,6), 0.32(TMXG) ! line 38
        BAE, TMOK2                   ! line 39
        BZXCZ, TMLOK2                ! line 40
        V+I, TMXGA, 04.0             ! line 41 -A MODE FIELD ERROR
        B, TGET2                     ! line 42
TMOK2   V+, TMXG, TSCBK2             ! line 43
TGET2   C0011(BU,2), 0.0(TMXG)       ! line 44
        CM0101, TIMOCD-1.0(TMXI)     ! line 45
        B, TMNG                      ! line 46 -NON TAPE FINISHED

TMNGA   LX, TMXG, TSCIX2             ! line 48 -LOAD TO TAPE MODE SCAN
        LF, TIMO(TMXI)               ! line 49
TMLOK5  KF(V+IC)(BU,30,6), .32(TMXG) ! line 50
        BAE, TMOK5                   ! line 51
        BZXCZ, TMLOK5                ! line 52
        V+I, TMXGA, 04.0             ! line 53 -MODE FIELD ERROR
        B, TGET5                     ! line 54
TMOK5   V+, TMXG, TSCBK2             ! line 55
TGET5   LF(BU,2), 0.0(TMXG)          ! line 56

