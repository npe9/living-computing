CNTBUF  VF, 0                                                ! line  7  -NUMBER OF ENTRIES IN BUFFER MAP
CWDISK  XW,0,0,0                                             ! line  8  -CONTROL WORD FOR DISK FETCH
CFOT    DRZ(BU,64), (2)                                      ! line  9
CINDEX  DRZ(N), 40                                           ! line 10  -INDEX
CBFMAP  DRZ(BU,64), (50)                                     ! line 11  -MAP OF BUFFER CONTENTS
CDICEX  DRZ(BU,64), (2)                                      ! line 12
        LVI,$15,$                                            ! line 13
        BE,CXUK                                              ! line 14
        LVI, 15, $                                           ! line 15
        BE, CXIT                                             ! line 16
        LVI, 15, $                                           ! line 17
        BE, CXIT                                             ! line 18
        CM0000(BU,1),ADSKRD                                  ! line 19
CXIT    B, DMCP                                              ! line 20
        , DRET                                               ! line 21
CLR     DRZ(BU,64), (11)                                     ! line 22
CXUK    BB,CDICEX+1.09,CEPGK                                 ! line 23
        M-1(BU,18),CUKCNT                                    ! line 24
        BRZ,CXUKND                                           ! line 25
        B,DMCP                                               ! line 26
        ,DLOCS                                               ! line 27
        ,PROSA                                               ! line 28
CLUK    ,0                                                   ! line 29
        SIC,CRDBR                                            ! line 30
        B,CRD1                                               ! line 31
        B,DMCP                                               ! line 32
        ,DRET                                                ! line 33
CEPGK   LVI,$14,SEPGK                                        ! line 34
        SIC,SDISIC                                           ! line 35
        B,SDISP                                              ! line 36
CXUKND  B,DMCP                                               ! line 37
        ,DCOMM                                               ! line 38
        ,CDSKFL                                              ! line 39
        ,4.                                                  ! line 40
        B,DMCP                                               ! line 41
        ,DRET                                                ! line 42
CDSKFL  (IQS*)DD(BU),OPERATOR--REPEATED UKS ON DISK  *       ! line 43
CLOCCT  VF,0                                                 ! line 44
CWRD    CW,0,0,0                                             ! line 45

