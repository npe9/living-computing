!CHECK 022757.40 | 000012.40 80 | line 2 ,DFREE
!CHECK 022760.00 | 000003.00 80 | line 3 ,3.
!CHECK 022760.40 | 000000.40 88 001000.00 F0 | line 4 CM0000,TCHOWN(TMXG)
!CHECK 022761.40 | 000000.22 03 | line 5 TMREJ5 Z,0.0(TMXB)
!CHECK 022762.00 | 000000.76 88 022764.34 06 | line 6 BBZ,TUNRES(TMXG),TMREJ3
!CHECK 022763.00 | 000000.77 88 001000.00 F0 | line 7 CM0000,TOVRES(TMXG)
!CHECK 022764.00 | 000001.22 83 022765.74 00 | line 8 TMREJ3 BZB,TLAST+1.0(TMXB),TMREJ4
!CHECK 022765.00 | 232306.07 01 | line 9 LVI,TMXB,TIOREQ-1.0
!CHECK 022765.40 | 022735.47 48 | line 10 TMREJ4 CB+,TMXB,TMREJ1
!CHECK 022766.00 | 215012.57 30 | line 16 TN2 SV,TMXF,TMARK
!CHECK 022766.40 | 000011.03 30 | line 17 SV,TMX1,$R
!CHECK 022767.00 | 022133.17 80 003036.46 70 | line 18 LF(BU,3),TERFLG+.15,61
!CHECK 022770.00 | 000000.34 8F 022027.20 D0 | line 19 ST(BU,18),0.28($15),46
!CHECK 022771.00 | 000021.00 80 022134.30 E0 | line 20 SWAPI,12,$1,TSIOXW
!CHECK 022772.00 | 000001.10 0F | line 21 B,1.00($15)
!CHECK 022772.40 | 000000.30 00 | line 27 TMCONV NOP
!CHECK 022773.00 | 000011.20 80 060600.06 70 | line 28 LF(BU,48,6),$R+.16
!CHECK 022774.00 | 000011.40 80 040400.12 F0 | line 29 SF(BU,32,4),$R+.32
!CHECK 022775.00 | 000011.71 01 | line 30 LVI,LXA,$R+.32
!CHECK 022775.40 | 231545.63 80 010020.06 70 | line 31 LF(BU,8,8),LBLZOR,32
!CHECK 022776.40 | 000000.04 8C 104420.23 10 | line 32 LCONVA KF(BU,4,4)(V+I),.4(LXA),32
!CHECK 022777.40 | 023001.37 42 | line 33 BAH,LCONVB
!CHECK 023000.00 | 777777.74 8C 004400.00 F0 | line 34 $CM0000(BU,4,4),-.4(LXA)
!CHECK 023001.00 | 000000.00 8C 004422.23 10 | line 35 LCONVB KF(BU,4,4),0.0(LXA),36
!CHECK 023002.00 | 022776.76 C4 | line 36 BZAEZ,LCONVA
!CHECK 023002.40 | 000011.71 0D | line 37 V-I,LXA,$R+.32
!CHECK 023003.00 | 000034.22 80 006673.46 70 | line 38 LF(BU,6,6),LXA+.18,119
!CHECK 023004.00 | 000010.30 30 | line 39 LV,LXA,$L
!CHECK 023004.40 | 000011.40 80 000400.24 3C | line 40 LCV(DU,0,4),$R+.32,0.0(LXA)
