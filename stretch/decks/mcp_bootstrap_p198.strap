! mcp_bootstrap_p198.strap -- MCP printed page 198: SEARCH (K SERCH ..
! K STEP) and the head of UNSTACK (K UNSTC .. B,Z PACK).
!
! docs/MCP_Mar63_001-249.pdf PDF p.205, read at 400 dpi (900 dpi for
! doubtful glyphs).  Header, READ: "TIME CLOCK 00054041  PUNID
! 11D11MCP  CARD ID LI000001  DIST. OF 3/01  3/01  PAGE NUMBER 198";
! the heading row's LOCATION field is BLANK -- line 1 is a banner
! (docs/transcription_workflow.md step 1).
!
! A NEW CARD DECK: the card serials restart at LI000001 (p.197 ran
! LH000043..LH000062).  Serials LI000001..LI000052 run one per line,
! no gap, no repeat.
!
! THE PAGE.  52 lines.
!   lines  1-7   comment cards, NOT TRANSCRIBED: 1 and 3 rules of
!                asterisks, 2 "-******** S E A R C H ********-",
!                4-7 the calling sequence, printed as remarks:
!                  "CALL SEG   LVI,1,DCG / B,K SERCH /
!                   DCG (NOT FOUND) / DCG+.32 (FOUND)"
!   line   8     SLC,$ at 222017.71 *
!   lines  9-31  SEARCH: K SERCH .. K STEP VF,-.38 (222036.40)
!   lines 32-34  comment cards, NOT TRANSCRIBED: rules of asterisks
!                round "-******** U N S T A C K ********-"
!   lines 35-52  UNSTACK: K UNSTC (222037.00) .. B,Z PACK (222051.00)
! Contiguous from 222017.71 to 222051.00 and the page ends.
!
! >>> THE JOIN WITH p.197. <<<  p.197 ends with K UL MES VF at
! 222017.40; this page's SLC,$ prints 222017.71, i.e. the counter
! after that VF (25 bits).  Line 9's half word then aligns to
! 222020.00.  So the trail is contiguous across the page break.
!
! LINE 8 IS PRINTED "SLC,$" AND IS WRITTEN "SLC, (8)222017.71" HERE
! (as printed pp.104/110 do): in a standalone deck "$" is 0.
!
! >>> GLYPHS SETTLED BY SOMETHING OTHER THAN PLAIN INK. <<<
!  * K SOSA (lines 43, 46): read at 900 dpi; the second glyph is the
!    same closed squared O as K CONT's O, not a C (Vision read SCSA
!    at line 46).  The label is only referenced on this page; the
!    BZBZ's h2 222045.74 is K SOSA's 222045.40 + bit field.
!  * The open round: this drum prints 0 as an open round that is
!    indistinguishable from C at 900 dpi (compare line 17's true C2).
!    In OCTAL fields only a 0 can stand.  In HEX bytes it was settled
!    by what the statement assembles to, four times:
!      line 25  M-1(BU,18),SQK($9)  h2 prints "BC", is B0
!      line 29  CM0000(BU,24),...   h2 prints "FC", is F0; the
!               statement itself prints "CMOCCC(BU,24),C.C($9)"
!      line 47  BEW,$               prints "C0", is 00
!      line 52  B,ZPACK             prints "C0", is 00
!    (lines 47/52: a B to a .00/.40/.50 address leaves the byte 00, as
!    line 45's B,KPACK+1.0 prints a clean "00".)
!  * Lines 11 and 40 print "B9" (B, flat-backed, read at 900 dpi; the
!    Vision sheet said 89): V+'s 5-bit code 01011 puts 1011 in bits
!    24-27, and both rows assemble to B9.
!  * Remark on line 22 prints "-PACK QLELE"; it is written QUEUE
!    (worn U).  A remark, no bit depends on it.
!  * "S Q K", "S CUM Q", "-TOTAL Q K": the Q prints with a short
!    tail that reads C/G at 400 dpi.

SPROGS  SYN, (8)215021.0             ! landed; p.109 line 7 -PROGRAM STATUS TABLE
SQK     SYN(BU,18), .32              ! landed; p.109 line 9
SQUE    SYN, (8)215420.0             ! landed; p.116 line 33 DRZ(BU,19),(128)
SCUMQ   SYN, (8)215466.0             ! landed; p.116 line 34
SAS     SYN(BU,1), .25               ! landed; p.109 line 8 -AUTO STACK STATUS
KNINTY  SYN, (8)216010.0             ! landed; p.123 label row
KSUPP   SYN, (8)216242.0             ! landed; p.128 line 3

        SLC, (8)222017.71                                    ! line  8 -- printed card is "SLC,$"
KSERCH  LVI,9,SPROGS                                         ! line  9
        LV,8,SQK($9)                                         ! line 10
        V+,8,SQK+1.0($9)                                     ! line 11  -TOTAL Q K
        BXVZ,0.0($1)                                         ! line 12
        LC,8,$8                                              ! line 13
        LVI,8,SQUE                                           ! line 14
KCLUB   L(V+I)(BU,18),.19($8),-18                            ! line 15
        KV,13,$L                                             ! line 16
        BXE,KPACK                                            ! line 17
        CB,8,KCLUB                                           ! line 18
        B,0.0($1)                                            ! line 19
KPACK   BZB,-.1($8),ZPACK                                    ! line 20  -TEST LEVEL - BR. IF PP
        V+I,9,1.0                                            ! line 21
ZPACK   L(V+I)(BU,19),-.19($8)                               ! line 22  -PACK QUEUE
        ST(V+I)(BU,19),.38($8)                               ! line 23
        CB,8,$-2.0                                           ! line 24
        M-1(BU,18),SQK($9)                                   ! line 25  -REDUCE Q K
        V+,8,KSTEP                                           ! line 26
        SV,8,SCUMQ                                           ! line 27
        BB,SAS($9),.32($1)                                   ! line 28
        CM0000(BU,24),0.0($9)                                ! line 29  -CLEAR WAIT FIELD
        B,.32($1)                                            ! line 30
KSTEP   VF, -.38                                             ! line 31
KUNSTC  LVI,9,SPROGS                                         ! line 35
        LVI,1,KNINTY                                         ! line 36
        LVI,8,SQUE                                           ! line 37
        LV,3,SQK+1.0($9)                                     ! line 38
        BXVZ,KCONT                                           ! line 39  -IS MCP QUE EMPTY
        V+,3,SQK($9)                                         ! line 40
        LC,8,$3                                              ! line 41
KFLIP   L(V+I)(BU,19),.19($8),-19                            ! line 42
        BZBZ,8.18,KSOSA                                      ! line 43
        LV,13,$L                                             ! line 44
        B,KPACK+1.0                                          ! line 45
KSOSA   CB,8,KFLIP                                           ! line 46
        BEW,$                                                ! line 47
KCONT   LC,8,SQK($9)                                         ! line 48
        BXCZ,KSUPP                                           ! line 49
        L(V+I)(BU,18),.19($8),-18                            ! line 50
        LV,13,$L                                             ! line 51
        B,ZPACK                                              ! line 52

!SYM KSERCH 222020.00
!SYM KCLUB  222023.00
!SYM KPACK  222026.00
!SYM ZPACK  222027.40
!SYM KSTEP  222036.40
!SYM KUNSTC 222037.00
