ZCHSCN  SYN(BU,32,8), (8)235071.0   ! p.370 line 14 "ZCHSCN LVI,..." (scratch, not landed); B line 48 235071.10
ZREQUN  SYN,$6                       ! p.376 line 8 (scratch, not landed); I nibble 6 on lines 9, 15, 46
ZREQCH  SYN,$8                       ! p.376 line 10 (scratch, not landed); I nibble 8 on lines 6, 7
