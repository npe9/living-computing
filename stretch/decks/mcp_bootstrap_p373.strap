ZDELTM  SYN(BU,36,6), (8)235372.44   ! p.376 line 3 "ZDELTM (AX)DD(BU,36,6),DELETMX" (scratch, not landed); KF line 27 235372.44
ZMNERX  SYN(BU,64,8), (8)235365.40  ! p.375 line 48 "ZMNERX CM0000,..." (scratch, not landed); BZAE lines 2, 14
ZOWNER  SYN(BU,64,8), (8)235066.40  ! p.370 line 7 "ZOWNER BZB,..." (scratch, not landed); B line 3 235066.50 (printed "ZCWNER")
ZASUIN  SYN,$PG5                     ! p.376 line 17 (scratch, not landed); CM1111 line 12 000013.56
ZPPCHD  SYN,$PG2                     ! p.376 line 15 (scratch, not landed); CM1111 line 23 000013.53
ZOPTST  SYN,$PG6                     ! p.376 line 18 spells it "ZCPTST" -- see header; CM1111 line 26 000013.57
ZMAIND  SYN(BU,64,8), (8)235341.0   ! p.375 line 20 "ZMAIND KF,..." (scratch, not landed); BZPG5 line 19
ZEXITX  SYN(BU,32,8), (8)234633.0   ! p.365 line 9 "ZEXITX LWF(U),..." (scratch, not landed); B line 22 234633.10
ZEREX1  SYN(BU,32,8), (8)234631.0   ! p.365 line 5 "ZEREX1 LX,12,ZEX1" (scratch, not landed); B line 31 234631.10
ZSPL01  SYN(BU,64,8), (8)235260.0   ! p.374 line 8 "ZSPL01 (A*)DD(BU,64,8),..." (scratch, not landed); line 35 BIT-EXACT
ZQUZ49  SYN(BU), (8)235265.0        ! p.374 line 10 "ZQUZ49 (IQS*)DD(BU),..." (scratch, not landed); VF line 42 235265.00+

        SLC, (8)235221.00
        K,ZDELET,12                                          ! line  1
        BZAE,ZMNERX                                          ! line  2  - IF NOT DELETE,TO ERROR CHK
        B,ZOWNER                                             ! line  3  printed "ZCWNER"
! line  4  -
! line  5  - ****** MULTI-CHANNEL ONLY REQUEST ******
ZMULCH  LV,ZREQUN,0.0(ZREQCH)                                ! line  6  -GET UNIT ST TBL BASE ADDR
        LF,SUNITK(ZREQCH),-18                                ! line  7  -UNIT COUNT FOR CHANNEL
        LC,ZREQUN,$L                                         ! line  8
ZQUES1  BB1,SUNASG(ZREQUN),ZQUS11                            ! line  9  -BRANCH IF NOT ASSIGNED TO TEST
! line 10  -IF ALL UNITS ON CHAN UNASN
        BPG5,$+1.32                                          ! line 11  -ASSN UNIT INDIC ON
        CM1111,ZASUIN                                        ! line 12  -SET ASSN UNIT IND ON
        KF,ZDELET,12                                         ! line 13
        BZAE,ZMNERX                                          ! line 14  -IF NOT DELETE, TO ERROR CHK
        BB,SOWNER(ZREQUN),ZMCPMC                             ! line 15  -BR IF REQ MULTI-CH UNIT IS MCP
        BZPG2,ZSETPP                                         ! line 16  -CH ONLY DEL OF MUL CH FOR PP
ZQUES2  CB+,ZREQUN,ZQUES1                                    ! line 17  -ANY MORE UNITS TO BE EXAMINED
! line 18  -ON REQUESTED CHANNEL
        BZPG5,ZMAIND                                         ! line 19
        BPG2,ZQUES4                                          ! line 20  -BRANCH IF ANY PP UNITS ON CHAN
ZDONE   LVI,12,5.0                                           ! line 21
        B,ZEXITX                                             ! line 22
ZSETPP  CM1111(BU,1),ZPPCHD                                  ! line 23  -SET PP UNIT SWITCH FOR PRIME
        B,ZQUES2                                             ! line 24
ZQUS11  BPG6,ZQUES2                                          ! line 25  -IF OP TESTED, LOOK FOR MORE UNS
        CM1111,ZOPTST                                        ! line 26  -SET OP CODE TEST IND ON
        KF,ZDELTM,12                                         ! line 27
        BAE,ZQUES2                                           ! line 28
        KF,ZDELET,12                                         ! line 29
        BAE,ZQUES2                                           ! line 30
        B,ZEREX1                                             ! line 31
ZQUES4  BPG3,ZDONE                                           ! line 32  -BRANCH IF ABEOJ,JC4 PRIMED
        SIC,ZSPLP9                                           ! line 33
        BD,ZSPLPR                                            ! line 34
        ,ZSPL01                                              ! line 35  printed "Z SPL 01" (open 0)
        CF,5.0                                               ! line 36
        SIC,SPRIMR                                           ! line 37
        BD,SPRIME                                            ! line 38
        ,DABEOJ                                              ! line 39
        BE,DMCP                                              ! line 40  printed "D MCP" (worn D)
        ,DCOMM                                               ! line 41
        VF,ZQUZ49                                            ! line 42
        CF,5.0                                               ! line 43
        B,ZDONE                                              ! line 44
ZMCPMC  LX,2,$R                                              ! line 45  -SAVE OP CODE IN ACC
        CM1111(BU,1),SUNASG(ZREQUN)                          ! line 46  -SET UNIT UNASSIGNED
        SIC,ZSCAN9                                           ! line 47
        B,ZCHSCN                                             ! line 48  -GO TO SCAN FOR NEW MCP UNIT

