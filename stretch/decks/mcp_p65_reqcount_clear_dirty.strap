! printed p.65 lines 44-48 WITH A DIRTY ACCUMULATOR -- the one way
! this differs from the boot, where the accumulator is never fresh.
!
! >>> WHY: THE BOOT'S I/O REQUEST TABLE IS ENTIRELY EMPTY AND DISK'S
! REQUEST COUNT IS ONE. <<<  printed p.62 line 28 puts T IOREQ at
! 003373.0 = word 1787, eighty entries; thirteen probes across words
! 1787-1866 of a boot run all read ZERO.  So MCP has no I/O requests
! at all.  Yet printed p.64's table comes out of the same run with
! DISK's REQUEST COUNT at 1, and that one non-zero byte is the whole
! ASSIGN reject: p.66 line 10's BRZ skips a row whose count is zero,
! so with every count zero line 13 would never run.
!
! THE LOOP THAT SHOULD HAVE LEFT THEM ZERO IS THIS ONE.  A watchpoint
! put the write to DISK's count at PC half-word 4010 = 003725.00,
! which printed p.65's checked rows give as line 47 (V+CR) -- so the
! store is line 46, the only store in the loop:
!
!   line 44           LX, TX1, TTYARA     -LOAD TO BEGINNING
!   line 45           Z, $R               -ZERO THE ACC
!   line 46  T CLEAR  ST, T RCAD(TX1)     -THEN CLEAR THE ...
!   line 47           V+CR, TX1, T COMBO
!   line 48           BZXCZ, T CLEAR
!
! T RCAD is printed p.63 line 29's SYN(BU,8),T MCAD+0.8 -- bit 16 of
! an entry, the third byte -- and T TYARA carries count 8, T COMBO
! value 24, both decoded from the live index words.  NOTE V+CR HERE
! AND V+C IN THE p.72 LOOP: different instructions, and p.72's loop is
! already shown correct in isolation
! (decks/mcp_p72_clear_loop.strap).
!
! EVERY BYTE IS DISTINCT so a stray write names itself: row r is
! (16+r, 32+r, 48+r).  After a correct loop the THIRD byte of each row
! -- the request count -- is zero and nothing else has moved.

        SLC, (8)2000.0

START   L(BU,64), DIRTY, 0        ! fill the accumulator low half
        L(BU,64), DIRTY, 64       ! and the high half too
        LX, $1, TABPTR
        Z, $R
CLEAR   ST, RCAD($1)
        V+CR, $1, COMBO
        BZXCZ, CLEAR
PASS    BEW, $

        CNOP
TABPTR  XW, TABLE, 8, 0
COMBO   XW, 24, 0, 0
        CNOP
TABLE   DD(BU,8), 16, 32, 48
        DD(BU,8), 17, 33, 49
        DD(BU,8), 18, 34, 50
        DD(BU,8), 19, 35, 51
        DD(BU,8), 20, 36, 52
        DD(BU,8), 21, 37, 53
        DD(BU,8), 22, 38, 54
        DD(BU,8), 23, 39, 55

DIRTY   DD(BU,64,8), -1

RCAD    SYN(BU,8), 0.16

        END, START
