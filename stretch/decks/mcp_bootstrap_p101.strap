! ---- CHECKS, read by tests/verify_mcp_page.py 101 ----------------
! Twenty-three symbols and no rows: a SYN deposits no storage word,
! so there is nothing for a !CHECK to look at.  Manufacturing one
! from the "+00000000" the BINARY OUTPUT column prints would be
! checking the printer, not the assembler.
!SYM   SCHANN   000000.14
!SYM   SUNITN   000000.57
!SYM   SIODK    000001.06
!SYM   SRMTC    000001.40
!SYM   SUUNAS   000001.76
!SYM   SRMIND   000001.77
!SYM   SEVLTB   000002.00
!SYM   SEVLMK   000002.40
!SYM   SFIAAC   000003.00
!SYM   SCWADR   000003.40
!SYM   SRETRY   000003.74
!SYM   SREMNT   000003.75
!SYM   SIOINS   000004.00
!SYM   SRETAD   000005.00
!SYM   SCTLOP   000005.52
!SYM   SSCRPM   000006.00
!SYM   SLABM    000007.20
!SYM   SSYSTM   000007.31
!SYM   SLABD    000007.35
!SYM   SFILEK   000007.46
