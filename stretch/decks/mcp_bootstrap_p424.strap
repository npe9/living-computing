!CHECK 022372.40 | 022374.76 C2 | line 14 BAE,TMOK3
!CHECK 022373.00 | 022371.70 40 | line 15 BZXCZ,TMLOK3
!CHECK 022373.40 | 000002.27 05 | line 16 V+I,TMXGA,02.0
!CHECK 022374.00 | 022375.10 00 | line 17 B,TGET3 (hex prints "C0": open round; B can only assemble 00, as line 28)
!CHECK 022374.40 | 022261.20 B0 | line 18 T MCK3 V+,TMXG,TSCBK3
!CHECK 022375.00 | 000000.00 88 002000.06 70 | line 19 T GET3 C0011(BU,2),0.0(TMXG)
!CHECK 022376.00 | 000007.76 8A 002000.12 F0 | line 20 CM0101,TIDNCD(TMXI)
!CHECK 022377.00 | 022263.20 10 | line 22 LX,TMXG,TSCIX4
!CHECK 022377.40 | 000010.00 8A 036000.06 70 | line 23 C0011,TIDS(TMXI)
!CHECK 022400.40 | 000000.41 88 236600.23 10 | line 24 T MLCK4 KF(V+IC)(BU,30,6),0.33(TMXG)
!CHECK 022401.40 | 022403.76 C2 | line 25 BAE,TMOK4
!CHECK 022402.00 | 022400.70 40 | line 26 BZXCZ,TMLOK4
!CHECK 022402.40 | 000001.27 05 | line 27 V+I,TMXGA,01.0
!CHECK 022403.00 | 022404.10 00 | line 28 B,TGET4
!CHECK 022403.40 | 022264.20 B0 | line 29 T MCK4 V+,TMXG,TSCBK4
!CHECK 022404.00 | 000000.00 88 003000.06 70 | line 30 T GET4 C0011(BU,3),0.0(TMXG)
!CHECK 022405.00 | 000010.76 8A 002000.12 F0 | line 31 CM0101,TIDSCD(TMXI)
!CHECK 022406.00 | 022133.27 30 | line 32 T MNG SV,TMXGA,TERFLG
!CHECK 022406.40 | 022411.71 42 | line 33 BXVZ,TM1AA
!CHECK 022407.00 | 000002.74 8A 004000.20 50 | line 35 L,TITYCD(TMXI)
!CHECK 022410.00 | 022411.74 C0 | line 36 BZRZ,TM1AA
!CHECK 022410.40 | 000020.03 01 | line 37 LVI,TMX1,16.
!CHECK 022411.00 | 022721.10 00 | line 38 B,TMREJB
!CHECK 022411.40 | 022154.20 10 | line 44 T M1AA LX,TMXG,TUNXW
!CHECK 022412.00 | 000000.64 8A 014027.20 50 | line 45 L,TIREF(TMXI),46
