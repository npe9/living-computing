YMOVE   SYN, (8)020172.40            ! $EOJ, not landed; CB line 6 020172.66 (.40 = half-word bit), half word only
YMOVEJ  SYN, (8)020501.0             ! $EOJ, not landed; BZXCZ line 3 020501.30, half word only
YC4INT  SYN, (8)021017.40            ! $EOJ, not landed; BB line 7 021017.74, half word only
YC4SMB  SYN, (8)020726.0             ! $EOJ, not landed; LVI line 38 020726.03, TI line 37 020726.20
YRESTR  SYN, (8)020226.0             ! $EOJ, not landed; B line 41 020226.10 (= line 48 WRESTR's address)
TMOVE   SYN, (8)022326.0             ! $EOJ, not landed; B line 46 022326.10, half word only
WJOR2   SYN(U), (8)231443.0          ! landed p.274 line 18 DRZ(U),15
WBREAK  SYN,WJOR2+1.0                ! p.392 line 16 defining form; not landed; XW line 47 value WBREAK+1.0 = 231445.00

        SLC, (8)020174.00
YMOVXW  XW,0,0,0,4                                           ! line  1
        LX,$10,YMOVXW                                        ! line  2
        BZXCZ,YMOVEJ                                         ! line  3
YMOJRP  V+I,$11,15.                                          ! line  4
        SV,$11,YMOVXW                                        ! line  5
        CB,$11,YMOVE                                         ! line  6
WJC4G1  BB,SCORG,YC4INT                                      ! line  7
WJC4G   LV,$14,SLRBU+.32                                     ! line  8
        LC,$14,SLRBU                                         ! line  9
        SV,$14,YLOL1                                         ! line 10  -LOWER LIMIT), AND YLOL1(LOWER
        SC,$14,YLOL2                                         ! line 11
WJC4G2  CM1111(BU,1),YLOL1+.25                               ! line 12
        SX,$13,SREADS                                        ! line 13
        Z,SLRBU+1.0                                          ! line 14  -SET LOWER REGISTERS
        LCI,$1,27.                                           ! line 15  -TO ZERO
        T,$1,SLRBU+1.0,SLRBU+2.0                             ! line 16
        CM1111(BU,1),SLRBU+9.21                              ! line 17  -SET IF MASK TO ONE
        CM1111(BU,1),SLRBU+9.0                               ! line 18
        CM1111(BU,1),SPINCL                                  ! line 19
        CM0000(BU,2),SSPFIX                                  ! line 20
        LV,$14,SMARK                                         ! line 21  -SET UP $EDUMP
        SV,$14,YEDLL+.32                                     ! line 22
        SIC,SPRIMR                                           ! line 23
        BD,SPRIME                                            ! line 24
        ,DRESLD                                              ! line 25
        BZB,SJ1FUL,$+2.32                                    ! line 26
        SIC,SPRIMR                                           ! line 27
        BD,SPRIME                                            ! line 28
        ,SJC1                                                ! line 29
        BE,DMCP                                              ! line 30  printed "BE,CMCP"
        ,SDRET                                               ! line 31  printed ",SCRET"
! -                                                            line 32
! - ***************************************************        line 33
! - GENERAL ERROR ROUTINE - PRINTS DIAGNOSIS OF ERROR AND RETURNS     line 34
! - TO BEGINNING , SKIPPING DEJSCN IF EOJ CARD WAS ENCOUNTERED.       line 35
! - ***************************************************        line 36
YBRLOG  TI,8,0($10),YC4SMB                                   ! line 37
        LVI,1,YC4SMB                                         ! line 38
        SIC,YPRRET                                           ! line 39
        B,YPR                                                ! line 40
        B,YRESTR                                             ! line 41
YEOJP   SYN,$                                                ! line 42  printed "YECJP"
! -                                                            line 43
WJC4Q   CM1111(BU,1),WMOVIQ+.24                              ! line 44  -INITIAL ENTRY BIT
        LVI,$15,WMOVIQ                                       ! line 45  -
        B,TMOVE                                              ! line 46  -TO MOVE
WMOVIQ  XW,WBREAK+1.0,0,1,0                                  ! line 47  -      TO REJECT NEXT JOB
WRESTR  CM1111,YEOJS                                         ! line 48
        CM0000(BU,1),SPINCL                                  ! line 49
        SIC,SPRIMR                                           ! line 50  -
        BD,SPRIME                                            ! line 51  -
        ,DEOJ                                                ! line 52  -
        BE,$+.32                                             ! line 53  -
        B,DMCP                                               ! line 54  -
        ,SDRET                                               ! line 55  -

