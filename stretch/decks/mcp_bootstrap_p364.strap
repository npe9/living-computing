!CHECK 234610.40 | 232721.36 30 | line 21 LV,15,J SIZE
!CHECK 234611.00 | 000020.37 05 | line 22 V+I,15,16.0
!CHECK 234611.40 | 000002.37 00 | line 23 C+I,15,2
!CHECK 234612.00 | 234614.77 30 | line 24 Z HARD C SV,15,J HAR5
!CHECK 234612.40 | 234617.77 50 | line 25 SC,15,J HAR 6
!CHECK 234613.00 | 234614.37 01 | line 26 LVI,15,$+1.0
!CHECK 234613.40 | 230567.44 00 | line 27 BD,SA6IQS
