! line 19  - SIC,Z COM 99    B,Z COM 01
! line 20  -
ZCOM01  SX,1,ZCOM98                                          ! line 21  -SAVE INDICES
        SX,2,ZCOM98+1.0                                      ! line 22
        LV,2,ZCOM90                                          ! line 23  -GET IOD NUMBER ADDRESS  (printed "Z CCM 90")
        LV,1,0.0($2)                                         ! line 24  -GET IOD NUMBER
        BXVZ,ZIODH                                           ! line 25  -IOD EQUAL TO ZERO, ERROR
        V+I,2,.32                                            ! line 26
        SVA,2,ZCOM90                                         ! line 27  -SET RETURN ADDRESS
        V+,1,SBAMCP                                          ! line 28  -ADD IO LOC BASE ADDR TO IOD
        LV,2,0.0($1)                                         ! line 29  -GET UNIT AREA ADDRESS
        LR,2,$2                                              ! line 30  -PUT UNIT AREA ADDR IN RF $2
        LV,1,SCHANN($2)                                      ! line 31
        V+,1,$1                                              ! line 32  -GET CHANNEL NUMBER INTO $1
        V+,1,SXCHAN                                          ! line 33  -ADD BASE OF CHAN ST TABLES
        BB,SMULTI($1),ZCOM02                                 ! line 34  -BRANCH IF MULTI UNIT CHANNEL
        LV,2,$1                                              ! line 35  -CHAN STATUS TBL ADDR INTO $2
ZCOM99  B,$                                                  ! line 36  -RETURN SLOT
ZCOM02  LV,2,SUNITN($2)                                      ! line 37  -GET UNIT NUMBER IN $1
        V+,2,SUNAA($1)                                       ! line 38  -ADD BASE ADDR OF UNIT ST. TBL.
ZCOM03  SVA,2,ZCOM04                                         ! line 39
        LV,2,$1                                              ! line 40  -GET CHAN ST TBL ADDR IN $2
ZCOM04  LVI,1,0.0                                            ! line 41  -GET UNIT ST ADDR IN $1
        B,ZCOM99                                             ! line 42  (printed "Z CCM 99")
ZCOM19  LVI,14,SASNER                                        ! line 43  -ERROR ROUTINE
        SIC,SDISIC                                           ! line 44
        BD,SDISP                                             ! line 45
ZCOM98  XW,0.0                                               ! line 46  -STORAGE FOR INDICES
        XW,0.0                                               ! line 47

