! line  7  -
        SLC,$                                                ! line  8  (prints 233107.00 *)
ZTIME   LV,7,STIC                                            ! line  9
        V+I,7,.32                                            ! line 10
        SVA,7,ZT1                                            ! line 11
        V+I,7,.32                                            ! line 12
        SV,7,STIC                                            ! line 13  -UPDATE STIC
        TI,15,STLR+14.0,17.0                                 ! line 14  -RESTORE INDEXES
ZT1     LVE,1,0.0                                            ! line 15  -GET STORAGE ADDRESS
        BUSAZ,$+.32                                          ! line 16
        BADZ,$+.32                                           ! line 17
        SIC,ZT81                                             ! line 18
        B,ZT8                                                ! line 19  -TO CHECK BOUNDS IF PP REQUEST
ZT2     Z,$SB                                                ! line 20
        CM1111(BU,2),$SB+.2                                  ! line 21  -SET ZONE BITS FOR IQS STORE
        L(BU,26),$TC,-60                                     ! line 22  -READ TIME CLOCK
        +(B,27,1),STIMEK,-60                                 ! line 23  -ADD TIME CONSTANT
        /I(BU,6),60,-60                                      ! line 24
        C0011(BU,6),$RM+.54                                  ! line 25  -GET SECONDS FROM RM IN BINARY
        CM0101(BU,6),0.20($1)                                ! line 26  -SAVE BINARY SECONDS
        /I(BU,6),60,-60                                      ! line 27  -COMPUTE HOURS AND MINUTES
        CV(BU),$L,24                                         ! line 28  -CONVERT HOURS TO DECIMAL
        LTRCV(BU,6),$RM+.54                                  ! line 29  -CONVERT MINUTES TO DEC
        C0011(BU,8),$TR+.52,12                               ! line 30
        LTRCV(BU,6),0.20($1)                                 ! line 31
        C0011(BU,8),$TR+.52                                  ! line 32
        ST(DU,63,8),0.0($1)                                  ! line 33  (printed "CU")
        LFI(BU,8),(2)01110101                                ! line 34  -IQS COLON
        SF(BU,8),0.16($1)                                    ! line 35
        SF(BU,8),0.40($1)                                    ! line 36
        B,KSUPP                                              ! line 37
ZT8     BB,SL,ZT81                                           ! line 38  -BRANCH IF MCP - NO TEST
        KV,1,STLR                                            ! line 39
        BZXL,ZT9                                             ! line 40
        KV,1,STLR+.32                                        ! line 41
        BXL,ZT9                                              ! line 42
ZT81    B,$                                                  ! line 43
ZT9     LVI,14,SFORBD                                        ! line 44
        SIC,SDISIC                                           ! line 45
        B,SDISP                                              ! line 46  (printed "SCISP")
STIMEK  VF,0.0                                               ! line 47

