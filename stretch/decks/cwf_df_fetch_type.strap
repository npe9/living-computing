        BZB, $DF,  $+2.0
        BB1, RESDF+.17, $+1.0        ! DF indicator on
        BBZ, $DF,  $+1.0
        BZB, 6.0,  $+2.0
        BB1, RESDS+.17, $+1.0        ! DS's routine ran
