! case 18: ST     mask ZERO: DS as at mask one
        L(BU,64,8), PAT2W            ! accumulator := PAT2W
        LVI, $X2, 1
        LVI, $X2, 2
        LVI, $X2, 3
        LVI, $X2, 4
        LVI, $X2, 5
        LVI, $X2, 6
        ST(BU,64,8), WHIGH           ! case 18
        K(BU,64,8), PAT2W            ! E-box work right behind it
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        BZB, $AE,  $+2.0
        BB1, RESAE+.18, $+1.0        ! accumulator unchanged
        BZB, $DF,  $+2.0
        BB1, RESDF+.18, $+1.0        ! DF indicator on
        BBZ, $DF,  $+1.0
        BZB, 6.0,  $+2.0
        BB1, RESDS+.18, $+1.0        ! DS's routine ran
        BBZ, 6.0,  $+1.0
!
! case 19: L      mask ZERO crossing: DF on, completes
        L(BU,64,8), PAT2W            ! accumulator := PAT2W
        LVI, $X2, 1
        LVI, $X2, 2
        LVI, $X2, 3
        LVI, $X2, 4
        LVI, $X2, 5
        LVI, $X2, 6
        L(BU,32,8), UNPROT+.48       ! case 19
        K(BU,64,8), PAT2W            ! E-box work right behind it
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        BZB, $AE,  $+2.0
        BB1, RESAE+.19, $+1.0        ! accumulator unchanged
        BZB, $DF,  $+2.0
        BB1, RESDF+.19, $+1.0        ! DF indicator on
        BBZ, $DF,  $+1.0
        BZB, 6.0,  $+2.0
        BB1, RESDS+.19, $+1.0        ! DS's routine ran
        BBZ, 6.0,  $+1.0
!
! case 20: ST     STORE-type behind a divide: its level waits, fetch or not
        BD,  $+.32
        BB1, 12.20, $+1.0            ! DF's mask bit := ONE
        BE,  $+.32
        L(BU,64,8), PAT2W            ! accumulator := PAT2W
        LVI, $X2, 1
        LVI, $X2, 2
        LVI, $X2, 3
        LVI, $X2, 4
        LVI, $X2, 5
        LVI, $X2, 6
        /(BU,48,8), DIVSR            ! (unprotected: the E-box busy)
        ST(BU,64,8), WHIGH           ! case 20
        K(BU,64,8), PAT2W            ! E-box work right behind it
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        BZB, $AE,  $+2.0
        BB1, RESAE+.20, $+1.0        ! accumulator unchanged
        BZB, 6.1,  $+2.0
        BB1, RESDF+.20, $+1.0        ! DF's routine ran
        BBZ, 6.1,  $+1.0
        BZB, 6.0,  $+2.0
        BB1, RESDS+.20, $+1.0        ! DS's routine ran
        BBZ, 6.0,  $+1.0
!
! case 21: CM     STORE-type behind a divide: its level waits, fetch or not
        L(BU,64,8), PAT2W            ! accumulator := PAT2W
        LVI, $X2, 1
        LVI, $X2, 2
        LVI, $X2, 3
        LVI, $X2, 4
        LVI, $X2, 5
        LVI, $X2, 6
        /(BU,48,8), DIVSR            ! (unprotected: the E-box busy)
        CM0011(BU,64,8), WHIGH       ! case 21
        K(BU,64,8), PAT2W            ! E-box work right behind it
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        NOP
        BZB, $AE,  $+2.0
        BB1, RESAE+.21, $+1.0        ! accumulator unchanged
        BZB, 6.1,  $+2.0
        BB1, RESDF+.21, $+1.0        ! DF's routine ran
        BBZ, 6.1,  $+1.0
        BZB, 6.0,  $+2.0
        BB1, RESDS+.21, $+1.0        ! DS's routine ran
        BBZ, 6.0,  $+1.0
!
        B,   PASS
PASS    BEW, $
!
        SLC, (8)6275.0
DIVSR   DD(BU,48,8), 3               ! an unprotected divisor
        SLC, (8)6276.0
PAT2W   DD(BU,64,8), (8)0000125252525212525240
UNPROT  DD(BU,64,8), (8)0000000000000000000017   ! the word BELOW the area
WLOW    DD(BU,64,8), (8)0000000000000000000052   ! inside the area
WHIGH   DD(BU,64,8), (8)0000125252525252525240   ! inside the area
WABOVE  DD(BU,64,8), 0
!
        SLC, (8)6400.0
RESAE   DD, 0                        ! bit k: accumulator unchanged after case k
RESDF   DD, 0                        ! bit k: DF routine ran (mask one) / DF on (mask zero)
RESDS   DD, 0                        ! bit k: DS routine ran
!
        SLC, (8)6500.0
TBL     DD, 0
        SLC, (8)6523.0
DSRTN   BB1, 6.0, $+1.0              ! entry 19 = DS
        SLC, (8)6524.0
DFRTN   BB1, 6.1, $+1.0              ! entry 20 = DF
        END, START
