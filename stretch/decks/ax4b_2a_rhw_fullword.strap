        LX,  $X2, $R
        NOP
        KV,  $X2, BIT0
        BXE, $+1.0
        B,   $+1.32
        NOP
        B,   $+1.32
        SIC, SEN                      ! -RHW MODIFICATION OF FULL WD INST
        B,   SERS                     ! -FAILS WHEN INDEXED BY ABOVE BIT.
        LX,  $X1, BIT1                ! -TEST RHW OF FW, INDEX BIT 33.
        L(BU), BIT0, ($X1)            ! -NO CHANGE TO INSTRUCTION.
        LX,  $X2, $R
        NOP
        KV,  $X2, BIT0
        BXE, $+1.0
        B,   $+1.32
        NOP
        B,   $+1.32
        SIC, SEN                      ! -RHW MODIFICATION OF FULL WD INST
        B,   SERS                     ! -FAILS WHEN INDEXED BY ABOVE BIT.
        LX,  $X1, BIT2                ! -TEST RHW OF FW, INDEX BIT 34
        L(BU), BIT0, ($X1)            ! -NO CHANGE TO INSTRUCTION.
        LX,  $X2, $R
        NOP
        KV,  $X2, BIT0
        BXE, $+1.0
        B,   $+1.32
        NOP
        B,   $+1.32
        SIC, SEN                      ! -RHW MODIFICATION OF FULL WD INST
        B,   SERS                     ! -FAILS WHEN INDEXED BY ABOVE BIT.
