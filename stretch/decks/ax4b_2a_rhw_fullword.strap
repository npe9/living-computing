I4817   LX,  $X0, I48ER1              ! -TEST 2A, CHECK RIGHT HALF WORD
        BXVZ, I4817A                  ! -MODIFICATION OF FULL WD. INST.
        SIC, SEN                      ! -PREVIOUS I-FLD SELN PROHIBITS
        B,   SERS                     ! -RUNNING THIS PROGRAM.
        LX,  $X13, IC248              ! -UPDATE CONTINUITY CHECK.
        KVI, $X13, (8)774000.0
        SIC, SEN
        BZXE, SERS                    ! -CONTINUITY ERROR.
        B,   I50                      ! -TERMINATE 1248.
I4817A  SR,  $X0, $X0
        LX,  $X0, $X0
        BXVZ, I4818
        SIC, SEN                      ! -PREVIOUS VFL FAILURE PROHIBITS
        B,   SERS                     ! -RUNNING THIS TEST.
        LX,  $X13, IC248              ! -UPDATE CONTINUITY.
        V+,  $X13, BIT7
        V+,  $X13, BIT8
        V+,  $X13, BIT9
        V+,  $X13, BIT10
        SX,  $X13, IC248
