        BEW, $
        BEW, $                        ! -ADDRESS IS 30.
        BEW, $
        BEW, $
        BEW, $
        BEW, $                        ! -ADDRESS IS 31.
        BEW, $
        BEW, $
        BEW, $

! -- ERROR BRANCH TABLE 2, all 32 entries (PDF pp.95-97) --
        SLC, (8)6626.0
I44B2A BEW, $                        ! -ADDRESS IS 0.
        BEW, $
        BEW, $
        BEW, $
I44B2  BEW, $                        ! -ADDRESS IS 1.
        BEW, $
