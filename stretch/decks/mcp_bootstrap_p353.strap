! mcp_bootstrap_p353.strap -- MCP printed page 353: the $DUMP program's
! character-class dispatch: load one-byte codes (B, D, U, BLANK, I, ...)
! by bit tests on $13 / $1, store them through $14, return via ARETRN;
! ADIRCT / AIMMED / AIMMD1-2 / AMNUS / ANEG / AMPYA / AMPY1A, lines 1-50.
!
! docs/MCP_Mar63_250-445.pdf PDF p.103, read at 400 dpi, names at 900
! dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 22$DUMP  CARD ID
! VB000498  DIST. OF 3/01  3/01  PAGE NUMBER 353"; the heading row's
! LOCATION field is 235475, line 1's word.  Still PUNID 22$DUMP, VB
! card series: the page does not leave the $DUMP.  No SLC printed.
!
! THE PAGE.  50 lines; every line number prints a "*".  "*" after the
! LOCATION on lines 11, 24, 37.  No remark cards.  Remarks on lines 2
! (-CHNGE. + TO -), 3 (-)), 5 (-B), 7 (-D), 9 (-U), 11 (-BLANK), 20
! (-I), 23 (-B), 25 (-D), 27 (-U), 29 (-BLANK).  Located rows contiguous
! from 235475.40 (line 1) to 235550.40 (line 50, LFI, a full word; next
! 235551.40), then blank paper.  No TAIL.
!
! JOIN.  p.352 (tools/page_sheet.py 352) ends with LF(BU,32) at
! 235474.40, a full word: next 235475.40 = line 1.  p.354 (sheet) opens
! at 235551.40: contiguous.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "ANVLDO" (line 17): the last glyph is a closed round, 71 px wide at
!     900 dpi against 65-67 px for the digit 0 and 68 px for the letter
!     O ("TO", line 2) on this page -- width does not settle it.  No deck
!     and no C22-6728 text names it; written with the letter O as Vision
!     reads it.  ANVLD0 is the look-alike to watch for in p.351-352.
!   * AINTC1, AIMMD1, AMPY1A: last/fifth glyph carries the 1's flag at
!     900 dpi (I prints with two serifs, as in ACONNI and (V+I)).
!   * octal / hex fields with an open round read 0 ("8C"/"0C" = 00 etc.).
!
! EXTERNALS.  None is defined by a landed deck (p.346-352 not landed);
! values from this page's binary.  B addresses less B's .10, and BB/BZB
! addresses less the .34 the op adds, give the half word only.
!
! CARD SERIALS.  VB000498 .. VB000547, one per line, none shared or
! skipped.

ARETRN  SYN, (8)235377.0             ! not landed; B line 13 235377.10, half word only
ACONNI  SYN, (8)235554.40            ! not landed (p.354); BB line 19 235554.74, half word only
ANVLDO  SYN, (8)235425.0             ! not landed; BZB line 17 235425.34, half word only
AINTC1  SYN, (8)235462.0             ! not landed; BB line 33 235462.34, B line 43 235462.10, half word only
AMPY2A  SYN, (8)235552.0             ! not landed (p.354 sheet: AMPY2A 235552.00); BB line 47 235552.34, half word only

        SLC, (8)235475.40
        BZB,0($13),$+2.                                      ! line  1
        LFI(BU,8),(8)40,40                                   ! line  2  -CHNGE. + TO -
        LFI(BU,8),(8)74,16                                   ! line  3  -)
        BB,.21($13),$+2.32                                   ! line  4
        LFI(BU,8),(8)62,8                                    ! line  5  -B
        B,$+1.32                                             ! line  6
        LFI(BU,8),(8)64,8                                    ! line  7  -D
        BZB,.19($13),$+2.32                                  ! line  8
        LFI(BU,8),(8)24                                      ! line  9  -U
        B,$+1.32                                             ! line 10
        LFI(BU,8),(8)20                                      ! line 11  -BLANK
        ST(BU,64),.24($14)                                   ! line 12
        B,ARETRN                                             ! line 13
ADIRCT  BB,.36($1),ACONNI+1.                                 ! line 14
        LFI(BU,8),(8)20,8                                    ! line 15
        B,AIMMD1                                             ! line 16
AIMMED  BZB,.39($1),ANVLDO                                   ! line 17
        BB,.35($1),AMPY1A                                    ! line 18
        BB,.36($1),ACONNI                                    ! line 19
        LFI(BU,8),(8)71,8                                    ! line 20  -I
AIMMD1  SF(BU,48)(V+I),.48($14),8                            ! line 21
AIMMD2  BB,.21($13),$+2.32                                   ! line 22
        LFI(BU,8),(8)62,8                                    ! line 23  -B
        B,$+1.32                                             ! line 24
        LFI(BU,8),(8)64,8                                    ! line 25  -D
        BZB,.19($13),$+2.32                                  ! line 26
        LFI(BU,8),(8)24                                      ! line 27  -U
        B,$+1.32                                             ! line 28
        LFI(BU,8),(8)20                                      ! line 29  -BLANK
        SF(BU,16),0($14)                                     ! line 30
        B,ARETRN                                             ! line 31
AMNUS   BB,.38($1),ANEG                                      ! line 32
        BB,.36($1),AINTC1                                    ! line 33
        LF(BU,4),.23($13),64                                 ! line 34
        KFI(BU,4),0,64                                       ! line 35
        BAE,$+2.                                             ! line 36
        LFI(BU,8),(8)40,40                                   ! line 37
        B,AINTC1-1.                                          ! line 38
        LFI(BU,8),(8)40,48                                   ! line 39
        B,AINTC1-1.                                          ! line 40
ANEG    BB,.35($1),AMPYA                                     ! line 41
        LFI(BU,8),(8)45,16                                   ! line 42
        B,AINTC1                                             ! line 43
AMPYA   SF(BU,8),$R.24,40                                    ! line 44
        LFI(BU,8),(8)45,40                                   ! line 45
        B,AINTC1-1.                                          ! line 46
AMPY1A  BB,.20($13),AMPY2A                                   ! line 47
        SF(BU,8),$R.24,40                                    ! line 48
        LFI(BU,8),(8)71,40                                   ! line 49
        LFI(BU,8),(8)71,40                                   ! line 50

