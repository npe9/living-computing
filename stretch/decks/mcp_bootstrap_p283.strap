!CHECK 232130.00 | 000000.13 34 | line 8 SV,LXIO,0.0(LXPP)
!CHECK 232130.40 | 000000.32 8F 232200.34 02 | line 9 BB,0.26($15),LERROR
!CHECK 232131.40 | 232170.10 00 | line 10 B,LFIN3
