!CHECK 232137.40 | 000023.22 00 | line 22 Z,LIODX
!CHECK 232140.00 | 000000.24 34 | line 23 LV,LWORKX,0.0(LXPP)
!CHECK 232140.40 | 231545.53 80 007027.20 50 | line 24 L(BU,7),LCOUNT,46
