!CHECK 232151.40 | 000000.00 89 010000.00 F0 | line 38 CM0000(BU,8),0.0(LXNT),0.0
!CHECK 232152.40 | 231560.23 0D | line 39 V-I,LXNT,LRLCT
!CHECK 232153.00 | 000032.06 30 | line 40 LV,LIODX,LWORKX
!CHECK 232153.40 | 231554.00 89 010000.20 50 | line 41 L(BU,8),LCT(LXNT),0.0
