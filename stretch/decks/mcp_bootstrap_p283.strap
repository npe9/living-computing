!CHECK 232156.40 | 232157.70 42 | line 45 BXCZ,LSEARF
!CHECK 232157.00 | 021111.07 01 | line 46 LVI,LIODX,TUIORQ
!CHECK 232157.40 | 000000.13 83 007000.23 10 | line 47 LSEARF KF(BU,7),.11(LIODX)
