! line  9  -
ZASN01  SIC,ZCOM99                                           ! line 10  (printed "Z CCM 99")
        B,ZCOM01                                             ! line 11  (printed "Z CCM C1")
        BB,SCHAVL($2),ZASN50                                 ! line 12  -BRANCH IF CHAN NOT AVAILABLE
        BB,SUNAVL($1),ZASN50                                 ! line 13  -BRANCH IF UNIT NOT AVAILABLE
        CT0011(BU,2),0.62($1)                                ! line 14
        BRZ,ZASN04                                           ! line 15  -BRANCH IF NOT RESERVED
        CM1111,SCNFCG                                        ! line 16  -SET CONFIGURATION CHANGE BIT
ZASN04  BZBZ,SUNASG($1),ZASN50                               ! line 17  -BR. IF ASSIGNED TO REASSIGN
! line 18  -MAKE ASSIGNED IF UNASSIGNED
        CM1111,SOWNER($1)                                    ! line 19  -SET OWNER TO MCP
        SR,2,SUNAA($1)                                       ! line 20  -PUT UNIT AREA ADDR. IN UST ENTRY
        KV,1,$2                                              ! line 21
        CM0000(BU,8),SVER+.1($1)                             ! line 22  -CLEAR TABLES
        CM0000(BU,7),SRD($1)                                 ! line 23
        BZXE,ZASN06                                          ! line 24  -IF UNEQUAL,BR. FOR MULTI CHAN
ZCOM95  LX,1,ZCOM98                                          ! line 25  -RESTORE INDICES
        LX,2,ZCOM98+1.0                                      ! line 26
ZCOM90  B,$                                                  ! line 27  -RETURN SLOT
ZASN06  CM1111,SMOUNT($1)                                    ! line 28
        CM1111(BU,1),SIMNT($1)                               ! line 29
        CM1111,SVER($1)                                      ! line 30
        CM0000,SDISPO($1)                                    ! line 31
        CM1111,STATI($1)                                     ! line 32
        LVNI,1,0.0                                           ! line 33
        SR,2,$2                                              ! line 34  -SET UNIT AREA ADDR INTO $2 VF
        SV,1,SFILEK($2)                                      ! line 35  -SET FILE COUNT TO -0
        Z,$SB                                                ! line 36
        CM1111(BU,2),$SB+.2                                  ! line 37  -SET ZONE BITS FOR IQS STORE
ZASN52  LCV(BU,18),.1($2)                                    ! line 38  -GET CHANNEL NO.
        ST(DU,16,8),ZASN12-.1                                ! line 39  -STORE CHAN NUM IN MESSAGE
        LCV(BU,3),SUNITN($2)                                 ! line 40  -GET UNIT NUMBER
        ST(DU,8,8),ZASN13-.1                                 ! line 41  -STORE UNIT NUMBER IN MESSAGE  (printed "CU")
        L(BU,26),$TC                                         ! line 42
        ST,SRMTC($2)                                         ! line 43
        CT0011,SYSMOD                                        ! line 44  -TEST MODE
        BRZ,ZASN09                                           ! line 45
        LV,2,ZASN15                                          ! line 46  -LOAD OFFLINE
ZASN07  SV,2,ZASN11                                          ! line 47
        B,DMCP                                               ! line 48

