ZCOM01  SYN, (8)233067.40            ! not landed; B line 11 233067.50, half word only
ZASN50  SYN, (8)233020.40            ! not landed; BB lines 12-13 / BZBZ line 17 233020.74, half word only
ZCOM98  SYN, (8)233105.0             ! not landed; LX lines 25-26 233105.02 / 233106.04, full word only
ZASN12  SYN, (8)233013.10            ! not landed; ST line 39 ZASN12-.1 = 233013.07, BIT-EXACT
ZASN13  SYN, (8)233014.20            ! not landed; ST line 41 ZASN13-.1 = 233014.17, BIT-EXACT
ZASN09  SYN, (8)233017.40            ! not landed; BRZ line 45 233017.74, half word only
ZASN15  SYN, (8)233016.0             ! not landed; LV line 46 233016.04, full word only
ZASN11  SYN, (8)233007.0             ! not landed; SV line 47 233007.05, full word only

        SLC, (8)232746.00
