AWRITB  SYN, (8)235327.40            ! not landed; SIC line 38 235327.40, half word only
AWRITE  SYN, (8)235325.40            ! not landed; B line 39 235325.50, half word only
AFORMT  SYN, (8)235175.40            ! not landed; NOP line 40 AFORMT-.32 = 235175.30, half word only
AMNTOP  SYN, (8)236161.40            ! not landed; LV line 41 236161.74, half word only
ABUFF   SYN, (8)236044.0             ! not landed; LV line 45 ABUFF+32. = 236104.32, half word only
ALCRFB  SYN, (8)235373.0             ! not landed; SIC line 46 235373.00, half word only
ALCRF   SYN, (8)235370.0             ! not landed; B line 47 235370.10, half word only

