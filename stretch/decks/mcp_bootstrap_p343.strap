APUMP6  LV,$1,$0                                             ! line 25
        BZB,.24($1),ALSRQ                                    ! line 26
        LVI,$4,APUML7                                        ! line 27
        SVA,$4,APUML6                                        ! line 28
        V+I,$0,.32                                           ! line 29
        SVA,$0,APUMP9                                        ! line 30
        LVI,$14,APCOL1                                       ! line 31
        SIC,AINTLB                                           ! line 32
        B,AINITL                                             ! line 33
        LVI,$14,AMNMBF                                       ! line 34
        SIC,AINTLB                                           ! line 35
        B,AINITL                                             ! line 36
        LVI,$11,17.                                          ! line 37
        SIC,AWRITB                                           ! line 38
        B,AWRITE                                             ! line 39
APANEL  NOP,AFORMT-.32                                       ! line 40
        LV,$14,AMNTOP                                        ! line 41
! line 42  - PANEL LINE 1
        LFI(BU,16),(8)021463                                 ! line 43  -LC
        SF(BU,16)(V+I),.24($14)                              ! line 44
        LV,$13,ABUFF+32.                                     ! line 45
        SIC,ALCRFB                                           ! line 46
        B,ALCRF                                              ! line 47
        LFI(BU,8),(8)73,8                                    ! line 48  -.
        SF(BU,16),-.16($14)                                  ! line 49
        V+I,$14,.32                                          ! line 50

