        KVI,$12,2.                                           ! line 19
        BZXH,$+1.32                                          ! line 20
        KVI,$12,15.                                          ! line 21
        BZXE,ADLWER                                          ! line 22
        L(BU,4),$12.14,-19                                   ! line 23
