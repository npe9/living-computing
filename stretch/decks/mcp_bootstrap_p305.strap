! mcp_bootstrap_p305.strap -- MCP printed page 305: the tail of the
! console-message stacking code (J PNTOK, R SIC1, R TRANS, R SIC2) and
! the I/O BOOK KEEPING routine M SET IO; lines 1-56.
!
! docs/MCP_Mar63_250-445.pdf PDF p.56, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 11D11MCP  CARD ID SA000153  DIST. OF 3/01
! 3/01  PAGE NUMBER 305" (round glyphs in numeric fields read 0).  The
! heading row's LOCATION field is 233256, line 1's word.
!
! THE PAGE.  56 lines, every line number printing a "*" after it.
! Located rows run contiguous from 233256.40 (line 1) to 233274.00
! (line 24, B,0.0(JXIN1), a half word); remark cards 25-32 (no
! location, a "-" in the NAME column: "***** SET UP I/O BOOK KEEPING
! *****" and its calling linkage); then 233274.40 (line 33, M SET IO)
! to 233310.00 (line 48, B,0.0(JXIN1), a half word); remark cards
! 49-56 ("*****CONSOLE I/O TERMINATION ROUTINE*****" and its linkage).
! Lines 18 (233270.00) and 42 (233303.00) print an asterisk after the
! LOCATION; recorded, not explained.
!
! JOIN.  p.306 (scratch) opens at 233310.40 with J TERM, so this page's
! last half word 233310.00 meets it.  p.304 has no scratch deck;
! contiguity at 233256.40 is NOT established here.
!
! COMMENT MARKS.  Lines 12 "T,JXTEM2,$,JSTACK-", 13 "LV,JXTEM,JSTKP-"
! and 14 "V-I,JXTEM,$-" print a "-" right after the statement (the
! comment mark, C28-6129 PDF p.5); written without it.  Lines 4, 7, 9
! and 16 print a blank then a lone "-" (an empty remark).
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * octal-field open rounds ("CCC024.12", "C00000.22") are 0; hex
!     "CO"/"DO"/"FO"/"BO" are C0/D0/F0/B0 where the statement assembles
!     them so.
!   * line 9 "CMOCOO(BU,3)", lines 38, 45 "CMOCOO" = CM0000 (connective
!     digits).
!   * line 33's label prints "M SET IO" (spaces the drum's); C22-6728
!     typesets "The I-O Bookkeeping Routine, MSETIO".  Line 30's remark
!     prints "B,MSETIC" (open O); a remark, left as printed.
!   * line 1's label "J PNTCK" (open O) = JPNTOK ("POINTER OK"; no
!     other spelling anywhere).
!   * "JSCWD1"/"JSCWD2", "JCNAD", "MRETAD", "SRETAD", "ADDRESS": a D
!     with a worn stem; JSCWD1/2 are p.309's (scratch) line 33-34
!     labels, JCNAD landed (p.122/p.128), SRETAD landed (p.101).
!
! EXTERNALS.  Index registers from p.306/p.309/p.310 (scratch) SYN,$n
! cards, each confirmed by this page's binary (LV J field 2J: .10 $4,
! .12 $5, .20 $8, .22 $9, .24 $10; B/BZXH low nibble 1 = $1).  p.309
! (scratch) defines JSCWD1/2 (XW), JSTKP/JSTWP/JMESM (VF), JSTACK
! (DR(N)); stand-ins carry the dds the compiler fixes.  MRETAD is from
! this page's binary only.
!
! CARD SERIALS.  SA000153 .. SA000208, line N prints SA0001(52+N); none
! skipped, none repeated.

JXIN1   SYN,$1                       ! p.306/p.309 scratch "JXIN1 SYN,$1"; B line 24 byte 01
JXTEM   SYN,$4                       ! p.306/p.309 scratch "JXTEM SYN,$4"; LV line 13 .10
JXTEM2  SYN,$5                       ! p.310 scratch line 1; LV line 2 .52 = 233454.40 + .12
MXCST   SYN,$8                       ! p.310 scratch line 4; LV line 33 .20
MXUST   SYN,$9                       ! p.310 scratch line 5; LV line 36 .22
MXUAT   SYN,$10                      ! p.310 scratch line 6; LV line 37 .24
JSIZSW  SYN,120.0                    ! p.310 scratch line 11; KVI line 21 JSTACK+JSIZSW = 233666.0
JSCWD1  SYN(BU), (8)233452.0         ! p.309 scratch line 33 XW; CM line 9/18 JSCWD1.25 = 233452.31, BIT-EXACT
JSCWD2  SYN(BU), (8)233453.0         ! p.309 scratch line 34 XW; SX line 16 233453.13
JSTKP   SYN(B,25,1), (8)233454.0     ! p.309 scratch line 35 VF; SV line 1 233454.11
JSTWP   SYN(B,25,1), (8)233454.40    ! p.309 scratch line 36 VF; LV line 2 233454.52
JMESM   SYN(B,25,1), (8)233455.0     ! p.309 scratch line 37 VF; V+ line 20 233455.10
JSTACK  SYN, (8)233476.0             ! p.309 scratch line 41 DR(N); V-I line 5 233476.13
JWAIT   SYN, (8)233666.00            ! landed p.184 stand-in; CM1111 line 23 BIT-EXACT, no dds
SCHANS  SYN, (8)215002.0             ! landed p.103 (SYN,SXCHAN); LV line 33 215002.20
JCNAD   SYN, (8)215006.0             ! landed p.122/p.128; V+ lines 34-35 215006.20
SSEL    SYN(BU,1), 0.39              ! landed p.99 -SELECT; CM line 38 000000.47
SCHOP   SYN(BU,1), 0.26              ! landed p.99 -CHAN OPERATING; CM line 40 .32
SSETUP  SYN(BU,1), 0.31              ! landed p.99 -PSEUDO-OP SET-UP; CM line 41 .37
SWR     SYN(BU,1), 0.58              ! landed p.99 -WRITE; CM line 42 .72
SRETAD  SYN(BU,19), 5.0              ! landed p.101 -RETURN ADDRESS; SV line 44 000005.13
SUNIT   SYN(BU,3), 0.56              ! landed p.99 -UNIT NUMBER; CM line 45 .70
SIOINS  SYN(BU,64), 4.0              ! landed p.101 -IO INSTR. LAST; ST line 47 000004.00
MRETAD  SYN, (8)233421.0             ! not landed; LVI line 43 233421.13, half word only

        SLC, (8)233256.40
JPNTOK  SV,JXTEM,JSTKP                                       ! line  1  -POINTER NOW AT FULL WA.
        LV,JXTEM2,JSTWP                                      ! line  2
        SVA,JXTEM2,RTRANS                                    ! line  3  -TRANS START ADDRESS
        SVA,JXTEM2,RSIC1                                     ! line  4  -
        V-I,JXTEM2,JSTACK                                    ! line  5
        SVA,JXTEM2,RSIC2                                     ! line  6
        LVI,JXTEM2,JSTACK                                    ! line  7  -
        SV,JXTEM2,JSTWP                                      ! line  8  -RESET WRITE TO ORIGIN
        CM0000(BU,3),JSCWD1.25                               ! line  9  -  (printed "CMOCOO")
RSIC1   V-I,JXTEM,$                                          ! line 10  - CALC COUNT
        LC,JXTEM2,JXTEM                                      ! line 11  - COUNT FOR TRANS + WRITE
RTRANS  T,JXTEM2,$,JSTACK                                    ! line 12  (comment mark "-" after)
        LV,JXTEM,JSTKP                                       ! line 13  (comment mark "-" after)
RSIC2   V-I,JXTEM,$                                          ! line 14  (comment mark "-" after)
        SV,JXTEM,JSTKP                                       ! line 15  -RESET STACK POINTER
        SX,JXTEM2,JSCWD2                                     ! line 16  -
        BXCZ,$+1.32                                          ! line 17  -LEAVE CHAIN OFF,IF COUNT ZERO
        CM1111(BU,1),JSCWD1+.25                              ! line 18  -TURN CHAIN BIT ON  (prints 233270.00 *)
        LV,JXTEM,JSTKP                                       ! line 19  -STACK POINTER
        V+,JXTEM,JMESM                                       ! line 20  -PLUS LENGTH OF LARGEST MESSAGE
        KVI,JXTEM,JSTACK+JSIZSW                              ! line 21
        BZXH,0.0(JXIN1)                                      ! line 22  -IF ROOM FOR NEXT MESSAGE
        CM1111(BU,1),JWAIT                                   ! line 23  -IF FULL,TURN ON WAIT BIT
        B,0.0(JXIN1)                                         ! line 24
! line 25  -
! line 26  - ***** SET UP I/O BOOK KEEPING *****
! line 27  -
! line 28  - LINKAGE...LVI,JXIN1,$+1.32
! line 29  - LVI,JXTEM,I/O ADDRESS
! line 30  - B,MSETIC   (printed so; the routine is M SET IO, line 33)
! line 31  - RETURN
! line 32  -
MSETIO  LV,MXCST,SCHANS                                      ! line 33  -BASE OF CST  (printed "M SET IO")
        V+,MXCST,JCNAD                                       ! line 34  -FORM CST ENTRY
        V+,MXCST,JCNAD                                       ! line 35  -ADDRESS
        LV,MXUST,0.0(MXCST)                                  ! line 36  -UST ENTRY ADDRESS
        LV,MXUAT,0.0(MXUST)                                  ! line 37  -UAT ADDRESS
        CM0000(BU,1),SSEL(MXUST)                             ! line 38  -SELECT MCP UNIT
        CM1111(BU,1),SSEL+1.0(MXUST)                         ! line 39  -UNSELECT PP UNIT
        CM1111(BU,1),SCHOP(MXCST)                            ! line 40
        CM1111(BU,1),SSETUP(MXUST)                           ! line 41
        CM1111(BU,1),SWR(MXUST)                              ! line 42  (prints 233303.00 *)
        LVI,JXTEM2,MRETAD                                    ! line 43  -SET RETURN
        SV,JXTEM2,SRETAD(MXUAT)                              ! line 44  -UPON INTERRUPT
        CM0000(BU,3),SUNIT(MXCST)                            ! line 45
        L(BU,64),(JXTEM)                                     ! line 46
        ST(BU,64),SIOINS(MXUAT)                              ! line 47
        B,0.0(JXIN1)                                         ! line 48
! line 49  -
