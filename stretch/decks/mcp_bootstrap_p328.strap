!CHECK 235101.00 | 235102.33 40 | line 37 BZXH,$+1.
!CHECK 235101.40 | 232554.07 D0 | line 38 SVA,$3,AHIWD
!CHECK 235102.00 | 232552.47 D0 | line 39 SVA,$3,ALDTC
!CHECK 235102.40 | 235233.10 00 | line 40 B,ANORMR (byte prints "C0" = 00)
!CHECK 235103.00 | 000000.03 82 304000.00 F0 | line 41 AOCTZ CM0000(BU,4)(V+ICR),.3($2) (h2 prints "304000.CC FO" = 00 F0; printed "CMOCOO")
!CHECK 235104.00 | 235054.50 00 | line 42 B,AOCTL2
