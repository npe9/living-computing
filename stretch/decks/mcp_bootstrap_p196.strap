ZID09   SYN, (8)221042.0             ! landed pp.166/179/184; line 11 B, half word only
ZID16   SYN, (8)221062.0             ! p.180 line 22 defines it; NO dds -- see EXTERNALS
SCREEL  SYN(BU,18), 8.32             ! landed; p.101 line 28 -CURRENT REEL ADDRESS
KEXTAP  SYN, (8)222015.0             ! landed p.179; p.197 line 25 defines it
KREELN  SYN, (8)222006.0             ! NEW -- BIT-EXACT off lines 21/24/26; p.197 line 20
KCUSTM  SYN, (8)221766.40            ! NEW -- line 17 BXVZ, half word only; p.197 line 1
KKTAPE  SYN, (8)221775.0             ! NEW -- line 19 BRZ, half word only; p.197 line 11
SA8IQS  SYN, (8)230566.0             ! landed p.147 line 39, same half word
KCONVR  SYN, (8)221350.0             ! landed; line 30 SIC -- BIT-EXACT
KCONV   SYN, (8)221335.0             ! landed; line 31 B, half word only
SIOINS  SYN(BU,64), 4.0              ! landed; p.101 line 17 -IO INSTR. LAST
MIOREJ  SYN, (8)221261.0             ! landed; line 38 B, half word only
KEOPR   SYN, (8)221354.40            ! landed; line 39 SIC -- BIT-EXACT
KSEOPT  SYN, (8)221350.40            ! landed; line 40 B, bit 32 SET
SCOMIC  SYN, (8)215470.40            ! landed; line 41 SIC -- BIT-EXACT
SCOMM   SYN, (8)215470.0             ! landed; line 42 B, half word only
SRMTC   SYN(BU,26), 1.32             ! landed p.101/179 -- THE dds IS LOAD-BEARING (line 46)
SRMIND  SYN(BU,1), 1.63              ! landed p.101/179 -- THE dds IS LOAD-BEARING (line 47)
KSUPP   SYN, (8)216242.0             ! landed, 37 decks; p.128 defines it

! ---------------- the page ----------------
        SLC, (8)221733.0             ! NOT PRINTED.  Line 4 is simply the first
                                     ! located card.  CHECKED by the merge -- see THE JOIN
! lines 1-3 are the banner: "*****  U N L O A D  *****"
KUNLOD  LV,2,KULMES                  ! line  4   printed name "K UNLOD"
        SLC,$                        ! line  5 * printed; emits nothing
        CM1111(BU,1),SMOUNT($11)     ! line  6
        LVI,5,KUNLM                  ! line  7   printed "K UNL M"
        BB,SOWNER($11),ZUNLO1        ! line  8   printed "Z UNLO1"
        LVI,7,ZUNLO2                 ! line  9   printed "Z UNL O2"
        SIC,ZID09X                   ! line 10   one card with line 11
        B,ZID09                      ! line 11   -CONVERT NAME
        B,ZUNLO3                     ! line 12   printed "Z UNL O3"
ZUNLO1  TI,1,ZID16,ZUNLO2            ! line 13   printed "Z UNLO1" / "Z ID16" / "Z UNLO2"
ZUNLO3  LVI,7,9.                     ! line 14   printed "Z UNLO3"
KFUNLD  LV,9,SCREEL($12)             ! line 15   printed "K F UNLD" / "S C REEL"
        LV,8,0.0($9)                 ! line 16   -ADDR OF NEXT REEL NAME
        BXVZ,KCUSTM                  ! line 17   -IF SCRATCH NEEDED
KRITET  LF(BU,30,6),.34($8)          ! line 18   printed "K RITE T"; -IF NOT, GET NEW REEL NO
        BRZ,KKTAPE                   ! line 19
        TI,2,KEXTAP,KREELN           ! line 20   printed "K EX TAP" / "K REEL N"
        SF(BU,40),KREELN+.72         ! line 21   printed "KREELN" CLOSED UP on this card
        LVI,15,$+1.0                 ! line 22 * one card with line 23
        B,SA8IQS                     ! line 23   printed "S A8 IQS"
        VF,KREELN+.72                ! line 24   argument 1
        CF,5                         ! line 25   argument 2
        VF,KREELN+.72                ! line 26   argument 3
KUNLD1  BZB,.26($8),$+1.32           ! line 27   printed "K UNLD1"; -TEST IF PROTECTED
        LVI,7,10.                    ! line 28   -FILE PROTECT MESSAGE LENGTH
        SV,2,$+1.32                  ! line 29
        SIC,KCONVR                   ! line 30   one card with line 31
        B,KCONV                      ! line 31
        VF,0.0                       ! line 32   the call's argument word
        CNOP                         ! line 33   emits a HALF WORD here (the counter is at .40)
        LX,0,$+1.0                   ! line 34   one card with line 35
        SX,0,SIOINS($12)             ! line 35
! >>> LINE 36 IS A SUBSTITUTION.  THE PAGE PRINTS:
! >>>     K FIRE  UNLOAD(SEOP),0.0($14)
! >>> and strap_asm refuses both "UNLOAD(SEOP),..." ("unknown
! >>> data-description mode 'SEOP'") and "UNLOAD,..." ("unknown
! >>> mnemonic").  The CTL form below compiles the printed word
! >>> exactly; see THE UNLOAD PROBLEM above.  printed p.165 did the
! >>> same for REW before REW was admitted.
KFIRE   CTL(SEOP),0.0($14),(8)137.   ! line 36   printed "K FIRE UNLOAD(SEOP),0.0($14)"
        LVI,1,$+1.0                  ! line 37   one card with line 38
        B,MIOREJ                     ! line 38   printed "M IO REJ"
        SIC,KEOPR                    ! line 39   printed "K EOP R"; one card with line 40
        B,KSEOPT                     ! line 40   printed "K SEOP T"
        SIC,SCOMIC                   ! line 41   printed "S COMIC"; one card with line 42
        B,SCOMM                      ! line 42   printed "S COMM"
        ,0.0($5)                     ! line 43 * BLANK OPERATION FIELD, as printed
        ,0.0($7)                     ! line 44   BLANK OPERATION FIELD, as printed
        L(BU,26),$TC                 ! line 45   -SET TIME FOR REMINDER MESSAGE
        ST,SRMTC($12)                ! line 46   printed "S RMTC"; length 26 comes from the dds
        CM0000,SRMIND($12)           ! line 47   printed "S RMIND"; -CLEAR INDICATOR
KNEWTP  B,KSUPP                      ! line 48   printed "K NEW TP"

