!CHECK 235434.00 | 236244.50 81 040000.06 70 | line 13 LF(BU,32),ABRBTB($1)
!CHECK 235435.00 | 000000.00 8E 040000.12 F0 | line 14 SF(BU,32),($14)
!CHECK 235436.00 | 235377.10 00 | line 15 B,ARETRN
!CHECK 235436.40 | 000000.73 8D 235450.74 02 | line 16 AFULL2 BB,.59($13),AFULL4
