!CHECK 231176.40 | 230566.04 00 | line 10 BD,SA8IQS
!CHECK 231177.00 | 000000.00+ | line 11 YPRCNV VF,0 (printed "CCCCCC.00+")
!CHECK 231177.40 | 000100 | line 12 CF,64
!CHECK 231200.00 | 231205.00+ | line 13 VF,YPRCMM
!CHECK 231200.40 | 000040.00 00 | line 14 BE,$MCP
!CHECK 231201.00 | 000043.40 80 | line 15 ,$COMM (printed "$CCMM")
!CHECK 231201.40 | 231205.00 80 | line 16 ,YPRCMM
!CHECK 231202.00 | 000010.00 80 | line 17 ,8.
!CHECK 231202.40 | 224052.00 80 | line 18 YPRSPL SIC,ZSPLP9
!CHECK 231203.00 | 224046.44 00 | line 19 BD,ZSPLPR
!CHECK 231203.40 | 000000.00 81 | line 20 ,0($1)
!CHECK 231204.00 | 000010.00 80 | line 21 ,8.
!CHECK 231204.40 | 000000.00 00 | line 22 YPRRET BE,0 (printed "BE,C")
!CHECK 231215.00 | 000033.00 80 231363.06 A0 | line 27 YUNCOD TI,3,$11,YUXSAV (last byte prints "AC")
!CHECK 231216.00 | 000001.73 BE | line 28 LVE,$13,1.32($14)
!CHECK 231216.40 | 000000.00 8D 014000.20 50 | line 29 L(BU,12),0.0($13)
!CHECK 231217.40 | 420000.00 80 414000.23 10 | line 30 KFI(BU,12),(2)100010000000
!CHECK 231220.40 | 231350.36 C4 | line 31 BZAEZ,YUER
!CHECK 231221.00 | 231223.33 30 | line 32 SV,$13,YUECS
!CHECK 231221.40 | 000001.32 3E | line 33 LV,$13,1.0($14)
!CHECK 231222.00 | 231223.37 01 | line 34 LVI,$15,$+1.0
!CHECK 231222.40 | 230622.04 00 | line 35 BD,SCA6
