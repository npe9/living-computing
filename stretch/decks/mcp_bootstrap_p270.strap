!CHECK 231173.00 | 000000.14 02 | line 5 BR,0($2) (printed "BR,C($2)")
!CHECK 231173.40 | 215001.10 80 231202.74 00 | line 6 BZB,SYSMOD,YPRSPL
!CHECK 231174.40 | 215001.11 80 231202.74 02 | line 7 BB,SYSMOD.1,YPRSPL
!CHECK 231175.40 | 231177.03 30 | line 8 SV,1,YPRCNV
