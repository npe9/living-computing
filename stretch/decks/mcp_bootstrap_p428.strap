! mcp_bootstrap_p428.strap -- MCP printed page 428: the $EOJ program's
! reassembly of the tape ASSIGN routine's disk/track arc allocation
! (TMDK3 .. TMDK1A), the "TRACK ANALYSER" (TMDK2, TMNULD, TMTRK) and the
! exits TM1FA, TOK, TMDSK3.
!
! docs/MCP_Mar63_250-445.pdf PDF p.178, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZF000534  DIST. OF 3/01
!  3/01  PAGE NUMBER 428"; the heading row's LOCATION field is 022550,
! line 1's word.
!
! >>> CARD SERIES ZF (as pp.416-425), PUNID 22$EOJ.  No SLC, no PUNID on
! the page; the origin below is line 1's printed LOCATION.  No TAIL. <<<
!
! THE PAGE.  50 lines, every line number prints a "*"; a further "*"
! after the LOCATION on lines 3, 17, 39 (recorded, not interpreted).
! Contiguous 022550.00 .. 022605.40 (line 50, a half word; next location
! 022606.00).  Lines 18-23 (21-23 the boxed banner "TRACK ANALYSER"),
! 29, 35, 41, 44, 47, 48 are remarks.  The same source as volume 1
! pp.92-93 (TMDK3 .. B,TMREJB), here with 17-bit arc fields.
!
! CARD SERIALS.  ZF000534 .. ZF000583, one per line, consecutive.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!  * line 6 prints "TMCSK3" = TMDSK3 (worn D): line 49 defines T MDSK3
!    at 022605.00 and BAH's binary is 022605.37.
!  * line 43 prints "TMXC" = TMXD (worn D): the V+I binary 000007.13
!    names index 5 = TMXD (TMXC is $4); volume 1 p.93 line 23 reads TMXD.
!  * lines 24, 36 print "CTOC11"/"CT0C11" = CT0011 (open 0s); the
!    connective byte 70 and the identical line-36 assembly confirm.
!  * line 45 label "T CK"/"T OK": open glyph; volume 1 p.93 line 25's
!    spelling TOK, remark "-OK RETURN".
!  * TMDK, TMDK1A, TMDK2, TMXD, TCUARC, TDSKRF etc. print D with the stem
!    worn (C-like); read as D throughout, as volume 1 pp.92-93 spell them.
!
! EXTERNALS.  Copied in their DEFINING forms from the $EOJ scratch decks
! (p.418: TMXn index names, TMMAX DD, TLIMB SYN,SBAPP; p.419: TSBDTB/
! TSBDFT, TDSKRF, TDTRK, TIREF; p.420: TMXARC, TORARC, TCUARC, TFMODE;
! p.425: TMREJB).  Each agrees with this page's binary.

TMX1    SYN,$1                       ! p.418 line 22; LV line 11 000011.02 30
TMXD    SYN,$5                       ! p.418 line 26; byte 85, V+I line 43 .13
TMXG    SYN,$8                       ! p.418 line 29; byte 88
TMXI    SYN,$10                      ! p.418 line 31; byte 8A
TMXGA   SYN,$11                      ! p.418 line 32; byte 8B
SBAPP   SYN(B,25,1), (8)215005.0     ! landed p.103 line 35 "S BAPP VF,0"; + line 10 215005.00
TLIMB   SYN,SBAPP                    ! p.418 line 16 (defining form)
TMMAX   SYN(BU,17), (8)022131.0      ! p.418 line 8 DD(BU,17) at 022131.00; KF line 5, LF line 32
TSBDTB  SYN(BU,32), (8)022240.0      ! p.419 line 11 DRZ(BU,32) at 022240.00
TSBDFT  SYN(BU,17),TSBDTB            ! p.419 line 12 (defining form); ST line 3 022240.00, 021
TDSKRF  SYN(BU,12),25.48             ! p.419 line 4; L line 8 000031.60, 014
TDTRK   SYN(BU,1),25.60              ! p.419 line 5; BB line 14 000031.74
TIREF   SYN(BU,12),0.52              ! p.419 line 19; LF line 30 000000.64
TMXARC  SYN(BU,17),5.33              ! p.420 line 12; ST line 7 000005.41
TORARC  SYN(BU,17),5.01              ! p.420 line 11; ST line 16 000005.01
TCUARC  SYN(BU,17),6.01              ! p.420 line 13; ST line 15 000006.01
TFMODE  SYN(BU,2),2.48               ! p.420 line 10; CM1111 line 42 000002.61
TMDK    SYN, (8)022536.0             ! not seen (p.426/427); BRZ line 37 022536.34, B line 40 .10, half word only
TN2     SYN, (8)022766.0             ! not seen; B line 46 022766.10, half word only
TMREJB  SYN, (8)022721.0             ! p.425's stand-in; B line 50 022721.10, half word only

        SLC, (8)022550.00
        B,TMDK4                                              ! line  1
TMDK3   +(BU,17),$R+.47,67                                   ! line  2  -ADD THE CONVERTED NUMBER - TRACK -
TMDK4   ST,TSBDFT(TMXGA),64                                  ! line  3  -UP DATE THE COUNTER
        M-1(BU,17),$L+.47                                    ! line  4
        KF,TMMAX,64                                          ! line  5  -LOOK FOR ILLEGAL DISK REQUEST
        BAH,TMDSK3                                           ! line  6  -YES (printed "TMCSK3")
        ST,TMXARC(TMXD),64                                   ! line  7  -STORE THE MAXIMUM ARC
        L,TDSKRF(TMXG),46                                    ! line  8  -GET THE REF NO.OF NULL IOD
        BRZ,TM1FA                                            ! line  9  -IF NONE
        +(BU,18),TLIMB,46                                    ! line 10  -ADD THE BASE ADDRESS OF THE SIOL TBL
        LV,TMX1,$R                                           ! line 11
        LV,TMX1,.32(TMX1)                                    ! line 12  -GET THE FILE AREA OF THE NULL IOD
        LF,TSBDFT(TMXGA)                                     ! line 13  -GET LAST COUNTER
        BB,TDTRK(TMXG),TMDK2                                 ! line 14  -IF TRACK
TMDK1A  ST,TCUARC(TMX1)                                      ! line 15  -UPDATE CURRENT ARC
        ST,TORARC(TMX1)                                      ! line 16  -UPDATE ORIGINAL ARC
        B,TM1FA                                              ! line 17
! line 18  -
! line 19  -
! line 20  -
! line 21  - ----------------------------------------------------------
! line 22  -              TRACK ANALYSER
! line 23  - ----------------------------------------------------------
TMDK2   CT0011(BU,3),$R+.61                                  ! line 24  -CHECK FOR MULTIPLE OF 8 (printed "CTOC11")
        BRZ,TMDK1A                                           ! line 25  -YES
        CM0000(BU,3),$R+.61                                  ! line 26  -ZERO THE TRIVIAL BITS
        M+1(BU,9),$R+.52                                     ! line 27  -ADD NEXT BEGINNING TRACK LOC
        B,TMDK1A                                             ! line 28
! line 29  -
TMNULD  LF,TIREF(TMXI)                                       ! line 30  -IF NULL DISK OR TRACK ,GET REF NO.
        ST,TDSKRF(TMXG)                                      ! line 31
        LF,TMMAX                                             ! line 32  -GET THE MAX DISK NUMBER POSSIBLE
        ST,TMXARC(TMXD)                                      ! line 33
        B,TM1FA                                              ! line 34
! line 35  -
TMTRK   CT0011(BU,3),$L+.61                                  ! line 36  -CHECK FOR MULTIPLE OF 8 (printed "CTOC11")
        BRZ,TMDK                                             ! line 37  -YES - RETURN
        CM0000(BU,3),$L+.61                                  ! line 38  -NO ZERO THE TRIVIAL BITS
        M+1(BU,9),$L+.52                                     ! line 39  -ADD ON TO GET NEXT BEGINNING TRACK L
        B,TMDK                                               ! line 40
! line 41  -
        CM1111(BU,1),TFMODE+.1(TMXD)                         ! line 42  -A DUMMY ONE FOR ALL BUT TAPE
TM1FA   V+I,TMXD,7.0                                         ! line 43  -STEP THE VF BY A FILE TABLE (printed "TMXC")
! line 44  -
TOK     LVI,TMX1,0.0                                         ! line 45  -OK RETURN
        B,TN2                                                ! line 46
! line 47  -
! line 48  -
TMDSK3  LVI,TMX1,1.0                                         ! line 49  -ILLEGAL DISK REQ
        B,TMREJB                                             ! line 50  -GO TO REJECT JOB

!SYM TMDK3  022550.40
!SYM TMDK4  022551.40
!SYM TMDK1A 022563.40
!SYM TMDK2  022566.00
!SYM TMNULD 022572.00
!SYM TMTRK  022576.40
!SYM TM1FA  022603.40
!SYM TOK    022604.00
!SYM TMDSK3 022605.00
!CHECK 022550.00 | 022551.50 00 | line 1 B,TMDK4
!CHECK 022550.40 | 000011.57 80 021041.60 10 | line 2 T MDK3 +(BU,17),$R+.47,67
!CHECK 022551.40 | 022240.00 8B 021040.20 D0 | line 3 T MDK4 ST,TSBDFT(TMXGA),64
!CHECK 022552.40 | 000010.57 80 021000.32 B0 | line 4 M-1(BU,17),$L+.47
!CHECK 022553.40 | 022131.00 80 021040.23 10 | line 5 KF,TMMAX,64
!CHECK 022554.40 | 022605.37 42 | line 6 BAH,TMDSK3 (printed "TMCSK3")
!CHECK 022555.00 | 000005.41 85 021040.20 D0 | line 7 ST,TMXARC(TMXD),64
!CHECK 022556.00 | 000031.60 88 014027.20 50 | line 8 L,TDSKRF(TMXG),46
!CHECK 022557.00 | 022603.74 C2 | line 9 BRZ,TM1FA
!CHECK 022557.40 | 215005.00 80 022027.20 10 | line 10 +(BU,18),TLIMB,46
