!CHECK 022561.00 | 000000.42 31 | line 12 LV,TMX1,.32(TMX1)
!CHECK 022561.40 | 022240.00 8B 021000.06 70 | line 13 LF,TSBDFT(TMXGA)
!CHECK 022562.40 | 000031.74 88 022566.34 02 | line 14 BB,TDTRK(TMXG),TMDK2
!CHECK 022563.40 | 000006.01 81 021000.20 D0 | line 15 T MDK1A ST,TCUARC(TMX1)
!CHECK 022564.40 | 000005.01 81 021000.20 D0 | line 16 ST,TORARC(TMX1)
!CHECK 022565.40 | 022603.50 00 | line 17 B,TM1FA
!CHECK 022566.00 | 000011.75 80 003000.07 70 | line 24 T MDK2 CT0011(BU,3),$R+.61
!CHECK 022567.00 | 022563.74 C2 | line 25 BRZ,TMDK1A
!CHECK 022567.40 | 000011.75 80 003000.00 F0 | line 26 CM0000(BU,3),$R+.61
!CHECK 022570.40 | 000011.64 80 011000.22 B0 | line 27 M+1(BU,9),$R+.52
!CHECK 022571.40 | 022563.50 00 | line 28 B,TMDK1A
!CHECK 022572.00 | 000000.64 8A 014000.06 70 | line 30 T MNULD LF,TIREF(TMXI)
!CHECK 022573.00 | 000031.60 88 014000.20 D0 | line 31 ST,TDSKRF(TMXG)
!CHECK 022574.00 | 022131.00 80 021000.06 70 | line 32 LF,TMMAX
!CHECK 022575.00 | 000005.41 85 021000.20 D0 | line 33 ST,TMXARC(TMXD)
!CHECK 022576.00 | 022603.50 00 | line 34 B,TM1FA
!CHECK 022576.40 | 000010.75 80 003000.07 70 | line 36 T MTRK CT0011(BU,3),$L+.61
!CHECK 022577.40 | 022536.34 C2 | line 37 BRZ,TMDK
!CHECK 022600.00 | 000010.75 80 003000.00 F0 | line 38 CM0000(BU,3),$L+.61
!CHECK 022601.00 | 000010.64 80 011000.22 B0 | line 39 M+1(BU,9),$L+.52
!CHECK 022602.00 | 022536.10 00 | line 40 B,TMDK
!CHECK 022602.40 | 000002.61 85 001000.36 F0 | line 42 CM1111(BU,1),TFMODE+.1(TMXD)
!CHECK 022603.40 | 000007.13 05 | line 43 T M1FA V+I,TMXD,7.0 (printed "TMXC")
