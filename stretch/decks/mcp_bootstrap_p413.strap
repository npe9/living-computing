! mcp_bootstrap_p413.strap -- MCP printed page 413: the $EOJ program's
! reassembly of the tape ASSIGN routine's CONVERT THE CHANNEL FIELDS
! (T P5A .. T P4): channel and unit numbers to IQS characters, the reel
! number through SA8IQS, and the tape's mounted/verify/scratch bits.
!
! docs/MCP_Mar63_250-445.pdf PDF p.163, read at 400 dpi.  Header, READ:
! "TIME CLOCK 00054041  PUNID 22$EOJ  CARD ID ZE000746  DIST. OF 3/01
!  3/01  PAGE NUMBER 413"; the heading row's LOCATION field is BLANK
! (lines 1-3 are a remark banner).
!
! STILL $EOJ: PUNID 22$EOJ, card series ZE, low core 0220xx, no SLC on
! the page -- the origin below is line 4's printed LOCATION.  No TAIL.
!
! THE PAGE.  56 lines, every line number prints a "*"; a "*" after the
! LOCATION on lines 10, 27 and 44.  Contiguous 022013.00 .. 022057.00
! (line 56, a full word; next location 022060.00).  p.412 is not landed
! and p.414 not seen: contiguity with neither neighbour is established.
!   lines  1-3   remark banner; lines 16, 20, 21, 26, 28, 40, 47, 54
!   are lone "-" remarks; line 7 prints a lone "-" remark after BZXE.
!   The same routine is volume 1's printed p.78
!   (decks/mcp_bootstrap_p78.strap, at 0045xx); this is a DIFFERENT
!   ASSEMBLY and a different text: p.78's KF,TLBL / BAE / CM0000 TVER
!   (its lines 29-31) are not here, and here T P4 is DEFINED (line 55).
!   Only spellings were taken from volume 1.
!
! CARD SERIALS.  ZE000746 .. ZE000801, one per line, consecutive.
! (p.409 ends at ZE000609; pp.410-412 lie between.)
!
! FOUR "$"-PREFIXED OPERATIONS (C28-6129 printed p.10, error marks
! suppressed): lines 8 ($L), 9 ($-), 10 ($SF), 11 ($CV) -- the same
! four rows volume-1 p.78 prints with "$".  All four are written as
! printed: strap_asm accepted "$" only before a letter until this
! page, and the assembly died on "$-" (the merge widened the rule).
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * line 6 KVI prints "021106.C5 C4"; the deck checks .05 04.  At 900
!     dpi the hex byte's first glyph is the same open round as the
!     octal ".C5" (where only 0 can stand) and as 021106's leading 0;
!     the plainly printed KVI,TXA,TPURFT assembles 04 (and volume-1
!     p.78 line 7 prints this same row's byte as 04).  Line 7's BZXE
!     "C0" and lines 24/49 BRZ "C2" are REAL C (the ops assemble C0/C2).
!   * line 43 "TFCISP" = TFDISP (D with worn stem; p.289 line 9).
!   * open O/0 in CM0000/C0011/CT0011 and TP5OUT read by the op/symbol.
!
! EXTERNALS.  Resident field symbols and index words copied in their
! defining forms (pp.99, 103, 287-289); TPURFT from staged p.398 (XW).
! Symbols defined on $EOJ pages not yet landed (TXA, TXB, TXC, TIXZ,
! TP3, TCHANX, TUNITX, TREELX, TMBLK, TSCRAT, TNOP, TP5IN, TP5OUT,
! TPSAV) are stood in from THIS page's binary; index registers from the
! index byte each row prints.

TCTWDX  SYN,TX1                      ! landed p.287 line 29
TX1     SYN,$10                      ! landed p.287 line 30
TXA     SYN,$2                       ! not landed; KVI line 6 J field (BIT-EXACT)
TXB     SYN,$3                       ! not landed; byte 83 lines 8, 17, 23
TXC     SYN,$4                       ! not landed; byte 84 lines 22, 43, 44, 48, 53, 55, 56
TIXZ    SYN,$5                       ! not landed; byte 85 lines 27, 45; LV line 25
TPURFT  SYN(BU), (8)021106.0         ! staged p.398 line 16 XW; KVI line 6 021106
TABSCH  SYN(BU,18),0.46              ! landed p.288 line 37
TABSUN  SYN(BU,3),0.07               ! landed p.288 line 32
TFREEL  SYN(BU,18),0.28              ! landed p.288 line 36
TREELN  SYN(BU,48),0.00              ! landed p.288 line 45
TVER    SYN(BU,1),0.40               ! landed p.289 line 14
TFDISP  SYN(BU,1),0.27               ! landed p.289 line 9
STATI   SYN(BU,1), 0.26              ! landed p.99 line 23
SMOUNT  SYN(BU,1), 0.51              ! landed p.99 line 42
SIMNT   SYN(BU,1), 0.53              ! landed p.99 line 44
SXCHAN  SYN(BU), (8)215002.0         ! landed p.103 line 28 XW; line 9 215002.00
TCHSXW  SYN,SXCHAN                   ! landed p.289 line 5 (defining form)
TIPL    SYN(B,25,1), (8)232225.0     ! landed p.287 line 8 VF; line 10 232225.01 = TIPL+1
SA8IQS  SYN, (8)230566.0             ! landed p.260 label; BD line 32 230566.04
TP3     SYN, (8)022076.0             ! not landed; BZXE line 7 / BRZ line 49, half word only
TCHANX  SYN(BU,24,8), (8)021742.10   ! not landed; CM0101 line 15 (no dds printed) prints 021742.10 and length 24, BIT-EXACT
TUNITX  SYN, (8)021743.20            ! not landed; line 19 021743.20
TREELX  SYN(BU,64,8), (8)021737.50   ! not landed; CM0101 line 51 (no dds printed) prints 021737.50 and length 64, BIT-EXACT
TMBLK   SYN, (8)021733.0             ! not landed; line 41 021733.00
TSCRAT  SYN, (8)021746.0             ! not landed; line 50 021746.00
TNOP    SYN, (8)022132.07            ! not landed; line 52 022132.07
TP5IN   SYN, (8)021760.0             ! not landed; line 30 021760.00
TP5OUT  SYN, (8)021761.0             ! not landed; line 37 021761.00
TPSAV   SYN(BU), (8)021762.0         ! not landed; SX/LX target lines 29, 39 021762

        SLC, (8)022013.00
! line  1  -      ----------------------------------------------------
! line  2  -      CONVERT THE CHANNEL FIELDS
! line  3  -      ----------------------------------------------------
TP5A    LX,TCTWDX,0.0($15)                                   ! line  4  -CHECK THE MODE
        BZXF,TP5A1                                           ! line  5
        KVI,TXA,TPURFT                                       ! line  6  -PRINT ONLY THE MESSAGES OF THAT MODE
        BZXE,TP3                                             ! line  7  -
TP5A1   $L,TABSCH(TXB),-60                                   ! line  8  -LOAD FOR ABS CHANNEL CONVERSION
        $-(BU,18),TCHSXW,-60                                 ! line  9  as printed ($OP, C28-6129 printed p.10)
        $SF(BU,18),TIPL+1,-60                                ! line 10  -TO SAVE THE CHAN FOR IPL PRINT
        $CV(BU,18),0.0,-32                                   ! line 11
        LF(BU,12,4),$L+.20,1                                 ! line 12  -CONVERT TO 8 BIT BYTE
        LFI(BU,2),3,5                                        ! line 13  -GET THE IQS LEAD BITS
        LFI(BU,2),3,13                                       ! line 14  -GET THE IQS LEAD BITS
        CM0101,TCHANX                                        ! line 15
! line 16  -
        C0011,TABSUN(TXB),1                                  ! line 17  -GET UNIT NUMBER
        LFI(BU,2),3,5                                        ! line 18  -GET THE IQS LEAD BITS
        CM0101(BU,8,8),TUNITX                                ! line 19
! line 20  -
! line 21  -
        CM1111,TVER(TXC)                                     ! line 22  -SET THE VERIFY BIT
        LF,TFREEL(TXB),46                                    ! line 23  -GET THE FIRST REEL ADDRESS
        BRZ,TPSCR                                            ! line 24  -SCRATCH TAPE REQUEST
        LV,TIXZ,$R                                           ! line 25
! line 26  -
        C0011(BU,48,6),TREELN(TIXZ)                          ! line 27
! line 28  -
TP5A2   SX,$15,TPSAV                                         ! line 29
        SF(BU,64,8),TP5IN                                    ! line 30  -SAVE FOR CONVERSION
        LVI,$15,TP5A3                                        ! line 31  -SET UP TO GO TO IQS CONV RTNE
        BD,SA8IQS                                            ! line 32
TP5A3   VF,TP5IN                                             ! line 33  -FWA IN
        CF,8                                                 ! line 34  -N
        VF,TP5OUT                                            ! line 35  -FWA OUT
TIPLB2  BE,$+.32                                             ! line 36  -MODIFIED BY IPL
        LF(BU,64,8),TP5OUT                                   ! line 37  -GET THE CONVERTED WORD
        SF(BU,40,8),TREELX                                   ! line 38  -SET UP IQS REEL NUMBER
        LX,$15,TPSAV                                         ! line 39  -RESTORE
! line 40  -
        C0011,TMBLK,64                                       ! line 41  -GET ACC FULL CF BLANKS
        CM0101(BU,24,8),TREELX+.40,64                        ! line 42
        CM0000,TFDISP(TXC)                                   ! line 43  -SET TO TAPE MOUNTED
        CM1111,STATI(TXC)                                    ! line 44  -SET TO TAPE MTED- SPECIFIC
        LF(BU,48,6),TREELN(TIXZ)                             ! line 45  -RESET ACC FOR REEL PROTECT TEST
        B,TP4                                                ! line 46
! line 47  -
TPSCR   CT0011(BU,2),STATI(TXC)                              ! line 48
        BRZ,TP3                                              ! line 49
        C0011,TSCRAT                                         ! line 50  -GET THE SCRATCH TAPE WORD
        CM0101,TREELX                                        ! line 51  -BUILD WORD
        C0011(BU,6,6),TNOP,56                                ! line 52  -GET NOT FILE PROTECT MASK
        CM0000(BU,2),STATI(TXC)                              ! line 53  -SET TC TAPE MTED- SCRATCH
! line 54  -
TP4     CM1111,SMOUNT(TXC)                                   ! line 55  -SET MOUNT BIT AND
        CM1111,SIMNT(TXC)                                    ! line 56  -THE INITIAL MOUNT BIT

!SYM TP5A   022013.00
!SYM TP5A1  022015.00
!SYM TP5A2  022034.00
!SYM TP5A3  022036.40
!SYM TIPLB2 022040.00
!SYM TPSCR  022050.40
!SYM TP4    022056.00

