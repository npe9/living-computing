!CHECK 022130.40 | 000000.30 00 | line 7  CNOP
!CHECK 022131.00 | 007777 | line 8  T MMAX DD(BU,17),4095 | 17
!CHECK 022133.00 | 000000.00+ | line 14 T ERFLG VF,0
!CHECK 022133.31 | 0 | line 15 T MFREJ DD(BU,1),0 | 1
!CHECK 022133.40 | 000000.30 00 | line 40 CNOP
!CHECK 022153.00 | 000000.00+ | line 43 T DKSAV VF,0 (prints "VF,C"; binary 000000.00+)
!CHECK 022154.00 | 022155.00+ 000 000000 000020 | line 49 T UNXW XW,TUNATB,0,$0
