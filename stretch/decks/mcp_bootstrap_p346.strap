! mcp_bootstrap_p346.strap -- MCP printed page 346: the $DUMP program's
! panel dump, continued: the end of the 3rd panel line (APNLP4 loop of
! 2 through AOCTLB/AOCTLC), $MR set up and converted through ACNVER,
! the 4th panel line (APNL4: mask, APNLW3 loop APNLP6, a 40-bit field,
! APNLW4 hex loop APNLP7 through AHXTB), the SIO-mode R/S letter and 3
! blanks, then AWRITB/AWRITE, lines 1-51.
!
! docs/MCP_Mar63_250-445.pdf PDF p.96, read at 400 dpi, doubtful glyphs
! at 900 dpi.  Header, READ: "TIME CLOCK 00054041  PUNID 22$DUMP  CARD
! ID VB000170  DIST. OF 3/01  3/01  PAGE NUMBER 346"; the heading row's
! LOCATION field is 235104, line 1's word.
!
! STILL THE $DUMP OVERLAY (PUNID 22$DUMP, card IDs VB...), no new SLC,
! no new card series.  No TAIL.
!
! THE PAGE.  51 lines; every line number prints a "*".  "*" after the
! LOCATION on lines 11, 28, 42.  Line 16 is a remark card ("-" in the
! NAME column, "PANEL 4TH LINE").  Remarks on lines 9 (-SET UP $MR),
! 13 (-MR), 42 (-SIO MODE), 43 (-R), 45 (-S), 48 (-3 BLANKS).  Located
! rows contiguous from 235104.00 (line 1) to 235150.40 (line 51, B, a
! half word; next 235151.00).
!
! JOIN.  p.345 ends with CB at 235103.40 (half word): next 235104.00 =
! line 1, contiguous.  p.347 (tools/page_sheet.py 347) opens at
! 235151.00 = 235150.40 + a half word: contiguous.
!
! GLYPHS SETTLED BY OTHER THAN PLAIN INK:
!   * "ACCTLC" (lines 5, 26, 31) = AOCTLC, as p.345 settled it; the SIC
!     lines print AOCTLB with a closed O.  Line 30 prints "ACCTLB" with
!     the O open there: AOCTLB (lines 4, 25 close it).
!   * line 47 "$+3.C": the last glyph is an open round; "$+3.0" -- the
!     printed branch address 235150.(00) = $+3 words; a symbol C has no
!     place there.  Digit 0.
!   * line 48 "(16)1C1010": the second digit prints open; hex C would
!     assemble 070100.20, the ink prints 040100.20 = (16)101010.  Digit 0.
!   * line 22 "A3PT40": the last glyph is an open round, read digit 0
!     with its sibling APT8 (line 1, a numbered family); nothing typeset
!     settles it.  No page defines it.
!   * line 11 "APNLI": the last glyph has the symmetric serifs of I, not
!     the flagged 1 of the "1111" in the same statement.
!   * octal / hex fields with an open round read 0 ("FC" = F0, "DO" = D0).
!
! EXTERNALS.  None is defined by a landed deck; AOCTLB/C, AINTLB,
! AINITL, AWRITB, AWRITE, ABUFF, AMNMBF copied from p.345's stand-ins;
! SPROGS, SSIO, SAS from p.109's forms.  The rest from this page's
! binary: VFL addresses are BIT-EXACT; B/V+/LX addresses give the half
! word only; TI addresses the word only.
!
! CARD SERIALS.  VB000170 .. VB000215.  VB000169 never prints: p.345's
! last card is VB000168 and this page's header and line 1 read VB000170.
! Shared serials, every one a SIC/B pair: lines 4-5 (173), 18-19 (186),
! 25-26 (192), 30-31 (196), 50-51 (215).  Line 16's remark card is
! VB000184.

AOCTLB  SYN, (8)235376.40            ! not landed; p.345 stand-in; SIC lines 4,25,30 235376.40, BIT-EXACT
AOCTLC  SYN, (8)235373.40            ! not landed; p.345 stand-in; B lines 5,26,31 235373.50, half word only
ABUFF   SYN, (8)236044.0             ! not landed; LVI line 10 ABUFF+4. = 236050.33, word only
AMNMBF  SYN, (8)236126.0             ! not landed; LVI line 17 236126.35, TI line 41 AMNMBF+13. 236143, word only
AINTLB  SYN, (8)235210.40            ! not landed; SIC line 18 235210.40, BIT-EXACT
AINITL  SYN, (8)235205.40            ! not landed; B line 19 235205.50, half word only
AWRITB  SYN, (8)235327.40            ! not landed; SIC line 50 235327.40, BIT-EXACT
AWRITE  SYN, (8)235325.40            ! not landed; B line 51 235325.50, half word only
APT8    SYN, (8)236155.0             ! not landed; V+ line 1 236155.34, half word only
APNLI   SYN(BU,1), (8)236147.05      ! not landed; CM1111 line 11 236147.05 BIT-EXACT; no-dds connective prints length 1 BU (001000.36, = CM1111(BU,1) on p.332); dds INFERRED from this binary only: a plain SYN assembles 000000.36 and fails
ACNVER  SYN, (8)235726.0             ! not landed; B line 15 235726.10, half word only
AMASK   SYN, (8)236231.50            ! not landed; LF(BU,32) line 20 236231.50, BIT-EXACT
A3PT40  SYN, (8)236160.40            ! not landed; V+ line 22 236160.74, half word only
APNLW3  SYN(BU), (8)236152.0         ! not landed; LX line 23 236152.02, index word
ATR16   SYN, (8)236231.0             ! not landed; LF(BU,40) line 33 236231.00, BIT-EXACT
APNLW4  SYN(BU), (8)236153.0         ! not landed; LX line 35 236153.02, index word
AHXTB   SYN, (8)236232.10            ! not landed; LF(BU,8) line 38 236232.10, BIT-EXACT
AMCMDE  SYN, (8)236225.0             ! not landed; TI line 41 236225.00, word only
SPROGS  SYN, (8)215021.0             ! landed p.109 line 7 -PROGRAM STATUS TABLE
SSIO    SYN(BU,1), .61               ! landed p.109 line 10 -SUPPRESSED MODE STATUS
SAS     SYN(BU,1), .25               ! landed p.109 line 8 -AUTO STACK STATUS

        SLC, (8)235104.00
        V+,$14,APT8                                          ! line  1
        LCI,$1,2                                             ! line  2
APNLP4  LF(BU,8,1)(V+I),.8($1)                               ! line  3
        SIC,AOCTLB                                           ! line  4
        B,AOCTLC                                             ! line  5
        ST(BU,64)(V+I),1.($14)                               ! line  6
        CB,$1,APNLP4                                         ! line  7
        V+I,$14,.32                                          ! line  8
        Z,$13                                                ! line  9  -SET UP $MR
        LVI,$13,ABUFF+4.                                     ! line 10
        CM1111,APNLI                                         ! line 11
        LCI,$13,1                                            ! line 12
        LFI(BU,16),(16)2429                                  ! line 13  -MR
        SF(BU,16)(V+I),.32($14)                              ! line 14
        B,ACNVER                                             ! line 15
! -     PANEL 4TH LINE                                         ! line 16
APNL4   LVI,$14,AMNMBF                                       ! line 17
        SIC,AINTLB                                           ! line 18
        B,AINITL                                             ! line 19
        LF(BU,32),AMASK                                      ! line 20
        SF(BU,32),.24($14)                                   ! line 21
        V+,$14,A3PT40                                        ! line 22
        LX,$1,APNLW3                                         ! line 23
        LF(BU,8,1)(V+I),.8($1)                               ! line 24
APNLP6  SIC,AOCTLB                                           ! line 25
        B,AOCTLC                                             ! line 26
        ST(BU,64)(V+I),1.($14)                               ! line 27
        CB,1,APNLP6-1.                                       ! line 28
        LF(BU,4,1),($1)                                      ! line 29
        SIC,AOCTLB                                           ! line 30
        B,AOCTLC                                             ! line 31
        SF(BU,32)(V+I),3.($14)                               ! line 32
        LF(BU,40),ATR16                                      ! line 33
        SF(BU,40)(V+I),.48($14)                              ! line 34
        LX,$1,APNLW4                                         ! line 35
APNLP7  L(BU,4)(V+I),.4($1),-21                              ! line 36
        LV,$13,$L                                            ! line 37
        LF(BU,8),AHXTB($13)                                  ! line 38
        SF(BU,8)(V+I),.8($14)                                ! line 39
        CB,$1,APNLP7                                         ! line 40
        TI,4,AMCMDE,AMNMBF+13.                               ! line 41
        BB,SPROGS+SSIO,$+2.32                                ! line 42  -SIO MODE
        LFI(BU,8),(16)29                                     ! line 43  -R
        B,$+1.32                                             ! line 44
        LFI(BU,8),(16)12                                     ! line 45  -S
        SF(BU,8),.32($14)                                    ! line 46
        BZB,SAS+SPROGS,$+3.0                                 ! line 47
        LFI(BU,24),(16)101010                                ! line 48  -3 BLANKS
        SF(BU,24),.72($14)                                   ! line 49
        SIC,AWRITB                                           ! line 50
        B,AWRITE                                             ! line 51

