        SLC, (8)230747.00
! line  1  -*************************************************************
! line  2  -          JOB CONTROL PHASE 1  OVERLAPPED
! line  3  -*************************************************************
        CNOP                                                 ! line  4  (no location printed)
YJC1TT  DD(BU,12),(8)0401                                    ! line  5
        DR(BU,33),(1)                                        ! line  6
        EXT(0,18)                                            ! line  7
        B,YC11ST                                             ! line  8
        DR(BU),(2)                                           ! line  9
! line 10  -*************************************************************
! line 11  - READ ONE CARD , DETERMINE TYPE AND SEQUENCE , AND EXTRACT INFORMATION
! line 12  -*************************************************************
YC11ST  LV,$14,SREJJB                                        ! line 13  -JC1 INITIALIZING PACKGE
        SVA,14,YSPDCR                                        ! line 14
        SV,$14,YC1JJC                                        ! line 15
        LX,$14,YC1MTT                                        ! line 16
        SX,$14,YJC1TT                                        ! line 17
        B,YC1A1                                              ! line 18
YC1A    BBZ,SJ1FUL,YC1UNC-.32                                ! line 19
        BZB,Y1UCXW+1.17,YC1A1                                ! line 20
        BZBZ,REJJOB+.61,YC1A1                                ! line 21  -TEST FOR UK
        LVI,$13,YISUKM                                       ! line 22
YC1PRJ  LV,$14,LASTPP                                        ! line 23
        CM1111(BU,1),TRJECT($14)                             ! line 24
        SV,$13,1.($14)                                       ! line 25
        CM0000(BU,1),TASGNP($14)                             ! line 26
YC1A1   B,DMCP                                               ! line 27
        ,SKOM                                                ! line 28  printed "SKCM"
        ,3.0                                                 ! line 29  -SCR1
YC1CA   ,0                                                   ! line 30
        B,YC1C                                               ! line 31  -END RETURN - TO SDRET
        LVE,$10,YC1CA                                        ! line 32
YC1UNC  LVI,$14,Y1UCXW                                       ! line 33  -TO UNCODE
        B,YUNCOD                                             ! line 34
Y1UCXW  XW,0                                                 ! line 35  -INFORMATION SLOT
        VF,1.0                                               ! line 36  -TYPE OF CARD DISPOSITION
        ,0($10)                                              ! line 37
        ,YC1DB                                               ! line 38
        B,YC1B                                               ! line 39  -ERROR RETURN
        LV,$14,Y1UCXW +1.0                                   ! line 40  -PICK UP TYPE OF CARD
        BR,0($14)                                            ! line 41  -GO TO SERVICE ROUTINE
        LVI,$14,2.0                                          ! line 42
        B,YC1TC                                              ! line 43  -T.O.P. CARD
        LVI,$14,0.0                                          ! line 44
        B,YC1JC                                              ! line 45  -JOB CARD
        LVI,$14,4.0                                          ! line 46
        SV,$14,Y1UCXW+1.0                                    ! line 47  --LIM CARD CHANGE
        B,YC1A1                                              ! line 48  -DISPOSITION + RETURN
        NOP                                                  ! line 49

