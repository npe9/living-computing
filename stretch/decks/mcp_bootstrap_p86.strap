! mcp_bootstrap_p86.strap -- MCP INITIALIZATION, printed page 86:
! THE MODE SCAN TABLES, THE DENSITY SCAN TABLE and THE DISPOSITION
! SCAN TABLE.
! docs/MCP_Mar63_001-249.pdf PDF p.93, header "PAGE NUMBER 86".
!
! CONTIGUOUS WITH printed p.85, whose last line is a DD(BU,5) at
! 004752.14; this page's line 5 XW is word-aligned at 004753.00.
!
! >>> THREE MORE SCAN TABLES, AND THE FIXTURE'S IOD SUBFIELDS ARE IN
! THEM. <<<  printed p.85 gave the TYPE scan; these give MODE, DENSITY
! and DISPOSITION.  strap/prosa.py's MCP_IODS punches
! subfields=("", "OUT1", "ODD", "HD", "SAVE") for its output tapes --
! and "ODD" is a mode here, "HD" a density, "SAVE" a disposition.  The
! fixture's card was written before these pages were read; the pages
! say the names were right.
!
!   mode:         (blank) 0   ECC 1   ODD 3   EVEN 2   NOECC 3
!   density:      HD 1   LD 3   (blank) 0
!   disposition:  NSAVE 0   (blank) 0   CSAVE 1   ISAVE 2   SAVE 3
!
! EACH NAME IS PADDED TO ITS FIELD: (AX)DD(BU,30,6) is five 6-bit
! characters, (BU,12,6) is two.  The space after the comma is DATA in
! entry mode, so there is none, and the trailing X is the terminator.

        SLC, (8)4753.0

! ---- THE MODE SCAN TABLES ----------------------------------------
TSCIX2  XW, TSCAN2, 5, 0             ! line 5  -INDEX FOR MODE SCAN
TSCBK2  VF, -2                       ! line 6  -BACKUP CONSTANT
TSCAN2  (AX)DD(BU,30,6),     X       ! line 8
        DD(BU,2), 0                  ! line 9
        (AX)DD(BU,30,6),ECC  X       ! line 10
        DD(BU,2), 1                  ! line 11
        (AX)DD(BU,30,6),ODD  X       ! line 12
        DD(BU,2), 3                  ! line 13
        (AX)DD(BU,30,6),EVEN X       ! line 14
        DD(BU,2), 2                  ! line 15
        (AX)DD(BU,30,6),NOECCX       ! line 16
        DD(BU,2), 3                  ! line 17
        DD(BU,2), 3                  ! line 18 -AN ERROR WILL BE ...

! ---- THE DENSITY SCAN TABLE --------------------------------------
TSCIX3  XW, TSCAN3, 3, 0             ! line 24 -IX FOR DENSITY SCAN
TSCBK3  VF, -2                       ! line 25 -BACKUP CONSTANT
TSCAN3  (AX)DD(BU,12,6),HDX          ! line 26
        DD(BU,2), 1                  ! line 27
        (AX)DD(BU,12,6),LDX          ! line 28
        DD(BU,2), 3                  ! line 29
        (AX)DD(BU,12,6),  X          ! line 30
        DD(BU,2), 0                  ! line 31
        DD(BU,2), 0                  ! line 32 -ERROR WILL BE NU...

! ---- THE DISPOSITION SCAN TABLE ----------------------------------
TSCIX4  XW, TSCAN4, 5, 0             ! line 39 -IX FOR THE DISPOSITION
TSCBK4  VF, -3                       ! line 40 -BACKUP CONSTANT
TSCAN4  (AX)DD(BU,30,6),NSAVEX       ! line 42
        DD(BU,3), 0                  ! line 43
        (AX)DD(BU,30,6),     X       ! line 44
        DD(BU,3), 0                  ! line 45
        (AX)DD(BU,30,6),CSAVEX       ! line 46
        DD(BU,3), 1                  ! line 47
        (AX)DD(BU,30,6),ISAVEX       ! line 48
        DD(BU,3), 2                  ! line 49
        (AX)DD(BU,30,6),SAVE X       ! line 50
        DD(BU,3), 3                  ! line 51
        DD(BU,03), 0                 ! line 52 -AN ERROR WILL BE ...

! ---- CHECKS, read by tests/verify_mcp_page.py 86 -----------------
!SYM   TSCIX2   004753.00
!SYM   TSCBK2   004754.00
!SYM   TSCAN2   004754.31
!SYM   TSCIX3   004757.00
!SYM   TSCBK3   004760.00
!SYM   TSCAN3   004760.31
!SYM   TSCIX4   004762.00
!SYM   TSCBK4   004763.00
!SYM   TSCAN4   004763.31
!CHECK 004753.00 | 004754.31+ 000 000005 000000 | line 5  T SCIX2 XW,TSCAN2,5,0
!CHECK 004754.00 | 000000.02- | line 6  T SCBK2 VF,-2
!CHECK 004757.00 | 004760.31+ 000 000003 000000 | line 24 T SCIX3 XW,TSCAN3,3,0
!CHECK 004760.00 | 000000.02- | line 25 T SCBK3 VF,-2
!CHECK 004762.00 | 004763.31+ 000 000005 000000 | line 39 T SCIX4 XW,TSCAN4,5,0
!CHECK 004763.00 | 000000.03- | line 40 T SCBK4 VF,-3

! ---- THE SCAN-TABLE DATA ITSELF, read off the page ---------------
!
! >>> THE CODE DD ROWS PRINT; THE CHARACTER ROWS DO NOT. <<<  Every
! DD(BU,2) and DD(BU,3) on this page prints its value in the BINARY
! OUTPUT column as ONE octal digit.  Every (AX)DD(BU,30,6) and
! (AX)DD(BU,12,6) prints NOTHING there -- thirteen rows (lines 8, 10,
! 12, 14, 16, 26, 28, 30, 42, 44, 46, 48, 50) carry a LOCATION and a
! blank binary column, so THE CHARACTER BITS ARE NOT ON THIS PAGE and
! cannot be !CHECKed from it.  Three of the thirteen are TSCAN2/3/4
! and are covered by a !SYM; the other ten are accounted by neither
! !SYM nor !CHECK, and that is the page's doing, not the deck's.
!
! THE WIDTHS BELOW COME FROM THE PAGE'S OWN STATEMENT COLUMN, which
! prints DD(BU,2) in the mode and density tables and DD(BU,3) in the
! disposition table (line 52 prints DD(BU,03)) -- not from the deck.
! listing_oracle.render() says in capitals that the DIGIT COUNT DOES
! NOT DETERMINE THE WIDTH, and here one digit covers both 2 and 3
! bits, so the width had to be read rather than inferred.
!
! AND THE SINGLE DIGIT IS THE FIELD, NOT A WINDOW OVER ITS NEIGHBOUR:
! all sixteen printed digits equal their printed operands, and not one
! of them is 4-7.  A 3-bit window starting at a 2-bit field would have
! pulled in the next character row's leading bit and shown a 4, 5, 6
! or 7 on at least one of the six rows whose operand is 3.  None does.
!
! One oddity, recorded and transcribed past: printed line 16's
! LOCATION carries a trailing asterisk, "004756.31 *".  That is the
! unexplained marker of docs/listing_typography.md 12 -- it sits in
! the LOCATION column, is not the line number's asterisk, and does not
! change an assembled bit.  Line 16 is an (AX)DD row, so it has no
! binary output to check either way.

!CHECK 004754.67 | 0 | line 9  DD(BU,2),0 as printed | 2
!CHECK 004755.27 | 1 | line 11 DD(BU,2),1 as printed | 2
!CHECK 004755.67 | 3 | line 13 DD(BU,2),3 as printed | 2
!CHECK 004756.27 | 2 | line 15 DD(BU,2),2 as printed | 2
!CHECK 004756.67 | 3 | line 17 DD(BU,2),3 as printed | 2
!CHECK 004756.71 | 3 | line 18 DD(BU,2),3 as printed | 2
!CHECK 004760.45 | 1 | line 27 DD(BU,2),1 as printed | 2
!CHECK 004760.63 | 3 | line 29 DD(BU,2),3 as printed | 2
!CHECK 004761.01 | 0 | line 31 DD(BU,2),0 as printed | 2
!CHECK 004761.03 | 0 | line 32 DD(BU,2),0 as printed | 2
!CHECK 004763.67 | 0 | line 43 DD(BU,3),0 as printed | 3
!CHECK 004764.30 | 0 | line 45 DD(BU,3),0 as printed | 3
!CHECK 004764.71 | 1 | line 47 DD(BU,3),1 as printed | 3
!CHECK 004765.32 | 2 | line 49 DD(BU,3),2 as printed | 3
!CHECK 004765.73 | 3 | line 51 DD(BU,3),3 as printed | 3
!CHECK 004765.76 | 0 | line 52 DD(BU,03),0 as printed | 3
