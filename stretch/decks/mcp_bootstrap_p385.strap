!CHECK 020155.40 | 020157.32 C0 | line 32 BZXE,$+1.32
!CHECK 020156.00 | 000001.00 8C 000000.00 F0 | line 33 CM0000(BU,64),1.0($12)
!CHECK 020157.00 | 020160.37 01 | line 34 LVI,$15,$+1.0
!CHECK 020157.40 | 231703.10 00 | line 35 B,LDECOD
!CHECK 020160.00 | 000000.00+ | line 36 YDECVF VF,0
!CHECK 020160.40 | 000007 | line 37 CF,7 -- an 18-bit count field, six bare octal digits
!CHECK 020161.00 | 000000.00+ | line 38 VF,0
!CHECK 020161.40 | 020471.50 00 | line 39 B,YICER2
!CHECK 020162.00 | 000017.31 05 | line 40 V+I,$12,15.0
