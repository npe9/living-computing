!CHECK 020146.40 | 000001.00 8C 060000.06 70 | line 17 LF(BU,48),1.0($12) (second "*" after location)
!CHECK 020147.40 | 231417.00 80 060600.23 10 | line 18 KF,YRELMK
!CHECK 020150.40 | 020152.76 C2 | line 19 BAE,YVI
!CHECK 020151.00 | 000000.64 8C 014000.06 70 | line 20 LF(BU,12),.52($12)
!CHECK 020152.00 | 020522.34 C2 | line 21 BRZ,YMOVJ1
!CHECK 020152.40 | 000017.31 05 | line 22 YVI V+I,$12,15.0
!CHECK 020153.00 | 020132.10 00 | line 23 B,YIODSO
!CHECK 020153.40 | 215020.31 B0 | line 28 YC4C9 LVE,$12,SJCTWS
