!CHECK 020163.00 | 215001.02 80 020164.74 04 | line 42 BZBZ,SCNFCG,$+1.32
!CHECK 020164.00 | 020166.31 30 | line 43 SV,$12,YCONCG
!CHECK 020164.40 | 020166.37 01 | line 45 LVI,$15,YCONCG
!CHECK 020165.00 | 021164.10 00 | line 46 B,TASIGN
!CHECK 020166.00 | 000000.00+ 111 000000 000000 | line 47 YCONCG XW,0,0,0,7
!CHECK 020167.00 | 020166.34 10 | line 49 LX,$14,YCONCG
!CHECK 020167.40 | 020500.30 44 | line 50 BZXCZZ,YASREJ
!CHECK 020170.00 | 215020.25 B0 | line 51 LVE,$10,SJCTWS
