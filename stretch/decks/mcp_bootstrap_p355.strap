        B,ADIRX2                                             ! line 29  (printed "ACIRX2")
ABRIND  L(BU,6),.19($13),-19                                 ! line 30
        LV,$1,$L                                             ! line 31
        LI(BU,8),(8)62,32                                    ! line 32  -B
        LF(BU,32),AINDCR($1)                                 ! line 33
        BZB,.30($13),ABINDF                                  ! line 34
        SF(BU,40)(V+I),.40($14)                              ! line 35
ABND1   BZB,.29($13),ARETRN                                  ! line 36
        LFI(BU,8),(8)31                                      ! line 37
        SF(BU,8),($14)                                       ! line 38
        B,ARETRN                                             ! line 39
ABINDF  SF(BU,8),$R.16,32                                    ! line 40
        LFI(BU,8),(8)31,32                                   ! line 41  -Z
        SF(BU,48)(V+I),.48($14)                              ! line 42
        B,ABND1                                              ! line 43
ADIRX   L(BU,4),.23($13),-19                                 ! line 44
        LV,$1,$L                                             ! line 45
        L(BU,32),ADRNDX($1),16                               ! line 46
ADIRX2  LFI(BU,8),(8)33,8                                    ! line 47
        LF(BU,4),.19($13),-21                                ! line 48
        LV,$1,$L                                             ! line 49
        LF(BU,8),AHXTB($1)                                   ! line 50

