        SF(BU,8)(V+I),.8($14),48                             ! line 19
        B,ADIRX2                                             ! line 20  (printed "ACIRX2")
ABRCH   BZB,.28($13),ABRIND                                  ! line 21
        LVI,$1,ANXBR                                         ! line 22
        L(BU,2),.29($13),40                                  ! line 23
        LF(BU,2),.23($13),42                                 ! line 24
        *(BU,6),AL40,20                                      ! line 25
        V+,$1,$R                                             ! line 26
        L(BU,40),0($1),16                                    ! line 27
