!   line 40* 220177.00   000000.00 80 401027.20 50      LI(BU,1),S TD DEN,46                   IH000070
!   line 41* 220200.00   000011.00 30                   LV,0,$R                                IH000071
!   line 42* 220200.40   000005.00 8C                   SIC,S RET AD($12)                      IH000072
!   line 43* 220201.00   217674.50 00                   B,K DENST                              IH000072
!   line 44* 220201.40   221371.00 80                   SIC,K K IND                            IH000073
!   line 45* 220202.00   221370.10 00                   B,K IO IND                             IH000073
!   line 46* 220202.40   221144.50 00                   B,Z STEVL                              IH000074
! ---------------------------------------------------------------

!SYM   KSPTM    220156.40
!SYM   KFILK1   220171.40
!SYM   KNSYST   220174.40
!CHECK 220147.40 | 221371.00 80 | line 1 SIC,K K IND -- the first row on the page; a SIC prints the bare 24-bit address, so this row pins K K IND to the bit
!CHECK 220150.00 | 221370.10 00 | line 2 B,K IO IND (same card as line 1) -- .10 is B's operation bits, so K IO IND is 221370.00 to the half word only
!CHECK 220150.40 | 000000.30 00 | line 3 CNOP -- the counter arrived at .40, so unlike p.156's line 11 this CNOP emitted a real half-word no-op at its own printed location
!CHECK 220151.00 | 220152.00 10 | line 4 LX,0,$+1.0 -- the target is line 6's word, which is where line 5 stores the built instruction
!CHECK 220151.40 | 000004.01 1C | line 5 SX,0,S IO INS($12) (same card as line 4) -- .01 is SX's operation bit, byte C is i = $12
!CHECK 220152.00 | 000000.00 8E 000076.05 00 | line 6 CTL,0.0($14),62. -SPACE BLOCK COMMAND -- 62 DECIMAL is 0o76, which is the printed field; the .05 checks plain CTL against CTL(SEOP)'s .15 and the 8E checks the index $14
!CHECK 220153.00 | 216242.03 01 | line 7 LVI,1,K SUPP -- the .03 is LVI's .01 plus J=1's .02, not address bits
!CHECK 220153.40 | 000000.37 8B 001000.36 F0 | line 8 CM1111(BU,1),S SET UP($11) -- .37 is S SET UP's bit 31; CM0000 would print 001000.00 (see line 34), and byte B is i = $11
!CHECK 220154.40 | 000005.00 8C | line 9 SIC,S RET AD($12) -- byte 8C is 80 for SIC plus i = $12 = C, so this C is REAL and not a damaged 0
!CHECK 220155.00 | 221261.10 00 | line 10 B,M IO REJ (same card as line 9) -- printed p.152 line 6 and p.156 lines 2 and 18 print the identical card
!CHECK 220155.40 | 221371.00 80 | line 11 SIC,E IND R -- same word as line 1's K K IND under a different name, and pinned to the bit by the SIC
!CHECK 220156.00 | 221370.10 00 | line 12 B,E IO IND (same card as line 11) -- same word as line 2's K IO IND
!CHECK 220156.40 | 000002.33 8D 002127.00 50 | line 13 K SP TM L(B,2,1),S FDEN($13),46 -SPACE OVER TAPE MARK -- .33 is S F DEN's bit 27; the second half word is the dds (B,2,1) with offset 46, which differs from line 15's (BU,1) 001027.20 and is printed identically on line 38; byte 8D is i = $13
!CHECK 220157.40 | 220161.35 C2 | line 14 BRN,$+1.32 -- $ is 220157.40 and 1.32 decimal is 1.40 octal, so the target is 220161.00, i.e. line 16, skipping line 15's full word; the .35 is BRN's operation bits and the C2 is real
!CHECK 220160.00 | 000007.35 8C 001027.20 50 | line 15 L(BU,1),S LABD($12),46 -- .35 is S LABD's bit 29; the second half word is identical to printed p.156 line 5's, which is the same dds and the same offset
!CHECK 220161.00 | 000011.00 30 | line 16 LV,0,$R -- $R is word 0o11 out of SYSTEM_SYMBOLS and J=0, so the row prints it bare
!CHECK 220161.40 | 000005.00 8C | line 17 SIC,S RET AD($12) -- the second of five printings of this card on one page
!CHECK 220162.00 | 217674.50 00 | line 18 B,K DENST (same card as line 17) -- .50 is K DENST's own .40 plus B's .10
!CHECK 220162.40 | 221371.00 80 | line 19 SIC,K K IND -- THIS location carries the trailing asterisk and lines 1, 29 and 44, the same card, do not
!CHECK 220163.00 | 221370.10 00 | line 20 B,K IO IND (same card as line 19)
!CHECK 220163.40 | 000000.30 00 | line 21 CNOP -- the second aligning no-op; the counter was again at .40
!CHECK 220164.00 | 220165.00 10 | line 22 LX,0,$+1.0 -- the byte reads 1C at 400 dpi and is 10: an LX has no index here, exactly as line 4 has none
!CHECK 220164.40 | 000004.01 1C | line 23 SX,0,S IO INS($12) (same card as line 22) -- bit-identical to line 5
!CHECK 220165.00 | 000000.00 8E 000077.05 00 | line 24 CTL,0.0($14),(8)77. -SPACE FILE COMMAND -- THE DOTTED OCTAL CONTROL CODE, which printed p.156 line 14 had to leave failing; it now compiles word-granular and matches the print
!CHECK 220166.00 | 216242.03 01 | line 25 LVI,1,K SUPP (bit-identical to line 7)
!CHECK 220166.40 | 000000.37 8B 001000.36 F0 | line 26 CM1111(BU,1),S SET UP($11) (bit-identical to line 8)
!CHECK 220167.40 | 000005.00 8C | line 27 SIC,S RET AD($12)
!CHECK 220170.00 | 221261.10 00 | line 28 B,M IO REJ (same card as line 27)
!CHECK 220170.40 | 221371.00 80 | line 29 SIC,K K IND
!CHECK 220171.00 | 221370.10 00 | line 30 B,K IO IND (same card as line 29)
!CHECK 220171.40 | 000001.01 01 | line 31 K FIL K1 LVI,0,1. -- J=0, so the .01 is LVI's operation bit alone; the name is eight characters, the full NAME field, and rests on this page's ink
!CHECK 220172.00 | 000007.41 3C | line 32 SV,0,S FILEK($12) (same card as line 31) -SET FILE COUNT TO +1 -- .41 is SV's .01 plus S FILEK's bit 32; the bits BELOW 32 are dropped by an index-arithmetic operand, so 7.38 and 7.32 are indistinguishable here
!CHECK 220172.40 | 000006.02 3C | line 33 LV,1,S SCRPM($12) -PICK UP RETURN ADDRESS -- .02 is J=1, so S SCRPM is word 6 bit 0; printed p.156 line 22 reads the same word with L(BU,30)
!CHECK 220173.00 | 000000.74 8B 001000.00 F0 | line 34 CM0000(BU,1),S CTL($11) -- 0o74 is S CTL's bit 60; the second half word's .00 against line 8's .36 is what distinguishes CM0000 from CM1111, so the four round mask glyphs are zeros twice over
!CHECK 220174.00 | 000000.10 01 | line 35 B,0.0($1) -- address 0.0 plus B's .10, byte 01 = i = $1; this is the one row where the byte's leading glyph really is a zero
!CHECK 220174.40 | 000001.01 01 | line 36 K N SYST LVI,0,1.0 -- printed with a trailing 0 where line 31 prints a bare dot; same bits, and the location is pinned independently by printed p.162's BZB at 220174.74
!CHECK 220175.00 | 000007.41 3C | line 37 SV,0,S FILE K($12) (same card as line 36) -SET FILE COUNT TO +1 -- printed "S FILE K" with a space where line 32 prints "S FILEK"; one symbol
!CHECK 220175.40 | 000002.33 8D 002127.00 50 | line 38 L(B,2,1),S FDEN($13),46 -SET UNIT TO IOD DENSITY -- bit-identical to line 13 and the SECOND starred location on the page, which is what refutes keying the asterisk to the statement
!CHECK 220176.40 | 220200.35 C2 | line 39 BRN,$+1.32 -- target 220200.00, i.e. line 41, skipping line 40's full word, exactly as line 14 skips line 15
!CHECK 220177.00 | 000000.00 80 401027.20 50 | line 40 LI(BU,1),S TD DEN,46 -- the leading 4 of the second half word is the P field, P=4 being Immediate addressing (line 15's L prints 001027.20 for the same dds and offset); an LI's first half word is the DATUM, left-justified, so a ONE-BIT immediate witnesses only the value's low bit -- measured, X = 0, 1.0, 0.32, 2.0 and 8 all print 000000.00 and only X = 1 prints 400000.00, so this row establishes that S TD DEN is EVEN and printed p.108 line 8 is what makes it 0
!CHECK 220200.00 | 000011.00 30 | line 41 LV,0,$R (bit-identical to line 16)
!CHECK 220200.40 | 000005.00 8C | line 42 SIC,S RET AD($12)
!CHECK 220201.00 | 217674.50 00 | line 43 B,K DENST (same card as line 42)
!CHECK 220201.40 | 221371.00 80 | line 44 SIC,K K IND
!CHECK 220202.00 | 221370.10 00 | line 45 B,K IO IND (same card as line 44)
!CHECK 220202.40 | 221144.50 00 | line 46 B,Z STEVL -- .50 is Z STEVL's .40 plus B's .10; a half word, so the counter leaves this page at 220203.00, which is where printed p.164's line 4 is printed
