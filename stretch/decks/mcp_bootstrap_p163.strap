!   line 21* 220163.40   000000.30 00                   CNOP                                   IH000056
!   line 22* 220164.00   220165.00 10                   LX,0,$+1.0                             IH000057
!   line 23* 220164.40   000004.01 1C                   SX,0,S IO INS($12)                     IH000057
