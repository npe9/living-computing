!   line 26* 220166.40   000000.37 8B 001000.36 F0      CM1111(BU,1),S SET UP($11)             IH000060
!   line 27* 220167.40   000005.00 8C                   SIC,S RET AD($12)                      IH000061
!   line 28* 220170.00   221261.10 00                   B,M IO REJ                             IH000061
!   line 29* 220170.40   221371.00 80                   SIC,K K IND                            IH000062
!   line 30* 220171.00   221370.10 00                   B,K IO IND                             IH000062
!   line 31* 220171.40   000001.01 01                 K FIL K1  LVI,0,1.                       IH000063
!   line 32* 220172.00   000007.41 3C                   SV,0,S FILEK($12)  -SET FILE COUNT TO +1  IH000063
!   line 33* 220172.40   000006.02 3C                   LV,1,S SCRPM($12)  -PICK UP RETURN ADDRESS  IH000064
!   line 34* 220173.00   000000.74 8B 001000.00 F0      CM0000(BU,1),S CTL($11)                IH000065
!   line 35* 220174.00   000000.10 01                   B,0.0($1)                              IH000066
!   line 36* 220174.40   000001.01 01                 K N SYST  LVI,0,1.0                      IH000067
!   line 37* 220175.00   000007.41 3C                   SV,0,S FILE K($12)  -SET FILE COUNT TO +1  IH000067
