!   7*   216312.00 *   000001.00                            K CS REG  DRZ(BU,64),1                                                      EB000362
!   8*   216313.00     003410.35 01                         C Q2BIG   LVI,$14,SQ2BIG               -LOAD ERROR CODE AND                 EB000363
!   9*   216313.40     217451.40 80                                   SIC,S DISIC                                                       EB000364
!  10*   216314.00     217372.10 00                                   B,S DISP                                                          EB000364
!  11*   216314.40     000005.20 3C                         K RELAY   LV,8,S RET AD($12)                                                EB000365
!  12*   216315.00     000001.17 5D                                   SC,7,1.0($13)                                                     EB000366
!  13*   216315.40     000000.10 08                                   B,0.0($8)                                                         EB000367
!  14*   216316.00     000003.34 8D  022033.60 50           C ARC AD  L(BU,18),SCW.28($13),55-SDD  -ORIGINAL COUNT TO ACC               EB000368
!  15*   216317.00     215001.01 80  001000.00 F0                     CM0000(BU,1),S HS ECH                                             EB000369
!  16*   216320.00     000004.00 1D                                   LX,0,S CCW($13)              -TEST IF FINAL CW COUNT IS ZERO      EB000370
!  17*   216320.40     216327.30 40                                   BZXCZ,K DISK E                                                    EB000371
!  18*                                                                                             -$L HOLDS NO OF ARCS WHICH EQUALS    EB000372
!  19*   216321.00     000000.00 80  000000.23 10                     KF(BU,64),$Z                 -IS NO OF ARCS AN INTEGER            EB000373
!  20*   216322.00     216323.76 C2                                   BAE, $+1.32                  -IF YES, BRANCH                      EB000374
!  21*   216322.40     000010.00 80  000000.22 B0                     M+1(BU,64), 8.0              -IF NOT, ROUND UP BY ONE             EB000375
!  22*   216323.40     000000.40 8A  022040.20 10                     +, S ARC AD($10),64          -ADD THIS TO S ARC AD AND RETURN THE EB000376
!  23*   216324.40     000000.40 8A  022040.20 D0                     ST(BU,18),SARC AD($10),64-SUM TO STORAGE IN                       EB000377
!  24*   216325.40 *   000006.00 8D  022040.20 D0                     ST(BU,18), SCUARC($13),64 - S ARC AD AND S CU ARC                 EB000378
!  25*   216326.40     215746.50 00                                   B,K GATE                                                          EB000379
!  26*   216327.00     000000.40 8A  022000.36 F0           KDISKE    CM1111(BU,18),SARCAD($10)-FORCE LOCATE ON NEXT I/O                EB000380
!  27*   216330.00     000003.00 1D                                   LX,0,S CW($13)                                                    EB000381
!  28*   216330.40     000004.01 1D                                   SX,0,S CCW($13)                                                   EB000381
!  29*   216331.00     215746.50 00                                   B,K GATE                                                          EB000382
!  30*   216332.00     000000.00+ 000 000000 000000         K RECEP   XW,0                                                              EB000383

!SYM   KCSREG   216312.00
!SYM   CQ2BIG   216313.00
!SYM   KRELAY   216314.40
!SYM   CARCAD   216316.00
!SYM   KDISKE   216327.00
!SYM   KRECEP   216332.00

!CHECK 216305.40 | 216242.63 80 001000.36 F0 | line  1 CM1111(BU,1),K SUP CS.19
!CHECK 216306.40 | 216312.00 8B 001000.00 F0 | line  2 CM0000(BU,1),K CS REG($11)
!CHECK 216307.40 | 000020.17 02 | line  3 LCI,7,16
!CHECK 216310.00 | 000010.17 50 | line  4 SC,7,$L
!CHECK 216310.40 | 215240.11 80 005071.52 F0 | line  5 CM0101(BU,5),S TLR+8.9,-13
!CHECK 216311.40 | 215721.50 00 | line  6 B,S FAKE I  (target half word checked; bits 0-31 of the offset are not)
!CHECK 216313.00 | 003410.35 01 | line  8 C Q2BIG LVI,$14,SQ2BIG  (S Q2BIG = (16)0708.0, from p.107)
!CHECK 216313.40 | 217451.40 80 | line  9 SIC,S DISIC  (first statement of card EB000364)
!CHECK 216314.00 | 217372.10 00 | line 10 B,S DISP  (second statement of card EB000364)
!CHECK 216314.40 | 000005.20 3C | line 11 K RELAY LV,8,S RET AD($12)
!CHECK 216315.00 | 000001.17 5D | line 12 SC,7,1.0($13)
!CHECK 216315.40 | 000000.10 08 | line 13 B,0.0($8)
!CHECK 216316.00 | 000003.34 8D 022033.60 50 | line 14 C ARC AD L(BU,18),SCW.28($13),55-SDD  (the offset is pinned only mod 128; SDD = 0 is p.108's)
!CHECK 216317.00 | 215001.01 80 001000.00 F0 | line 15 CM0000(BU,1),S HS ECH
!CHECK 216320.00 | 000004.00 1D | line 16 LX,0,S CCW($13)
!CHECK 216320.40 | 216327.30 40 | line 17 BZXCZ,K DISK E
!CHECK 216321.00 | 000000.00 80 000000.23 10 | line 19 KF(BU,64),$Z  (low nibble is i2 = 0: no second operand)
!CHECK 216322.00 | 216323.76 C2 | line 20 BAE, $+1.32
!CHECK 216322.40 | 000010.00 80 000000.22 B0 | line 21 M+1(BU,64), 8.0
!CHECK 216323.40 | 000000.40 8A 022040.20 10 | line 22 +, S ARC AD($10),64
!CHECK 216324.40 | 000000.40 8A 022040.20 D0 | line 23 ST(BU,18),SARC AD($10),64
