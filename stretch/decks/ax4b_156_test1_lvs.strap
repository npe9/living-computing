        BXVZ, $+1.32
        SIC, SEN                      ! -ZEROS IN 0-15 OF LVS FAILS TO
        B, SERS                       ! -CLEAR SPECIFIED IX REG.
        B, $+1.0
        BD, I562
        SIC, SENO+.32
        B, SSW                        ! -TO SSIP.
        BD, $+.32
        LX, $X13, IC256               ! -UPDATE CONTINUITY CHECK.
        V+, $X13, BIT1
        SX, $X13, IC256
!
! ======================================================================
! PDF p.189, 012774.00: IC256.  PDF p.190: the CNOP before 156K1 prints
! nothing (012775.00 holds ICK256, not used here, so 012776.00 is
! already aligned); 156K1 at 012776.00; 1000 at 013035.00.
! ======================================================================
        SLC, (8)12774.0
IC256   XW, 0, 0, 0                   ! -CONTINUITY REG 1256.
        SLC, (8)12776.0
I56K1   XW, (8)777774.00, 0, 0
        SLC, (8)13035.0
I000    (8)DD(BU,64,8), 1777777777777777777777  ! -INDX WD. OF ONES.
!
