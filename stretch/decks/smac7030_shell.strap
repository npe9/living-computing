! smac7030_shell.strap -- RECONSTRUCTION of SMAC's processor shell, branch
! table and Generator Language subroutines, written as a 7030 program.
!
! >>> A RECONSTRUCTION.  IBM's SMAC was a 7030 program and no listing of it
! >>> is known.  This code is written here, to the language of J28-6128
! >>> (CHM 102634360) and its errata.  docs/smac_7030.md records every
! >>> convention with its page, or marks it CHOSEN.  The reference for its
! >>> output is strap/smac.py and the bulletin's printed cards. <<<
!
! REGISTERS.  X1 the running generator's base (p.13 item 2).  X2 the
! branch table (p.13 item 3).  X15 linkage from a generator (p.13 item 4).
! X3-X8 are this program's working registers.  X9-X14 belong to generator
! logic (p.13 item 6): nothing here touches them, and an inner macro saves
! and restores them.
!
! Links between the routines below are memory cells ("SIC,cell"), so that
! no index register has to survive a call.  RefMan printed p.41: SIC and
! the branch after it are one instruction; what it stores is the address
! after the branch.
!
! SC and LC hold a count in the LEFT 18 bits of the addressed field, not in
! an index word's count position: use LX on an index word.
!
! A half-word argument is read as (BU,24), never with LV: STRAP sets its
! bit 24, the value's sign (RefMan printed p.19).
!
! THE FAILURES.  Each sets QERRBIT and halts at HALTE with a code in QERR.
! p.13 says a major error ends compilation at the end of the pass; this
! version stops at once.  smac.py raises on the same conditions, except 11
! and 13, which are limits of this version:
!    4 a lone "/" in a skeleton (smac.py's CHOSEN C4)
!    5 a parameter past the subject's last (smac.py's CHOSEN C3)
!    6 a skeleton field overflows its columns
!    7 MOUTV's N is not a whole number (p.11)
!    8 MOUTF has no skeleton for this many arguments (p.7)
!    9 a pointer used before it is defined (p.5)
!   10 MMVPT's N is QCN and QCN was not stored (p.5)
!   11 more than 100 parameters (CHOSEN limit)
!   12 macros nested deeper than 20 (smac.py's limit)
!   13 more than 9999 generator executions (the /Q/ counter, CHOSEN C2)
!   14 more than nine continuation cards (p.2)
!   15 MGETL: the parameter is not a literal (smac.py's CHOSEN C5)
!
        SLC, (8)2000.0
START   LVI, $2, BT
!
! ======== the shell: one statement at a time (p.2) ===================
MNEXT   LX, $3, QINP
        KCI, $3, 0
        BXE, DONE
        SV, $3, CURC
        C-I, $3, 1
        V+I, $3, 10.0
        SX, $3, QINP
! a card blank in all 80 columns is dropped, as smac.py's read_blocks does
        LV, $4, CURC
        SIC, BLLK
        B, ISBLK
        L(BU,1), ISB
        KI(BU,1), 1
        BAE, MNEXT
! p.13: QMIBIT stays one until the first non-continuation card is identified
        LI(BU,1), 0
        ST(BU,1), QMIBIT($2)
! column 1: C28-6129 pp.2-3, J28-6128 p.1
        LV, $3, CURC
        L(BU,8), 0($3)
        KI(BU,8), 0
        BAE, MTAG
        KI(BU,8), (8)44
        BZAE, MCOMM
! the tag field: an apostrophe first makes the card a comment (C28-6129 p.2)
MTAG    LV, $3, CURC
        L(BU,8)(V+I), .8($3)
        LCI, $4, 8
MTAG1   L(BU,8)(V+I), .8($3)
        KI(BU,8), 0
        BZAE, MTAG2
        CB, $4, MTAG1
        B, MBLOCK
MTAG2   KI(BU,8), (8)52
        BZAE, MBLOCK
! a comment card goes to STRAP as punched
MCOMM   L(BU,24), CURC
        ST(BU,24), COPYF
        SIC, CPLK
        B, COPYC
        B, MNEXT
!
! a statement.  QCIBIT: was the previous source statement a macro? (p.13)
MBLOCK  L(BU,1), LASTM
        ST(BU,1), QCIBIT($2)
        LI(BU,1), 0
        ST(BU,1), LASTM
        L(BU,24), CURC
        ST(BU,24), HEAD
        SIC, STLK
        B, STMT0
! continuation cards: "*" in column 1, at most nine (p.2).  Blank cards
! between them are dropped.
        LI(BU,24), 0
        ST(BU,24), NCONT
MLOOK   LX, $3, QINP
        KCI, $3, 0
        BXE, MFIND
        SV, $3, TMPP
        LV, $4, TMPP
        SIC, BLLK
        B, ISBLK
        L(BU,1), ISB
        KI(BU,1), 1
        BAE, MLOOK2
        LV, $3, TMPP
        L(BU,8), 0($3)
        KI(BU,8), (8)44
        BZAE, MFIND
        L(BU,24), NCONT
        KI(BU,24), 9
        BZAE, MLOOK1
        LI(BU,24), 14
        B, ERROR
MLOOK1  M+1(BU,24), NCONT
        L(BU,24), TMPP
        ST(BU,24), APPP
        SIC, APLK
        B, APPEND
MLOOK2  LX, $3, QINP
        C-I, $3, 1
        V+I, $3, 10.0
        SX, $3, QINP
        B, MLOOK
!
! the operation: the statement's first field
MFIND   LVI, $3, STMT
        LC, $4, STL
        SIC, FOLK
        B, FINDOP
        L(BU,24), GENA
        KI(BU,24), 0
        BZAE, MSCAN
! not a SMAC statement: every card of the block goes to STRAP as punched
        L(BU,24), HEAD
        ST(BU,24), TMPP
MCP1    LV, $4, TMPP
        SIC, BLLK
        B, ISBLK
        L(BU,1), ISB
        KI(BU,1), 1
        BAE, MCP2
        L(BU,24), TMPP
        ST(BU,24), COPYF
        SIC, CPLK
        B, COPYC
MCP2    L(BU,24), TMPP
        +(BU,24), C640
        ST(BU,24), TMPP
        L(BU,24), QINP
        K(BU,24), TMPP
        BAH, MCP1
        B, MNEXT
!
! the parameters: column 1, tag, operation, each argument (p.3).  The text
! is copied into the saved region, so that a parameter of an outer
! statement survives an inner macro.
MSCAN   LV, $3, HEAD
        LVI, $4, COLBUF
        L(BU,64), 0($3)
        ST(BU,64), 0($4)
        L(BU,8), 1.0($3)
        ST(BU,8), 1.0($4)
        LVI, $7, PTAB
        LVI, $5, 0
        LCI, $5, 0
        L(BU,8), COLBUF
        KI(BU,8), 0
        BAE, MSC1
        LVI, $5, COLBUF
        LCI, $5, 1
MSC1    SX, $5, 0($7)
        V+I, $7, 1.0
        LV, $3, TAGV
        LCI, $4, 8
        LCI, $6, 0
        LI(BU,1), 0
        ST(BU,1), ONLY1
        SIC, FILK
        B, FIELDS
        LVI, $3, STMT
        LC, $4, STL
        LCI, $6, 1
        SIC, FILK
        B, FIELDS
        SV, $7, TMPV
        L(BU,18), TMPV
        -(BU,18), PTABW
        ST(BU,24), QCOUNT($2)
! "MOP," with nothing after the comma has no argument (smac.py's args == [""])
        KI(BU,24), 4
        BZAE, MGO
        LX, $5, PTAB+3.0
        KCI, $5, 0
        BZXE, MGO
        LI(BU,24), 3
        ST(BU,24), QCOUNT($2)
! the /Q/ tag for this execution: the next value of the count (CHOSEN C2)
MGO     L(BU,8), GUNIQ+.56
        KI(BU,8), (8)162
        BZAE, MGI4
        LI(BU,8), (8)140
        ST(BU,8), GUNIQ+.56
        L(BU,8), GUNIQ+.48
        KI(BU,8), (8)162
        BZAE, MGI3
        LI(BU,8), (8)140
        ST(BU,8), GUNIQ+.48
        L(BU,8), GUNIQ+.40
        KI(BU,8), (8)162
        BZAE, MGI2
        LI(BU,8), (8)140
        ST(BU,8), GUNIQ+.40
        L(BU,8), GUNIQ+.32
        KI(BU,8), (8)162
        BZAE, MGI1
        LI(BU,24), 13
        B, ERROR
MGI4    +(BU,8), C2B
        ST(BU,8), GUNIQ+.56
        B, MG3
MGI3    +(BU,8), C2B
        ST(BU,8), GUNIQ+.48
        B, MG3
MGI2    +(BU,8), C2B
        ST(BU,8), GUNIQ+.40
        B, MG3
MGI1    +(BU,8), C2B
        ST(BU,8), GUNIQ+.32
MG3     L(BU,64), GUNIQ
        ST(BU,64), UNIQ
! p.13: QMACBIT, QINBIT, and QGUB from the generator's own first word
        LI(BU,1), 1
        ST(BU,1), QMACBIT($2)
        L(BU,24), DEPTH
        KI(BU,24), 0
        BAE, MG4
        LI(BU,1), 1
        B, MG5
MG4     LI(BU,1), 0
MG5     ST(BU,1), QINBIT($2)
        LV, $1, GENA
        L(BU,1), 0($1)
        ST(BU,1), QGUB($2)
        LI(BU,1), 1
        ST(BU,1), 0($1)
        B, 1.0($1)
!
! MEXIT comes back here
SEXIT   L(BU,24), DEPTH
        KI(BU,24), 0
        BZAE, SEX1
        LI(BU,1), 0
        ST(BU,1), QMACBIT($2)
        LI(BU,1), 1
        ST(BU,1), QMIBIT($2)
        ST(BU,1), LASTM
        B, MNEXT
! the end of an inner macro: back into the outer generator's skeleton
SEX1    SIC, POLK
        B, POPF
        L(BU,24), DEPTH
        -(BU,24), C1
        ST(BU,24), DEPTH
        KI(BU,24), 0
        BAE, SEX2
        LI(BU,1), 1
        B, SEX3
SEX2    LI(BU,1), 0
SEX3    ST(BU,1), QINBIT($2)
        B, PS4
!
! ---- small routines ------------------------------------------------
! ISBLK: is the card at V($4) all blank?  ISB is the answer.
ISBLK   LI(BU,1), 0
        ST(BU,1), ISB
        LCI, $5, 10
IB1     L(BU,64)(V+I), 1.0($4)
        K(BU,64), ZERO
        BZAE, IB9
        CB, $5, IB1
        LI(BU,1), 1
        ST(BU,1), ISB
IB9     LV, $8, BLLK
        B, 0($8)
!
! COPYC: the card at COPYF to the output
COPYC   LV, $4, COPYF
        LV, $5, QOUTP
        LCI, $6, 10
CC1     L(BU,64)(V+I), 1.0($4)
        ST(BU,64)(V+I), 1.0($5)
        CB, $6, CC1
        SV, $5, QOUTP
        M+1(BU,24), OUTCNT
        LV, $8, CPLK
        B, 0($8)
!
! STMT0: start the statement text from the card at HEAD
STMT0   LVI, $5, STMT
        LCI, $5, 0
        SX, $5, STX
        SC, $5, STL
        LI(BU,1), 0
        ST(BU,1), INCOM
        L(BU,24), HEAD
        ST(BU,24), APPP
        SIC, APLK
        B, APPEND
        LV, $8, STLK
        B, 0($8)
!
! APPEND: add columns 10-72 of the card at APPP to the statement text.
! Each card's text is stripped; an apostrophe ends the statement, and
! later cards of the block add nothing (smac.py's read_blocks).
APPEND  L(BU,1), INCOM
        KI(BU,1), 1
        BAE, AP9
        L(BU,24), APPP
        +(BU,24), C72
        ST(BU,24), TMPV
        LV, $3, TMPV
        LCI, $4, 63
        LCI, $6, 2
        LVI, $7, APFLD
        LI(BU,1), 0
        ST(BU,1), ONLY1
        ST(BU,1), FSTOP
        SIC, FILK
        B, FIELDS
        L(BU,1), FSTOP
        ST(BU,1), INCOM
        LX, $3, APFLD
        KCI, $3, 0
        BXE, AP9
        LX, $5, STX
AP1     L(BU,8)(V+I), .8($3)
        ST(BU,8)(V+I), .8($5)
        C+I, $5, 1
        CB, $3, AP1
        SX, $5, STX
        SC, $5, STL
AP9     LV, $8, APLK
        B, 0($8)
!
! ======== FIELDS: split a run of characters into fields ==============
! In: $3 first character, $4 its count (C).  C($6): 0 one field; 1 split at
! commas outside parentheses, stop at an apostrophe; 2 one field, stop at
! an apostrophe.  $7 the entry to fill.  ONLY1 stops after the first field.
! Each entry is an index word: V the first non-blank character, C the
! length to the last non-blank.  V($6) is the parenthesis depth, in 1.0s.
FIELDS  LVI, $5, 0
        LCI, $5, 0
        LVI, $6, 0
        KCI, $4, 0
        BXE, FEND
F1      SV, $3, FCUR
        L(BU,8)(V+I), .8($3)
        KCI, $6, 0
        BXE, FBODY
        KI(BU,8), (8)52
        BZAE, F0
        LI(BU,1), 1
        ST(BU,1), FSTOP
        B, FEND
F0      KCI, $6, 2
        BXE, FBODY
        KI(BU,8), (8)50
        BZAE, F2
        KVI, $6, 0
        BXE, FCOMMA
        B, FBODY
F2      KI(BU,8), (8)45
        BZAE, F3
        V+I, $6, 1.0
        B, FBODY
F3      KI(BU,8), (8)47
        BZAE, FBODY
        V-I, $6, 1.0
FBODY   KVI, $5, 0
        BXE, FNS
        C+I, $5, 1
        KI(BU,8), 0
        BAE, FNEXT
        SC, $5, FLEN
        B, FNEXT
FNS     KI(BU,8), 0
        BAE, FNEXT
        LV, $5, FCUR
        LCI, $5, 1
        SC, $5, FLEN
FNEXT   CB, $4, F1
FEND    SIC, FPLK
        B, FPUT
        LV, $8, FILK
        B, 0($8)
FCOMMA  SIC, FPLK
        B, FPUT
        L(BU,1), ONLY1
        KI(BU,1), 1
        BZAE, FC1
        LV, $8, FILK
        B, 0($8)
FC1     LVI, $5, 0
        LCI, $5, 0
        B, FNEXT
! close the current field
FPUT    KVI, $5, 0
        BXE, FP1
        LC, $5, FLEN
FP1     KVI, $7, PTLIM
        BXL, FP2
        LI(BU,24), 11
        B, ERROR
FP2     SX, $5, 0($7)
        V+I, $7, 1.0
        LV, $8, FPLK
        B, 0($8)
!
! ======== FINDOP: is the first field an operation in the table? ======
! In: $3 first character, $4 its count.  Out: GENA the generator, or 0.
FINDOP  LCI, $6, 1
        LVI, $7, KFLD
        LI(BU,1), 1
        ST(BU,1), ONLY1
        SIC, FILK
        B, FIELDS
        L(BU,24), ZERO
        ST(BU,24), GENA
        LX, $3, KFLD
        KCI, $3, 0
        BXE, FOEND
        KCI, $3, 9
        BXH, FOEND
! the key: nine characters, blank filled
        L(BU,64), ZERO
        ST(BU,64), KEY
        ST(BU,64), KEY+1.0
        LVI, $4, KEY
FO1     L(BU,8)(V+I), .8($3)
        ST(BU,8)(V+I), .8($4)
        CB, $3, FO1
        LX, $5, OPTX
FO2     L(BU,64), KEY
        K(BU,64), 0($5)
        BZAE, FO3
        L(BU,8), KEY+1.0
        K(BU,8), 1.32($5)
        BZAE, FO3
        L(BU,24), 1.0($5)
        ST(BU,24), GENA
        B, FOEND
FO3     V+I, $5, 2.0
        CB, $5, FO2
FOEND   LV, $8, FOLK
        B, 0($8)
!
! ======== PUSHF / POPF: the state of an outer macro ==================
! X1, X15 and X9-X14 go into the region, and the region to the stack.
PUSHF   SX, $1, SV1
        SX, $15, SV15
        SX, $9, SV9
        SX, $10, SV9+1.0
        SX, $11, SV9+2.0
        SX, $12, SV9+3.0
        SX, $13, SV9+4.0
        SX, $14, SV9+5.0
        LVI, $3, SVBEG
        LV, $4, FP
PU1     L(BU,64)(V+I), 1.0($3)
        ST(BU,64)(V+I), 1.0($4)
        KVI, $3, SVEND
        BXL, PU1
        SV, $4, FP
        LV, $8, PULK
        B, 0($8)
POPF    LVI, $3, SVBEG
        L(BU,24), FP
        -(BU,24), FRSZ
        ST(BU,24), FP
        LV, $4, FP
PO1     L(BU,64)(V+I), 1.0($4)
        ST(BU,64)(V+I), 1.0($3)
        KVI, $3, SVEND
        BXL, PO1
        LX, $1, SV1
        LX, $15, SV15
        LX, $9, SV9
        LX, $10, SV9+1.0
        LX, $11, SV9+2.0
        LX, $12, SV9+3.0
        LX, $13, SV9+4.0
        LX, $14, SV9+5.0
        LV, $8, POLK
        B, 0($8)
!
! ======== the Generator Language subroutines ========================
! PARM: the parameter numbered by the accumulator into $6's index word
PARM    KI(BU,24), 0
        BAE, PMFAR
        K(BU,24), QCOUNT($2)
        BAH, PMFAR
        ST(BU,18), PIDX
        LV, $6, PIDX
        LX, $6, PTM1($6)
        LV, $8, PMLK
        B, 0($8)
PMFAR   LI(BU,24), 5
        B, ERROR
!
! GPTR: the accumulator names a pointer's cell, as an offset in the branch
! table; the accumulator returns its value.  Zero is undefined (p.5).
GPTR    ST(BU,24), TMPV
        LV, $3, TMPV
        V+, $3, $X2
        L(BU,24), 0($3)
        KI(BU,24), 0
        BZAE, GP1
        LI(BU,24), 9
        B, ERROR
GP1     LV, $8, GPLK
        B, 0($8)
!
! MBGEN, p.4: QPT1 at the first parameter, nothing else defined
SBGEN   LI(BU,24), 1
        ST(BU,24), QPT1($2)
        LI(BU,24), 0
        ST(BU,24), QPT2($2)
        ST(BU,24), QPT3($2)
        ST(BU,24), QPT4($2)
        ST(BU,24), QPT5($2)
        ST(BU,24), QLIT($2)
        L(BU,24), NFLAGC
        ST(BU,24), QCN($2)
        B, 0($15)
!
! MMVPT, p.5.  Args: source pointer, N or NFLAG for QCN, new pointer.
SMVPT   L(BU,24), .32($15)
        K(BU,24), NFLAGC
        BZAE, MV1
        L(BU,24), QCN($2)
        K(BU,24), NFLAGC
        BZAE, MV1
        LI(BU,24), 10
        B, ERROR
MV1     ST(BU,24), MVT
        L(BU,24), 0($15)
        SIC, GPLK
        B, GPTR
        +(BU,24), MVT
        ST(BU,24), MVT
        L(BU,24), 1.0($15)
        ST(BU,24), TMPV
        LV, $3, TMPV
        V+, $3, $X2
        L(BU,24), MVT
        ST(BU,24), 0($3)
        B, 1.32($15)
!
! MOUT, pp.5-6.  Args: pointer, number of skeletons, each skeleton.
SOUT    L(BU,24), 0($15)
        SIC, GPLK
        B, GPTR
        ST(BU,24), MOB
        L(BU,24), .32($15)
        ST(BU,24), MOCT
        V+I, $15, 1.0
OU1     L(BU,24), MOCT
        KI(BU,24), 0
        BAE, OU9
        -(BU,24), C1
        ST(BU,24), MOCT
        L(BU,24), 0($15)
        ST(BU,24), SKADR
        L(BU,24), MOB
        ST(BU,24), BASE
        SIC, PSLK
        B, PUTSKL
        V+I, $15, .32
        B, OU1
OU9     B, 0($15)
!
! MGETL, p.6.  Args: pointer, parameter.  Digits, with an optional trailing
! point (smac.py's CHOSEN C5), to binary in QLIT.
SGETL   L(BU,24), 0($15)
        SIC, GPLK
        B, GPTR
        +(BU,24), .32($15)
        -(BU,24), C1
        SIC, PMLK
        B, PARM
        KCI, $6, 0
        BXE, GLBAD
        LI(BU,24), 0
        ST(BU,24), GLV
        LI(BU,1), 0
        ST(BU,1), GLD
GL1     L(BU,8)(V+I), .8($6)
        ST(BU,8), CH
        KI(BU,8), (8)164
        BZAE, GL2
        KCI, $6, 1
        BZXE, GLBAD
        L(BU,1), GLD
        KI(BU,1), 1
        BZAE, GLBAD
        B, GL9
GL2     KI(BU,8), (8)140
        BAL, GLBAD
        KI(BU,8), (8)162
        BAH, GLBAD
        BB, CH+.7, GLBAD
        L(BU,24), GLV
        *(BU,16), TEN
        ST(BU,24), GLV, 20
        L(BU,24), GLV
        +(BU,4), CH+.3
        ST(BU,24), GLV
        LI(BU,1), 1
        ST(BU,1), GLD
        CB, $6, GL1
GL9     L(BU,24), GLV
        ST(BU,24), QLIT($2)
        B, 1.0($15)
GLBAD   LI(BU,24), 15
        B, ERROR
!
! The compares, pp.6-7, with the errata's names.  Args: pointer, parameter,
! count of characters, target, then eight characters in two half-words.
SKPEQ   LI(BU,8), 0
        ST(BU,8), KCHARS
        LI(BU,8), 1
        ST(BU,8), KEQ
        B, SKCOM
SKPNE   LI(BU,8), 0
        ST(BU,8), KCHARS
        LI(BU,8), 0
        ST(BU,8), KEQ
        B, SKCOM
SKCEQ   LI(BU,8), 1
        ST(BU,8), KCHARS
        LI(BU,8), 1
        ST(BU,8), KEQ
        B, SKCOM
SKCNE   LI(BU,8), 1
        ST(BU,8), KCHARS
        LI(BU,8), 0
        ST(BU,8), KEQ
SKCOM   L(BU,24), 0($15)
        SIC, GPLK
        B, GPTR
        +(BU,24), .32($15)
        -(BU,24), C1
        SIC, PMLK
        B, PARM
        L(BU,24), 1.0($15)
        ST(BU,18), KLEN
        LC, $4, KLEN
        LI(BU,1), 0
        ST(BU,1), KRES
        KC, $6, KLEN
        BXL, KC8
        BXE, KC1
! the parameter is longer: unequal for a whole parameter (p.6)
        L(BU,8), KCHARS
        KI(BU,8), 1
        BZAE, KC8
KC1     SV, $15, TMPV
        LV, $3, TMPV
        V+I, $3, 2.0
KC2     L(BU,8)(V+I), .8($6)
        K(BU,8)(V+I), .8($3)
        BZAE, KC8
        CB, $4, KC2
        LI(BU,1), 1
        ST(BU,1), KRES
KC8     L(BU,1), KRES
        K(BU,8), KEQ
        BZAE, KC9
        L(BU,24), 1.32($15)
        ST(BU,24), TMPV
        LV, $8, TMPV
        V+, $8, $X1
        B, 0($8)
KC9     B, 3.0($15)
!
! MOUTF, pp.7-9.  Args: number of pairs, then (skeleton, n) half-words.
SOUTF   L(BU,24), 0($15)
        ST(BU,24), MFCT
        V+I, $15, .32
        LI(BU,24), 0
        ST(BU,24), MFDONE
OF1     L(BU,24), MFCT
        KI(BU,24), 0
        BAE, OF9
        -(BU,24), C1
        ST(BU,24), MFCT
        L(BU,24), MFDONE
        KI(BU,24), 0
        BZAE, OF2
        L(BU,24), QCOUNT($2)
        -(BU,24), C3
        K(BU,24), .32($15)
        BZAE, OF2
        L(BU,24), 0($15)
        ST(BU,24), SKADR
        LI(BU,24), 1
        ST(BU,24), BASE
        ST(BU,24), MFDONE
        SIC, PSLK
        B, PUTSKL
OF2     V+I, $15, 1.0
        B, OF1
OF9     L(BU,24), MFDONE
        KI(BU,24), 0
        BZAE, OF10
        LI(BU,24), 8
        B, ERROR
OF10    B, 0($15)
!
! MOUTV, pp.9-11.  Args: number of sets, then (M, skeleton, K) half-words.
! M = NFLAG is the bulletin's N.
SOUTV   L(BU,24), 0($15)
        ST(BU,24), MVCT
        ST(BU,24), MVCT2
        V+I, $15, .32
        SV, $15, MVSET
        LI(BU,24), 0
        ST(BU,24), MVREST
        ST(BU,24), MVNK
        ST(BU,24), MVN
        ST(BU,24), MVFRST
! first walk: the sum of Mj*Kj over the sets that are not N
        LV, $7, MVSET
OV1     L(BU,24), MVCT
        KI(BU,24), 0
        BAE, OV2
        -(BU,24), C1
        ST(BU,24), MVCT
        L(BU,24), 0($7)
        K(BU,24), NFLAGC
        BZAE, OV1A
        L(BU,24), 1.0($7)
        ST(BU,24), MVNK
        B, OV1B
! RefMan printed p.68: the product goes to the cleared accumulator at
! offset 20, wherever the operand came from.
OV1A    *(BU,24), 1.0($7)
        ST(BU,24), TMPV, 20
        L(BU,24), TMPV
        +(BU,24), MVREST
        ST(BU,24), MVREST
OV1B    V+I, $7, 1.32
        B, OV1
! N = [(parameters-3) - sum] / K (p.11, errata)
OV2     SV, $7, MVEND
        L(BU,24), MVNK
        KI(BU,24), 0
        BAE, OV4
        L(BU,24), QCOUNT($2)
        -(BU,24), C3
        K(BU,24), MVREST
        BAL, OVBAD
        -(BU,24), MVREST
        ST(BU,24), MVNUM
OV3     L(BU,24), MVNUM
        KI(BU,24), 0
        BAE, OV4
        K(BU,24), MVNK
        BAL, OVBAD
        -(BU,24), MVNK
        ST(BU,24), MVNUM
        M+1(BU,24), MVN
        B, OV3
OVBAD   LI(BU,24), 7
        B, ERROR
! second walk: put the skeletons out.  The first set's pointer is column
! one; set i+1's is column one moved over L = 3 + sum(j<=i) Mj*Kj (p.10).
OV4     LI(BU,24), 1
        ST(BU,24), MVB
OV5     L(BU,24), MVCT2
        KI(BU,24), 0
        BAE, OV9
        -(BU,24), C1
        ST(BU,24), MVCT2
        LV, $7, MVSET
        L(BU,24), 0($7)
        K(BU,24), NFLAGC
        BZAE, OV5A
        L(BU,24), MVN
OV5A    ST(BU,24), MVM
OV6     L(BU,24), MVM
        KI(BU,24), 0
        BAE, OV7
        -(BU,24), C1
        ST(BU,24), MVM
        LV, $7, MVSET
        L(BU,24), .32($7)
        ST(BU,24), SKADR
        L(BU,24), MVB
        ST(BU,24), BASE
        SIC, PSLK
        B, PUTSKL
        LV, $7, MVSET
        L(BU,24), MVB
        +(BU,24), 1.0($7)
        ST(BU,24), MVB
        B, OV6
! The running pointer after set 1 is 1 + M1*K1; set 2's is 4 + M1*K1.
! Only set 1 starts at column one, so 3 is added once.
OV7     LV, $7, MVSET
        V+I, $7, 1.32
        SV, $7, MVSET
        L(BU,24), MVFRST
        KI(BU,24), 0
        BZAE, OV5
        L(BU,24), MVB
        +(BU,24), C3
        ST(BU,24), MVB
        LI(BU,24), 1
        ST(BU,24), MVFRST
        B, OV5
OV9     LV, $15, MVEND
        B, 0($15)
!
! ======== PUTSKL: one skeleton, at the parameter pointer BASE ========
! In: SKADR the skeleton, relative to X1.  A skeleton is a word holding
! its count of cards, then 80-column IQS card images (CHOSEN).
PUTSKL  LV, $3, SKADR
        V+, $3, $X1
        L(BU,24), 0($3)
        ST(BU,24), SKCT
        V+I, $3, 1.0
        SV, $3, SKP
PS1     L(BU,24), SKCT
        KI(BU,24), 0
        BAE, PS9
        -(BU,24), C1
        ST(BU,24), SKCT
! a clean output card: all blanks
        LV, $5, QOUTP
        LCI, $6, 10
        L(BU,64), ZERO
PS2     ST(BU,64)(V+I), 1.0($5)
        CB, $6, PS2
! column 1
        LV, $3, SKP
        LCI, $3, 1
        LV, $5, QOUTP
        LCI, $5, 1
        LI(BU,8), 0
        ST(BU,8), CMODE
        SIC, SBLK
        B, SUBST
! columns 2-9, the tag
        LCI, $3, 8
        L(BU,24), QOUTP
        +(BU,24), C8
        ST(BU,24), TMPV
        LV, $5, TMPV
        LCI, $5, 8
        SIC, SBLK
        B, SUBST
! columns 10-72.  After an apostrophe nothing is substituted: smac.py
! substitutes the statement and appends the comment.
        LCI, $3, 63
        L(BU,24), QOUTP
        +(BU,24), C72
        ST(BU,24), TMPV
        LV, $5, TMPV
        LCI, $5, 63
        LI(BU,8), 1
        ST(BU,8), CMODE
        SIC, SBLK
        B, SUBST
! an expansion that is itself a SMAC statement is an inner macro (p.13)
        L(BU,24), QOUTP
        +(BU,24), C72
        ST(BU,24), TMPV
        LV, $3, TMPV
        LCI, $4, 63
        SIC, FOLK
        B, FINDOP
        L(BU,24), GENA
        KI(BU,24), 0
        BAE, PS3
! The card is copied aside, so the inner macro's own output can take its
! place.  smac.py's limit: 20 levels.
        L(BU,24), DEPTH
        KI(BU,24), 20
        BZAE, PSI1
        LI(BU,24), 12
        B, ERROR
PSI1    SIC, PULK
        B, PUSHF
        LV, $4, QOUTP
        LVI, $5, ICARD
        LCI, $6, 10
PSI2    L(BU,64)(V+I), 1.0($4)
        ST(BU,64)(V+I), 1.0($5)
        CB, $6, PSI2
        M+1(BU,24), DEPTH
        L(BU,24), ICARDV
        ST(BU,24), HEAD
        SIC, STLK
        B, STMT0
        B, MSCAN
! the card stands: it goes to STRAP
PS3     LV, $5, QOUTP
        V+I, $5, 10.0
        SV, $5, QOUTP
        M+1(BU,24), OUTCNT
! SEXIT comes back here after an inner macro
PS4     LV, $3, SKP
        V+I, $3, 10.0
        SV, $3, SKP
        B, PS1
PS9     LV, $8, PSLK
        B, 0($8)
!
! ======== SUBST: copy a field, substituting (p.12) ===================
! In: $3 source, C($3) its columns; $5 destination, C($5) its columns;
! CMODE 0 substitute, 1 substitute until an apostrophe, 2 verbatim.
SUBST   L(BU,8)(V+I), .8($3)
        ST(BU,8), CH
        L(BU,8), CMODE
        KI(BU,8), 2
        BAE, SB8
        KI(BU,8), 1
        BZAE, SB1
        L(BU,8), CH
        KI(BU,8), (8)52
        BZAE, SB1
        LI(BU,8), 2
        ST(BU,8), CMODE
        B, SB8
SB1     L(BU,8), CH
        KI(BU,8), (8)46
        BZAE, SB8
! a slash.  The next character decides.
        KCI, $3, 1
        BXE, SBLONE
        C-I, $3, 1
        L(BU,8)(V+I), .8($3)
        ST(BU,8), CH
        KI(BU,8), (8)46
        BAE, SB8
        KI(BU,8), (8)115
        BZAE, SB2
! /Q/: the closing slash, then this execution's tag (CHOSEN C2)
        KCI, $3, 1
        BXE, SBLONE
        C-I, $3, 1
        L(BU,8)(V+I), .8($3)
        KI(BU,8), (8)46
        BZAE, SBLONE
        LX, $6, UQV
        B, SB6
! /n/: digits, then a slash.  The 89 set's digits are 011dddd0, so the
! digit's value is the four bits at offset 3 (strap/charsets.py).
SB2     LI(BU,16), 0
        ST(BU,16), NVAL
SB3     L(BU,8), CH
        KI(BU,8), (8)140
        BAL, SBLONE
        KI(BU,8), (8)162
        BAH, SBLONE
        BB, CH+.7, SBLONE
        L(BU,16), NVAL
        *(BU,16), TEN
        ST(BU,16), NVAL, 20
        L(BU,16), NVAL
        +(BU,4), CH+.3
        ST(BU,16), NVAL
        KCI, $3, 1
        BXE, SBLONE
        C-I, $3, 1
        L(BU,8)(V+I), .8($3)
        ST(BU,8), CH
        KI(BU,8), (8)46
        BZAE, SB3
! parameter number BASE + n - 1
        L(BU,24), BASE
        +(BU,16), NVAL
        -(BU,24), C1
        SIC, PMLK
        B, PARM
        KCI, $6, 0
        BXE, SB9
SB6     L(BU,8)(V+I), .8($6)
        ST(BU,8), CH
        SIC, EMLK
        B, EMIT
        CB, $6, SB6
        B, SB9
SB8     SIC, EMLK
        B, EMIT
SB9     CB, $3, SUBST
        LV, $8, SBLK
        B, 0($8)
SBLONE  LI(BU,24), 4
        B, ERROR
!
! EMIT: CH to the destination.  Blanks past the field's end are dropped.
EMIT    KCI, $5, 0
        BXE, EM1
        L(BU,8), CH
        ST(BU,8)(V+I), .8($5)
        C-I, $5, 1
EM9     LV, $8, EMLK
        B, 0($8)
EM1     L(BU,8), CH
        KI(BU,8), 0
        BAE, EM9
        LI(BU,24), 6
!
! ======== stopping =================================================
ERROR   ST(BU,24), QERR($2)
        LI(BU,1), 1
        ST(BU,1), QERRBIT($2)
HALTE   BEW, $
DONE    BEW, $
!
! ======== the branch table (p.2).  Every reference is ($2). ==========
! MEGEN puts these names into each generator as SYN cards (p.5).
        CNOP
BT      B, SEXIT
        B, SBGEN
        B, SOUTF
        B, SOUTV
        B, SMVPT
        B, SOUT
        B, SGETL
        B, SKPEQ
        B, SKPNE
        B, SKCEQ
        B, SKCNE
        CNOP
BTBITS  DD(BU,64), 0
BTERR   DD(BU,64), 0
QEXIT   SYN, 0.0
QBGEN   SYN, .32
QOUTF   SYN, 1.0
QOUTV   SYN, 1.32
QMVPT   SYN, 2.0
QOUT    SYN, 2.32
QGETL   SYN, 3.0
QKPEQ   SYN, 3.32
QKPNE   SYN, 4.0
QKCEQ   SYN, 4.32
QKCNE   SYN, 5.0
QDBUGB  SYN, BTBITS-BT+.0
QMIBIT  SYN, BTBITS-BT+.1
QCIBIT  SYN, BTBITS-BT+.2
QMACBIT SYN, BTBITS-BT+.3
QINBIT  SYN, BTBITS-BT+.4
QERRBIT SYN, BTBITS-BT+.5
QERR    SYN, BTERR-BT
QCOUNT  SYN, BTCOUNT-BT
QPT1    SYN, BTPT1-BT
QPT2    SYN, BTPT2-BT
QPT3    SYN, BTPT3-BT
QPT4    SYN, BTPT4-BT
QPT5    SYN, BTPT5-BT
QLIT    SYN, BTLIT-BT
QCN     SYN, BTCN-BT
QGUB    SYN, BTGUB-BT
!
! ======== working storage ===========================================
! Core outside the image reads back 0xAA on the model, so every cell is
! given a value.
        CNOP
C1      DD(BU,24), 1
        CNOP
C3      DD(BU,24), 3
        CNOP
C8      DD(BU,24), 8
        CNOP
C72     DD(BU,24), 72
        CNOP
C640    DD(BU,24), 640
        CNOP
TEN     DD(BU,16), 10
        CNOP
C2B     DD(BU,8), 2
        CNOP
NFLAGC  , (8)777777.0
        CNOP
PTABW   , PTAB
        CNOP
TAGV    XW, COLBUF+.8, 0, 0
UQV     XW, UNIQ+.24, 5, 0
FRSZ    XW, SVEND-SVBEG, 0, 0
ICARDV  XW, ICARD, 0, 0
ZERO    DD(BU,64), 0
CURC    DD(BU,64), 0
TMPV    DD(BU,64), 0
TMPP    DD(BU,64), 0
ISB     DD(BU,64), 0
LASTM   DD(BU,64), 0
GENA    DD(BU,64), 0
ONLY1   DD(BU,64), 0
FSTOP   DD(BU,64), 0
FCUR    DD(BU,64), 0
FLEN    DD(BU,64), 0
KFLD    DD(BU,64), 0
APFLD   DD(BU,64), 0
STL     DD(BU,64), 0
APPP    DD(BU,64), 0
COPYF   DD(BU,64), 0
NCONT   DD(BU,64), 0
DEPTH   DD(BU,64), 0
KEY     DD(BU,64), 0
KEY2    DD(BU,64), 0
GLV     DD(BU,64), 0
GLD     DD(BU,64), 0
KCHARS  DD(BU,64), 0
KEQ     DD(BU,64), 0
KLEN    DD(BU,64), 0
KRES    DD(BU,64), 0
MVT     DD(BU,64), 0
CMODE   DD(BU,64), 0
CH      DD(BU,64), 0
NVAL    DD(BU,64), 0
PIDX    DD(BU,64), 0
BLLK    DD(BU,64), 0
CPLK    DD(BU,64), 0
STLK    DD(BU,64), 0
APLK    DD(BU,64), 0
FOLK    DD(BU,64), 0
FILK    DD(BU,64), 0
FPLK    DD(BU,64), 0
PULK    DD(BU,64), 0
POLK    DD(BU,64), 0
PMLK    DD(BU,64), 0
GPLK    DD(BU,64), 0
SBLK    DD(BU,64), 0
EMLK    DD(BU,64), 0
! the /Q/ counter: "Q" and four IQS digits, starting at 0000
GUNIQ   (IQS?)DD(BU,64,8),   Q0000?
ICARD   DRZ(BU,64), 10
!
! ======== the region an inner macro saves: SVBEG up to SVEND ==========
SVBEG   SYN, $
BTCOUNT DD(BU,64), 0
BTPT1   DD(BU,64), 0
BTPT2   DD(BU,64), 0
BTPT3   DD(BU,64), 0
BTPT4   DD(BU,64), 0
BTPT5   DD(BU,64), 0
BTLIT   DD(BU,64), 0
BTCN    DD(BU,64), 0
BTGUB   DD(BU,64), 0
UNIQ    DD(BU,64), 0
HEAD    DD(BU,64), 0
STX     DD(BU,64), 0
INCOM   DD(BU,64), 0
SV1     DD(BU,64), 0
SV15    DD(BU,64), 0
SV9     DRZ(BU,64), 6
BASE    DD(BU,64), 0
SKADR   DD(BU,64), 0
SKCT    DD(BU,64), 0
SKP     DD(BU,64), 0
PSLK    DD(BU,64), 0
MOB     DD(BU,64), 0
MOCT    DD(BU,64), 0
MFCT    DD(BU,64), 0
MFDONE  DD(BU,64), 0
MVCT    DD(BU,64), 0
MVCT2   DD(BU,64), 0
MVSET   DD(BU,64), 0
MVREST  DD(BU,64), 0
MVNK    DD(BU,64), 0
MVEND   DD(BU,64), 0
MVNUM   DD(BU,64), 0
MVN     DD(BU,64), 0
MVM     DD(BU,64), 0
MVB     DD(BU,64), 0
MVFRST  DD(BU,64), 0
COLBUF  DRZ(BU,64), 2
STMT    DRZ(BU,64), 80
PTM1    SYN, PTAB-1.0
PTAB    DRZ(BU,64), 100
PTLIM   SYN, $
SVEND   SYN, $
