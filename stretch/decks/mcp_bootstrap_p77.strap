!   line  8  004462.40  000000.44 82  004576.34 02     BB,TJBPRO(TXA),TP2
!   line  9  004463.40  000000.45 82  004576.34 02     BB,TRJECT(TXA),TP2
!   line 11  004464.40  000000.06 32                   LV,TXB,TCRREF(TXA)
