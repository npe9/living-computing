!   line 30  004500.40  000000.00 83  004575.74 00     T P5Z  BZB,TASGNI(TXB),TP3
!   line 31  004501.40  000000.03 83  004575.74 00     BZB,TTYPE(TXB),TP3
!   line 33  004502.40  000000.56 83  022027.20 50     L,TABSCH(TXB),46
!   line 34  004503.40  000011.10 30                   LV,TXC,$R
!   line 35  004504.00  000000.10 34                   LV,TXC,0.0(TXC)
!   line 36  004504.40  000000.07 83  003027.20 50     L,TABSUN(TXB),46
!   line 37  004505.40  000011.10 B0                   V+,TXC,$R
!   line 38  004506.00  000000.02 83  004511.34 0C     BZB1,TPRINT(TXB),TP5A
!   line 40  004507.00  000000.76 84  004575.74 00     BZB,TUNRES(TXC),TP3
