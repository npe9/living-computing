!   line  3*  220607.00     220642.46 30                 F STUP   LV,$3,FLZCN                -B.A. OF 1ST ONE BIT IN PATTERN WD KE000047
!   line  4*  220607.40     220643.10 30                          LV,$4,FADC                                                   KE000048
