        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), INCORRECT CARD TYPE WITHIN IODS *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG21  SYN, $   ! X MSG 21, listing 000501.00
XMSG23  SYN, $   ! X MSG 23
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), IO REQUIREMENTS REJECTED *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG24  SYN, $   ! X MSG 24, listing 000506.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), IO ASSIGNMENTS CAN NOT BE MADE *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE

! THE ONE BLOCK WHERE THE LABEL COMES BEFORE THE CNOP.  Everywhere
! else the deck writes the end-of-message code, then CNOP, then the
! next message's SYN -- so the label lands on a full word.  Printed
! p.12 lines 42-44 write it the other way round for X MSG 25: the
! code at 000513.20, the SYN at 000513.30, and only then the CNOP at
! 000513.40.  So X MSG 25 is NOT word-aligned; it points at the
! trailing edge of the previous message.  Writing the CNOP first
! would have put it at 000514.00 and the listing says 000513.30.
XMSG25  SYN, $   ! X MSG 25, listing 000513.30
        CNOP
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), IO TABLES CAN NOT BE FORMED *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG26  SYN, $   ! X MSG 26, listing 000521.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), PROSA ARC COUNT INCORRECT *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP
        END, XMSG00
