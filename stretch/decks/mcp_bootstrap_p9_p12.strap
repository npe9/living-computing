        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), EKJ OF CCW IN IO STATUS REPORT ROUTINE*
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG22  SYN, $   ! X MSG 22, listing 000473.00
