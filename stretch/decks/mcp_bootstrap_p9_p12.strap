        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), UNSUCCESSFUL COMPLETION OF MCP IPL READ*
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG11  SYN, $   ! X MSG 11, listing 000403.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), EKJ ON DISK OPERATION *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG12  SYN, $   ! X MSG 12, listing 000410.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), UNRJ ON DISK OPERATION *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG13  SYN, $   ! X MSG 13, listing 000415.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), UNSUCCESSFUL COMPLETION OF LOCATE TO DISK*
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG14  SYN, $   ! X MSG 14, listing 000424.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), EKJ ON CCW ON DISK OPERATION *
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG15  SYN, $   ! X MSG 15, listing 000432.00
XMSG16  SYN, $   ! X MSG 16
XMS16A  SYN, $   ! X MS 16A
XMS16B  SYN, $   ! X MS 16B
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        DD(BU,8),(2)00000010       ! -RED$
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), WRITE DISK OPERATION IN ERROR*
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMS16C  SYN, $   ! X MS 16C, listing 000440.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
        (IQS*)DD(BU,64,8),000000.0*   ! -SLOT FOR ERROR ADDRESS
        (IQS*)DD(BU,64,8), NO IOCD CARD DETECTED*
        DD(BU,8),(2)1111 1110      ! -CONTROL CODE * END OF MESSAGE
        CNOP

XMSG17  SYN, $   ! X MSG 17, listing 000444.00
        DD(BU,8),(2)1111 1101      ! -CONTROL CODE * CARRIAGE RETURN
