        LFI(BU,8),(8)33,8                                    ! line 12  -,
        LF(BU,4),.19($13),-21                                ! line 13
        LV,$1,$L                                             ! line 14
        LF(BU,8),AHXTB($1)                                   ! line 15
        ST(BU,64),($14)                                      ! line 16
        B,ARETRN                                             ! line 17
AFLPNT  LVI,$14,APCOL1                                       ! line 18
        TI,1,APFL,2.($14)                                    ! line 19
        TI,1,APFL,6.($14)                                    ! line 20
        TI,1,APFL,10.($14)                                   ! line 21
        TI,1,APFL,14.($14)                                   ! line 22
        CM1111(BU,1),AFLPTI                                  ! line 23
AFLP1   LVI,$15,$+1.                                         ! line 24
        B,AWDCMP                                             ! line 25
        LCI,$13,1                                            ! line 26
        B,ACNVER                                             ! line 27
        LV,$14,AHOTP                                         ! line 28
        CM0000(BU,19),$11                                    ! line 29
        SIC,ALCRFB                                           ! line 30
        B,ALCRF                                              ! line 31
        LCI,$13,4                                            ! line 32
ACNVER  CM1111(BU,1),$IND.63                                 ! line 33  -SET NOISY MODE
        CM0000(BU,8),.16($14)                                ! line 34
        BZB,0($13),$+2.                                      ! line 35
        CM1111(BU,1),AEXPF                                   ! line 36
        DL(N),0($13)                                         ! line 37
        BBZ,$L,$+1.                                          ! line 38
ALOOP2  BZRZ,ALOOP4                                          ! line 39
        CM1111(BU,1),$PG0                                    ! line 40  -INDICATE X FOR FRACTION
        C1111(BU,1),$L.12                                    ! line 41  -ASSUME EXISTENCE OF BIT 49
        E-I,48                                               ! line 42  -ADJUST EXPNT AS IF NORMALIZED
        BZBZ,$L,ALOOP4                                       ! line 43
        CM1111(BU,1),AEXPF                                   ! line 44
ALOOP4  BZBZ,10.04,ACPLUS                                    ! line 45
        CM0000,AFRACI                                        ! line 46
        B,ACPLUS+1.                                          ! line 47
ACPLUS  CM1111,AFRACI                                        ! line 48

