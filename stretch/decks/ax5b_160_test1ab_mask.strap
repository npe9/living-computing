        B, SERS                       ! -UNABLE TO TEST ANY FURTHER BITS.
        B, I6010
        NOP
        SIC, SEN                      ! -BIT 58 OF MASK REG NOT ZERO.
        B, SERS                       ! -UNABLE TO TEST ANY FURTHER BITS.
        B, I6010
        NOP
        SIC, SEN                      ! -BIT 59 OF MASK REG NOT ZERO.
        B, SERS                       ! -UNABLE TO TEST ANY FURTHER BITS.
        B, I6010
