        B, SERS                       ! -UNABLE TO TEST ANY FURTHER BITS.
        B, I6010
        NOP
        SIC, SEN                      ! -BIT 63 OF MASK REG NOT ZERO.
        B, SERS                       ! -UNABLE TO TEST ANY FURTHER BITS.
