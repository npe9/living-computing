! mcp_bootstrap_p24.strap -- MCP INITIALIZATION, printed page 24:
! killing unavailable units, the BCD-zero replacement, the TIME
! CONVERSION, and the error message with its constants.
! docs/MCP_Mar63_001-249.pdf PDF p.31, header "PAGE NUMBER 24".
! docs/boot_plan.md M3.
!
! Contiguous with printed p.23: that page's last instruction is a
! full word at 001173.40 and this one starts at 001174.40.
!
! ---------------------------------------------------------------
! >>> THIS PAGE SETTLES printed p.23's PREDICTION <<<
! ---------------------------------------------------------------
! p.22 line 35 loads an immediate X VTIME = 001242.02 and p.23 line
! 15 loads X VDATE = 001242.70, so the two constants had to sit 0o70
! bits apart in one word region.  Lines 50 and 51 here DEFINE them,
! at 001242.02 and 001242.70 exactly.  The prediction was written
! into tests/run_tests.sh before this page was opened.
!
! ---------------------------------------------------------------
! WHAT THE PAGE DOES
! ---------------------------------------------------------------
!   lines  1-12  X IO 3/4/5/6: mark units not available, one at a
!                time, counting down with CB until all are killed.
!   lines 13-18  X VZER / X VZER 1: store a BCD zero -- "(2)1010" --
!                over a character the validation found blank.
!   lines 19-31  THE TIME CONVERSION: read the 26-bit time clock,
!                divide twice by sixty to split seconds, minutes and
!                hours, and convert each to decimal with CV and
!                LTRCV.
!   lines 32-36  X VTDER: write the "DATE/TIME INVALID" message.
!   lines 38-56  the message, the control words, and the constants.
!
! ---------------------------------------------------------------
! THE ASSEMBLER GAINED "DRZ" FOR THIS PAGE
! ---------------------------------------------------------------
! Line 52 is "X VSTOR DRZ(BU),100 - TEMPORARY STORAGE", whose BINARY
! OUTPUT prints 000144.00 -- 0o144 is a hundred, so it reserves a
! hundred WORDS and the printed value is the SIZE, exactly as DR's
! is.  DR and DRZ are the pair C22-6531 and C28-6129 both carry,
! "Data Reservation, with and without zeroing"; only DR existed here.
! The count is written BARE on this page and PARENTHESISED on printed
! p.21, and dr_count has always taken either.
!
! ---------------------------------------------------------------
! THE NAMES ARE "X IO n", NOT "X IC n"
! ---------------------------------------------------------------
! docs/listing_typography.md 13 again: this page's own name column
! prints "X IC 3", "X IC 4", "X IC 5" and then "X IO 6" for four
! labels of one family, and its operands print "X IO 1" and "X IO6".
! A column that disagrees with itself about a glyph is naming the
! unstable one (13a).  Read at 600 dpi the operands are unambiguous:
! "BXCZ,X IO 1", "B,X IO 1", "CB,$10,X IO6".  printed p.23's labels
! are spelled the same way here for that reason.
!
! ---------------------------------------------------------------
! EXTERNALS, every one recovered from this page's own binary output
! ---------------------------------------------------------------
!   X IO 1    001153.40  (lines 2, 4, 7, 12)  -- printed p.23 line 32
!   X VCONS   001076.00  (line 15)  -- printed p.22 line 33
!   X VCONT   001132.40  (line 18)  -- printed p.23 line 13
!   X VBACK   001072.40  (line 31)  -- printed p.22 line 28
!   X VIORP   001152.00  (line 36)  -- printed p.23 line 30
!   X LR IN   001034.00  -- printed p.21's buffer, FIFTH page to use it
!   X VSWCH   001672.00  (line 35)
!   X IO STK  000005.00  (line 54) -- a size, like X VTMST below
!   X7 3      000066.40 / X 71  000057.40
X73     SYN, (8)66.40
X71     SYN, (8)57.40
XIO1    SYN, (8)1153.40
XVCONS  SYN, (8)1076.0
XVCONT  SYN, (8)1132.40
XVBACK  SYN, (8)1072.40
XVIORP  SYN, (8)1152.0
XLRIN   SYN, (8)1034.0
XVSWCH  SYN, (8)1672.0
XIOSTK  SYN, (8)5.0

        SLC, (8)1174.40

! ---- kill the units that are not available ----------------------
XIO3    CM1111(BU,1), .28($14)       ! line 1  -UNIT TO NOT AVAILABLE
        B, XIO1                      ! line 2
XIO4    CM1111(BU,1), .28($14)       ! line 3  -UNIT NOT AVAILABLE
        B, XIO1                      ! line 4
XIO5    L(BU,4), .59($14), 46        ! line 5  - GET UNIT COUNT
        LC, $10, $R                  ! line 6
        BXCZ, XIO1                   ! line 7  IF NO UNITS ON CHANNEL
                                     !          (DEAD CHANNEL)
        LV, $14, 0.0($14)            ! line 8  -GET UST BASE
XIO6    CM1111(BU,1), .28($14)       ! line 9  -UNIT TO NOT AVAILABLE
        V+I, $14, 1.0                ! line 10
        CB, $10, XIO6                ! line 11 -IF ALL UNITS KILLED
        B, XIO1                      ! line 12 - RETURN FOR MORE
                                     !            OPTIONS

! ---- replace a blank character with a BCD zero -------------------
XVZER   LFI(BU,4), (2)1010, 46       ! line 13 - BCD ZERO
        ST(BU,4), -.4($1), 46        ! line 14
        B, XVCONS                    ! line 15
XVZER1  LFI(BU,4), (2)1010, 46       ! line 16 - BCD ZERO
        ST(BU,4), -.4($1), 46        ! line 17
        B, XVCONT                    ! line 18

! ---- the time conversion -----------------------------------------
XVNOTM  L(BU,26), $TC, -60           ! line 19 - GET TIME
        LVI, $1, XVSTOR              ! line 20
        /I(BU,6), 60, -60            ! line 21
        C0011(BU,6), $RM+.54         ! line 22 -SECONDS IN RM IN
                                     !           BINARY
        CM0101(BU,6), 0.24($1)       ! line 23 - SAVE BINARY SECONDS
        /I(BU,6), 60, -60            ! line 24 -COMPUTE HOUR AND
                                     !           MINUTES
        CV(BU), $L, 16               ! line 25 -CONVERT HOURS TO
                                     !           DECIMAL
        LTRCV(BU,6), $RM+.54         ! line 26 - CONVERT MINUTES TO
                                     !            DECIMAL
        C0011(BU,8), $TR+.52, 8      ! line 27
        LTRCV(BU,6), 0.24($1)        ! line 28 -CONVERT SECONDS
        C0011(BU,8), $TR+.52         ! line 29
        ST(BU,24), XLRIN             ! line 30
        B, XVBACK                    ! line 31

! ---- the error message -------------------------------------------
XVTDER  W(SEOP), 0.0($15), XVTMCW    ! line 32 -WRITE OUT ERROR
                                     !           MESSAGE.
        SIC, X73                     ! line 33
        B, X71                       ! line 34 - I/O TEST
        CM0000(BU,1), XVSWCH+.19     ! line 35
        B, XVIORP                    ! line 36

        CNOP                         ! line 37
XVMESS  DD(BU,8), (2)11111101        ! line 38 -CONTROL CODE FOR
                                     !           CARRAIGE RETURN
        DD(BU,8), (2)00000010        ! line 39 -RED $
        (IQS*)DD(BU,64,8),DATE/TIME INVALID RETRY *     ! line 40
        (IQS*)DD(BU,64,8),VIA COMD, CLOCK *             ! line 41
        DD(BU,8), (2)11111101        ! line 42 -CARRAIGE RETURN
        DD(BU,8), (2)11111110        ! line 43 -END OF MESSAGE
        CNOP                         ! line 44
XVTMST  SYN, $-XVMESS                ! line 45
XVTMCW  CW(CCR), XLRIN, 3, XVTCW     ! line 46
XVTCW   CW, XVMESS, XVTMST           ! line 47
        CNOP                         ! line 48
XVCLOK  (A*)DD(BU,,6),COMD,CLOCK,*                      ! line 49
XVTIME  (A*)DD(BU,,6),00,00,00,*                        ! line 50
XVDATE  (A*)DD(BU,,6),00/00/00*                         ! line 51
XVSTOR  DRZ(BU), 100                 ! line 52 - TEMPORARY STORAGE

        SLC, (8)1410.0
XIOCW   CW(CCR), XLRIN, 3, XIOCW1    ! line 53
XIOCW1  CW, XIOSTA, XIOSTK           ! line 54 -CW USED TO REQUEST IO
                                     !           STATUS
        CNOP                         ! line 55
XIOSTA  DD(BU,8), (2)11111101        ! line 56 -CONTROL CODE CARRIAGE
                                     !           RETURN

        END, XIO3
