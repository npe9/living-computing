!CHECK 233024.40 | 233103.31 42 | line 22 ZASN51 BXVZ,ZCOM19
!CHECK 233025.00 | 215001.02 80 001000.36 F0 | line 23 CM1111,SCNFCG
!CHECK 233026.00 | 235127.63 80 001000.36 F0 | line 24 CM1111(BU,1),ZLODLP+.19
!CHECK 233027.00 | 000022.05 70 | line 25 SR,2,$2
!CHECK 233027.40 | 000000.07 12 | line 26 SX,ZCHNNM,SCHANN($2)
!CHECK 233030.00 | 000000.51 32 | line 27 SV,ZUNTNM,SUNITN($2)
!CHECK 233030.40 | 000031.02 30 | line 28 LV,1,$9
!CHECK 233031.00 | 000000.05 31 | line 29 SV,2,0.0($1)
!CHECK 233031.40 | 000000.65 81 001000.36 F0 | line 30 CM1111,SIMNT($1)
!CHECK 233032.40 | 233034.00 80 000023.20 A0 | line 31 TI,8,ZASN99,$3 (byte prints AC)
!CHECK 233033.40 | 232772.50 00 | line 32 B,ZASN52
!CHECK 233044.00 | 233077.40 80 | line 42 ZDSN01 SIC,ZCOM99
!CHECK 233044.40 | 233067.50 00 | line 43 B,ZCOM01
!CHECK 233045.00 | 000022.02 90 | line 44 KV,1,$2
!CHECK 233045.40 | 000000.36 81 233103.34 02 | line 45 BB,SUNSUP($1),ZCOM19
!CHECK 233046.40 | 000000.35 81 233103.34 0E | line 46 BB1,SUNASG($1),ZCOM19
!CHECK 233047.40 | 000000.40 81 001000.00 F0 | line 48 CM0000,SOWNER($1)
