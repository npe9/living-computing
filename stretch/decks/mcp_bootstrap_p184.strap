!   line  5  221216.40   220064.32 C0                        BZXE,K ILEGL              -IF NOT, FAKE EPGK
!   line  6  221217.00   217711.10 00                        B,K W LABL                -IF SO, REWRITE LABEL
!   line  7  221217.40   000000.40 8B 221221.74 02  KRELOD   BB,SOWNER($11),$+2.0
!   line  8  221220.40   000003.75 8C 221233.74 0E           BB1,SREMNT($12),KBOUNC    -IF 2ND TIME THROW HIM OFF
