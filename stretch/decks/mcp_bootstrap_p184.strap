KCBJR   SYN, (8)221313.40            ! line 24 SIC -- BIT-EXACT; p.186 line 9 defines it; spelling corrected, GLYPH CALL (8)
JIOBSY  SYN, (8)233666.04            ! line 16 VFL address -- BIT-EXACT; no dds on purpose
JWAIT   SYN, (8)233666.00            ! line 17 VFL address -- BIT-EXACT; no dds on purpose
KUNLM   SYN, (8)222001.0             ! p.197 line 19 defines "K UNL M"
ZUNLO2  SYN, (8)222011.0             ! p.197 line 21 defines "Z UNLO2"
KULMES  SYN, (8)222017.40            ! p.197 line 26 defines "K UL MES"

        SLC, (8)221214.0             ! NOT PRINTED.  Asserted; see THE JOIN
        B,K SP TM                    ! line  1   -SPACE OVER TAPE MARK
RV3SCR  K(BU,30),.34($4),64          ! line  2   printed name "RV3 SCR"
        BZAE,K RELOD                 ! line  3
        KVI,0,E MK 1A                ! line  4   -IF SO, TEST IF $W OR $WEF OP
        BZXE,K ILEGL                 ! line  5   -IF NOT, FAKE EPGK
        B,K W LABL                   ! line  6   -IF SO, REWRITE LABEL
KRELOD  BB,SOWNER($11),$+2.0         ! line  7   printed name "KRELOD", closed up
        BB1,SREMNT($12),KBOUNC       ! line  8   -IF 2ND TIME THROW HIM OFF
        LV,8,$4                      ! line  9
        LVI,5,KUNLM                  ! line 10
        LVI,$7,ZUNLO2                ! line 11
        SIC,ZID09X                   ! line 12 * location-column asterisk
        B,ZID09                      ! line 13
        LVI,$7,9.0                   ! line 14
        LV,$2,KULMES                 ! line 15
        LF(BU,1),JIOBSY              ! line 16
        SF(BU,1),JWAIT               ! line 17
        SIC,K NEW TP                 ! line 18
        B,K RITE T                   ! line 19   -ASK FOR CORRECT REEL
        LVI,0,K SUPP                 ! line 20
        SVA,0,K NEW TP               ! line 21
        SIC,K UNR R                  ! line 22
        B,K K LOOP                   ! line 23   -WAIT FOR CHAN SIGNAL
        SIC,K CBJ R                  ! line 24
        B,K CLEAR                    ! line 25   -CLEAR CONTROL WORD
        B,R RR                       ! line 26   -TEST IF CORRECT REEL
KBOUNC  LVI,1,K LETTR                ! line 27   printed name "K BOUNC"
        LF(BU,30,6),.34($4)          ! line 28   -EXPAND REEL NO TO 8 BIT BCD
        ST(BU,40),K DRAG             ! line 29
        B,J GETOF                    ! line 30   -THROW PP OFF
        CNOP                         ! line 31 * emits a half word here
! line 32  K LETTR, 42 characters at 8 bits; NO trailing comment on the
! next four cards -- the blanks before the "*" are DATA.
KLETTR  (A*)DD(BU),1YOUR JOB HAS BEEN TERMINATED BECAUSE THE *
        (A*)DD(BU),OPERATOR COULD NOT LOCATE REEL NO. *
KDRAG   (A*)DD(BU),                                        *
        (A*)DD(BU),                   *
RRDL    XW,$,1.0,$                   ! line 36   printed name "R RDL"

! ---------------------------------------------------------------
! THE PRINTED LISTING, AS READ
! ---------------------------------------------------------------
!   line  1  221214.00   220156.50 00                        B,K SP TM                 -SPACE OVER TAPE MARK
!   line  2  221214.40   000000.42 84 036040.21 10  RV3 SCR  K(BU,30),.34($4),64       -TEST IF SCRATCH TAPE IS WANTED
!   line  3  221215.40   221217.76 C0                        BZAE,K RELOD
